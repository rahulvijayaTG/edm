<?xml version="1.0"?>
<!--
Pluggable look and feel configuration file for i2 web apps
-->
<plaf>
  <skins>
    <!--  -->
    <defaults>
      <skinName>i2 standard</skinName>
      <directories>
        <javascript>/skins/i2-standard/js</javascript>
        <css>/skins/i2-standard</css>
        <image>/skins/i2-standard/images</image>
      </directories>
    </defaults>

    <!-- skin definitions -->
    <skin name="i2 standard">
      <info>
        The standard i2 look and feel.
      </info>
      <directories>
        <javascript>/skins/i2-standard/js</javascript>
        <css>/skins/i2-standard</css>
        <image>/skins/i2-standard/images</image>
      </directories>
    </skin>

    <skin name="i2 high contrast">
      <info>
        The standard i2 look and feel with saturated colors.  This
        skin is designed for overhead projectors that need higher
        contrast and colors that are not washed out.
      </info>
      <directories>
        <css>/skins/i2-high-contrast</css>
        <image>/skins/i2-high-contrast/images</image>
      </directories>
    </skin>

    <skin name="i2 autumn">
      <info>
        The standard i2 look and feel with a golden color scheme.
      </info>
      <directories>
        <css>/skins/i2-autumn</css>
        <image>/skins/i2-autumn/images</image>
      </directories>
    </skin>

    <skin name="i2 spring">
      <info>
        The standard i2 look and feel with a green color scheme.
      </info>
      <directories>
        <css>/skins/i2-spring</css>
        <image>/skins/i2-spring/images</image>
      </directories>
    </skin>
  </skins>
</plaf>



