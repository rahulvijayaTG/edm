    <ui_form2 Name="Manage Domain" InputFormVar="pglFormInput" OutputFormVar="pglFormOutput" ShowInBreadCrumbs="SHOW" Template="ManageDomainData_SearchPage.pgl">
      <pre_actions>
        <action>
          <IF_TEST Test="$thisParam/FILTER_ON/@Value='DomainSearchTable'">
            <THEN>
              <SET Var="donotshowtable" FromValue="1"/>
            </THEN>
          </IF_TEST>
          <SET Var="exportTableId" FromValue="{ifElse($thisParam/FILTER_ID/@Value = null, '', $thisParam/FILTER_ID/@Value)}"/>
          <IF_TEST Test="$thisParam/SYS_BACK/@Value ='0^manageDomainDataFirstScreen.3'">
            <THEN>
              <ADD_CHILDREN DocVar="thisParam" FromSelectList="$selectedXML/*"/>
            </THEN>
          </IF_TEST>
          <IF_TEST Test="$thisParam/BUTTON_ID/@Value ='SYS_RELOAD' and $thisParam/SelectedClear/@Value='DomainSearchTable' ">
            <THEN>
              <REMOVE_CHILDREN ChildName="selectedTableName" DocVar="thisParam"/>
            </THEN>
          </IF_TEST>
          <REQUEST AssignToVar="check" Name="getDomainTable">
            <TO_XML SelectList="$thisParam/*"/>
          </REQUEST>
          <IF_TEST Test="$userAction ='Create' or $userAction ='Update' or $userAction ='Delete' or $userAction ='Copy'">
            <THEN>
              <TO_DOCVAR AssignToVar="myDoc">
                <MYDOCUMENT>
                  <INPUT>
                    <TO_XML SelectList="$thisParam/*"/>
                  </INPUT>
                  <COLLATE_LIST Value="DOMAINDATA">
                    <DOMAINIDENTIFIER/>
                    <DOMAINNAME/>
                    <DOMAINMNEMONICVALUE/>
                    <DOMAINDESCRIPTION/>
                    <SourceSystemMnemonicValue/>
                    <SourceObjectMnemonicValue/>
                    <SourceKeyName/>
                    <SourceKeyValue/>
                  </COLLATE_LIST>
                </MYDOCUMENT>
              </TO_DOCVAR>
              <COLLATE_XML DocVar="myDoc" AssignToVar="collateDoc"/>
              <PRINTLN Value="COLLATED doc "/>
              <PRINTLN Value="{$collateDoc }"/>
              <TO_DOCVAR AssignToVar="selectedCollatedDomainDetails">
                <DomainDataDetails>
                  <ENTITY_STATE Value="{$thisParam/ENTITY_STATE/@Value}"/>
                </DomainDataDetails>
              </TO_DOCVAR>
              <FOR_EACH SelectList="$collateDoc/DOMAINDATA" CurrentElement="currdomaindetails">
                <IF_TEST Test="$currdomaindetails/DOMAINIDENTIFIER/@Value=$thisParam/selectedDOMAINIDENTIFIER/@Value">
                  <THEN>
                    <ADD_CHILDREN DocVar="selectedCollatedDomainDetails" FromSelectList="$currdomaindetails/*"/>
                  </THEN>
                </IF_TEST>
              </FOR_EACH>
              <PRINTLN Value="Appended  doc "/>
              <PRINTLN Value="{$selectedCollatedDomainDetails }"/>
              <IF_TEST Test="$userAction ='Create' or $userAction ='Update' or $userAction ='Delete'">
                <THEN>
                  <REQUEST AssignToVar="addedRecord" Name="saveDomainData">
                    <TO_XML SelectList="$thisParam/*"/>
                    <TO_XML SelectList="$selectedCollatedDomainDetails"/>
                  </REQUEST>
                  <PRINTLN Value="RESULT AFTER SAVE::::::{$addedRecord}"/>
                  <IF_TEST Test="$addedRecord/_RESULT/_ERROR/@Value !=null">
                    <THEN>
                      <SET Var="sucessMessage" FromValue=""/>
                    </THEN>
                  </IF_TEST>
                </THEN>
              </IF_TEST>
            </THEN>
          </IF_TEST>
          <IF_TEST Test="$selectedCollatedDomainDetails/DOMAINIDENTIFIER/@Value !=null and $selectedCollatedDomainDetails/DOMAINIDENTIFIER/@Value !='-999999999' and $userAction ='Copy'">
            <THEN>
              <TO_DOCVAR AssignToVar="intmdDominNew">
                <DOMAINDATA>
                  <DOMAINIDENTIFIER Value="-999999999"/>
                  <ENTITY_STATE Value="ACTIVE"/>
                  <SourceSystemMnemonicValue Value="EDM"/>
                </DOMAINDATA>
              </TO_DOCVAR>
              <MAKE_INSTANCE_DOCUMENT Name="DOMAINNAME" AssignToVar="domainName"/>
              <SET DocVar="domainName" Attribute="Value" FromValue="{$selectedCollatedDomainDetails/DOMAINNAME/@Value}"/>
              <MAKE_INSTANCE_DOCUMENT Name="DOMAINMNEMONICVALUE" AssignToVar="domainNmval"/>
              <SET DocVar="domainNmval" Attribute="Value" FromValue="{$selectedCollatedDomainDetails/DOMAINMNEMONICVALUE/@Value}"/>
              <MAKE_INSTANCE_DOCUMENT Name="DOMAINDESCRIPTION" AssignToVar="domaindesc"/>
              <SET DocVar="domaindesc" Attribute="Value" FromValue="{$selectedCollatedDomainDetails/DOMAINDESCRIPTION/@Value}"/>
              <ADD_CHILDREN DocVar="intmdDominNew" FromDocVar="domainName"/>
              <ADD_CHILDREN DocVar="intmdDominNew" FromDocVar="domainNmval"/>
              <ADD_CHILDREN DocVar="intmdDominNew" FromDocVar="domaindesc"/>
              <TO_DOCVAR AssignToVar="newRecordDetails">
                <ROOT>
                  <TO_XML DocVar="intmdDominNew"/>
                </ROOT>
              </TO_DOCVAR>
            </THEN>
            <ELSE>
              <TO_DOCVAR AssignToVar="newRecordDetails">
                <ROOT>
                  <DOMAINDATA>
                    <!--<CSSCLASS Value="gaurav"/>-->
                    <DOMAINIDENTIFIER Value="-999999999"/>
                    <DOMAINNAME Value="EnterNew"/>
                    <DOMAINDESCRIPTION Value="EnterNew"/>
                    <DOMAINMNEMONICVALUE Value="EnterNew"/>
                    <ENTITY_STATE Value="ACTIVE"/>
                    <SourceSystemMnemonicValue Value="EDM"/>
                  </DOMAINDATA>
                </ROOT>
              </TO_DOCVAR>
            </ELSE>
          </IF_TEST>
          <IF_TEST Test="$thisParam/selectedTableName/@Value !=null">
            <THEN>
              <SET Var="SelectedTableName" FromValue="{$thisParam/selectedTableName/@Value}"/>
              <REQUEST AssignToVar="domainDataDetails" Name="getDomainTableData">
                <TO_XML SelectList="$thisParam/*"/>
                <exportTableId Value="{$exportTableId}"/>
              </REQUEST>
              <IF_TEST Test="$addedRecord/_RESULT/_ERROR/@Value !=null">
                <THEN>
                  <PRINTLN Value="DOMAIN DETAILS :::::{$selectedCollatedDomainDetails/DOMAINIDENTIFIER/@Value}"/>
                  <SET Var="selectedDomainIdentifier" FromValue="{$selectedCollatedDomainDetails/DOMAINIDENTIFIER/@Value}"/>
                  <SET_PROPS Select="$domainDataDetails/DOMAINDATAS/*[DOMAINIDENTIFIER[@Value=$selectedDomainIdentifier]]">
                    <DOMAINNAME Value="{$selectedCollatedDomainDetails/DOMAINNAME/@Value}"/>
                    <DOMAINDESCRIPTION Value="{$selectedCollatedDomainDetails/DOMAINDESCRIPTION/@Value}"/>
                    <DOMAINMNEMONICVALUE Value="{$selectedCollatedDomainDetails/DOMAINMNEMONICVALUE/@Value}"/>
                    <ENTITY_STATE Value="{$selectedCollatedDomainDetails/ENTITY_STATE/@Value}"/>
                    <SourceSystemMnemonicValue Value="EDM"/>
                  </SET_PROPS>
                  <PRINTLN Value="DOMAIN DETAILS NEW:::::{$domainDataDetails}"/>
                  <IF_TEST Test="$selectedDomainIdentifier='-999999999'">
                    <THEN>
                      <TO_DOCVAR AssignToVar="newRecordDetails">
                        <ROOT>
                          <DOMAINDATA>
                            <DOMAINIDENTIFIER Value="-999999999"/>
                            <DOMAINNAME Value="{$selectedCollatedDomainDetails/DOMAINNAME/@Value}"/>
                            <DOMAINDESCRIPTION Value="{$selectedCollatedDomainDetails/DOMAINDESCRIPTION/@Value}"/>
                            <DOMAINMNEMONICVALUE Value="{$selectedCollatedDomainDetails/DOMAINMNEMONICVALUE/@Value}"/>
                            <ENTITY_STATE Value="ACTIVE"/>
                            <SourceSystemMnemonicValue Value="EDM"/>
                          </DOMAINDATA>
                        </ROOT>
                      </TO_DOCVAR>
                    </THEN>
                  </IF_TEST>
                  <TO_DOCVAR AssignToVar="domainDetailswithNew">
                    <DOMAINDATAS TotalRowCount="{$domainDataDetails/DOMAINDATAS/@TotalRowCount}">
                      <TO_XML SelectList="$addedRecord/REQUEST/_ERRORS"/>
                      <TO_XML SelectList="$newRecordDetails/*"/>
                      <TO_XML SelectList="$domainDataDetails/DOMAINDATAS/DOMAINDATA"/>
                    </DOMAINDATAS>
                  </TO_DOCVAR>
                </THEN>
                <ELSE>
                  <TO_DOCVAR AssignToVar="domainDetailswithNew">
                    <DOMAINDATAS TotalRowCount="{$domainDataDetails/DOMAINDATAS/@TotalRowCount}">
                      <TO_XML SelectList="$addedRecord/REQUEST/_ERRORS"/>
                      <TO_XML SelectList="$newRecordDetails/*"/>
                      <TO_XML SelectList="$domainDataDetails/DOMAINDATAS/DOMAINDATA"/>
                    </DOMAINDATAS>
                  </TO_DOCVAR>
                </ELSE>
              </IF_TEST>
              <PRINTLN Value="DOMAIN DATA DETAILS::::{$domainDetailswithNew}"/>
            </THEN>
          </IF_TEST>
          <PRINTLN Value="USER ACTION::::::{$userAction}"/>
          <IF_TEST Test="($userAction ='Create' or $userAction ='Update') and $addedRecord/_RESULT/_ERROR/@Value =null">
            <THEN>
              <IF_TEST Test="$thisParam/selectedDOMAINIDENTIFIER/@Value ='-999999999'">
                <THEN>
                  <SET Var="sucessMessage" FromValue="Record successfully Created"/>
                </THEN>
                <ELSE>
                  <SET Var="sucessMessage" FromValue="Record successfully Modified"/>
                </ELSE>
              </IF_TEST>
            </THEN>
            <ELSE>
              <IF_TEST Test="$userAction ='Delete' and $addedRecord/_RESULT/_ERROR/@Value =null">
                <THEN>
                  <SET Var="sucessMessage" FromValue="Record successfully deleted"/>
                </THEN>
              </IF_TEST>
            </ELSE>
          </IF_TEST>
          <IF_TEST Test="$thisParam/BUTTON_ID/@Value ='SYS_RELOAD' or $userAction ='Clear' or  $userAction ='DisplayData' or $userAction ='Create' or $userAction ='Update'">
            <THEN>
              <IF_TEST Test="$addedRecord/_RESULT/_ERROR/@Value =null">
                <THEN>
                  <REMOVE_CHILDREN ChildName="selectedDOMAINIDENTIFIER" DocVar="thisParam"/>
                </THEN>
              </IF_TEST>
            </THEN>
          </IF_TEST>
          <IF_TEST Test="$userAction ='Copy'">
            <THEN>
              <REMOVE_CHILDREN ChildName="selectedDOMAINIDENTIFIER" DocVar="thisParam"/>
              <TO_DOCVAR AssignToVar="thisAppend">
                <INPUT>
                  <selectedDOMAINIDENTIFIER Value="-999999999"/>
                </INPUT>
              </TO_DOCVAR>
              <ADD_CHILDREN DocVar="thisParam" FromSelectList="$thisAppend/*"/>
            </THEN>
          </IF_TEST>
          <TO_DOCVAR AssignToVar="pglFormInput">
            <RESPONE>
              <ROOT TotalRowCount="{$check/@TotalRowCount}">
                <SUCESSMESSAGE Value="{$sucessMessage}"/>
                <FILTER_ENTITY_STATE Value="{$thisParam/FILTER_ENTITY_STATE/@Value}"/>
                <TO_XML SelectList="$check/*"/>
                <IF_TEST Test="$donotshowtable!=1">
                  <THEN>
                    <TO_XML SelectList="$domainDetailswithNew"/>
                  </THEN>
                </IF_TEST>
                <DISPLAYLL Value="{concat($SelectedTableName,'  Domain Data')}"/>
                <SELECTEDDOMAINTABLENAME Value="{$SelectedTableName}"/>
                <SELECTEDDOMAINIDENTIFIER Value="{$thisParam/selectedDOMAINIDENTIFIER/@Value}"/>
                <STATUSOPTION>
                  <OPTION Value="ACTIVE"/>
                  <OPTION Value="INACTIVE"/>
                  <OPTION Value="DELETED"/>
                </STATUSOPTION>
              </ROOT>
            </RESPONE>
          </TO_DOCVAR>
          <APPEND_TO_XML DocVar="pglFormInput">
            <FILTER_ID Value="{$exportTableId}"/>
          </APPEND_TO_XML>
        </action>
      </pre_actions>
      <post_actions>
        <action>
          <IF_TEST Test="$userAction='ChangeLog'">
