<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="uiWfRPLayersSearch.pgl">
  <ui:search displayText="Search RP Layers" exportSearch="false" saveSearch="false" collapsable="false">
    <ui:validation id="tst" displayCondition="asdf" />
        <ui:field-group id="fieldGroups" columns="2" select="$root">
          <ui:dropdown id="SRCH_ENGINE" name="SRCH_ENGINE" displayText="Engine Id" selectAll="true" optionSrc="$root/Engine/ID" />
          <ui:entry-field displayText="Layer Name" id="SRCH_LAYER" name="SRCH_LAYER">
            <ui:links>
              <ui:link displayText="Select Layer" targetType="popup" targetName="orderPopup">
                <ui:image src="pop_up_window.gif" />
                <ui:url page="view.x2ps">
                  <FIELD_NAME select="'SRCH_LAYER'" />
                  <ENTITY_NAME select="'SRCH_LAYER'" />
                  <SELECTABLE select="'All'" />
                  <BUTTON_ID select="'selectLayers'" />
                </ui:url>
              </ui:link>
            </ui:links>
          </ui:entry-field>
      <ui:dropdown name="SRCH_DMNDTYP" displayText="Demand Type " selectAll="true" optionSrc="$root/DemandType/ID" />
          <ui:entry-field id="SRCH_MOD_BY" name="SRCH_MOD_BY" displayText="Modified By" rowSpan="2" />
        </ui:field-group>
    <ui:field-group id="dateRange" select="$root">
      <!--          <ui:date-range displayText="Modified Date" name="SRCH_MOD_DATE" fromDate="$root/FROM_DATE/@Value" toDate="$root/TO_DATE/@Value"/>-->
      <ui:date-range name="SRCH_MOD_DATE" displayText="Modified Date Range" fromDate="{FROM_SRCH_MOD_DATE/@Value}" toDate="{TO_SRCH_MOD_DATE/@Value}" />
    </ui:field-group>
      </ui:search>
  <ui:container id="container" name="container" scrollable="true">
    <ui:step id="top_container" name="top_container" scrollable="true" displayText="">
      <ui:validation successMessage="{$root/SUCCESSMSG/MSG/@Value}" anyFieldIsRequired="false" />
      <ui:table displayText="RP Layers" rowSrc="$root/LAYER_DETAILS_LIST/LAYER_DETAILS" totalRowCount="{$root/ROWCOUNT/@Value}" maxRows="10" selectable="All" rowId="EngineIdLayerNameCombo" postRowIdAs="SelectedLayer" id="LayerDetails">
        <ui:field-group>
          <ui:entry-field displayText="Engine Id" name="EngineId" editable="false" />
          <ui:hidden-field name="EngineIdLayerNameCombo" />
          <ui:entry-field displayText="Layer Name" name="DemandCategoryName" editable="false" />
          <ui:entry-field displayText="Analytical Model Name" name="AnalyticalModelName" editable="false" />
          <ui:entry-field displayText="AllocationBandText" name="AllocationBandText" />
          <ui:entry-field displayText="AllocationBandText Comment" name="AllocationBandTextCommentText" />
          <ui:entry-field displayText="LayerEffectiveEndDayNumber" name="LayerEffectiveEndDayNumber" type="Number" />
          <ui:entry-field displayText="LayerEffectiveStartDayNumber" name="LayerEffectiveStartDayNumber" type="Number" />
          <!--<ui:entry-field displayText="DemandType" name="DemandType"/>-->
          <ui:dropdown displayText="DemandType" name="DemandType" value="{$root/LAYER_DETAILS_LIST/LAYER_DETAILS/DemandType/@Value}">
            <ui:option id="SalesOrder" value="SalesOrder" />
            <ui:option id="Forecast" value="Forecast" />
          </ui:dropdown>
          <ui:entry-field id="DemandCategoryPriorityNumber" name="DemandCategoryPriorityNumber" displayText="DemandCategoryPriorityNumber" sortable="true" type="Number" />
          <ui:display-field id="ModifiedBy" name="ModifiedBy" displayText="Modified By" sortable="true" />
          <ui:display-field id="LAST_MODIFIED_DATE" name="LAST_MODIFIED_DATE" displayText="Last Modified" sortable="true" />
        </ui:field-group>
        <ui:buttons id="tableButtons">
          <ui:button displayText="Show History" id="ShowHistory" name="ShowHistory" enabledBySelections="true" validate="false" />
          <ui:divider />
          <ui:button displayText="Mass Update" id="MassUpdate" name="MassUpdate" enabledBySelections="true" validate="false" />
          <ui:divider />
          <ui:button displayText="Delete" id="Delete" name="Delete" enabledBySelections="true" />
          <ui:divider />
          <ui:button displayText="Copy" id="copy" name="copy" enabledBySelections="true" validate="false" onClick="javaScript:checkCopy('LayerDetails')" />
          <ui:button displayText="Create" id="create" name="create" enabledBySelections="false" validate="false" />
          <ui:divider />
          <ui:button displayText="Save" id="Save" name="Save" enabledBySelections="true" validate="false" />
        </ui:buttons>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:script>function checkCopy(tableid)
		{

		var table = document.getElementById(tableid+"_data");
		var count=0,j;
		var a=document.getElementsByName('SelectedLayer');
										//alert(a);
		for( k=0; k &lt;a.length;k++)
		{
		
		if(a[k].checked)
		{
		count++;
		}
		}

		if(count&gt;=2){
		core_alert('Copy One Record at a time');
		}else{

				 document.form.BUTTON_ID.value="copy";

                document.form.submit();
		}
		}</ui:script>
</ui:page-group>

