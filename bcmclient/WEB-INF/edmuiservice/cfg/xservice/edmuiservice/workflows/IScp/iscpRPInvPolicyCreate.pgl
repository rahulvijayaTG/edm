<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="iscpRPInvPolicyCreate.pgl">
  <ui:table displayText="" rowSrc="$root/INV_POLICY_DETAILS_LIST/INV_POLICY_DETAILS">
    <ui:validation successMessage="{$root/SUCCESSMSG/MSG/@Value}" anyFieldIsRequired="true" />
    <ui:field-group>
      <ui:dropdown name="SegmentNumber" id="SegmentNumber" displayText="Segment" optionSrc="$root/Segment/ID" />
      <!-- <ui:entry-field name="SegmentNumber" id="SegmentNumber" displayText="Segment" readOnly="true"/>-->
      <!-- <ui:dropdown name="LocationIdentificationValue" id="LocationIdentificationValue" displayText="Location" sortable="false" optionSrc="$root/Location/ID" value="{LocationIdentificationValue/@Value}" selectOne="true" onChange="javaScript:fetchSegmentName()" required="true"/>-->
      <!-- <ui:entry-field displayText="Location" name="LOC_NUM" id="LOC_NUM">-->
      <ui:entry-field displayText="Location Number" name="LocationIdentificationValue" id="LocationIdentificationValue" required="true">
        <ui:links>
          <ui:link displayText="Select Locations" onClick="javascript:selectlocation()">
            <ui:image src="pop_up_window.gif" />
          </ui:link>
        </ui:links>
      </ui:entry-field>
      <!--<ui:dropdown name="ItemIdentificationValue" id="ItemIdentificationValue" displayText="Item" sortable="false" optionSrc="$root/Item/ID" value="{ItemIdentificationValue/@Value}" onChange="javaScript:fetchSegmentName()"/>-->
      <!--			<ui:entry-field displayText="Item" name="Item_Number" id="Item_Number">-->
      <ui:entry-field displayText="Item Number" name="ItemIdentificationValue" id="ItemIdentificationValue" required="true">
        <ui:links>
          <ui:link displayText="Select Item" onClick="javascript:selectItem()">
            <ui:image src="pop_up_window.gif" />
          </ui:link>
        </ui:links>
      </ui:entry-field>
      <ui:entry-field name="MaximumCoverageDaysNumber" id="MaximumCoverageDaysNumber" displayText="Max Coverage Days" sortable="false" dataType="Number" required="true" minValue="0" />
      <ui:dropdown name="ReplenishmentBandProfile" id="ReplenishmentBandProfile" displayText="Max Inventory Bands" sortable="false" optionSrc="$root/BAND_PROFILES/ID" value="{ReplenishmentBandProfile/@Value}" required="true" />
      <ui:dropdown name="DeploymentPolicy" id="DeploymentPolicy" displayText="Deployment Policy" sortable="false" optionSrc="$root/DEPLOYMENT_POLICY/ID" value="{DeploymentPolicy/@Value}" required="true" />
      <ui:entry-field name="EffectiveStartDate" id="EffectiveStartDate" displayText="Effective Start Date" sortable="false" editable="true" dataType="Date" required="true" />
      <ui:entry-field name="EffectiveEndDate" id="EffectiveEndDate" displayText="Effective End Date" sortable="false" editable="true" dataType="Date" required="true" />
      <!--   <ui:hidden-field name="ItemIdentifier" id="ItemIdentifier"/>-->
      <ui:hidden-field name="ItemUnitOfMeasureValue" id="ItemUnitOfMeasureValue" />
      <!--      <ui:hidden-field name="LocationIdentifier" id="LocationIdentifier"/>
  <ui:hidden-field name="LocationXItemStartDatetime" id="LocationXItemStartDatetime"/>-->
      <!-- <ui:entry-field name="MaximumCoverageDaysCommentText" id="MaximumCoverageDaysCommentText" displayText="Max Coverage Days Comment" sortable="false"/>
      <ui:entry-field name="ReplenishmentBandProfileCommentText" id="ReplenishmentBandProfileCommentText" displayText="Replenishment BandProfile Comment" sortable="false"/>
      <ui:entry-field name="DeploymentPolicyCommentText" id="DeploymentPolicyCommentText" displayText="Deployment Policy Comment" sortable="false"/>
      <ui:entry-field name="LAST_MODIFIED_BY" id="LAST_MODIFIED_BY" displayText="Modified By" sortable="false" editable="false"/>
      <ui:entry-field name="LAST_MODIFIED_DATE" id="LAST_MODIFIED_DATE" displayText="Last Modified" sortable="false" editable="false"/>-->
    </ui:field-group>
    <ui:buttons id="btnGrp">
      <!-- RIC: 240988 Praneeth - Cancel button wording changes request - Start -->
      <ui:button id="Cancel" displayText="Back to Search" emphasized="true" validate="false" />
      <!-- RIC: 240988 Praneeth - Cancel button wording changes request - End -->
      <ui:button id="Save" displayText="Save" emphasized="true" validate="true" />
    </ui:buttons>
  </ui:table>
  <ui:script>
    function fetchSegmentName()
		{



				 document.form.BUTTON_ID.value="fetchSegment";

                document.form.submit();
		
		}
    <!--*********************Loc Popup js ******************-->
    function selectlocation(){
		var LocationIdentificationValue=document.form.LocationIdentificationValue.value;
    <!--	var locdesc= document.form.ITEMDESC.value;-->
    <!--		var loctype = document.form.LOCTYPE.value;-->
    var Item = document.form.ItemIdentificationValue.value;
		//alert(LocationIdentificationValue);
	//	alert(loctype);
	
		var segment = '';
		var a = document.getElementById('SegmentNumber');
		//alert(a.length);
 		for( k=0; k &lt;a.length;k++)
		{
if(a[k].selected)
		{
		if(segment != '')
		{
		segment = segment + ',';
		}
		segment = segment + a[k].value;
		
		}
		}
	
		//alert(segment);
			window.open('view.x2ps?SERVICE_NAME=edmuiservice&amp;START_WORKFLOW=wfTLSelectLocation&amp;FIELD_NAME=LocationIdentificationValue&amp;SELECTABLE=All&amp;POPUP=true&amp;SRCH_LOC_ID='+LocationIdentificationValue+'&amp;SRCH_SGMNT_ID='+segment+'&amp;SRCH_ITEM_ID='+Item,null,'height=480,width=740,screenX=400,screenY=400,top=200,left=250,toolbar=yes,menubar=no');
    <!--	window.open('view.x2ps?SERVICE_NAME=edmuiservice&amp;START_WORKFLOW=wfPiSelecLocation&amp;FIELD_NAME=LocationIdentification&amp;SELECTABLE=All&amp;POPUP=true&amp;GroupIdentifier='+groupidentifier+'&amp;GroupLineInfo='+linenumbers,null,'height=480,width=740,screenX=400,screenY=400,top=200,left=250,toolbar=yes,menubar=no');-->
    }
		
		function selectItem(){
		var LocationIdentificationValue=document.form.LocationIdentificationValue.value;
    <!--		var Itemdesc= document.form.ITEMDESC.value;-->
    <!--		var gtin = document.form.UniformCodeCouncilNumberValue.value;-->
    var Item = document.form.ItemIdentificationValue.value;
    <!--		var ItemType = document.form.MATTYPE.value;-->
    var segment = '';
		//alert(a.length);
		var a = document.getElementById('SegmentNumber');
 		for( k=0; k &lt;a.length;k++)
		{
if(a[k].selected)
		{
		if(segment != '')
		{
		segment = segment + ',';
		}
		segment = segment + a[k].value;
		
		}
		}
 		

			window.open('view.x2ps?SERVICE_NAME=edmuiservice&amp;START_WORKFLOW=wfTLSelectItem&amp;FIELD_NAME=ItemIdentificationValue&amp;SOURCE=RP&amp;SELECTABLE=All&amp;POPUP=true&amp;SRCH_LOC_ID='+LocationIdentificationValue+'&amp;SRCH_SGMNT_ID='+segment+'&amp;SRCH_ITEM_ID='+Item,null,'height=480,width=740,screenX=400,screenY=400,top=200,left=250,toolbar=yes,menubar=no');
    <!--  document.form.ItemIdentificationValue.focus();-->
    }
  </ui:script>
</ui:page-group>

