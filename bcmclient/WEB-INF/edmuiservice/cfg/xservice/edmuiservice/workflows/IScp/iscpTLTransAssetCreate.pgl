<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="TLTransAssetCreate.pgl">
  <ui:container id="cnt" scrollable="true">
    <ui:step id="stp" displayText="Create New Transportation Asset">
      <ui:validation successMessage="{$root/SUCCESS_MESSAGE/@Value}" />
      <ui:field-group columns="2" id="fg">
        <ui:hidden-field id="START_COUNT" name="START_COUNT" />
        <ui:entry-field displayText="Asset Number" name="TransportationAssetValue" required="true" readOnly="true" />
        <ui:entry-field displayText="Asset Description" name="TransportationAssetDescription" required="true" />
        <ui:entry-field displayText="Default Asset Cube" name="DefaultAssetCubeMeasure" required="true" dataType="Number" decimals="0" maxlength="13" minValue="1" />
        <ui:dropdown displayText="Asset Cube UOM" name="DefaultAssetCubeUnitOfMeasureValue" selectAll="false" optionSrc="$root/UOM_VALUES1/*" selectOne="true" required="true" />
        <ui:entry-field displayText="Default Asset Weight" name="DefaultAssetWeightMeasure" required="true" dataType="Number" decimals="0" maxlength="13" minValue="1" />
        <ui:dropdown displayText="Asset Weight UOM" name="DefaultAssetWeightUnitOfMeasureValue" selectAll="false" optionSrc="$root/UOM_VALUES/*" selectOne="true" required="true" />
        <ui:entry-field displayText="Number of Asset Pallets   " name="DefaultPalletAssetCount" required="true" dataType="Number" decimals="0" maxlength="11" minValue="1" />
        <ui:textarea name="TransportationAssetCommentText" displayText="Comments" required="false" />
      </ui:field-group>
      <ui:buttons id="buttons1" name="buttons1">
        <!-- RIC: 240988 Praneeth - Cancel button wording changes request - Start -->
        <ui:button displayText="Back to Search" id="cancel" name="cancel" validate="false" />
        <!-- RIC: 240988 Praneeth - Cancel button wording changes request - End -->
        <ui:button displayText="Save" id="save_create" name="save_create" />
      </ui:buttons>
    </ui:step>
  </ui:container>
  <ui:script>function on_save_create(){
 
 var bIsValid = true;
 document.form.SUBMIT_AS_XML.value = 'false';

bIsValid = (isValid_stp());
 
if( bIsValid == false )
{
  validation_alert('stp');
}
if ( bIsValid == true) 
{
		var assetDesc =  document.form.TransportationAssetDescription.value;
		var noOfPallets =  document.form.DefaultPalletAssetCount.value;		
		/*var assetCubeUOM =  document.form.DefaultAssetCubeUnitOfMeasure.value;
		var assetWeightUOM =  document.form.DefaultAssetWeightUnitOfMeasure.value;				
		if (assetCubeUOM.length == 0) {
							core_alert("Please enter the value for Asset Cube UOM!")
							bIsValid = false;
							return;
					}				
		if (assetWeightUOM.length == 0) {
							core_alert("Please enter the value for Asset weight UOM!")
							bIsValid = false;
							return;
					}	*/

	if (document.form.DefaultAssetWeightMeasure.value == 0) {
							core_alert("Please enter positive value for Asset Weight Measure !")
							bIsValid = false;
							return;
		      }
			if (document.form.DefaultAssetCubeMeasure.value == 0) {
							core_alert("Please enter positive value for Asset Cube Measure !")
							bIsValid = false;
							return;
		      }
		if (document.form.DefaultPalletAssetCount.value == 0) {
							core_alert("Please enter positive value for Number of Asset Pallets !")
							bIsValid = false;
							return;
		      }
		document.form.DefaultPalletAssetCount.value = floor(noOfPallets);
		document.form.TransportationAssetDescription.value = trimString(assetDesc);
   	        disableButtons(); 
		trapExcelPivotChanges(); 
		document.form.BUTTON_ID.value = 'save_create'; 
		document.form.action = 'view.x2ps';
		document.form.submit();  		
}		    
		    onResize();  
		    return; 
		}</ui:script>
</ui:page-group>

