<ui:page-group xmlns:ui="http://www.i2.com/ui" name="studio.templates.simple_entry" source="studio.controller:load">
  <ui:container id="container">
    <ui:step id="top_container" displayText="RP Inventory Policy Search">
      <ui:validation successMessage="{$root/SUCCESSMSG/MSG/@Value}" displayCondition="asdf" />
      <ui:search displayText="Search" saveSearch="false" exportSearch="false">
        <ui:field-group columns="2" select="$root/SEARCH_FIELDS">
          <ui:field-group>
            <ui:dropdown id="PartyIdentificationValue" preferredWidth="10" name="PartyIdentificationValue" displayText="Segment" selectAll="true" selectOne="false" optionSrc="$root/Segments/*" />
            <ui:entry-field displayText="Location Description" name="LOCDESC" />
            <ui:dropdown id="LOCTYPE" name="LOCTYPE" displayText="Location Type" selectAll="true" optionSrc="$root/LocTypes/*" />
            <ui:entry-field displayText="Location" name="LOC_NUM" id="LOC_NUM">
              <ui:links>
                <ui:link displayText="Select Locations" targetType="popup" targetName="catalogPopup">
                  <ui:image src="pop_up_window.gif" />
                  <ui:url page="view.x2ps">
                    <FIELD_NAME select="'LOC_NUM'" />
                    <SELECTABLE select="'All'" />
                    <BUTTON_ID select="'selectLocation'" />
                  </ui:url>
                </ui:link>
              </ui:links>
            </ui:entry-field>
            <ui:entry-field id="SRCH_MOD_BY" name="SRCH_MOD_BY" displayText="Modified By" rowSpan="2" />
          </ui:field-group>
          <ui:field-group>
            <ui:entry-field displayText="Item Description" name="ITEMDESC" />
            <ui:entry-field displayText="Item Number" name="Item_Number" id="Item_Number">
              <ui:links>
                <ui:link displayText="Select Item" targetType="popup" targetName="catalogPopup">
                  <ui:image src="pop_up_window.gif" />
                  <ui:url page="view.x2ps">
                    <FIELD_NAME select="'Item_Number'" />
                    <SELECTABLE select="'All'" />
                    <BUTTON_ID select="'selectItem'" />
                  </ui:url>
                </ui:link>
              </ui:links>
            </ui:entry-field>
            <!-- <ui:entry-field displayText="GTIN #" name="GTIN" id="GTIN">
              <ui:links>
                <ui:link displayText="Select GTIN" targetType="popup" targetName="planPopUp">
                  <ui:image src="pop_up_window.gif"/>
                  <ui:url page="view.x2ps">
                    <FIELD_NAME select="'GTIN'"/>
                  
                    <SELECTABLE select="'All'"/>
                    <BUTTON_ID select="'SelectGTIN'"/>
                  </ui:url>
                </ui:link>
              </ui:links>
            </ui:entry-field>-->
            <ui:dropdown id="MATTYPE" name="MATTYPE" displayText="Material Type" selectAll="true" optionSrc="$root/ItemTypes/*" />
          </ui:field-group>
          <ui:field-group id="dateRange" select="$root">
            <!--          <ui:date-range displayText="Modified Date" name="SRCH_MOD_DATE" fromDate="$root/FROM_DATE/@Value" toDate="$root/TO_DATE/@Value"/>-->
            <ui:date-range name="SRCH_MOD_DATE" displayText="Modified Date Range" fromDate="{FROM_SRCH_MOD_DATE/@Value}" toDate="{TO_SRCH_MOD_DATE/@Value}" />
          </ui:field-group>
        </ui:field-group>
      </ui:search>
      <ui:table displayText="RP Inventory Policy Parameters" rowSrc="$root/INV_POLICY_DETAILS_LIST/INV_POLICY_DETAILS" totalRowCount="$root/ROWCOUNT/@Value" maxRows="10" selectable="All" rowId="ItemLocCombo" postRowIdAs="SelectedItemLoc" id="InvPolicyDetails" doPaging="true">
        <ui:validation successMessage="{$root/SUCCESSMSG/MSG/@Value}" anyFieldIsRequired="false" />
        <ui:field-group>
          <ui:hidden-field name="ItemLocCombo" />
          <ui:entry-field name="SegmentNumber" id="SegmentNumber" displayText="Segment" editable="false" />
          <ui:entry-field name="ItemIdentificationValue" id="ItemIdentificationValue" displayText="Item" sortable="false" editable="false" />
          <ui:entry-field name="ItemDescription" id="ItemDescription" displayText="Item Desc" sortable="false" editable="false" />
          <ui:entry-field name="ItemType" id="ItemType" displayText="Material Type" sortable="false" editable="false" />
          <ui:entry-field name="LocationIdentificationValue" id="LocationIdentificationValue" displayText="Location" sortable="false" editable="false" />
          <ui:entry-field name="LocationDescription" id="LocationDescription" displayText="Location Desc" sortable="false" editable="false" />
          <ui:entry-field name="LocationType" id="LocationType" displayText="Location Type" sortable="false" editable="false" />
          <!--  <ui:entry-field name="GTIN" id="GTIN" displayText="GTIN #" sortable="false" editable="false"/>-->
          <ui:entry-field name="MaximumCoverageDaysNumber" id="MaximumCoverageDaysNumber" displayText="Max Coverage Days" sortable="false" />
          <ui:dropdown name="ReplenishmentBandProfile" id="ReplenishmentBandProfile" displayText="Replenishment Band Profile" sortable="false" optionSrc="$root/BAND_PROFILES/ID" value="{ReplenishmentBandProfile/@Value}" />
          <ui:dropdown name="DeploymentPolicy" id="DeploymentPolicy" displayText="Deployment Policy" sortable="false" optionSrc="$root/DEPLOYMENT_POLICY/ID" value="{DeploymentPolicy/@Value}" />
          <ui:entry-field name="EffectiveStartDate" id="EffectiveStartDate" displayText="Effective Start Date" sortable="false" editable="false" />
          <ui:entry-field name="EffectiveEndDate" id="EffectiveEndDate" displayText="Effective End Date" sortable="false" editable="true" />
          <ui:entry-field name="MaximumCoverageDaysCommentText" id="MaximumCoverageDaysCommentText" displayText="Max Coverage Days Comment" sortable="false" />
          <ui:entry-field name="ReplenishmentBandProfileCommentText" id="ReplenishmentBandProfileCommentText" displayText="Replenishment BandProfile Comment" sortable="false" />
          <ui:entry-field name="DeploymentPolicyCommentText" id="DeploymentPolicyCommentText" displayText="Deployment Policy Comment" sortable="false" />
          <ui:entry-field name="LAST_MODIFIED_BY" id="LAST_MODIFIED_BY" displayText="Modified By" sortable="false" editable="false" />
          <ui:entry-field name="LAST_MODIFIED_DATE" id="LAST_MODIFIED_DATE" displayText="Last Modified" sortable="false" editable="false" />
          <ui:hidden-field name="SourceSystemMnemonicValue" id="SourceSystemMnemonicValue" />
        </ui:field-group>
        <ui:buttons id="tableButtons">
          <ui:button displayText="Mass Update" id="MassUpdate" name="MassUpdate" enabledBySelections="true" />
          <ui:divider />
          <ui:button displayText="Save" id="Save" name="Save" enabledBySelections="true" />
          <ui:divider />
          <ui:button displayText="Create" id="create" name="create" enabledBySelections="false" />
          <ui:divider />
          <ui:button displayText="Copy" id="copy" name="copy" enabledBySelections="true" onClick="javaScript:checkCopy('InvPolicyDetails')" />
          <ui:divider />
          <ui:button displayText="Delete" id="Delete" name="Delete" enabledBySelections="true" />
        </ui:buttons>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:script>function checkCopy(tableid)
		{

		var table = document.getElementById(tableid+"_data");
		var count=0,j;
		var a=document.getElementsByName('SelectedItemLoc');
										//alert(a);
		for( k=0; k &lt;a.length;k++)
		{
		
		if(a[k].checked)
		{
		count++;
		}
		}

		if(count&gt;=2){
		core_alert('Copy One Record at a time');
		}else{

				 document.form.BUTTON_ID.value="copy";

                document.form.submit();
		}
		}</ui:script>
</ui:page-group>

