<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="iscppigrpsearchnedit.pgl">
  <ui:search name="grpLnSrch" displayText="Group and Line Search" anyFieldIsRequired="false" collapsable="true" exportSearch="false" saveSearch="false">
    <ui:validation displayCondition="dummy" />
    <ui:field-group id="Search Parameters" columns="2" select="$root/SEARCH_FIELDS">
      <ui:entry-field name="InterchangeGroupMnValue" displayText="Group ID">
        <ui:links>
          <ui:link displayText="Select Group" targetType="popup" targetName="planPopUp">
            <ui:image src="pop_up_window.gif" />
            <ui:url page="view.x2ps">
              <FIELD_NAME select="'InterchangeGroupMnValue'" />
              <ENTITY_NAME select="'InterchangeGroupMnValue'" />
              <!--<ROW_ID_NAME select="'ItemInterchangeGroupIdentifier'"/>-->
              <ROW_ID_VALUE select="'InterchangeGroupMnValue/@Value'" />
              <SELECT select="'All'" />
              <BUTTON_ID select="'SEARCH_GRP_ID'" />
            </ui:url>
          </ui:link>
        </ui:links>
      </ui:entry-field>
      <ui:textarea name="InterchangeGroupDesc" displayText="Group Description" displayNoWrap="false" />
      <ui:dropdown name="InterchangeGroupStatus" displayText="Group Status" optionSrc="$root/GRP_STS/*" selectAll="false" />
      <ui:entry-field name="PrimaryItemIdentifier" displayText="Successor Product">
        <ui:links>
          <ui:link displayText="Select Product" targetType="popup" targetName="planPopUp">
            <ui:image src="pop_up_window.gif" />
            <ui:url page="view.x2ps">
              <FIELD_NAME select="'PrimaryItemIdentifier'" />
              <SELECTABLE select="'All'" />
              <SOURCE select="'PI'" />
              <ITEM_TYPE select="'FIN'"/>
              <BUTTON_ID select="'SEARCH_PRD_PDT'" />
            </ui:url>
          </ui:link>
        </ui:links>
      </ui:entry-field>
      <ui:entry-field name="RelatedItemIdentifier" displayText="Predecessor Product">
        <ui:links>
          <ui:link displayText="Select Product" targetType="popup" targetName="planPopUp">
            <ui:image src="pop_up_window.gif" />
            <ui:url page="view.x2ps">
              <FIELD_NAME select="'RelatedItemIdentifier'" />
              <SELECTABLE select="'All'" />
              <SOURCE select="'PI'" />
              <ITEM_TYPE select="'FIN'"/>
              <BUTTON_ID select="'SEARCH_SUCC_PDT'" />
            </ui:url>
          </ui:link>
        </ui:links>
      </ui:entry-field>
      <!--  <ui:entry-field name="modifiedby" displayText="Modified By">
        <ui:links>
          <ui:link displayText="Select Users" targetType="popup" targetName="catalogPopup">
            <ui:url page="view.x2ps">
              <SELECTABLE select="'All'" />
              <BUTTON_ID select="'Select_User'" />
              <FIELD_NAME select="'modifiedby'" />
            </ui:url>
            <ui:image src="pop_up_window.gif" />
          </ui:link>
        </ui:links>
      </ui:entry-field>-->
      <!--<ui:date-range name="modifieddate" displayText="Modified Date Range" fromDate="{$root/var/fromdate/@Value}" toDate="{$root/var/todate/@Value}"/>-->
    </ui:field-group>
  </ui:search>
  <ui:container id="SearchResults" displayText="Group and Line Search Results" collapsable="false" scrollable="true">
    <ui:step id="SearchResults" displayText="Group and Line Search Results">
      <ui:validation anyFieldIsRequired="false" successMessage="{$root/SUCCESS_MESSAGE/@Value}" />
      <ui:table id="grpLnSearchResults" displayText="Group and Line Search Results" displayTextNoRecords="No Records Found" exportable="true" rowSubTreeSrc="GRP_LINES/ P_ItemInterchangeGroup" rowSrc="$root/GRP" rowId="GroupId" postRowIdAs="SELECTED_GRP_ID" collapsable="false" maxRows="$root/MaxRows/@Value" totalRowCount="$root/TotalRowCount/@Value" startAtRow="$root/START_AT_ROW/@Value" rememberSelections="true" selectable="All" rowSelectorCondition="{GrpStatus/@Value = 'IN PROCESS'}">
        <ui:field-group id="tablefg">
          <ui:treecell id="GroupId" name="GroupId" displayText="Group ID" noChildren="{count(GRP_LINES/P_ItemInterchangeGroup) = 0}" depth="{count(ancestor::node()[name()='P_ItemInterchangeGroup'])}" column="0" />
          <ui:hidden-field id="GroupId_uniq" name="GroupId_uniq" />
          <ui:choose-field name="GroupDesc" displayText="Group Description">
            <ui:when test="count(GroupDesc) &gt; 0">
              <ui:textarea name="GroupDesc" displayText="Group Description" required="true" />
            </ui:when>
            <ui:otherwise>
              <ui:display-field name="GroupDesc" />
            </ui:otherwise>
          </ui:choose-field>
          <!--<ui:choose-field name="GrpStatus" displayText="Group Status">
            <ui:when test="count(GrpStatus) > 0">-->
          <ui:display-field name="GrpStatus" displayText="Group Status" />
          <!--</ui:when>
            <ui:otherwise/>
          </ui:choose-field>-->
          <ui:entry-field name="GrpLineId" displayText="Group Line ID" editable="false" align="left" dataType="Number" />
          <ui:display-field name="PredPdt" displayText="Predecessor Product" />
          <ui:display-field name="PrdPdtDesc" displayText="Predecessor Product Description" />
          <ui:display-field name="SuccPdt" displayText="Successor Product" />
          <ui:display-field name="SuccPdtDesc" displayText="Successor Product Description" />
          <ui:choose-field name="ConversionFactorRate" displayText="Conversion Ratio">
            <ui:when test="count(ConversionFactorRate) &gt; 0">
              <ui:entry-field name="ConversionFactorRate" displayText="Conversion Factor" />
            </ui:when>
            <ui:otherwise>
              <ui:display-field name="ConversionFactorRate" displayText="Conversion Ratio" />
            </ui:otherwise>
          </ui:choose-field>
          <ui:choose-field name="ItemInterchangeRsnVal" displayText="Product Interchange Reason">
            <ui:when test="count(ItemInterchangeRsnVal) &gt; 0">
              <ui:dropdown name="ItemInterchangeRsnVal" displayText="Product Interchange Reason" optionSrc="$root/INTR_RSN/*" />
            </ui:when>
            <ui:otherwise>
              <ui:display-field name="ItemInterchangeRsnVal" displayText="Product Interchange Reason" />
            </ui:otherwise>
          </ui:choose-field>
          <!-- Multi User Enhancement Dt:02/11/2008 Venkat Mekala Code Start -->
          <ui:hidden-field id="DateModified" name="DateModified" displayText="Last Modified Date" editable="false" align="left" />
          <!-- Multi User Enhancement Dt:02/11/2008 Venkat Mekala Code End -->
        </ui:field-group>
        <ui:buttons id="buttons">
          <ui:button id="Save" name="Save" displayText="Save" enabledBySelections="true" displayCondition="{contains($root/AccessLevel/@Value,'Update')}" />
        </ui:buttons>
      </ui:table>
    </ui:step>
  </ui:container>
</ui:page-group>

