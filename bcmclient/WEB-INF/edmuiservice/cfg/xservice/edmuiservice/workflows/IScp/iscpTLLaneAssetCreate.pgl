<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="TLLaneAssetCreate.pgl">
  <ui:container id="cnt" scrollable="true">
    <ui:step id="stp" displayText="Create New Lane Asset Assignment">
      <ui:validation successMessage="{$root/SUCCESS_MESSAGE/@Value}" />
      <ui:field-group id="new" columns="2">
        <ui:hidden-field id="START_COUNT" name="START_COUNT" />
        <ui:entry-field name="TransportLaneIdentifier" displayText="Lane Name" required="true">
          <ui:links>
            <ui:link displayText="Select Lane" targetType="popup" targetName="catalogPopup">
              <ui:url page="view.x2ps">
                <BUTTON_ID select="'Select_tl_id'" />
                <FIELD_NAME select="'TransportLaneIdentifier'" />
                <POP_LANE_NAME select="'TransportLaneName'" />
                <SELECTABLE select="'Single'" />
              </ui:url>
              <ui:image src="pop_up_window.gif" />
            </ui:link>
          </ui:links>
        </ui:entry-field>
        <ui:hidden-field displayText="Lane Name" name="TransportLaneName" />
        <ui:entry-field name="TransportationAssetValue" displayText="Asset Number" required="true">
          <ui:links>
            <ui:link displayText="Select Asset" targetType="popup" targetName="catalogPopup">
              <ui:url page="view.x2ps">
                <BUTTON_ID select="'Select_ta_id'" />
                <FIELD_NAME select="'TransportationAssetValue'" />
                <ITEM_TYPE select="'TRAN'" />
                <POP_ASST_DESC select="'ItemName'" />
                <SELECTABLE select="'Single'" />
                <SOURCE select="'TransAsset'" />
              </ui:url>
              <ui:image src="pop_up_window.gif" />
            </ui:link>
          </ui:links>
        </ui:entry-field>
        <ui:entry-field displayText="Asset Description" name="ItemName" readOnly="true" />
        <ui:entry-field displayText="Lane Asset Start Date" name="EffectiveStartDate" dataType="Date" required="true" />
        <ui:entry-field displayText="Lane Asset End Date" name="EffectiveEndDate" dataType="Date" required="true" />
        <ui:dropdown displayText="Asset Priority" name="AssetPriorityValue" selectOne="true" optionSrc="$root/ASST_PRIR/*" required="true" />
        <ui:dropdown displayText="Valid Days Of Week" name="WeekValidDaysValue" selectOne="true" optionSrc="$root/DOW/*" required="true" />
        <!--      </ui:field-group>

      <ui:field-group columns="2" id="subGrp">-->
        <ui:entry-field displayText="Min Target Cube" name="MinimumTargetCubeMeasure" required="true" dataType="Number" decimals="0" maxlength="13" align="left" unFormat="true" minValue="1" />
        <ui:entry-field displayText="Target Cube Value" name="TargetCubeMeasure" required="true" dataType="Number" decimals="0" maxlength="13" align="left" unFormat="true" minValue="1" />
        <ui:entry-field displayText="Max Target Cube" name="MaximumTargetCubeMeasure" required="true" dataType="Number" decimals="0" maxlength="13" align="left" unFormat="true" minValue="1" />
        <ui:entry-field displayText="Target Weight Value" name="TargetWeightMeasure" required="true" dataType="Number" decimals="0" maxlength="13" align="left" unFormat="true" minValue="1" />
        <ui:entry-field displayText="Target Pallet Value" name="TargetPalletCount" required="true" dataType="Number" decimals="0" maxlength="11" unFormat="true" align="left" minValue="1" />
        <ui:entry-field displayText="Number of Assets Available" name="AvailableAssetCount" required="true" dataType="Number" maxlength="11" decimals="0" unFormat="true" align="left" minValue="1" />
      </ui:field-group>
      <ui:field-group columns="2" id="comGrp">
        <ui:textarea displayText="Comments" name="TransportLaneXTransportEquipmentItemCommentText" required="false" />
      </ui:field-group>
      <ui:buttons id="buttons1" name="buttons1">
        <!-- RIC: 240988 Praneeth - Cancel button wording changes request - Start -->
        <ui:button displayText="Back to Search" id="cancel" validate="false" />
        <!-- RIC: 240988 Praneeth - Cancel button wording changes request - End -->
        <ui:button displayText="Save" id="save" />
      </ui:buttons>
    </ui:step>
  </ui:container>
  <ui:script>function on_save(){
   var bIsValid = true;
   document.form.SUBMIT_AS_XML.value = 'false';
  
  bIsValid = (isValid_stp());
   
  if( bIsValid == false )
  {
    validation_alert('stp');
  }
  
  if ( bIsValid == true) 
  {
var startDate = document.form.EffectiveStartDate_DC.value;
var endDate = document.form.EffectiveEndDate_DC.value;				
if (Date.parse(startDate) &gt; Date.parse(endDate)) {
		core_alert("Invalid Date Range,Start Date cannot be after End Date!")
		return;
}	

   disableButtons(); 
   trapExcelPivotChanges(); 
  document.form.BUTTON_ID.value = 'save'; 
  document.form.action = 'view.x2ps';
  document.form.submit();  
  }
  
  onResize();  
  return; 

}</ui:script>
</ui:page-group>

