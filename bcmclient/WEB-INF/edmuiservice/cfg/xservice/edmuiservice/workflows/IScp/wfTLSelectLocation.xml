<?xml version="1.0" encoding="UTF-8"?>
<workflow mgcCount="132" ShowInBreadCrumbs="true" Version="1.0" Name="wfTLSelectLocation" Description="" Type="" PrimaryDocument="" IsStartAllowed="Yes">
  <variables>
    <variable Name="fieldName" Type="string" Comment=""/>
    <variable Name="locTypeForRP" Type="string" Comment=""/>
    <variable Name="populateLocNameField" Type="string" Comment=""/>
    <variable Name="select" Type="string" Comment=""/>
    <variable Name="pageSource" Type="string" Comment=""/>
  </variables>
  <nodes>
    <start Name="start2">
      <actions>
        <action>
          <SET DocVar="fieldName" FromValue="{$thisParam/FIELD_NAME/@Value}"/>
          <SET DocVar="select" FromValue="{$thisParam/SELECTABLE/@Value}"/>
          <SET DocVar="locTypeForRP" FromValue="{$thisParam/POP_LOC_TYPE/@Value}"/>
          <SET DocVar="pageSource" FromValue="{$thisParam/SOURCE/@Value}"/>
          <!--SET DocVar="populateLocNameField" FromValue="{$thisParam/POPULATE_LOC_NAME/@Value}"/-->
        </action>
      </actions>
      <next_nodes>
        <next_node Name="Select Location" Description=""/>
      </next_nodes>
    </start>
    <ui_form2 Name="Select Location" InputFormVar="pglFormInput" OutputFormVar="pglFormOutput" ShowInBreadCrumbs="HIDE" Template="iscpTLSelectLocation.pgl">
      <pre_actions>
        <action>
          <SET Var="paginateStart" FromValue="{ifElse($thisParam/START_COUNT/@Value = null, '0', $thisParam/START_COUNT/@Value)}"/>
          <SET Var="pgMaxRows" FromValue="{ifElse($thisParam/MAX_ROWS/@Value = null, '10', $thisParam/MAX_ROWS/@Value)}"/>
          <SET DocVar="thisParam" Property="SRCH_STATE" FromValue="ACTIVE"/>
          <SET Var="sortBy" FromValue="{ifElse((($thisParam/SORT_BY/@Value = null) or ($thisParam/SORT_BY/@Value = 'ID')), 'LocationIdn', $thisParam/SORT_BY/@Value)}"/>
          <SET Var="sortOrder" FromValue="{ifElse((($thisParam/SORT_ORDER/@Value = null) or ($thisParam/SORT_BY/@Value = 'ID')), 'Ascending', $thisParam/SORT_ORDER/@Value)}"/>
          <MAKE_INSTANCE_DOCUMENT Name="{$sortBy}" AssignToVar="sortByTag"/>
          <SET DocVar="sortByTag" Attribute="Sort" FromValue="{$sortOrder}"/>
          <!-- 02/19/2008 Rahul Keshri Fixed loacation popup which was showing deleted items Begin -->
          <SET DocVar="thisParam" Property="SRCH_STATE" FromValue="ACTIVE"/>
          <!-- 02/19/2008 Rahul Keshri fix End -->
          <FORM_SEARCH_FILTER Value="{$thisParam}" AssignToVar="locFilters">
            <SRCH_LOC_ID MultiValued="true"/>
            <!--SRCH_LOC_NAME MultiValued="true"/-->
            <SRCH_LOC_DESC MultiValued="true"/>
            <SRCH_LOC_TYPE MultiValued="true"/>
            <SRCH_SGMNT_ID MultiValued="true"/>
            <SRCH_ITEM_ID MultiValued="true"/>
            <SRCH_STATE/>
          </FORM_SEARCH_FILTER>
          <APPEND_TO_XML DocVar="locFilters">
            <ORDER_BY>
              <TO_XML DocVar="sortByTag"/>
            </ORDER_BY>
          </APPEND_TO_XML>
          <REQUEST Name="readLocations" ServiceName="BCM_MASTER" AssignToVar="locSrchResult" ReturnRowCount="yes">
            <MaxRows Value="{$pgMaxRows}"/>
            <StartAtRow Value="{$paginateStart}"/>
            <TO_XML SelectList="$locFilters/*"/>
            <pageSource Value="{$pageSource}"/>
            <FILTER Name="LocationIdentificationClassMnemonicValue">
              <LocationIdentificationClassMnemonicValue Value="{$defaultLocationforISCP}"/>
            </FILTER>
            <FILTER Name="SRCH_SGMNT_DESC">
              <OR>
                <SRCH_SGMNT_DESC Value="{$PartyDesc1000}" MatchBy="NOT_EQUAL"/>
                <SRCH_SGMNT_DESC Value="{$PartyDescProject1up}" MatchBy="NOT_EQUAL"/>
              </OR>
            </FILTER>
          </REQUEST>
          <TO_DOCVAR AssignToVar="formattedLocTypes">
            <LOC_TYPES/>
          </TO_DOCVAR>
          <FOR_EACH CurrentElement="curLocType" SelectList="$locSrchResult/LOC_TYPES/*">
            <APPEND_TO_XML DocVar="formattedLocTypes">
              <OPTION Value="{concat($curLocType/LocationClassMnemonicValue/@Value,' - ',$curLocType/LocationClassName/@Value)}" Id="{$curLocType/LocationClassMnemonicValue/@Value}"/>
            </APPEND_TO_XML>
          </FOR_EACH>
          <SET DocVar="prevSel" FromValue=""/>
          <FOR_EACH SelectList="$thisParam/*" CurrentElement="curElem">
            <IF_TEST Test="name($curElem) = 'SELECTED_LOC_IDS'">
              <THEN>
                <SET DocVar="prevSel" FromValue="{ifElse(contains(prevSel,$curElem/@Value),'',concat($prevSel,',',$curElem/@Value))}"/>
              </THEN>
            </IF_TEST>
          </FOR_EACH>
          <TO_DOCVAR AssignToVar="pglFormInput">
            <ROOT>
              <SEARCH_FIELDS>
                <TO_XML SelectList="$thisParam/SRCH_LOC_ID"/>
                <TO_XML SelectList="$thisParam/SRCH_SGMNT_ID"/>
                <TO_XML SelectList="$thisParam/SRCH_ITEM_ID"/>
                <TO_XML SelectList="$thisParam/SRCH_LOC_DESC"/>
                <TO_XML SelectList="$thisParam/SRCH_LOC_TYPE"/>
                <FIELD_NAME Value="{$fieldName}"/>
                <POPULATE_LOC_NAME Value="{$populateLocNameField}"/>
                <PREV_SEL Value="{substringAfter($prevSel,',')}"/>
                <POP_LOCC_TYPE Value="{$locTypeForRP}"/>
              </SEARCH_FIELDS>
              <START_AT_ROW Value="{$paginateStart}"/>
              <TotalRowCount Value="{$locSrchResult/LOC_DETAILS/@TotalRowCount}"/>
              <SORT_BY Value="{$sortBy}"/>
              <SORT_ORDER Value="{$sortOrder}"/>
              <TO_XML SelectList="$locSrchResult/*"/>
              <SELECT Value="{$select}"/>
              <LOC_TYPES>
                <OPTION Value="Select All" Id="*"/>
                <TO_XML SelectList="$formattedLocTypes/*"/>
                <!--        <DROP_DOWN_OPTIONS SelectList="$locSrchResult/LOC_TYPES/P_LocationClass" Id="LocationClassMnemonicValue" Value="LocationClassName"/>-->
              </LOC_TYPES>
            </ROOT>
          </TO_DOCVAR>
        </action>
      </pre_actions>
      <if_cond Value="$userAction ='search_button'">
        <next_nodes OutputVar="{outputXml,xml}">
          <next_node Name="Select Location" Description=""/>
        </next_nodes>
      </if_cond>
      <else_if_cond Value="$userAction ='select'">
        <next_nodes OutputVar="{outputXml,xml}"/>
      </else_if_cond>
      <else_if_cond Value="$userAction ='cancel'">
        <next_nodes OutputVar="{outputXml,xml}"/>
      </else_if_cond>
      <else_if_cond Value="true()">
        <next_nodes OutputVar="{outputXml,xml}">
          <next_node Name="done4" Description=""/>
        </next_nodes>
      </else_if_cond>
    </ui_form2>
    <done Name="done4">
      <actions>
      </actions>
      <next_nodes/>
    </done>
  </nodes>
