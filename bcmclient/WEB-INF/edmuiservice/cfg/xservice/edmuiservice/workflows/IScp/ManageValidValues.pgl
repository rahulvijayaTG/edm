<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="ManageValidValues.pgl">
  <ui:container id="topContainer">
    <ui:step id="c1" displayText="Manage Valid Values" editable="true">
      <ui:validation successMessage="{$root/SUCCESSMSG/MSG/@Value}" />
      <ui:field-group id="srch" columns="1">
        <!--  <ui:entry-field id="ParamName" name="ParamName" displayText="Parameter Name" editable="true" Value="{$root/FIELD_NAME/@Value}"/>-->
        <ui:display-field name="ParamName" id="ParamName" displayText="{$root/FIELD_NAME/@Value}" editable="true" />
        <ui:entry-field id="NewValue" name="NewValue" displayText="NewValue" required="true" />
        <ui:hidden-field name="FIELD_NAME" value="{$root/FIELD_NAME/@Value}" />
      </ui:field-group>
      <ui:table id="bottomTable" displayText="Existing Values" rowSrc="$root/LINE/ROWDATA" postRowIdAs="SELECTED_ITEM" collapsable="false" scrollable="true" rowId="validvalue" displayTextNoRecords="No Record Found" selectable="All" totalRowCount="$root/LINE/@TotalRowCount" startAtRow="$root/LINE/@startRowCount" maxRows="10">
        <ui:field-group id="tableColumns" width="100%">
          <ui:entry-field id="validvalue" name="validvalue" displayText="value" editable="false" />
        </ui:field-group>
        <ui:buttons>
          <ui:button id="add" name="add" displayText="add" emphasized="true" enabledBySelections="false" displayCondition="{contains($root/AccessLevel/@Value,'Remove')}" />
          <ui:button id="delete" name="delete" displayText="delete" emphasized="true" enabledBySelections="true" displayCondition="{contains($root/AccessLevel/@Value,'Remove')}" />
          <ui:button id="back" name="back" displayText="Back" emphasized="true" enabledBySelections="false" />
        </ui:buttons>
      </ui:table>
    </ui:step>
  </ui:container>
</ui:page-group>

