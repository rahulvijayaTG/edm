<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="pglFscSearchEdit.pgl">
  <ui:container id="TopContainer" name="TopContainer" scrollable="true">
    <ui:step id="Main" name="Main" displayText="ISCP Facility Storage Capacity Search and Edit">
      <ui:grid>
        <ui:row>
          <ui:cell>
            <ui:container editable="false" height="100" width="445">
              <ui:step displayText="Planning Horizon" id="top_container" editable="true">
                <ui:grid>
                  <ui:row>
                    <ui:cell>
                      <ui:field-group id="leftFields11">
                        <ui:display-field displayText="Starting Week" id="SWTXT" name="SWTXT" />
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields12">
                        <ui:dropdown id="SWYEAR" name="SWYEAR" optionSrc="$root/YEARLIST/OPTIONS/OPTION" value="{$root/SWYEAR/@Value}" />
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields13">
                        <ui:dropdown id="SWPERIOD" name="SWPERIOD" optionSrc="$root/PERIODLIST/OPTIONS/OPTION" value="{$root/SWPERIOD/@Value}" />
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields14">
                        <ui:dropdown id="SWWEEK" required="true" name="SWWEEK" optionSrc="$root/WEEKLIST/OPTIONS/OPTION" value="{$root/SWWEEK/@Value}" />
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields15">
                        <ui:entry-field editable="fasle" id="SWDATE" style="font-weight:Bold" value="{$root/STARTDATE/@Value}" defaultValue="MM/DD/YYYY" />
                      </ui:field-group>
                    </ui:cell>
                  </ui:row>
                  <ui:row>
                    <ui:cell>
                      <ui:field-group id="leftFields21">
                        <ui:display-field displayText="Ending Week" id="SWTXT" name="SWTXT" />
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields22">
                        <ui:dropdown id="EWYEAR" name="EWYEAR" optionSrc="$root/YEARLIST/OPTIONS/OPTION" value="{$root/EWYEAR/@Value}" />
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields23">
                        <ui:dropdown id="EWPERIOD" name="EWPERIOD" optionSrc="$root/PERIODLIST/OPTIONS/OPTION" value="{$root/EWPERIOD/@Value}" />
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields24">
                        <ui:dropdown id="EWWEEK" required="true" name="EWWEEK" optionSrc="$root/WEEKLIST/OPTIONS/OPTION" value="{$root/EWWEEK/@Value}" />
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields25">
                        <ui:entry-field editable="fasle" id="EWDATE" style="font-weight:Bold;" value="{$root/ENDDATE/@Value}" defaultValue="MM/DD/YYYY" />
                      </ui:field-group>
                    </ui:cell>
                  </ui:row>
                </ui:grid>
                <ui:buttons id="buttons">
                  <ui:button id="APPLY" name="APPLY" displayText="Apply" emphasized="true" />
                </ui:buttons>
              </ui:step>
            </ui:container>
          </ui:cell>
          <ui:cell rowSpan="2">
            <ui:container editable="false" height="200">
              <ui:step displayText="Legends - for individual time buckets (Not across time buckets)" id="top_container" editable="true">
                <ui:field-group showDivider="true">
                  <ui:entry-field editable="false" displayText="XX, XXX" displayNoWrap="false" defaultValue="(Location cell) Sum of hard constraint effective units &gt; location's effective units" style="font-weight:Bold;background:#BEC5E7" />
                  <ui:entry-field editable="fasle" displayText="XX, XXX" displayNoWrap="true" defaultValue="(Segment cell) Sum of hard constraint effective units &gt; location's effective units" style="font-weight:Bold;color:red;background:yellow" />
                  <ui:entry-field editable="fasle" displayText="XX, XXX" displayNoWrap="true" defaultValue="Segment's soft constraint effective units &gt; segment's hard constraint effective units" style="font-weight:Bold;color:red;background:#BEC5E7" />
                </ui:field-group>
              </ui:step>
            </ui:container>
          </ui:cell>
        </ui:row>
        <ui:row>
          <ui:cell>
            <ui:container editable="false" height="100" width="445">
              <ui:step displayText="Planning Horizon" id="top_container" editable="true">
                <ui:grid>
                  <ui:row>
                    <ui:cell>
                      <ui:field-group id="leftFields">
                        <ui:display-field id="LOCID" name="LOCID" displayText="Location(s)" />
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell colSpan="4">
                      <ui:field-group id="leftFields">
                        <ui:entry-field id="LOCID" name="LOCID">
                          <ui:links>
                            <ui:link displayText="Select Customers" targetType="popup" targetName="planPopUp">
                              <ui:image src="pop_up_window.gif" />
                              <ui:url page="start.x2ps">
                                <FIELD_NAME select="'LOCID'" />
                                <ENTITY_NAME select="'LOCID'" />
                                <SELECTABLE select="'All'" />
                                <BUTTON_ID select="'selectLocation'" />
                              </ui:url>
                            </ui:link>
                          </ui:links>
                        </ui:entry-field>
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields">
                        <ui:display-field id="HDNFLD1" name="HDNFLD1" displayText="L131i ID" style="font-weight:Bold;color:white" />
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields">
                        <ui:display-field id="HDNFLD2" name="HDNFLD2" displayText="Loi ID" style="font-weight:Bold;color:white" />
                      </ui:field-group>
                    </ui:cell>
                  </ui:row>
                  <ui:row>
                    <ui:cell>
                      <ui:field-group id="leftFields">
                        <ui:display-field id="SEGID" name="SEGID" displayText="Segment(s)" />
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell colSpan="4">
                      <ui:field-group id="leftFields">
                        <ui:entry-field id="SEGID" name="SEGID">
                          <ui:links>
                            <ui:link displayText="Select Customers" targetType="popup" targetName="planPopUp">
                              <ui:image src="pop_up_window.gif" />
                              <ui:url page="start.x2ps">
                                <FIELD_NAME select="'SEGID'" />
                                <ENTITY_NAME select="'SEGID'" />
                                <SELECTABLE select="'All'" />
                                <BUTTON_ID select="'selectSegment'" />
                              </ui:url>
                            </ui:link>
                          </ui:links>
                        </ui:entry-field>
                      </ui:field-group>
                    </ui:cell>
                  </ui:row>
                </ui:grid>
                <ui:buttons id="buttons">
                  <ui:button id="SEARCH" name="SEARCH" displayText="Search" emphasized="true" />
                </ui:buttons>
              </ui:step>
            </ui:container>
          </ui:cell>
        </ui:row>
      </ui:grid>
      <ui:container id="container2" name="container2">
        <ui:step id="Inner" name="Inner" displayText="ISCP Facility Storage Capacity Search Results">
          <ui:pivot id="pivot" displayText="" select="$root/REAL_DATA/MULTI_COLLAB_DATA/BUFFER_SLAS" subRowSrc="BUCKETS/ROWDATA" selectable="Single" rowId="LOCIDN" scrollable="true" maxRows="10">
            <ui:table-row select="BUFFER_SLA">
              <ui:table-row select="SEGMENTS/BUFFER_SLA" />
            </ui:table-row>
            <ui:pivot-field axis="row" id="LOCIDN" name="LOCIDN" displayText="Location" treeCell="true" collapsed="true" dataType="Number" />
            <ui:pivot-field axis="row" id="LOCNAME" name="LOCNAME" displayText="Location Name" />
            <ui:pivot-field axis="row" id="LOCTYPE" name="LOCTYPE" displayText="Location Type" />
            <ui:pivot-field axis="row" id="SGNIDN" name="SGNIDN" displayText="Segment" dataType="Number" />
            <ui:pivot-field axis="row" id="SGMNAME" name="SGMNAME" displayText="Segment Name" />
            <ui:pivot-field axis="row" id="CNSRNT" name="CNSRNT" displayText="Constraint" />
            <ui:pivot-field axis="row" id="UOM" name="UOM" displayText="Unit of Measure" />
            <ui:pivot-field axis="column" name="FROM_DATE" displayText="" />
            <ui:entry-field name="STRGCPCTY" displayText="Units (Rated Capacity)" size="6" dataType="Number" align="left" />
            <ui:entry-field name="UTLPRCTG" displayText="Utilization %" dataType="Number" size="6" align="left" />
            <ui:display-field name="EFFSTRGUNIT" displayText="Effective Units" size="6" dataType="Number" align="left" />
            <ui:entry-field name="CMMNT" displayText="Comments" size="6" align="left" />
            <ui:entry-field name="STRTDATE" id="STRTDATE" displayText="" editable="false" displayCondition="false" />
            <ui:hidden-field name="STRTDATE" id="STRTDATE" defaultValue="1232" onlyJavascript="true" submitAsXML="true" />
          </ui:pivot>
          <ui:buttons>
            <ui:button id="SH" displayText="Show History" />
            <ui:divider />
            <ui:button id="DEL" displayText="Delete" name="DEL" enabledBySelections="true" />
            <ui:divider />
            <ui:button displayText="Create" id="CPY" name="CPY" enabledBySelections="true" />
            <ui:divider />
            <ui:button displayText="Edit " id="EDIT" name="EDIT" emphasized="true" enabledBySelections="true" />
          </ui:buttons>
        </ui:step>
      </ui:container>
    </ui:step>
  </ui:container>
</ui:page-group>

