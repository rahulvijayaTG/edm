    <ui:step id="step1">-->
    <ui:field-group id="fg2" columns="2">
      <ui:field-group id="fg21">
        <ui:hidden-field id="numberofrecs" name="numberofrecs" value="{$root/ROOT/selectedgroups/@Value}" displayText="count" />
        <ui:entry-field displayText="Group ID" id="ItemInterchangeGroupIdentifier" name="ItemInterchangeGroupIdentifier" value="{$root/var/grpid/@Value}">
          <ui:links>
            <ui:link displayText="Select Group" targetType="popup" targetName="planPopUp">
              <ui:image src="pop_up_window.gif" />
              <ui:url page="view.x2ps">
                <FIELD_NAME select="'ItemInterchangeGroupIdentifier'" />
                <ENTITY_NAME select="'ItemInterchangeGroupIdentifier'" />
                <!--<ROW_ID_NAME select="'ItemInterchangeGroupIdentifier'"/>-->
                <ROW_ID_VALUE select="'ItemInterchangeGroupIdentifier/@Value'" />
                <SELECT select="'All'" />
                <BUTTON_ID select="'SEARCH_GRP_ID'" />
              </ui:url>
            </ui:link>
          </ui:links>
        </ui:entry-field>
        <ui:dropdown id="InterchangeGroupStatus" optionSrc="$root/stat/OPTION" name="InterchangeGroupStatus" displayText="Group Status" value="{$root/var/status/@Value}" selectOne="true" />
        <ui:entry-field id="LocationIdentifier" name="LocationIdentifier" displayText="Location" value="{$root/var/location/@Value}">
          <ui:links>
            <ui:link displayText="Select Location" targetType="popup" targetName="planPopUp">
              <ui:image src="pop_up_window.gif" />
              <ui:url page="view.x2ps">
                <FIELD_NAME select="'LocationIdentifier'" />
                <ENTITY_NAME select="'LocationIdentifier'" />
                <ROW_ID_NAME select="'LocationIdentifier'" />
                <ROW_ID_VALUE select="'LocationIdentifier/@Value'" />
                <SELECTABLE select="'All'" />
                <BUTTON_ID select="'SEARCH_LOCATION_ID'" />
              </ui:url>
            </ui:link>
          </ui:links>
        </ui:entry-field>
        <!--<ui:date-range id="modifieddate" name="modifieddate" displayText="Modified Date Range" fromDate="{$root/var/fromdate/@Value}" toDate="{$root/var/todate/@Value}"/>-->
      </ui:field-group>
      <ui:field-group id="rightgrp">
        <ui:entry-field id="RelatedItemIdentifier" name="RelatedItemIdentifier" displayText="Predecessor Product" value="{$root/var/RelatedItemIdentifier/@Value}">
          <ui:links>
            <ui:link displayText="Select Product" targetType="popup" targetName="planPopUp">
              <ui:image src="pop_up_window.gif" />
              <ui:url page="view.x2ps">
                <FIELD_NAME select="'RelatedItemIdentifier'" />
                <ENTITY_NAME select="'RelatedItemIdentifier'" />
                <ROW_ID_NAME select="'RelatedItemIdentifier'" />
                <ROW_ID_VALUE select="'RelatedItemIdentifier/@Value'" />
                <SELECTABLE select="'All'" />
                <SOURCE select="'PI'" />
                <ITEM_TYPE select="'FIN'" />
                <BUTTON_ID select="'SEARCH_PRD'" />
              </ui:url>
            </ui:link>
          </ui:links>
        </ui:entry-field>
        <ui:entry-field id="PrimaryItemIdentifier" name="PrimaryItemIdentifier" displayText="Successor Product" value="{$root/var/primaryitemidentifier/@Value}">
          <ui:links>
            <ui:link displayText="Select Product" targetType="popup" targetName="planPopUp">
              <ui:image src="pop_up_window.gif" />
              <ui:url page="view.x2ps">
                <FIELD_NAME select="'PrimaryItemIdentifier'" />
                <ENTITY_NAME select="'PrimaryItemIdentifier'" />
                <ROW_ID_NAME select="'PrimaryItemIdentifier'" />
                <ROW_ID_VALUE select="'PrimaryItemIdentifier/@Value'" />
                <SELECTABLE select="'All'" />
                <SOURCE select="'PI'" />
                <ITEM_TYPE select="'FIN'" />
                <BUTTON_ID select="'SEARCH_PRD_SUCCSS'" />
              </ui:url>
