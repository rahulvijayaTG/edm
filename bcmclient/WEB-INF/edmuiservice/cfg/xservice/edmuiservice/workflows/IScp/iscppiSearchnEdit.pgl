<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="piSearchnEdit.pgl">
  <ui:search name="linelocSearchnEdit" displayText="Group Line Location Search And Edit" collapsable="true" exportSearch="false" saveSearch="false" anyFieldIsRequired="false">
    <ui:validation displayText="dummy" displayCondition="false" />
