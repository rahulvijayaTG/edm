    <ui_form2 Name="Select Layers" InputFormVar="pglFormInput" OutputFormVar="pglFormOutput" ShowInBreadCrumbs="HIDE" Template="iscpRPSelectLayers.pgl">
      <pre_actions>
        <action>
          <SET Var="sortBy" FromValue="{ifElse($thisParam/SORT_BY/@Value = null, 'LayerName', $thisParam/SORT_BY/@Value)}"/>
          <SET Var="sortOrder" FromValue="{ifElse($thisParam/SORT_ORDER/@Value = null, 'Ascending', $thisParam/SORT_ORDER/@Value)}"/>
          <MAKE_INSTANCE_DOCUMENT Name="{$sortBy}" AssignToVar="sortByTag"/>
          <IF_TEST Test="$userAction='search_button'">
            <THEN>
              <REMOVE_CHILDREN DocVar="thisParam" ChildName="SELECTED_ITEM"/>
            </THEN>
          </IF_TEST>
          <TO_DOCVAR AssignToVar="pglFormInput">
            <root>
              <FIELD_NAME Value="{$thisParam/PARAMETERS/FIELD_NAME/@Value}"/>
              <FIELD_DESC Value="{$thisParam/PARAMETERS/FIELD_DESC/@Value}"/>
            </root>
          </TO_DOCVAR>
          <TO_DOCVAR AssignToVar="enteredSearchCriteria">
            <Criteria>
              <SRCH_ENGINE Value="{$thisParam/SRCH_ENGINE/@Value}"/>
              <SRCH_DMNDTYP Value="{ifElse($userAction='search_button',$thisParam/SRCH_DMNDTYP/@Value,$enteredSearchCriteria/SRCH_DMNDTYP/@Value)}"/>
              <SRCH_LAYER Value="{$thisParam/SRCH_LAYER/@Value}"/>
            </Criteria>
          </TO_DOCVAR>
          <APPEND_TO_XML DocVar="thisReturn">
            <TO_XML SelectList="$enteredSearchCriteria/*"/>
          </APPEND_TO_XML>
          <APPEND_TO_XML DocVar="pglFormInput">
            <TO_XML SelectList="$thisReturn/*"/>
          </APPEND_TO_XML>
          <GET_DOC_SMART Name="P_AnalyticalModelSoftwareInstance" AssignToVar="ENGINELIST" HandleException="true" ServiceName="PEDM_MASTER">
            <SELECT>
              <AnalyticalModelSoftwareInstanceMnemonicValue/>
            </SELECT>
            <ORDER_BY Sort="Ascending">
              <AnalyticalModelSoftwareInstanceMnemonicValue/>
            </ORDER_BY>
          </GET_DOC_SMART>
          <TO_DOCVAR AssignToVar="enginelist">
            <Engine>
            </Engine>
          </TO_DOCVAR>
          <FOR_EACH SelectList="$ENGINELIST/P_AnalyticalModelSoftwareInstance" CurrentElement="id">
            <SET Var="matchesRes" FromValue="{nativeFunction('java.util.regex.Pattern', 'matches', '[0-9]*', $id/AnalyticalModelSoftwareInstanceMnemonicValue/@Value)}"/>
            <IF_TEST Test="($matchesRes='true')">
              <THEN>
            <REQUEST AssignToVar="engineid" Name="getEngineIdInterfaceFormatVal" ServiceName="PEDM_MASTER">
              <EngineId Value="{$id/AnalyticalModelSoftwareInstanceMnemonicValue/@Value}"/>
              <ORDER_BY>
                <TO_XML DocVar="sortByTag"/>
              </ORDER_BY>
            </REQUEST>
            <TO_DOCVAR AssignToVar="eng">
              <ID Id="{$id/AnalyticalModelSoftwareInstanceMnemonicValue/@Value}" Value="{$engineid/EngineId/@Value}"/>
            </TO_DOCVAR>
            <APPEND_TO_XML DocVar="enginelist">
              <TO_XML DocVar="eng"/>
            </APPEND_TO_XML>
              </THEN>
            </IF_TEST>
          </FOR_EACH>
          <APPEND_TO_XML DocVar="pglFormInput">
            <TO_XML Select="$enginelist"/>
          </APPEND_TO_XML>
          <IF_TEST Test="($thisParam/PARAMETERS/BUTTON_ID/@Value!='selectLayers')">
            <THEN>
              <SET DocVar="thisParam" Property="SRCH_STATE" FromValue="ACTIVE"/>
              <IF_TEST Test="$thisParam/SRCH_LAYER/@Value!=null and strlen($thisParam/SRCH_LAYER/@Value)>0">
                <THEN>
                  <SET Var="searchLayerString" FromValue="{$thisParam/SRCH_LAYER/@Value}"/>
                  <SET Var="searchLayerString" FromValue="{concat($searchLayerString,',')}"/>
                  <SET Var="modifiedString" FromValue=""/>
                  <WHILE Condition="strlen($searchLayerString)>1">
                    <SET Var="CurParam" FromValue="{substringBefore($searchLayerString, ',')}"/>
                    <SET Var="modifiedString" FromValue="{concat($modifiedString,substringAfter($CurParam, 'LAYER'),',')}"/>
                    <SET Var="searchLayerString" FromValue="{substringAfter($searchLayerString, ',')}"/>
                  </WHILE>
                  <SET Var="modifiedString" FromValue="{subString($modifiedString,0,strlen($modifiedString)-1)}"/>
                  <SET DocVar="thisParam" Property="SRCH_LAYER" FromValue="{$modifiedString/@Value}"/>
                </THEN>
              </IF_TEST>
              <FORM_SEARCH_FILTER Value="{$thisParam}" AssignToVar="rpLayerFilter">
                <SRCH_LAYER MultiValued="true"/>
                <SRCH_ENGINE MultiValued="true"/>
                <SRCH_STATE/>
              </FORM_SEARCH_FILTER>
              <SET Var="paginateStart" FromValue="{ifElse($thisParam/START_COUNT/@Value = null, '0', $thisParam/START_COUNT/@Value)}"/>
              <SET Var="pgMaxRows" FromValue="{ifElse($thisParam/MAX_ROWS/@Value = null, '10', $thisParam/MAX_ROWS/@Value)}"/>
              <SET Var="sortBy1" FromValue="{ifElse($thisParam/SORT_BY/@Value = null or $thisParam/SORT_BY/@Value = 'ID' or $thisParam/SORT_BY/@Value ='LayerName','DemandCategoryName', $thisParam/SORT_BY/@Value)}"/>
              <SET Var="sortOrder1" FromValue="{ifElse($thisParam/SORT_ORDER/@Value = null, 'Ascending', $thisParam/SORT_ORDER/@Value)}"/>
              <MAKE_INSTANCE_DOCUMENT Name="{$sortBy1}" AssignToVar="sortByTag1"/>
              <SET DocVar="sortByTag1" Attribute="Sort" FromValue="{$sortOrder1/@Value}"/>
              <IF_TEST Test="strlen($thisParam/SRCH_LAYER/@Value)>0 or strlen($thisParam/SRCH_ENGINE/@Value)>0">
                <THEN>
                  <REQUEST Name="getLayerList" ServiceName="PEDM_MASTER" AssignToVar="layerList" ReturnRowCount="yes" MaxRows="{$pgMaxRows}" StartAtRow="{$paginateStart}">
                    <TO_XML SelectList="$rpLayerFilter/*"/>
                    <ORDER_BY>
                      <TO_XML DocVar="sortByTag1"/>
                    </ORDER_BY>
                  </REQUEST>
                </THEN>
              </IF_TEST>
              <SET DocVar="prevSel" FromValue=""/>
              <FOR_EACH SelectList="$thisParam/*" CurrentElement="curElem">
                <IF_TEST Test="name($curElem) = 'SELECTED_ITEM'">
                  <THEN>
                    <SET DocVar="prevSel" FromValue="{ifElse(contains(prevSel,$curElem/@Value),'',concat($prevSel,',',$curElem/@Value))}"/>
                  </THEN>
                </IF_TEST>
              </FOR_EACH>
              <SET Var="totalRowCount" FromValue="{$layerList/LAYERLIST/@TotalRowCount}"/>
              <TO_DOCVAR AssignToVar="rowcount">
                <ROWCOUNT Value="{$totalRowCount/@Value}"/>
              </TO_DOCVAR>
              <APPEND_TO_XML DocVar="pglFormInput">
                <TO_XML Select="$rowcount"/>
              </APPEND_TO_XML>
              <FOR_EACH CurrentElement="id" SelectList="$layerList/LAYERLIST/P_AnalyticalModelSoftwareInstance">
                <TO_DOCVAR AssignToVar="layerName">
                  <LayerName Value="{concat('LAYER',$id/DemandCategoryName/@Value)}"/>
                </TO_DOCVAR>
                <TO_DOCVAR AssignToVar="layerNameList">
                  <LAYERLIST/>
                </TO_DOCVAR>
                <APPEND_TO_XML DocVar="layerNameList">
                  <TO_XML Select="$layerName"/>
                </APPEND_TO_XML>
                <APPEND_TO_XML DocVar="pglFormInput">
                  <TO_XML Select="$layerNameList"/>
                </APPEND_TO_XML>
              </FOR_EACH>
              <TO_DOCVAR AssignToVar="fieldname">
                <FIELD_NAME Value="SRCH_LAYER"/>
              </TO_DOCVAR>
              <APPEND_TO_XML DocVar="pglFormInput">
                <TO_XML Select="$fieldname"/>
              </APPEND_TO_XML>
              <SET DocVar="pglFormInput" Property="PREV_SEL" FromValue="{substringAfter($prevSel,',')}"/>
            </THEN>
          </IF_TEST>
        </action>
      </pre_actions>
      <if_cond Value="$userAction ='search_button'">
        <next_nodes OutputVar="{outputXml,xml}">
          <next_node Name="Select Layers" Description=""/>
        </next_nodes>
      </if_cond>
      <else_if_cond Value="$userAction ='select'">
