<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="uiWfpiManagepiGrp.pgl">
  <ui:container id="container1">
    <ui:step id="step1" displayText="Product Interchangeability (PI) Basic Group Information">
      <ui:validation successMessage="{$root/succssmsg/message/@Value}" />
      <ui:field-group id="fg">
        <ui:entry-field id="GrpId" name="GrpId" displayText="Group ID" value="{$root/restorevalues/grpid/@Value}" required="true" readOnly="true">
          <ui:links>
            <ui:link displayText="Select Group" targetType="popup" targetName="planPopUp">
              <ui:image src="pop_up_window.gif" />
              <ui:url page="view.x2ps">
                <FIELD_NAME select="'GrpId'" />
                <ENTITY_NAME select="'GrpSts'" />
                <ROW_ID_NAME select="'GrpDesc'" />
                <ROW_ID_VALUE select="'grpstshidden'" />
                <ROW_ID_3 select="'counthidden'" />
                <SELECT select="'Single'" />
                <BUTTON_ID select="'SEARCH_GRP_ID'" />
                <MANAGE_STS select="'FromManageStatusUI'" />
              </ui:url>
            </ui:link>
          </ui:links>
        </ui:entry-field>
        <ui:textarea id="GrpDesc" name="GrpDesc" displayText="Group Description" value="{$root/restorevalues/grpdesc/@Value}" readOnly="true" />
        <ui:dropdown id="GrpSts" name="GrpSts" displayText="Group Status" optionSrc="$root/OPTION/*" value="{$root/restorevalues/grpsts/@Value}" selectOne="true" onChange="javascipt:grpidchange()" />
        <ui:hidden-field id="grpstshidden" name="grpstshidden" value="{$root/restorevalues/statusfrompopup/@Value}" />
        <ui:hidden-field id="counthidden" name="counthidden" value="{$root/restorevalues/counthidden/@Value}" />
      </ui:field-group>
      <ui:buttons id="buttons">
        <ui:button id="save_button" name="save_button" displayText="Save" displayCondition="{contains($root/AccessLevel/@Value,'Update')}" onClick="javascript:checkgrpstatus()" />
      </ui:buttons>
      <ui:script id="statuscheck">
        function checkgrpstatus()
	{
		var temp=document.getElementsByName('grpstshidden');
		var description=document.getElementsByName('GrpSts');
		var countflag=document.getElementsByName('counthidden');
		var length=temp.length;
		for(i=0;i &lt; length;i++)
		{
        		<!-- if(description[i].value=='BLOCKED')-->
        		if(temp[i].value=='IN PROCESS' &amp;&amp; description[i].value=='BLOCKED' &amp;&amp; countflag[i].value==1)
			{
				var response_blocked=core_confirm("You are trying to Change a Group to BLOCKED Status. Do You want to continue?");
				if(response_blocked =='yes')
				{
					document.form.BUTTON_ID.value = 'save_button'; 
					document.form.action = 'view.x2ps';
					document.form.submit();  
				}
				else
				{
					document.form.SUBMIT_AS_XML.value = 'false';
					return;
				}
			}
        		<!-- QC:20815, 08/15/2008,Venkat, Start -->
        		if(temp[i].value=='IN PROCESS' &amp;&amp; description[i].value=='RELEASED' &amp;&amp; countflag[i].value==1)
			{
				var response=core_confirm("At least one of the Line Location records in this Group has a deployment start date in the past. Do you want to RELEASE this group?");
				if(response=='yes')
				{
					document.form.BUTTON_ID.value = 'save_button'; 
					document.form.action = 'view.x2ps';
					document.form.submit();  
				}
				else
				{
					document.form.SUBMIT_AS_XML.value = 'false';
					return;
				}
			}
			else
			{
				document.form.BUTTON_ID.value = 'save_button'; 
				document.form.action = 'view.x2ps';
				document.form.submit();  
			}
			<!-- QC:20815, 08/15/2008,Venkat, End -->
		}
	}
		
	function grpidchange()
	{
		if(document.form.GrpId.value !='')
		{
			document.form.BUTTON_ID.value='STATUS';
			document.form.submit();
		}
		else
		{
			return;
		}
	}
      </ui:script>
    </ui:step>
  </ui:container>
</ui:page-group>

