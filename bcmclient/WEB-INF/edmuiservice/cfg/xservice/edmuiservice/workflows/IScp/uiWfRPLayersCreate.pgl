<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="uiWfRPLayersCreate.pgl">
  <ui:table displayText="RP Layers" rowSrc="$root/LAYER_DETAILS_LIST/LAYER_DETAILS" collapsable="false" totalRowCount="$root/ROWCOUNT/@Value" maxRows="10" exportable="true" configurable="false" postRowIdAs="SelectedLayer">
    <ui:validation successMessage="{$root/SUCCESSMSG/MSG/@Value}" />
    <ui:field-group>
      <ui:dropdown displayText="Engine Id" name="EngineId" optionSrc="$root/Engine/ID" />
      <ui:entry-field displayText="Layer Name" name="DemandCategoryName" />
      <ui:entry-field displayText="Analytical Model Name" name="AnalyticalModelName" />
      <ui:entry-field displayText="AllocationBandText" name="AllocationBandText" />
      <ui:entry-field displayText="LayerEffectiveEndDayNumber" name="LayerEffectiveEndDayNumber" type="Number" />
      <ui:entry-field displayText="LayerEffectiveStartDayNumber" name="LayerEffectiveStartDayNumber" type="Number" />
      <!--<ui:entry-field displayText="DemandType" name="DemandType"/>-->
      <ui:dropdown displayText="DemandType" name="DemandType" optionSrc="$root/DemandType/ID" />
      <ui:entry-field id="DemandCategoryPriorityNumber" name="DemandCategoryPriorityNumber" displayText="DemandCategoryPriorityNumber" sortable="true" type="Number" />
    </ui:field-group>
    <ui:buttons id="btnGrp">
      <ui:button id="Cancel" displayText="Cancel" emphasized="true" validate="false" />
      <ui:button id="Save" displayText="Save" emphasized="true" validate="false" />
    </ui:buttons>
  </ui:table>
</ui:page-group>

