<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="IPItemLocExecption.pgl">
  <ui:container id="SearchContainer" displayText="IP Item Location Exception History">
    <ui:step id="searchStep">
      <ui:search id="srchLocParams" exportSearch="false" saveSearch="false" collapsable="true" displayText="Search">
        <ui:field-group columns="2" id="fieldGroups">
          <ui:field-group id="leftFields">
            <ui:dropdown displayText="Segment" name="STATE_ID" selectAll="true" optionSrc="$root/ORDER_STATES/*">
              <ui:option id="480003800" value="480003800, Quaker Oats Foods" />
              <ui:option id="480004800" value="480004800, Gatorade" />
              <ui:option id="480005800" value="480005800, Tropicana" />
            </ui:dropdown>
            <!--<ui:entry-field displayText="Segment" id="SRCH_SEGMENT" name="SRCH_SEGMENT">
              <ui:links>
                <ui:link displayText="Select Segments" targetType="popup" targetName="orderPopup">
                  <ui:image src="pop_up_window.gif"/>
                  <ui:url page="view.x2ps">
                    <FIELD_NAME select="'SRCH_SEGMENT'"/>
                    <ENTITY_NAME select="'SRCH_SEGMENT'"/>
                    <SELECTABLE select="'All'"/>
                    <BUTTON_ID select="'searchSegment'"/>
                  </ui:url>
                </ui:link>
              </ui:links>
            </ui:entry-field>-->
            <ui:entry-field displayText="Location" id="SRCH_LOC" name="SRCH_LOC">
              <ui:links>
                <ui:link displayText="Select Locations" targetType="popup" targetName="orderPopup">
                  <ui:image src="pop_up_window.gif" />
                  <ui:url page="view.x2ps">
                    <FIELD_NAME select="'SRCH_LOC'" />
                    <ENTITY_NAME select="'SRCH_LOC'" />
                    <SELECTABLE select="'All'" />
                    <BUTTON_ID select="'searchLocation'" />
                  </ui:url>
                </ui:link>
              </ui:links>
            </ui:entry-field>
            <ui:entry-field id="SRCH_ITEM" name="SRCH_ITEM" displayText="Item Number">
              <ui:links>
                <ui:link displayText="Select Items" targetType="popup" targetName="orderPopup">
                  <ui:image src="pop_up_window.gif" />
                  <ui:url page="view.x2ps">
                    <FIELD_NAME select="'SRCH_ITEM'" />
                    <ENTITY_NAME select="'SRCH_ITEM'" />
                    <SELECTABLE select="'All'" />
                    <BUTTON_ID select="'searchItem'" />
                  </ui:url>
                </ui:link>
              </ui:links>
            </ui:entry-field>
            <!--            <ui:display-field id="modDateRange" name="modDateRange" displayText="Modified Date Range (Inclusive)"/>-->
          </ui:field-group>
          <ui:field-group id="rightFields">
            <ui:entry-field id="LocDesc" name="LocDesc" displayText="Location Description" />
            <ui:entry-field id="ItemDesc" name="ItemDesc" displayText="Item Description" />
            <ui:entry-field id="GTIN" name="GTIN" displayText="GTIN #" />
            <ui:entry-field id="SRCH_MOD_BY" name="SRCH_MOD_BY" displayText="Modified By" rowSpan="2" />
          </ui:field-group>
        </ui:field-group>
        <ui:field-group id="dateRange" columns="2">
          <!--<ui:display-field displayText="Modified Date"/>
					<ui:display-field />-->
          <ui:date-range displayText="Modified Date" name="SRCH_MOD_DATE" fromDate="{$root/FROM_DATE/@Value}" toDate="{$root/TO_DATE/@Value}" />
        </ui:field-group>
      </ui:search>
      <ui:table id="bottomTable" displayText="IP Item Location History" select="$root/line" rowSrc="ROW_DATA" rowId="segNumber" exportable="true">
        <ui:field-group id="tableColumns">
          <ui:display-field displayText="Item" name="Item" id="Item" sortable="true" visibility="true" />
          <ui:display-field displayText="Item Description" id="ItemDescription" name="ItemDescription" sortable="true" />
          <ui:display-field displayText="GTIN #" name="GTIN" id="GTIN" sortable="true" />
          <ui:display-field name="MaterialType" id="MaterialType" displayText="Material Type" />
          <ui:display-field displayText="Location" name="Location" id="Location" sortable="true" />
          <ui:display-field displayText="Location Description" name="LocDesc" id="LocDesc" />
          <ui:display-field displayText="Modified Date" name="modDate" id="modDate" sortable="true" />
          <ui:display-field displayText="Modified By" name="modBy" id="modBy" sortable="true" />
          <ui:display-field displayText="Default PRP Daya" name="DefPRPDays" id="DefPRPDays" />
          <ui:display-field displayText="Override PRP Days" name="ORPRPDays" id="ORPRPDays" />
          <ui:display-field displayText="Override PRP Days Comment" name="ORPRPDaysComment" id="ORPRPDaysComment" />
          <ui:display-field displayText="Default FRCST Error" name="DefFRCSTError" id="DefFRCSTError" />
          <ui:display-field displayText="Override FRCST Error" name="ORFRCSTError" id="ORFRCSTError" />
          <ui:display-field displayText="Override FRCST Error Comment" name="ORFRCSTErrComment" id="ORFRCSTErrComment" />
          <ui:display-field displayText="Default ROQ" name="DefROQ" id="DefROQ" />
          <ui:display-field displayText="Override ROQ" name="ORROQ" id="ORROQ" />
          <ui:display-field displayText="Override ROQ Comment" name="ORROQComment" id="ORROQComment" />
          <ui:display-field name="DefKeepInvFlag" id="DefKeepInvFlag" displayText="Default Keep Inventory Flag" />
          <ui:display-field name="ORKeepInvFlag" id="ORKeepInvFlag" displayText="Override Keep Inventory Flag" />
          <ui:display-field name="ORKeepInvFlagComment" id="ORKeepInvFlagComment" displayText="Override Keep Inventory Flag Comment" />
        </ui:field-group>
        <ui:buttons id="tableButtons">
          <ui:button displayText="Return" id="return" name="return" />
        </ui:buttons>
      </ui:table>
    </ui:step>
  </ui:container>
</ui:page-group>

