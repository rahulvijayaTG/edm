<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="uiWfIPSegParamSearch.pgl">
  <ui:container id="container">
    <ui:step id="top_container" displayText="RP Top Level Parameters Search">
      <ui:search displayText="" exportSearch="false" saveSearch="false" collapsable="false">
        <ui:validation id="tst" displayCondition="asdf" />
        <ui:field-group id="fieldGroups" columns="2" rows="3" select="$root">
          <ui:dropdown id="SRCH_SEGMENT" name="SRCH_SEGMENT" displayText="Segment" selectAll="true" optionSrc="$root/Segment/ID" />
          <ui:dropdown id="SRCH_ENGINE" name="SRCH_ENGINE" displayText="Engine Id" selectAll="true" optionSrc="$root/Engine/ID" />
          <ui:entry-field id="SRCH_MOD_BY" name="SRCH_MOD_BY" displayText="Modified By" rowSpan="2" />
        </ui:field-group>
        <ui:field-group id="dateRange" select="$root">
          <!--          <ui:date-range displayText="Modified Date" name="SRCH_MOD_DATE" fromDate="$root/FROM_DATE/@Value" toDate="$root/TO_DATE/@Value"/>-->
          <ui:date-range name="SRCH_MOD_DATE" displayText="Modified Date Range" fromDate="{FROM_SRCH_MOD_DATE/@Value}" toDate="{TO_SRCH_MOD_DATE/@Value}" />
        </ui:field-group>
      </ui:search>
    </ui:step>
  </ui:container>
  <ui:container id="bottomContainer" displayText="">
    <ui:validation successMessage="{$root/SUCCESS_MESSAGE/@Value}" anyFieldIsRequired="false" />
    <ui:step id="c1" displayText="" editable="true">
      <ui:table displayText="RP Top Level Parameters" rowSrc="$root/RESPONSE/SEGMENT_DETAILS " collapsable="true" totalRowCount="$root/ROWCOUNT/@Value" startAtRow="$root/SEGMENT_LISTS/@startRowCount" maxRows="2" selectable="All" rowId="EngineSegCombo" exportable="true" scrollable="true" postRowIdAs="SelectedEngineSegCombo" doPaging="true" id="TopLevelDetails">
        <ui:field-group>
          <ui:entry-field editable="false" displayText="Engine Id" name="EngineId" />
          <ui:entry-field editable="false" displayText="Segment Description" name="SegmentDescription" id="SegmentDescription" />
          <ui:entry-field editable="false" displayText="Segment Name" name="SegmentIdentification" id="SegmentIdentification" />
          <ui:hidden-field name="EngineSegCombo" />
          <ui:hidden-field name="EngineIdHidden" />
          <ui:hidden-field name="EngineIdAsRowId" />
          <ui:choose-field name="Enterprise" displayText="Enterprise">
            <ui:when test="(BASETAG/@Value='true') ">
              <ui:entry-field name="Enterprise" editable="false" />
            </ui:when>
            <ui:otherwise>
              <ui:entry-field name="Enterprise" editable="false" />
            </ui:otherwise>
          </ui:choose-field>
          <ui:choose-field name="InstanceId" displayText="Instance Id">
            <ui:when test="(BASETAG/@Value='true') ">
              <ui:entry-field name="InstanceId" editable="false" />
            </ui:when>
            <ui:otherwise>
              <ui:entry-field name="InstanceId" editable="false" />
            </ui:otherwise>
          </ui:choose-field>
          <ui:entry-field id="LAST_MODIFIED_DATE" name="LAST_MODIFIED_DATE" displayText="Date Modified" sortable="true" dataType="Date" editable="false" />
          <ui:entry-field id="ModifiedBy" name="ModifiedBy" displayText="Modified By" sortable="true" editable="false" />
          <ui:entry-field id="Comments" name="Comments" displayText="Comments" sortable="true" editable="false" />
        </ui:field-group>
        <ui:buttons id="tableButtons">
          <ui:button displayText="Show History" id="ShowHistory" name="ShowHistory" enabledBySelections="true" />
          <ui:divider />
          <ui:button displayText="Mass Update" id="MassUpdate" name="MassUpdate" enabledBySelections="true" />
          <ui:divider />
          <ui:button displayText="Copy" id="copy" name="copy" enabledBySelections="true" validate="false" onClick="javaScript:checkCopy('TopLevelDetails')" />
          <ui:button displayText="Create" id="create" name="create" enabledBySelections="false" validate="false" />
          <ui:divider />
          <ui:button displayText="Delete" id="Delete" name="Delete" enabledBySelections="true" />
          <ui:divider />
          <!--         <ui:button displayText="Save" id="Save" name="Save" enabledBySelections="true"/>-->
        </ui:buttons>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:script>function checkCopy(tableid)
		{

		var table = document.getElementById(tableid+"_data");
		var count=0,j;
		var a=document.getElementsByName('SelectedEngineSegCombo');
										//alert(a);
		for( k=0; k &lt;a.length;k++)
		{
		
		if(a[k].checked)
		{
		count++;
		}
		}

		if(count&gt;=2){
		core_alert('Copy One Record at a time');
		}else{

				 document.form.BUTTON_ID.value="copy";

                document.form.submit();
		}
		}</ui:script>
</ui:page-group>

