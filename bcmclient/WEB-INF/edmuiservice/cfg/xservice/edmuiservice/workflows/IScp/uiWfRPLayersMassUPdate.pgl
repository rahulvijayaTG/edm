<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="uiWfRPLayersMassUPdate.pgl">
  <ui:container id="topContainer">
    <ui:step id="c1" displayText="RP Layer Parameters" editable="true">
      <ui:validation successMessage="{$root/SUCCESSMSG/MSG/@Value}" anyFieldIsRequired="false" />
      <ui:table displayText="RP Layers" rowSrc="$root/LAYER_DETAILS_LIST/LAYER_DETAILS" collapsable="false" totalRowCount="$root/ROWCOUNT/@Value" maxRows="10" exportable="true" configurable="false" postRowIdAs="SelectedLayer">
        <ui:field-group>
          <ui:display-field displayText="Engine Id" name="EngineId" editable="false" />
          <ui:hidden-field name="EngineIdLayerNameCombo" />
          <ui:display-field displayText="Layer Name" name="DemandCategoryName" editable="false" />
          <ui:display-field displayText="Analytical Model Name" name="AnalyticalModelName" editable="false" />
          <ui:display-field displayText="AllocationBandText" name="AllocationBandText" />
          <ui:display-field displayText="LayerEffectiveEndDayNumber" name="LayerEffectiveEndDayNumber" type="Number" />
          <ui:display-field displayText="LayerEffectiveStartDayNumber" name="LayerEffectiveStartDayNumber" type="Number" />
          <ui:display-field displayText="DemandType" name="DemandType" />
          <ui:display-field id="DemandCategoryPriorityNumber" name="DemandCategoryPriorityNumber" displayText="DemandCategoryPriorityNumber" sortable="true" type="Number" />
          <!--  <ui:display-field id="ModifiedBy" name="ModifiedBy" displayText="Modified By" sortable="true"/>
          <ui:display-field id="LAST_MODIFIED_DATE" name="LAST_MODIFIED_DATE" displayText="Last Modified" sortable="true"/>-->
        </ui:field-group>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:container id="bottomContainer" displayText="Mass Update">
    <ui:step id="c1" displayText="" editable="true">
      <ui:validation />
      <ui:table displayText="Updateable Parameters" rowSrc="$root/PARAMETER_NAMES/PARAMETER_NAME" postRowIdAs="SelectedParameterName" rowId="paramName" exportable="false" selectable="All" scrollable="true" id="MassUpdate">
        <ui:field-group>
          <ui:display-field displayText="Parameter Name" name="ParameterName" id="ParameterName" />
          <ui:hidden-field name="paramName" id="paramName" />
          <ui:choose-field name="ParameterValue" displayText="Parameter Value">
            <ui:when test="DROPDOWN/@Value = 'true'">
              <ui:dropdown size="1" optionSrc="$root/DemandType/ID" />
            </ui:when>
            <ui:otherwise>
              <ui:entry-field name="PARAMVAL" required="false" value="{$root/PARAM_DETAILS_LIST/PARAM_DETAILS/PARAMVAL/@Value}" />
            </ui:otherwise>
          </ui:choose-field>
          <ui:textarea name="Comments" displayText="Comments" required="true" />
        </ui:field-group>
        <ui:buttons>
          <ui:button displayText="Save" id="Save" name="Save" enabledBySelections="true" onClick="javaScript:checkComments('MassUpdate')" />
          <ui:button displayText="Cancel" id="Cancel" name="Cancel" enabledBySelections="false" />
        </ui:buttons>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:script>function checkComments(tableid)
		{
		var table = document.getElementById(tableid+"_data");
		var count=0,j;
		var a=document.getElementsByName('SelectedParameterName');
										//alert(a);
		for( k=0; k &lt;a.length;k++)
		{
		
		if(a[k].checked)
		{
//	alert(k);
			for(var j=0;j&lt; table.rows[k].cells.length;j++)
		{
		//alert(table.rows[k].cells[j].childNodes[0].value);
		if(table.rows[k].cells[j].childNodes[0].tagName =="TEXTAREA" &amp;&amp; (table.rows[k].cells[j].childNodes[0].value=="" || table.rows[k].cells[j].childNodes[0].value==null))
		{

		core_alert("Enter Comments for  "+table.rows[k].cells[0].childNodes[0].value);
		return;
		}
		}
		}
		}
				 document.form.BUTTON_ID.value="Save";

                document.form.submit();
		}</ui:script>
</ui:page-group>

