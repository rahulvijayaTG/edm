  <ui:script>
    var dtCh= "/";
  var minYear=1901;
  var maxYear=9999;
  		
  function isInteger(s){
  	var i;
      for (i = 0; i &lt; s.length; i++){   
          // Check that current character is number.
          var c = s.charAt(i);
          if (((c &lt; "0") || (c &gt; "9"))) return false;
      }
      // All characters are numbers.
      return true;
  }
  
  
  function stripCharsInBag(s, bag){
  	var i;
      var returnString = "";
      // Search through string's characters one by one.
      // If character is not in bag, append to returnString.
      for (i = 0; i &lt; s.length; i++){   
          var c = s.charAt(i);
          if (bag.indexOf(c) == -1) returnString += c;
      }
      return returnString;
  }
  
  function daysInFebruary (year){
  	// February has 29 days in any year evenly divisible by four,
      // EXCEPT for centurial years which are not also divisible by 400.
      return (((year % 4 == 0) &amp;&amp; ( (!(year % 100 == 0)) || (year % 400 == 0))) ? 29 : 28 );
  }
  function DaysArray(n) {
  	for (var i = 1; i &lt;= n; i++) {
  		this[i] = 31;
  		if (i==4 || i==6 || i==9 || i==11) {this[i] = 30;}
  		if (i==2) {this[i] = 29;}
     } 
     return this;
  }
  
  function isDate(dtStr){
  	var dtCh= "/";	
  	var daysInMonth = DaysArray(12);
  	var pos1=dtStr.indexOf(dtCh);
  	var pos2=dtStr.indexOf(dtCh,pos1+1);
  	var strMonth=dtStr.substring(0,pos1);
  	var strDay=dtStr.substring(pos1+1,pos2);
  	var strYear=dtStr.substring(pos2+1);
  	strYr=strYear;
  	if (strDay.charAt(0)=='0' &amp;&amp; strDay.length&gt;1) strDay=strDay.substring(1);
  	if (strMonth.charAt(0)=='0' &amp;&amp; strMonth.length&gt;1) strMonth=strMonth.substring(1);
  	for (var i = 1; i &lt;= 3; i++) {
  		if (strYr.charAt(0)=="0" &amp;&amp; strYr.length&gt;1) strYr=strYr.substring(1);
  	}
  	month=parseInt(strMonth);
  	day=parseInt(strDay);
  	year=parseInt(strYr);
  	if (pos1==-1 || pos2==-1){
  		//core_alert("The date format should be : MM/DD/YYYY");
  		return false;
  	}
  if (strMonth.length &lt;1 || month&lt;1 || month&gt;12){
  		//core_alert("Please enter a valid month");
  		return false;
  	}
  if (strDay.length&lt;1 || day&lt;1 || day&gt;31 || (month==2 &amp;&amp; day&gt;daysInFebruary(year)) || day &gt; daysInMonth[month]){
  		//core_alert("Please enter a valid day");
  		return false;
  	}
  	if (strYear.length != 4 || year==0 || year&lt;minYear || year&gt;maxYear){
  		//core_alert("Please enter a valid 4 digit year between "+minYear+" and "+maxYear);
  		return false;
  	}		
  	if (dtStr.indexOf(dtCh,pos2+1)!=-1 || isInteger(stripCharsInBag(dtStr, dtCh))==false){
  		//core_alert("Please enter a valid date");
  		return false;
  	}
  return true;
}		
  
  
  function checkDateFormat(dtStr)
  {
     // Regular expression used to check if date is in correct format
     var pattern = new RegExp("0|1[0-9]/[0-3][0-9]/19|20[0-9]{2}");
     if(dtStr.match(pattern))
     {
        var date_array = dtStr.split('/');
  		
        // Attention! Javascript consider months in the range 0 - 11
        var month = date_array[0]-1;
  
        var day = date_array[1];
        var year = date_array[2];
  
        // This instruction will create a date object
        source_date = new Date(year,month,day);
  
        if(year != source_date.getFullYear())
        {
          // core_alert('The Entered Date is not valid!');
           return false;
        }
  
        if(month != source_date.getMonth())
        {
          // core_alert('The Entered Date is not valid!');
           return false;
        }
  
        if(day != source_date.getDate())
        {
          // core_alert('The Entered Date is not valid!');
           return false;
        }
     }
     else
     {
        // core_alert('The Entered Date Format is not valid!');
        return false;
     }
  
     return true;
  }		
	
  
  
  function fetchRPLUomVal(){
		//code for DR days update start
		  var sun =document.getElementsByName( 'SUN' );		
		var mon = document.getElementsByName( 'MON' );
		var tue = document.getElementsByName( 'TUE' );
		var wed = document.getElementsByName( 'WED' );
		var thu = document.getElementsByName( 'THU' );
		var fri = document.getElementsByName( 'FRI' );
		var sat = document.getElementsByName( 'SAT' );
		var destnRcvngDays =  document.getElementsByName( 'DestinationReceivingDays' );
		var originalComments = document.getElementsByName('origComments');
		//var destnRcvngDay;
		  var selectedIds =document.getElementsByName( 'SEQ_NUM' );
		  var length = selectedIds.length;
	    var canSave;

      for(i=0; i &lt; length; i++)
			{
        var t = selectedIds[ i ];
       // var commentValue = commentList[ i ];				
        if ( t.checked )
        {		
		if(sun[i].checked)								
		    destnRcvngDay = 1;
		else
		    destnRcvngDay = 0;
		if(mon[i].checked)								
				destnRcvngDay += '' + 1;
		else
		    destnRcvngDay +='' + 0;
		if(tue[i].checked)								
		    destnRcvngDay +='' + 1;
		else
		    destnRcvngDay +='' + 0;
		if(wed[i].checked)								
		    destnRcvngDay += '' + 1;
		else
		    destnRcvngDay += '' + 0;
		if(thu[i].checked)								
		    destnRcvngDay += '' + 1;
		else
		    destnRcvngDay += '' + 0;
		if(fri[i].checked)								
		    destnRcvngDay += '' + 1;
		else
		    destnRcvngDay += '' + 0;
		if(sat[i].checked)								
		    destnRcvngDay += '' + 1;
		else
		    destnRcvngDay += '' + 0;	
		destnRcvngDays[ i ].value = destnRcvngDay;
	//	alert(destnRcvngDays[ i ].value);
		}
		}
				//code for DR days update END
		
		
		var a=document.getElementsByName('SEQ_NUM');
		var rplUomJSVar = document.getElementsByName('ReplenishmentLotSizeUOM');
     var rplUomHiddenJSVar = document.getElementsByName('ReplenishmentLotSizeUOMHidden');
		var ItemIdentificationJSVar = document.getElementsByName('ItemIdentification');
				var TransportLaneXItemCommentTextJSVar = document.getElementsByName('TransportLaneXItemCommentText');

		
var cansubmit = 'false';
		for( k=0; k &lt;a.length;k++)
		{
		
		if(a[k].checked)
	   	{

		if(rplUomJSVar[k].value != rplUomHiddenJSVar[k].value){
		if(rplUomJSVar[k].value==''){
		core_alert('Please select a value for Replenishment Lot Size UOM');
		cansubmit = 'false';
		return;
		}else{
		document.form.SelectedRPLUOMItemVal.value=ItemIdentificationJSVar[k].value;
		document.form.SelectedRPLUOMVal.value=rplUomJSVar[k].value;
			document.form.SelectedSEQUENCENUM.value=a[k].value;
cansubmit = 'true';
		break;
		}
	      	}
		   }
		}

		if(cansubmit = 'true'){
						 document.form.BUTTON_ID.value="fetchRPLUom";

                document.form.submit();
		    }
		}
		
		function onSearch(){
		var canSearch = "true";

				var laneId = document.form.SRCH_TL_ID.value;
		
		var matNo = document.form.SRCH_ITEM_ID.value;
		var laneName = document.form.SRCH_TL_ID.value;
		var segment = document.form.SRCH_SEGMENT_ID.value;
		var laneStatus = document.form.SRCH_LNE_ITEM_STATUS.value;
		var laneStartDate = document.form.SRCH_LNE_ITEM_STRT_DATE_DC.value;
		var laneEndDate = document.form.SRCH_LNE_ITEM_END_DATE_DC.value;
		if(laneStartDate != '')
		{
		   //if(checkDateFormat(laneStartDate) == false){
		   if(isDate(laneStartDate) == false){
		    core_alert('Invalid Date: Please Enter a Valid Start Date: M/d/yyyy');
		     document.form.SRCH_LNE_ITEM_STRT_DATE_DC.focus();
		     canSearch = 'false';
	   	   return;
		   }
		}
		
		if(laneEndDate != '')
		{
		   //if(checkDateFormat(laneEndDate) == false){
		    if(isDate(laneEndDate) == false){
		    core_alert('Invalid Date: Please Enter a Valid End Date: M/d/yyyy');
		     document.form.SRCH_LNE_ITEM_END_DATE_DC.focus();
		     canSearch = 'false';
	   	   return;
		   }
		}		
		if (matNo=='' 	&amp;&amp; laneName=='' 		&amp;&amp; segment=='*' 		&amp;&amp; laneStatus=='*' 		&amp;&amp; laneStartDate=='' 		&amp;&amp; laneEndDate=='' ){
		var response = core_confirm('No search criteria entered, the search might take a long time. Would you still like to continue with the search?');
					if ( response == 'yes' ) {
						canSearch = 'true';
					} else {
						canSearch = 'false';
					}
		}

		// here /g represents global search
		
    var repStr = new RegExp(/[\*]/g);
  	document.form.TL_WILD_CARD_SRCH.value = laneId.replace(repStr,'%');				

		if(canSearch=='true')
			{
								document.form.BUTTON_ID.value = 'search_button'; 
							document.form.action = 'view.x2ps';
							document.form.submit();  
	   	}		
		else
		return;
		}		
		
	function pglToggleButton( buttonId, hasNoSelections )
 {
   var type = btnTypes[buttonId];

   if (hasNoSelections == true)
   {
     i2uiToggleButtonState(buttonId, 'disabled');
				 i2uiToggleButtonState('create', 'enabled');
   }
   else
   {
     i2uiToggleButtonState(buttonId, 'enabled', type);
		 i2uiToggleButtonState('create', 'disabled');
   }
 }
    
    function formDestnRcvngDay(){
	  var sun =document.getElementsByName( 'SUN' );		
			  var isError =document.getElementsByName( 'isError' );		
		var mon = document.getElementsByName( 'MON' );
		var tue = document.getElementsByName( 'TUE' );
		var wed = document.getElementsByName( 'WED' );
		var thu = document.getElementsByName( 'THU' );
		var fri = document.getElementsByName( 'FRI' );
		var sat = document.getElementsByName( 'SAT' );
		var destnRcvngDays =  document.getElementsByName( 'DestinationReceivingDays' );
//		var ReplenishmentLotSize = document.getElementsByName( 'ReplenishmentLotSize_N4' );
		var ReplenishmentLotSizeUOM = document.getElementsByName( 'ReplenishmentLotSizeUOM' );		
		var srcPrir = document.getElementsByName( 'SourcingPriority' );			
		var transModePrir = document.getElementsByName( 'TransportModePriority' );
    <!-- MYANG RIC 249141 - Rounding value using for Single SKU Long Term Start -->
    var ReplenishmentRoundingValue = document.getElementsByName( 'ReplenishmentRoundingValue');
    <!-- MYANG RIC 249141 - Rounding value using for Single SKU Long Term End -->
    var commentList = document.getElementsByName('TransportLaneXItemCommentText');				
		var startDate = document.getElementsByName( 'EffectiveStartDate_DC');		
		var endDate = document.getElementsByName('EffectiveEndDate_DC');				
		var unloadingTime = document.getElementsByName('UnloadingTime');		
		var loadingTime = document.getElementsByName('LoadingTime');			
		var originalComments = document.getElementsByName('origComments');
		//var destnRcvngDay;
		  var selectedIds =document.getElementsByName( 'SEQ_NUM' );
		  var length = selectedIds.length;
	    var canSave;

		for(i=0; i &lt; length; i++)
			{
        var t = selectedIds[ i ];
       // var commentValue = commentList[ i ];				
        if ( t.checked )
        {		
		if(sun[i].checked)								
		    destnRcvngDay = 1;
		else
		    destnRcvngDay = 0;
		if(mon[i].checked)								
				destnRcvngDay += '' + 1;
		else
		    destnRcvngDay +='' + 0;
		if(tue[i].checked)								
		    destnRcvngDay +='' + 1;
		else
		    destnRcvngDay +='' + 0;
		if(wed[i].checked)								
		    destnRcvngDay += '' + 1;
		else
		    destnRcvngDay += '' + 0;
		if(thu[i].checked)								
		    destnRcvngDay += '' + 1;
		else
		    destnRcvngDay += '' + 0;
		if(fri[i].checked)								
		    destnRcvngDay += '' + 1;
		else
		    destnRcvngDay += '' + 0;
		if(sat[i].checked)								
		    destnRcvngDay += '' + 1;
		else
		    destnRcvngDay += '' + 0;	
		destnRcvngDays[ i ].value = destnRcvngDay;
		if (Date.parse(startDate[i].value) &gt; Date.parse(endDate[i].value)){
		core_alert("Invalid Date Range,Start Date cannot be after End Date!")
    		canSave = "false";
		return;
		}		
	
		/*if(ReplenishmentLotSize[i].value != ReplenishmentRoundingValue[i].value){
		core_alert("Replenishment Lot Size and the Rounding value should be the same!");
		return;
		}*/
		if(ReplenishmentLotSizeUOM[i].value.length == 0){
		core_alert("Please enter the value for Replenishment Lot Size UOM!");
		return;
		}
    <!-- MYANG RIC 249141 - Rounding value using for Single SKU Long Term Start -->
    if (ReplenishmentRoundingValue[i].value.length == 0) {
					core_alert("Please enter a positive value for Single SKU.");
					canSave = "false";
					return;				
		}
		else if (ReplenishmentRoundingValue[i].value.length &gt; 0) {
				var anum=/(^\d+$)|(^\d+\.\d+$)/;
				if (!anum.test(ReplenishmentRoundingValue[i].value)) {
					core_alert("Please enter a positive value for Single SKU.");
					canSave = "false";
					return;				
				}
		}
    <!-- MYANG RIC 249141 - Rounding value using for Single SKU Long Term End -->
    if(srcPrir[i].value.length == 0){
		core_alert("Please enter the value for Sourcing Priority!");
		return;
		}		
		if(transModePrir[i].value.length == 0){
		core_alert("Please enter the value for Transport Mode Priority!");
		return;
		}		
					
		/*if (!validateUnldngTime(unloadingTime[i].value)) {
		          return;
       		}    
		if (!validateLdngTime(loadingTime[i].value)) {
		          return;
       		} 		*/
		if(trimString(commentList[i].value).length == 0){
		core_alert("Please enter comments before saving!");
		return;		
		}
		else
		  canSave = "true";
		if(trimString(commentList[i].value).length &gt; 255){
		core_alert("Comments should not be greater than 255 characters!");
		return;		
		}
		else
		  canSave = "true";

		if (trimString(commentList[i].value) == originalComments[i].value &amp;&amp; isError[i].value == 0  ) {
		core_alert("Please enter new comments for update!")
		return;
		}		
		else
		  canSave = "true";
		}
		}
		if(canSave){
				document.form.BUTTON_ID.value = 'save'; 
		    document.form.action = 'view.x2ps';
		    document.form.submit();					
    }
		else{
				document.form.SUBMIT_AS_XML.value = 'false';		
		}
}
		
		function validateLdngTime(ldngTime) {
		var canSubmit = "false";		
		var ldngTimeDurn = ldngTime.split(":");
		var pattern = new RegExp(/([0-9]{1,2})([:]{1})([0-9]{2})([:]{1})([0-9]{2})/);
    		if(!pattern.test(ldngTime) || ldngTimeDurn.length &gt; 3 || ldngTimeDurn[2].match(/\D/)){
		       core_alert("Invalid value entered for Loading time. It should be in hh:mm:ss format!");
					 canSubmit = "false";
					 return;
		}
		if(ldngTimeDurn[0].search(/\./) != -1 || ldngTimeDurn[0]  &lt; 0 || ldngTimeDurn[0].match(/\D/)){
		       core_alert("Loading time should be a positive integer!");
		       canSubmit = "false";
					 return;		
		}				
		if(ldngTimeDurn[1]  &gt; 59){
		       core_alert("Minutes in Loading Time should not be greater than 59!");
					 canSubmit = "false";
					 return;		
		}
		if( ldngTimeDurn[2] &gt; 59){
		       core_alert("Seconds  in Loading Time should not be greater than 59!");
					 canSubmit = "false";
					 return;		
		}		
		if(ldngTimeDurn[0] &lt;=0 &amp;&amp; ldngTimeDurn[1] &lt;=0 &amp;&amp; ldngTimeDurn[2] &lt;=0){
		       core_alert("Invalid value entered for Loading Time. It should not be 00:00:00!");
					 canSubmit = "false";
					 return;		
		}		
		else{
   		       canSubmit = "true";
		}
		return canSubmit;
	}

function validateUnldngTime(unldngTime) {
		var canSubmit = "false";
		var unldngTimeDurn = unldngTime.split(":");		
				var pattern = new RegExp(/([0-9]{1,2})([:]{1})([0-9]{2})([:]{1})([0-9]{2})/);
		    		if(!pattern.test(unldngTime) || unldngTimeDurn.length &gt; 3 || unldngTimeDurn[2].match(/\D/)){
				       core_alert("Invalid value entered for Unloading time. It should be in hh:mm:ss format!");
							 canSubmit = "false";
							 return;		
				}
				if(unldngTimeDurn[0].search(/\./) != -1 || unldngTimeDurn[0]  &lt; 0 || unldngTimeDurn[0].match(/\D/)){
				       core_alert("Unloading time should be a positive integer!");
				       canSubmit = "false";
							 return;		
				}				

		if(unldngTimeDurn[1]  &gt; 59){
		       core_alert("Minutes in Unloading Time should not be greater than 59!");
					 canSubmit = "false";
					 return;		
		}
		if( unldngTimeDurn[2] &gt; 59){
		       core_alert("Seconds in Unloading Time should not be greater than 59!");
					 canSubmit = "false";
					 return;		
		}		
	 if(unldngTimeDurn[0] &lt;=0 &amp;&amp; unldngTimeDurn[1] &lt;=0 &amp;&amp; unldngTimeDurn[2] &lt;=0){
		       core_alert("Invalid value entered for Unloading Time. It should not be 00:00:00!");
					 canSubmit = "false";
					 return;		
		}		
		else{
   		       canSubmit = "true";
		}
		return canSubmit;
	}
				
		function on_delete(){
					var response = core_confirm('Are you sure you want to delete the selected record(s)?');
					if ( response == 'yes' ) {
						canSubmit = 'true';
					} else {
						canSubmit = 'false';
					}
					if (canSubmit == 'true') {
								document.form.BUTTON_ID.value = 'delete'; 
							document.form.action = 'view.x2ps';
							document.form.submit();
					}
		else{
						document.form.SUBMIT_AS_XML.value = 'false';
					}
					return;
		}
		
function on_copy(){
		var selectedIds = document.getElementsByName('SEQ_NUM');
		var count = 0;
      for(i=0; i &lt; selectedIds.length; i++)
			{
        var t = selectedIds[ i ];
        if ( t.checked )
        {
          count += 1;
        }
      }		
		if(count &gt; 1){
		            core_alert('Please select only one record for Copy!');
								return;
		}
		else{
								document.form.BUTTON_ID.value = 'copy'; 
							document.form.action = 'view.x2ps';
							document.form.submit();  		
		}
		}
	function on_massUpdate(){
 		var bIsValid = true;
 		document.form.SUBMIT_AS_XML.value = 'false';
		bIsValid = (isValid_TassetTable());
 		if( bIsValid == false )
		{
  		validation_alert('TassetTable');
		}
		if ( bIsValid == true) 
		{
		var selectedIds = document.getElementsByName('SEQ_NUM');
		var selRowCount = document.form.SELECTED_ROW_COUNT.value;
		var count = 0;
		var isValid = true;
		var prevSelCountLength = 0;
  	var arrSelRowCnts = new Array();
		if(selRowCount.length &gt; 0){
      arrSelRowCnts = selRowCount.split(",");		
			prevSelCountLength =  arrSelRowCnts.length;
		 }
     for(i=0; i &lt; selectedIds.length; i++)
			{
		        var t = selectedIds[ i ];
            if ( t.checked)
            {
				         count += 1;
						}
		  		for(j=0; j &lt; arrSelRowCnts.length; j++)
					{
        			var t = selectedIds[ i ];
        			var t1 = arrSelRowCnts[  j ];
			        if ( t.checked)
 			         {
        				if (t1 == t.value)
        				{
		 								isValid = false;
										prevSelCountLength = prevSelCountLength - 1;
                }
        			}
        			else
							{
										if (t.type != 'hidden' &amp;&amp; t1 == t.value)
        						{
        							isValid = false;
		 									prevSelCountLength = prevSelCountLength - 1;				
        						}        		
										else
													isValid = true;	
        		 	}
	         }	
      }		
			count = count + prevSelCountLength;
	
		if(document.form.TassetTable_globalrowselector.checked)
		{
				var decision=core_confirm("Do you want to update all records satisfying the current search criteria");
				if(decision=='yes')
				{
					document.form.BUTTON_ID.value = 'massUpdateAll'; 
					document.form.action = 'view.x2ps';
					document.form.submit();  	
				}
				else
				{

								if(count &lt;=1 || ( isValid == false &amp;&amp; prevSelCountLength == 1)){
		            core_alert('Please select at least two records for mass update!');
								return;
								}
								else{
						  	disableButtons(); 
						  	trapExcelPivotChanges(); 				
					  		document.form.BUTTON_ID.value = 'massUpdate'; 
								document.form.action = 'view.x2ps';
								document.form.submit();  							
		   		}
	

		 }
  }
		else
				{

								if(count &lt;=1 || ( isValid == false &amp;&amp; prevSelCountLength == 1)){
		            core_alert('Please select at least two records for mass update!');
								return;
								}
								else{
						  	disableButtons(); 
						  	trapExcelPivotChanges(); 				
					  		document.form.BUTTON_ID.value = 'massUpdate'; 
								document.form.action = 'view.x2ps';
								document.form.submit();  							
		   		}
		}
		}
}
  </ui:script>
</ui:page-group>

