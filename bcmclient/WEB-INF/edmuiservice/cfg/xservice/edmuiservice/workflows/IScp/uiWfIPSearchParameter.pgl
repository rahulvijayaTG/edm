<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="uiWfIPSegParamSearchParameter.pgl">
	<ui:container id="top" displayText="Select Segments">
		<ui:step id="topStep">
			<ui:search id="srchContainer" displayText="Search" exportSearch="false" saveSearch="false">
				<ui:field-group id="srch" columns="2">
					<ui:entry-field id="SRCH_PARAM_NAME" name="SRCH_PARAM_NAME" displayText="Parameter Name"/>
					<ui:entry-field id="SRCH_PARAM_DESC" name="SRCH_PARAM_DESC" displayText="Parameter Description"/>
					<ui:hidden-field name="FIELD_NAME" value="{$root/FIELD_NAME/@Value}"/>
				</ui:field-group>
			</ui:search>
			<ui:table id="bottomTable" displayText="IP Parameters" rowSrc="$root/RESPONSE/P_Parameter" rowId="ParameterName" selectable="All" postRowIdAs="SELECTED_ITEM">
				<ui:field-group id="tableColumns" width="100%">
					<ui:display-field name="ParameterMnemonicValue" id="ParameterMnemonicValue" displayText="Parameter Name"/>
					<ui:display-field name="ParameterDescription" id="ParameterDescription" displayText="Parameter Description"/>
					<ui:display-field name="UnitOfMeasureMnemonicValue" id="UnitOfMeasureMnemonicValue" displayText="UOM"/>
				</ui:field-group>
				<ui:buttons>
					<ui:button id="select" name="select" displayText="Select" emphasized="true" enabledBySelections="true" onClick="javascript:selectItem();"/>
				</ui:buttons>
			</ui:table>
		</ui:step>
	</ui:container>
	<ui:script>function selectItem()
    {
		  var selectedIds =document.getElementsByName( 'SELECTED_ITEM' );
		  var length = selectedIds.length;
      var items = null;
      var categoryCodes = null;
      for(i=0; i &lt; length; i++)
			{
        var t = selectedIds[ i ];
        if ( t.checked )
        {
          if( items )
            items += ',' + t.value;
          else
            items = t.value;
        }
      }
      if ( document.form.FIELD_NAME.value.length &gt; 0)
        {
		          var fieldName = document.form.FIELD_NAME.value;
          eval("parent.opener.form." + fieldName + ".value = items;");
      }
      window.close();    
      }
		function onSearch()
      {

		 document.form.BUTTON_ID.value="search_button";
                document.form.submit();
		}</ui:script>
</ui:page-group>
