            <USER_ID Value="{$userId}"/>
          </REQUEST>
          <TO_DOCVAR AssignToVar="formattedTypes">
            <INTR_RSN/>
          </TO_DOCVAR>
          <FOR_EACH CurrentElement="curRsnType" SelectList="$piSrchResult/INTR_RSN/*">
            <APPEND_TO_XML DocVar="formattedTypes">
              <OPTION Value="{concat($curRsnType/ItemInterchangeReasonMnemonicValue/@Value,' - ',$curRsnType/ItemInterchangeReasonName/@Value)}" Id="{$curRsnType/ItemInterchangeReasonMnemonicValue/@Value}"/>
            </APPEND_TO_XML>
          </FOR_EACH>
          <TO_DOCVAR AssignToVar="pglFormInput">
            <ROOT>
              <SELECT Value="{ifElse(contains($roleAccessPerm/SQL_RESULT/ACCESS_LEVEL/@Value,'Update') or contains($roleAccessPerm/SQL_RESULT/ACCESS_LEVEL/@Value,'Add') or contains($roleAccessPerm/SQL_RESULT/ACCESS_LEVEL/@Value,'Delete'),'All','None')}"/>
              <SEARCH_FIELDS>
                <TO_XML SelectList="$appliedFilters/InterchangeGroupMnValue"/>
                <TO_XML SelectList="$appliedFilters/InterchangeGroupDesc"/>
                <TO_XML SelectList="$appliedFilters/InterchangeGroupStatus"/>
                <TO_XML SelectList="$appliedFilters/RelatedItemIdentifier"/>
                <TO_XML SelectList="$appliedFilters/PrimaryItemIdentifier"/>
                <TO_XML SelectList="$appliedFilters/modifiedby"/>
                <TO_XML SelectList="$appliedFilters/FROM_modifieddate"/>
                <TO_XML SelectList="$appliedFilters/TO_modifieddate"/>
              </SEARCH_FIELDS>
              <AccessLevel Value="{$roleAccessPerm/SQL_RESULT/ACCESS_LEVEL/@Value}"/>
              <START_AT_ROW Value="{$paginateStart}"/>
              <!--<TotalRowCount Value="{$piSrchResult/TotalRowCount/@Value}"/> row count is present in pisearchresults. check the xml-->
              <MaxRows Value="{$pgMaxRows}"/>
              <SORT_BY Value="{$sortBy}"/>
              <SORT_ORDER Value="{$sortOrder}"/>
              <GRP_STS>
                <OPTION Value="Select All" Id="*"/>
                <DROP_DOWN_OPTIONS SelectList="$piSrchResult/GRP_STS/P_ItemInterchangeGroupStatus" Id="ItemInterchangeGroupStatusMnemonicValue" Value="ItemInterchangeGroupStatusMnemonicValue"/>
              </GRP_STS>
              <TO_XML DocVar="formattedTypes"/>
              <TO_XML SelectList="$piSrchResult/*"/>
              <USER_ACTION Value="{$userAction}"/>
            </ROOT>
          </TO_DOCVAR>
        </action>
      </pre_actions>
      <post_actions>
