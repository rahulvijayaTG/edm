          <SET DocVar="sortByTag" Attribute="Sort" FromValue="{$sortOrder}"/>
          <SET DocVar="thisParam" Property="EntityState" FromValue="ACTIVE"/>
          <IF_TEST Test="$thisParam/TO_modifieddate/@Value != null and $thisParam/TO_modifieddate/@Value !=''">
            <THEN>
              <SET_PROPS Select="$thisParam">
                <TO_modifieddate Value="{concat($thisParam/TO_modifieddate/@Value,' 23:59:59')}"/>
              </SET_PROPS>
            </THEN>
          </IF_TEST>
          <IF_TEST Test="$userAction != 'Save' or $successSave = 'YES'">
            <THEN>
              <IF_TEST Test="$isSearch = 'YES'">
                <THEN>
                  <FORM_SEARCH_FILTER Value="{$appliedFilters}" AssignToVar="piFilters">
                    <InterchangeGroupMnValue MultiValued="true"/>
                    <InterchangeGroupDesc MultiValued="true"/>
                    <InterchangeGroupStatus MultiValued="true"/>
                    <RelatedItemIdentifier MultiValued="true"/>
                    <PrimaryItemIdentifier MultiValued="true"/>
                    <EntityState/>
                    <modifiedby MultiValued="true"/>
                    <modifieddate Range="true"/>
                  </FORM_SEARCH_FILTER>
                </THEN>
              </IF_TEST>
              <REQUEST Name="readPIGrps" ServiceName="BCM_MASTER" AssignToVar="piSrchResult" ReturnRowCount="yes">
                <MaxRows Value="{$pgMaxRows}"/>
                <StartAtRow Value="{$paginateStart}"/>
