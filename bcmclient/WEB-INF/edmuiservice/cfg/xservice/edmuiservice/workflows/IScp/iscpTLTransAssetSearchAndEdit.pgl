<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="TLTransAssetSearchAndEdit.pgl">
  <ui:search displayText="Transportation Asset Search" exportSearch="false" saveSearch="false" collapsable="true">
    <ui:validation id="srchVal" instructionMessage="Please enter at least one of Asset Id or Asset Description for Search" anyFieldIsRequired="false" displayCondition="123" />
    <!--    <ui:field-group>
      <ui:display-field name="insMsg" displayText="Please enter at least one of Asset Id or Asset Description for Search"/>
    </ui:field-group>-->
    <ui:field-group columns="2" select="$root/SEARCH_FIELDS">
      <!--      <ui:entry-field name="SRCH_ITEM_ID" displayText="Asset Number">
        <ui:links>
          <ui:link displayText="Select Assets" targetType="popup" targetName="catalogPopup">
            <ui:url page="view.x2ps">
              <SELECTABLE select="'All'"/>
              <ITEM_TYPE select="'TRAN'"/>
              <BUTTON_ID select="'Select_TA_id'"/>
              <FIELD_NAME select="'SRCH_ITEM_ID'"/>
            </ui:url>
            <ui:image src="pop_up_window.gif"/>
          </ui:link>
        </ui:links>
      </ui:entry-field>-->
      <ui:entry-field name="SRCH_ITEM_ID" displayText="Asset Number">
        <ui:links>
          <ui:link displayText="Select Assets" onClick="javascript:openPopUp()">
            <ui:image src="pop_up_window.gif" />
          </ui:link>
        </ui:links>
      </ui:entry-field>
      <ui:entry-field name="SRCH_ITEM_DESC" displayText="Asset Description" onBlur="javascript:saveDesc(this);" />
      <!--<ui:entry-field name="SRCH_MOD_BY" displayText="Modified By">
        <ui:links>
          <ui:link displayText="Select Users" targetType="popup" targetName="catalogPopup">
            <ui:url page="view.x2ps">
              <SELECTABLE select="'All'"/>
              <BUTTON_ID select="'Select_User'"/>
              <FIELD_NAME select="'SRCH_MOD_BY'"/>
            </ui:url>
            <ui:image src="pop_up_window.gif"/>
          </ui:link>
        </ui:links>
      </ui:entry-field>-->
      <ui:hidden-field name="SELECTED_ROW_COUNT" />
    </ui:field-group>
    <!-- <ui:field-group id="advFilter" columns="2" select="$root/SEARCH_FIELDS">
      <ui:date-range displayText="Modified Date Range" name="SRCH_MOD_DATE" fromDate="{FROM_SRCH_MOD_DATE/@Value}" toDate="{TO_SRCH_MOD_DATE/@Value}"/>
    </ui:field-group>-->
  </ui:search>
  <ui:container id="srchResCont" name="srchResCont" scrollable="true">
    <ui:step id="srchResStep" name="srchResStep" displayText="Transportation Asset Search Results" scrollable="true">
      <ui:validation anyFieldIsRequired="false" successMessage="{$root/SUCCESS_MESSAGE/@Value}" />
      <ui:table id="TAssetTable" name="TAssetTable" displayText="Transportation Asset Search Results" displayTextNoRecords="No Records Found" rowSrc="P_TransportEquipmentItem" select="$root/TA_DETAILS" rowId="ItemId" postRowIdAs="SELECTED_TA_ID" selectable="{$root/SELECT/@Value}" totalRowCount="$root/TotalRowCount/@Value" startAtRow="$root/START_AT_ROW/@Value" rememberSelections="true" freeze="1" scrollable="true" exportable="true" filter="false" collapsable="false">
        <ui:field-group>
          <ui:entry-field displayText="Asset Number" name="ItemId" sortable="true" editable="false" filter="false" />
          <ui:choose-field id="ItemDescription" displayText="Asset Description">
            <ui:when test="contains($root/AccessLevel/@Value,'Update') or contains($root/AccessLevel/@Value,'Add')">
              <ui:entry-field displayText="Asset Description" name="ItemDescription" filter="false" sortable="true" />
            </ui:when>
            <ui:otherwise>
              <ui:display-field displayText="Asset Description " name="ItemDescription" />
            </ui:otherwise>
          </ui:choose-field>
          <ui:choose-field id="DefaultPalletAmount" displayText="Number of Asset Pallets">
            <ui:when test="contains($root/AccessLevel/@Value,'Update') or contains($root/AccessLevel/@Value,'Add')">
              <ui:entry-field displayText="Number of Asset Pallets" name="DefaultPalletAmount" sortable="true" dataType="Number" decimals="0" maxlength="11" filter="true" unFormat="true" minValue="1" />
            </ui:when>
            <ui:otherwise>
              <ui:display-field displayText="Number of Asset Pallets " name="DefaultPalletAmount" unFormat="true" dataType="Number" decimals="0" />
            </ui:otherwise>
          </ui:choose-field>
          <ui:choose-field id="CubeVolumeMeasureiption" displayText="Default Asset Cube">
            <ui:when test="contains($root/AccessLevel/@Value,'Update') or contains($root/AccessLevel/@Value,'Add')">
              <ui:entry-field displayText="Default Asset Cube " name="CubeVolumeMeasure" sortable="true" dataType="Number" decimals="0" maxlength="13" unFormat="true" filter="true" minValue="1" />
            </ui:when>
            <ui:otherwise>
              <ui:display-field displayText="Default Asset Cube " name="CubeVolumeMeasure" unFormat="true" />
            </ui:otherwise>
          </ui:choose-field>
          <ui:choose-field id="CubeVolumeUOMId" displayText="Asset Cube UOM">
            <ui:when test="contains($root/AccessLevel/@Value,'Update') or contains($root/AccessLevel/@Value,'Add')">
              <ui:dropdown displayText="Asset Cube UOM " name="CubeVolumeUOMId" optionSrc="$root/UOM_VALUES1/*" filter="false" sortable="true" />
            </ui:when>
            <ui:otherwise>
              <!--  <ui:display-field displayText="Asset Cube UOM " name="CubeVolumeUOMId"/>-->
              <ui:dropdown displayText="Asset Cube UOM " name="CubeVolumeUOMId" optionSrc="$root/UOM_VALUES1/*" editable="false" />
            </ui:otherwise>
          </ui:choose-field>
          <ui:choose-field id="TareWeightMeasure" displayText="Default Asset Weight">
            <ui:when test="contains($root/AccessLevel/@Value,'Update') or contains($root/AccessLevel/@Value,'Add')">
              <ui:entry-field displayText="Default Asset Weight" name="TareWeightMeasure" sortable="true" dataType="Number" decimals="0" maxlength="13" filter="true" unFormat="true" minValue="1" />
            </ui:when>
            <ui:otherwise>
              <ui:display-field displayText="Default Asset Weight" name="TareWeightMeasure" unFormat="true" />
            </ui:otherwise>
          </ui:choose-field>
          <ui:choose-field id="TareWeightUOMId" displayText="Asset Weight UOM">
            <ui:when test="contains($root/AccessLevel/@Value,'Update') or contains($root/AccessLevel/@Value,'Add')">
              <ui:dropdown displayText="Asset Weight UOM" name="TareWeightUOMId" optionSrc="$root/UOM_VALUES/*" filter="false" sortable="true" />
            </ui:when>
            <ui:otherwise>
              <!-- <ui:display-field displayText="Asset Weight UOM " name="TareWeightUOMId"/>-->
              <ui:dropdown displayText="Asset Weight UOM" name="TareWeightUOMId" optionSrc="$root/UOM_VALUES/*" editable="false" />
            </ui:otherwise>
          </ui:choose-field>
          <ui:hidden-field id="origComments" name="origComments" value="{TransportEquipmentItemCommentText/@Value}" />
          <ui:hidden-field id="isError" name="isError" value="{count($root/P_TransportEquipmentItem/*/_ERRORS)}" />
          <!-- ADDED BY VAMSHI FOR MULTI USER EDIT -->
          <ui:hidden-field name="LAST_MODIFIED_DATE" id="LAST_MODIFIED_DATE" />
          <ui:choose-field id="TransportEquipmentItemCommentText" displayText="Comments">
            <ui:when test="contains($root/AccessLevel/@Value,'Update') or contains($root/AccessLevel/@Value,'Add')">
              <ui:textarea displayText="Comments" name="TransportEquipmentItemCommentText" />
            </ui:when>
            <ui:otherwise>
              <ui:textarea displayText="Comments" name="TransportEquipmentItemCommentText" editable="false" />
            </ui:otherwise>
          </ui:choose-field>
          <!--<ui:display-field displayText="Date Modified" name="LAST_MODIFIED_DATE" sortable="true" filter="false"/>
          <ui:display-field displayText="Modified By" name="LAST_MODIFIED_BY" sortable="true" filter="false"/>-->
        </ui:field-group>
        <ui:buttons id="buttons1" name="buttons1">
          <!--          <ui:button displayText="Show History" id="showHistory" name="showHistory" enabledBySelections="false"/>-->
          <ui:button displayText="Delete" id="delete" name="delete" enabledBySelections="true" displayCondition="{contains($root/AccessLevel/@Value,'Remove')}" />
          <ui:button displayText="Mass Update" id="massUpdate" name="massUpdate" enabledBySelections="true" displayCondition="{contains($root/AccessLevel/@Value,'Update')}" />
          <ui:button displayText="Copy" id="copy" name="copy" enabledBySelections="true" displayCondition="{contains($root/AccessLevel/@Value,'Add')}" />
          <ui:button displayText="Create" id="create" name="create" displayCondition="{contains($root/AccessLevel/@Value,'Add')}" />
          <ui:button displayText="Save" id="save" name="save" enabledBySelections="true" displayCondition="{contains($root/AccessLevel/@Value,'Update')}" />
        </ui:buttons>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:script>function onSearch(){
		var canSearch = "true";
	/*	var startDateSrch = document.form.FROM_SRCH_MOD_DATE_DC.value;
		var endDateSrch = document.form.TO_SRCH_MOD_DATE_DC.value;
     var currDate= new Date();
		var formatDate = currDate.getMonth()+1+'/'+currDate.getDate()+'/'+currDate.getYear();
		if (Date.parse(endDateSrch) &gt; Date.parse(currDate)) {
    core_alert("To Date cannot be greater than the current date!");
		canSearch = "false";
		return;
		}
		else
				canSearch = "true";
		if (endDateSrch.length &gt; 0 &amp;&amp; startDateSrch.length &lt;= 0) {
				document.form.FROM_SRCH_MOD_DATE_DC.value =endDateSrch; 
    core_alert("Please specify From date to Search!");
		canSearch = "false";
		return;
		}
		if (startDateSrch.length &gt; 0 &amp;&amp; endDateSrch.length &lt;= 0) {
   document.form.TO_SRCH_MOD_DATE_DC.value =startDateSrch; 
		}		*/
		if(canSearch)
			{
								document.form.BUTTON_ID.value = 'search_button'; 
							document.form.action = 'view.x2ps';
							document.form.submit();  
	   	}		
		}		
		
	function pglToggleButton( buttonId, hasNoSelections )
 {
   var type = btnTypes[buttonId];

   if (hasNoSelections == true)
   {
     i2uiToggleButtonState(buttonId, 'disabled');
				 i2uiToggleButtonState('create', 'enabled');
   }
   else
   {
     i2uiToggleButtonState(buttonId, 'enabled', type);
		 i2uiToggleButtonState('create', 'disabled');
   }
 }				
		var desc = "";
    function saveDesc(){
    desc = trimString(this.form.SRCH_ITEM_DESC.value);
			return desc;
			}		
		function openPopUp(){
		window.open("view.x2ps?SERVICE_NAME=edmuiservice&amp;START_WORKFLOW=wfTLSelectItem&amp;FIELD_NAME=SRCH_ITEM_ID&amp;SOURCE=TransAsset&amp;SELECTABLE=All&amp;ITEM_TYPE=TRAN&amp;POPUP=true&amp;SRCH_ITEM_DESC="+desc,null,"height=480,width=740,screenX=400,screenY=400,top=250,left=400,toolbar=no,menubar=no");
		}
				
	function on_massUpdate(){
 		var bIsValid = true;
 		document.form.SUBMIT_AS_XML.value = 'false';
		bIsValid = (isValid_TAssetTable());
 		if( bIsValid == false )
		{
  		validation_alert('TAssetTable');
		}
		if ( bIsValid == true) 
		{
		var selectedIds = document.getElementsByName('SELECTED_TA_ID');
		var selRowCount = document.form.SELECTED_ROW_COUNT.value;
		var count = 0;
		var isValid = true;
		var prevSelCountLength = 0;
  		var arrSelRowCnts = new Array();
		if(selRowCount.length &gt; 0){
      			arrSelRowCnts = selRowCount.split(",");		
			prevSelCountLength =  arrSelRowCnts.length;
		 }
     		for(i=0; i &lt; selectedIds.length; i++)
			{
		        var t = selectedIds[ i ];
     		        if ( t.checked)
     		        {
							      count += 1;
								}
		  		for(j=0; j &lt; arrSelRowCnts.length; j++)
					{
        			var t = selectedIds[ i ];
        			var t1 = arrSelRowCnts[  j ];
			        if ( t.checked)
 			         {
        				if (t1 == t.value)
        				{
		 								isValid = false;
										prevSelCountLength = prevSelCountLength - 1;
                }
        			}
        			else
							{
										if (t.type != 'hidden' &amp;&amp; t1 == t.value)
        						{
        							isValid = false;
		 									prevSelCountLength = prevSelCountLength - 1;				
        						}        		
										else
													isValid = true;	
        		 	}
	         }	
       }		
			count = count + prevSelCountLength;
				if(document.form.TAssetTable_globalrowselector.checked)
		{
				var decision=core_confirm("Do you want to update all records satisfying the current search criteria");
				if(decision=='yes')
				{
					document.form.BUTTON_ID.value = 'massUpdateAll'; 
					document.form.action = 'view.x2ps';
					document.form.submit();  	
				}
				else
				{

								if(count &lt;=1 || ( isValid == false &amp;&amp; prevSelCountLength == 1)){
		            core_alert('Please select at least two records for mass update!');
								return;
								}
								else{
						  	disableButtons(); 
						  	trapExcelPivotChanges(); 				
					  		document.form.BUTTON_ID.value = 'massUpdate'; 
								document.form.action = 'view.x2ps';
								document.form.submit();  							
		   		}
	

		 }
  }
		else
			{

								if(count &lt;=1 || ( isValid == false &amp;&amp; prevSelCountLength == 1)){
		            core_alert('Please select at least two records for mass update!');
								return;
								}
								else{
						  	disableButtons(); 
						  	trapExcelPivotChanges(); 				
					  		document.form.BUTTON_ID.value = 'massUpdate'; 
								document.form.action = 'view.x2ps';
								document.form.submit();  							
		   		}
		}														
		   
		    }
  }
						
		function on_copy(){
		var selectedIds = document.getElementsByName('SELECTED_TA_ID');
		var count = 0;
      for(i=0; i &lt; selectedIds.length; i++)
			{
        var t = selectedIds[ i ];
        if ( t.checked )
        {
          count += 1;
        }
      }		
		if(count &gt; 1){
		            core_alert('Please select only one record for Copy!');
								return;
		}
		else{
								document.form.BUTTON_ID.value = 'copy'; 
							document.form.action = 'view.x2ps';
							document.form.submit();  		
		}
		}		
		/*function onSearch(){
      var itemId = document.form.SRCH_ITEM_ID.value;	
      var itemDesc = document.form.SRCH_ITEM_DESC.value;			
		if(itemId.length == 0 &amp;&amp; itemDesc.length == 0)		{
		core_alert("Select at least one of Asset Id or Asset Description for Search!"); 
		return;
		}
		else{
								document.form.BUTTON_ID.value = 'search_button'; 
							document.form.action = 'view.x2ps';
							document.form.submit();  
		}		
		}		*/
		function on_delete(){
					var response = core_confirm('Are you sure you want to delete the selected record(s)?');
					if ( response == 'yes' ) {
						canSubmit = 'true';
					} else {
						canSubmit = 'false';
					}
					if (canSubmit == 'true') {
								document.form.BUTTON_ID.value = 'delete'; 
							document.form.action = 'view.x2ps';
							document.form.submit();  
					}
		else{
						document.form.SUBMIT_AS_XML.value = 'false';
						}
					return;
		}
		function on_save(){
		var originalComments = document.getElementsByName('origComments');
		var isError = document.getElementsByName('isError');		
		var selectedIds = document.getElementsByName('SELECTED_TA_ID');
		var commentList = document.getElementsByName('TransportEquipmentItemCommentText');		
		var assetDesc =  document.getElementsByName('ItemDescription');
		var noOfPallets =  document.getElementsByName('DefaultPalletAmount');
		var cubeUOM =  document.getElementsByName('CubeVolumeUOMId');
		var wghtUOM =  document.getElementsByName('TareWeightUOMId');	
	
	
		var canSave = "false";
      for(i=0; i &lt; selectedIds.length; i++)
			{
        var t = selectedIds[ i ];
        var commentValue = commentList[ i ];		
	      noOfPallets[i].value = floor(noOfPallets[i].value);	
				assetDesc[i].value = trimString(assetDesc[i].value);
	
        if ( t.checked )
        {
         if(trimString(commentValue.value).length == 0){
		          core_alert("Please enter comments before saving!");
		          return;
		     }
         else{
		canSave = "true";
		}
         if(cubeUOM[i].value.length == 0){
		          core_alert("Please enter the value for Asset Cube UOM!");
		          return;
		     }
         else{
		canSave = "true";
		}
         if(wghtUOM[i].value.length == 0){
		          core_alert("Please enter the value for Asset Weight UOM!");
		          return;
		     }
		
		
         else{
		canSave = "true";
		}				
		
         if(trimString(commentValue.value).length &gt; 255){
		          core_alert("Comments should not be greater than 255 characters!");
		          return;
		     }
         else{
		canSave = "true";
		}
		if (trimString(commentValue.value) == originalComments[i].value &amp;&amp; isError[i].value == 0 ) {
		core_alert("Please enter new comments for update!")
		return;
	  }		
		else{
		canSave = "true";
		}
        }
      }		
	if(canSave){
								document.form.BUTTON_ID.value = 'save'; 
							document.form.action = 'view.x2ps';
							document.form.submit();  
		
				
        }
		else{
		
      }		
		}</ui:script>
</ui:page-group>

