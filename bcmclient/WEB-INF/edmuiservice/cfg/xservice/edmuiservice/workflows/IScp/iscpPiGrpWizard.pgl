    function cv_test(input)
{
	if(input==1)
	{
		if(document.form.CONV_RATIO.value&lt;0)
		{
			core_alert("Error with the Conversion Ratio : Either Null or Negative");
			return;
		}
		else if(document.form.PREDID.value == '')
		{
			core_alert("Predecessor Product is a required field. Please select or enter a valid value");
			document.form.PREDID.focus();
			return;
		}  
		else if(document.form.SUCCSSID.value == '')
		{
			core_alert("Successor Product is a required field. Please select or enter a valid value");
			document.form.SUCCSSID.focus();
			return;
		}  
		else
		{
			document.form.BUTTON_ID.value ='SAVE_SC2';
			document.form.submit(); 
		}    
	}
	if(input==2)
	{
		if(document.form.CONV_RATIO.value&lt;0)
		{
			core_alert("Error with the Conversion Ratio : Either Null or Negative");
			return;
		}
		else if(document.form.PREDID.value == '')
		{
			core_alert("Predecessor Product is a required field. Please select or enter a valid value");
			document.form.PREDID.focus();
			return;
		}  
		else if(document.form.SUCCSSID.value == '')
		{
			core_alert("Successor Product is a required field. Please select or enter a valid value");
			document.form.SUCCSSID.focus();
			return;
		}  
		else
		{
			document.form.BUTTON_ID.value ='FINISH_SC2';
			document.form.submit(); 
		}    
	}
}
    <!--QC:20768, Venkat, 06/24/2008, End-->
  </ui:script>
  <ui:script id="testontabe">
    	function	ontab1(buttonid)
	{
		document.form.BUTTON_ID.value = buttonid;
		form.submit();
    	}
		function checkonsave(buttonid)
		{
				var initialgroupstatus = document.form.GrpStatus_pi.value;
				var changedgroupstatus = document.form.GroupStatus.value;
				var existencecheck=document.form.linelocrec.value;
		 
				if(initialgroupstatus =='IN PROCESS' &amp;&amp; changedgroupstatus=='RELEASED' &amp;&amp; existencecheck==1)
				{
					var decision=core_confirm("At least one of the Line Location records in this Group has a deployment start date in the past. Do you want to RELEASE this group?");
					<!-- QC:20815, 08/15/2008,Venkat, Start -->
					if(decision=='yes')
					{
						document.form.BUTTON_ID.value = buttonid; 
						document.form.action = 'view.x2ps';
						document.form.submit();  
				    	}
					else
				        {
						document.form.SUBMIT_AS_XML.value = 'false';
						return;
					}
					<!-- QC:20815, 08/15/2008,Venkat, End -->
				}
				else
				{
					document.form.BUTTON_ID.value = buttonid; 
					document.form.action = 'view.x2ps';
					document.form.submit();  
				}
		}
		
		function onNext(input)
		{
    <!-- ########for the first next button######### -->
    if(input==0)
																			 {
																					if(document.form.GrpDesc_pi.value != document.form.PIGDESC.value) 
																				 {
																						var decision=core_confirm("Any unsaved changes will be lost. Do you still want to continue?");
																						if(decision=='yes')
																							onTab('SecondContainer','topContainer');
																						else
																							 return;
																					}
																					else
																					{
																						onTab('SecondContainer','topContainer');
																					}
																			  }
    <!-- #######for the Second next button######### -->
    if(input==1)
																			{																				
																				if((document.form.PREDID.value != '') || (document.form.SUCCSSID.value != ''))
		                                    {
																					 var decision=core_confirm("Any unsaved changes will be lost. Do you still want to continue?");
																						if(decision=='yes')
		                                         {
																							document.form.BUTTON_ID.value='NEXT_SC2';
																							onTab('Add_Locations','topContainer');
																						 }
																						else
																							 return;
																				}
																				else
																				{
																					document.form.BUTTON_ID.value='NEXT_SC2';
																					onTab('Add_Locations','topContainer')
																				}
																			 }
    <!--##########for the third next button########-->
    if(input==2)
																			{														
																				if((document.form.LineNumber.value != '') || (document.form.LocationIdentification.value != ''))
		                                    {
																					 var decision=core_confirm("Any unsaved changes will be lost. Do you still want to continue?");
																						if(decision=='yes')
																							onTab('Promote','topContainer');
																						else
																							 return;
																				}
																				else
																				{
																					document.form.BUTTON_ID.value='NEXT_SC3';
																					onTab('Promote','topContainer');
																				}
																			}
    <!--##########for the third Save button########-->
    if(input==33)
		
			 {
		
	
		if(document.form.LineNumber.value =='')
			{
					core_alert("Group Line ID is a required field. Please select or enter a valid value");
					document.form.LineNumber.focus();
						return;
			}
		else if(document.form.LocationIdentification.value =='')
			{
    <!--QC:20768, Venkat, 06/24/2008, Start-->
    <!--core_alert(&quot;Location is a required field. Please select or enter a valid value&quot;);-->
    core_alert("Location is a required field. Please select a valid value");
    <!--QC:20768, Venkat, 06/24/2008, End-->
    document.form.LocationIdentification.focus();
					return;
			}
		else if(document.form.Use_DT.value =='')
			{
					core_alert("Predecessor Product Use Up Date is a required field. Please select or enter a valid value");
					document.form.Use_DT.focus();
					return;
			}
					else if(document.form.Dep_Strt_Dt.value =='')
			{
				core_alert("Deployment Start Date is a required field. Please select or enter a valid value");
				document.form.Dep_Strt_Dt.focus();
				return;
			}												
		
		if(document.form.	Dep_End_Dt.value ==''||document.form.	Dep_End_Dt.value ==''||document.form.	Dep_End_Dt.value ==''||document.form.	Dep_End_Dt.value ==''||document.form.	Dep_End_Dt.value ==''||document.form.	Dep_End_Dt.value =='')
																			{
																				var response=core_confirm("Some of the Date Fields do not have values. Do you wish to use default dates for them?");
		                                        if(response=='yes')
																						{document.form.BUTTON_ID.value='SAVE_SC3';
																							document.form.submit();
																						}
																						else{return;}
																		   }
																			else
																			  {
																							document.form.BUTTON_ID.value='SAVE_SC3';
																							document.form.submit();
																				}
		                                 }
    <!-- ################################finish3 button################-->
    if(input==331)
		 {
		
		if(document.form.LineNumber.value =='')
			{
					core_alert("Group Line ID is a required field. Please select or enter a valid value");
					document.form.LineNumber.focus();
						return;
			}
		else if(document.form.LocationIdentification.value =='')
			{
    <!--QC:20768, Venkat, 06/24/2008, Start-->
    <!--core_alert(&quot;Location is a required field. Please select or enter a valid value&quot;);-->
    core_alert("Location is a required field. Please select a valid value");
    <!--QC:20768, Venkat, 06/24/2008, End-->
    document.form.LocationIdentification.focus();
					return;
			}
		else if(document.form.Use_DT.value =='')
			{
					core_alert("Predecessor Product Use Up Date is a required field. Please select or enter a valid value");
					document.form.Use_DT.focus();
					return;
			}
					else if(document.form.Dep_Strt_Dt.value =='')
			{
				core_alert("Deployment Start Date is a required field. Please select or enter a valid value");
				document.form.Dep_Strt_Dt.focus();
				return;
			}
	
		if(document.form.	Dep_End_Dt.value ==''||document.form.	Dep_End_Dt.value ==''||document.form.	Dep_End_Dt.value ==''||document.form.	Dep_End_Dt.value ==''||document.form.	Dep_End_Dt.value ==''||document.form.	Dep_End_Dt.value =='')
																			{
																				var response=core_confirm("Some of the Date Fields do not have values. Do you wish to use default dates for them?");
		                                        if(response=='yes')
																						{document.form.BUTTON_ID.value='FINISH_SC3';
																							document.form.submit();
																						}
																						else{return;}
																		   }
																			else
																			  {
																							document.form.BUTTON_ID.value='FINISH_SC3';
																							document.form.submit();
																				}
		                                 }
																		}
	function linelocselection()
																			{
																			  var groupidentifier=document.form.GrpId_pi.value;
																				var linenumbers=document.form.LineNumber.value;																			
																				if(linenumbers =='')
																				{ core_alert("Please select Group Line ID before proceeding ");  document.form.LineNumber.focus();   return;}
																				else{																				
