<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="TLSelectTLane.pgl" title="Select Lane">
  <ui:search displayText="Transportation Lane Search" exportSearch="false" saveSearch="false" collapsable="true">
    <ui:field-group columns="2" select="$root/SEARCH_FIELDS">
      <ui:entry-field name="SRCH_SRC_LOC" displayText="Source Location Number">
        <!--<ui:links>
          <ui:link displayText="Select Location" targetType="popup" targetName="catalogPopup">
            <ui:url page="view.x2ps">
              <SELECTABLE select="'All'"/>
              <BUTTON_ID select="'Select_Src_Loc_id'"/>
              <FIELD_NAME select="'SRCH_SRC_LOC'"/>
            </ui:url>
            <ui:image src="pop_up_window.gif"/>
          </ui:link>
        </ui:links>-->
      </ui:entry-field>
      <!--  <ui:entry-field name="SRCH_SRC_LOC_NAME" displayText="Source Location Name"/>-->
      <ui:entry-field name="SRCH_SRC_LOC_DESC" displayText="Source Location Description" />
      <ui:dropdown name="SRCH_SRC_LOC_TYPE" displayText="Source Location Type" optionSrc="$root/LOC_TYPES/*" selectAll="false" />
      <ui:entry-field name="SRCH_DESTN_LOC" displayText="Destination Location Number">
        <!--<ui:links>
          <ui:link displayText="Select Location" targetType="popup" targetName="catalogPopup">
            <ui:url page="view.x2ps">
              <SELECTABLE select="'All'"/>
              <BUTTON_ID select="'Select_Destn_Loc_id'"/>
              <FIELD_NAME select="'SRCH_DESTN_LOC'"/>
            </ui:url>
            <ui:image src="pop_up_window.gif"/>
          </ui:link>
        </ui:links>-->
      </ui:entry-field>
      <!--   <ui:entry-field name="SRCH_DESTN_LOC_NAME" displayText="Destination Location Name"/>-->
      <ui:entry-field name="SRCH_DESTN_LOC_DESC" displayText="Destination Location Description" />
      <ui:dropdown name="SRCH_DESTN_LOC_TYPE" displayText="Destination Location Type" optionSrc="$root/LOC_TYPES/*" selectAll="false" />
      <ui:dropdown displayText="Transport Mode" name="SRCH_TL_MODE" selectAll="false" optionSrc="$root/TL_MODES/*" defaultValue="Select All" />
      <ui:hidden-field name="FIELD_NAME" id="FIELD_NAME" />
      <ui:hidden-field name="POP_LANE_NAME" id="POP_LANE_NAME" />
      <ui:hidden-field name="SRC_LOC_IDN" id="SRC_LOC_IDN" />
      <ui:hidden-field name="PREV_SEL2" id="PREV_SEL2" />
    </ui:field-group>
  </ui:search>
  <ui:container id="srchResCont" name="srchResCont" scrollable="true">
    <ui:step id="srchResStep" name="srchResStep" displayText="Transportation Lane Search Results" scrollable="true">
      <ui:table id="TLaneTable" name="TLaneTable" displayText="Transportation Lane Search Results" displayTextNoRecords="No Records Found" rowSrc="P_TransportLane" select="$root/TL_DETAILS" rowId="TransportLaneName" postRowIdAs="SELECTED_TL_ID" selectable="{$root/SELECT/@Value}" totalRowCount="$root/TotalRowCount/@Value" startAtRow="$root/START_AT_ROW/@Value" rememberSelections="true" collapsable="false">
        <ui:field-group>
          <ui:entry-field displayText="Lane Name" name="TransportLaneName" editable="false" />
          <ui:entry-field displayText="Lane ID" name="TransportLaneIdentifier" dataType="Number" editable="false" decimals="0" unFormat="true" sortable="true" />
          <ui:entry-field displayText="Source Location Number" name="OriginLocationIdn" editable="false" sortable="true" />
          <!--  <ui:display-field displayText="Source Location Name" name="SrcLocationName"/>-->
          <ui:display-field displayText="Source Location Description" name="SrcLocationDesc" />
          <ui:display-field displayText="Source Location Type" name="SrcLocationType" />
          <ui:entry-field displayText="Destination Location Number" name="DestinationLocationIdn" editable="false" sortable="true" />
          <!-- <ui:display-field displayText="Destination Location Name" name="DestnLocationName"/>-->
          <ui:display-field displayText="Destination Location Description" name="DestnLocationDesc" />
          <ui:display-field displayText="Destination Location Type" name="DestnLocationType" />
          <ui:entry-field displayText="Transport Mode " name="TransMode" editable="false" />
        </ui:field-group>
        <ui:buttons id="buttons1" name="buttons1">
          <ui:button displayText="Cancel" id="cancel" name="cancel" onClick="javascript:window.close();" />
          <ui:button displayText="Select" id="select" enabledBySelections="true" onClick="javascript:selectTransLane();" />
        </ui:buttons>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:script>function selectTransLane()
    {
		  var selectedIds =document.getElementsByName( 'SELECTED_TL_ID' );
		 var prevSelections =document.form.PREV_SEL2.value;
		  var laneNames =document.getElementsByName( 'TransportLaneName' );		
		
		  var length = selectedIds.length;
      var tlanes = null;
  		var tlaneName = null;

      var categoryCodes = null;
      for(i=0; i &lt; length; i++)
			{
        var t = selectedIds[ i ];
		    var selLaneName = laneNames[ i ];
								
        if ( t.checked )
        {
          if( tlanes )
            tlanes += ',' +t.value.split('.')[0];

          else
             tlanes =t.value.split('.')[0];
		
          if( tlaneName )
            tlaneName += ',' + selLaneName.value;

          else
             tlaneName = selLaneName.value;		

        }
      }
         if(prevSelections.length &gt; 0)
	         {
	           	tlanes= prevSelections+','+tlanes;
	          }
		
      if ( document.form.FIELD_NAME.value.length &gt; 0)
        {

          var fieldName = document.form.FIELD_NAME.value;
          eval("parent.opener.form." + fieldName + ".value = tlanes;");
      }

		      if ( document.form.POP_LANE_NAME.value.length &gt; 0)
        {

          var fieldName = document.form.POP_LANE_NAME.value;
          eval("parent.opener.form." + fieldName + ".value = tlaneName;");
      }

      window.close();    
      }</ui:script>
</ui:page-group>

