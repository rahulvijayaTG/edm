<?xml version="1.0" encoding="UTF-8"?>
<workflow mgcCount="109" ShowInBreadCrumbs="true" Version="1.0" Name="wfTLSelectItem" Description="" Type="" PrimaryDocument="" IsStartAllowed="Yes">
  <variables>
    <variable Name="fieldName" Type="string" Comment=""/>
    <variable Name="itemType" Type="string" Comment=""/>
    <variable Name="popField" Type="string" Comment=""/>
    <variable Name="select" Type="string" Comment=""/>
    <variable Name="pageSource" Type="string" Comment=""/>
    <variable Name="itemTypeForRP" Type="string" Comment=""/>
    <variable Name="pageSourceForRPLUom" Type="string" Comment=""/>
  </variables>
  <nodes>
    <start Name="start2">
      <actions>
        <action>
          <SET DocVar="fieldName" FromValue="{$thisParam/FIELD_NAME/@Value}"/>
          <SET DocVar="popField" FromValue="{$thisParam/POP_ASST_DESC/@Value}"/>
          <SET DocVar="select" FromValue="{$thisParam/SELECTABLE/@Value}"/>
          <SET DocVar="itemType" FromValue="{$thisParam/ITEM_TYPE/@Value}"/>
          <SET DocVar="pageSource" FromValue="{$thisParam/SOURCE/@Value}"/>
          <SET DocVar="pageSourceForRPLUom" FromValue="{$thisParam/SOURCE1/@Value}"/>
          <SET DocVar="itemTypeForRP" FromValue="{$thisParam/POP_ITEM_TYPE/@Value}"/>
        </action>
      </actions>
      <next_nodes>
        <next_node Name="Select Item" Description=""/>
      </next_nodes>
    </start>
    <ui_form2 Name="Select Item" InputFormVar="pglFormInput" OutputFormVar="pglFormOutput" ShowInBreadCrumbs="HIDE" Template="iscpTLSelectItem.pgl">
      <pre_actions>
        <action>
          <SET Var="paginateStart" FromValue="{ifElse($thisParam/START_COUNT/@Value = null, '0', $thisParam/START_COUNT/@Value)}"/>
          <SET Var="pgMaxRows" FromValue="{ifElse($thisParam/MAX_ROWS/@Value = null, '10', $thisParam/MAX_ROWS/@Value)}"/>
          <SET DocVar="thisParam" Property="SRCH_STATE" FromValue="ACTIVE"/>
          <SET DocVar="thisParam" Property="SRCH_ITEM_TYPE" FromValue="{$itemType}"/>
          <SET Var="sortBy" FromValue="{ifElse((($thisParam/SORT_BY/@Value = null) or ($thisParam/SORT_BY/@Value = 'ID')), 'ItemId', $thisParam/SORT_BY/@Value)}"/>
          <SET Var="sortOrder" FromValue="{ifElse((($thisParam/SORT_ORDER/@Value = null) or ($thisParam/SORT_BY/@Value = 'ID')), 'Ascending', $thisParam/SORT_ORDER/@Value)}"/>
          <MAKE_INSTANCE_DOCUMENT Name="{$sortBy}" AssignToVar="sortByTag"/>
          <SET DocVar="sortByTag" Attribute="Sort" FromValue="{$sortOrder}"/>
          <FORM_SEARCH_FILTER Value="{$thisParam}" AssignToVar="itemFilters">
            <SRCH_ITEM_ID MultiValued="true"/>
            <SRCH_ITEM_DESC MultiValued="true"/>
            <SRCH_ITEM_NAME MultiValued="true"/>
            <SRCH_STATE/>
            <SRCH_ITEM_TYPE MultiValued="true"/>
            <SRCH_LOC_ID MultiValued="true"/>
            <SRCH_SGMNT_ID MultiValued="true"/>
            <SRCH_GTIN_ID MultiValued="true"/>
          </FORM_SEARCH_FILTER>
          <APPEND_TO_XML DocVar="itemFilters">
            <ORDER_BY>
              <TO_XML DocVar="sortByTag"/>
            </ORDER_BY>
          </APPEND_TO_XML>
          <IF_TEST Test="$pageSource != null and $pageSource != 'TransAsset' and $pageSource != 'IPItemLocation' and $pageSource != 'RP'">
            <THEN>
              <IF_TEST Test="count($itemFilters/FILTER[@Name = 'SRCH_ITEM_TYPE']) = 0">
                <THEN>
                  <APPEND_TO_XML DocVar="itemFilters">
                    <FILTER Name="SRCH_ITEM_TYPE">
                      <SRCH_ITEM_TYPE Value="{$itemTyp}" MatchBy="NOT_EQUAL"/>
                    </FILTER>
                  </APPEND_TO_XML>
                </THEN>
                <ELSE>
                  <APPEND_TO_XML Select="$itemFilters/FILTER[@Name = 'SRCH_ITEM_TYPE']">
                    <AND>
                      <SRCH_ITEM_TYPE Value="{$itemTyp}" MatchBy="NOT_EQUAL"/>
                    </AND>
                  </APPEND_TO_XML>
                </ELSE>
              </IF_TEST>
            </THEN>
            <ELSE/>
          </IF_TEST>
          <TO_DOCVAR AssignToVar="itemids">
            <ROOT/>
          </TO_DOCVAR>
          <IF_TEST Test="$thisParam/pageSource='TransAsset'">
            <THEN>
              <EXECUTE_SQL_QUERY AssignToVar="transassetlist" Value="select item_id from p_m_item where item_id like 'TA_%'"/>
              <FOR_EACH SelectList="$transassetlist/SQL_RESULT" CurrentElement="id">
                <APPEND_TO_XML DocVar="itemids">
                  <ItemId Value="{$id/ITEM_ID/@Value}"/>
                </APPEND_TO_XML>
              </FOR_EACH>
              <FORM_SEARCH_FILTER Value="{$itemids}" AssignToVar="itemidlist">
                <ItemId MultiValued="true"/>
              </FORM_SEARCH_FILTER>
            </THEN>
          </IF_TEST>
          <!--EXECUTE_SQL_QUERY AssignToVar="resitemidlist" Value="select a.item_id from p_m_item a where a.AMT_UOM_ID = a.BS_UOM_ID"/>
					 <EXECUTE_SQL_QUERY AssignToVar="transassetlist" Value="select a.item_id from p_m_item a where a.AMT_UOM_ID = a.BS_UOM_ID and a.item_id like 'TA_%'"/-->
          <!--   <FOR_EACH SelectList="$resitemidlist/SQL_RESULT" CurrentElement="id">
            <APPEND_TO_XML DocVar="itemids">
              <ItemId Value="{$id/ITEM_ID/@Value}"/>
            </APPEND_TO_XML>
          </FOR_EACH>-->
          <REQUEST Name="searchItems" ServiceName="PEDM_MASTER" AssignToVar="itemSrchResult" ReturnRowCount="yes" MaxRows="{$pgMaxRows}" StartAtRow="{$paginateStart}">
            <PAGE_SOURCE Value="{$pageSource}"/>
            <PAGE_SOURCE_RPL Value="{$pageSourceForRPLUom}"/>
            <TO_XML SelectList="$itemidlist/*"/>
            <MaxRows Value="{$pgMaxRows}"/>
            <StartAtRow Value="{$paginateStart}"/>
            <TO_XML SelectList="$itemFilters/*"/>
            <FILTER Name="SRCH_ITEM_IDN_CLAS">
              <SRCH_ITEM_IDN_CLAS Value="SAP_MAT_NUM" MatchBy="EQUAL"/>
            </FILTER>
          </REQUEST>
          <TO_DOCVAR AssignToVar="formattedItemTypes">
            <ITEM_TYPES/>
          </TO_DOCVAR>
          <FOR_EACH CurrentElement="curItemType" SelectList="$itemSrchResult/ITEM_TYPES/*">
            <APPEND_TO_XML DocVar="formattedItemTypes">
              <!-- CR:107148 & CR:114447 12/08/2007 Venkat Mekala Code Starts-->
              <!--<OPTION Value="{concat($curItemType/ItemType/@Value,' - ',$curItemType/ItemTypeName/@Value)}" Id="{$curItemType/ItemType/@Value}"/>-->
              <OPTION Value="{$curItemType/ItemTypeName/@Value}" Id="{$curItemType/ItemType/@Value}"/>
              <!-- CR::107148 & CR:114447 Code Ends -->
            </APPEND_TO_XML>
          </FOR_EACH>
          <SET DocVar="prevSel" FromValue=""/>
          <FOR_EACH SelectList="$thisParam/*" CurrentElement="curElem">
            <IF_TEST Test="name($curElem) = 'SELECTED_ITEM_IDS'">
              <THEN>
                <SET DocVar="prevSel" FromValue="{ifElse(contains(prevSel,$curElem/@Value),'',concat($prevSel,',',$curElem/@Value))}"/>
              </THEN>
            </IF_TEST>
          </FOR_EACH>
          <TO_DOCVAR AssignToVar="pglFormInput">
            <ROOT>
              <SEARCH_FIELDS>
                <TO_XML SelectList="$thisParam/SRCH_ITEM_ID"/>
                <!--      <TO_XML SelectList="$thisParam/SRCH_ITEM_DESC"/>-->
                <TO_XML SelectList="$thisParam/SRCH_LOC_ID"/>
                <TO_XML SelectList="$thisParam/SRCH_SGMNT_ID"/>
                <TO_XML SelectList="$thisParam/SRCH_GTIN_ID"/>
                <TO_XML SelectList="$thisParam/SRCH_ITEM_NAME"/>
                <TO_XML SelectList="$thisParam/SRCH_ITEM_TYPE"/>
                <SOURCE Value="{ifElse($pageSource != null,$pageSource,0)}"/>
                <STP_DISPLAY_TEXT Value="{ifElse($pageSource != null and $pageSource ='TransAsset','Search Assets','Search Items')}"/>
                <CONT_DISPLAY_TEXT Value="{ifElse($pageSource != null and $pageSource ='TransAsset','Select Assets','Select Items')}"/>
                <SRCH_RES_DISPLAY_TEXT Value="{ifElse($pageSource != null and $pageSource ='TransAsset','Asset Search Results','Item Search Results')}"/>
                <NUMBER_DISPLAY_TEXT Value="{ifElse($pageSource != null and $pageSource ='TransAsset','Asset Number','Item Number')}"/>
                <NAME_DISPLAY_TEXT Value="{ifElse($pageSource != null and $pageSource ='TransAsset','Asset Name','Item Name')}"/>
                <DESC_DISPLAY_TEXT Value="{ifElse($pageSource != null and $pageSource ='TransAsset','Asset Description','Item Description')}"/>
                <TYPE_DISPLAY_TEXT Value="{ifElse($pageSource != null and $pageSource ='TransAsset','Asset Type','Material Type')}"/>
                <FIELD_NAME Value="{$fieldName}"/>
                <POP_ASST_DESC Value="{$popField}"/>
                <PREV_SEL Value="{substringAfter($prevSel,',')}"/>
                <POP_ITEMM_TYPE Value="{$itemTypeForRP}"/>
                <SRCH_RPL_UOM Value="{$pageSourceForRPLUom}"/>
              </SEARCH_FIELDS>
              <START_AT_ROW Value="{$paginateStart}"/>
              <TotalRowCount Value="{$itemSrchResult/ITEM_DETAILS/@TotalRowCount}"/>
              <SORT_BY Value="{$sortBy}"/>
              <SORT_ORDER Value="{$sortOrder}"/>
              <TO_XML SelectList="$itemSrchResult/*"/>
              <ITEM_TYPES>
                <OPTION Value="Select All" Id="*"/>
                <TO_XML SelectList="$formattedItemTypes/*"/>
                <!--        <DROP_DOWN_OPTIONS SelectList="$itemSrchResult/ITEM_TYPES/P_ItemType" Id="ItemType" Value="ItemTypeName"/>-->
              </ITEM_TYPES>
              <SELECT Value="{$select}"/>
            </ROOT>
          </TO_DOCVAR>
        </action>
      </pre_actions>
      <if_cond Value="$userAction ='search_button'">
        <next_nodes OutputVar="{outputXml,xml}">
          <next_node Name="Select Item" Description=""/>
        </next_nodes>
      </if_cond>
      <else_if_cond Value="$userAction ='select'">
        <next_nodes OutputVar="{outputXml,xml}"/>
      </else_if_cond>
      <else_if_cond Value="$userAction ='cancel'">
        <next_nodes OutputVar="{outputXml,xml}"/>
      </else_if_cond>
      <else_if_cond Value="true()">
        <next_nodes OutputVar="{outputXml,xml}">
          <next_node Name="done4" Description=""/>
        </next_nodes>
      </else_if_cond>
    </ui_form2>
    <done Name="done4">
      <actions>
      </actions>
      <next_nodes/>
    </done>
  </nodes>
  <mgcview>
