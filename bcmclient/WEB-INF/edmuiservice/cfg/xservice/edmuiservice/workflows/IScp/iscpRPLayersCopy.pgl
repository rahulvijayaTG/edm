<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="iscpRPLayersCopy.pgl">
  <ui:table displayText="" rowSrc="$root/LAYER_DETAILS_LIST/LAYER_DETAILS" collapsable="false" totalRowCount="$root/ROWCOUNT/@Value" maxRows="10" exportable="true" configurable="false" postRowIdAs="SelectedLayer">
    <ui:validation successMessage="{$root/SUCCESSMSG/MSG/@Value}" />
    <ui:field-group>
      <ui:dropdown displayText="Engine ID" name="EngineId" id="EngineId" optionSrc="$root/Engine/ID" onChange="javaScript:fetchLayerName()" required="true" />
      <ui:hidden-field name="AnalyticalModelIdentifier" />
      <ui:hidden-field name="DemandCategoryIdentifier" />
      <ui:hidden-field name="SourceSystemMnemonicValue" />
      <ui:entry-field displayText="Layer Name" name="DemandCategoryName" editable="false" required="true" />
      <ui:hidden-field displayText="Analytical Model Name" name="AnalyticalModelName" />
      <ui:entry-field displayText="Allocation Band" name="AllocationBandText" />
      <ui:entry-field displayText="Effective Start Day" name="LayerEffectiveStartDayNumber" dataType="Number" required="true" />
      <ui:entry-field displayText="Effective End Day" name="LayerEffectiveEndDayNumber" dataType="Number" required="true" />
      <!--<ui:entry-field displayText="DemandType" name="DemandType"/>-->
      <ui:dropdown displayText="Demand Type" name="DemandType" optionSrc="$root/DemandType/ID" required="true" />
      <ui:entry-field id="DemandCategoryPriorityNumber" name="DemandCategoryPriorityNumber" displayText="Priority" dataType="Number" required="true" minValue="1" />
    </ui:field-group>
    <ui:buttons id="btnGrp">
      <!-- RIC: 240988 Praneeth - Cancel button wording changes request - Start -->
      <ui:button id="Cancel" displayText="Back to Search" emphasized="true" validate="false" />
      <!-- RIC: 240988 Praneeth - Cancel button wording changes request - End -->
      <ui:button id="Save" displayText="Save" emphasized="true" validate="true" />
    </ui:buttons>
  </ui:table>
  <ui:script>function fetchLayerName()
		{



				 document.form.BUTTON_ID.value="fetchLayer";

                document.form.submit();
		
		}
			function validateEmptySave()
		{

	
if(document.form.EngineId.value==''){
		core_alert('Please enter values for required fields to create a record');
		return; 
		
		}else{
			 document.form.BUTTON_ID.value="Save";

                document.form.submit();
		}

			
		
		}</ui:script>
</ui:page-group>

