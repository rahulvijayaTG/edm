<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="pglAddFSC.pgl">
  <ui:container id="TopContainer" name="TopContainer" scrollable="true">
    <ui:step id="Main" name="Main" displayText="ISCP Facility Storage Capacity Search and Edit">
      <ui:grid>
        <ui:row>
          <ui:cell>
            <ui:container editable="false" height="160">
              <ui:step displayText="Planning Horizon" id="top_container" editable="true">
                <ui:grid>
                  <ui:row>
                    <ui:cell>
                      <ui:field-group id="leftFields">
                        <ui:display-field displayText="Starting Week" id="SWTXT" />
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields">
                        <ui:dropdown id="SWYEAR" name="SWYEAR">
                          <ui:option id="2006" value="2006" />
                          <ui:option id="2006" value="2007" />
                          <ui:option id="2006" value="2007" />
                        </ui:dropdown>
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields">
                        <ui:dropdown id="SWPERIOD" name="SWPERIOD">
                          <ui:option id="P1" value="P1" />
                          <ui:option id="P2" value="P2" />
                          <ui:option id="P3" value="P3" />
                        </ui:dropdown>
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields">
                        <ui:dropdown id="SWWEEK" required="true" name="SWWEEK">
                          <ui:option id="W1" value="W1" />
                          <ui:option id="W2" value="W2" />
                          <ui:option id="W3" value="W3" />
                        </ui:dropdown>
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields">
                        <ui:entry-field editable="fasle" id="SWDATE" defaultValue="01-Jan-06" style="font-weight:Bold" />
                      </ui:field-group>
                    </ui:cell>
                  </ui:row>
                  <ui:row>
                    <ui:cell>
                      <ui:field-group id="leftFields">
                        <ui:display-field displayText="Ending Week" id="EWTXT" />
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields">
                        <ui:dropdown id="EWYEAR" name="EWYEAR">
                          <ui:option id="2006" value="2006" />
                          <ui:option id="2006" value="2007" />
                          <ui:option id="2006" value="2007" />
                        </ui:dropdown>
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields">
                        <ui:dropdown id="EWPERIOD" name="EWPERIOD">
                          <ui:option id="P1" value="P1" />
                          <ui:option id="P2" value="P2" />
                          <ui:option id="P3" value="P3" />
                        </ui:dropdown>
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields">
                        <ui:dropdown id="EWWEEK" required="true" name="EWWEEK">
                          <ui:option id="W1" value="W1" />
                          <ui:option id="W2" value="W2" />
                          <ui:option id="W3" value="W3" />
                        </ui:dropdown>
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields">
                        <ui:entry-field editable="fasle" id="EWDATE" defaultValue="22-Jan-06" style="font-weight:Bold;" />
                      </ui:field-group>
                    </ui:cell>
                  </ui:row>
                  <ui:row>
                    <ui:cell>
                      <ui:field-group id="leftFields">
                        <ui:display-field id="LOCID" name="LOCID" displayText="Location(s)" />
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell colSpan="4">
                      <ui:field-group id="leftFields">
                        <ui:entry-field id="LOCID" name="LOCID">
                          <ui:links>
                            <ui:link displayText="Select Customers" targetType="popup" targetName="planPopUp">
                              <ui:image src="pop_up_window.gif" />
                              <ui:url page="start.x2ps">
                                <FIELD_NAME select="'LOCID'" />
                                <ENTITY_NAME select="'LOCID'" />
                                <SELECTABLE select="'All'" />
                                <BUTTON_ID select="'selectLocation'" />
                              </ui:url>
                            </ui:link>
                          </ui:links>
                        </ui:entry-field>
                      </ui:field-group>
                    </ui:cell>
                  </ui:row>
                  <ui:row>
                    <ui:cell>
                      <ui:field-group id="leftFields">
                        <ui:display-field id="SEGID" name="SEGID" displayText="Segment(s)" />
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell colSpan="4">
                      <ui:field-group id="leftFields">
                        <ui:entry-field id="SEGID" name="SEGID">
                          <ui:links>
                            <ui:link displayText="Select Customers" targetType="popup" targetName="planPopUp">
                              <ui:image src="pop_up_window.gif" />
                              <ui:url page="start.x2ps">
                                <FIELD_NAME select="'SEGID'" />
                                <ENTITY_NAME select="'SEGID'" />
                                <SELECTABLE select="'All'" />
                                <BUTTON_ID select="'selectSegment'" />
                              </ui:url>
                            </ui:link>
                          </ui:links>
                        </ui:entry-field>
                      </ui:field-group>
                    </ui:cell>
                  </ui:row>
                </ui:grid>
                <ui:buttons id="buttons">
                  <ui:button id="SEARCH" name="SEARCH" displayText="Search" emphasized="true" />
                </ui:buttons>
              </ui:step>
            </ui:container>
          </ui:cell>
          <ui:cell>
            <ui:container editable="false" height="160">
              <ui:step displayText="Legends - for individual time buckets (Not across time buckets)" id="top_container" editable="true">
                <ui:field-group showDivider="true">
                  <ui:entry-field editable="false" displayText="XX, XXX" displayNoWrap="true" defaultValue="(Location cell) Sum of hard constraint effective units &gt; location's effective units" style="font-weight:Bold;background:#BEC5E7" />
                  <ui:entry-field editable="fasle" displayText="XX, XXX" displayNoWrap="true" defaultValue="(Segment cell) Sum of hard constraint effective units &gt; location's effective units" style="font-weight:Bold;color:red;background:yellow" />
                  <ui:entry-field editable="fasle" displayText="XX, XXX" displayNoWrap="true" defaultValue="Segment's soft constraint effective units &gt; segment's hard constraint effective units" style="font-weight:Bold;color:red;background:#BEC5E7" />
                </ui:field-group>
              </ui:step>
            </ui:container>
          </ui:cell>
        </ui:row>
      </ui:grid>
      <ui:container id="container2" name="container2">
        <ui:step id="Inner" name="Inner" displayText="ISCP Facility Storage Capacity Search Results">
          <ui:pivot id="pivot" displayText="" select="$root/REAL_DATA/MULTI_COLLAB_DATA/BUFFER_SLAS" subRowSrc="BUCKETS/ROWDATA" selectable="All" rowId="LOCIDN" scrollable="true" maxRows="10">
            <ui:table-row select="LOCLVLRCRD">
              <ui:table-row select="SEGMENTS/SGMTVLRCRD" />
            </ui:table-row>
            <ui:pivot-field axis="row" id="LOCIDN" name="LOCIDN" displayText="Location" treeCell="true" collapsed="true" />
            <!--<ui:entry-field id="locidn" name="locidn" displayText="Location"/>-->
            <ui:pivot-field axis="row" id="LOCNAME" name="LOCNAME" displayText="Location Name" />
            <ui:pivot-field axis="row" id="LOCTYPE" name="LOCTYPE" displayText="Location Type" />
            <ui:pivot-field axis="row" id="SGNIDN" name="SGNIDN" displayText="Segment" />
            <ui:pivot-field axis="row" id="SGMNAME" name="SGMNAME" displayText="Segment Name" />
            <ui:pivot-field axis="row" id="CNSRNT" name="CNSRNT" displayText="Constraint" treeCell="true" collapsed="true" />
            <ui:pivot-field axis="row" id="UOM" name="UOM" displayText="Unit of Measure" treeCell="true" collapsed="true" />
            <ui:pivot-field axis="column" name="FROM_DATE" displayText="" />
            <ui:entry-field name="STRGCPCTY" displayText="Units (Rated Capacity)" size="6" dataType="Number" align="left" />
            <ui:entry-field name="UTLPRCTG" displayText="Utilization %" dataType="Number" size="6" align="left" />
            <ui:display-field name="EFFSTRGUNIT" displayText="Effective Units" size="6" dataType="Number" align="left" />
            <ui:entry-field name="CMMNT" displayText="Comments" size="6" align="left" />
          </ui:pivot>
          <ui:buttons>
            <ui:button id="SH" displayText="Show History" />
            <ui:divider />
            <ui:button id="DEL" displayText="Delete" name="DEL" enabledBySelections="true" />
            <ui:divider />
            <ui:button displayText="Copy" id="CPY" name="CPY" enabledBySelections="true" />
            <ui:divider />
            <ui:button displayText="Mass Update" id="MUPD" name="MUPD" enabledBySelections="true" />
            <ui:divider />
            <ui:button displayText="Validate" id="VAL" name="VAL" />
            <ui:divider />
            <ui:button displayText="Save " id="SAVE" name="SAVE" emphasized="true" enabledBySelections="true" />
          </ui:buttons>
        </ui:step>
      </ui:container>
    </ui:step>
  </ui:container>
</ui:page-group>

