<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="iscpFSCSelectSegment.pgl" title="Select Segment">
  <ui:container id="srchCont" name="srchCont" scrollable="true">
    <ui:step id="srchStp" name="srchStp" displayText="Select Segment" scrollable="true">
      <ui:search displayText="Search Segment" exportSearch="false" saveSearch="false" collapsable="false">
        <ui:field-group columns="2" select="$root/SEARCH_FIELDS">
          <ui:entry-field name="SRCH_SEG_ID" displayText="Segment" />
          <ui:entry-field name="SRCH_SEG_NAME" displayText="Segment Name" />
          <ui:entry-field name="SRCH_SEG_DESC" displayText="Segment Description" />
          <ui:dropdown displayText="Segment Type" name="SRCH_SEG_TYPE" optionSrc="$root/SEG_TYPES/*" selectAll="false" required="true" />
          <ui:hidden-field name="FIELD_NAME" id="FIELD_NAME" />
        </ui:field-group>
      </ui:search>
    </ui:step>
  </ui:container>
  <ui:container id="srchResCont" name="srchResCont" scrollable="true">
    <ui:step id="srchResStep" name="srchResStep" displayText="Segments Search Results" scrollable="true">
      <ui:table id="segTable" name="segTable" displayText="Segments Search Results" displayTextNoRecords="No Records Found" rowSrc="P_Party" select="$root/SEG_DETAILS" rowId="PartyIdnValue" postRowIdAs="SELECTED_SEG_IDS" selectable="{$root/SELECT/@Value}" startAtRow="$root/START_AT_ROW/@Value" rememberSelections="true">
        <ui:field-group>
          <ui:entry-field displayText="Segment" name="PartyIdnValue" id="PartyIdnValue" editable="false" dataType="String" sortable="true" />
          <ui:entry-field displayText="Segment Name" name="PartyDescription" editable="false" />
          <ui:display-field displayText="Segment Description" name="PartyDescription" />
          <ui:display-field displayText="Segment Type" name="PartyType" />
        </ui:field-group>
        <ui:buttons id="buttons1" name="buttons1">
          <ui:button displayText="Cancel" onClick="javascript:self.close ();" />
          <ui:divider />
          <ui:button displayText="Select" id="select" name="select" enabledBySelections="true" onClick="javascript:selectSegation();" />
        </ui:buttons>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:script>function selectSegation()
    {
		  var selectedIds =document.getElementsByName( 'SELECTED_SEG_IDS' );
		  var selectedSegName =document.getElementsByName( 'PartyDescription' );		
		  var length = selectedIds.length;
      var segs = null;
		  var segName = null;
      var categoryCodes = null;
      for(i=0; i &lt; length; i++)
			{
        var t = selectedIds[ i ];
		   var selSegName = selectedSegName[i]; 
        if ( t.checked )
        {
          if( segs )
            segs += ',' + t.value;
          else
             segs = t.value;
          if( selSegName )
            segName =  selSegName.value;

          else
            segName =  selSegName.value;

        }
      }
 
      if ( document.form.FIELD_NAME.value.length &gt; 0)
        {

          var fieldName = document.form.FIELD_NAME.value;
          eval("parent.opener.form." + fieldName + ".value = segs;");
      }
      window.close();    
      }</ui:script>
</ui:page-group>

