<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="uiWfIPSegParamMassUpdate.pgl">
  <ui:container id="topContainer">
    <ui:step id="c1" displayText="RP Top Level Parameters" editable="true">
      <ui:validation successMessage="{$root/SUCCESSMSG/MSG/@Value}" anyFieldIsRequired="false" />
      <ui:table id="bottomTable" displayText="Engines" rowSrc="$root/ENGINE_LIST/ENGINE" postRowIdAs="segNO" collapsable="false" scrollable="true" rowId="segNO" displayTextNoRecords="No Record Found">
        <ui:field-group>
          <ui:display-field id="EngineId" name="EngineId" displayText="Engine ID" />
          <ui:display-field id="SegmentIdentification" displayText="Segment Name" name="SegmentIdentification" />
          <ui:display-field id="SegmentDescription" displayText="Segment Description" name="SegmentDescription" />
          <ui:display-field id="Enterprise" name="Enterprise" displayText="Enterprise" />
          <ui:display-field id="InstanceId" name="InstanceId" displayText="Instance ID" />
          <ui:display-field id="comment" name="comment" displayText="Comment" />
          <!-- <ui:display-field id="LAST_MODIFIED_DATE" name="LAST_MODIFIED_DATE" displayText="Date Modified"/>
          <ui:display-field id="ModifiedBy" name="ModifiedBy" displayText="Modified By"/>-->
        </ui:field-group>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:container id="bottomContainer" displayText="Mass Update">
    <ui:step id="c1" displayText="" editable="true">
      <ui:validation />
      <ui:field-group columns="4" id="fieldGroups2">
        <ui:field-group id="leftFields">
          <ui:checkbox name="EnterpriseCheckBox" />
        </ui:field-group>
        <ui:field-group id="middleFields" columns="6">
          <ui:entry-field displayText="Enterprise" id="Enterprise" name="Enterprise" required="false" />
        </ui:field-group>
      </ui:field-group>
      <ui:field-group columns="4" id="fieldGroups2">
        <ui:field-group id="leftFields">
          <ui:checkbox name="InstanceIdCheckBox" />
        </ui:field-group>
        <ui:field-group id="middleFields" columns="6">
          <ui:entry-field displayText="Instance ID" id="InstanceId" name="InstanceId" required="false" />
        </ui:field-group>
      </ui:field-group>
      <ui:field-group columns="8" id="fieldGroups2">
        <ui:field-group id="leftFields">
          <ui:textarea name="Comments" id="Comments" displayText="Comments" required="true" />
        </ui:field-group>
      </ui:field-group>
      <ui:buttons>
        <ui:button name="Save" id="Save" displayText="Save" enabledBySelections="true" />
        <ui:button name="Cancel" id="Cancel" displayText="Cancel" enabledBySelections="false" />
      </ui:buttons>
    </ui:step>
  </ui:container>
</ui:page-group>

