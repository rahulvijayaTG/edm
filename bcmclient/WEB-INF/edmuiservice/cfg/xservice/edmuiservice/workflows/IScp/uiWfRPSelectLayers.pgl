<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="uiWfRPSelectLayers.pgl">
  <ui:container id="top" displayText="Select Layers">
    <ui:step id="topStep">
      <ui:search id="srchContainer" displayText="Search" exportSearch="false" saveSearch="false">
        <ui:field-group id="srch" columns="2">
          <ui:dropdown id="SRCH_ENGINE" name="SRCH_ENGINE" displayText="Engine Id" selectAll="true" optionSrc="$root/Engine/ID" selectOne="true" />
          <ui:entry-field id="SRCH_LAYER" name="SRCH_LAYER" displayText="Layer Name" />
          <ui:hidden-field name="FIELD_NAME" value="{$root/FIELD_NAME/@Value}" />
        </ui:field-group>
      </ui:search>
      <ui:table id="bottomTable" displayText="RP Layers" rowSrc="$root/LAYERLIST" rowId="LayerName" selectable="All" postRowIdAs="SELECTED_ITEM" doPaging="true" totalRowCount="$root/ROWCOUNT/@Value" maxRows="10">
        <ui:field-group id="tableColumns">
          <ui:display-field name="LayerName" id="LayerName" displayText="Layer Name" />
        </ui:field-group>
        <ui:buttons>
          <ui:button id="select" name="select" displayText="Select" emphasized="true" enabledBySelections="true" onClick="javascript:selectItem();" />
        </ui:buttons>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:script>function selectItem()
    {
		  var selectedIds =document.getElementsByName( 'SELECTED_ITEM' );
		  var length = selectedIds.length;
      var items = null;
      var categoryCodes = null;
      for(i=0; i &lt; length; i++)
			{
        var t = selectedIds[ i ];
        if ( t.checked )
        {
          if( items )
            items += ',' + t.value;
          else
            items = t.value;
        }
      }
      if ( document.form.FIELD_NAME.value.length &gt; 0)
        {
          var fieldName = document.form.FIELD_NAME.value;
          eval("parent.opener.form." + fieldName + ".value = items;");
      }
      window.close();    
      }
		
		
		
function onSearch()
      {

		 document.form.BUTTON_ID.value="search_button";
                document.form.submit();
		}</ui:script>
</ui:page-group>

