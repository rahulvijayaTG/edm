<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="wfSerachGTIN.pgl" title="Search GTIN">
  <ui:container id="top" displayText="Select GTIN#" collapsable="true">
    <ui:step id="topStep">
      <ui:search id="srchContainer" displayText="Search GTIN#" collapsable="false" exportSearch="false" saveSearch="false">
        <ui:field-group id="srch" columns="2">
          <ui:entry-field id="UniformCodeCouncilNumberValue" name="UniformCodeCouncilNumberValue" displayText="GTIN" dataType="String" />
          <ui:hidden-field name="FIELD_NAME" value="{$root/FIELD_NAME/@Value}" />
          <ui:hidden-field name="GTIN_WILDCARD_SRCH" id="GTIN_WILDCARD_SRCH" />
          <ui:hidden-field name="PREV_SEL" id="PREV_SEL" />
          <ui:hidden-field name="SRCH_SGMNT_ID" id="SRCH_SGMNT_ID" />
          <ui:hidden-field name="SRCH_ITEM_ID" id="SRCH_ITEM_ID" />
          <ui:hidden-field name="SRCH_LOC_ID" id="SRCH_LOC_ID" />
        </ui:field-group>
      </ui:search>
      <ui:table rememberSelections="true" id="bottomTable" displayText="GTIN# Search Results" rowSrc="$root/ROW_DATA" totalRowCount="$root/TotalRowCount/@Value" maxRows="10" postRowIdAs="SELECTED_ITEM" collapsable="false" scrollable="true" rowId="SRCH_GTIN" displayTextNoRecords="No Record Found" selectable="All">
        <ui:field-group id="tableColumns" width="100%">
          <ui:entry-field id="SRCH_GTIN" name="SRCH_GTIN" displayText="GTIN" editable="false" dataType="String" unFormat="true" align="Left" />
        </ui:field-group>
        <ui:buttons>
          <ui:button displayText="Cancel" id="cancel" name="cancel" onClick="javascript:window.close();" />
          <ui:button id="select" name="select" displayText="Select" emphasized="true" enabledBySelections="true" onClick="javascript:selectItem();" />
        </ui:buttons>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:script>function selectItem()
    {
		  var selectedIds =document.getElementsByName( 'SELECTED_ITEM' );
		  var length = selectedIds.length;
		var prevSelections =document.form.PREV_SEL.value;
      var items = null;
      var categoryCodes = null;
      for(i=0; i &lt; length; i++)
			{
        var t = selectedIds[ i ];
        if ( t.checked )
        {
          if( items )
            items += ',' + t.value;
          else
		          items = t.value;
        }
      }
		if(prevSelections.length &gt; 0)
	{
	        	items= prevSelections+','+items;
	}
      if ( document.form.FIELD_NAME.value.length &gt; 0)
        {
          var fieldName = document.form.FIELD_NAME.value;
          eval("parent.opener.form." + fieldName + ".value = items;");
      }
      window.close();    
      }
function onSearch()
      {
		var gtin = document.form.UniformCodeCouncilNumberValue.value;
		// here /g represents global search
		
    var repStr = new RegExp(/[\*]/g);
  	document.form.GTIN_WILDCARD_SRCH.value = gtin.replace(repStr,'%');		
		

		 document.form.BUTTON_ID.value="search_button";
                document.form.submit();
		}</ui:script>
</ui:page-group>

