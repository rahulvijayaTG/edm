<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="wfIPLocParamSearch.pgl">
  <!-- <ui:container id="container">
    <ui:step id="step">
      <ui:validation successMessage="{$root/SUCCESSMSG/MSG/@Value}"/>-->
  <ui:search displayText="IP Location Parameter Search" exportSearch="false" saveSearch="False" collapsable="true" displayCondition="true">
    <ui:validation successMessage="{$root/SUCCESSMSG/MSG/@Value}" anyFieldIsRequired="false" />
    <ui:field-group id="fg">
      <ui:field-group id="field group1" rows="-1">
        <ui:dropdown id="PartyIdentificationValue" selectAll="true" size="2" name="PartyIdentificationValue" displayText="Segment" preferredWidth="3" rowSpan="5" colSpan="3" optionSrc="$root/Segments/*" />
      </ui:field-group>
      <ui:field-group id="fieldgroup2">
        <ui:dropdown id="LocationClassMnemonicValue" name="LocationClassMnemonicValue" selectAll="true" displayText="Location Type" preferredWidth="5" optionSrc="$root/LocTypes/*" />
        <!--<ui:entry-field id="Location_Number" name="Location_Number" displayText="Location Number" defaultValue="1000"/>-->
        <ui:entry-field displayText="Location Number" id="LocationIdentificationValue" name="LocationIdentificationValue">
          <ui:links>
            <ui:link displayText="Select Locations" onClick="javascript:selectlocation()">
              <!--<ui:link displayText="Select Locations" targetType="popup" targetName="orderPopup" onClick="javascript:linelocselection()">-->
              <ui:image src="pop_up_window.gif" />
              <!-- <ui:url page="view.x2ps">
                <FIELD_NAME select="'LocationIdentificationValue'"/>
                <SELECTABLE select="'All'"/>
                <BUTTON_ID select="'searchLocation'"/>
              </ui:url>-->
            </ui:link>
          </ui:links>
        </ui:entry-field>
        <ui:entry-field id="LocationIdentificationValueDescription" name="LocationIdentificationValueDescription" displayText="Location Description" />
        <ui:hidden-field name="pgRowCount" id="pgRowCount" value="{$root/pgRowCount/@Value}" />
      </ui:field-group>
    </ui:field-group>
  </ui:search>
  <ui:table rememberSelections="true" displayText="IP Location Parameter Search Results" id="IP_LOC_PARAM" rowId="SegLocComb" selectable="All" rowSrc="$root/RESULTS/ROOOT/Table" maxRows="10" exportable="true" postRowIdAs="selectedSegLocComb" startAtRow="$root/startatRow/@Value" totalRowCount="$root/totalRowCount/@Value">
    <ui:field-group id="columns">
      <ui:entry-field id="SegmentNumber" name="SegmentNumber" displayText="Segment Number" sortable="true" editable="false" />
      <ui:entry-field id="SegmentDescription" name="SegmentDescription" displayText="Segment Description" sortable="false" editable="false" />
      <ui:entry-field id="LocationNumber" name="LocationNumber" displayText="Location Number" sortable="true" editable="false" />
      <ui:entry-field id="LocationDescription" name="LocationDescription" displayText="Location Description" sortable="false" editable="false" />
      <ui:entry-field id="LocationType" name="LocationType" displayText="Location Type" sortable="false" editable="false" />
      <ui:choose-field id="KeepInventoryFlag" displayText="Keep Inventory Flag">
        <ui:when test="contains($root/AccessLevel/@Value,'Update') or contains($root/AccessLevel/@Value,'Add')">
          <ui:dropdown id="KeepInventoryFlag" name="KeepInventoryFlag" displayText="Keep Inventory Flag" optionSrc="$root/Inventory/ID" value="{KeepInventoryFlag/@Value}" selectOne="true" />
        </ui:when>
        <ui:otherwise>
          <ui:display-field displayText="Keep Inventory Flag " name="KeepInventoryFlag" />
        </ui:otherwise>
      </ui:choose-field>
      <ui:choose-field id="ParameterValueCommentText" displayText="Comments">
        <ui:when test="contains($root/AccessLevel/@Value,'Update') or contains($root/AccessLevel/@Value,'Add')">
          <ui:textarea id="ParameterValueCommentText" name="ParameterValueCommentText" displayText="Comments" sortable="false" required="false" />
        </ui:when>
        <ui:otherwise>
          <ui:textarea id="ParameterValueCommentText" name="ParameterValueCommentText" displayText="Comments" editable="false" />
        </ui:otherwise>
      </ui:choose-field>
      <ui:hidden-field name="SourceSystemMnemonicValue" id="SourceSystemMnemonicValue" />
      <ui:hidden-field name="SegLocComb" id="SegLocComb" />
      <ui:hidden-field id="ParameterValueCommentText_Hidden" name="ParameterValueCommentText_Hidden" />
      <ui:hidden-field id="KeepInventoryFlag_Hidden" name="KeepInventoryFlag_Hidden" />
      <!-- added by vamshi for multi user edit -->
      <ui:hidden-field id="LAST_MODIFIED_DATE" name="LAST_MODIFIED_DATE" />
    </ui:field-group>
    <ui:buttons id="buttons1" displayCondition="true">
      <ui:button displayText="Mass Update" id="MassUpdate" name="MassUpdate" enabledBySelections="true" displayCondition="{contains($root/AccessLevel/@Value,'Update')}" />
      <ui:divider />
      <!-- <ui:button displayText="Show History" id="ShowHistory" name="ShowHistory" enabledBySelections="true"/>
          <ui:divider/>-->
      <ui:button displayText="Save" id="Save" name="Save" enabledBySelections="true" displayCondition="{contains($root/AccessLevel/@Value,'Update')}" />
    </ui:buttons>
  </ui:table>
  <!--  </ui:step>
  </ui:container>-->
  <ui:script>
    function selectlocation(){
		var LocationIdentificationValue=document.form.LocationIdentificationValue.value;
		var locdesc= document.form.LocationIdentificationValueDescription.value;
		var loctype = document.form.LocationClassMnemonicValue.value;
		//alert(LocationIdentificationValue);
	//	alert(loctype);
		var a = document.getElementById('PartyIdentificationValue');
		var segment = '';
		//alert(a.length);
 		for( k=0; k &lt;a.length;k++)
		{
if(a[k].selected)
		{
		if(segment != '')
		{
		segment = segment + ',';
		}
		segment = segment + a[k].value;
		
		}
		}
		//alert(segment);
		//  CR:94039 12/11/2007 Rahul Keshri Code Starts

			window.open('view.x2ps?SERVICE_NAME=edmuiservice&amp;START_WORKFLOW=wfTLSelectLocation&amp;SOURCE=IPLocation&amp;FIELD_NAME=LocationIdentificationValue&amp;SELECTABLE=All&amp;POPUP=true&amp;SRCH_LOC_ID='+LocationIdentificationValue+'&amp;SRCH_SGMNT_ID='+segment+'&amp;SRCH_LOC_TYPE='+loctype+'&amp;SRCH_LOC_DESC='+locdesc,null,'height=480,width=740,screenX=400,screenY=400,top=200,left=250,toolbar=yes,menubar=no');
    
		// CR:94039 Code Ends
    <!--	window.open('view.x2ps?SERVICE_NAME=edmuiservice&amp;START_WORKFLOW=wfPiSelecLocation&amp;FIELD_NAME=LocationIdentification&amp;SELECTABLE=All&amp;POPUP=true&amp;GroupIdentifier='+groupidentifier+'&amp;GroupLineInfo='+linenumbers,null,'height=480,width=740,screenX=400,screenY=400,top=200,left=250,toolbar=yes,menubar=no');-->
    }
		function clearComments(rowID){
					var table = document.getElementById("IP_LOC_PARAM_data");
		//alert('enters');
		var KeepInvFlag=document.getElementsByName('KeepInventoryFlag');
			var KeepInvFlag_hidden=document.getElementsByName('KeepInventoryFlag_Hidden');
	var a = document.getElementsByName('selectedSegLocComb');
	//	alert(a.length);
			for( k=0; k &lt;a.length;k++)
		{
			if(a[k].checked)
		{
			//alert(k);
		if(KeepInvFlag[k].value !=KeepInvFlag_hidden[k].value)
		{
				//alert(table.rows[k].cells[6].childNodes[0].value);
				table.rows[k].cells[7].childNodes[0].value='';
		}
		
					
	
		}
		}
		}
		function on_MassUpdate(){
		var selectedIds = document.getElementsByName('selectedSegLocComb');
		var maxrows = document.form.pgRowCount.value;
		var lenSelIds = selectedIds.length;
		var count =lenSelIds - maxrows ;
//alert(maxrows);
	//alert(lenSelIds);
var count1=0;
      for(i=0; i &lt; selectedIds.length; i++)
			{
        var t = selectedIds[ i ];
        if ( t.checked )
        {
          count += 1;
		count1+=1;
	        }
      }	
		//alert('kamal');
		//alert(count1);	
		//added for select all start
		if(count1==10)
		{
		  var decision=core_confirm("Do you want to update all records satisfying the current search criteria?");
		if(decision=='yes')
		{
		//alert('selected all records');
			  	document.form.BUTTON_ID.value = 'MassUpdateAll'; 
							document.form.action = 'view.x2ps';
							document.form.submit();  	
		}
		else
		{
			if(count &lt;= 1){
		            core_alert('Please select at least two records for mass update!');
								return;
		}
		else{
		  	document.form.BUTTON_ID.value = 'MassUpdate'; 
							document.form.action = 'view.x2ps';
							document.form.submit();  	
		}
		}

}
				//added for select all start
	else
		{
			if(count &lt;= 1){
		            core_alert('Please select at least two records for mass update!');
								return;
		}
		else{
		  	document.form.BUTTON_ID.value = 'MassUpdate'; 
							document.form.action = 'view.x2ps';
							document.form.submit();  	
		}
				}
		}
		function onSearch(){
		//alert("Rahul");
				var LocationIdentificationValue=document.form.LocationIdentificationValue.value;
		var locdesc= document.form.LocationIdentificationValueDescription.value;
		var loctype = document.form.LocationClassMnemonicValue.value;
//var a = document.getElementsByName('selectedSegLocComb');
		var a = document.getElementById('PartyIdentificationValue');

		    var segment = '';
     		for( k=0; k &lt;a.length;k++)
    		{
    if(a[k].selected)
    		{
    		if(segment != '')
    		{
    		segment = segment + ',';
    		}
    		segment = segment + a[k].value;
    		
    		}
		}
		
		/*
			alert(LocationIdentificationValue);
				alert(locdesc);
		alert(loctype);
/	alert(SegmentDescription);
			alert(segment); */
		
		var	canSubmit = 'true';
		if (LocationIdentificationValue=='' 	&amp;&amp; locdesc=='' 		&amp;&amp; loctype=='' 		&amp;&amp; loctype=='' 		&amp;&amp;  segment==''){
		var response = core_confirm('No search criteria entered, the search might take a long time. Would you still like to continue with the search?');
					if ( response == 'no' ) {
						canSubmit = 'false';
					} else {
						canSubmit = 'true';
					}
		}
		
		if(canSubmit == 'true'){
			document.form.BUTTON_ID.value = 'search_button'; 
				
							document.form.submit();  
		}
		
		
		}
  </ui:script>
</ui:page-group>

