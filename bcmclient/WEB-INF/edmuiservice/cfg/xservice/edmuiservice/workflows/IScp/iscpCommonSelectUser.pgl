<ui:page-group xmlns:ui="http://www.i2.com/ui" title="Select Users" Id="iscpCommonSelectUser.pgl">
  <ui:container id="srchCont" name="srchCont" scrollable="true">
    <ui:step id="srchStp" name="srchStp" displayText="Select Users" scrollable="true">
      <ui:search displayText="Search Users" exportSearch="false" saveSearch="false" collapsable="false">
        <ui:field-group columns="2" select="$root/SEARCH_FIELDS">
          <ui:entry-field name="SRCH_USER_NAME" displayText="User Name" />
          <ui:hidden-field name="FIELD_NAME" id="FIELD_NAME" />
        </ui:field-group>
      </ui:search>
    </ui:step>
  </ui:container>
  <ui:container id="srchResCont" name="srchResCont" scrollable="true">
    <ui:step id="srchResStep" name="srchResStep" displayText="User Search Results" scrollable="true">
      <ui:table id="usrTable" name="usrTable" displayText="User Search Results" displayTextNoRecords="No Records Found" rowSrc="USER_PROFILE" select="$root" rowId="ID" postRowIdAs="SELECTED_USER_IDS" selectable="{$root/SELECT/@Value}" totalRowCount="$root/TotalRowCount/@Value" startAtRow="$root/START_AT_ROW/@Value" rememberSelections="true">
        <ui:field-group>
          <ui:entry-field displayText="User ID" name="ID" editable="false" sortable="true" />
          <ui:entry-field displayText="User Name" name="LOGIN_NAME" editable="false" />
        </ui:field-group>
        <ui:buttons id="buttons1" name="buttons1">
          <ui:button displayText="Cancel" id="cancel" name="cancel" onClick="javascript:window.close();" />
          <ui:button displayText="Select" id="select" name="select" enabledBySelections="true" onClick="javascript:selectUserId();" />
        </ui:buttons>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:script>function selectUserId()
    {
		  var selectedIds =document.getElementsByName( 'SELECTED_USER_IDS' );
		  var length = selectedIds.length;
      var Users = null;
      for(i=0; i &lt; length; i++)
			{
        var t = selectedIds[ i ];
        if ( t.checked )
        {
          if( Users )
            Users += ',' + t.value;

          else
             Users = t.value;
        }
      }
 
      if ( document.form.FIELD_NAME.value.length &gt; 0)
        {

          var fieldName = document.form.FIELD_NAME.value;
          eval("parent.opener.form." + fieldName + ".value = Users;");
      }
      window.close();    
      }</ui:script>
</ui:page-group>

