<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="piGroupSelect.pgl" title="Select Group">
  <ui:container id="searchcriteria" collapsable="true" displayText="search criteria">
    <ui:step id="searchparam" displayText="search criteria">
      <ui:field-group id="groupparam" columns="2">
        <ui:entry-field id="groupidentificaiton" name="groupidentification" displayText="Group ID" value="{$root/searchcriteria/groupidentification/@Value}" />
        <ui:textarea id="groupdescription" name="groupdescription" displayText="Group Description" value="{$root/searchcriteria/groupdescription/@Value}" />
        <ui:dropdown id="groupstatus" name="groupstatus" displayText="Group Status" optionSrc="$root/search/OPTION" selectOne="true" value="{$root/searchcriteria/groupstatus/@Value}" />
        <!-- Fix for not showing Blocked Records in the Popup Result Grid Venkat -->
        <ui:hidden-field id="MANAGE_STS" name="MANAGE_STS" value="FromManageStatusUI" />
        <!-- Fix for not showing Blocked Records in the Popup Result Grid Venkat -->
      </ui:field-group>
      <ui:buttons id="search button">
        <ui:button id="Search" name="Search" displayText="Search" emphasized="true" />
      </ui:buttons>
    </ui:step>
  </ui:container>
  <ui:container id="container">
    <ui:step id="step" displayText="Search results for Item Interchangeability Group">
      <ui:field-group id="loc">
        <ui:hidden-field name="FIELD_NAME" value="{$root/fieldnames/FIELD_NAME/@Value}" />
        <ui:hidden-field name="ROW_ID_NAME" value="{$root/fieldnames/ROW_ID_NAME/@Value}" />
        <ui:hidden-field name="ROW_ID_NAME_1" value="{$root/fieldnames/ROW_ID_NAME_1/@Value}" />
        <ui:hidden-field name="ROW_ID_NAME_2" value="{$root/fieldnames/ROW_ID_NAME_2/@Value}" />
        <ui:hidden-field name="ROW_ID_NAME_3" value="{$root/fieldnames/ROW_ID_NAME_3/@Value}" />
        <ui:hidden-field name="prevselected" value="{$root/fieldnames/prevselected/@Value}" />
      </ui:field-group>
      <ui:table id="IntGrpId" displayText="Item Interchangeability Group ID Search Results" selectable="{$root/fieldnames/SELECT/@Value}" rowSrc="$root/abc" rowId="GroupId" postRowIdAs="GroupIdentification" maxRows="$root/MaxRows/@Value" totalRowCount="$root/TotalRowCount/@Value" startAtRow="$root/StartAtRow/@Value" rememberSelections="true">
        <ui:field-group id="location_grp">
          <ui:entry-field id="GroupId" name="GroupId" displayText="Group ID" editable="false" sortable="true" />
          <ui:entry-field id="Groupdesc" name="Groupdesc" displayText="Group Description" editable="false" />
          <ui:entry-field id="GroupStatus" name="GroupStatus" displayText="Group Status" editable="false" />
        </ui:field-group>
        <ui:buttons id="buttons">
          <ui:button id="Cancel" displayText="Cancel" name="Cancel" onClick="javascript:cancelgrp();" />
          <ui:button id="Save_Return" displayText="Select" name="Save_Return" onClick="javascript:selectItem('IntGrpId');" enabledBySelections="true" />
        </ui:buttons>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:script id="selectItem">function selectItem(tableid)
  {
		  var selectedIds =document.getElementsByName('GroupIdentification');
		  var length = selectedIds.length;
		  
		  var table = document.getElementById(tableid+"_data");
			var items=document.form.prevselected.value;	
			var descr=null;
		  var status=null;
		
      for(i=1; i &lt; length; i++)
			{	
        var t = selectedIds[i];				
				var j=i-1;
        if ( t.checked )
        { 		
					if(items)
				  {				
							items=items+','+table.rows[j].cells[1].childNodes[0].value;							
					}
					else{	
                items =table.rows[j].cells[1].childNodes[0].value;													
								descr=table.rows[j].cells[2].childNodes[0].value;
								status=table.rows[j].cells[3].childNodes[0].value;										
				 			   }
          }
      }	
	
		 if (document.form.FIELD_NAME.value.length &gt; 0 &amp;&amp; document.form.ROW_ID_NAME.value !="")
     {			     
          var fieldName = document.form.FIELD_NAME.value;		 		
		      eval("parent.opener.form." + fieldName + ".value = items;");
					var fieldName1=document.form.ROW_ID_NAME.value;
					eval("parent.opener.form." + fieldName1 + ".value = descr;");
					var fieldName2=document.form.ROW_ID_NAME_1.value;
					eval("parent.opener.form." + fieldName2 + ".value = status;");
					var fieldName3=document.form.ROW_ID_NAME_2.value;
					eval("parent.opener.form." + fieldName3 + ".value = status;");
    }
		if (document.form.FIELD_NAME.value.length &gt; 0 &amp;&amp; document.form.ROW_ID_NAME.value == "")
		{

		   var fieldName = document.form.FIELD_NAME.value;		 		
		   eval("parent.opener.form." + fieldName + ".value = items;");
		}
    window.close();    
      }</ui:script>
  <ui:script>function cancelgrp()
		{
		  window.close();
		}</ui:script>
</ui:page-group>

