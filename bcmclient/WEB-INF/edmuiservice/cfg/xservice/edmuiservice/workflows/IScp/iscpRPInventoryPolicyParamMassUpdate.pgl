<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="iscpRPInventoryPolicyParamMassUpdate.pgl">
  <ui:container id="topContainer">
    <ui:step id="c1" displayText="" editable="true">
      <ui:table displayText="Inventory Policy Parameters" rowSrc="$root/INV_POLICY_DETAILS_LIST/INV_POLICY_DETAILS" collapsable="true" displayCondition="{$root/ShowMassUpdateTable/@Value='YES'}">
        <ui:field-group>
          <ui:display-field name="SegmentNumber" id="SegmentNumber" displayText="Segment" editable="false" />
          <ui:display-field name="ItemIdentificationValue" id="ItemIdentificationValue" displayText="Item Number" sortable="false" />
          <ui:display-field name="ItemDescription" id="ItemDescription" displayText="Item Description" sortable="false" editable="false" />
          <ui:display-field name="ItemType" id="ItemType" displayText="Material Type" sortable="false" editable="false" />
          <ui:display-field name="LocationIdentificationValue" id="LocationIdentificationValue" displayText="Location Number" sortable="false" />
          <ui:display-field name="LocationDescription" id="LocationDescription" displayText="Location Description" sortable="false" editable="false" />
          <ui:display-field name="LocationType" id="LocationType" displayText="Location Type" sortable="false" editable="false" />
          <ui:display-field name="MaximumCoverageDaysNumber" id="MaximumCoverageDaysNumber" displayText="Max Coverage Days" sortable="false" />
          <ui:display-field name="ReplenishmentBandProfile" id="ReplenishmentBandProfile" displayText="Max Inventory Bands" sortable="false" optionSrc="$root/BAND_PROFILES/ID" value="{ReplenishmentBandProfile/@Value}" />
          <ui:display-field name="DeploymentPolicy" id="DeploymentPolicy" displayText="Deployment Policy" sortable="false" optionSrc="$root/DEPLOYMENT_POLICY/ID" value="{DeploymentPolicy/@Value}" />
          <ui:display-field name="EffectiveStartDate" id="EffectiveStartDate" displayText="Effective Start Date" sortable="false" editable="true" />
          <ui:display-field name="EffectiveEndDate" id="EffectiveEndDate" displayText="Effective End Date" sortable="false" editable="true" />
          <ui:display-field name="MaximumCoverageDaysCommentText" id="MaximumCoverageDaysCommentText" displayText="Max Coverage Days Comments" sortable="false" />
          <ui:display-field name="ReplenishmentBandProfileCommentText" id="ReplenishmentBandProfileCommentText" displayText="Max Inventory Bands Comments" sortable="false" />
          <ui:display-field name="DeploymentPolicyCommentText" id="DeploymentPolicyCommentText" displayText="Deployment Policy Comments" sortable="false" />
          <ui:hidden-field name="SourceSystemMnemonicValue" id="SourceSystemMnemonicValue" />
          <ui:hidden-field name="ItemUnitOfMeasureValue" id="ItemUnitOfMeasureValue" />
        </ui:field-group>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:container id="bottomContainer" displayText="Mass Update">
    <ui:step id="c1" displayText="" editable="true">
      <ui:validation successMessage="{$root/SUCCESSMSG/MSG/@Value}" anyFieldIsRequired="true" />
      <ui:table displayText="Updatable Parameters" rowSrc="$root/PARAMETER_NAMES/PARAMETER_NAME" postRowIdAs="SelectedParameterName" rowId="paramName" exportable="false" selectable="All" scrollable="true" id="MassUpdate">
        <ui:field-group>
          <ui:display-field displayText="Parameter Name" name="ParameterName" id="ParameterName" />
          <ui:hidden-field name="paramName" id="paramName" />
          <ui:hidden-field name="CommentTag" />
          <ui:choose-field name="ParameterValue" displayText="Parameter Value">
            <ui:when test="DROPDOWN/@Value = 'true'">
              <ui:dropdown id="PARAMVAL" name="PARAMVAL" optionSrc="ID" value="{ParamVal/@Value}" />
            </ui:when>
            <ui:otherwise>
              <ui:entry-field name="PARAMVAL" required="false" value="{ParamVal/@Value}" />
            </ui:otherwise>
          </ui:choose-field>
          <ui:textarea name="CommentsVal" displayText="Comments" required="false" value="{CommentsVal/@Value}" />
        </ui:field-group>
        <ui:buttons>
          <ui:button displayText="Save" id="Save" name="Save" enabledBySelections="true" onClick="javaScript:checkComments('MassUpdate')" emphasized="true" />
          <!-- RIC: 240988 Praneeth - Cancel button wording changes request - Start -->
          <ui:button displayText="Back to Search" id="MassUpdateCancel" name="MassUpdateCancel" enabledBySelections="false" emphasized="true" />
          <!-- RIC: 240988 Praneeth - Cancel button wording changes request - End -->
        </ui:buttons>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:script>function checkComments(tableid)
		{
	
		var table = document.getElementById(tableid+"_data");
		var count=0,j;
		var a=document.getElementsByName('SelectedParameterName');
					
		for( k=0; k &lt;a.length;k++)
		{
		
		if(a[k].checked)
		{
//	alert(k);

			for(var j=0;j&lt; table.rows[k].cells.length;j++)
		{
		//alert(table.rows[k].cells[j].childNodes[0].value);
	
		if(table.rows[k].cells[j].childNodes[0].tagName =="TEXTAREA" &amp;&amp; (table.rows[k].cells[j].childNodes[0].value=="" || table.rows[k].cells[j].childNodes[0].value==null))
		{

		core_alert("Enter Comments for  "+table.rows[k].cells[1].innerHTML);
		return;
		}
		}
		}
		}
				 document.form.BUTTON_ID.value="Save";

                document.form.submit();
		}</ui:script>
</ui:page-group>

