<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="TLTransAssetMassUpdate.pgl">
  <ui:container id="topContainer" scrollable="true" collapsable="true">
    <ui:step id="c1" displayText="Transportation Asset Mass Update Selections">
      <!--      <ui:validation anyFieldIsRequired="false" successMessage="{$root/MESSAGE/SUCCESS_MESSAGE/@Value}"/>-->
      <!--      <ui:hidden-field id="SELECTED_TA_ID" name="SELECTED_TA_ID"/>
      <ui:hidden-field id="PREV_START_COUNT" name="PREV_START_COUNT"/>-->
      <ui:table id="TassetTable" name="TassetTable" displayText="Transportation Assets" displayTextNoRecords="Not found" rowSrc="P_TransportEquipmentItem" select="$root" collapsable="false" displayCondition="{$root/ABC/displayTableFlag/@Value ='true'}">
        <ui:field-group>
          <ui:entry-field displayText="Asset Number" name="TransportationAssetValue" editable="false" />
          <ui:display-field displayText="Asset Description" name="TransportationAssetDescription" />
          <ui:display-field displayText="Default Asset Cube" name="DefaultAssetCubeMeasure" dataType="Number" decimals="0" maxlength="13" unFormat="true" />
          <ui:dropdown displayText="Asset Cube UOM" name="DefaultAssetCubeUnitOfMeasureValue" optionSrc="$root/UOM_VALUES1/*" editable="false" />
          <ui:display-field displayText="Default Asset Weight" name="DefaultAssetWeightMeasure" dataType="Number" decimals="0" maxlength="13" unFormat="true" />
          <ui:dropdown displayText="Asset Weight UOM" name="DefaultAssetWeightUnitOfMeasureValue" optionSrc="$root/UOM_VALUES/*" editable="false" />
          <ui:display-field displayText="Number of Asset Pallets" name="DefaultPalletAssetCount" dataType="Number" decimals="0" maxlength="11" />
          <ui:textarea displayText="Comments" name="TransportEquipmentItemCommentText" editable="false" />
        </ui:field-group>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:container id="bottomContainer" displayText="Mass Update" scrollable="true">
    <ui:step id="c1" displayText="Mass Update" editable="true">
      <ui:validation successMessage="{$root/SUCCESS_MESSAGE/@Value}" />
      <ui:field-group id="main" rows="4">
        <ui:field-group columns="6" id="fieldGroups1">
          <ui:field-group id="leftFields">
            <ui:checkbox id="chkDefaultAssetCube" name="chkDefaultAssetCube" onClick="javascript:valChk();" />
          </ui:field-group>
          <ui:field-group id="middleFields" columns="12" select="$root/REQUEST">
            <ui:entry-field displayText="Default Asset Cube" name="upd_DefaultAssetCube" dataType="Number" decimals="0" maxlength="13" minValue="1" />
            <ui:checkbox id="chkDefaultAssetCubeUOM" name="chkDefaultAssetCubeUOM" onClick="javascript:valChk();" />
            <ui:dropdown displayText="Asset Cube UOM" name="upd_DefaultAssetCubeUnitOfMeasure" optionSrc="$root/UOM_VALUES1/*" selectOne="true" />
          </ui:field-group>
        </ui:field-group>
        <ui:field-group columns="4" id="fieldGroups2">
          <ui:field-group id="leftFields">
            <ui:checkbox id="chkDefaultAssetWeight" name="chkDefaultAssetWeight" onClick="javascript:valChk();" />
          </ui:field-group>
          <ui:field-group id="middleFields" columns="6" select="$root/REQUEST">
            <ui:entry-field displayText="Default Asset Weight" name="upd_DefaultAssetWeight" dataType="Number" decimals="0" maxlength="13" minValue="1" />
            <ui:checkbox id="chkDefaultAssetWeightUOM" name="chkDefaultAssetWeightUOM" onClick="javascript:valChk();" />
            <ui:dropdown displayText="Asset Weight UOM" name="upd_DefaultAssetWeightUnitOfMeasure" optionSrc="$root/UOM_VALUES/*" selectOne="true" />
          </ui:field-group>
        </ui:field-group>
        <ui:field-group columns="6" id="fieldGroups2">
          <ui:field-group id="leftFields">
            <ui:checkbox id="chkDefaultNumberOfAssetPallets" name="chkDefaultNumberOfAssetPallets" onClick="javascript:valChk();" />
          </ui:field-group>
          <ui:field-group id="middleFields" columns="11" select="$root/REQUEST">
            <ui:entry-field displayText="Number of Asset Pallets" name="upd_DefaultNumberOfAssetPallets" dataType="Number" decimals="0" maxlength="11" minValue="1" />
          </ui:field-group>
        </ui:field-group>
        <ui:field-group columns="8" id="fieldGroups2" select="$root/REQUEST">
          <ui:field-group id="leftFields">
            <ui:textarea name="TransportEquipmentItemCommentText" displayText="Comments" required="true" />
          </ui:field-group>
        </ui:field-group>
      </ui:field-group>
      <ui:buttons>
        <!-- RIC: 240988 Praneeth - Cancel button wording changes request - Start -->
        <ui:button displayText="Back to Search" id="cancel" validate="false" />
        <!-- RIC: 240988 Praneeth - Cancel button wording changes request - End -->
        <ui:button displayText="Save" id="Save" name="Save" disabled="{count($root/REQUEST/*/_ERRORS) = 0}" onClick="javascript:valSave();" />
      </ui:buttons>
    </ui:step>
  </ui:container>
  <ui:script>
    function valChk(){	
		//core_alert("in CHK!");
		var chkNewDefaultAssetCube = document.getElementsByName("chkDefaultAssetCube");
			var chkNewDefaultAssetCubeUOM = document.getElementsByName("chkDefaultAssetCubeUOM");
			var chkNewDefaultAssetWeight = document.getElementsByName("chkDefaultAssetWeight");
	 		var chkNewDefaultAssetWeightUOM = document.getElementsByName("chkDefaultAssetWeightUOM");
   		var chkNewDefaultNumberOfAssetPallets = document.getElementsByName("chkDefaultNumberOfAssetPallets"); 
		
			if(chkNewDefaultAssetCube[0].checked || chkNewDefaultAssetCubeUOM[0].checked || chkNewDefaultAssetWeight[0].checked||chkNewDefaultAssetWeightUOM[0].checked || chkNewDefaultNumberOfAssetPallets[0].checked)
		{
				//core_alert("in CHK!");
				 i2uiToggleButtonState('Save', 'enabled');
			}		
		else{
			 i2uiToggleButtonState('Save', 'disabled');
			}		
		}
		
		function valSave(){
		var chkAsstCube = document.getElementsByName("chkDefaultAssetCube");
		var chkAsstCubeUOM = document.getElementsByName("chkDefaultAssetCubeUOM");
		var chkAsstWghtUOM = document.getElementsByName("chkDefaultAssetWeightUOM");
		var chkAsstWeight = document.getElementsByName("chkDefaultAssetWeight");
		var chkAsstPallet = document.getElementsByName("chkDefaultNumberOfAssetPallets");
		var chkAssetCubeVal = document.form.upd_DefaultAssetCube.value;		
		var assetCubeUOM = document.form.upd_DefaultAssetCubeUnitOfMeasure.value;				
		var assetWghtUOM = document.form.upd_DefaultAssetWeightUnitOfMeasure.value;		
		var chkAssetWghtVal = document.form.upd_DefaultAssetWeight.value;		
		var chkAssetPalletVal = document.form.upd_DefaultNumberOfAssetPallets.value;
		var chkComments = document.form.TransportEquipmentItemCommentText.value;	
		var canSave = "false";
    <!--  MYANG RIC 203580 - Validation for focused fields when save START -->
    var anum=/(^\d+$)|(^\d+\.\d+$)/;
    <!--  MYANG RIC 203580 - Validation for focused fields when save END -->
    if(chkAsstCube[0].checked || chkAsstWeight[0].checked || chkAsstPallet[0].checked || chkAsstCubeUOM[0].checked || chkAsstWghtUOM[0].checked)
		{

  	 if(chkAsstCube[0].checked &amp;&amp; chkAssetCubeVal.length == 0)
		{
		// Check Asset Cube has been entered
		core_alert("Please enter the value for Asset Cube!");
				canSave = "false";
				return;				
		}
		else{
						canSave = "true";
		}		
		
		 if(chkAsstCube[0].checked &amp;&amp; chkAssetCubeVal == 0)
		{
		// Check Asset Cube is not zero
		core_alert("Please enter Non Zero Value for Asset Cube!");
				canSave = "false";
				return;				
		}
		else{
						canSave = "true";
		}
    <!--  MYANG RIC 203580 - Validation for focused fields when save START -->
    if(chkAsstCube[0].checked &amp;&amp; chkAssetCubeVal.length &gt; 0)
		{
				if (!anum.test(chkAssetCubeVal)) {
					//document.form.upd_DefaultAssetCube.value = floor(chkAssetCubeVal);
					core_alert("Please enter a positive value for Default Asset Cube!");
					canSave = "false";
					return;				
				}
		}
    <!--  MYANG RIC 203580 - Validation for focused fields when save END -->
    if(chkAsstCubeUOM[0].checked &amp;&amp; assetCubeUOM.length == 0)
		{
		// Check Asset Cube has been entered
		core_alert("Please enter the value for Asset Cube UOM!");
				canSave = "false";
				return;				
		}
		else{
						canSave = "true";
		}		

		if(chkAsstWeight[0].checked &amp;&amp; chkAssetWghtVal.length == 0)
		{
		// Check Asset Weight has been entered
		core_alert("Please enter the value for Asset Weight!");
				canSave = "false";
				return;				
		}
		else{
						canSave = "true";
		}		
		if(chkAsstWeight[0].checked &amp;&amp; chkAssetWghtVal == 0)
		{
		// Check Asset Weight is not zero
		core_alert("Please enter Non Zero value for Asset Weight!");
				canSave = "false";
				return;				
		}
		else{
						canSave = "true";
		}
    <!--  MYANG RIC 203580 - Validation for focused fields when save START -->
    if(chkAsstWeight[0].checked &amp;&amp; chkAssetWghtVal.length &gt; 0)
		{
				//document.form.upd_DefaultAssetWeight.value = floor(chkAssetWghtVal);
				if (!anum.test(chkAssetWghtVal)) {
					core_alert("Please enter a positive value for Default Asset Weight!");
					canSave = "false";
					return;				
				}
		}
    <!--  MYANG RIC 203580 - Validation for focused fields when save END -->
    if(chkAsstWghtUOM[0].checked &amp;&amp; assetWghtUOM.length == 0)
		{
		// Check Asset Weight has been entered
		core_alert("Please enter the value for Asset Weight UOM!");
				canSave = "false";
				return;				
		}
		else{
						canSave = "true";
		}		
		
		if(chkAsstPallet[0].checked &amp;&amp; chkAssetPalletVal.length == 0)
		{
		// Check Asset Pallet has been entered
		core_alert("Please enter the number of Asset Pallets!");
				canSave = "false";
				return;				
		}
		else{
						canSave = "true";
		}		
	
		if(chkAsstPallet[0].checked &amp;&amp; chkAssetPalletVal == 0)
		{
		// Check Asset Pallet is not zero
		core_alert("Please enter Non Zero number of Asset Pallets!");
				canSave = "false";
				return;				
		}
		else{
						canSave = "true";
		}		
	
		if(chkAsstPallet[0].checked &amp;&amp; chkAssetPalletVal.length &gt; 0)
		{
				//document.form.upd_DefaultNumberOfAssetPallets.value = floor(chkAssetPalletVal);
    <!--  MYANG RIC 203580 - Validation for focused fields when save START -->
    if (!anum.test(chkAssetPalletVal)) {
					core_alert("Please enter a positive value for Number of Asset Pallets!");
					canSave = "false";
					return;				
				}
    <!--  MYANG RIC 203580 - Validation for focused fields when save END -->
    }	
		
		if(trimString(chkComments).length == 0){
		core_alert("Please enter comments before saving!");
				canSave = "false";
				return;				
		}			
		else{
						canSave = "true";
		}
		if(trimString(chkComments).length &gt; 255){
		core_alert("Comments should not be greater than 255 characters!");
				canSave = "false";
				return;				
		}			
		else{
						canSave = "true";
		}		
    }		
		else{
		core_alert("Please enter Values for at least one of Asset Cube or Asset Weight or Asset Pallet");
		canSave = "false";
		}
		if(canSave == "false"){
		}
		else{
							document.form.BUTTON_ID.value = 'Save'; 
							document.form.action = 'view.x2ps';
							document.form.submit();  		
        }		
		}
  </ui:script>
</ui:page-group>

