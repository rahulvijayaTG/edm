<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="TLSelectLocation.pgl" title="Select Location">
  <ui:container id="srchCont" name="srchCont" scrollable="true" collapsable="true">
    <ui:step id="srchStp" name="srchStp" displayText="Select Location" scrollable="true">
      <ui:search displayText="Search Location" exportSearch="false" saveSearch="false" collapsable="false">
        <ui:field-group columns="2" select="$root/SEARCH_FIELDS">
          <ui:entry-field name="SRCH_LOC_ID" displayText="Location Number" />
          <!--ui:entry-field name="SRCH_LOC_NAME" displayText="Location Name"/-->
          <ui:entry-field name="SRCH_LOC_DESC" displayText="Location Description" />
          <ui:dropdown displayText="Location Type" name="SRCH_LOC_TYPE" optionSrc="$root/LOC_TYPES/*" selectAll="false" />
          <ui:hidden-field name="FIELD_NAME" id="FIELD_NAME" />
          <ui:hidden-field name="PREV_SEL" id="PREV_SEL" />
          <ui:hidden-field name="POPULATE_LOC_NAME" id="POPULATE_LOC_NAME" />
          <ui:hidden-field name="SRCH_SGMNT_ID" id="SRCH_SGMNT_ID" />
          <ui:hidden-field name="SRCH_ITEM_ID" id="SRCH_ITEM_ID" />
          <ui:hidden-field name="POP_LOCC_TYPE" id="POP_LOCC_TYPE" />
        </ui:field-group>
      </ui:search>
    </ui:step>
  </ui:container>
  <ui:container id="srchResCont" name="srchResCont" scrollable="true">
    <ui:step id="srchResStep" name="srchResStep" displayText="Locations Search Results" scrollable="true">
      <ui:table id="locTable" name="locTable" displayText="Locations Search Results" displayTextNoRecords="No Records Found" rowSrc="P_Location" select="$root/LOC_DETAILS" rowId="LocationIdn" postRowIdAs="SELECTED_LOC_IDS" selectable="{$root/SELECT/@Value}" startAtRow="$root/START_AT_ROW/@Value" rememberSelections="true" collapsable="false">
        <ui:field-group>
          <ui:entry-field displayText="Location Number" name="LocationIdn" editable="false" sortable="true" />
          <!--ui:entry-field displayText="Location Name" name="LocationName" editable="false"/-->
          <ui:display-field displayText="Location Description" name="LocationDescription" />
          <ui:entry-field displayText="Location Type" name="LocationType" editable="false" />
        </ui:field-group>
        <ui:buttons id="buttons1" name="buttons1">
          <ui:button displayText="Cancel" id="cancel" name="cancel" onClick="javascript:window.close();" />
          <ui:button displayText="Select" id="select" name="select" enabledBySelections="true" onClick="javascript:selectLocation();" />
        </ui:buttons>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:script>function selectLocation()
    {
		  var selectedIds =document.getElementsByName( 'SELECTED_LOC_IDS' );
		  var prevSelections =document.form.PREV_SEL.value;
		  //var selectedLocName =document.getElementsByName( 'LocationName' );		
		  var length = selectedIds.length;
      var locs = null;
		  var locName = null;
		var locType=null;
		var selectedLocType =document.getElementsByName('LocationType');		
      for(i=0; i &lt; length; i++)
			{
        var t = selectedIds[ i ];
		   //var selLocName = selectedLocName[i]; 
		var selLocType = selectedLocType[i];
        if ( t.checked )
        {
          if( locs )
            locs += ',' + t.value;
          else
             locs = t.value;
			  if( locType )
					{

            locType += ',' + selLocType.value;	}
          else
						{
             locType = selLocType.value;
				   }
		
		  }
          /*if( selLocName )
            locName =  selLocName.value;

          else
            locName =  selLocName.value;*/

      
      }
      if(prevSelections.length &gt; 0)
	{
		locs= prevSelections+','+locs;
	}
      if ( document.form.FIELD_NAME.value.length &gt; 0)
        {

          var fieldName = document.form.FIELD_NAME.value;
          eval("parent.opener.form." + fieldName + ".value = locs;");
      }
		if ( document.form.POP_LOCC_TYPE.value.length &gt; 0)
        {

          var fieldName1 = document.form.POP_LOCC_TYPE.value;

          eval("parent.opener.form." + fieldName1 + ".value = locType;");
      }
		 
      /*if ( document.form.POPULATE_LOC_NAME.value.length &gt; 0)
        {

          var fieldName = document.form.POPULATE_LOC_NAME.value;
          eval("parent.opener.form." + fieldName + ".value = locName;");
      }*/		
      window.close();    
      }</ui:script>
</ui:page-group>

