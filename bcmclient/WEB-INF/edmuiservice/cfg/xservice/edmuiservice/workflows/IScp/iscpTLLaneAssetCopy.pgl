<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="TLLaneAssetCopy.pgl">
  <ui:container id="cnt" scrollable="true">
    <ui:step id="stp" displayText="Copy Lane Asset Assignment">
      <ui:validation anyFieldIsRequired="true" />
      <ui:field-group id="new" columns="2">
        <ui:hidden-field id="SEQ_NUM" name="SEQ_NUM" />
        <ui:hidden-field id="START_COUNT" name="START_COUNT" />
        <ui:entry-field name="TransportLaneIdentifier" displayText="Lane Name" required="true" unFormat="true" align="left">
          <ui:links>
            <ui:link displayText="Select Lane" targetType="popup" targetName="catalogPopup">
              <ui:url page="view.x2ps">
                <BUTTON_ID select="'Select_tl_id'" />
                <FIELD_NAME select="'TransportLaneIdentifier'" />
                <!-- QC:20744 Pop-up Close Praneeth 01/15/2008 Start-->
                <!--<POP_LANE_NAME select="'TransportLaneName'" />-->
                <!-- QC:20744 Pop-up Close Praneeth 01/15/2008 End-->
                <SELECTABLE select="'Single'" />
              </ui:url>
              <ui:image src="pop_up_window.gif" />
            </ui:link>
          </ui:links>
        </ui:entry-field>
        <!--<ui:entry-field displayText="Lane Name" name="TransportLaneName" readOnly="true"/>-->
        <ui:entry-field name="ItemId" displayText="Asset Number" required="true">
          <ui:links>
            <ui:link displayText="Select Asset" targetType="popup" targetName="catalogPopup">
              <ui:url page="view.x2ps">
                <BUTTON_ID select="'Select_ta_id'" />
                <FIELD_NAME select="'ItemId'" />
                <POP_ASST_DESC select="'ItemDescription'" />
                <ITEM_TYPE select="'TRAN'" />
                <SELECTABLE select="'Single'" />
                <SOURCE select="'TransAsset'" />
              </ui:url>
              <ui:image src="pop_up_window.gif" />
            </ui:link>
          </ui:links>
        </ui:entry-field>
        <ui:entry-field displayText="Asset Description" name="ItemDescription" readOnly="true" />
        <ui:entry-field displayText="Lane Asset Start Date" name="EffectiveStartDate" dataType="Date" required="true" />
        <ui:entry-field displayText="Lane Asset End Date" name="EffectiveEndDate" dataType="Date" required="true" />
        <ui:dropdown displayText="Asset Priority" name="AssetPriority" selectOne="true" optionSrc="$root/ASST_PRIR/*" required="true" />
        <ui:dropdown displayText="Valid Days Of Week" name="ValidDaysOfWeek" selectOne="true" optionSrc="$root/DOW/*" required="true" />
        <!--      </ui:field-group>
      <ui:field-group id="subGrp" columns="2">-->
        <ui:entry-field displayText="Min Target Cube" name="MinCubetarget" required="true" dataType="Number" decimals="0" maxlength="13" unFormat="true" align="left" minValue="1" />
        <ui:entry-field displayText="Target Cube Value" name="TargetCubeValue" required="true" dataType="Number" decimals="0" maxlength="13" unFormat="true" align="left" minValue="1" />
        <ui:entry-field displayText="Max Target Cube" name="MaxCubetarget" required="true" dataType="Number" decimals="0" maxlength="13" unFormat="true" align="left" minValue="1" />
        <ui:entry-field displayText="Target Weight Value" name="TargetWeightValue" required="true" dataType="Number" decimals="0" maxlength="13" unFormat="true" align="left" minValue="1" />
        <ui:entry-field displayText="Target Pallet Value" name="TargetPalletValue" required="true" dataType="Number" decimals="0" maxlength="11" unFormat="true" align="left" minValue="1" />
        <ui:entry-field displayText="Number of Assets Available" name="NumberofAssetsAvailable" required="true" dataType="Number" maxlength="11" decimals="0" unFormat="true" align="left" minValue="1" />
      </ui:field-group>
      <ui:field-group id="comGrp" columns="2">
        <ui:textarea displayText="Comments" name="TransportLaneXTransportEquipmentItemCommentText" required="false" />
      </ui:field-group>
      <ui:buttons id="buttons1" name="buttons1">
        <!-- RIC: 240988 Praneeth - Cancel button wording changes request - Start -->
        <ui:button displayText="Back to Search" id="cancel" validate="false" />
        <!-- RIC: 240988 Praneeth - Cancel button wording changes request - End -->
        <ui:button displayText="Save" id="save_copy" onClick="javascript:on_save()" />
      </ui:buttons>
    </ui:step>
  </ui:container>
  <ui:script>function on_save(){
   var bIsValid = true;
   document.form.SUBMIT_AS_XML.value = 'false';
  
  bIsValid = (isValid_stp());
   
  if( bIsValid == false )
  {
    validation_alert('stp');
  }
  
  if ( bIsValid == true) 
  {
var startDate = document.form.EffectiveStartDate_DC.value;
var endDate = document.form.EffectiveEndDate_DC.value;				
if (Date.parse(startDate) &gt; Date.parse(endDate)) {
		core_alert("Invalid Date Range,Start Date cannot be after End Date!")
		bIsValid == false
		return;
}		
  
 		//document.form.DefaultNumberOfAssetPallets.value = floor(noOfPallets);
	
 	//	document.form.TransportationAssetDescription.value = trimString(assetDesc);
   disableButtons(); 
   trapExcelPivotChanges(); 
  document.form.BUTTON_ID.value = 'save_copy'; 
  document.form.action = 'view.x2ps';
  document.form.submit();  
  }
  
  onResize();  
  return; 

}</ui:script>
</ui:page-group>

