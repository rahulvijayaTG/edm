<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="TLLaneProductMassUpdate.pgl">
  <ui:container id="topContainer" scrollable="true" collapsable="true">
    <ui:step id="c1" displayText="Lane Product Assignment Mass Update Selections" editable="true" displayCondition="{$root/ABC/displayTableFlag/@Value ='true'}">
      <ui:table id="TassetTable" name="TassetTable" displayText="Lane Product Assignments" displayTextNoRecords="Not found" rowSrc="P_TransportLaneXItem" select="$root/LANE_ITEM_DETAILS" rowId="SeqNum" postRowIdAs="SEQ_NUM" scrollable="true" collapsable="false">
        <ui:field-group>
          <ui:hidden-field name="TransportLaneIdentifier" id="TransportLaneIdentifier" />
          <ui:link-field displayText="Lane Name" name="TransportLaneName" targetType="popup" targetName="catalogPopup">
            <ui:url page="view.x2ps">
              <ID select="TransportLaneIdentifier/@Value" />
              <BUTTON_ID select="'view_tlane'" />
            </ui:url>
          </ui:link-field>
          <ui:hidden-field name="SeqNum" />
          <!--          <ui:entry-field displayText="Source Location" name="SourceLocationIdn" editable="false"/>
          <ui:display-field displayText="Source Location Name" name="SrcLocationName" />
          <ui:entry-field displayText="Destination Location" name="DestinationLocationIdn" editable="false" />
          <ui:display-field displayText="Destination Location Name" name="DestnLocationName" />
          <ui:entry-field displayText="Transport Mode" name="TransMode" sortable="true" editable="false"/>-->
          <ui:entry-field displayText="Material Number" name="ItemIdentification" editable="false" />
          <ui:display-field displayText="Material Description" name="ItemDescription" />
          <!-- CR:107148 12/29/2007 Venkat Code Start -->
          <!--<ui:display-field displayText="Material Type" name="ItemType" sortable="false"/>-->
          <ui:display-field displayText="Material Type" name="ItemTypeName" sortable="false" />
          <!-- CR:107148 12/29/2007 Venkat Code End -->
          <ui:entry-field displayText="Segment" name="SegmentIdentification" editable="false" />
          <ui:display-field displayText="Segment Description" name="PartyDescription" />
          <ui:display-field displayText="Lane Item Start Date" name="EffectiveStartDate" dataType="Date" />
          <ui:display-field displayText="Lane Item End Date" name="EffectiveEndDate" dataType="Date" />
          <ui:display-field displayText="Replenish Lot Size" name="ReplenishmentLotSize" dataType="Number" decimals="0" maxlength="13" unFormat="true" />
          <ui:display-field displayText="Replenishment Lot Size UOM" name="ReplenishmentLotSizeUOM" />
          <!-- MYANG RIC 249141  - TL Prod single sku field Start -->
          <ui:display-field displayText="Single SKU" name="ReplenishmentRoundingValue" dataType="Number" decimals="0" maxlength="13" unFormat="true" />
          <!-- MYANG RIC 249141  - TL Prod single sku field End -->
          <ui:display-field displayText="Unloading Time (hours)" name="UnloadingTime" dataType="Number" decimals="0" unFormat="true" />
          <ui:display-field displayText="Loading Time (hours)" name="LoadingTime" dataType="Number" decimals="0" unFormat="true" />
          <ui:display-field displayText="Sourcing Priority" name="SourcingPriority" />
          <ui:display-field displayText="Transport Mode Priority" name="TransportModePriority" />
          <ui:field-group displayText="Destination Receiving Days" id="days" columns="2">
            <ui:checkbox id="SUN" name="SUN" displayText="Sun" disabled="true" />
            <ui:checkbox id="MON" name="MON" displayText="Mon" disabled="true" />
            <ui:checkbox id="TUE" name="TUE" displayText="Tues" disabled="true" />
            <ui:checkbox id="WED" name="WED" displayText="Wed" disabled="true" />
            <ui:checkbox id="THU" name="THU" displayText="Thurs" disabled="true" />
            <ui:checkbox id="FRI" name="FRI" displayText="Fri" disabled="true" />
            <ui:checkbox id="SAT" name="SAT" displayText="Sat" disabled="true" />
          </ui:field-group>
          <ui:display-field displayText="Lane Item Status" name="TransportationLaneStatus" />
          <ui:textarea displayText="Comments" name="TransportLaneXItemCommentText" editable="false" />
        </ui:field-group>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:container id="bottomContainer" displayText="Mass Update" scrollable="true">
    <ui:step id="c1" displayText="Mass Update" editable="true">
      <ui:validation successMessage="{$root/SUCCESS_MESSAGE/@Value}" />
      <ui:field-group columns="6" id="fieldGroups1">
        <ui:field-group id="leftFields">
          <ui:checkbox id="chkEndDate" name="chkEndDate" onClick="javascript:valChk();" />
        </ui:field-group>
        <ui:field-group id="middleFields" columns="11">
          <!--          <ui:entry-field displayText="Lane Asset Start Date " name="upd_EffectiveStartDate" dataType="Date"/>-->
          <ui:entry-field displayText="Lane Item End Date " name="upd_EffectiveEndDate" dataType="Date" />
          <ui:checkbox id="chkLaneItemSts" name="chkLaneItemSts" onClick="javascript:valChk();" />
          <ui:dropdown displayText="Lane Item Status" name="TransportationLaneStatus" optionSrc="$root/LANE_ITEM_STATUS/*" selectOne="true" />
        </ui:field-group>
      </ui:field-group>
      <ui:field-group columns="6" id="fieldGroups2">
        <ui:field-group id="leftFields">
          <ui:checkbox id="chkLoadingTime" name="chkLoadingTime" onClick="javascript:valChk();" />
        </ui:field-group>
        <ui:field-group id="middleFields" columns="11">
          <ui:entry-field displayText="Loading Time (hours)" name="LoadingTime" dataType="Number" decimals="0" maxlength="11" unFormat="true" minValue="0" />
          <ui:checkbox id="chkUnloadingTime" name="chkUnloadingTime" onClick="javascript:valChk();" />
          <ui:entry-field displayText="Unloading Time (hours)" name="UnloadingTime" dataType="Number" decimals="0" maxlength="11" unFormat="true" minValue="0" />
        </ui:field-group>
      </ui:field-group>
      <ui:field-group columns="6" id="fieldGroups2">
        <ui:field-group id="leftFields">
          <ui:checkbox id="chkRplLotSize" name="chkRplLotSize" onClick="javascript:valChk();" />
        </ui:field-group>
        <ui:field-group id="middleFields" columns="11">
          <ui:entry-field displayText="Replenishment Lot Size" name="ReplenishmentLotSize" dataType="Number" decimals="0" maxlength="13" unFormat="true" />
          <ui:checkbox id="chkRplLotSizeUOM" name="chkRplLotSizeUOM" onClick="javascript:valChk();" />
          <ui:dropdown displayText="Replenishment Lot Size UOM" name="ReplenishmentLotSizeUnitOfMeasure" selectOne="true" optionSrc="$root/UOM_VALUES/*" />
        </ui:field-group>
      </ui:field-group>
      <!--<ui:field-group columns="4" id="fieldGroups2">
        <ui:field-group id="leftFields">
          <ui:checkbox id="chkRplRndgVal" name="chkRplRndgVal" onClick="javascript:valChk();"/>
        </ui:field-group>
        <ui:field-group id="middleFields" columns="6">
          <ui:entry-field displayText="Replenishment Rounding Value" name="ReplenishmentRoundingValue" dataType="Number" decimals="4" maxlength="13"/>
          <ui:checkbox id="chkLaneItemSts" name="chkLaneItemSts" onClick="javascript:valChk();"/>
          <ui:dropdown displayText="Lane Item Status" name="TransportationLaneStatus" optionSrc="$root/LANE_ITEM_STATUS/*" selectOne="true"/>
        </ui:field-group>
      </ui:field-group>-->
      <ui:field-group columns="4" id="fieldGroups3">
        <ui:field-group id="leftFields">
          <ui:checkbox id="chkSrcPrir" name="chkSrcPrir" onClick="javascript:valChk();" />
        </ui:field-group>
        <ui:field-group id="middleFields" columns="6">
          <ui:dropdown displayText="Sourcing Priority" name="SourcingPriority" optionSrc="$root/SRC_PRIR/*" selectOne="true" />
          <ui:checkbox id="chkTrnsModePrir" name="chkTrnsModePrir" onClick="javascript:valChk();" />
          <ui:dropdown displayText="Transport Mode Priority" name="TransportModePriority" optionSrc="$root/TRANS_MODE_PRIR/*" selectOne="true" />
        </ui:field-group>
      </ui:field-group>
      <!-- MYANG RIC 249141  - TL Prod single sku field Start -->
      <ui:field-group columns="4" id="fieldGroups4">
        <ui:field-group id="leftFields">
          <ui:checkbox id="chkRplRndgVal" name="chkRplRndgVal" onClick="javascript:valChk();" />
        </ui:field-group>
        <ui:field-group id="middleFields" columns="2">
          <ui:entry-field displayText="Single SKU" name="ReplenishmentRoundingValue" dataType="Number" decimals="0" maxlength="13" unFormat="true" />
        </ui:field-group>
      </ui:field-group>
      <ui:entry-field displayText="Single SKU" name="ReplenishmentRoundingValue" dataType="Number" decimals="4" maxlength="13" align="left" />
      <!-- MYANG RIC 249141  - TL Prod single sku field End -->
      <ui:field-group columns="6" id="fieldGroups3">
        <ui:field-group id="leftFields" rows="4">
          <ui:checkbox id="chkDestnDays" name="chkDestnDays" onClick="javascript:valChk();" />
        </ui:field-group>
        <ui:field-group id="middleFields" columns="11" rows="1">
          <ui:field-group displayText="Destination Receiving Days" id="days" columns="2">
            <ui:checkbox id="upd_SUN" name="upd_SUN" displayText="Sun" />
            <ui:checkbox id="upd_MON" name="upd_MON" displayText="Mon" />
            <ui:checkbox id="upd_TUE" name="upd_TUE" displayText="Tues" />
            <ui:checkbox id="upd_WED" name="upd_WED" displayText="Wed" />
            <ui:checkbox id="upd_THU" name="upd_THU" displayText="Thurs" />
            <ui:checkbox id="upd_FRI" name="upd_FRI" displayText="Fri" />
            <ui:checkbox id="upd_SAT" name="upd_SAT" displayText="Sat" />
          </ui:field-group>
          <ui:hidden-field name="DestinationReceivingDays" />
          <ui:textarea displayText="Comments" name="upd_TransportLaneXItemCommentText" required="true" />
        </ui:field-group>
      </ui:field-group>
      <ui:buttons>
        <ui:button displayText="Back to Search" id="cancel" validate="false" />
        <ui:button displayText="Save" id="save_upd" disabled="{count($root/*/_ERRORS) = 0 and count($root/_ERRORS) = 0}" onClick="javascript:valSave()" />
      </ui:buttons>
    </ui:step>
  </ui:container>
  <ui:script>
    function valChk(){	
	  //core_alert("in CHK!");
		
	  var chkNewEndDate = document.getElementsByName("chkEndDate");
	  var chkNewLoadingTime  = document.getElementsByName("chkLoadingTime");
		var chkNewchkUnloadingTime  = document.getElementsByName("chkUnloadingTime");
		var chkNewRplLotSize  = document.getElementsByName("chkRplLotSize");
	 	var chkNewRplLotSizeUOM  = document.getElementsByName("chkRplLotSizeUOM");
    <!-- MYANG RIC 249141 - Rounding value using for Single SKU Long Term Start -->
    var chkNewRplRndgVal = document.getElementsByName("chkRplRndgVal");
    <!-- MYANG RIC 249141 - Rounding value using for Single SKU Long Term End -->
    var chkNewLaneItemSts  = document.getElementsByName("chkLaneItemSts");    
    var chkNewSrcPrir  = document.getElementsByName("chkSrcPrir");
		var chkNewchkTrnsModePrir   = document.getElementsByName("chkTrnsModePrir");
   	var chkNewDestnDays  = document.getElementsByName("chkDestnDays");
    <!-- MYANG RIC 249141 - Rounding value using for Single SKU Long Term Start -->
    if(chkNewEndDate[0].checked ||  chkNewLoadingTime[0].checked || chkNewchkUnloadingTime[0].checked || 
		chkNewRplLotSize[0].checked||chkNewRplLotSizeUOM[0].checked || chkNewLaneItemSts[0].checked || 
		chkNewSrcPrir[0].checked || chkNewchkTrnsModePrir[0].checked|| chkNewDestnDays[0].checked ||
		chkNewRplRndgVal[0].checked)
    <!-- MYANG RIC 249141 - Rounding value using for Single SKU Long Term End -->
    {
				 i2uiToggleButtonState('save_upd', 'enabled');
			}		
		else{
		i2uiToggleButtonState('save_upd', 'disabled');
		}
		}

		
		

 function validateLdngTime() {
		var canSubmit = "false";
		var ldngTime = document.form.LoadingTime.value;		
		var ldngTimeDurn = ldngTime.split(":");
		var pattern = new RegExp(/([0-9]{1,2})([:]{1})([0-9]{2})([:]{1})([0-9]{2})/);
    		
		if(ldngTimeDurn[0].search(/\./) != -1 || ldngTimeDurn[0]  &lt; 0 || ldngTimeDurn[0].match(/\D/)){
		       core_alert("Loading time should be a positive integer!");
					 document.form.LoadingTime.focus();
		       canSubmit = "false";
					 return;		
		}				
		if(ldngTimeDurn[1]  &gt; 59){
		       core_alert("Minutes in Loading Time should not be greater than 59!");
		       document.form.LoadingTime.focus();
					 canSubmit = "false";
					 return;		
		}
		if( ldngTimeDurn[2] &gt; 59){
		       core_alert("Seconds  in Loading Time should not be greater than 59!");
		       document.form.LoadingTime.focus();
					 canSubmit = "false";
					 return;		
		}		
		if(ldngTimeDurn[0] &lt;=0 &amp;&amp; ldngTimeDurn[1] &lt;=0 &amp;&amp; ldngTimeDurn[2] &lt;=0){
		       core_alert("Invalid value entered for Loading Time. It should not be 00:00:00!");
		       document.form.LoadingTime.focus();
					 canSubmit = "false";
					 return;		
		}		
		else{
   		       canSubmit = "true";
		}
		return canSubmit;
	} 

 function validateUnldngTime() {
		var canSubmit = "false";
		var unldngTime = document.form.UnloadingTime.value;
		var unldngTimeDurn = unldngTime.split(":");		
				var pattern = new RegExp(/([0-9]{1,2})([:]{1})([0-9]{2})([:]{1})([0-9]{2})/);
		    		
				if(unldngTimeDurn[0].search(/\./) != -1 || unldngTimeDurn[0]  &lt; 0 || unldngTimeDurn[0].match(/\D/)){
				       core_alert("Unloading time should be a positive integer!");
							 document.form.UnloadingTime.focus();
				       canSubmit = "false";
							 return;		
				}				

		if(unldngTimeDurn[1]  &gt; 59){
		       core_alert("Minutes in Unloading Time should not be greater than 59!");
		       document.form.UnloadingTime.focus();
					 canSubmit = "false";
					 return;		
		}
		if( unldngTimeDurn[2] &gt; 59){
		       core_alert("Seconds in Unloading Time should not be greater than 59!");
		       document.form.UnloadingTime.focus();
					 canSubmit = "false";
					 return;		
		}		
	if(unldngTimeDurn[0] &lt;=0 &amp;&amp; unldngTimeDurn[1] &lt;=0 &amp;&amp; unldngTimeDurn[2] &lt;=0){
		       core_alert("Invalid value entered for Unloading Time. It should not be 00:00:00!");
		       document.form.UnloadingTime.focus();
					 canSubmit = "false";
					 return;		
		}		
		else{
   		       canSubmit = "true";
		}
		return canSubmit;
	} 
						
		function valSave(){
		var chkEndDate = document.getElementsByName("chkEndDate");
		var chkLoadTime = document.getElementsByName("chkLoadingTime");
		var chkUnLoadTime = document.getElementsByName("chkUnloadingTime");
		var chkRplLotSize = document.getElementsByName("chkRplLotSize");
    <!-- MYANG RIC 249141 - Rounding value using for Single SKU Long Term Start -->
    var chkRplRndg = document.getElementsByName("chkRplRndgVal");
    <!-- MYANG RIC 249141 - Rounding value using for Single SKU Long Term End -->
    var chkSrcPrir = document.getElementsByName("chkSrcPrir");
		var chkTrnsModePrir = document.getElementsByName("chkTrnsModePrir");			
		var chkLaneItemSts = document.getElementsByName("chkLaneItemSts");			
		var chkDestnDays = document.getElementsByName("chkDestnDays");		
		var chkRplLotSizeUOM = document.getElementsByName("chkRplLotSizeUOM");				

  	var chkEndDateVal = document.form.upd_EffectiveEndDate_DC.value;								
		var chkLoadTimeVal = document.form.LoadingTime.value;
		var chkUnloadTimeVal = document.form.UnloadingTime.value;
		var chkRplnLotSizeVal = document.form.ReplenishmentLotSize.value;
		var chkRplnLotSizeUOMVal = document.form.ReplenishmentLotSizeUnitOfMeasure.value;
    <!-- MYANG RIC 249141 - Rounding value using for Single SKU Long Term Start -->
    var chkRplRndgVal = document.form.ReplenishmentRoundingValue.value;
    <!-- MYANG RIC 249141 - Rounding value using for Single SKU Long Term End -->
    var chkLaneStsVal = document.form.TransportationLaneStatus.value;
		var chkSrcPrirVal = document.form.SourcingPriority.value;										
		var chkTransModePrirVal = document.form.TransportModePriority.value;			
		
		var chkComments = document.form.upd_TransportLaneXItemCommentText.value;	
		var canSave = "false";

		if(chkEndDate[0].checked || chkLoadTime[0].checked || chkUnLoadTime[0].checked || 
		chkRplLotSize[0].checked || chkSrcPrir[0].checked || chkTrnsModePrir[0].checked || 
		chkLaneItemSts[0].checked || chkDestnDays[0].checked || chkRplLotSizeUOM[0].checked ||
    <!-- MYANG RIC 249141 - Rounding value using for Single SKU Long Term Start -->
    chkRplRndg[0].checked)
    <!-- MYANG RIC 249141 - Rounding value using for Single SKU Long Term End -->
    {

		if(chkEndDate[0].checked &amp;&amp; chkEndDateVal.length == 0)
		{

		core_alert("Please enter the value for Lane Item End Date!");
				canSave = "false";
		}
		else{
						canSave = "true";
		}
				
		if(chkLoadTime[0].checked)
		{
					if(chkLoadTimeVal.length == 0){
		core_alert("Please enter the value for Loading Time!");
				canSave = "false";
				return;		
		}

		  if(!validateLdngTime()){

				canSave = "false";
				return;				

		}		

		}
		else{
						canSave = "true";
		}		

		if(chkUnLoadTime[0].checked)
		{
			if(chkUnloadTimeVal.length == 0){
		core_alert("Please enter the value for Unloading Time!");
				canSave = "false";
				return;				
		}

		if(!validateUnldngTime()){

				canSave = "false";

				return;				

		}				

		}
		else{
						canSave = "true";
		}		
		
		if(chkRplLotSize[0].checked &amp;&amp; chkRplnLotSizeVal.length == 0)
		{
		core_alert("Please enter the value for Replenishment Lot Size!");
				canSave = "false";
				return;				
		}
		else{
						canSave = "true";
		}
    <!--  MYANG RIC 203580 - Validation for focused fields when save START -->
    if(chkRplLotSize[0].checked &amp;&amp; chkRplnLotSizeVal.length &gt; 0)
		{
				var anum=/(^\d+$)|(^\d+\.\d+$)/;
				if (!anum.test(chkRplnLotSizeVal)) {
					core_alert("Please enter a positive value for Replenishment Lot Size!");
					canSave = "false";
					return;				
				}
		}
    <!--  MYANG RIC 203580 - Validation for focused fields when save END -->
    if(chkRplLotSizeUOM[0].checked &amp;&amp; chkRplnLotSizeUOMVal.length == 0)
		{
		core_alert("Please enter the value for Replenishment Lot Size UOM!");
				canSave = "false";
				return;				
		}
		else{
						canSave = "true";
		}
    <!-- MYANG RIC 249141 - Rounding value using for Single SKU Long Term Start -->
    if(chkRplRndg[0].checked &amp;&amp; chkRplRndgVal.length == 0)
		{
		core_alert("Please enter a positive value for Single SKU.");
				canSave = "false";
				return;				
		}
		else{
						canSave = "true";
		}
    
    if(chkRplRndg[0].checked &amp;&amp; chkRplRndgVal.length &gt; 0)
		{
				var anum=/(^\d+$)|(^\d+\.\d+$)/;
				if (!anum.test(chkRplRndgVal)) {
					core_alert("Please enter a positive value for Single SKU.");
					canSave = "false";
					return;				
				}
		}
    <!-- MYANG RIC 249141 - Rounding value using for Single SKU Long Term End -->
    if(chkSrcPrir[0].checked &amp;&amp; chkSrcPrirVal.length == 0)
		{
		core_alert("Please enter the Sourcing priority !");
				canSave = "false";
				return;				
		}
		else{
						canSave = "true";
		}		
		
		if(chkTrnsModePrir[0].checked &amp;&amp; chkTransModePrirVal.length == 0)
		{
		core_alert("Please enter the Transport Mode priority!");
				canSave = "false";
				return;		
		}
		else{
						canSave = "true";
		}		
		
		if(chkLaneItemSts[0].checked &amp;&amp; chkLaneStsVal.length == 0)
		{
		core_alert("Please enter the Lane Status!");
				canSave = "false";
				return;		
		}
		else{
						canSave = "true";
		}															
		if(trimString(chkComments).length == 0){
		core_alert("Please enter comments before saving!");
				canSave = "false";
				return;				
		}		
		else{
						canSave = "true";
		}					          		
		if(trimString(chkComments).length &gt; 255){
		core_alert("Comments should not be greater than 255 characters!");
				canSave = "false";
				return;				
		}		
		else{
						canSave = "true";
		}						          		
		if(chkDestnDays[0].checked){
						formDestnRcvngDay();
		}				
    }		
		else{
		core_alert("Please enter value for at least one field and proceed!");
		canSave = "false";
		}
		if(canSave == "false"){
		}
		else{
							document.form.BUTTON_ID.value = 'save_upd'; 
							document.form.action = 'view.x2ps';
							document.form.submit();  		
        }		
		}
    function formDestnRcvngDay(){
	  var sun =document.getElementsByName( 'upd_SUN' );		
		var mon = document.getElementsByName( 'upd_MON' );
		var tue = document.getElementsByName( 'upd_TUE' );
		var wed = document.getElementsByName( 'upd_WED' );
		var thu = document.getElementsByName( 'upd_THU' );
		var fri = document.getElementsByName( 'upd_FRI' );
		var sat = document.getElementsByName( 'upd_SAT' );
		var destnRcvngDay;
		if(sun[0].checked)								
		    destnRcvngDay = 1;
		else
		    destnRcvngDay = 0;
		if(mon[0].checked)								
				destnRcvngDay += '' + 1;
		else
		    destnRcvngDay +='' + 0;
		if(tue[0].checked)								
		    destnRcvngDay +='' + 1;
		else
		    destnRcvngDay +='' + 0;
		if(wed[0].checked)								
		    destnRcvngDay += '' + 1;
		else
		    destnRcvngDay += '' + 0;
		if(thu[0].checked)								
		    destnRcvngDay += '' + 1;
		else
		    destnRcvngDay += '' + 0;
		if(fri[0].checked)								
		    destnRcvngDay += '' + 1;
		else
		    destnRcvngDay += '' + 0;
		if(sat[0].checked)								
		    destnRcvngDay += '' + 1;
		else
		    destnRcvngDay += '' + 0;	
		document.form.DestinationReceivingDays.value = destnRcvngDay;		
		}
  </ui:script>
</ui:page-group>

