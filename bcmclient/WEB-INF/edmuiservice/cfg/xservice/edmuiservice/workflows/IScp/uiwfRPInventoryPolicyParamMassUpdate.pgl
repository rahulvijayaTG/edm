<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="uiWfRPInventoryPolicyParamMassUPdate.pgl">
  <ui:container id="topContainer">
    <ui:step id="c1" displayText="RP Inventory Parameters" editable="true">
      <ui:validation successMessage="{$root/SUCCESSMSG/MSG/@Value}" anyFieldIsRequired="false" />
      <ui:table displayText="RP Inventory Policy Parameters" rowSrc="$root/INV_POLICY_DETAILS_LIST/INV_POLICY_DETAILS">
        <ui:field-group>
          <ui:display-field name="SegmentNumber" id="SegmentNumber" displayText="Segment" editable="false" />
          <ui:display-field name="ItemIdentificationValue" id="ItemIdentificationValue" displayText="Item" sortable="false" />
          <ui:display-field name="ItemDescription" id="ItemDescription" displayText="Item Desc" sortable="false" editable="false" />
          <ui:display-field name="ItemType" id="ItemType" displayText="Material Type" sortable="false" editable="false" />
          <ui:display-field name="LocationIdentificationValue" id="LocationIdentificationValue" displayText="Location" sortable="false" />
          <ui:display-field name="LocationDescription" id="LocationDescription" displayText="Location Desc" sortable="false" editable="false" />
          <ui:display-field name="LocationType" id="LocationType" displayText="Location Type" sortable="false" editable="false" />
          <ui:display-field name="MaximumCoverageDaysNumber" id="MaximumCoverageDaysNumber" displayText="Max Coverage Days" sortable="false" />
          <ui:display-field name="ReplenishmentBandProfile" id="ReplenishmentBandProfile" displayText="Max Inv Bands" sortable="false" optionSrc="$root/BAND_PROFILES/ID" value="{ReplenishmentBandProfile/@Value}" />
          <ui:display-field name="DeploymentPolicy" id="DeploymentPolicy" displayText="Deployment Policy" sortable="false" optionSrc="$root/DEPLOYMENT_POLICY/ID" value="{DeploymentPolicy/@Value}" />
          <ui:display-field name="EffectiveStartDate" id="EffectiveStartDate" displayText="Effective Start Date" sortable="false" editable="true" />
          <ui:display-field name="EffectiveEndDate" id="EffectiveEndDate" displayText="Effective End Date" sortable="false" editable="true" />
          <ui:display-field name="MaximumCoverageDaysCommentText" id="MaximumCoverageDaysCommentText" displayText="Max Coverage Days Comment" sortable="false" />
          <ui:display-field name="ReplenishmentBandProfileCommentText" id="ReplenishmentBandProfileCommentText" displayText="Replenishment BandProfile Comment" sortable="false" />
          <ui:display-field name="DeploymentPolicyCommentText" id="DeploymentPolicyCommentText" displayText="Deployment Policy Comment" sortable="false" />
          <ui:display-field name="LAST_MODIFIED_BY" id="LAST_MODIFIED_BY" displayText="Modified By" sortable="false" editable="false" />
          <ui:display-field name="LAST_MODIFIED_DATE" id="LAST_MODIFIED_DATE" displayText="Last Modified" sortable="false" editable="false" />
        </ui:field-group>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:container id="bottomContainer" displayText="Mass Update">
    <ui:step id="c1" displayText="" editable="true">
      <ui:validation />
      <ui:table displayText="Updateable Parameters" rowSrc="$root/PARAMETER_NAMES/PARAMETER_NAME" postRowIdAs="SelectedParameterName" rowId="paramName" exportable="false" selectable="All" scrollable="true" id="MassUpdate">
        <ui:field-group>
          <ui:display-field displayText="Parameter Name" name="ParameterName" id="ParameterName" />
          <ui:hidden-field name="paramName" id="paramName" />
          <ui:choose-field name="ParameterValue" displayText="Parameter Value">
            <ui:when test="DROPDOWN/@Value = 'true'">
              <ui:dropdown id="PARAMVAL" name="PARAMVAL" optionSrc="ID" />
            </ui:when>
            <ui:otherwise>
              <ui:entry-field name="PARAMVAL" required="false" value="{$root/PARAM_DETAILS_LIST/PARAM_DETAILS/PARAMVAL/@Value}" />
            </ui:otherwise>
          </ui:choose-field>
          <ui:textarea name="Comments" displayText="Comments" required="true" />
        </ui:field-group>
        <ui:buttons>
          <ui:button displayText="Save" id="Save" name="Save" enabledBySelections="true" onClick="javaScript:checkComments('MassUpdate')" emphasized="true" />
          <ui:button displayText="Cancel" id="Cancel" name="Cancel" enabledBySelections="false" emphasized="true" />
        </ui:buttons>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:script>function checkComments(tableid)
		{
	
		var table = document.getElementById(tableid+"_data");
		var count=0,j;
		var a=document.getElementsByName('SelectedParameterName');
					
		for( k=0; k &lt;a.length;k++)
		{
		
		if(a[k].checked)
		{
//	alert(k);

			for(var j=0;j&lt; table.rows[k].cells.length;j++)
		{
		//alert(table.rows[k].cells[j].childNodes[0].value);
	
		if(table.rows[k].cells[j].childNodes[0].tagName =="TEXTAREA" &amp;&amp; (table.rows[k].cells[j].childNodes[0].value=="" || table.rows[k].cells[j].childNodes[0].value==null))
		{

		core_alert("Enter Comments for  "+table.rows[k].cells[0].childNodes[0].value);
		return;
		}
		}
		}
		}
				 document.form.BUTTON_ID.value="Save";

                document.form.submit();
		}</ui:script>
</ui:page-group>

