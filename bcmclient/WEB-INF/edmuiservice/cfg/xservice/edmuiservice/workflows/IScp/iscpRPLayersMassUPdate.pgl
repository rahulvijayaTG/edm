<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="iscpRPLayersMassUPdate.pgl">
  <ui:container id="topContainer">
    <ui:step id="c1" displayText="" editable="true">
      <ui:table displayText="" rowSrc="$root/LAYER_DETAILS_LIST/LAYER_DETAILS" collapsable="true" totalRowCount="$root/ROWCOUNT/@Value" exportable="true" configurable="false" displayCondition="{$root/ShowMassUpdateTable/@Value='YES'}">
        <ui:field-group>
          <ui:display-field displayText="Engine ID" name="EngineId" editable="false" />
          <ui:hidden-field name="EngineIdLayerNameCombo" />
          <ui:hidden-field name="SourceSystemMnemonicValue" />
          <ui:display-field displayText="Layer Name" name="DemandCategoryName" editable="false" />
          <ui:hidden-field displayText="Analytical Model Name" name="AnalyticalModelName" editable="false" />
          <ui:display-field displayText="Allocation Band" name="AllocationBandText" />
          <ui:display-field displayText="Effective Start Day" name="LayerEffectiveStartDayNumber" type="Number" />
          <ui:display-field displayText="Effective End Day" name="LayerEffectiveEndDayNumber" type="Number" />
          <ui:display-field displayText="Demand Type" name="DemandType" />
          <ui:display-field id="DemandCategoryPriorityNumber" name="DemandCategoryPriorityNumber" displayText="Priority" type="Number" />
          <ui:display-field displayText="Allocation Band Comments" name="AllocationBandTextCommentText" />
          <ui:display-field displayText="Demand Type Comments" name="DemandCategoryClassCommentText" />
          <ui:display-field displayText="Effective Start Day Comments" name="LayerEffectiveStartDayComment" />
          <ui:display-field displayText="Effective End Day Comments" name="LayerEffectiveEndDayComment" />
          <ui:display-field displayText="Priority Comments" name="DemandPriorityNumberComment" />
          <!--  <ui:display-field id="ModifiedBy" name="ModifiedBy" displayText="Modified By" sortable="true"/>
          <ui:display-field id="LAST_MODIFIED_DATE" name="LAST_MODIFIED_DATE" displayText="Last Modified" sortable="true"/>-->
        </ui:field-group>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:container id="bottomContainer" displayText="Mass Update">
    <ui:step id="c1" displayText="" editable="true">
      <ui:validation successMessage="{$root/SUCCESSMSG/MSG/@Value}" anyFieldIsRequired="true" />
      <ui:table displayText="Updatable Parameters" rowSrc="$root/PARAMETER_NAMES/PARAMETER_NAME" postRowIdAs="SelectedParameterName" rowId="paramName" exportable="false" selectable="All" scrollable="true" id="MassUpdate">
        <ui:field-group>
          <ui:display-field displayText="Parameter Name" name="ParameterName" id="ParameterName" />
          <ui:hidden-field name="paramNamedummy" id="paramNamedummy" />
          <ui:hidden-field name="paramName" id="paramName" />
          <ui:hidden-field name="CommentTag" />
          <ui:choose-field name="ParameterValue" displayText="Parameter Value">
            <ui:when test="DROPDOWN/@Value = 'true'">
              <ui:dropdown name="PARAMVAL" size="1" optionSrc="$root/DemandType/ID" value="{ParamVal/@Value}" />
            </ui:when>
            <ui:otherwise>
              <ui:entry-field name="PARAMVAL" required="false" value="{ParamVal/@Value}" />
            </ui:otherwise>
          </ui:choose-field>
          <ui:textarea name="CommentsVal" displayText="Comments" required="false" value="{CommentsVal/@Value}" />
        </ui:field-group>
        <ui:buttons>
          <ui:button displayText="Save" id="Save" name="Save" enabledBySelections="true" onClick="javaScript:checkComments('MassUpdate')" />
          <!-- RIC: 240988 Praneeth - Cancel button wording changes request - Start -->
          <ui:button displayText="Back to Search" id="MassUpdateCancel" name="MassUpdateCancel" enabledBySelections="false" />
          <!-- RIC: 240988 Praneeth - Cancel button wording changes request - End -->
        </ui:buttons>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:script>
    function checkComments(tableid)
		{
		var table = document.getElementById(tableid+"_data");
		var count=0,j;
		var a=document.getElementsByName('SelectedParameterName');
		var paramName=document.getElementsByName('ParameterName');
    <!-- MYANG RIC 241481 - RP Layer Mass Update doesn't work when SELECT ALL START -->
    var anum=/(^\d+$)|(^\d+\.\d+$)/;
		// check for numberic fields 
		for( k=0; k &lt;a.length;k++) {
			if(a[k].checked) {
				if (table.rows[k].cells[0].childNodes[0].value == "LayerEffectiveStartDayValue") {
					if (!anum.test(table.rows[k].cells[2].childNodes[0].value)) {
						core_alert("Please enter a positive value for Effective Start Day.");
		        return;
					}
				}	
				if (table.rows[k].cells[0].childNodes[0].value == "LayerEffectiveEndDayValue") {
					if (!anum.test(table.rows[k].cells[2].childNodes[0].value)) {
						core_alert("Please enter a positive value for Effective End Day.");
		        return;
					}
				}	
				if (	table.rows[k].cells[0].childNodes[0].value == "PriorityValue") {
					if (!anum.test(table.rows[k].cells[2].childNodes[0].value)) {
						core_alert("Please enter a positive value for Priority.");
		        return;
					}
				}	
			}
		}
    <!-- MYANG RIC 241481 - RP Layer Mass Update doesn't work when SELECT ALL END -->
    for( k=0; k &lt;a.length;k++)
		{
		
		if(a[k].checked)
		{

			for(var j=0;j&lt; table.rows[k].cells.length;j++)
		{
		//alert("row=" + k + " cells=" + j + " value=" + table.rows[k].cells[j].childNodes[0].value);
		if(table.rows[k].cells[j].childNodes[0].tagName =="TEXTAREA" &amp;&amp; (table.rows[k].cells[j].childNodes[0].value=="" || table.rows[k].cells[j].childNodes[0].value==null))
		{
		
		core_alert("Enter Comments for  "+table.rows[k].cells[1].innerHTML);
		return;
		}
		} //for(var j=0
		} //if(a[k].checked)
		} //for( k=0; 
	
					 
				document.form.BUTTON_ID.value="Save";
				document.form.submit();
		}
  </ui:script>
</ui:page-group>

