                  <!-- <ui:url page="view.x2ps">
                <FIELD_NAME select="'LocationIdentificationValue'"/>
                <SELECTABLE select="'All'"/>
                <BUTTON_ID select="'selectLocation'"/>
              </ui:url>-->
                </ui:link>
              </ui:links>
            </ui:entry-field>
            <!--<ui:entry-field id="SRCH_MOD_BY" name="SRCH_MOD_BY" displayText="Modified By" rowSpan="2"/>-->
            <ui:entry-field name="SRCH_MOD_BY" displayText="Modified By">
              <ui:links>
                <ui:link displayText="Select Users" targetType="popup" targetName="catalogPopup">
                  <ui:url page="view.x2ps">
                    <SELECTABLE select="'All'" />
                    <BUTTON_ID select="'Select_User'" />
                    <FIELD_NAME select="'SRCH_MOD_BY'" />
                  </ui:url>
                  <ui:image src="pop_up_window.gif" />
                </ui:link>
              </ui:links>
            </ui:entry-field>
          </ui:field-group>
          <ui:field-group>
            <ui:entry-field displayText="Item Description" name="ITEMDESC" />
            <ui:entry-field displayText="Item Number" name="Item_Number" id="Item_Number">
              <ui:links>
                <ui:link displayText="Select Item" onClick="javascript:selectItem()">
                  <ui:image src="pop_up_window.gif" />
                  <!--  <ui:url page="view.x2ps">
                <FIELD_NAME select="'ItemIdentificationValue'"/>
                <SELECTABLE select="'All'"/>
                <BUTTON_ID select="'selectItem'"/>
              </ui:url>-->
                </ui:link>
              </ui:links>
            </ui:entry-field>
            <!-- <ui:entry-field displayText="GTIN #" name="GTIN" id="GTIN">
              <ui:links>
                <ui:link displayText="Select GTIN" targetType="popup" targetName="planPopUp">
                  <ui:image src="pop_up_window.gif"/>
                  <ui:url page="view.x2ps">
                    <FIELD_NAME select="'GTIN'"/>
                  
                    <SELECTABLE select="'All'"/>
                    <BUTTON_ID select="'SelectGTIN'"/>
                  </ui:url>
                </ui:link>
              </ui:links>
            </ui:entry-field>-->
            <ui:dropdown id="MATTYPE" name="MATTYPE" displayText="Material Type" selectAll="true" optionSrc="$root/ItemTypeList/*" />
          </ui:field-group>
          <ui:field-group id="dateRange" select="$root">
            <ui:hidden-field name="pgRowCount" id="pgRowCount" value="{$root/pgRowCount/@Value}" />
            <!--          <ui:date-range displayText="Modified Date" name="SRCH_MOD_DATE" fromDate="$root/FROM_DATE/@Value" toDate="$root/TO_DATE/@Value"/>-->
            <ui:date-range name="SRCH_MOD_DATE" displayText="Modified Date Range" fromDate="{FROM_SRCH_MOD_DATE/@Value}" toDate="{TO_SRCH_MOD_DATE/@Value}" />
          </ui:field-group>
        </ui:field-group>
      </ui:search>
      <ui:table displayText="Search Results" rowSrc="$root/INV_POLICY_DETAILS_LIST/INV_POLICY_DETAILS" totalRowCount="$root/ROWCOUNT/@Value" maxRows="10" selectable="All" rowId="ItemLocCombo" postRowIdAs="SelectedItemLoc" id="InvPolicyDetails" doPaging="true" exportable="true" freeze="3" startAtRow="$root/STARTROWCOUNT/@Value" rememberSelections="true">
        <ui:validation successMessage="{$root/SUCCESSMSG/MSG/@Value}" anyFieldIsRequired="false" />
        <ui:field-group>
          <ui:hidden-field name="ItemLocCombo" />
          <ui:hidden-field name="ItemUnitOfMeasureValue" id="ItemUnitOfMeasureValue" />
          <ui:entry-field name="SegmentNumber" id="SegmentNumber" displayText="Segment" editable="false" sortable="true" />
          <ui:entry-field name="LocationIdentificationValue" id="LocationIdentificationValue" displayText="Location Number" editable="false" sortable="true" />
          <ui:entry-field name="ItemIdentificationValue" id="ItemIdentificationValue" displayText="Item Number" editable="false" sortable="true" />
          <ui:entry-field name="ItemDescription" id="ItemDescription" displayText="Item Description" sortable="false" editable="false" />
          <ui:entry-field name="ItemType" id="ItemType" displayText="Material Type" sortable="false" editable="false" />
          <ui:entry-field name="PartyDescription" id="PartyDescription" displayText="Segment Description" editable="false" sortable="false" />
          <ui:entry-field name="LocationType" id="LocationType" displayText="Location Type" sortable="false" editable="false" />
          <ui:entry-field name="LocationDescription" id="LocationDescription" displayText="Location Description" sortable="false" editable="false" />
          <!--  <ui:entry-field name="GTIN" id="GTIN" displayText="GTIN #" sortable="false" editable="false"/>-->
          <ui:choose-field id="MaximumCoverageDaysNumber" displayText="Max Coverage Days">
            <ui:when test="contains($root/AccessLevel/@Value,'Update') or contains($root/AccessLevel/@Value,'Add')">
              <ui:entry-field name="MaximumCoverageDaysNumber" id="MaximumCoverageDaysNumber" displayText="Max Coverage Days" sortable="false" dataType="Number" minValue="0" />
            </ui:when>
            <ui:otherwise>
              <ui:display-field displayText="Max Coverage Days " name="MaximumCoverageDaysNumber" />
            </ui:otherwise>
          </ui:choose-field>
          <ui:hidden-field name="MaximumCoverageDaysNumber_Hidden" id="MaximumCoverageDaysNumber_Hidden" />
          <ui:choose-field id="ReplenishmentBandProfile" displayText="Max Inventory Bands">
            <ui:when test="contains($root/AccessLevel/@Value,'Update') or contains($root/AccessLevel/@Value,'Add')">
              <ui:dropdown name="ReplenishmentBandProfile" id="ReplenishmentBandProfile" displayText="Max Inventory Bands" sortable="false" optionSrc="$root/BAND_PROFILES/ID" value="{ReplenishmentBandProfile/@Value}" />
            </ui:when>
            <ui:otherwise>
              <ui:display-field displayText="Max Inventory Bands " name="ReplenishmentBandProfile" />
            </ui:otherwise>
          </ui:choose-field>
          <ui:hidden-field name="ReplenishmentBandProfile_Hidden" id="ReplenishmentBandProfile_Hidden" />
          <ui:choose-field id="DeploymentPolicy" displayText="Deployment Policy">
            <ui:when test="contains($root/AccessLevel/@Value,'Update') or contains($root/AccessLevel/@Value,'Add')">
              <ui:dropdown name="DeploymentPolicy" id="DeploymentPolicy" displayText="Deployment Policy" sortable="false" optionSrc="$root/DEPLOYMENT_POLICY/ID" value="{DeploymentPolicy/@Value}" />
            </ui:when>
            <ui:otherwise>
              <ui:display-field displayText="Deployment Policy " name="DeploymentPolicy" />
            </ui:otherwise>
          </ui:choose-field>
          <ui:hidden-field name="DeploymentPolicy_Hidden" id="DeploymentPolicy_Hidden" />
          <ui:entry-field name="EffectiveStartDate" id="EffectiveStartDate" displayText="Effective Start Date" sortable="false" editable="false" />
          <ui:choose-field id="EffectiveEndDate" displayText="Effective End Date">
            <ui:when test="contains($root/AccessLevel/@Value,'Update') or contains($root/AccessLevel/@Value,'Add')">
              <ui:entry-field name="EffectiveEndDate" id="EffectiveEndDate" displayText="Effective End Date" sortable="false" editable="true" />
            </ui:when>
            <ui:otherwise>
              <ui:display-field displayText="Effective End Date " name="EffectiveEndDate" />
            </ui:otherwise>
          </ui:choose-field>
          <ui:hidden-field name="EffectiveEndDate_Hidden" id="EffectiveEndDate_Hidden" />
          <ui:choose-field id="MaximumCoverageDaysCommentText" displayText="Max Coverage Days Comments">
            <ui:when test="contains($root/AccessLevel/@Value,'Update') or contains($root/AccessLevel/@Value,'Add')">
              <ui:textarea name="MaximumCoverageDaysCommentText" id="MaximumCoverageDaysCommentText" displayText="Max Coverage Days Comments" sortable="false" />
            </ui:when>
            <ui:otherwise>
              <ui:textarea displayText="Max Coverage Days Comments " name="MaximumCoverageDaysCommentText" editable="false" />
            </ui:otherwise>
          </ui:choose-field>
          <ui:hidden-field name="MaximumCoverageDaysCommentText_Hidden" id="MaximumCoverageDaysCommentText_Hidden" />
          <ui:choose-field id="ReplenishmentBandProfileCommentText" displayText="Max Inventory Bands Comments">
            <ui:when test="contains($root/AccessLevel/@Value,'Update') or contains($root/AccessLevel/@Value,'Add')">
              <ui:textarea name="ReplenishmentBandProfileCommentText" id="ReplenishmentBandProfileCommentText" displayText="Max Inventory Bands Comments" sortable="false" />
            </ui:when>
            <ui:otherwise>
              <ui:textarea displayText="Max Inventory Bands Comments " name="ReplenishmentBandProfileCommentText" editable="false" />
            </ui:otherwise>
          </ui:choose-field>
          <ui:hidden-field name="ReplenishmentBandProfileCommentText_Hidden" id="ReplenishmentBandProfileCommentText_Hidden" />
          <ui:choose-field id="DeploymentPolicyCommentText" displayText="Deployment Policy Comments">
            <ui:when test="contains($root/AccessLevel/@Value,'Update') or contains($root/AccessLevel/@Value,'Add')">
              <ui:textarea name="DeploymentPolicyCommentText" id="DeploymentPolicyCommentText" displayText="Deployment Policy Comments" sortable="false" />
            </ui:when>
            <ui:otherwise>
              <ui:textarea displayText="Deployment Policy " name="DeploymentPolicyCommentText" editable="false" />
            </ui:otherwise>
          </ui:choose-field>
          <ui:hidden-field name="DeploymentPolicyCommentText_Hidden" id="DeploymentPolicyCommentText_Hidden" />
          <ui:entry-field name="LAST_MODIFIED_BY" id="LAST_MODIFIED_BY" displayText="Modified By" editable="false" sortable="true" />
          <ui:entry-field name="LAST_MODIFIED_DATE" id="LAST_MODIFIED_DATE" displayText="Date Modified" editable="false" sortable="true" />
          <ui:hidden-field name="SourceSystemMnemonicValue" id="SourceSystemMnemonicValue" />
          <ui:hidden-field name="ItemIdentifier" id="ItemIdentifier" />
          <ui:hidden-field name="LocationIdentifier" id="LocationIdentifier" />
          <ui:hidden-field name="LocationXItemSequenceNumber" id="LocationXItemSequenceNumber" />
          <ui:hidden-field name="LocationXItemReplenishmentParameterSequenceNumber" id="LocationXItemReplenishmentParameterSequenceNumber" />
        </ui:field-group>
        <ui:buttons id="tableButtons">
          <ui:button displayText="Delete" id="Delete" name="Delete" enabledBySelections="true" displayCondition="{contains($root/AccessLevel/@Value,'Remove')}" onClick="javaScript:on_delete('InvPolicyDetails')" />
          <ui:divider />
          <ui:button displayText="Mass Update" id="MassUpdate" name="MassUpdate" enabledBySelections="true" displayCondition="{contains($root/AccessLevel/@Value,'Update')}" onClick="javaScript:checkMassupdate('InvPolicyDetails')" />
          <ui:divider />
          <ui:button displayText="Copy" id="copy" name="copy" enabledBySelections="true" onClick="javaScript:checkCopy('InvPolicyDetails')" displayCondition="{contains($root/AccessLevel/@Value,'Add')}" />
          <ui:divider />
          <ui:button displayText="Create" id="create" name="create" enabledBySelections="false" displayCondition="{contains($root/AccessLevel/@Value,'Add')}" />
          <ui:divider />
          <ui:button displayText="Save" id="Save" name="Save" enabledBySelections="true" displayCondition="{contains($root/AccessLevel/@Value,'Update')}" onClick="javaScript:checkCommentsOnSave('InvPolicyDetails')" />
        </ui:buttons>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:script>
    function checkCopy(tableid)
		{

		var table = document.getElementById(tableid+"_data");
		var count=0,j;
		var a=document.getElementsByName('SelectedItemLoc');
										//alert(a);
		for( k=0; k &lt;a.length;k++)
		{
		
		if(a[k].checked)
		{
		count++;
		}
		}

		if(count&gt;=2){
		core_alert('Copy One Record at a time');
		}else{

				 document.form.BUTTON_ID.value="copy";

                document.form.submit();
		}
		}
		
		//
		
		function checkCommentsOnSave(tableid)
		{
		
		var a=document.getElementsByName('SelectedItemLoc');
var PrevMaxCvgDays = document.getElementsByName('MaximumCoverageDaysNumber');
var CurrentMaxCvgDays = document.getElementsByName('MaximumCoverageDaysNumber_Hidden');
var PrevMaxCvgDaysComments = document.getElementsByName('MaximumCoverageDaysCommentText');
var CurrentMaxCvgDaysComments = document.getElementsByName('MaximumCoverageDaysCommentText_Hidden');
//alert(a);
var PrevBandPrflVal = document.getElementsByName('ReplenishmentBandProfile');
var CurrentBandPrflVal = document.getElementsByName('ReplenishmentBandProfile_Hidden');
var PrevBandPrflComments = document.getElementsByName('ReplenishmentBandProfileCommentText');
var CurrentBandPrflComments = document.getElementsByName('ReplenishmentBandProfileCommentText_Hidden');
//
var PrevDeployPlcyVal = document.getElementsByName('DeploymentPolicy');
var CurrentDeployPlcyVal = document.getElementsByName('DeploymentPolicy_Hidden');
var PrevDeployPlcyComments = document.getElementsByName('DeploymentPolicyCommentText');
var CurrentDeployPlcyComments = document.getElementsByName('DeploymentPolicyCommentText_Hidden');

//

		for( k=0; k &lt;a.length;k++)
		{
		
		if(a[k].checked)
		{


		
		 if((PrevBandPrflVal[k].value != CurrentBandPrflVal[k].value) &amp;&amp;
		(trimString(PrevBandPrflComments[k].value) ==CurrentBandPrflComments[k].value)){
     core_alert("Please enter new comments for Inv. Bands update");

       return;
     
     }

if((PrevMaxCvgDays[k].value != CurrentMaxCvgDays[k].value) 
		&amp;&amp;(trimString(PrevMaxCvgDaysComments[k].value) ==CurrentMaxCvgDaysComments[k].value)){
core_alert("Please enter new comments for Max Coverage days update");

 return;

     }
		
	    
     if((PrevDeployPlcyVal[k].value != CurrentDeployPlcyVal[k].value) 
		&amp;&amp;(trimString(PrevDeployPlcyComments[k].value) ==CurrentDeployPlcyComments[k].value)){
     core_alert("Please enter new comments for  Deploy Policy update");

       return;
     
     }
		
		  if( PrevBandPrflVal[k].value == CurrentBandPrflVal[k].value &amp;&amp;
		(PrevBandPrflComments[k].value !=CurrentBandPrflComments[k].value)  ){
     core_alert("Please edit  inventory bands before editing the comment");
  
       return;
     
     }
		  if(PrevMaxCvgDays[k].value == CurrentMaxCvgDays[k].value &amp;&amp; 
		(PrevMaxCvgDaysComments[k].value !=CurrentMaxCvgDaysComments[k].value) ){
     core_alert("Please edit max coverage days  before editing the comment");
  
       return;
     
     }
				  if( PrevDeployPlcyVal[k].value == CurrentDeployPlcyVal[k].value 
		 &amp;&amp;(PrevDeployPlcyComments[k].value !=CurrentDeployPlcyComments[k].value) ){
     core_alert("Please edit deployment policy before editing the comment");
  
       return;
     
     }
     
		
		}
		}
		document.form.BUTTON_ID.value="Save";

                document.form.submit();
		}
		
		
		function on_delete(){
		var canSubmit='false';
		var response = core_confirm('Are you sure you want to delete the selected record(s)?');
    <!--if ( response == 'no' ) {
						canSubmit = 'false';
					} else {
						canSubmit = 'true';
					}-->
    if (response == 'yes') {
							document.form.BUTTON_ID.value = 'Delete'; 
							document.form.submit();
					}
					else{
						return;
					}

		}
    <!--*********************Loc Popup js ******************-->
    function selectlocation(){
		var LocationIdentificationValue=document.form.LOC_NUM.value;
		var locdesc= document.form.ITEMDESC.value;
		var loctype = document.form.LOCTYPE.value;
		var Item = document.form.Item_Number.value;
		//alert(LocationIdentificationValue);
	//	alert(loctype);
		var a = document.getElementById('PartyIdentificationValue');
		var segment = '';
		//alert(a.length);
 		for( k=0; k &lt;a.length;k++)
		{
if(a[k].selected)
		{
		if(segment != '')
		{
		segment = segment + ',';
		}
		segment = segment + a[k].value;
		
		}
		}
		//alert(segment);
			window.open('view.x2ps?SERVICE_NAME=edmuiservice&amp;START_WORKFLOW=wfTLSelectLocation&amp;SOURCE=RP&amp;FIELD_NAME=LOC_NUM&amp;SELECTABLE=All&amp;POPUP=true&amp;SRCH_LOC_ID='+LocationIdentificationValue+'&amp;SRCH_SGMNT_ID='+segment+'&amp;SRCH_LOC_TYPE='+loctype+'&amp;SRCH_LOC_DESC='+locdesc+'&amp;SRCH_ITEM_ID='+Item,null,'height=480,width=740,screenX=400,screenY=400,top=200,left=250,toolbar=yes,menubar=no');
    <!--	window.open('view.x2ps?SERVICE_NAME=edmuiservice&amp;START_WORKFLOW=wfPiSelecLocation&amp;FIELD_NAME=LocationIdentification&amp;SELECTABLE=All&amp;POPUP=true&amp;GroupIdentifier='+groupidentifier+'&amp;GroupLineInfo='+linenumbers,null,'height=480,width=740,screenX=400,screenY=400,top=200,left=250,toolbar=yes,menubar=no');-->
    }
		
		function selectItem(){
		var LocationIdentificationValue=document.form.LOC_NUM.value;
		var Itemdesc= document.form.ITEMDESC.value;
    <!--		var gtin = document.form.UniformCodeCouncilNumberValue.value;-->
    var Item = document.form.Item_Number.value;
		var ItemType = document.form.MATTYPE.value;
		var a = document.getElementById('PartyIdentificationValue');
		var segment = '';
 		for( k=0; k &lt;a.length;k++)
		{
if(a[k].selected)
		{
		if(segment != '')
		{
		segment = segment + ',';
		}
		segment = segment + a[k].value;
		
		}
		}
			window.open('view.x2ps?SERVICE_NAME=edmuiservice&amp;START_WORKFLOW=wfTLSelectItem&amp;SOURCE=RP&amp;FIELD_NAME=Item_Number&amp;SELECTABLE=All&amp;POPUP=true&amp;SRCH_LOC_ID='+LocationIdentificationValue+'&amp;SRCH_SGMNT_ID='+segment+'&amp;SRCH_ITEM_TYPE='+ItemType+'&amp;SRCH_ITEM_DESC='+Itemdesc+'&amp;SRCH_ITEM_ID='+Item,null,'height=480,width=740,screenX=400,screenY=400,top=200,left=250,toolbar=yes,menubar=no');
    <!--	window.open('view.x2ps?SERVICE_NAME=edmuiservice&amp;START_WORKFLOW=wfPiSelecLocation&amp;FIELD_NAME=LocationIdentification&amp;SELECTABLE=All&amp;POPUP=true&amp;GroupIdentifier='+groupidentifier+'&amp;GroupLineInfo='+linenumbers,null,'height=480,width=740,screenX=400,screenY=400,top=200,left=250,toolbar=yes,menubar=no');-->
    }
		
		function onSearch(){
    
	var LocationIdentificationValue=document.form.LOC_NUM.value;
	var locdesc= document.form.LOCDESC.value;
	var loctype = document.form.LOCTYPE.value;
	
	var Itemdesc= document.form.ITEMDESC.value;
	var Item = document.form.Item_Number.value;
	var ItemType = document.form.MATTYPE.value;
	var ModifiedBy= document.form.SRCH_MOD_BY.value;

	var FromSrchDate = document.form.FROM_SRCH_MOD_DATE_DC.value;
	var ToSrchDate = document.form.TO_SRCH_MOD_DATE_DC.value;
    
    var a = document.getElementById('PartyIdentificationValue');
    var segment = '';
     		for( k=0; k &lt;a.length;k++)
    		{
    if(a[k].selected)
    		{
    		if(segment != '')
    		{
    		segment = segment + ',';
    		}
    		segment = segment + a[k].value;
    		
    		}
		}
	/*alert("locidn"+LocationIdentificationValue);
alert("locdesc"+locdesc);
alert("loctype"+loctype);
alert("Itemdesc"+Itemdesc);
alert("Item"+Item);
alert("ItemType"+ItemType);
alert("ModifiedBy"+ModifiedBy);
alert("FromSrchDate"+FromSrchDate);
alert("ToSrchDate"+ToSrchDate);
alert("segment"+segment+"HI");*/
	

						var	canSubmit = 'true';
		if (LocationIdentificationValue=='' 	&amp;&amp; locdesc=='' 		&amp;&amp; loctype=='' 		&amp;&amp; Itemdesc=='' 		&amp;&amp; Item=='' 		&amp;&amp; ItemType=='' 		&amp;&amp; ModifiedBy=='' 		&amp;&amp; FromSrchDate=='' 		&amp;&amp; ToSrchDate=='' 		&amp;&amp; segment==''){
		var response = core_confirm('No search criteria entered, the search might take a long time. Would you still like to continue with the search?');
					if ( response == 'yes' ) {
						canSubmit = 'true';
					} else {
						canSubmit = 'false';
					}
		}
		
		if(canSubmit == 'true'){

			document.form.BUTTON_ID.value = 'search_button'; 
				
							document.form.submit();  
		}




	
    }
		
		function checkMassupdate(tableid)
		{

		var selectedIds = document.getElementsByName('SelectedItemLoc');
		var maxrows = document.form.pgRowCount.value;
		var lenSelIds = selectedIds.length;
		var count =lenSelIds - maxrows ;
	if(document.form.InvPolicyDetails_globalrowselector.checked){
		var decision=core_confirm("Do you want to update all records satisfying the current search criteria?");
			
		if(decision=='yes')
			{
						document.form.BUTTON_ID.value = 'MassUpdateAll'; 
						document.form.action = 'view.x2ps';
						document.form.submit();  	
			}else{
						document.form.BUTTON_ID.value = 'MassUpdate'; 
						document.form.action = 'view.x2ps';
						document.form.submit();  	
			}
			
		}else{
      for(i=0; i &lt; selectedIds.length; i++)
			{
        var t = selectedIds[ i ];
        if ( t.checked )
        {
          count += 1;
	      }
      }		
		if(count &lt;= 1){
		            core_alert('Please select at least two records for mass update!');
								return;
		}
		else{
		  				document.form.BUTTON_ID.value = 'MassUpdate'; 
							document.form.action = 'view.x2ps';
							document.form.submit();  	
		}
		}
		}
  </ui:script>
</ui:page-group>

