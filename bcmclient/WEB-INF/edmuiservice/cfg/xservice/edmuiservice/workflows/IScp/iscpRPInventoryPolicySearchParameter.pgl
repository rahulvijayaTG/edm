<ui:page-group xmlns:ui="http://www.i2.com/ui" name="studio.templates.simple_entry" source="studio.controller:load" Id="iscpRPInventoryPolicySearchParameter.pgl">
  <ui:container id="container">
    <ui:step id="top_container" displayText="">
      <ui:search displayText="Search" saveSearch="false" exportSearch="false">
        <ui:validation successMessage="{$root/SUCCESSMSG/MSG/@Value}" displayCondition="asdf" />
        <ui:field-group columns="2" select="$root/SEARCH_FIELDS">
          <ui:field-group>
            <ui:dropdown id="PartyIdentificationValue" preferredWidth="10" name="PartyIdentificationValue" displayText="Segment" selectAll="true" selectOne="false" optionSrc="$root/Segment/ID" />
