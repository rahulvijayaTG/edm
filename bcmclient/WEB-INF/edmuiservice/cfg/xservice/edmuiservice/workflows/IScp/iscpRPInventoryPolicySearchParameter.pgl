            <ui:dropdown id="LOCTYPE" name="LOCTYPE" displayText="Location Type" selectAll="true" optionSrc="$root/LocTypList/*" />
            <ui:entry-field displayText="Location Number" name="LOC_NUM" id="LOC_NUM">
              <ui:links>
                <ui:link displayText="Select Locations" onClick="javascript:selectlocation()">
