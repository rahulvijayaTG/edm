<?xml version="1.0" encoding="UTF-8"?>
<workflow mgcCount="25" ShowInBreadCrumbs="true" Version="1.0" Name="wfRPCreateLayer" Description="" Type="" PrimaryDocument="" IsStartAllowed="Yes">
  <variables/>
  <nodes>
    <done Name="done2">
      <actions>
      </actions>
      <next_nodes/>
    </done>
    <ui_form2 Name="Create Record" InputFormVar="pglFormInput" OutputFormVar="pglFormOutput" ShowInBreadCrumbs="SHOW" Template="iscpRPLayersCreate.pgl">
      <pre_actions>
        <TO_DOCVAR AssignToVar="pglFormInput">
          <SAMPLE_XML/>
        </TO_DOCVAR>
        <TO_DOCVAR AssignToVar="massUpdateTable">
          <LAYER_DETAILS_LIST>
          </LAYER_DETAILS_LIST>
        </TO_DOCVAR>
        <GET_DOC_SMART Name="P_DemandCategoryClass" AssignToVar="DEMANDTYPELIST" HandleException="true" ServiceName="PEDM_MASTER">
          <SELECT>
            <DemandCategoryClassMnemonicValue/>
          </SELECT>
        </GET_DOC_SMART>
        <TO_DOCVAR AssignToVar="dmndtypList">
          <DemandType>
          </DemandType>
        </TO_DOCVAR>
        <FOR_EACH SelectList="$DEMANDTYPELIST/P_DemandCategoryClass" CurrentElement="id">
          <TO_DOCVAR AssignToVar="dmnd">
            <ID Value="{$id/DemandCategoryClassMnemonicValue/@Value}"/>
          </TO_DOCVAR>
          <APPEND_TO_XML DocVar="dmndtypList">
            <TO_XML DocVar="dmnd"/>
          </APPEND_TO_XML>
        </FOR_EACH>
        <APPEND_TO_XML DocVar="pglFormInput">
          <TO_XML Select="$dmndtypList"/>
        </APPEND_TO_XML>
        <GET_DOC_SMART Name="P_AnalyticalModelSoftwareInstance" AssignToVar="ENGINELIST" HandleException="true" ServiceName="PEDM_MASTER">
          <SELECT>
            <AnalyticalModelSoftwareInstanceMnemonicValue/>
          </SELECT>
          <ORDER_BY Sort="Ascending">
            <AnalyticalModelSoftwareInstanceMnemonicValue/>
          </ORDER_BY>
        </GET_DOC_SMART>
        <TO_DOCVAR AssignToVar="enginelist">
          <Engine>
          </Engine>
        </TO_DOCVAR>
        <FOR_EACH SelectList="$ENGINELIST/P_AnalyticalModelSoftwareInstance" CurrentElement="id">
          <SET Var="matchesRes" FromValue="{nativeFunction('java.util.regex.Pattern', 'matches', '[0-9]*', $id/AnalyticalModelSoftwareInstanceMnemonicValue/@Value)}"/>
          <IF_TEST Test="($matchesRes='true')">
            <THEN>
          <REQUEST AssignToVar="engineid" Name="getEngineIdInterfaceFormatVal" ServiceName="PEDM_MASTER">
            <EngineId Value="{$id/AnalyticalModelSoftwareInstanceMnemonicValue/@Value}"/>
          </REQUEST>
          <TO_DOCVAR AssignToVar="eng">
            <ID Value="{$engineid/EngineId/@Value}"/>
          </TO_DOCVAR>
          <APPEND_TO_XML DocVar="enginelist">
            <TO_XML DocVar="eng"/>
          </APPEND_TO_XML>
            </THEN>
          </IF_TEST>
        </FOR_EACH>
        <TO_DOCVAR AssignToVar="dummytoRenderTable">
          <LAYER_DETAILS_LIST>
            <LAYER_DETAILS/>
          </LAYER_DETAILS_LIST>
        </TO_DOCVAR>
        <!--    <APPEND_TO_XML DocVar="pglFormInput">
          <TO_XML Select="$dummytoRenderTable"/>
        </APPEND_TO_XML>-->
        <APPEND_TO_XML DocVar="pglFormInput">
          <TO_XML Select="$enginelist"/>
        </APPEND_TO_XML>
        <!--*************************************************************************************-->
        <!--*************************************************************************************-->
        <IF_TEST Test="$userAction='Save' ">
          <THEN>
            <TO_DOCVAR AssignToVar="record">
              <RECORD>
                <AnalyticalModelName Value="{$thisParam/AnalyticalModelName/@Value}"/>
                <LayerName Value="{$thisParam/DemandCategoryName/@Value}"/>
                <SourceSystemMnemonicValue Value="{$ui_sourceSystemMnemonicVal/@Value}"/>
                <SourceKeyValue Value="default"/>
                <SourceKeyName Value="DMND_CAT_ID"/>
                <SourceObjectMnemonicValue Value="P_M_DMND_CAT"/>
                <EngineIdentifier Value="{$thisParam/EngineId/@Value}"/>
                <AllocationBandsValue Value="{$thisParam/AllocationBandText/@Value}"/>
                <LayerEffectiveEndDayValue Value="{$thisParam/LayerEffectiveEndDayNumber/@Value}"/>
                <LayerEffectiveStartDayValue Value="{$thisParam/LayerEffectiveStartDayNumber/@Value}"/>
                <DemandTypeValue Value="{$thisParam/DemandType/@Value}"/>
                <PriorityValue Value="{$thisParam/DemandCategoryPriorityNumber/@Value}"/>
                <ACTIONTOBDONE Value="INSERT"/>
                <DOCUMENTNAME Value="E_ReplenishmentLayers"/>
                <FromSource Value="UI"/>
                <SYS_TYPE Value="INSERT"/>
                <SOURCE Value="UI"/>
              </RECORD>
            </TO_DOCVAR>
            <TO_DOCVAR AssignToVar="massUpdateErrors">
              <_ERRORS>
              </_ERRORS>
            </TO_DOCVAR>
            <TO_DOCVAR AssignToVar="massUpdateSuccess">
              <SUCCESSMSG>
              </SUCCESSMSG>
            </TO_DOCVAR>
            <GET_DOCUMENT Name="P_DemandCategory" AssignToVar="queryLayer" HandleException="true" ServiceName="PEDM_MASTER" ReturnRowCount="True">
              <SELECT>
                <ENTITY_STATE/>
                <SourceSystemMnemonicValue/>
                <DemandCategoryIdentifier/>
              </SELECT>
              <AND>
                <AnalyticalModelIdentifier Value="{$thisParam/AnlytcalMdlIdn/@Value}"/>
                <DemandCategoryName Value="{subString($thisParam/DemandCategoryName/@Value,5,strlen($thisParam/DemandCategoryName/@Value))}"/>
                <ENTITY_STATE Value="DELETED"/>
              </AND>
            </GET_DOCUMENT>
            <IF_TEST Test="($queryLayer/@TotalRowCount =0 and  $queryLayer/P_DemandCategory/ENTITY_STATE/@Value!='DELETED')">
              <THEN>
                <REQUEST AssignToVar="thisReturn" Name="createRPLayerParam" ServiceName="BCM_MASTER" HandleException="true">
                  <TO_XML SelectList="$record/*"/>
                </REQUEST>
                <IF_TEST Test="($thisReturn/_RESULT/@Value='SEVERE_ERROR')">
                  <THEN>
                    <SET Var="tp" FromValue="0"/>
                    <SET Var="tweakedErrMsg" FromValue="{concat($thisReturn/_RESULT/_ERROR/@Value,' For ',' Layer:  ',$record/LayerName/@Value,'  and Engine Id:  ',$record/EngineIdentifier/@Value)}"/>
                    <TO_DOCVAR AssignToVar="error">
                      <_ERROR Value="{$tweakedErrMsg/@Value}"/>
                    </TO_DOCVAR>
                    <APPEND_TO_XML DocVar="massUpdateErrors">
                      <TO_XML Select="$error"/>
                    </APPEND_TO_XML>
                  </THEN>
                  <ELSE>
                    <TO_DOCVAR AssignToVar="success">
                      <MSG Value="Records Successfully Created"/>
                    </TO_DOCVAR>
                    <APPEND_TO_XML DocVar="massUpdateSuccess">
                      <TO_XML Select="$success"/>
                    </APPEND_TO_XML>
                  </ELSE>
                </IF_TEST>
              </THEN>
              <ELSE>
                <TO_DOCVAR AssignToVar="record">
                  <RECORD>
                    <DOCUMENT_CONTEXT>
                      <AnalyticalModelName Value="{$thisParam/AnalyticalModelName/@Value}"/>
                      <LayerName Value="{$thisParam/DemandCategoryName/@Value}"/>
                      <!--         <SourceSystemMnemonicValue Value="{$queryLayer/P_DemandCategory/SourceSystemMnemonicValue/@Value}"/>-->
                    </DOCUMENT_CONTEXT>
                    <UPDATE_PROPERTIES>
                      <EngineIdentifier Value="{$thisParam/EngineId/@Value}"/>
                      <AllocationBandsValue Value="{$thisParam/AllocationBandText/@Value}"/>
                      <LayerEffectiveEndDayValue Value="{$thisParam/LayerEffectiveEndDayNumber/@Value}"/>
                      <LayerEffectiveStartDayValue Value="{$thisParam/LayerEffectiveStartDayNumber/@Value}"/>
                      <DemandTypeValue Value="{$thisParam/DemandType/@Value}"/>
                      <PriorityValue Value="{$thisParam/DemandCategoryPriorityNumber/@Value}"/>
                      <SYS_TYPE Value="ACTIVATE"/>
                      <SOURCE Value="UI"/>
                    </UPDATE_PROPERTIES>
                    <ACTIONTOBDONE Value="ACTIVATE"/>
                    <DOCUMENTNAME Value="E_ReplenishmentLayers"/>
                  </RECORD>
                </TO_DOCVAR>
                <REQUEST AssignToVar="thisReturn" Name="updateRPLayerParam" ServiceName="BCM_MASTER" HandleException="true">
                  <TO_XML SelectList="$record/*"/>
                </REQUEST>
                <IF_TEST Test="($thisReturn/_RESULT/@Value='SEVERE_ERROR')">
                  <THEN>
                    <SET Var="tp" FromValue="0"/>
                    <SET Var="tweakedErrMsg" FromValue="{concat($thisReturn/_RESULT/_ERROR/@Value,' For ',' Layer:  ',$record/DOCUMENT_CONTEXT/LayerName/@Value,'  and Engine Id:  ',$record/UPDATE_PROPERTIES/EngineIdentifier/@Value)}"/>
                    <TO_DOCVAR AssignToVar="error">
                      <_ERROR Value="{$tweakedErrMsg/@Value}"/>
                    </TO_DOCVAR>
                    <APPEND_TO_XML DocVar="massUpdateErrors">
                      <TO_XML Select="$error"/>
                    </APPEND_TO_XML>
                  </THEN>
                  <ELSE>
                    <TO_DOCVAR AssignToVar="success">
                      <MSG Value="Records Successfully Created"/>
                    </TO_DOCVAR>
                    <APPEND_TO_XML DocVar="massUpdateSuccess">
                      <TO_XML Select="$success"/>
                    </APPEND_TO_XML>
                  </ELSE>
                </IF_TEST>
              </ELSE>
            </IF_TEST>
            <APPEND_TO_XML DocVar="pglFormInput">
              <TO_XML Select="$massUpdateErrors"/>
            </APPEND_TO_XML>
            <APPEND_TO_XML DocVar="pglFormInput">
              <TO_XML Select="$massUpdateSuccess"/>
            </APPEND_TO_XML>
          </THEN>
        </IF_TEST>
        <!--**************************************FETCH LAYER***********************************************************-->
        <!--*************************************************************************************************************-->
        <IF_TEST Test="$userAction='fetchLayer' and  (strlen($thisParam/EngineId/@Value)>0)">
          <THEN>
            <REQUEST AssignToVar="engineid" Name="getEngineIdBitPower" ServiceName="PEDM_MASTER">
              <EngineIdentification Value="{$thisParam/EngineId/@Value}"/>
            </REQUEST>
            <REQUEST AssignToVar="manipulateLayerName" Name="getMaxLayerName" ServiceName="PEDM_MASTER">
              <EngineId Value="{$engineid/_EngineIdentification/@Value}"/>
            </REQUEST>
            <SET Var="trackEngine" FromValue="1"/>
            <SET Var="manipulatedLayerName" FromValue="{ifElse($manipulateLayerName/MAX_LAYER_NAME/@Value=null,0,$manipulateLayerName/MAX_LAYER_NAME/@Value)}"/>
            <SET Var="manipulatedLayerName" FromValue="{int($manipulatedLayerName + 1)}"/>
            <SET Var="anlymodelName" FromValue="{concat('RP_',$engineid/_EngineIdentification/@Value)}"/>
            <IF_TEST Test="strlen($manipulateLayerName/AnlMdlId/@Value)&lt;=0">
              <THEN>
                <GET_DOCUMENT Name="P_AnalyticalModel" AssignToVar="queryAnlyMdl" HandleException="true" ServiceName="PEDM_MASTER" ReturnRowCount="True">
                  <SELECT>
                    <AnalyticalModelIdentifier/>
                  </SELECT>
                  <QUERY_DOCUMENT_LINK Name="REL_2476">
                    <AND>
                      <AnalyticalModelSoftwareInstanceMnemonicValue Value="{$engineid/_EngineIdentification/@Value}"/>
                    </AND>
                  </QUERY_DOCUMENT_LINK>
                </GET_DOCUMENT>
              </THEN>
            </IF_TEST>
            <TO_DOCVAR AssignToVar="record">
              <LAYER_DETAILS>
                <EngineId Value="{$thisParam/EngineId/@Value}"/>
                <DemandCategoryName Value="{concat('LAYER',$manipulatedLayerName)}"/>
                <AnalyticalModelName Value="{$anlymodelName}"/>
                <AllocationBandText Value="{$thisParam/AllocationBandText/@Value}"/>
                <LayerEffectiveEndDayNumber Value="{$thisParam/LayerEffectiveEndDayNumber/@Value}"/>
                <LayerEffectiveStartDayNumber Value="{$thisParam/LayerEffectiveStartDayNumber/@Value}"/>
                <DemandType Value="{$thisParam/DemandType/@Value}"/>
                <DemandCategoryPriorityNumber Value="{$thisParam/DemandCategoryPriorityNumber/@Value}"/>
                <AnlytcalMdlIdn Value="{ifElse(strlen($manipulateLayerName/AnlMdlId/@Value)&lt;=0,$queryAnlyMdl/P_AnalyticalModel/AnalyticalModelIdentifier/@Value,$manipulateLayerName/AnlMdlId/@Value)}"/>
                <SourceSystemMnemonicValue Value="{$manipulateLayerName/Src_Sys/@Value}"/>
              </LAYER_DETAILS>
            </TO_DOCVAR>
            <APPEND_TO_XML DocVar="massUpdateTable">
              <TO_XML Select="$record"/>
            </APPEND_TO_XML>
          </THEN>
        </IF_TEST>
        <!--**************************************************************************-->
        <!--**************************************************************************-->
        <IF_TEST Test="$trackEngine/@Value=1">
          <THEN>
            <APPEND_TO_XML DocVar="pglFormInput">
              <TO_XML Select="$massUpdateTable"/>
            </APPEND_TO_XML>
          </THEN>
          <ELSE>
            <TO_DOCVAR AssignToVar="dummytoRenderTable">
              <LAYER_DETAILS_LIST>
                <LAYER_DETAILS/>
              </LAYER_DETAILS_LIST>
            </TO_DOCVAR>
            <APPEND_TO_XML DocVar="pglFormInput">
              <TO_XML Select="$dummytoRenderTable"/>
            </APPEND_TO_XML>
          </ELSE>
        </IF_TEST>
      </pre_actions>
      <if_cond Value="$userAction ='Cancel'">
        <next_nodes OutputVar="{outputXml,xml}">
          <next_node Name="Layer Search" Description=""/>
        </next_nodes>
      </if_cond>
      <else_if_cond Value="$userAction ='Save'">
        <next_nodes OutputVar="{outputXml,xml}">
          <next_node Name="Create Record" Description=""/>
        </next_nodes>
      </else_if_cond>
      <else_if_cond Value="$userAction ='fetchLayer'">
        <next_nodes OutputVar="{outputXml,xml}">
          <next_node Name="Create Record" Description=""/>
        </next_nodes>
      </else_if_cond>
      <else_if_cond Value="true()">
        <next_nodes OutputVar="{outputXml,xml}">
          <next_node Name="done2" Description=""/>
        </next_nodes>
      </else_if_cond>
    </ui_form2>
    <start Name="start4">
      <actions>
      </actions>
      <next_nodes>
        <next_node Name="Create Record" Description=""/>
      </next_nodes>
    </start>
    <sub_workflow Name="Layer Search" InputVar="{NodeInXml,xml}" Workflow="wfRPLayers">
      <pre_actions>
      </pre_actions>
      <post_actions>
      </post_actions>
      <next_nodes OutputVar="{NodeOutXml,xml}"/>
      <input>
      </input>
    </sub_workflow>
  </nodes>
