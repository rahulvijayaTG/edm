<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="wfSrchLocation.pgl">
  <ui:container id="top" displayText="Select Segments">
    <ui:step id="topStep">
      <ui:search id="srchContainer" displayText="Search" exportSearch="false" saveSearch="false">
        <ui:field-group id="srch" columns="2">
          <ui:entry-field id="SRCH_LOCATION_NO" name="SRCH_LOCATION_NO" displayText="Location" />
          <ui:entry-field id="SRCH_LOCATION_DESC" name="SRCH_LOCATION_DESC" displayText="Location Description" />
          <ui:entry-field id="SRCH_LOCATION_TYPE" name="SRCH_LOCATION_TYPE" displayText="Location Type" />
          <ui:hidden-field name="FIELD_NAME" value="{$root/FIELD_NAME/@Value}" />
        </ui:field-group>
      </ui:search>
      <ui:table id="bottomTable" displayText="Locations" rowSrc="$root/RESPONSE/P_LocationIdentification" postRowIdAs="SELECTED_ITEM" collapsable="false" scrollable="true" rowId="LocationIdentificationValue" displayTextNoRecords="No Record Found" selectable="All">
        <ui:field-group id="tableColumns" width="100%">
          <ui:entry-field id="LocationIdentificationValue" name="LocationIdentificationValue" displayText="Location" editable="false" />
          <ui:display-field id="LocationIdentificationValueDescription" name="LocationIdentificationValueDescription" displayText="Location Description" />
          <ui:display-field id="LocationClassName" name="LocationClassName" displayText="Location Type" />
        </ui:field-group>
        <ui:buttons>
          <ui:button id="select" name="select" displayText="Select" emphasized="true" enabledBySelections="true" onClick="javascript:selectItem();" />
        </ui:buttons>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:script>function selectItem()
    {
		  var selectedIds =document.getElementsByName( 'SELECTED_ITEM' );
		  var length = selectedIds.length;
      var items = null;
      var categoryCodes = null;
      for(i=0; i &lt; length; i++)
			{
        var t = selectedIds[ i ];
        if ( t.checked )
        {
          if( items )
            items += ',' + t.value;
          else
            items = t.value;
        }
      }
      if ( document.form.FIELD_NAME.value.length &gt; 0)
        {
          var fieldName = document.form.FIELD_NAME.value;
          eval("parent.opener.form." + fieldName + ".value = items;");
      }
      window.close();    
      }</ui:script>
</ui:page-group>

