		{

		//core_alert('Selected Parameter is of Free Form Type');

		i2uiToggleButtonState('validValue', 'disabled')

		return;

		}

			}

		}



		}

		

		

				function on_Deactivate(){
                   // Changes made by 09032016 for QC 20794
					var response = core_confirm('Deactivating a parameter will also deactivate all the Segment-Parameters associated with it. Do you still want to deactivate?');

					if ( response == 'yes' ) {

						canSubmit = 'true';

					} else {

						canSubmit = 'false';

					}

					if (canSubmit == 'true') {

								document.form.BUTTON_ID.value = 'Deactivate'; 

							document.form.action = 'view.x2ps';

							document.form.submit();  

					}

		else{

						document.form.SUBMIT_AS_XML.value = 'false';

					}

					return;

		}

			function on_Activate(){
                         // Changes made by 09032016 for QC 20794
					var response = core_confirm('Activating a parameter will also activate all the Segment-Parameters associated with it. Do you still want to activate?');

					if ( response == 'yes' ) {

						canSubmit = 'true';

					} else {

						canSubmit = 'false';

					}

					if (canSubmit == 'true') {

								document.form.BUTTON_ID.value = 'Activate'; 

							document.form.action = 'view.x2ps';

							document.form.submit();  

					}

		else{

						document.form.SUBMIT_AS_XML.value = 'false';

					}

					return;

		}

			function on_Delete(){
                           // Changes made by 09032016 for QC 20794
