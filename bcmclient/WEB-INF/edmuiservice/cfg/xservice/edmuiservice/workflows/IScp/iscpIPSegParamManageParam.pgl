<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="uiWfIPSegmentParameter.pgl">
  <!--<ui:container id="SearchContainer" displayText="">

    <ui:step id="searchStep">

      <ui:validation successMessage="{$root/SUCCESSMSG/MSG/@Value}"/>-->
  <ui:search id="srchSegParams" exportSearch="false" saveSearch="false" collapsable="true" displayText="Search Parameter">
    <ui:validation successMessage="{$root/SUCCESSMSG/MSG/@Value}" anyFieldIsRequired="false" />
    <ui:field-group rows="2">
      <ui:entry-field displayText="Parameter Name" id="ParameterMnemonicValue" name="ParameterMnemonicValue">
        <ui:links>
          <ui:link displayText="Select Parameters" targetType="popup" targetName="orderPopup">
            <ui:image src="pop_up_window.gif" />
            <ui:url page="view.x2ps">
              <FIELD_NAME select="'ParameterMnemonicValue'" />
              <ENTITY_NAME select="'ParameterMnemonicValue'" />
              <SELECTABLE select="'All'" />
              <BUTTON_ID select="'selectParameter'" />
            </ui:url>
          </ui:link>
        </ui:links>
      </ui:entry-field>
      <ui:dropdown id="ENTITYSTATE" name="ENTITYSTATE" displayText="State" defaultValue="ACTIVE">
        <ui:option id="ACTIVE" value="ACTIVE" />
        <ui:option id="INACTIVE" value="INACTIVE" />
      </ui:dropdown>
    </ui:field-group>
  </ui:search>
  <!--<ui:table id="bottomTable" displayText="RP Segment Parameters" select="$root/line" rowSrc="ROW_DATA" rowId="PARAMETER_NAME" selectable="single" totalRowCount="$root/ROWCNT/@Value" maxRows="5">-->
  <ui:table id="bottomTable" displayText="Parameter Search Results" select="$root/line" rowSrc="ROW_DATA" rowId="PARAMETER_NAME" selectable="single" startAtRow="$root/startAtRow/@Value" totalRowCount="$root/ROWCNT/@Value" maxRows="5" exportable="true" postRowIdAs="selectedParameterName">
    <ui:field-group id="tableColumns">
      <ui:entry-field editable="false" name="PARAMETER_NAME" id="PARAMETER_NAME" displayText="Parameter Name" sortable="true" />
      <ui:choose-field id="PARAMETER_DESC" name="PARAMETER_DESC" displayText="Parameter Description" displayNoWrap="false">
        <ui:when test="(contains($root/AccessLevel/@Value,'Add') or contains($root/AccessLevel/@Value,'Update')) and ENTITY_STATE/@Value='ACTIVE'">
          <ui:entry-field name="PARAMETER_DESC" id="PARAMETER_DESC" displayText="Parameter Description" displayNoWrap="false" />
        </ui:when>
        <ui:otherwise>
          <ui:display-field name="PARAMETER_DESC" id="PARAMETER_DESC" displayText="Parameter Description" displayNoWrap="false" />
        </ui:otherwise>
      </ui:choose-field>
      <ui:choose-field id="PARAMETER_UOM" name="PARAMETER_UOM" displayText="Parameter UOM">
        <ui:when test="(contains($root/AccessLevel/@Value,'Add') or contains($root/AccessLevel/@Value,'Update')) and ENTITY_STATE/@Value='ACTIVE'">
          <ui:dropdown id="PARAMETER_UOM" name="PARAMETER_UOM" displayText="Parameter UOM" optionSrc="$root/UOM/*" />
        </ui:when>
        <ui:otherwise>
          <ui:display-field name="PARAMETER_UOM" id="PARAMETER_UOM" displayText="Parameter UOM" />
        </ui:otherwise>
      </ui:choose-field>
      <ui:entry-field editable="false" name="ENTITY_STATE" id="ENTITY_STATE" displayText="State" />
      <ui:entry-field editable="false" id="ParameterDatatypeName" name="ParameterDatatypeName" displayText="Data Type" />
      <ui:choose-field id="ParameterValueFreeFormIndicator" name="ParameterValueFreeFormIndicator" displayText="Valid Value List">
        <ui:when test="ParameterValueFreeFormIndicator/@Value='Y'">
          <ui:entry-field editable="false" id="ParameterValueFreeFormIndicator" value="N" name="ParameterValueFreeFormIndicator" displayText="Valid Value List" />
        </ui:when>
        <ui:otherwise>
          <ui:entry-field editable="false" id="ParameterValueFreeFormIndicator" value="Y" name="ParameterValueFreeFormIndicator" displayText="Valid Value List" />
        </ui:otherwise>
      </ui:choose-field>
      <!--	 <ui:entry-field editable="false" id="ParameterValueFreeFormIndicator" name="ParameterValueFreeFormIndicator" displayText="Valid Value List"/>-->
      <ui:hidden-field id="PARAMETER_DESC_Hidden" name="PARAMETER_DESC_Hidden" />
      <ui:hidden-field id="PARAMETER_UOM_Hidden" name="PARAMETER_UOM_Hidden" />
      <!--  <ui:display-field name="LAST_MODIFIED_DATE" id="LAST_MODIFIED_DATE" displayText="Modified Date" sortable="false"/>

      <ui:display-field name="ModifiedBy" id="ModifiedBy" displayText="Modified By" sortable="false"/>-->
      <ui:hidden-field id="LAST_MODIFIED_DATE" name="LAST_MODIFIED_DATE" />
    </ui:field-group>
    <ui:buttons id="tblActions">
      <ui:button id="validValue" name="validValue" displayText="Manage Valid Values" enabledBySelections="true" displayCondition="{contains($root/AccessLevel/@Value,'View') and ($root/chkStateActive/@Value=1)}" />
      <ui:button id="Delete" name="Delete" displayText="Delete" enabledBySelections="true" displayCondition="{contains($root/AccessLevel/@Value,'Remove') and ($root/chkState/@Value=1)}" />
      <ui:button id="Activate" name="Activate" displayText="Activate" enabledBySelections="true" displayCondition="{contains($root/AccessLevel/@Value,'Update') and ($root/chkState/@Value=1)}" />
      <ui:button id="Deactivate" name="Deactivate" displayText="Deactivate" enabledBySelections="true" displayCondition="{contains($root/AccessLevel/@Value,'Update') and ($root/chkStateActive/@Value=1)}" />
      <ui:button id="Save" name="Save" displayText="Save" enabledBySelections="true" displayCondition="{contains($root/AccessLevel/@Value,'Update')and ($root/chkStateActive/@Value=1)}" />
    </ui:buttons>
  </ui:table>
  <!--    </ui:step>

  </ui:container>-->
  <ui:container id="addNewContainer" collapsable="true" displayText="Add New Parameter" scrollable="true" displayCondition="{contains($root/AccessLevel/@Value,'Add')}">
    <ui:step id="bottomStep">
      <!--   <ui:validation successMessage="{$root/SUCCESSMSG/MSG/@Value}" displayCondition="1"/>-->
      <ui:field-group columns="2">
        <ui:field-group id="addNew" rows="3">
          <ui:entry-field name="ADD_PARAM_NAME" id="ADD_PARAM_NAME" displayText="Parameter Name" required="true" />
          <ui:dropdown displayText="Parameter UOM" id="ADD_PARAM_UOM" name="ADD_PARAM_UOM" defaultValue="NV" required="true" optionSrc="$root/UOM/*" />
          <ui:textarea name="ADD_COMMENTS" id="ADD_COMMENTS" displayText="Comments" />
          <ui:entry-field name="ADD_PARAM_DESC" id="ADD_PARAM_DESC" displayText="Parameter Description" required="false" displayNoWrap="false" />
          <ui:dropdown id="DATATYPE" name="ADD_DATATYPE" displayText="Data Type" required="true" defaultValue="TEXT">
            <ui:option id="BOOLEAN" value="BOOLEAN" />
            <ui:option id="NUMBER" value="NUMBER" />
            <ui:option id="TEXT" value="TEXT" />
          </ui:dropdown>
          <ui:checkbox name="ADD_ISVALIDVALUE" displayText="Valid Value List" />
        </ui:field-group>
      </ui:field-group>
      <ui:buttons>
        <ui:button id="Clear" name="Clear" displayText="Clear" enabledBySelections="true" validate="false" />
        <ui:button id="Add" name="Add" displayText="Add New" enabledBySelections="true" validate="false" displayCondition="{contains($root/AccessLevel/@Value,'Add')}" />
      </ui:buttons>
    </ui:step>
  </ui:container>
