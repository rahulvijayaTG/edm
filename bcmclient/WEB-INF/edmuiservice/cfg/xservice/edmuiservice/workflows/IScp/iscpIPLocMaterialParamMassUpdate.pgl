            <ui:when test="ParamName/@Value!='OverrideKeepInventoryIndicator'">
              <ui:entry-field id="ParameterValue1" name="ParameterValue1"/>
            </ui:when>
            <ui:otherwise>
              <ui:dropdown id="ParameterValue1" name="ParameterValue1" selectOne="true">
                <ui:option id="N" value="N"/>
                <ui:option id="U" value="U"/>
                <ui:option id="Y" value="Y"/>
              </ui:dropdown>
            </ui:otherwise>
          </ui:choose-field>
          <ui:textarea name="Comments1" displayText="Comments" required="false"/>
          <ui:hidden-field id="CommFieldName" name="CommFieldName"/>
        </ui:field-group>
        <ui:buttons>
          <ui:button displayText="Save" id="Save" name="Save" enabledBySelections="true"/>
          <ui:button displayText="Cancel" id="Cancel" name="Cancel" enabledBySelections="false"/>
        </ui:buttons>
      </ui:table>-->
      <!-- <ui:field-group columns="4" id="fieldGroups1">
        <ui:field-group id="leftFields" rows="4">
          <ui:checkbox name="chkForecastError" id="chkForecastError" onClick="javascript:enableSave();"/>
          <ui:checkbox name="chkPRP" id="chkPRP"/>
          <ui:checkbox name="chkROQ" id="chkROQ"/>
          <ui:checkbox name="chkKIF" id="chkKIF"/>
        </ui:field-group>
        <ui:field-group id="middleFields" rows="4">
          <ui:entry-field displayText="Override FRCT Error %" id="OverrideForecastError" required="false"/>
          <ui:entry-field displayText="Override PRP Days" id="OverrideProductionRiskPeriod" name="OverrideProductionRiskPeriod" required="false"/>
          <ui:entry-field displayText="Override ROQ" id="OverrideReorderQuantity" name="OverrideReorderQuantity" required="false"/>
