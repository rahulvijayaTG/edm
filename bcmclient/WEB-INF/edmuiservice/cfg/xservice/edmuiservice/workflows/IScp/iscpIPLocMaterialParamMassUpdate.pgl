<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="2">
  <ui:container id="topContainer">
    <ui:step id="c1" displayText="" editable="true">
      <ui:validation successMessage="{$root/SUCCESSMSG/MSG/@Value}" />
      <ui:table id="topTable" displayText="Mass Update Selections" rowSrc="$root/ITEMLOC_LISTS/ITEM_LOC_PARM" collapsable="true" rowId="ItemLoc" scrollable="true" exportable="false" postRowIdAs="SelectedItemLoc" displayCondition="{$root/ITEMLOC_LISTS/userAction/@Value='MassUpdate'}">
        <ui:field-group>
          <ui:entry-field editable="false" displayText="Item Number" name="ItemIdentification" id="ItemIdentification" />
          <ui:display-field name="ItemDesc" id="ItemDesc" displayText="Item Description" sortable="false" />
          <ui:display-field name="GTIN" id="GTIN" displayText="GTIN #" sortable="false" dataType="Number" unFormat="true" />
          <!-- CR:107148 12/19/07 Venkat Code Start -->
          <!--<ui:display-field name="ItemTypeDescription" id="ItemTypeDescription" displayText="Material Type" sortable="false"/>-->
          <ui:display-field name="ItemTypeName" id="ItemTypeName" displayText="Material Type" sortable="false" />
          <!-- CR:107148 12/19/07 Venkat Code End -->
          <ui:display-field sortable="false" name="SegmentIdentification" id="SegmentIdentification" displayText="Segment Number" />
          <ui:entry-field editable="false" name="LocationIdentification" id="LocationIdentification" displayText="Location Number" sortable="false" />
          <ui:display-field name="LocationDesc" id="LocationDesc" displayText="Location Description" sortable="false" />
          <ui:hidden-field name="ItemLoc" id="ItemLoc" />
          <ui:hidden-field name="ItemUOMValue" id="ItemUOMValue" />
          <ui:display-field name="OverrideForecastErrorPercent" id="OverrideForecastErrorPercent" displayText="Override Percent Error" />
          <ui:display-field name="OverrideProductionRiskPeriodValue" id="OverrideProductionRiskPeriodValue" displayText="Override Production Risk Period" />
          <ui:display-field name="OverrideReplenishmentOrderQuantity" id="OverrideReplenishmentOrderQuantity" displayText="Override Reorder Quantity" />
          <ui:display-field name="OverrideKeepInventoryIndicator" id="OverrideKeepInventoryIndicator" displayText="Override Keep Inventory Flag" />
          <ui:display-field name="Comments" id="Comments" displayText="Comments" />
        </ui:field-group>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:container id="bottomContainer" displayText="Mass Update">
    <ui:step id="c2" displayText="" editable="true">
      <ui:field-group columns="4" id="fieldGroups2">
        <ui:field-group id="leftFields">
          <ui:checkbox name="chkForecastError" onClick="javascript:disableSave(this)" />
        </ui:field-group>
        <ui:field-group id="middleFields" columns="6">
          <ui:entry-field displayText="Override Percent Error" dataType="Number" id="OverrideFE" name="OverrideFE" required="false" />
        </ui:field-group>
      </ui:field-group>
      <ui:field-group columns="4" id="fieldGroups2">
        <ui:field-group id="leftFields">
          <ui:checkbox name="chkPRP" onClick="javascript:disableSave(this)" />
        </ui:field-group>
        <ui:field-group id="middleFields" columns="6">
          <ui:entry-field displayText="Override Production Risk Period" dataType="Number" id="OverridePRP" name="OverridePRP" required="false" />
        </ui:field-group>
      </ui:field-group>
      <ui:field-group columns="4" id="fieldGroups2">
        <ui:field-group id="leftFields">
          <ui:checkbox name="chkROQ" onClick="javascript:disableSave(this)" />
        </ui:field-group>
        <ui:field-group id="middleFields" columns="6">
          <ui:entry-field displayText="Override Reorder Quantity" dataType="Number" id="OverrideROQ" name="OverrideROQ" required="false" />
        </ui:field-group>
      </ui:field-group>
      <ui:field-group columns="4" id="fieldGroups2">
        <ui:field-group id="leftFields">
          <ui:checkbox name="chkKIF" onClick="javascript:disableSave(this)" />
        </ui:field-group>
        <ui:field-group id="middleFields" columns="6">
          <ui:dropdown defaultValue="Y" displayText="Override Keep Inventory Flag" id="OverrideKIF" name="OverrideKIF" required="false">
            <ui:option id="N" value="N" />
            <ui:option id="U" value="U" />
            <ui:option id="Y" value="Y" />
          </ui:dropdown>
          <!--   <ui:entry-field displayText="Override Keep Inventory Flag" id="OverrideKIF" name="OverrideKIF" required="false"/>-->
        </ui:field-group>
      </ui:field-group>
      <ui:field-group columns="8" id="fieldGroups2">
        <ui:field-group id="leftFields">
          <ui:textarea name="Comments1" id="Comments1" displayText="Comments" required="false" />
        </ui:field-group>
      </ui:field-group>
      <ui:buttons>
        <ui:button displayText="Save" id="Save" name="Save" enabledBySelections="true" disabled="true" onClick="javaScript:checkComments()" />
        <!-- RIC: 240988 Praneeth - Cancel button wording changes request - Start -->
        <ui:button displayText="Back to Search" id="Cancel" name="Cancel" enabledBySelections="false" />
        <!-- RIC: 240988 Praneeth - Cancel button wording changes request - End -->
      </ui:buttons>
      <!-- <ui:table id="bottomTable" displayText="Updateable Parameters" rowSrc="$root/PARAM_DETAILS_LIST/PARAM_DETAILS" postRowIdAs="SelectedParamName" totalRowCount="4" startAtRow="0" maxRows="4" rowId="ParamName" exportable="false" selectable="All" scrollable="true">
