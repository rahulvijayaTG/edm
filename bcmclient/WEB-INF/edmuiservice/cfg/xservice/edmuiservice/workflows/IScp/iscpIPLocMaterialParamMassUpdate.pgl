          <ui:textarea id="OverrideForecastErrorCommentText" name="OverrideForecastErrorCommentText" displayText="Comments" required="true"/>
          <ui:textarea id="OverrideProductionRiskPeriodCommentText" name="OverrideProductionRiskPeriodCommentText" displayText="comments" required="true"/>
          <ui:textarea id="OverrideReorderQuantityCommentText" name="OverrideReorderQuantityCommentText" displayText="comments" required="true"/>
          <ui:textarea id="OverrideKeepInventoryIndicatorCommentText" name="OverrideKeepInventoryIndicatorCommentText" displayText="Comments" required="true"/>
        </ui:field-group>
      </ui:field-group>
      <ui:buttons>
        <ui:button displayText="Save" id="Save" name="Save" enabledBySelections="true"/>
        <ui:button displayText="Cancel" id="Cancel" name="Cancel" enabledBySelections="false" validate="false"/>
      </ui:buttons>-->
    </ui:step>
  </ui:container>
  <ui:script>var RPcheckbox=2;
			function disableSave(checkbox){

		if(checkbox.checked &amp;&amp;RPcheckbox&gt;=2){
		RPcheckbox+=1;

		i2uiToggleButtonState('Save', 'enabled');
		}else if(!checkbox.checked &amp;&amp; RPcheckbox&gt;2){

	RPcheckbox-=1;

	
		 if( RPcheckbox&lt;=2){


				i2uiToggleButtonState('Save', 'disabled');
		}else
				i2uiToggleButtonState('Save', 'enabled');
		
		}

		
		}
				function checkComments(){


		if(strlen(document.form.Comments1.value) ==0){
		core_alert('Please enter Comments');
		return;
				}else{
				
			 document.form.BUTTON_ID.value="Save";

                document.form.submit();
		}
		}</ui:script>
</ui:page-group>

