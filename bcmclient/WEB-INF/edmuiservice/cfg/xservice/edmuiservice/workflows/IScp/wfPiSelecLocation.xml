    <ui_form2 Name="iscpPiSelectLocation" InputFormVar="pglFormInput" OutputFormVar="pglFormOutput" ShowInBreadCrumbs="HIDE" Template="iscpPiSelectLocation.pgl">
      <pre_actions>
        <action>
          <SET Var="paginateStart" FromValue="{ifElse($thisParam/START_COUNT/@Value = null, '0', $thisParam/START_COUNT/@Value)}"/>
          <SET Var="pgMaxRows" FromValue="{ifElse($thisParam/MAX_ROWS/@Value = null, '5', $thisParam/MAX_ROWS/@Value)}"/>
          <SET Var="singleQuote" FromValue="'"/>
          <TO_DOCVAR AssignToVar="pglFormInput">
            <ROOT/>
          </TO_DOCVAR>
          <TO_DOCVAR AssignToVar="dropDownSegment">
            <SEGMENTS/>
          </TO_DOCVAR>
          <REQUEST AssignToVar="resSegments" Name="getSegments" ServiceName="PEDM_MASTER">
          </REQUEST>
          <FOR_EACH SelectList="$resSegments/P_PartyIdentification" CurrentElement="curELE">
            <APPEND_TO_XML DocVar="dropDownSegment">
              <P_PartyIdentification>
                <PartyIdentificationValue Value="{$curELE/PartyIdentificationValue/@Value}"/>
                <segmentIds Value="{$curELE/PartyIdentificationValue/@Value}-{$curELE/PartyDescription/@Value}"/>
              </P_PartyIdentification>
            </APPEND_TO_XML>
          </FOR_EACH>
          <IF_TEST Test="$thisParam/PARAMETERS/* = null">
            <THEN>
              <FOR_EACH SelectList="$thisParam/*" CurrentElement="prevselectedelement">
                <IF_TEST Test="name($prevselectedelement) = 'Selected_Locations'">
                  <THEN>
                    <!--<SET Var="PrevSelected" FromValue="{ifElse($PrevSelected='',$prevselectedelement/@Value,(ifElse(contains(PrevSelected,$prevselectedelement/@Value),'$PrevSelected',concat($PrevSelected,',',$prevselectedelement/@Value))))}"/>-->
                    <IF_TEST Test="$PrevSelected=''">
                      <THEN>
                        <SET Var="PrevSelected" FromValue="{$prevselectedelement/@Value}"/>
                      </THEN>
                      <ELSE>
                        <IF_TEST Test="contains($PrevSelected,$prevselectedelement/@Value)">
                          <THEN>
                            <SET Var="PrevSelected" FromValue="{$PrevSelected}"/>
                          </THEN>
                          <ELSE>
                            <SET Var="PrevSelected" FromValue="{concat($PrevSelected,',',$prevselectedelement/@Value)}"/>
                          </ELSE>
                        </IF_TEST>
                      </ELSE>
                    </IF_TEST>
                  </THEN>
                </IF_TEST>
              </FOR_EACH>
            </THEN>
            <ELSE>
              <FOR_EACH SelectList="$thisParam/PARAMETERS/*" CurrentElement="prevselectedelement">
                <IF_TEST Test="name($prevselectedelement) = 'Selected_Locations'">
                  <THEN>
                    <IF_TEST Test="$PrevSelected=''">
                      <THEN>
                        <SET Var="PrevSelected" FromValue="{$prevselectedelement/@Value}"/>
                      </THEN>
                      <ELSE>
                        <IF_TEST Test="contains($PrevSelected,$prevselectedelement/@Value)">
                          <THEN>
                            <SET Var="PrevSelected" FromValue="{$PrevSelected}"/>
                          </THEN>
                          <ELSE>
                            <SET Var="PrevSelected" FromValue="{concat($PrevSelected,',',$prevselectedelement/@Value)}"/>
                          </ELSE>
                        </IF_TEST>
                      </ELSE>
                    </IF_TEST>
                  </THEN>
                </IF_TEST>
              </FOR_EACH>
            </ELSE>
          </IF_TEST>
          <!--##############this segment of code is to create tags for grpid and line number in thisparam while navigating between pages############-->
          <IF_TEST Test="$thisParam/GroupLineInfo/@Value != null">
            <THEN>
              <SET Var="lineinfo" FromValue="{$thisParam/GroupLineInfo/@Value}"/>
              <SET Var="groupidforappend" FromValue="{$thisParam/GroupIdentifier/@Value}"/>
            </THEN>
            <ELSE>
              <SET_PROPS Select="$thisParam">
                <GroupLineInfo Value="{$lineinfo}"/>
                <GroupIdentifier Value="{$groupidforappend}"/>
              </SET_PROPS>
            </ELSE>
          </IF_TEST>
          <!--##########################-->
          <GET_DOCUMENT AssignToVar="groupidentifier" Name="P_ItemInterchangeGroup" ServiceName="PEDM_MASTER">
            <ItemInterchangeGroupMnemonicValue Value="{ifElse($thisParam/GroupIdentifier/@Value != null,$thisParam/GroupIdentifier/@Value,$thisParam/PARAMETERS/GroupIdentifier/@Value)}"/>
          </GET_DOCUMENT>
          <SET Var="sortBy" FromValue="loc_idn_val"/>
          <IF_TEST Test="(( (($thisParam/SORT_ORDER/@Value=null) or ($thisParam/SORT_BY/@Value = 'ID')) and (($thisParam/PARAMETERS/SORT_ORDER/@Value=null) or ($thisParam/PARAMETERS/SORT_BY/@Value = 'ID')) ))">
            <THEN>
              <SET Var="sortOrder" FromValue="ASC"/>
              <!-- If the value is null or the sort by is ID-->
            </THEN>
            <ELSE>
              <IF_TEST Test="($thisParam/SORT_ORDER/@Value='Descending') or ($thisParam/PARAMETERS/SORT_ORDER/@Value='Descending')">
                <THEN>
                  <SET Var="sortOrder" FromValue="DESC"/>
                  <!-- if the value is descending-->
                </THEN>
                <ELSE>
                  <IF_TEST Test="($thisParam/SORT_ORDER/@Value='Ascending') or ($thisParam/PARAMETERS/SORT_ORDER/@Value='Ascending')">
                    <THEN>
                      <SET Var="sortOrder" FromValue="ASC"/>
                      <!-- if the value is Ascending-->
                    </THEN>
                  </IF_TEST>
                </ELSE>
              </IF_TEST>
            </ELSE>
          </IF_TEST>
          <IF_TEST Test="$thisParam/PARAMETERS/* = null">
            <THEN>
              <FORM_SEARCH_FILTER Value="{$thisParam}" AssignToVar="grpLineFilters">
                <GroupLineInfo MultiValued="true"/>
              </FORM_SEARCH_FILTER>
            </THEN>
            <ELSE>
              <FORM_SEARCH_FILTER Value="{$thisParam/PARAMETERS}" AssignToVar="grpLineFilters">
                <GroupLineInfo MultiValued="true"/>
              </FORM_SEARCH_FILTER>
            </ELSE>
          </IF_TEST>
          <APPEND_TO_XML DocVar="grpLineFilters">
            <ORDER_BY>
              <TO_XML DocVar="sortByTag"/>
            </ORDER_BY>
          </APPEND_TO_XML>
          <!--##########################-->
          <TO_DOCVAR AssignToVar="listItemId">
            <Items/>
          </TO_DOCVAR>
          <!--*******getting the line numbers and items and appending them to the list****************-->
          <IF_TEST Test="$grpLineFilters/FILTER/OR/* != null">
            <THEN>
              <SET Var="eliminateSqlQuery" FromValue="{concat('select DISTINCT loc_id from P_M_ITINGRP_LN_X_LOC where ITINGRP_ID=',$groupidentifier/P_ItemInterchangeGroup/ItemInterchangeGroupIdentifier/@Value,' and itingrp_ln_num IN (')}"/>
              <SET Var="countLines" FromValue="0"/>
              <!--*****************************if multiple lines are selected******************-->
              <FOR_EACH SelectList="$grpLineFilters/FILTER/OR/*" CurrentElement="currelem">
                <GET_DOCUMENT AssignToVar="itemresults" Name="P_ItemInterchangeGroupLine" ServiceName="PEDM_MASTER">
                  <SELECT>
                    <RelatedItemIdentifier/>
                    <PrimaryItemIdentifier/>
                  </SELECT>
                  <ItemInterchangeGroupLineNumber Value="{$currelem/@Value}"/>
                  <ItemInterchangeGroupIdentifier Value="{$groupidentifier/P_ItemInterchangeGroup/ItemInterchangeGroupIdentifier/@Value}"/>
                </GET_DOCUMENT>
                <TO_DOCVAR AssignToVar="tempitemidsvar">
                  <abc>
                    <ItemIds Value="{int($itemresults/P_ItemInterchangeGroupLine/RelatedItemIdentifier/@Value)}"/>
                    <ItemIds Value="{int($itemresults/P_ItemInterchangeGroupLine/PrimaryItemIdentifier/@Value)}"/>
                  </abc>
                </TO_DOCVAR>
                <APPEND_TO_XML DocVar="listItemId">
                  <TO_XML SelectList="$tempitemidsvar/*"/>
                </APPEND_TO_XML>
                <IF_TEST Test="$countLines = 0">
                  <THEN>
                    <SET Var="eliminateSqlQuery" FromValue="{concat($eliminateSqlQuery,$currelem/@Value)}"/>
                    <SET Var="countLines" FromValue="1"/>
                  </THEN>
                  <ELSE>
                    <SET Var="eliminateSqlQuery" FromValue="{concat($eliminateSqlQuery,',',$currelem/@Value)}"/>
                  </ELSE>
                </IF_TEST>
              </FOR_EACH>
              <SET Var="eliminateSqlQuery" FromValue="{concat($eliminateSqlQuery,')',' and SYS_ENT_STATE =',$singleQuote,'ACTIVE',$singleQuote)}"/>
            </THEN>
            <ELSE>
              <!--*****************************if single line is selected******************-->
              <GET_DOCUMENT AssignToVar="itemresults" Name="P_ItemInterchangeGroupLine" ServiceName="PEDM_MASTER">
                <SELECT>
                  <RelatedItemIdentifier/>
                  <PrimaryItemIdentifier/>
                </SELECT>
                <ItemInterchangeGroupLineNumber Value="{$thisParam/GroupLineInfo/@Value}"/>
                <ItemInterchangeGroupIdentifier Value="{$groupidentifier/P_ItemInterchangeGroup/ItemInterchangeGroupIdentifier/@Value}"/>
              </GET_DOCUMENT>
              <TO_DOCVAR AssignToVar="tempitemidsvar">
                <abc>
                  <ItemIds Value="{int($itemresults/P_ItemInterchangeGroupLine/RelatedItemIdentifier/@Value)}"/>
                  <ItemIds Value="{int($itemresults/P_ItemInterchangeGroupLine/PrimaryItemIdentifier/@Value)}"/>
                </abc>
              </TO_DOCVAR>
              <APPEND_TO_XML DocVar="listItemId">
                <TO_XML SelectList="$tempitemidsvar/*"/>
              </APPEND_TO_XML>
              <SET Var="eliminateSqlQuery" FromValue="{concat('select DISTINCT loc_id from P_M_ITINGRP_LN_X_LOC where ITINGRP_ID=',$groupidentifier/P_ItemInterchangeGroup/ItemInterchangeGroupIdentifier/@Value,' and ITINGRP_LN_NUM=',$thisParam/GroupLineInfo/@Value,' and SYS_ENT_STATE =',$singleQuote,'ACTIVE',$singleQuote)}"/>
            </ELSE>
          </IF_TEST>
          <!--************************************appending items to the list completed************************************-->
          <SET Var="initialcount" FromValue="1"/>
          <!--****** the first statement in the query is different hence setting the count*********-->
          <SET Var="itemcount" FromValue="{count($listItemId/*[name()='ItemIds'])}"/>
          <FOR_EACH SelectList="$listItemId/*" CurrentElement="currelem">
            <IF_TEST Test="$initialcount='1'">
              <THEN>
                <SET Var="singleQuote" FromValue="'"/>
                <!-- ST:177715 09/08/2008 Sanjeev Halgiri Start -->
                <!-- SET Var="sqlquery" FromValue="{concat('SELECT DISTINCT t.loc_idn_val, t.loc_id, t2.loc_nm_desc,t11.PRTY_IDN_VAL,t11.prty_id,t.loc_id,t9.PRTY_DESC FROM p_m_loc_idn t, p_m_loc_nm t2, p_m_loc_idn_clas t3,p_m_acntr_x_org t6, p_m_acntr t5, p_m_org t8,p_m_prty t9,p_m_prty_idn t11 WHERE t2.loc_id=t.loc_id and t.LOC_IDN_CLAS_ID=t3.loc_idn_clas_id and t3.loc_idn_clas_mn_val=',$singleQuote,$defaultLocationIdnMnemonicVal,$singleQuote,' and t.loc_id IN (SELECT DISTINCT t1.loc_id FROM p_m_loc_x_item t1 WHERE t1.item_id =',$currelem/@Value,' ','AND t1.acntr_id = t5.acntr_id AND t6.acntr_id = t5.acntr_id AND t8.org_prty_id = t6.ORG_PRTY_ID AND t8.org_prty_id = t9.prty_id AND t9.prty_id = t11.prty_id AND t11.PRTY_IDN_VAL !=',$singleQuote,'1000',$singleQuote,' AND t11.PRTY_IDN_VAL !=',$singleQuote,'Project1Up',$singleQuote)}"/ -->
                <SET Var="sqlquery" FromValue="{concat('SELECT DISTINCT t.loc_idn_val, t.loc_id, t2.loc_nm_desc,t11.PRTY_IDN_VAL,t11.prty_id,t.loc_id,t9.PRTY_DESC FROM p_m_loc_idn t, p_m_loc_nm t2, p_m_loc_idn_clas t3,p_m_acntr_x_org t6, p_m_acntr t5, p_m_org t8,p_m_prty t9,p_m_prty_idn t11 WHERE t2.loc_id=t.loc_id and t.LOC_IDN_CLAS_ID=t3.loc_idn_clas_id and t3.loc_idn_clas_mn_val=',$singleQuote,$defaultLocationIdnMnemonicVal,$singleQuote,' and t.loc_id IN (SELECT DISTINCT t1.loc_id FROM p_m_loc_x_item t1 WHERE t1.item_id =',$currelem/@Value,' ','AND t1.acntr_id = t5.acntr_id AND t6.acntr_id = t5.acntr_id AND t8.org_prty_id = t6.ORG_PRTY_ID AND t8.org_prty_id = t9.prty_id AND t9.prty_id = t11.prty_id AND t11.PRTY_IDN_VAL !=',$singleQuote,'1000',$singleQuote,' AND t11.PRTY_IDN_VAL !=',$singleQuote,'Project1Up',$singleQuote,' AND t1.SYS_ENT_STATE !=',$singleQuote,'DELETED',$singleQuote)}"/>
                <!-- ST:177715 09/08/2008 Sanjeev Halgiri End -->
                <SET Var="sqlquery" FromValue="{ifElse(($thisParam/segmentIds/@Value != null) and ($thisParam/segmentIds/@Value !=''),concat($sqlquery,' AND t11.PRTY_IDN_VAL =',$singleQuote,substringBefore($thisParam/segmentIds/@Value,'-'),$singleQuote,' AND LOC_ID IN','('),concat($sqlquery,' AND LOC_ID IN','('))}"/>
                <SET Var="initialcount" FromValue="0"/>
                <SET Var="itemcount" FromValue="{int(int($itemcount)-1)}"/>
                <SET Var="leftbrace" FromValue="{concat($leftbrace,')')}"/>
              </THEN>
              <ELSE>
                <IF_TEST Test="$itemcount > '1'">
                  <THEN>
                    <!-- ST:177715 09/08/2008 Sanjeev Halgiri Start -->
                    <!-- SET Var="sqlquery" FromValue="{concat($sqlquery,'select loc_id from P_M_LOC_X_ITEM where item_id=',$currelem/@Value,' ','AND t1.acntr_id = t5.acntr_id AND t6.acntr_id = t5.acntr_id AND t8.org_prty_id = t6.ORG_PRTY_ID AND t8.org_prty_id = t9.prty_id AND t9.prty_id = t11.prty_id AND t11.PRTY_IDN_VAL !=',$singleQuote,'1000',$singleQuote,' AND t11.PRTY_IDN_VAL !=',$singleQuote,'Project1Up',$singleQuote)}"/ -->
                    <SET Var="sqlquery" FromValue="{concat($sqlquery,'select loc_id from P_M_LOC_X_ITEM where item_id=',$currelem/@Value,' ','AND t1.acntr_id = t5.acntr_id AND t6.acntr_id = t5.acntr_id AND t8.org_prty_id = t6.ORG_PRTY_ID AND t8.org_prty_id = t9.prty_id AND t9.prty_id = t11.prty_id AND t11.PRTY_IDN_VAL !=',$singleQuote,'1000',$singleQuote,' AND t11.PRTY_IDN_VAL !=',$singleQuote,'Project1Up',$singleQuote,' AND SYS_ENT_STATE !=',$singleQuote,'DELETED',$singleQuote)}"/>
                    <!-- ST:177715 09/08/2008 Sanjeev Halgiri End -->
                    <SET Var="sqlquery" FromValue="{ifElse(($thisParam/segmentIds/@Value != null) and ($thisParam/segmentIds/@Value !=''),concat($sqlquery,' AND t11.PRTY_IDN_VAL =',$singleQuote,substringBefore($thisParam/segmentIds/@Value,'-'),$singleQuote,' AND LOC_ID IN','('),concat($sqlquery,' AND LOC_ID IN','('))}"/>
                    <SET Var="itemcount" FromValue="{int(int($itemcount)-1)}"/>
                    <SET Var="leftbrace" FromValue="{concat($leftbrace,')')}"/>
                  </THEN>
                  <ELSE>
                    <!-- ST:177715 09/08/2008 Sanjeev Halgiri Start -->
                    <!-- SET Var="sqlquery" FromValue="{concat($sqlquery,'select loc_id from P_M_LOC_X_ITEM where item_id=',$currelem/@Value,' AND t1.acntr_id = t5.acntr_id AND t6.acntr_id = t5.acntr_id AND t8.org_prty_id = t6.ORG_PRTY_ID AND t8.org_prty_id = t9.prty_id AND t9.prty_id = t11.prty_id AND t11.PRTY_IDN_VAL !=',$singleQuote,'1000',$singleQuote,' AND t11.PRTY_IDN_VAL !=',$singleQuote,'Project1Up',$singleQuote)}"/ -->
                    <SET Var="sqlquery" FromValue="{concat($sqlquery,'select loc_id from P_M_LOC_X_ITEM where item_id=',$currelem/@Value,' AND t1.acntr_id = t5.acntr_id AND t6.acntr_id = t5.acntr_id AND t8.org_prty_id = t6.ORG_PRTY_ID AND t8.org_prty_id = t9.prty_id AND t9.prty_id = t11.prty_id AND t11.PRTY_IDN_VAL !=',$singleQuote,'1000',$singleQuote,' AND t11.PRTY_IDN_VAL !=',$singleQuote,'Project1Up',$singleQuote,' AND SYS_ENT_STATE !=',$singleQuote,'DELETED',$singleQuote)}"/>
                    <!-- ST:177715 09/08/2008 Sanjeev Halgiri End -->
                    <SET Var="sqlquery" FromValue="{ifElse(($thisParam/segmentIds/@Value != null) and ($thisParam/segmentIds/@Value !=''),concat($sqlquery,' AND t11.PRTY_IDN_VAL =',$singleQuote,substringBefore($thisParam/segmentIds/@Value,'-'),$singleQuote),$sqlquery)}"/>
                    <SET Var="itemcount" FromValue="{int(int($itemcount)-1)}"/>
                    <SET Var="leftbrace" FromValue="{concat($leftbrace,')')}"/>
                  </ELSE>
                </IF_TEST>
              </ELSE>
            </IF_TEST>
          </FOR_EACH>
          <!--******************query formation is complete***************************-->
          <PRINTLN Value="{$sqlquery}"/>
          <SET Var="sqlquery" FromValue="{concat($sqlquery,$leftbrace,' and t.loc_id NOT IN','(',$eliminateSqlQuery,')')}"/>
          <SET Var="sqlquery" FromValue="{concat($sqlquery,' ','ORDER BY',' ',$sortBy,' ',$sortOrder)}"/>
          <EXECUTE_SQL_QUERY AssignToVar="locationresults" Value="{$sqlquery}" MaxRows="{$pgMaxRows}" StartAtRow="{$paginateStart}" ReturnRowCount="yes"/>
          <TO_DOCVAR AssignToVar="temporarylocdetails">
            <LOC_DETAILS/>
          </TO_DOCVAR>
          <FOR_EACH SelectList="$locationresults/*" CurrentElement="currelem">
            <TO_DOCVAR AssignToVar="locationdetails">
              <abc>
                <LocationIdn Value="{$currelem/LOC_IDN_VAL/@Value}"/>
                <LocationDescription Value="{$currelem/LOC_NM_DESC/@Value}"/>
                <segVal Value="{$currelem/PRTY_IDN_VAL/@Value}"/>
                <segDesc Value="{$currelem/PRTY_DESC/@Value}"/>
              </abc>
            </TO_DOCVAR>
            <APPEND_TO_XML DocVar="temporarylocdetails">
              <TO_XML SelectList="$locationdetails"/>
            </APPEND_TO_XML>
          </FOR_EACH>
          <APPEND_TO_XML DocVar="pglFormInput">
            <TO_XML SelectList="$dropDownSegment"/>
            <TO_XML SelectList="$temporarylocdetails"/>
            <PREV_SEL Value="{$PrevSelected}"/>
            <lineSelected Value="{$lineinfo}"/>
            <FIELD_NAME Value="{$fieldName}"/>
            <segmentValue Value="{$thisParam/segmentIds/@Value}"/>
            <StartAtRow Value="{$paginateStart}"/>
            <MaxRows Value="{$pgMaxRows}"/>
            <TotalRowCount Value="{$locationresults/@TotalRowCount}"/>
          </APPEND_TO_XML>
        </action>
      </pre_actions>
      <if_cond Value="$userAction ='select'">
        <next_nodes OutputVar="{outputXml,xml}"/>
      </if_cond>
      <else_if_cond Value="$userAction ='searchButton'">
        <next_nodes OutputVar="{outputXml,xml}">
          <next_node Name="iscpPiSelectLocation" Description=""/>
        </next_nodes>
      </else_if_cond>
      <else_if_cond Value="true()">
        <next_nodes OutputVar="{outputXml,xml}">
          <next_node Name="done3" Description=""/>
        </next_nodes>
      </else_if_cond>
    </ui_form2>
