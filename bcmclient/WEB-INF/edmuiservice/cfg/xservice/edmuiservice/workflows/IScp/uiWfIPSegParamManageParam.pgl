<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="uiWfIPSegmentParameter.pgl">
  <ui:container id="SearchContainer" displayText="IP Manage Segment Parameters">
    <ui:step id="searchStep">
      <ui:validation successMessage="{$root/SUCCESSMSG/MSG/@Value}" displayCondition="1" />
      <ui:search id="srchSegParams" exportSearch="false" saveSearch="false" collapsable="true" displayText="Search">
        <ui:field-group rows="2">
          <!--<ui:entry-field id="SRCH_PARAM_NAME" name="SRCH_PARAM_NAME" displayText="Parameter Name"/>-->
          <ui:entry-field displayText="Parameter" id="SRCH_PARAM" name="SRCH_PARAM">
            <ui:links>
              <ui:link displayText="Select Parameters" targetType="popup" targetName="orderPopup">
                <ui:image src="pop_up_window.gif" />
                <ui:url page="view.x2ps">
                  <FIELD_NAME select="'SRCH_PARAM'" />
                  <ENTITY_NAME select="'SRCH_PARAM'" />
                  <SELECTABLE select="'All'" />
                  <BUTTON_ID select="'selectParameter'" />
                </ui:url>
              </ui:link>
            </ui:links>
          </ui:entry-field>
          <ui:dropdown id="ENTITYSTATE" name="ENTITYSTATE" displayText="State" defaultValue="ACTIVE">
            <ui:option id="NEW" value="NEW" />
            <ui:option id="ACTIVE" value="ACTIVE" />
            <ui:option id="INACTIVE" value="INACTIVE" />
          </ui:dropdown>
          <ui:entry-field id="SRCH_DESC" name="SRCH_DESC" displayText="Parameter Description" />
          <!--<ui:entry-field id="SRCH_MOD_BY" name="SRCH_MOD_BY" displayText="Modified By" rowSpan="2"/>-->
        </ui:field-group>
        <!--<ui:field-group id="dateRange">
          <ui:date-range displayText="Modified Date" name="SRCH_MOD_DATE" fromDate="{$root/FROM_DATE/@Value}" toDate="{$root/TO_DATE/@Value}"/>
        </ui:field-group>-->
      </ui:search>
      <!--<ui:table id="bottomTable" displayText="RP Segment Parameters" select="$root/line" rowSrc="ROW_DATA" rowId="PARAMETER_NAME" selectable="single" totalRowCount="$root/ROWCNT/@Value" maxRows="5">-->
      <ui:table id="bottomTable" displayText="IP Segment Parameters" select="$root/line" rowSrc="ROW_DATA" rowId="PARAMETER_NAME" selectable="single" totalRowCount="$root/ROWCNT/@Value" maxRows="5">
        <ui:field-group id="tableColumns">
          <ui:display-field name="PARAMETER_NAME" id="PARAMETER_NAME" displayText="Parameter Name" sortable="true" />
          <ui:display-field name="PARAMETER_DESC" id="PARAMETER_DESC" displayText="Parameter Description" />
          <ui:display-field name="PARAMETER_UOM" id="PARAMETER_UOM" displayText="Parameter UOM" />
          <!--          <ui:dropdown name="PARAMETER_UOM" id="PARAMETER_UOM" displayText="UOM" selectOne="true">
            <ui:option id="pct" value="Percent"/>
            <ui:option id="ton" value="Ton"/>
            <ui:option id="kg" value="KiloGrams"/>
            <ui:option id="Integer" value="Integer"/>
            <ui:option id="Pct" value="Pct"/>
          </ui:dropdown>-->
          <ui:entry-field name="COMMENT" id="COMMENT" displayText="Comments" />
          <!-- <ui:display-field name="STATE" id="STATE" displayText="State"/>-->
          <ui:display-field name="MOD_DATE" id="MOD_DATE" displayText="Modified Date" sortable="true" />
          <ui:display-field name="MOD_BY" id="MOD_BY" displayText="Modified By" sortable="true" />
        </ui:field-group>
        <ui:buttons id="tblActions">
          <ui:button id="validValue" name="validValue" displayText="Manage Valid Values" enabledBySelections="true" />
          <ui:button id="Save" name="Save" displayText="Save" enabledBySelections="true" />
        </ui:buttons>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:container id="addNewContainer" displayText="Add New IP Segment Parameter" scrollable="true">
    <ui:step id="bottomStep">
      <ui:validation successMessage="{$root/SUCCESSMSG/MSG/@Value}" />
      <ui:field-group columns="2">
        <ui:field-group id="addNew" rows="3">
          <ui:entry-field name="ADD_PARAM_NAME" id="ADD_PARAM_NAME" displayText="Parameter Name" required="true" />
          <!--        <ui:entry-field name="ADD_PARAM_UOM" id="ADD_PARAM_UOM" displayText="Parameter UOM" required="true"/>-->
          <ui:dropdown displayText="Parameter UOM" id="ADD_PARAM_UOM" name="ADD_PARAM_UOM" required="true" optionSrc="$root/UOM/ID" />
          <ui:textarea name="ADD_COMMENTS" id="ADD_COMMENTS" displayText="Comment" />
          <ui:entry-field name="ADD_PARAM_DESC" id="ADD_PARAM_DESC" displayText="Parameter Description" required="false" />
          <!--     <ui:checkbox name="canOverride" displayText="Can Override?" required="true"/>-->
          <ui:dropdown id="DATATYPE" name="ADD_DATATYPE" displayText="Parameter Data Type" selectOne="true">
            <ui:option id="TEXT" value="TEXT" />
            <ui:option id="NUMBER" value="NUMBER" />
            <ui:option id="BOOLEAN" value="BOOLEAN" />
          </ui:dropdown>
          <ui:checkbox name="ADD_ISVALIDVALUE" displayText="Is Valid Value?" required="true" />
        </ui:field-group>
        <!--       <ui:field-group>
          <ui:dropdown name="LIST_BOX" size="5" displayText="Segment" selectAll="true" select="Single">
            <ui:option id="option1" value="480003800, Quaker Oats Foods"/>
            <ui:option id="option2" value="480004800, Gatorade"/>
            <ui:option id="option3" value="480005800, Tropicana"/>
            <ui:option id="option4" value="480006800, Quaker Oats Foods"/>
            <ui:option id="option5" value="480007800, Gatorade"/>
            <ui:option id="option6" value="480008800, Tropicana"/>
          </ui:dropdown>
        </ui:field-group>-->
      </ui:field-group>
      <ui:buttons>
        <ui:button id="Clear" name="Clear" displayText="Clear" enabledBySelections="true" validate="false" />
        <ui:button id="Add" name="Add" displayText="Add New" enabledBySelections="true" validate="false" />
      </ui:buttons>
    </ui:step>
  </ui:container>
  <ui:script>function onSearch()
      {

		 document.form.BUTTON_ID.value="search_button";
                document.form.submit();
		}</ui:script>
</ui:page-group>

