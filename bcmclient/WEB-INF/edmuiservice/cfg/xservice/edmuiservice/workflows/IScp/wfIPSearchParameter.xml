                <TO_XML SelectList="$ParameterNames/*"/>
              </OR>
              <OR>
                <TO_XML SelectList="$ParameterDesc/*"/>
              </OR>
            </AND>
            <QUERY_DOCUMENT_LINK Name="REL_2483">
              <SELECT>
                <UnitOfMeasureMnemonicValue/>
