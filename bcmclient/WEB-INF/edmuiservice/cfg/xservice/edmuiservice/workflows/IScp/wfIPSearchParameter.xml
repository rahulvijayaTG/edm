                <PARAMETER_DESC Value="{$id/ParameterDescription/@Value}"/>
                <PARAMETER_UOM Value="{$id/UnitOfMeasureMnemonicValue/@Value}"/>
              </ROW_DATA>
            </APPEND_TO_XML>
          </FOR_EACH>
          <PRINTLN Value="Parameters{$ParameterList}"/>
          <SET DocVar="ParameterList" Property="FIELD_NAME" FromValue="{$fieldName}"/>
          <SET DocVar="ParameterList" Property="USER_ID" FromValue="{$userId}"/>
          <SET DocVar="ParameterList" Property="ParameterMnemonicValue" FromValue="{$thisParam/ParameterMnemonicValue/@Value}"/>
          <SET DocVar="ParameterList" Property="ParameterDescription" FromValue="{$thisParam/ParameterDescription/@Value}"/>
          <SET DocVar="ParameterList" Property="TotalRowCount" FromValue="{$parameterLst/@TotalRowCount}"/>
          <SET DocVar="ParameterList" Property="PREV_SEL" FromValue="{substringAfter($prevSel,',')}"/>
          <SET DocVar="pglFormInput" FromDocVar="ParameterList"/>
        </action>
