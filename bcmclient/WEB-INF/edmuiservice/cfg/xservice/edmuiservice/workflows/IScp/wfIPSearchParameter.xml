            </QUERY_DOCUMENT_LINK>
            <ORDER_BY>
              <ParameterMnemonicValue Sort="{$sortOrder/@Value}"/>
            </ORDER_BY>
          </GET_DOC_SMART>
          <SET DocVar="prevSel" FromValue=""/>
          <FOR_EACH SelectList="$thisParam/*" CurrentElement="curElem">
            <IF_TEST Test="name($curElem) = 'SELECTED_ITEM'">
              <THEN>
                <SET DocVar="prevSel" FromValue="{ifElse(contains(prevSel,$curElem/@Value),'',concat($prevSel,',',$curElem/@Value))}"/>
