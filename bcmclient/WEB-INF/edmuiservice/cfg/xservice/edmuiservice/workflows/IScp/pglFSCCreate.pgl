<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="pglFSCCreate.pgl">
  <ui:container id="TopContainer" name="TopContainer" scrollable="true">
    <ui:step id="Main" name="Main" displayText="ISCP Facility Storage Capacity Search and Edit">
      <ui:grid>
        <ui:row>
          <ui:cell>
            <ui:container editable="false" height="100" width="400">
              <ui:step displayText="Planning Horizon" id="top_container" editable="true">
                <ui:grid>
                  <ui:row>
                    <ui:cell>
                      <ui:field-group id="leftFields11">
                        <ui:display-field displayText="Starting Week" id="SWTXT" name="SWTXT" />
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields12">
                        <ui:dropdown id="SWYEAR" name="SWYEAR" optionSrc="$root/YEARLIST/OPTIONS/OPTION" value="{$root/SWYEAR/@Value}" />
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields13">
                        <ui:dropdown id="SWPERIOD" name="SWPERIOD" optionSrc="$root/PERIODLIST/OPTIONS/OPTION" value="{$root/SWPERIOD/@Value}" />
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields14">
                        <ui:dropdown id="SWWEEK" required="true" name="SWWEEK" optionSrc="$root/WEEKLIST/OPTIONS/OPTION" value="{$root/SWWEEK/@Value}" />
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields15">
                        <ui:entry-field editable="fasle" id="SWDATE" style="font-weight:Bold" value="{$root/STARTDATE/@Value}" defaultValue="MM/DD/YYYY" />
                      </ui:field-group>
                    </ui:cell>
                  </ui:row>
                  <ui:row>
                    <ui:cell>
                      <ui:field-group id="leftFields21">
                        <ui:display-field displayText="Ending Week" id="SWTXT" name="SWTXT" />
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields22">
                        <ui:dropdown id="EWYEAR" name="EWYEAR" optionSrc="$root/YEARLIST/OPTIONS/OPTION" value="{$root/EWYEAR/@Value}" />
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields23">
                        <ui:dropdown id="EWPERIOD" name="EWPERIOD" optionSrc="$root/PERIODLIST/OPTIONS/OPTION" value="{$root/EWPERIOD/@Value}" />
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields24">
                        <ui:dropdown id="EWWEEK" required="true" name="EWWEEK" optionSrc="$root/WEEKLIST/OPTIONS/OPTION" value="{$root/EWWEEK/@Value}" />
                      </ui:field-group>
                    </ui:cell>
                    <ui:cell>
                      <ui:field-group id="leftFields25">
                        <ui:entry-field editable="fasle" id="EWDATE" style="font-weight:Bold;" value="{$root/ENDDATE/@Value}" defaultValue="MM/DD/YYYY" />
                      </ui:field-group>
                    </ui:cell>
                  </ui:row>
                </ui:grid>
                <ui:buttons id="buttons">
                  <ui:button id="APPLY" name="APPLY" displayText="Apply" emphasized="true" disabled="{$root/APPENABLE/@Value}" />
                </ui:buttons>
              </ui:step>
            </ui:container>
          </ui:cell>
          <ui:cell>
            <ui:container editable="false" height="100">
              <ui:step displayText="Legends - for individual time buckets (Not across time buckets)" id="top_container" editable="true">
                <ui:field-group showDivider="true">
                  <ui:entry-field id="LGD11" name="LGD11" editable="false" displayText="XX, XXX" displayNoWrap="true" defaultValue="(Location cell) Sum of hard constraint effective units &gt; location's effective units" style="font-weight:Bold;background:#BEC5E7" />
                  <ui:entry-field id="LGD12" name="LGD12" editable="fasle" displayText="XX, XXX" displayNoWrap="true" defaultValue="(Segment cell) Sum of hard constraint effective units &gt; location's effective units" style="font-weight:Bold;color:red;background:yellow" />
                  <ui:entry-field id="LGD13" name="LGD13" editable="fasle" displayText="XX, XXX" displayNoWrap="true" defaultValue="Segment's soft constraint effective units &gt; segment's hard constraint effective units" style="font-weight:Bold;color:red;background:#BEC5E7" />
                </ui:field-group>
              </ui:step>
            </ui:container>
          </ui:cell>
        </ui:row>
      </ui:grid>
      <ui:container id="container2" name="container2" collapsable="true">
        <ui:help displayPage="http://www.i2.com" />
        <ui:step id="Inner" name="Inner" displayText="ISCP Facility Storage Capacity Location Record">
          <ui:field-group id="leftFields">
            <ui:entry-field id="LOC_ID" name="LOC_ID" displayText="Select Location">
              <ui:links>
                <ui:link displayText="Select Customers" targetType="popup" targetName="planPopUp">
                  <ui:image src="pop_up_window.gif" />
                  <ui:url page="start.x2ps">
                    <FIELD_NAME select="'LOCID'" />
                    <ENTITY_NAME select="'LOCID'" />
                    <SELECTABLE select="'All'" />
                    <BUTTON_ID select="'selectLocation'" />
                  </ui:url>
                </ui:link>
              </ui:links>
            </ui:entry-field>
          </ui:field-group>
          <ui:pivot id="pivotLoc" displayText="Location Record" select="$root/REAL_DATA/MULTI_COLLAB_DATA/LOCATION_SLAS" subRowSrc="BUCKETS/BUCKET" rowId="LocationIdentifier" scrollable="true">
            <ui:validation successMessage="{$root/SUCCESSMSG/MSG/@Value}" />
            <ui:table-row select="BUFFER_SLA" />
            <ui:pivot-field axis="row" id="LocationIdentifier" name="LocationIdentifier" displayText="Location" />
            <ui:pivot-field axis="row" id="LOCNAME" name="LOCNAME" displayText="Location Name" />
            <ui:pivot-field axis="row" id="LocationCapacityType" name="LocationCapacityType" displayText="Location Type" />
            <ui:pivot-field axis="row" id="OrganizationXLocationCapacityLimitClassIdentifier" name="OrganizationXLocationCapacityLimitClassIdentifier" displayText="Constraint" />
            <ui:pivot-field axis="row" id="CapacityUnitOfMeasureIdentifier" name="CapacityUnitOfMeasureIdentifier" displayText="Unit of Measure" />
            <ui:pivot-field axis="column" name="FROM_DATE" displayText="" />
            <ui:entry-field name="OrganizationXAllocatedLocationCapacityMeasure" displayText="Units (Rated Capacity)" dataType="Number" align="left" required="true" />
            <!--ui:entry-field name="OrganizationXLocationCapacityTargetUtilizationPercent" id="OrganizationXLocationCapacityTargetUtilizationPercent" displayText="Utilization %" dataType="Number"  align="left" onBlur="javascript:isValidValue(this.value, 'OrganizationXLocationCapacityTargetUtilizationPercent')"/-->
            <ui:entry-field name="OrganizationXLocationCapacityTargetUtilizationPercent" id="OrganizationXLocationCapacityTargetUtilizationPercent" displayText="Utilization %" dataType="Number" align="left" required="true" />
            <ui:display-field name="EFFSTRGUNIT" displayText="Effective Units" dataType="Number" align="left" style="{STYLE/@Value}" />
            <ui:entry-field name="CMMNT" displayText="Comments" align="left" />
          </ui:pivot>
          <ui:buttons>
            <ui:button displayText="Create Location" id="CREATE_LOC" name="CREATE_LOC" />
            <ui:divider />
            <ui:button displayText="Validate" id="VALIDATE_LOC" name="VALIDATE_LOC" />
            <ui:divider />
            <ui:button displayText="Save " id="SAVE_LOC" name="SAVE_LOC" emphasized="true" />
          </ui:buttons>
        </ui:step>
      </ui:container>
      <ui:container id="Container3" name="Container3" collapsable="true">
        <ui:help displayPage="http://www.i2.com" />
        <ui:step id="c1" displayText="ISCP Facility Storage Capacity Segment Record" editable="true">
          <ui:field-group id="leftFields">
            <ui:entry-field id="PRTY_ID" name="PRTY_ID" displayText="Select Segment">
              <ui:links>
                <ui:link displayText="Select Setment" targetType="popup" targetName="planPopUp">
                  <ui:image src="pop_up_window.gif" />
                  <ui:url page="start.x2ps">
                    <FIELD_NAME select="'LOCID'" />
                    <ENTITY_NAME select="'LOCID'" />
                    <SELECTABLE select="'All'" />
                    <BUTTON_ID select="'selectLocation'" />
                  </ui:url>
                </ui:link>
              </ui:links>
            </ui:entry-field>
          </ui:field-group>
          <ui:pivot id="pivotSgmnt" displayText="Segment Record" select="$root/REAL_DATA/MULTI_COLLAB_DATA/SEGMENT_SLAS" subRowSrc="BUCKETS/BUCKET" scrollable="true">
            <ui:validation successMessage="{$root/SUCCESSMSG/MSG/@Value}" />
            <ui:table-row select="BUFFER_SLA" />
            <ui:pivot-field axis="row" id="OrganizationPartyIdentifier" name="OrganizationPartyIdentifier" displayText="Segment" />
            <ui:pivot-field axis="row" id="SGMNAME" name="SGMNAME" displayText="Segment Name" />
            <ui:pivot-field axis="row" id="OrganizationXLocationCapacityLimitClassIdentifier" name="OrganizationXLocationCapacityLimitClassIdentifier" displayText="Constraint" />
            <ui:pivot-field axis="row" id="CapacityUnitOfMeasureIdentifier" name="CapacityUnitOfMeasureIdentifier" displayText="Unit of Measure" />
            <ui:pivot-field axis="column" name="FROM_DATE" displayText="" />
            <ui:entry-field name="OrganizationXAllocatedLocationCapacityMeasure" displayText="Units (Rated Capacity)" dataType="Number" align="left" required="true" />
            <ui:entry-field name="OrganizationXLocationCapacityTargetUtilizationPercent" id="OrganizationXLocationCapacityTargetUtilizationPercent" displayText="Utilization %" dataType="Number" align="left" required="true" />
            <ui:display-field name="EFFSTRGUNIT" displayText="Effective Units" dataType="Number" align="left" style="{STYLE/@Value}" />
            <!--ui:entry-field id="OrganizationXLocationCapacityLimitClassIdentifier" name="OrganizationXLocationCapacityLimitClassIdentifier" displayText="Constraint" required="true"/-->
            <ui:entry-field name="CMMNT" displayText="Comments" align="left" />
          </ui:pivot>
          <ui:buttons>
            <ui:button displayText="Create Segment" id="CREATE_SGMNT" name="CREATE_SGMNT" />
            <ui:divider />
            <ui:button displayText="Validate" id="VALIDATE_SGMNT" name="VALIDATE_SGMNT" />
            <ui:divider />
            <ui:button displayText="Save " id="SAVE_SGMNT" name="SAVE_SGMNT" emphasized="true" />
          </ui:buttons>
        </ui:step>
      </ui:container>
    </ui:step>
  </ui:container>
</ui:page-group>