            <ORDER_BY>
              <ItemInterchangeGroupStatusMnemonicValue sort="Ascending"/>
            </ORDER_BY>
          </GET_DOCUMENT>
          <FOR_EACH CurrentElement="currentStatus" SelectList="$ItemStatsCaps/P_ItemInterchangeGroupStatus/*">
