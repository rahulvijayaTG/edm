                  <SET Var="counthidden" FromValue="1"/>
                </THEN>
                <ELSE>
                  <SET Var="counthidden" FromValue="0"/>
                </ELSE>
              </IF_TEST>
            </THEN>
          </IF_TEST>
          <!--*********************************************************************************************-->
          <IF_TEST Test="$userAction='save_button'">
            <THEN>
              <TO_DOCVAR AssignToVar="updategrpvar">
                <ROOT>
                  <DOCUMENT_CONTEXT>
                    <InterchangeabilityGroupValue Value="{$thisParam/GrpId/@Value}"/>
                  </DOCUMENT_CONTEXT>
                  <UPDATE_PROPERTIES>
                    <InterchangeabilityGroupStatusValue Value="{$thisParam/GrpSts/@Value}"/>
                    <InterchangeabilityGroupDescription Value="{$thisParam/GrpDesc/@Value}"/>
                    <!--QC:20768, Venkat, 06/24/2008, Start-->
                    <SOURCE Value="UI"/>
                    <SYS_TYPE Value="UPDATE"/>
                    <SourceKeyValue Value="{$thisParam/GrpId/@Value}"/>
                    <!--QC:20768, Venkat, 06/24/2008, End-->
                  </UPDATE_PROPERTIES>
                  <DOCUMENTNAME Value="E_ProductInterchangeabilityGroupMaster"/>
                  <ACTIONTOBDONE Value="UPDATE"/>
                </ROOT>
              </TO_DOCVAR>
              <REQUEST Name="ruleupdatePiGrpPedmOutbound" ServiceName="PEDM_MASTER" AssignToVar="thisReturn" HandleException="true">
                <TO_XML SelectList="$updategrpvar/*"/>
              </REQUEST>
              <IF_TEST Test="($thisReturn/RESPONSE/_RESULT/@Value='SEVERE_ERROR')">
                <THEN>
                  <TO_DOCVAR AssignToVar="error">
                    <_ERROR Value="{$thisReturn/RESPONSE/_RESULT/_ERROR/@Value}"/>
                  </TO_DOCVAR>
                  <APPEND_TO_XML DocVar="errors">
                    <TO_XML SelectList="$error"/>
                  </APPEND_TO_XML>
                </THEN>
                <ELSE>
                  <TO_DOCVAR AssignToVar="successmessage1">
                    <message Value="Record updated Successfully"/>
                  </TO_DOCVAR>
                  <SET Var="statusfrompopup" FromValue="{$thisParam/GrpSts/@Value}"/>
                  <APPEND_TO_XML DocVar="successmessage">
                    <TO_XML SelectList="$successmessage1"/>
                  </APPEND_TO_XML>
                </ELSE>
              </IF_TEST>
            </THEN>
          </IF_TEST>
        </action>
      </post_actions>
