          <SET Var="grpdesc" FromValue="{$thisParam/GrpDesc/@Value}"/>
          <SET Var="grpid" FromValue="{$thisParam/GrpId/@Value}"/>
          <SET Var="grpsts" FromValue="{$thisParam/GrpSts/@Value}"/>
