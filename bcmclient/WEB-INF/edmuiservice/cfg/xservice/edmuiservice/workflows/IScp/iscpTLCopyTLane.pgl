<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="TLCopyTLane.pgl">
  <ui:container id="cnt" scrollable="true">
    <ui:step id="stp" displayText="Copy Transportation Lane">
      <ui:validation anyFieldIsRequired="true" />
      <ui:field-group columns="2" id="fg" select="$root/COPIED_VALUES">
        <ui:hidden-field id="SELECTED_TL_ID" name="SELECTED_TL_ID" />
        <ui:hidden-field id="START_COUNT" name="START_COUNT" />
        <ui:entry-field name="OriginLocationIdn" displayText="Source Location Number" required="true">
          <ui:links>
            <ui:link displayText="Select Location" targetType="popup" targetName="catalogPopup">
              <ui:url page="view.x2ps">
                <SELECTABLE select="'Single'" />
                <BUTTON_ID select="'Src_Loc_Copy'" />
                <FIELD_NAME select="'OriginLocationIdn'" />
                <POPULATE_LOC_NAME select="'SrcLocationName'" />
              </ui:url>
              <ui:image src="pop_up_window.gif" />
            </ui:link>
          </ui:links>
        </ui:entry-field>
        <!--  <ui:entry-field name="SrcLocationName" displayText="Source Location Name" readOnly="true"/>-->
        <ui:entry-field name="DestinationLocationIdn" displayText="Destination Location Number" required="true">
          <ui:links>
            <ui:link displayText="Select Location" targetType="popup" targetName="catalogPopup">
              <ui:url page="view.x2ps">
                <SELECTABLE select="'Single'" />
                <BUTTON_ID select="'Destn_Loc_Copy'" />
                <FIELD_NAME select="'DestinationLocationIdn'" />
                <POPULATE_LOC_NAME select="'DestnLocationName'" />
              </ui:url>
              <ui:image src="pop_up_window.gif" />
            </ui:link>
          </ui:links>
        </ui:entry-field>
        <!-- <ui:entry-field name="DestnLocationName" displayText="Destination Location Name" readOnly="true"/>-->
        <ui:dropdown displayText="Transport Mode" name="TransportModeIdentifier" optionSrc="$root/TL_MODES/*" selectOne="true" required="true" />
        <ui:dropdown displayText="Lane Type" name="TransportLaneClassIdentifier" optionSrc="$root/TL_CLASS/*" selectOne="true" required="true" />
        <!--        <ui:entry-field displayText="Lane Start Date" name="TransportLaneStartDate" dataType="Date" required="false"/>
        <ui:entry-field displayText="Lane End Date" name="TransportLaneEndDate" dataType="Date" required="false"/>-->
        <ui:entry-field displayText="Lane Duration (hours)" name="TransportDurationTimeCount" required="true" dataType="Number" decimals="0" maxlength="11" unFormat="true" align="left" minValue="0" />
        <!-- onChange="javascript:validateTime();" -->
        <ui:textarea displayText="Comments" name="TransportLaneCommentText" required="false" />
      </ui:field-group>
      <ui:buttons id="btnList" name="btnList">
        <!-- RIC: 240988 Praneeth - Cancel button wording changes request - Start -->
        <ui:button displayText="Back to Search" id="cancel" name="cancel" validate="false" />
        <!-- RIC: 240988 Praneeth - Cancel button wording changes request - End -->
        <ui:button displayText="Save" id="save_copy" name="save_copy" />
      </ui:buttons>
    </ui:step>
  </ui:container>
  <ui:script>function validateTime() {
		var laneDuration = document.form.TransportDurationTimeCount.value;
		var arrDurn = laneDuration.split(":");
		var pattern = new RegExp(/([0-9]{1,2})([:]{1})([0-9]{2})([:]{1})([0-9]{2})/);
    		if(!pattern.test(laneDuration) || arrDurn.length &gt; 3 || arrDurn[2].match(/\D/)){
		       core_alert("Invalid value entered for Lane Duration. It should be in hh:mm:ss format!");
		       document.form.TransportDurationTimeCount.focus();
  		       i2uiToggleButtonState('save_copy', 'disabled');			
		       return;
		}
		if(arrDurn[0].search(/\./) != -1 || arrDurn[0]  &lt; 0 || arrDurn[0].match(/\D/)){
		       core_alert("Lane Duration should be a positive integer!");
		       document.form.TransportDurationTimeCount.focus();
		       i2uiToggleButtonState('save_copy', 'disabled');			
		       return;
		}				
		if(arrDurn[1]  &gt; 59){
		       core_alert("Minutes should not be greater than 59!");
		       document.form.TransportDurationTimeCount.focus();
		       i2uiToggleButtonState('save_copy', 'disabled');			
		       return;
		}
		if( arrDurn[2] &gt; 59){
		       core_alert("Seconds should not be greater than 59!");
		       document.form.TransportDurationTimeCount.focus();
 		       i2uiToggleButtonState('save_copy', 'disabled');			
							return;
					}		
		if(arrDurn[0] &lt;=0 &amp;&amp; arrDurn[1] &lt;=0 &amp;&amp; arrDurn[2] &lt;=0){
		       core_alert("Invalid value entered for Lane Duration. It should not be 00:00:00!");
		       document.form.TransportDurationTimeCount.focus();
 		       i2uiToggleButtonState('save_copy', 'disabled');			
							return;
					}				
    else{	
   		       i2uiToggleButtonState('save_copy', 'enabled');		
		}
		}
		function on_save_copy(){
 var bIsValid = true;
 document.form.SUBMIT_AS_XML.value = 'false';

bIsValid = (isValid_stp());
 
if( bIsValid == false )
{
  validation_alert('stp');
}
if ( bIsValid == true) 
{
		var laneDuration = document.form.TransportDurationTimeCount.value;
		var arrDurn = laneDuration.split(":");
		var pattern = new RegExp(/([0-9]{1,2})([:]{1})([0-9]{2})([:]{1})([0-9]{2})/);
				if(arrDurn[0] &lt;=0 &amp;&amp; arrDurn[1] &lt;=0 &amp;&amp; arrDurn[2] &lt;=0){
		       core_alert("Invalid value entered for Lane Duration. It should not be 00:00:00!");
		       document.form.TransportDurationTimeCount.focus();
 		      // i2uiToggleButtonState('save_copy', 'disabled');			
							return;
					}		
		else{
 disableButtons(); 
 trapExcelPivotChanges(); 
document.form.BUTTON_ID.value = 'save_copy'; 
document.form.action = 'view.x2ps';
document.form.submit();  
		}
}

onResize();  
return; 		
		}
