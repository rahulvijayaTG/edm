					if (Date.parse(startDate) &gt; Date.parse(endDate)) {
							core_alert("Invalid Date Range,Start Date cannot be after End Date!")
							return;
					}		
		      if(transDuration.indexOf(".") &gt; 0){
						core_alert("Transportation Duration in decimals will be rounded off!");
     		   }
			document.form.BUTTON_ID.value = 'save_copy'; 
			document.form.action = 'view.x2ps';
			document.form.submit();  		
		}*/</ui:script>
</ui:page-group>

