      <pre_actions>
        <action>
          <SET Var="sortBy" FromValue="ItemInterchangeGroupLineNumber"/>
          <SET Var="sortOrder" FromValue="{ifElse((($thisParam/SORT_ORDER/@Value = null) or ($thisParam/SORT_BY/@Value = 'ID')), 'Ascending', $thisParam/SORT_ORDER/@Value)}"/>
          <MAKE_INSTANCE_DOCUMENT Name="{$sortBy}" AssignToVar="sortByTag"/>
          <SET DocVar="sortByTag" Attribute="Sort" FromValue="{$sortOrder}"/>
          <TO_DOCVAR AssignToVar="pglFormInput">
            <LineValues/>
            <abc/>
          </TO_DOCVAR>
          <SET Var="dataPaginateStart" FromValue="{ifElse($thisParam/START_COUNT/@Value = null, '0', $thisParam/START_COUNT/@Value)}"/>
          <SET Var="dataPgMaxRows" FromValue="{ifElse($thisParam/MAX_ROWS/@Value = null, '10', $thisParam/MAX_ROWS/@Value)}"/>
          <GET_DOCUMENT Name="P_ItemIdentificationClass" AssignToVar="ItemIdnClassId" ServiceName="PEDM_MASTER">
            <ItemIdentificationClassMnemonicValue Value="{$defaultitemIdentificationClassMnemonicValue}"/>
          </GET_DOCUMENT>
          <GET_DOCUMENT AssignToVar="ItemInterchangeGroupIdentifier" ServiceName="PEDM_MASTER" Name="P_ItemInterchangeGroup">
            <SELECT>
              <ItemInterchangeGroupIdentifier/>
            </SELECT>
            <ItemInterchangeGroupMnemonicValue Value="{$groupidentification}"/>
          </GET_DOCUMENT>
          <GET_DOCUMENT Name="P_ItemInterchangeGroupLine" ServiceName="PEDM_MASTER" AssignToVar="LineResults" MaxRows="{$dataPgMaxRows}" ReturnRowCount="yes" StartAtRow="{$dataPaginateStart}">
            <SELECT>
              <RelatedItemIdentifier/>
              <PrimaryItemIdentifier/>
              <ItemInterchangeGroupLineNumber/>
              <ConversionFactorRate/>
              <ItemInterchangeReasonIdentifier/>
            </SELECT>
            <ItemInterchangeGroupIdentifier Value="{$ItemInterchangeGroupIdentifier/P_ItemInterchangeGroup/ItemInterchangeGroupIdentifier/@Value}"/>
            <ORDER_BY>
              <TO_XML DocVar="sortByTag"/>
            </ORDER_BY>
          </GET_DOCUMENT>
          <FOR_EACH SelectList="$LineResults/P_ItemInterchangeGroupLine" CurrentElement="currelem">
            <IF_TEST Test="$thisParam/LineIdentification/@Value !=null">
              <THEN>
                <SET Var="prevselected" FromValue="{ifElse($prevselected ='',int($thisParam/LineIdentification/@Value),concat($prevselected,',',int($thisParam/LineIdentification/@Value)))}"/>
              </THEN>
            </IF_TEST>
            <!-- MYANG RIC 271805 - PI default values sort order Start -->
            <GET_DOCUMENT AssignToVar="interchangereason" ServiceName="PEDM_MASTER" Name="P_ItemInterchangeReason">
              <SELECT>
                <ItemInterchangeReasonMnemonicValue/>
                <ItemInterchangeReasonName/>
              </SELECT>
              <ItemInterchangeReasonIdentifier Value="{$currelem/ItemInterchangeReasonIdentifier/@Value}"/>
              <ORDER_BY>
                <ItemInterchangeReasonMnemonicValue sort="Ascending"/>
              </ORDER_BY>
            </GET_DOCUMENT>
            <!-- MYANG RIC 271805 - PI default values sort order End -->
            <GET_DOCUMENT AssignToVar="predItemIdnResults" Name="P_ItemIdentification" ServiceName="PEDM_MASTER">
              <SELECT>
                <ItemIdentificationValue/>
                <ItemIdentificationValueDescription/>
              </SELECT>
              <!-- QC Defect : 20772, Venkat Mekala, 04/02/08  Code Start-->
              <QUERY_DOCUMENT_LINK Name="REL_947">
                <SELECT>
                  <ItemName/>
                </SELECT>
                <ItemIdentifier Value="{$currelem/RelatedItemIdentifier/@Value}"/>
              </QUERY_DOCUMENT_LINK>
              <!-- QC Defect : 20772, Venkat Mekala, 04/02/08  Code End-->
              <ItemIdentifier Value="{$currelem/RelatedItemIdentifier/@Value}"/>
              <ItemIdentificationClassIdentifier Value="{$ItemIdnClassId/P_ItemIdentificationClass/ItemIdentificationClassIdentifier/@Value}"/>
            </GET_DOCUMENT>
            <GET_DOCUMENT AssignToVar="succssItemIdnResults" Name="P_ItemIdentification" ServiceName="PEDM_MASTER">
              <SELECT>
                <ItemIdentificationValue/>
                <ItemIdentificationValueDescription/>
              </SELECT>
              <!-- QC Defect : 20772, Venkat Mekala, 04/02/08 Code Start -->
              <QUERY_DOCUMENT_LINK Name="REL_947">
                <SELECT>
                  <ItemName/>
                </SELECT>
                <ItemIdentifier Value="{$currelem/PrimaryItemIdentifier/@Value}"/>
              </QUERY_DOCUMENT_LINK>
              <!-- QC Defect : 20772, Venkat Mekala, 04/02/08 Code End -->
              <ItemIdentifier Value="{$currelem/PrimaryItemIdentifier/@Value}"/>
              <ItemIdentificationClassIdentifier Value="{$ItemIdnClassId/P_ItemIdentificationClass/ItemIdentificationClassIdentifier/@Value}"/>
            </GET_DOCUMENT>
            <TO_DOCVAR AssignToVar="myLineVar">
              <abc>
                <LineIdn Value="{int($currelem/ItemInterchangeGroupLineNumber/@Value)}"/>
                <predprodIdn Value="{$predItemIdnResults/P_ItemIdentification/ItemIdentificationValue/@Value}"/>
                <!-- QC Defect : 20772, Venkat Mekala, 04/02/08  Code Start -->
                <!--<predprodDesc Value="{$predItemIdnResults/P_ItemIdentification/ItemIdentificationValueDescription/@Value}"/>-->
                <predprodDesc Value="{$predItemIdnResults/P_ItemIdentification/ItemName/@Value}"/>
                <!-- QC Defect : 20772, Venkat Mekala, 04/02/08  Code End -->
                <succssprodIdn Value="{$succssItemIdnResults/P_ItemIdentification/ItemIdentificationValue/@Value}"/>
                <!-- QC Defect : 20772, Venkat Mekala, 04/02/08  Code Start -->
                <!--<succssprodDesc Value="{$succssItemIdnResults/P_ItemIdentification/ItemIdentificationValueDescription/@Value}"/>-->
                <succssprodDesc Value="{$succssItemIdnResults/P_ItemIdentification/ItemName/@Value}"/>
                <!-- QC Defect : 20772, Venkat Mekala, 04/02/08  Code End -->
                <conversionFactor Value="{$currelem/ConversionFactorRate/@Value}"/>
                <interchangeReason Value="{concat($interchangereason/P_ItemInterchangeReason/ItemInterchangeReasonMnemonicValue/@Value,'-',$interchangereason/P_ItemInterchangeReason/ItemInterchangeReasonName/@Value)}"/>
              </abc>
            </TO_DOCVAR>
            <APPEND_TO_XML DocVar="pglFormInput">
              <TO_XML DocVar="myLineVar"/>
            </APPEND_TO_XML>
          </FOR_EACH>
          <TO_DOCVAR AssignToVar="fieldname">
            <SEARCH_FIELDS>
              <FIELD_NAME Value="{$FIELD_NAME}"/>
              <FIELD_NAME_PREDID Value="{$FIELD_NAME_PREDID}"/>
              <FIELD_NAME_PREDDESC Value="{$FIELD_NAME_PREDDESC}"/>
              <FIELD_NAME_SUCCSSID Value="{$FIELD_NAME_SUCCSSID}"/>
              <FIELD_NAME_SUCCSSDESC Value="{$FIELD_NAME_SUCCSSDESC}"/>
              <FIELD_NAME_CONVERSION_RATIO Value="{$FIELD_NAME_CONVERSION_RATIO}"/>
              <FIELD_NAME_INTERCHANGE_REASON Value="{$FIELD_NAME_INTERCHANGE_REASON}"/>
              <STEP_ID Value="{$STEP_ID}"/>
              <selectvalue Value="{$selectvalue}"/>
              <prevselected Value="{$prevselected}"/>
              <START_AT_ROW Value="{$dataPaginateStart}"/>
              <MAX_ROWS Value="{$dataPgMaxRows}"/>
              <TOTAL_ROW_COUNT Value="{$LineResults/@TotalRowCount}"/>
            </SEARCH_FIELDS>
          </TO_DOCVAR>
          <APPEND_TO_XML DocVar="pglFormInput">
            <TO_XML DocVar="fieldname"/>
          </APPEND_TO_XML>
        </action>
      </pre_actions>
