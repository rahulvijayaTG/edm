<?xml version="1.0" encoding="UTF-8"?>
<workflow mgcCount="13" ShowInBreadCrumbs="true" Version="1.0" Name="uiWfFscCreate" Description="" Type="" PrimaryDocument="" IsStartAllowed="Yes">
  <variables>
    <variable Name="finalIndex" Type="int" Comment=""/>
    <variable Name="locationCreated" Type="string" Comment=""/>
    <variable Name="strEndDate" Type="string" Comment=""/>
    <variable Name="strStartDate" Type="string" Comment=""/>
    <variable Name="xmlLocationBucketForCreate" Type="xml" Comment=""/>
    <variable Name="xmlWklyBktInfo" Type="xml" Comment=""/>
    <variable Name="xmlSuccessMsg" Type="xml" Comment=""/>
    <variable Name="xmlErrorMsg" Type="xml" Comment=""/>
    <variable Name="selectListWeek" Type="xml" Comment=""/>
    <variable Name="selectListYear" Type="xml" Comment=""/>
    <variable Name="selectListPeriod" Type="xml" Comment=""/>
    <variable Name="strSWYEAR" Type="string" Comment=""/>
    <variable Name="strSWPERIOD" Type="string" Comment=""/>
    <variable Name="strSWWEEK" Type="string" Comment=""/>
    <variable Name="strEWYEAR" Type="string" Comment=""/>
    <variable Name="strEWPERIOD" Type="string" Comment=""/>
    <variable Name="strEWWEEK" Type="string" Comment=""/>
    <variable Name="strRefSoftCnsrnt" Type="string" Comment=""/>
    <variable Name="strRefHardCnsrnt" Type="string" Comment=""/>
  </variables>
  <nodes>
    <start Name="start">
      <actions>
        <action>
          <REQUEST Name="getDropDownForUI" AssignToVar="xmlSelectLists" HandleException="true" ServiceName="PEDM_MASTER"/>
          <PRINTLN Value="select list is {$xmlSelectLists}"/>
          <TO_DOCVAR AssignToVar="selectListPeriod">
            <ROOT>
              <OPTIONS/>
            </ROOT>
          </TO_DOCVAR>
          <SET Var="optionsPeriodVar" FromSelect="$selectListPeriod/OPTIONS"/>
          <TO_DOCVAR AssignToVar="selectListYear">
            <ROOT>
              <OPTIONS/>
            </ROOT>
          </TO_DOCVAR>
          <SET Var="optionsYearVar" FromSelect="$selectListYear/OPTIONS"/>
          <TO_DOCVAR AssignToVar="selectListWeek">
            <ROOT>
              <OPTIONS/>
            </ROOT>
          </TO_DOCVAR>
          <SET Var="optionsWeekVar" FromSelect="$selectListWeek/OPTIONS"/>
          <FOR_EACH CurrentElement="currOption" SelectList="$xmlSelectLists/P_CalendarPeriod">
            <TO_DOCVAR AssignToVar="currOptionVar">
              <ROOT>
                <OPTION Value="{$currOption/CalendarPeriodName/@Value}"/>
              </ROOT>
            </TO_DOCVAR>
            <APPEND_CHILDREN DocVar="optionsPeriodVar" FromDocVar="currOptionVar"/>
          </FOR_EACH>
          <FOR_EACH CurrentElement="currOption" SelectList="$xmlSelectLists/P_CalendarWeek">
            <TO_DOCVAR AssignToVar="currOptionVar">
              <ROOT>
                <OPTION Value="{$currOption/CalendarWeekName/@Value}"/>
              </ROOT>
            </TO_DOCVAR>
            <APPEND_CHILDREN DocVar="optionsWeekVar" FromDocVar="currOptionVar"/>
          </FOR_EACH>
          <FOR_EACH CurrentElement="currOption" SelectList="$xmlSelectLists/P_CalendarYear">
            <TO_DOCVAR AssignToVar="currOptionVar">
              <ROOT>
                <OPTION Value="{substringAfter($currOption/CalendarYearMnemonicValue/@Value, '_')}"/>
              </ROOT>
            </TO_DOCVAR>
            <APPEND_CHILDREN DocVar="optionsYearVar" FromDocVar="currOptionVar"/>
          </FOR_EACH>
        </action>
      </actions>
      <next_nodes>
        <next_node Name="FSC Create" Description=""/>
      </next_nodes>
    </start>
    <done Name="done">
      <actions>
      </actions>
      <next_nodes/>
    </done>
    <ui_form2 Name="FSC Create" InputFormVar="pglFormInput" OutputFormVar="pglFormOutput" ShowInBreadCrumbs="SHOW" Template="pglFSCCreate.pgl">
      <pre_actions>
        <action>
          <TO_DOCVAR AssignToVar="pglFormInput">
            <SAMPLE_XML>
              <YEARLIST/>
              <WEEKLIST/>
              <PERIODLIST/>
              <APPENABLE Value="false"/>
            </SAMPLE_XML>
          </TO_DOCVAR>
          <APPEND_TO_XML Select="$pglFormInput/WEEKLIST">
            <TO_XML SelectList="$selectListWeek/*"/>
          </APPEND_TO_XML>
          <APPEND_TO_XML Select="$pglFormInput/YEARLIST">
            <TO_XML SelectList="$selectListYear/*"/>
          </APPEND_TO_XML>
          <APPEND_TO_XML Select="$pglFormInput/PERIODLIST">
            <TO_XML SelectList="$selectListPeriod/*"/>
          </APPEND_TO_XML>
          <IF_TEST Test="$userAction = 'APPLY'">
            <THEN>
              <!-- Getting all the date between provided search criteria Start -->
              <REQUEST Name="getMainDateData" AssignToVar="xmlMainDateData" HandleException="true" ServiceName="PEDM_MASTER">
                <SWYEAR Value="{$thisParam/SWYEAR/@Value}"/>
                <SWPERIOD Value="{$thisParam/SWPERIOD/@Value}"/>
                <SWWEEK Value="{$thisParam/SWWEEK/@Value}"/>
                <EWYEAR Value="{$thisParam/EWYEAR/@Value}"/>
                <EWPERIOD Value="{$thisParam/EWPERIOD/@Value}"/>
                <EWWEEK Value="{$thisParam/EWWEEK/@Value}"/>
              </REQUEST>
              <SET Var="strSWYEAR" FromValue="{$thisParam/SWYEAR/@Value}"/>
              <SET Var="strSWPERIOD" FromValue="{$thisParam/SWPERIOD/@Value}"/>
              <SET Var="strSWWEEK" FromValue="{$thisParam/SWWEEK/@Value}"/>
              <SET Var="strEWYEAR" FromValue="{$thisParam/EWYEAR/@Value}"/>
              <SET Var="strEWPERIOD" FromValue="{$thisParam/EWPERIOD/@Value}"/>
              <SET Var="strEWWEEK" FromValue="{$thisParam/EWWEEK/@Value}"/>
              <SET Var="strStartDate" FromValue="{substringBefore($xmlMainDateData/STRTDATE/@Value, ' ')}"/>
              <SET Var="strEndDate" FromValue="{substringBefore($xmlMainDateData/ENDDATE/@Value, ' ')}"/>
              <SET Var="xmlWklyBktInfo" FromVar="{$xmlMainDateData}"/>
              <!--SET Property="ENABLECRTLOCBTN" DocVar="pglFormInput" FromValue="true"/-->
            </THEN>
            <ELSE/>
          </IF_TEST>
          <IF_TEST Test="$userAction='CREATE_LOC'">
            <THEN>
              <REQUEST Name="isLocRecExists" AssignToVar="thisReturn" HandleException="true" ServiceName="PEDM_MASTER">
                <TO_XML SelectList="$thisParam/*"/>
              </REQUEST>
              <IF_TEST Test="$thisReturn/_RESULT/@Value = 'SUCCESS'">
                <!--IF_TEST Test="$thisReturn/_RESULT/@Value != 'SUCCESS'" put this validation for actual-->
                <THEN>
                  <PRINTLN Value="ate"/>
                  <TO_DOCVAR AssignToVar="xmlMainLocData">
                    <SAMPLE_XML>
                      <REAL_DATA>
                        <MULTI_COLLAB_DATA>
                          <LOCATION_SLAS/>
                        </MULTI_COLLAB_DATA>
                      </REAL_DATA>
                    </SAMPLE_XML>
                  </TO_DOCVAR>
                  <SET Var="locationCreated" FromValue="{$thisParam/LOC_ID/@Value}"/>
                  <REQUEST Name="getLocationDetails" AssignToVar="xmlLocDtls" HandleException="true" ServiceName="PEDM_MASTER">
                    <LOC_ID Value="{$thisParam/LOC_ID/@Value}"/>
                  </REQUEST>
                  <TO_DOCVAR AssignToVar="xmlLocBuckets">
                    <BUFFER_SLA>
                      <LOCNAME Value="{$xmlLocDtls/LOCNAME/@Value}"/>
                      <CapacityUnitOfMeasureIdentifier Value="{$xmlLocDtls/CapacityUnitOfMeasureIdentifier/@Value}"/>
                      <LocationCapacityType Value="{$xmlLocDtls/LocationCapacityType/@Value}"/>
                      <LocationIdentifier Value="{$thisParam/LOC_ID/@Value}"/>
                      <OrganizationXLocationCapacityLimitClassIdentifier Value="{$xmlLocDtls/OrganizationXLocationCapacityLimitClassIdentifier/@Value}"/>
                      <BUCKETS/>
                    </BUFFER_SLA>
                  </TO_DOCVAR>
                  <FOR_EACH SelectList="$xmlWklyBktInfo/DATEINFO" CurrentElement="wklyBucketTag">
                    <TO_DOCVAR AssignToVar="bucketData">
                      <BUCKET>
                        <FROM_DATE Value="{$wklyBucketTag/STDTWKBKT/@Value}"/>
                        <OrganizationXAllocatedLocationCapacityMeasure Value=""/>
                        <EFFSTRGUNIT Value="0"/>
                        <OrganizationXLocationCapacityTargetUtilizationPercent Value=""/>
                        <OrganizationXLocationCapacityStartDate Value="{$wklyBucketTag/STDTVAL/@Value}"/>
                        <OrganizationXLocationCapacityEndDate Value="{$wklyBucketTag/ENDTVAL/@Value}"/>
                        <LocationIdentifier Value="{$thisParam/LOC_ID/@Value}"/>
                        <LocationCapacityStartDate Value="{$wklyBucketTag/STDTVAL/@Value}"/>
                      </BUCKET>
                    </TO_DOCVAR>
                    <APPEND_TO_XML Select="$xmlLocBuckets/BUCKETS">
                      <TO_XML DocVar="bucketData"/>
                    </APPEND_TO_XML>
                  </FOR_EACH>
                  <APPEND_TO_XML Select="$xmlMainLocData/REAL_DATA/MULTI_COLLAB_DATA/LOCATION_SLAS">
                    <TO_XML DocVar="xmlLocBuckets"/>
                  </APPEND_TO_XML>
                  <SET Var="xmlLocationBucketForCreate" FromVar="{$xmlMainLocData}"/>
                </THEN>
                <ELSE>
                  <PRINTLN Value="need to put error msg that recore exists..."/>
                </ELSE>
              </IF_TEST>
            </THEN>
            <ELSE/>
          </IF_TEST>
          <IF_TEST Test="$userAction='CREATE_SGMNT'">
            <THEN>
              <DELETE_ALL_CHILDREN Select="$xmlLocationBucketForCreate">
                <SEGMENT_SLAS/>
              </DELETE_ALL_CHILDREN>
              <FORM_SEARCH_FILTER Value="{$thisParam}" AssignToVar="sgmntListFilt">
                <PRTY_ID MultiValued="true"/>
              </FORM_SEARCH_FILTER>
              <TO_DOCVAR AssignToVar="sgmntList">
                <ROOT>
                  <OR/>
                </ROOT>
              </TO_DOCVAR>
              <IF_TEST Test="count($sgmntListFilt/FILTER/OR) > 0">
                <THEN>
                  <APPEND_TO_XML Select="$sgmntList/OR">
                    <TO_XML SelectList="$sgmntListFilt/FILTER/OR/*"/>
                  </APPEND_TO_XML>
                </THEN>
                <ELSE>
                  <APPEND_TO_XML Select="$sgmntList/OR">
                    <TO_XML SelectList="$sgmntListFilt/FILTER/*"/>
                  </APPEND_TO_XML>
                </ELSE>
              </IF_TEST>
                  <PRINTLN Value="ate"/>
                  <TO_DOCVAR AssignToVar="xmlMainSegData">
                    <SAMPLE_XML>
                      <SEGMENT_SLAS/>
                    </SAMPLE_XML>
                  </TO_DOCVAR>
              <FOR_EACH CurrentElement="prtyId" SelectList="$sgmntList/OR/PRTY_ID">
                    <!-- Adding Hard Record -->
                    <REQUEST Name="getSegmentDetails" AssignToVar="xmlSegDtls" HandleException="true" ServiceName="PEDM_MASTER">
                      <PRTY_ID Value="{$prtyId/@Value}"/>
                    </REQUEST>
                    <SET Var="strRefSoftCnsrnt" FromValue="{$xmlSegDtls/OrganizationXLocationCapacityLimitClassIdentifierSoft/@Value}"/>
                    <SET Var="strRefHardCnsrnt" FromValue="{$xmlSegDtls/OrganizationXLocationCapacityLimitClassIdentifierHard/@Value}"/>
                    <TO_DOCVAR AssignToVar="xmlSegBuckets">
                      <BUFFER_SLA>
                        <SGMNAME Value="{$xmlSegDtls/SGMNAME/@Value}"/>
                        <CapacityUnitOfMeasureIdentifier Value="{$xmlSegDtls/CapacityUnitOfMeasureIdentifier/@Value}"/>
                        <OrganizationPartyIdentifier Value="{$prtyId/@Value}"/>
                        <OrganizationXLocationCapacityLimitClassIdentifier Value="{$xmlSegDtls/OrganizationXLocationCapacityLimitClassIdentifierHard/@Value}"/>
                        <BUCKETS/>
                      </BUFFER_SLA>
                    </TO_DOCVAR>
                    <FOR_EACH SelectList="$xmlWklyBktInfo/DATEINFO" CurrentElement="wklyBucketTag">
                      <TO_DOCVAR AssignToVar="bucketData">
                        <BUCKET>
                          <FROM_DATE Value="{$wklyBucketTag/STDTWKBKT/@Value}"/>
                          <OrganizationXAllocatedLocationCapacityMeasure Value=""/>
                          <EFFSTRGUNIT Value="0"/>
                          <OrganizationXLocationCapacityTargetUtilizationPercent Value=""/>
                          <OrganizationXLocationCapacityStartDate Value="{$wklyBucketTag/STDTVAL/@Value}"/>
                          <OrganizationXLocationCapacityEndDate Value="{$wklyBucketTag/ENDTVAL/@Value}"/>
                          <LocationIdentifier Value="{$locationCreated}"/>
                          <OrganizationPartyIdentifier Value="{$prtyId/@Value}"/>
                          <LocationCapacityStartDate Value="{$wklyBucketTag/STDTVAL/@Value}"/>
                          <OrganizationXLocationCapacityLimitClassIdentifier Value="{$xmlSegDtls/OrganizationXLocationCapacityLimitClassIdentifierHard/@Value}"/>
                        </BUCKET>
                      </TO_DOCVAR>
                      <APPEND_TO_XML Select="$xmlSegBuckets/BUCKETS">
                        <TO_XML DocVar="bucketData"/>
                      </APPEND_TO_XML>
                    </FOR_EACH>
                    <APPEND_TO_XML Select="$xmlMainSegData/SEGMENT_SLAS">
                      <TO_XML DocVar="xmlSegBuckets"/>
                    </APPEND_TO_XML>
                    <!-- Adding Soft Record -->
                    <TO_DOCVAR AssignToVar="xmlSegBuckets">
                      <BUFFER_SLA>
                        <SGMNAME Value="{$xmlSegDtls/SGMNAME/@Value}"/>
                        <CapacityUnitOfMeasureIdentifier Value="{$xmlSegDtls/CapacityUnitOfMeasureIdentifier/@Value}"/>
                        <OrganizationPartyIdentifier Value="{$prtyId/@Value}"/>
                        <OrganizationXLocationCapacityLimitClassIdentifier Value="{$xmlSegDtls/OrganizationXLocationCapacityLimitClassIdentifierSoft/@Value}"/>
                        <BUCKETS/>
                      </BUFFER_SLA>
                    </TO_DOCVAR>
                    <FOR_EACH SelectList="$xmlWklyBktInfo/DATEINFO" CurrentElement="wklyBucketTag">
                      <TO_DOCVAR AssignToVar="bucketData">
                        <BUCKET>
                          <FROM_DATE Value="{$wklyBucketTag/STDTWKBKT/@Value}"/>
                          <OrganizationXAllocatedLocationCapacityMeasure Value=""/>
                          <EFFSTRGUNIT Value="0"/>
                          <OrganizationXLocationCapacityTargetUtilizationPercent Value=""/>
                          <OrganizationXLocationCapacityStartDate Value="{$wklyBucketTag/STDTVAL/@Value}"/>
                          <OrganizationXLocationCapacityEndDate Value="{$wklyBucketTag/ENDTVAL/@Value}"/>
                          <LocationIdentifier Value="{$locationCreated}"/>
                          <OrganizationPartyIdentifier Value="{$prtyId/@Value}"/>
                          <LocationCapacityStartDate Value="{$wklyBucketTag/STDTVAL/@Value}"/>
                          <OrganizationXLocationCapacityLimitClassIdentifier Value="{$xmlSegDtls/OrganizationXLocationCapacityLimitClassIdentifierSoft/@Value}"/>
                        </BUCKET>
                      </TO_DOCVAR>
                      <APPEND_TO_XML Select="$xmlSegBuckets/BUCKETS">
                        <TO_XML DocVar="bucketData"/>
                      </APPEND_TO_XML>
                    </FOR_EACH>
                    <APPEND_TO_XML Select="$xmlMainSegData/SEGMENT_SLAS">
                      <TO_XML DocVar="xmlSegBuckets"/>
                    </APPEND_TO_XML>
                  </FOR_EACH>
                  <APPEND_TO_XML Select="$xmlLocationBucketForCreate/REAL_DATA/MULTI_COLLAB_DATA">
                    <TO_XML SelectList="$xmlMainSegData/*"/>
                  </APPEND_TO_XML>
                  <!--SET Var="xmlLocationBucketForCreate" FromVar="{$xmlMainLocData}"/-->
              <!--/THEN>
                <ELSE>
                  <PRINTLN Value="need to put error msg that recore exists..."/>
                </ELSE>
              </IF_TEST-->
            </THEN>
            <ELSE/>
          </IF_TEST>
          <SET Property="STARTDATE" DocVar="pglFormInput" FromValue="{$strStartDate}"/>
          <SET Property="ENDDATE" DocVar="pglFormInput" FromValue="{$strEndDate}"/>
          <SET Property="SWYEAR" DocVar="pglFormInput" FromValue="{$strSWYEAR}"/>
          <SET Property="SWPERIOD" DocVar="pglFormInput" FromValue="{$strSWPERIOD}"/>
          <SET Property="SWWEEK" DocVar="pglFormInput" FromValue="{$strSWWEEK}"/>
          <SET Property="EWYEAR" DocVar="pglFormInput" FromValue="{$strEWYEAR}"/>
          <SET Property="EWPERIOD" DocVar="pglFormInput" FromValue="{$strEWPERIOD}"/>
          <SET Property="EWWEEK" DocVar="pglFormInput" FromValue="{$strEWWEEK}"/>
          <!--          <IF_TEST Test="$xmlLocationBucketForCreate != null">
            <THEN>
              <SET Var="pglFormInput" FromVar="{$xmlLocationBucketForCreate}"/>
            </THEN>
            <ELSE/>
          </IF_TEST>-->
          <APPEND_TO_XML DocVar="pglFormInput">
            <TO_XML SelectList="$xmlLocationBucketForCreate/*"/>
          </APPEND_TO_XML>
          <APPEND_TO_XML DocVar="pglFormInput">
            <TO_XML SelectList="$xmlErrorMsg/*"/>
          </APPEND_TO_XML>
          <PRINTLN Value="pglforminput is {$pglFormInput}"/>
        </action>
      </pre_actions>
      <post_actions>
        <action>
          <IF_TEST Test="$userAction = 'VALIDATE_LOC'">
            <THEN>
              <SET Var="index" FromValue="0"/>
              <SET Var="divBy" FromValue="100"/>
              <FOR_EACH CurrentElement="currBucket" SelectList="$xmlLocationBucketForCreate/REAL_DATA/MULTI_COLLAB_DATA/LOCATION_SLAS/BUFFER_SLA/BUCKETS/BUCKET">
                <SET Var="index" FromValue="{$index + 1}"/>
                <SET Var="newCMMNT" FromValue="{$pglFormOutput/CMMNT[$index]/@Value}"/>
                <SET Var="newSTRGCPCTY" FromValue="{$pglFormOutput/OrganizationXAllocatedLocationCapacityMeasure[$index]/@Value}"/>
                <SET Var="newUTLPRCTG" FromValue="{$pglFormOutput/OrganizationXLocationCapacityTargetUtilizationPercent[$index]/@Value}"/>
                <SET Property="CMMNT" DocVar="currBucket" FromValue="{$newCMMNT}"/>
                <SET Property="OrganizationXAllocatedLocationCapacityMeasure" DocVar="currBucket" FromValue="{$newSTRGCPCTY}"/>
                <SET Property="OrganizationXLocationCapacityTargetUtilizationPercent" DocVar="currBucket" FromValue="{$newUTLPRCTG}"/>
                <SET Property="EFFSTRGUNIT" DocVar="currBucket" FromValue="{$newSTRGCPCTY mul $newUTLPRCTG div $divBy}"/>
                <SET Property="OrganizationPartyIdentifier" DocVar="currBucket" FromValue="100000400"/>
              </FOR_EACH>
              <SET Var="finalIndex" FromValue="{$index}"/>
              <FOR_EACH CurrentElement="currBucket" SelectList="$xmlLocationBucketForCreate/REAL_DATA/MULTI_COLLAB_DATA/LOCATION_SLAS/BUFFER_SLA/BUCKETS/BUCKET">
                <REQUEST AssignToVar="xmlUIFormatter" Name="MapUICreateLCLCAndOXLCEdmUI" ServiceName="edmuiservice">
                  <TO_XML SelectList="$currBucket/*"/>
                </REQUEST>
                <REQUEST AssignToVar="formatXml" Name="MapInboundcreateLCAndOXLCPeldm" ServiceName="PEDM_MASTER">
                  <TO_XML SelectList="$xmlUIFormatter/*"/>
                </REQUEST>
                <REQUEST AssignToVar="thisReturn" Name="validateOrgXLocCapacity">
                  <TO_XML SelectList="$formatXml/*"/>
                </REQUEST>
                <IF_TEST Test="count($thisReturn/*/_ERRORS) != 0">
                  <THEN>
                    <IF_TEST Test="substringBefore($thisReturn/_RESULT/_ERROR/@Value, ':') = 'ERR-FSC-CRT-0004'">
                      <THEN>
                        <!--SET_CHILD Value="{$currBucket}" FromValue="{$thisReturn/REQUEST/*}"/-->
                        <SET Var="newUtlPtcg" FromValue="{$currBucket/OrganizationXLocationCapacityTargetUtilizationPercent/@Value}"/>
                        <REMOVE_CHILDREN DocVar="currBucket" ChildName="OrganizationXLocationCapacityTargetUtilizationPercent"/>
                        <ADD_CHILDREN DocVar="currBucket" FromValue="{$thisReturn/REQUEST/OrganizationXLocationCapacityTargetUtilizationPercent}"/>
                        <SET Property="OrganizationXLocationCapacityTargetUtilizationPercent" DocVar="currBucket" FromValue="{$newUtlPtcg}"/>
                      </THEN>
                      <ELSE/>
                    </IF_TEST>
                    <!--<APPEND_TO_XML DocVar="tmpErrorMsg">
                      <_ERRORS Value="{$thisReturn/_RESULT/@Value}">
                        <TO_XML SelectList="$thisReturn/_RESULT/*"/>
                      </_ERRORS>
                    </APPEND_TO_XML>-->
                    <APPEND_TO_XML DocVar="tmpErrorMsg">
                      <TO_XML SelectList="$thisReturn/_RESULT/*"/>
                    </APPEND_TO_XML>
                  </THEN>
                  <ELSE>
                    <SET Var="newUtlPtcg" FromValue="{$currBucket/OrganizationXLocationCapacityTargetUtilizationPercent/@Value}"/>
                    <REMOVE_CHILDREN DocVar="currBucket" ChildName="OrganizationXLocationCapacityTargetUtilizationPercent"/>
                    <SET Property="OrganizationXLocationCapacityTargetUtilizationPercent" DocVar="currBucket" FromValue="{$newUtlPtcg}"/>
                  </ELSE>
                </IF_TEST>
              </FOR_EACH>
            </THEN>
            <ELSE/>
          </IF_TEST>
          <IF_TEST Test="$userAction = 'SAVE_LOC'">
            <THEN>
              <FOR_EACH CurrentElement="currBucket" SelectList="$xmlLocationBucketForCreate/REAL_DATA/MULTI_COLLAB_DATA/LOCATION_SLAS/BUFFER_SLA/BUCKETS/BUCKET">
                <PRINTLN Value="adfda {$thisReturn}"/>
                <REQUEST AssignToVar="thisReturn" Name="validateOrgXLocCapacity">
                  <TO_XML DocVar="currBucket"/>
                </REQUEST>
              </FOR_EACH>
            </THEN>
            <ELSE/>
          </IF_TEST>
          <IF_TEST Test="$userAction = 'VALIDATE_SGMNT'">
            <THEN>
              <SET Var="index" FromValue="{$finalIndex}"/>
              <SET Var="divBy" FromValue="100"/>
              <TO_DOCVAR AssignToVar="tmpErrorMsg">
                <ERRORMSG/>
              </TO_DOCVAR>
              <FOR_EACH CurrentElement="currBucket" SelectList="$xmlLocationBucketForCreate/REAL_DATA/MULTI_COLLAB_DATA/SEGMENT_SLAS/BUFFER_SLA/BUCKETS/BUCKET">
                <SET Var="index" FromValue="{$index + 1}"/>
                <SET Var="newCMMNT" FromValue="{$pglFormOutput/CMMNT[$index]/@Value}"/>
                <SET Var="newSTRGCPCTY" FromValue="{$pglFormOutput/OrganizationXAllocatedLocationCapacityMeasure[$index]/@Value}"/>
                <SET Var="newUTLPRCTG" FromValue="{$pglFormOutput/OrganizationXLocationCapacityTargetUtilizationPercent[$index]/@Value}"/>
                <SET Property="CMMNT" DocVar="currBucket" FromValue="{$newCMMNT}"/>
                <SET Property="OrganizationXAllocatedLocationCapacityMeasure" DocVar="currBucket" FromValue="{$newSTRGCPCTY}"/>
                <SET Property="OrganizationXLocationCapacityTargetUtilizationPercent" DocVar="currBucket" FromValue="{$newUTLPRCTG}"/>
                <SET Property="EFFSTRGUNIT" DocVar="currBucket" FromValue="{$newSTRGCPCTY mul $newUTLPRCTG div $divBy}"/>
              </FOR_EACH>
              <FOR_EACH CurrentElement="currBucket" SelectList="$xmlLocationBucketForCreate/REAL_DATA/MULTI_COLLAB_DATA/SEGMENT_SLAS/BUFFER_SLA/BUCKETS/BUCKET">
                <REQUEST AssignToVar="xmlUIFormatter" Name="MapUICreateOXLCEdmUI" ServiceName="edmuiservice">
                  <TO_XML SelectList="$currBucket/*"/>
                </REQUEST>
                <REQUEST AssignToVar="formatXml" Name="MapInboundcreateOXLCPeldm" ServiceName="PEDM_MASTER">
                  <TO_XML SelectList="$xmlUIFormatter/*"/>
                </REQUEST>
                <REQUEST Name="getLocCapcity" AssignToVar="existingLocCapcity" ServiceName="PEDM_MASTER">
                  <TO_XML SelectList="$formatXml/*"/>
                </REQUEST>
                <SET DocVar="formatXml" Property="LocationCapacityIdentifier" FromValue="{$existingLocCapcity/LC_ID/@Value}"/>
                <REQUEST AssignToVar="thisReturn" Name="validateOrgXLocCapacity">
                  <TO_XML SelectList="$formatXml/*"/>
                </REQUEST>
                <IF_TEST Test="count($thisReturn/*/_ERRORS) != 0">
                  <THEN>
                    <IF_TEST Test="substringBefore($thisReturn/_RESULT/_ERROR/@Value, ':') = 'ERR-FSC-CRT-0009'">
                      <THEN>
                        <SET Property="STYLE" DocVar="currBucket" FromValue="font-weight:Bold;color:red;background:yellow"/>
                      </THEN>
                      <ELSE>
                        <IF_TEST Test="substringBefore($thisReturn/_RESULT/_ERROR/@Value, ':') = 'ERR-FSC-CRT-0011'">
                          <THEN>
                            <SET Property="STYLE" DocVar="currBucket" FromValue="font-weight:Bold;color:red;background:#BEC5E7"/>
                          </THEN>
                          <ELSE>
                            <IF_TEST Test="substringBefore($thisReturn/_RESULT/_ERROR/@Value, ':') = 'ERR-FSC-CRT-0004'">
                              <THEN>
                                <!--SET_CHILD Value="{$currBucket}" FromValue="{$thisReturn/REQUEST/*}"/-->
                                <SET Var="newUtlPtcg" FromValue="{$currBucket/OrganizationXLocationCapacityTargetUtilizationPercent/@Value}"/>
                                <REMOVE_CHILDREN DocVar="currBucket" ChildName="OrganizationXLocationCapacityTargetUtilizationPercent"/>
                                <ADD_CHILDREN DocVar="currBucket" FromValue="{$thisReturn/REQUEST/OrganizationXLocationCapacityTargetUtilizationPercent}"/>
                                <SET Property="OrganizationXLocationCapacityTargetUtilizationPercent" DocVar="currBucket" FromValue="{$newUtlPtcg}"/>
                              </THEN>
                              <ELSE/>
                            </IF_TEST>
                          </ELSE>
                        </IF_TEST>
                      </ELSE>
                    </IF_TEST>
                    <!--<APPEND_TO_XML DocVar="tmpErrorMsg">
                      <_ERRORS Value="{$thisReturn/_RESULT/@Value}">
                        <TO_XML SelectList="$thisReturn/_RESULT/*"/>
                      </_ERRORS>
                    </APPEND_TO_XML>-->
                    <APPEND_TO_XML DocVar="tmpErrorMsg">
                      <TO_XML SelectList="$thisReturn/_RESULT/*"/>
                    </APPEND_TO_XML>
                  </THEN>
                  <ELSE>
                    <REMOVE_CHILDREN ChildName="STYLE" DocVar="currBucket"/>
                    <SET Var="newUtlPtcg" FromValue="{$currBucket/OrganizationXLocationCapacityTargetUtilizationPercent/@Value}"/>
                    <REMOVE_CHILDREN DocVar="currBucket" ChildName="OrganizationXLocationCapacityTargetUtilizationPercent"/>
                    <SET Property="OrganizationXLocationCapacityTargetUtilizationPercent" DocVar="currBucket" FromValue="{$newUtlPtcg}"/>
                  </ELSE>
                </IF_TEST>
                <IF_TEST Test="$currBucket/OrganizationXLocationCapacityLimitClassIdentifier/@Value = $strRefSoftCnsrnt">
                  <THEN>
                    <PRINTLN Value="this is validation for soft records"/>
                    <SET Var="hardEffectiveUnit" FromValue="{$xmlLocationBucketForCreate/REAL_DATA/MULTI_COLLAB_DATA/SEGMENT_SLAS/BUFFER_SLA/BUCKETS/BUCKET[OrganizationPartyIdentifier/@Value = $currBucket/OrganizationPartyIdentifier/@Value]/EFFSTRGUNIT/@Value}"/>
                    <SET Var="softEffectiveUnit" FromValue="{$currBucket/EFFSTRGUNIT/@Value}"/>
                    <IF_TEST Test="$hardEffectiveUnit >= $softEffectiveUnit">
                      <THEN>
                        <REMOVE_CHILDREN ChildName="STYLE" DocVar="currBucket"/>
                      </THEN>
