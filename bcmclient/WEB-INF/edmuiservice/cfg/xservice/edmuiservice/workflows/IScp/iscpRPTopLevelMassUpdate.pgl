<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="iscpRPTopLevelMassUpdate.pgl">
  <ui:container id="topContainer">
    <ui:step id="c1" displayText="" editable="true">
      <ui:table id="bottomTable" displayText="Top Level Records" rowSrc="$root/ENGINE_LIST/ENGINE" collapsable="true" scrollable="true" displayTextNoRecords="No Record Found" displayCondition="{$root/ShowMassUpdateTable/@Value='YES'}">
        <ui:field-group>
          <ui:display-field id="EngineId" name="EngineId" displayText="Engine ID" />
          <ui:entry-field name="LocationIdentificationValue" id="LocationIdentificationValue" displayText="Location Number" editable="false" />
          <ui:display-field id="SegmentIdentification" displayText="Segment Name" name="SegmentIdentification" />
          <ui:display-field id="SegmentDescription" displayText="Segment Description" name="SegmentDescription" />
          <ui:display-field id="Enterprise" name="Enterprise" displayText="Enterprise" />
          <ui:display-field id="InstanceId" name="InstanceId" displayText="Instance ID" />
          <ui:textarea id="CommentValue" name="CommentValue" displayText="Comments" editable="FALSE" />
          <!-- <ui:display-field id="LAST_MODIFIED_DATE" name="LAST_MODIFIED_DATE" displayText="Date Modified"/>
          <ui:display-field id="ModifiedBy" name="ModifiedBy" displayText="Modified By"/>-->
        </ui:field-group>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:container id="bottomContainer" displayText="Mass Update">
    <ui:step id="c1" displayText="" editable="true">
      <ui:validation successMessage="{$root/SUCCESSMSG/MSG/@Value}" anyFieldIsRequired="false" />
      <ui:field-group columns="4" id="fieldGroups2">
        <ui:field-group id="leftFields">
          <!--<ui:checkbox name="EnterpriseCheckBox"  onClick="javascript:enableSave(this, '1')"/>-->
          <ui:checkbox name="EnterpriseCheckBox" onClick="javascript:disableSave(this)" />
        </ui:field-group>
        <ui:field-group id="middleFields" columns="6">
          <ui:entry-field displayText="Enterprise" id="Enterprise" name="Enterprise" required="false" />
        </ui:field-group>
      </ui:field-group>
      <ui:field-group columns="4" id="fieldGroups2">
        <ui:field-group id="leftFields">
          <!--<ui:checkbox name="InstanceIdCheckBox" onClick="javascript:enableSave(this, '2')"/>-->
          <ui:checkbox name="InstanceIdCheckBox" onClick="javascript:disableSave(this)" />
        </ui:field-group>
        <ui:field-group id="middleFields" columns="6">
          <ui:entry-field displayText="Instance ID" id="InstanceId" name="InstanceId" required="false" />
        </ui:field-group>
      </ui:field-group>
      <ui:field-group columns="8" id="fieldGroups2">
        <ui:field-group id="leftFields">
          <ui:textarea name="Comments" id="Comments" displayText="Comments" required="false" />
        </ui:field-group>
      </ui:field-group>
      <ui:buttons>
        <ui:button name="Save" id="Save" displayText="Save" enabledBySelections="true" disabled="true" onClick="javaScript:checkComments()" />
        <!-- RIC: 240988 Praneeth - Cancel button wording changes request - Start -->
        <ui:button name="MassUpdateCancel" id="MassUpdateCancel" displayText="Back to Search" enabledBySelections="false" />
        <!-- RIC: 240988 Praneeth - Cancel button wording changes request - End -->
      </ui:buttons>
    </ui:step>
  </ui:container>
  <ui:script>var RPcheckbox=2;

		function disableSave(checkbox){

		if(checkbox.checked &amp;&amp;RPcheckbox&gt;=2){
		RPcheckbox+=1;

		i2uiToggleButtonState('Save', 'enabled');
		}else if(!checkbox.checked &amp;&amp; RPcheckbox&gt;2){

	RPcheckbox-=1;

	
		 if( RPcheckbox&lt;=2){


				i2uiToggleButtonState('Save', 'disabled');
		}else
				i2uiToggleButtonState('Save', 'enabled');
		
		}

		
		}
		
	
		function checkComments(){


		if(strlen(document.form.Comments.value) ==0){
		core_alert('Please enter Comments');
		return;
				}else{
				
			 document.form.BUTTON_ID.value="Save";

                document.form.submit();
		}
		
		}</ui:script>
</ui:page-group>

