		   //if(checkDateFormat(endDateSrch) == false){
		    if(isDate(endDateSrch) == false){
		    core_alert('Invalid Date: Please Enter a Valid End Date: M/d/yyyy');
		     document.form.SRCH_ASST_END_DATE_DC.focus();
		     canSearch = 'false';
	   	   return;
		   }
		}		
	/*	var startDateSrch = document.form.FROM_SRCH_MOD_DATE_DC.value;
		var endDateSrch = document.form.TO_SRCH_MOD_DATE_DC.value;
     var currDate= new Date();
		var formatDate = currDate.getMonth()+1+'/'+currDate.getDate()+'/'+currDate.getYear();
		if (Date.parse(endDateSrch) &gt; Date.parse(currDate)) {
    core_alert("To Date cannot be greater than the current date!");
		canSearch = "false";
		return;
		}
		else
				canSearch = "true";
		if (endDateSrch.length &gt; 0 &amp;&amp; startDateSrch.length &lt;= 0) {
		document.form.FROM_SRCH_MOD_DATE_DC.value =endDateSrch; 
   core_alert("Please specify From date to Search!");
		canSearch = "false";
		return;
		}
		if (startDateSrch.length &gt; 0 &amp;&amp; endDateSrch.length &lt;= 0) {
   document.form.TO_SRCH_MOD_DATE_DC.value =startDateSrch; 
		}		*/
		if(canSearch)
			{
								document.form.BUTTON_ID.value = 'search_button'; 
							document.form.action = 'view.x2ps';
							document.form.submit();  
	   	}		
		}		
		
	function pglToggleButton( buttonId, hasNoSelections )
 {
   var type = btnTypes[buttonId];
   if (hasNoSelections == true)
   {
     i2uiToggleButtonState(buttonId, 'disabled');
				 i2uiToggleButtonState('create', 'enabled');
   }
   else
   {
     i2uiToggleButtonState(buttonId, 'enabled', type);
		 i2uiToggleButtonState('create', 'disabled');
   }
 }						
		
 function on_copy()
 {
		var selectedIds = document.getElementsByName('SEQ_NUM');
		var count = 0;
      for(i=0; i &lt; selectedIds.length; i++)
			{
        var t = selectedIds[ i ];
        if ( t.checked )
        {
          count += 1;
        }
      }		
		if(count &gt; 1){
		            core_alert('Please select only one record for Copy!');
								return;
		}
		else{
								document.form.BUTTON_ID.value = 'copy'; 
							document.form.action = 'view.x2ps';
							document.form.submit();  		
		}
		}		
		
	function on_massUpdate(){
		var bIsValid = true;
 		document.form.SUBMIT_AS_XML.value = 'false';
		bIsValid = (isValid_LaneAssetTable());
 		if( bIsValid == false )
		{
  		validation_alert('LaneAssetTable');
		}
		if ( bIsValid == true) 
		{
		var selectedIds = document.getElementsByName('SEQ_NUM');
		var selRowCount = document.form.SELECTED_ROW_COUNT.value;
		var count = 0;
		var isValid = true;
		var prevSelCountLength = 0;
  	var arrSelRowCnts = new Array();
		if(selRowCount.length &gt; 0){
      arrSelRowCnts = selRowCount.split(",");		
			prevSelCountLength =  arrSelRowCnts.length;
		 }
     for(i=0; i &lt; selectedIds.length; i++)
			{
		        var t = selectedIds[ i ];
            if ( t.checked)
            {
				         count += 1;
						}
		  		for(j=0; j &lt; arrSelRowCnts.length; j++)
					{
        			var t = selectedIds[ i ];
        			var t1 = arrSelRowCnts[  j ];
			        if ( t.checked)
 			         {
        				if (t1 == t.value)
        				{
		 								isValid = false;
										prevSelCountLength = prevSelCountLength - 1;
                }
        			}
        			else
							{
										if (t.type != 'hidden' &amp;&amp; t1 == t.value)
        						{
        							isValid = false;
		 									prevSelCountLength = prevSelCountLength - 1;				
        						}        		
										else
													isValid = true;	
        		 	}
	         }	
      }		
			count = count + prevSelCountLength;
	
     if(document.form.LaneAssetTable_globalrowselector.checked)
		{
				var decision=core_confirm("Do you want to update all records satisfying the current search criteria");
				if(decision=='yes')
				{
					document.form.BUTTON_ID.value = 'massUpdateAll'; 
					document.form.action = 'view.x2ps';
					document.form.submit();  	
				}
				else
				{
    <!-- MYANG RIC 266165 - Update Asset Priority Start -->
    if(count &lt;=0 || ( isValid == false &amp;&amp; prevSelCountLength == 1)){
		            core_alert('Please select at least one record for mass update!');
								return;
								}
    <!-- MYANG RIC 266165 - Update Asset Priority End -->
    else{
						  	disableButtons(); 
						  	trapExcelPivotChanges(); 				
					  		document.form.BUTTON_ID.value = 'massUpdate'; 
								document.form.action = 'view.x2ps';
								document.form.submit();  							
		   		}
	

		 }
  }
			else
			{
    <!-- MYANG RIC 266165 - Update Asset Priority Start -->
    if(count &lt;=0 || ( isValid == false &amp;&amp; prevSelCountLength == 1)){
		            core_alert('Please select at least one records for mass update!');
								return;
								}
    <!-- MYANG RIC 266165 - Update Asset Priority End -->
    else{
						  	disableButtons(); 
						  	trapExcelPivotChanges(); 				
					  		document.form.BUTTON_ID.value = 'massUpdate'; 
								document.form.action = 'view.x2ps';
								document.form.submit();  							
		   		}
		}	
		 }
  }
		
function on_delete()
{
					var response = core_confirm('Are you sure you want to delete the selected record(s)?');
					if ( response == 'yes' ) {
						canSubmit = 'true';
					} else {
						canSubmit = 'false';
					}
	if (canSubmit == 'true') 
	{
								document.form.BUTTON_ID.value = 'delete'; 
							document.form.action = 'view.x2ps';
							document.form.submit();  
					}
	else
	{
								document.form.SUBMIT_AS_XML.value = 'false';
					}
					return;
				}
function on_save()
{
		var originalComments = document.getElementsByName('origComments');
		var isError = document.getElementsByName('isError');		
		var selectedIds = document.getElementsByName('SEQ_NUM');
		var commentList = document.getElementsByName('TransportLaneXTransportEquipmentItemCommentText');		
		var startDate = document.getElementsByName('EffectiveStartDate_DC');		
		var endDate = document.getElementsByName('EffectiveEndDate_DC');						
		var canSave = "false";			
      for(i=0; i &lt; selectedIds.length; i++)
			{
        var t = selectedIds[ i ];
        var commentValue = commentList[ i ];		
        if ( t.checked )
        {
		   if (Date.parse(startDate[i].value) &gt; Date.parse(endDate[i].value)) 
		   {
							core_alert("Invalid Date Range,Start Date cannot be after End Date!")
				canSave = "false";
							return;
					}					
		   else
		   {
		canSave = "true";
		}		
		   if(trimString(commentValue.value).length == 0)
		   {
			core_alert("Please enter comments before saving!");
			canSave = "false";		
		  	return;
	     	   }
		   else
		   {
			canSave = "true";
		   }		
		   if(trimString(commentValue.value).length &gt; 255)
		   {
			core_alert("Comments should not be greater than 255 characters!");
				canSave = "false";		
		          return;
		     }
		   else
		   {
		canSave = "true";
		}			
    if (trimString(commentValue.value) == originalComments[i].value &amp;&amp; isError[i].value == 0 ) {
		core_alert("Please enter new comments for update!")
		return;
    }
		else
		   {
	    	canSave = "true";
		  }				
		}		
        }
	if(canSave)
	{
								document.form.BUTTON_ID.value = 'save'; 
							document.form.action = 'view.x2ps';
							document.form.submit();  
        }
	else
	{}
      
		}
  </ui:script>
</ui:page-group>

