		/*function on_clear(){
		document.form.SRCH_SRC_LOC.value ="";
		document.form.SRCH_DESTN_LOC.value ="";		
		document.form.SRCH_TL_MODE.option.value ="*";		
		document.form.SRCH_TL_TYPE.id ="*";		
		document.form.SRCH_STRT_DATE_DC.value ="";
		document.form.SRCH_END_DATE_DC.value ="";		
		document.form.SRCH_MOD_BY.value ="";
		document.form.FROM_SRCH_MOD_DATE_DC.value ="";		
		document.form.TO_SRCH_MOD_DATE_DC.value ="";		
