<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="TLSearchAndEdit.pgl">
  <ui:search displayText="Transportation Lane Search" exportSearch="false" saveSearch="false" collapsable="true">
    <!--  <ui:container id="srchCont" name="srchCont" scrollable="true">
    <ui:step id="srchStep" name="srchStep" displayText="Transportation Lane Search" scrollable="true">-->
    <ui:validation id="srchVal" instructionMessage="Please enter at least one of Source Location or Destination Location or Lane Type for Search" anyFieldIsRequired="false" displayCondition="123" />
    <!--    <ui:field-group>
      <ui:display-field name="insMsg" displayText="Please enter at least one of Source Location or Destination Location or Lane Type for Search" style="font:bold"/>
    </ui:field-group>-->
    <ui:field-group columns="2" select="$root/SEARCH_FIELDS">
      <ui:entry-field name="SRCH_SRC_LOC" displayText="Source Location Number">
        <ui:links>
          <ui:link displayText="Select Location" targetType="popup" targetName="catalogPopup">
            <ui:url page="view.x2ps">
              <SELECTABLE select="'All'" />
              <BUTTON_ID select="'Select_Src_Loc_id'" />
              <FIELD_NAME select="'SRCH_SRC_LOC'" />
            </ui:url>
            <ui:image src="pop_up_window.gif" />
          </ui:link>
        </ui:links>
      </ui:entry-field>
      <ui:entry-field name="SRCH_DESTN_LOC" displayText="Destination Location Number">
        <ui:links>
          <ui:link displayText="Select Location" targetType="popup" targetName="catalogPopup">
            <ui:url page="view.x2ps">
              <SELECTABLE select="'All'" />
              <BUTTON_ID select="'Select_Destn_Loc_id'" />
              <FIELD_NAME select="'SRCH_DESTN_LOC'" />
            </ui:url>
            <ui:image src="pop_up_window.gif" />
          </ui:link>
        </ui:links>
      </ui:entry-field>
      <ui:dropdown displayText="Transport Mode" name="SRCH_TL_MODE" selectAll="false" optionSrc="$root/TL_MODES/*" />
      <ui:dropdown displayText="Lane Type" name="SRCH_TL_TYPE" selectAll="false" optionSrc="$root/TL_CLASS/*" />
      <!--      <ui:entry-field name="SRCH_STRT_DATE" displayText="Lane Start Date" dataType="Date"/>
      <ui:entry-field name="SRCH_END_DATE" displayText="Lane End Date" dataType="Date"/>-->
      <!--<ui:entry-field name="SRCH_MOD_BY" displayText="Modified By">
        <ui:links>
          <ui:link displayText="Select Users" targetType="popup" targetName="catalogPopup">
            <ui:url page="view.x2ps">
              <SELECTABLE select="'All'"/>
              <BUTTON_ID select="'Select_User'"/>
              <FIELD_NAME select="'SRCH_MOD_BY'"/>
            </ui:url>
            <ui:image src="pop_up_window.gif"/>
          </ui:link>
        </ui:links>
      </ui:entry-field>-->
      <ui:hidden-field name="SELECTED_ROW_COUNT" />
    </ui:field-group>
    <!-- <ui:field-group id="advFilter" columns="2" select="$root/SEARCH_FIELDS">
      <ui:date-range displayText="Modified Date Range" name="SRCH_MOD_DATE" fromDate="{FROM_SRCH_MOD_DATE/@Value}" toDate="{TO_SRCH_MOD_DATE/@Value}"/>
    </ui:field-group>-->
    <!--      <ui:buttons>
        <ui:button id="clear" name="clear" displayText="Clear" emphasized="true"/>
        <ui:button id="search_button" name="search_button" displayText="Search" emphasized="true"/>
      </ui:buttons>-->
    <!--    </ui:step>
  </ui:container>-->
  </ui:search>
  <ui:container id="srchResCont" name="srchResCont" scrollable="true">
    <ui:step id="srchResStep" name="srchResStep" displayText="Transportation Lane Search Results" scrollable="true">
      <ui:validation anyFieldIsRequired="false" successMessage="{$root/SUCCESS_MESSAGE/@Value}" />
      <ui:table id="TLaneTable" name="TLaneTable" displayText="Transportation Lane Search Results" displayTextNoRecords="No Records Found" rowSrc="P_TransportLane" select="$root/TL_DETAILS" rowId="TransportLaneIdentifier" postRowIdAs="SELECTED_TL_ID" selectable="{$root/SELECT/@Value}" totalRowCount="$root/TotalRowCount/@Value" startAtRow="$root/START_AT_ROW/@Value" rememberSelections="true" freeze="2" scrollable="true" collapsable="false" exportable="true" filter="false">
        <ui:field-group>
          <ui:entry-field displayText="Lane ID" name="TransportLaneIdentifier" editable="false" unFormat="true" dataType="Number" sortable="true" />
          <ui:display-field displayText="Lane Name" name="TransportLaneName" />
          <ui:display-field displayText="Source Location Number" name="OriginLocationIdn" sortable="true" />
          <!--<ui:display-field displayText="Source Location Name" name="SrcLocationName"/>-->
          <ui:display-field displayText="Destination Location Number" name="DestinationLocationIdn" sortable="true" />
          <!-- <ui:display-field displayText="Destination Location Name" name="DestnLocationName"/>-->
          <ui:display-field displayText="Transport Mode " name="TransMode" sortable="true" />
          <ui:choose-field id="laneDuration" displayText="Lane Duration(hours)">
            <ui:when test="contains($root/AccessLevel/@Value,'Update') or contains($root/AccessLevel/@Value,'Add')">
              <ui:entry-field displayText="Lane Duration (hours)" name="TransportDurationTimeCount" required="false" dataType="Number" decimals="0" maxlength="11" unFormat="true" minValue="0" />
            </ui:when>
            <ui:otherwise>
              <ui:display-field displayText="Lane Duration (hours) " name="TransportDurationTimeCount" dataType="Number" decimals="0" unFormat="true" />
            </ui:otherwise>
          </ui:choose-field>
          <!--          <ui:entry-field displayText="Lane Duration UOM " name="LANE_DURATION_UOM" id="LANE_DURATION_UOM" filter="true" editable="false"/>-->
          <ui:choose-field id="lanetype" displayText="Lane Type">
            <ui:when test="contains($root/AccessLevel/@Value,'Update') or contains($root/AccessLevel/@Value,'Add')">
              <ui:dropdown displayText="Lane Type" name="TransLaneClass" selectAll="false" optionSrc="$root/TL_EDIT_CLASS/*" />
            </ui:when>
            <ui:otherwise>
              <ui:display-field displayText="Lane Type" name="TransLaneClass" selectAll="false" optionSrc="$root/TL_EDIT_CLASS/*" />
            </ui:otherwise>
          </ui:choose-field>
          <ui:entry-field displayText="Lane Start Date " name="TransportLaneStartDate" dataType="Date" editable="false" />
          <!-- added by vamshi for multi user edit -->
          <ui:hidden-field name="LAST_MODIFIED_DATE" id="LAST_MODIFIED_DATE" />
          <ui:entry-field displayText="Lane End Date " name="TransportLaneEndDate" dataType="Date" editable="false" />
          <ui:hidden-field id="origComments" name="origComments" value="{TransportLaneCommentText/@Value}" />
          <ui:hidden-field id="isError" name="isError" value="{count($root/TL_DETAILS/P_TransportLane/*/_ERRORS)}" />
          <ui:choose-field id="comments" displayText="Comments">
            <ui:when test="contains($root/AccessLevel/@Value,'Update') or contains($root/AccessLevel/@Value,'Add')">
              <ui:textarea displayText="Comments" name="TransportLaneCommentText" />
            </ui:when>
            <ui:otherwise>
              <ui:textarea displayText="Comments" name="TransportLaneCommentText" editable="false" />
            </ui:otherwise>
          </ui:choose-field>
          <!-- <ui:display-field displayText="Date Modified" name="LAST_MODIFIED_DATE" sortable="true"/>
          <ui:display-field displayText="Modified By" name="LAST_MODIFIED_BY" sortable="true"/>-->
        </ui:field-group>
        <ui:buttons id="buttons1" name="buttons1">
          <!--          <ui:button displayText="Show History" id="showHistory" name="showHistory" enabledBySelections="false"/>-->
          <ui:button displayText="Delete" id="delete" name="delete" enabledBySelections="true" displayCondition="{contains($root/AccessLevel/@Value,'Remove')}" />
          <ui:button displayText="Mass Update" id="massUpdate" name="massUpdate" enabledBySelections="true" displayCondition="{contains($root/AccessLevel/@Value,'Update')}" />
          <ui:button displayText="Copy" id="copy" name="copy" enabledBySelections="true" displayCondition="{contains($root/AccessLevel/@Value,'Add')}" />
          <ui:button displayText="Create" id="create" name="create" displayCondition="{contains($root/AccessLevel/@Value,'Add')}" />
          <ui:button displayText="Save" id="save" name="save" enabledBySelections="true" displayCondition="{contains($root/AccessLevel/@Value,'Update')}" />
        </ui:buttons>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:script>function validateTime(laneDuration) {
		var canSubmit = "false";
		/*var selectedIds = document.getElementsByName('SELECTED_TL_ID');
				var laneDurationList = document.getElementsByName('TransportDurationTimeCount');

      for(i=0; i &lt; selectedIds.length; i++)
			{
        var t = selectedIds[ i ];
        if ( t.checked )
        {		*/
   // laneDuration = laneDurationList[i].value;
		var arrDurn = laneDuration.split(":");
		var pattern = new RegExp(/([0-9]{1,2})([:]{1})([0-9]{2})([:]{1})([0-9]{2})/);
    		if(!pattern.test(laneDuration) || arrDurn.length &gt; 3 || arrDurn[2].match(/\D/)){
		       core_alert("Invalid value entered for Lane Duration. It should be in hh:mm:ss format!");
		canSubmit = "false";
		       return;
		}
		if(arrDurn[0].search(/\./) != -1 || arrDurn[0]  &lt; 0 || arrDurn[0].match(/\D/)){
		       core_alert("Lane Duration should be a positive integer!");
				canSubmit = "false";
		       return;
		}		
		if(arrDurn[1]  &gt; 59){
		       core_alert("Minutes should not be greater than 59!");
				canSubmit = "false";
		       return;
		}
		if( arrDurn[2] &gt; 59){
		       core_alert("Seconds should not be greater than 59!");
				canSubmit = "false";
		       return;
		}		
		if(arrDurn[0] &lt;=0 &amp;&amp; arrDurn[1] &lt;=0 &amp;&amp; arrDurn[2] &lt;=0){
		       core_alert("Invalid value entered for Lane Duration. It should not be 00:00:00!");
				canSubmit = "false";
		       return;
		}		
		else{
				canSubmit = "true";
		}
		return canSubmit;
	//	}
		//}
	}     

 function pglToggleButton( buttonId, hasNoSelections )
 {
   var type = btnTypes[buttonId];

   if (hasNoSelections == true)
   {
     i2uiToggleButtonState(buttonId, 'disabled');
				 i2uiToggleButtonState('create', 'enabled');
   }
   else
   {
     i2uiToggleButtonState(buttonId, 'enabled', type);
		 i2uiToggleButtonState('create', 'disabled');
   }
 }						

		function on_copy(){
		var selectedIds = document.getElementsByName('SELECTED_TL_ID');
		var count = 0;
      for(i=0; i &lt; selectedIds.length; i++)
			{
        var t = selectedIds[ i ];
        if ( t.checked )
        {
          count += 1;
        }
      }		
		if(count &gt; 1){
		            core_alert('Please select only one record for Copy!');
								return;
		}
		else{
								document.form.BUTTON_ID.value = 'copy'; 
							document.form.action = 'view.x2ps';
							document.form.submit();  		
		}
		}
    function on_save(){
		var originalComments = document.getElementsByName('origComments');
		var isError = document.getElementsByName('isError');		
		var selectedIds = document.getElementsByName('SELECTED_TL_ID');
		var comments = document.getElementsByName('TransportLaneCommentText');
		var laneDurationList = document.getElementsByName('TransportDurationTimeCount');		
      for(i=0; i &lt; selectedIds.length; i++)
			{
        var t = selectedIds[ i ];
        if ( t.checked )
        {
				/*	isValidDurn = validateTime(laneDurationList[i].value);
					if(!isValidDurn)				
		   				return;		*/
					if (trimString(comments[i].value).length &lt;= 0) {
							core_alert("Please enter comments before saving!")
							return;
					}		
					if (trimString(comments[i].value).length &gt; 255) {
							core_alert("Comments should not be greater than 255 characters!")
							return;
					}				
					if (trimString(comments[i].value) == originalComments[i].value &amp;&amp; isError[i].value == 0) {
							core_alert("Please enter new comments for update!")
							return;
					}						
        }
      }		
			document.form.BUTTON_ID.value = 'save'; 
			document.form.action = 'view.x2ps';
			document.form.submit();  		
		}		
