      /*var srcLoc = document.form.SRCH_SRC_LOC.value;	
      var destLoc = document.form.SRCH_DESTN_LOC.value;			
      var tlType = document.form.SRCH_TL_TYPE.value;
		if(srcLoc.length == 0 &amp;&amp; destLoc.length == 0 &amp;&amp; tlType == '*')		{
		core_alert("Select at least one of  Source location or Destination location or Lane Type for Search!");
