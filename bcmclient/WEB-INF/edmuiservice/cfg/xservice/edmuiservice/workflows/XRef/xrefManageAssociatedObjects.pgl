<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="xrefManageAssociatedObjects.pgl">
  <ui:container id="c1" height="50">
    <ui:step id="step1" displayText="Associated Objects">
      <ui:table id="obj1" displayText="Objects" displayTextNoRecords="" select="INPUT_OBJECTS" rowSrc="ATTRIBUTE_OBJECT" doPaging="true" startAtRow="{$root/Start_At_Row/@Value}" postRowIdAs="ObjectMnemonicValue">
        <ui:field-group id="fg1">
          <ui:display-field id="ObjectMnemonicValue" name="ObjectMnemonicValue" displayText="Object Name" />
          <ui:display-field id="ObjectDescription" name="ObjectDescription" displayText="Description" />
          <!--<ui:display-field id="LastModifiedDate" name="LastModifiedDate" displayText="Last Modified Date"/>
          <ui:display-field id="LastModifiedBy" name="LastModifiedBy" displayText="Last Modified By"/>-->
        </ui:field-group>
        <ui:buttons>
          <ui:button id="Close" name="Close" displayText="Close" onClick="javascript:window.close();" />
        </ui:buttons>
      </ui:table>
    </ui:step>
  </ui:container>
</ui:page-group>

