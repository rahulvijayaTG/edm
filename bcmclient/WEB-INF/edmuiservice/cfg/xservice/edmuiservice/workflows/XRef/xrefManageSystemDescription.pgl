<ui:page-group xmlns:ui="system desc" Id="xrefManageSystemDescription.pgl">
  <ui:container id="desc" width="400" height="250">
    <ui:step id="stepDesc" displayText="Enter System Description">
      <ui:field-group id="fg1">
        <ui:textarea id="enterDesc" name="enterDesc" displayText="" colSpan="20" rows="10" value="{$root/FIELD_VALUE/@Value}" align="center" columns="50" />
        <ui:hidden-field name="ROW_ID_NAME" id="ROW_ID_NAME" value="{$root/ROW_ID_NAME/@Value}" />
        <ui:hidden-field name="ROW_ID_VALUE" id="ROW_ID_VALUE" value="{$root/ROW_ID_VALUE/@Value}" />
        <ui:hidden-field name="FIELD_NAME" id="FIELD_NAME" value="{$root/FIELD_NAME/@Value}" />
        <ui:hidden-field name="OPENER_FORM_NAME" id="OPENER_FORM_NAME" />
      </ui:field-group>
      <ui:buttons id="b">
        <ui:button id="Save" name="Save" displayText="Save" onClick="javascript:on_save()" />
        <ui:button id="Cancel" name="Cancel" displayText="Cancel" onClick="javascript:window.close();" />
      </ui:buttons>
    </ui:step>
  </ui:container>
  <ui:script>
    function on_save()
  {
			var sysDesc = this.form.enterDesc.value;
	//	alert(sysDesc);
    
    	var n = document.form.OPENER_FORM_NAME.value;
				
    if( n == '' )
      var n = 'form';
    var fieldName = document.form.FIELD_NAME.value;
    var rowIdName = document.form.ROW_ID_NAME.value;
	
    if(rowIdName == '')
    {
      eval("parent.opener." + n + "." + fieldName + ".value = sysDesc;");
    }
    //its in a table
    else
    {
      eval("var rows = parent.opener.document.getElementsByName('" + rowIdName + "');");
      var rowIdValue = document.form.ROW_ID_VALUE.value;

      if(rows.length == 1)
      {
        if ( fieldName.length &gt;  0 )
        eval("opener.document." + n + "." + 'SystemDescription' + ".value = sysDesc;");
      }
      else
      {     
        for(j=0; j&lt;rows.length; j++)
        {
    			var temp = rows[j].value;					
          if ( temp == rowIdValue )
          {	
            eval("parent.opener." + n + "." + 'SystemDescription' + "[" + (j)  + "].value = sysDesc;");
          }		     
				}
      }
    }
		window.close();
    <!--		document.form.action=start.x2ps-->
    }
  </ui:script>
</ui:page-group>

