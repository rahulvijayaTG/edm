<ui:page-group xmlns:ui="http://www.i2.com/ui" name="Create_ObjectType_Form" source="studio.controller:load">
  <ui:container id="containerSystemroot">
    <ui:step id="root_containerSystem" displayText="System Management">
      <ui:validation anyFieldIsRequired="false" successMessage="{$root/_SUCCESS/@Value}" displayText="{$root/_SUCCESS/@Value}" anyFieldHasErrors="false" displayCondition="{$root/User_Action/@Value != 'CREATE' and $root/User_Action/@Value != 'UPDATE'}" />
