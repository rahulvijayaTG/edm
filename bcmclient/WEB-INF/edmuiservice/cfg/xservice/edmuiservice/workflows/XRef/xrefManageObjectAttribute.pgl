        <ui:header id="head1">
          <ui:link id="link1" displayText="Import from Excel" displayCondition="{contains($root/AccessLevel/@Value,'Remove') or contains($root/AccessLevel/@Value,'Add') or contains($root/AccessLevel/@Value,'Update')}">
            <ui:image id="img1" src="/upld_avail.gif" />
            <ui:url id="UploadFile" displayText="Upload File" page="{concat($pages:upload_local_transaction_details,'?TEMPLATE_NAME=EntityE_ObjectTemplate&amp;DISPLAY_NAME=E_Object&amp;DATA_TYPE=xls')}" />
          </ui:link>
        </ui:header>
        <ui:field-group id="tableColumns">
          <ui:display-field id="ObjectMnemonicValue" displayText="Object Name" name="ObjectMnemonicValue" sortable="true" filter="true" />
          <ui:display-field id="ObjectClassMnemonicValue" sortable="true" displayText="Object Class Name" name="ObjectClassMnemonicValue" />
