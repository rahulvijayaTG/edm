    <ui:step id="top_containerSystem" displayText="System">-->
      <ui:table rowSrc="$root/SYSTEM" id="SystemSearchTable" postRowIdAs="selectedSystemMnemonicValue" rowId="SystemMnemonicValue" displayTextNoRecords="Nothing found" selectable="Single" filter="true" exportable="true" doPaging="true" maxRows="5" select="ROOT" startAtRow="$root/StartAtRow/@Value" collapsable="true" displayText="System" displayCondition="{(string-length($root/FILTER_ID/@Value) = 0) or ($root/FILTER_ID/@Value = 'SystemSearchTable')}">
        <ui:field-group>
          <ui:display-field id="SystemMnemonicValue" displayText="System Name" sortable="true" name="SystemMnemonicValue" filter="true" size="10" />
          <ui:display-field id="SystemDescription" displayText="System Description" name="SystemDescription" sortable="true" size="10" filter="true" />
          <ui:display-field name="SystemLastModifiedDate" displayText="Last Modified Date" sortable="true" filter="true" sortType="descending" id="SystemLastModifiedDate" />
          <ui:display-field displayText="Last Modified By" name="SystemLastModifiedBy" filter="true" id="SystemLastModifiedBy" />
        </ui:field-group>
      </ui:table>
