<ui:page-group xmlns:ui="http://www.i2.com/ui" name="ManageObjectType Search Screen" source="studio.controller:load">
  <ui:container id="container">
    <ui:step id="top_container" displayText="Object Class">
      <ui:validation anyFieldIsRequired="false" successMessage="{$root/_SUCCESS/@Value}" displayCondition="{$root/User_Action/@Value != 'CREATE' and $root/User_Action/@Value != 'UPDATE'}"/>
      <!--ui:table rowSrc="CrossReferenceObjectClass" id="ObjectTypeSearchTable" postRowIdAs="selectedCrossReferenceObjectClassIdentifier" rowId="CrossReferenceObjectIdentifier" displayTextNoRecords="Nothing found" select="ROOT" selectable="Single" filter="true" exportable="true" doPaging="true" maxRows="10" startAtRow="@startAtRow" rowSelectorCondition="{CrossReferenceObjectStatusIdentifier/@Value='1.0'}"-->
      <ui:table rowSrc="$root/ObjectClass" id="ObjectTypeSearchTable" postRowIdAs="selectedObjectClassMnemonicValue" rowId="ObjectClassMnemonicValue" displayTextNoRecords="Nothing found" select="ROOT" selectable="Single" filter="true" exportable="true" doPaging="true" maxRows="10" startAtRow="@startAtRow" rowSelectorCondition="{ObjectClassStatus/@Value='Active'}" scrollable="true" collapsable="false" rememberSelections="true">
        <ui:header id="head1">
          <ui:link id="link1" displayText="Import from Excel" displayCondition="{contains($root/AccessLevel/@Value,'Remove') or contains($root/AccessLevel/@Value,'Add') or contains($root/AccessLevel/@Value,'Update')}">
            <ui:image id="img1" src="/upld_avail.gif"/>
            <ui:url id="UploadFile" displayText="Upload File" page="{concat($pages:upload_local_transaction_details,'?TEMPLATE_NAME=EntityE_ObjectClassTemplate&amp;DISPLAY_NAME=E_ObjectClass&amp;DATA_TYPE=xls')}" />
          </ui:link>
        </ui:header>
        <ui:field-group id="tableColumns">
          <ui:entry-field id="ObjectClassMnemonicValue" sortable="true" name="ObjectClassMnemonicValue" displayText="Name" size="20" editable="false"/>
          <ui:entry-field id="ObjectClassDescription" sortable="true" columns="10" displayText="Description" name="ObjectClassDescription" size="20" editable="false">
            <!--   <ui:links>
              <ui:link displayText="Select Description" targetType="popup" targetName="planPopUp">
                <ui:url page="view.x2ps">
                  <BUTTON_ID select="'select_item_id'"/>
                  <FIELD_NAME select="'ItemCode'"/>
                  <ObjectClassDescription select="''ObjectClassDescription''"/>
                </ui:url>
                <ui:image src="pop_up_window.gif"/>
              </ui:link>
            </ui:links>-->
          </ui:entry-field>
          <ui:dropdown id="ObjectClassDomain" sortable="true" name="ObjectClassDomain" editable="false" displayText="Category" visibility="true" size="1" filter="true" selectOne="true">
            <ui:option id="Y" value="Code_Decode" selected="{$root/MASS_ENTRY_ObjectClassDomain/@Value='Y'}" />
            <ui:option id="N" value="XRef" selected="{$root/MASS_ENTRY_ObjectClassDomain/@Value='N'}" />
          </ui:dropdown>
          <ui:dropdown id="ObjectClassStatus" name="ObjectClassStatus" sortable="true" editable="false" displayText="Status" visibility="true" size="1" filter="true" selectOne="true">
            <ui:option id="1.0" value="ACTIVE" selected="{$root/MASS_ENTRY_ObjectClassStatus/@Value=1.0}"/>
            <ui:option id="2.0" value="DELETED" selected="{$root/MASS_ENTRY_ObjectClassStatus/@Value=2.0}"/>
          </ui:dropdown>
          <ui:hidden-field id="ObjectClassGenericIndicator" name="ObjectClassGenericIndicator" displayText="GenericFlag" size="1"/>
          <ui:entry-field id="ObjectClassNotes" sortable="true" name="ObjectClassNotes" displayText="Comments/Notes" editable="false"/>
          <ui:display-field id="LastModifiedDate" sortable="true" displayText="Last Modified Date" name="LastModifiedDate" filter="true" sortType="descending"/>
          <ui:display-field id="LastModifiedBy" displayText="Last Modified By" name="LastModifiedBy" filter="true"/>
        </ui:field-group>
        <ui:buttons>
          <ui:button id="ShowDetail" name="SHOW" displayText="Show Details" validate="false" disabled="true" enabledBySelections="true"/>
          <ui:button id="DELETE" name="DELETE" displayText="Delete" validate="false" disabled="true" enabledBySelections="true" displayCondition="{contains($root/AccessLevel/@Value,'Remove')}"/>
        </ui:buttons>
        <ui:script id="check"/>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:container id="container" displayText="Top Container" collapsable="false">
    <ui:step displayText="Object Class Detail" id="top_container" editable="true">
      <ui:validation anyFieldIsRequired="true" successMessage="{$root/SELECTED/_SUCCESS/@Value}" displayText="{$root/SELECTED/_ERROR/@Value}" anyFieldHasErrors="false" displayCondition="{$root/User_Action/@Value != 'DELETE'}"/>
      <!-- bootstrap fields -->
      <!-- these should even be hidden from templates -->
      <ui:field-group select="$root">
        <ui:hidden-field name="EV_NAME"/>
        <ui:hidden-field name="EV_KEY"/>
        <ui:hidden-field name="CURRENT_USER_ID" value="{identity-user-id()}"/>
        <ui:hidden-field name="mode" value=""/>
        <ui:hidden-field name="errSts" value="{$root/ERR_STS/@Value}" />
      </ui:field-group>
      <!-- bootstrap fields done-->
      <ui:field-group rows="3" id="fieldGroups" columns="3" select="$root/SELECTED">
        <ui:field-group id="FirstGroup" rows="2">
          <ui:entry-field id="BtmObjectClassMnemonicValue" name="BtmObjectClassMnemonicValue" displayText="Object Class Name" required="true" onKeyUp="javascript:onObjClassChange(this)"/>
          <ui:textarea id="BtmObjectClassDescription" name="BtmObjectClassDescription" displayText="Description" columns="65" rows="3" required="false" onKeyUp="javascript:onObjClassChange(this)"/>
        </ui:field-group>
        <!--<ui:field-group id="SecondGroup"  columns="6"  >-->
        <ui:field-group id="ThirdGroup" columns="3" select="$root/SELECTED/BtmObjectClassDomain">
          <ui:field-group columns="5">
            <ui:display-field id="Category" name="Category" required="true" displayText="Category" align="left" colSpan="10"/>
            <ui:radiobutton id="BtmObjectClassDomain" name="BtmObjectClassDomain" checkedValue="Code_Decode" value="{$root/SELECTED/BtmObjectClassDomain/@Value}" configurable="true" preferredWidth="5" onClick="javascript:onObjClassChange(this)"/>
            <ui:display-field value="Code Decode"/>
            <!--</ui:field-group>-->
            <!--<ui:field-group  columns="2">-->
            <ui:radiobutton id="BtmObjectClassDomain" name="BtmObjectClassDomain" checkedValue="XRef" value="{$root/SELECTED/BtmObjectClassDomain/@Value}" configurable="true" align="left" colSpan="1" rowSpan="1" onClick="javascript:onObjClassChange(this)"/>
            <ui:display-field value="XRef" align="left"/>
          </ui:field-group>
          <ui:field-space/>
          <ui:entry-field id="Status" sortable="true" displayText="Status" name="Status" defaultValue="Active" editable="false" align="right"/>
        </ui:field-group>
        <!--</ui:field-group>-->
        <ui:field-group id="ThirdGroup">
          <ui:textarea id="BtmNotes" name="BtmNotes" displayText="Comments/Notes" columns="65" rows="3" editable="true" colSpan="30" onKeyUp="javascript:onObjClassChange(this)"/>
        </ui:field-group>
      </ui:field-group>
      <ui:buttons>
        <ui:button id="CLEAR" name="CLEAR" displayText="Clear" emphasized="false" onClick="javascript:onClear()" disabled="false" enabledBySelections="true" />
        <ui:divider id="div1" name="div1"/>
        <ui:button id="CREATE" name="CREATE" displayText="Create" emphasized="false" displayCondition="{contains($root/AccessLevel/@Value,'Add')}" disabled="true" />
        <ui:divider id="div" name="div"/>
        <ui:button id="UPDATE" name="UPDATE" displayText="Update" emphasized="true" displayCondition="{contains($root/AccessLevel/@Value,'Update')}" disabled="true" />
      </ui:buttons>
    </ui:step>
  </ui:container>
  <ui:script>function onObjClassChange(thisObj) {		
		
			  	 disableButtons(); 
      	enableButton('CLEAR');	   	 

			if (thisObj.id == 'BtmObjectClassMnemonicValue')
		{
			 form.mode.value='create';
     	 enableButton('CREATE');
		}
		else
		{
				if (form.mode.value != 'create')
		{
				if(form.errSts.value != 'True')
		     {	 enableButton('UPDATE'); }
				else
		   { enableButton('CREATE');  }
		
		}
		else
		{
     	 enableButton('CREATE');
		
		}
		}
		}
		
		
    function onClear() {
		form.BUTTON_ID.value = &quot;CLEAR&quot;;
      form.submit();
		}
    
    function on_DELETE(){
    
   var response = core_confirm('Are you sure you want to delete this records?');
		
		if ( response == 'no' ) {
      canSubmit = 'false';
   } 
     if( response == 'yes' ) {
       canSubmit = 'true';
   }
		
		if (canSubmit == 'true') {
		    disableButtons();    
   
    var selectedIds = document.getElementsByName('selectedObjectClassMnemonicValue');
		     var generic = document.getElementsByName('ObjectClassGenericIndicator');    
   
    var length = selectedIds.length;    

    for(i=0; i &lt; length; i++)
                  {
                      var t = selectedIds[ i ];
                         if ( t.checked )
                      {
                      var genVal = generic[i].value;
		                         	if(genVal == 'N'){
		    			                 			core_alert(&quot; Non Generic Objects Cannot be Deleted.&quot;);
																		 	enableButton('DELETE');
																     	enableButton('ShowDetail');
		    															return;		                  
		    													}		 
		                            else {
	             	                  document.form.BUTTON_ID.value = 'DELETE' ; 
		                                document.form.action = 'view.x2ps';  
		                                      document.form.submit();    
              		               }    
                    }
                }
		 }

   else{
    document.form.SUBMIT_AS_XML.value = 'false';		
    }
    return;
		
        }
    
   function on_UPDATE(){       
           document.form.BUTTON_ID.value = 'UPDATE' ; 
		        document.form.action = 'view.x2ps';  
		           document.form.submit();  
		}
		
    function  validateTotalCountOfCheckBox()
		{
		var count=0,j;
		for( j=0; j &lt;document.form.selectedXRefObjectClassId.length;j++)
		{
		if(document.form.selectedXRefObjectClassId[j].checked){
		count++;
		}
		}
		if(count > 1)
		{
		alert(count);
		alert(&quot;You cant Modify More than One Object Type&quot;);
		}
		else{
	document.form.submit();
		}
		}</ui:script>
</ui:page-group>