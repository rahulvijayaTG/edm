      </else_if_cond>
      <else_if_cond Value="true()">
        <next_nodes OutputVar="{outputXml,xml}"/>
      </else_if_cond>
    </ui_form2>
    <task Name="create" InputVar="{nodeInput,xml}">
      <actions>
        <action>
          <TO_DOCVAR AssignToVar="createInfo">
            <INFO>
              <ACTIONTOBDONE Value="INSERT"/>
              <ObjectClassMnemonicValue Value="{$nodeInput/ObjectClass/@Value}"/>
              <DataBaseViewName Value="{$nodeInput/ViewName/@Value}"/>
              <MapStatus Value="{$nodeInput/Status/@Value}"/>
              <MapCardinality Value="{$nodeInput/CARDINALITY/@Value}"/>
              <CrossReferenceSourceSystemMnemonicValue Value="{$nodeInput/SourceSystem/@Value}"/>
              <CrossReferenceSourceObjectMnemonicValue Value="{$nodeInput/SourceObject/@Value}"/>
              <TargetSystemMnemonicValue Value="{$nodeInput/TargetSystem/@Value}"/>
              <TargetObjectMnemonicValue Value="{$nodeInput/TargetObject/@Value}"/>
              <MapUsage Value="{$nodeInput/Usage/@Value}"/>
              <ConversionSystemNotes Value="{$nodeInput/comments/@Value}"/>
            </INFO>
          </TO_DOCVAR>
          <REQUEST AssignToVar="res" Name="CreateActivateMapUI" ReturnRowCount="yes" ServiceName="BCM_MASTER" HandleException="yes">
            <TO_XML SelectList="$createInfo/*"/>
          </REQUEST>
          <TO_DOCVAR AssignToVar="values">
            <VALUES>
              <P_CrossReferenceMap>
                <MapUsage Value="{$thisParam/Usage/@Value}"/>
                <MapStatus Value="{$thisParam/Status/@Value}"/>
                <MapCardinality Value="{$thisParam/CARDINALITY/@Value}"/>
                <TargetObjectMnemonicValue Value="{$thisParam/TargetObject/@Value}"/>
                <TargetSystemMnemonicValue Value="{$thisParam/TargetSystem/@Value}"/>
                <CrossReferenceSourceObjectMnemonicValue Value="{$thisParam/SourceObject/@Value}"/>
                <CrossReferenceSourceSystemMnemonicValue Value="{$thisParam/SourceSystem/@Value}"/>
                <ObjectClassMnemonicValue Value="{$thisParam/ObjectClass/@Value}"/>
                <DataBaseViewName Value="{upperCase($thisParam/ViewName/@Value)}"/>
                <ConversionSystemNotes Value="{$thisParam/comments/@Value}"/>
              </P_CrossReferenceMap>
            </VALUES>
          </TO_DOCVAR>
          <IF_TEST Test="$res/@Status = 'Success' and $res/SCENARIO_ID/@Value = 0 and $res/MapUsage/@Value != null and $res/CrossReferenceSourceObjectMnemonicValue/@Value != null">
            <THEN>
              <APPEND_TO_XML DocVar="message1">
                <_SUCCESS Value="Map Added Successfully!" Details="true"/>
              </APPEND_TO_XML>
              <APPEND_TO_XML DocVar="details">
                <DETAILS>
                  <TO_XML SelectList="$values/*"/>
                </DETAILS>
              </APPEND_TO_XML>
            </THEN>
            <ELSE>
              <IF_TEST Test="$res/@Status = 'Success' and $res/MODULE/@Value = 'Activate'">
                <THEN>
                  <APPEND_TO_XML DocVar="message1">
                    <_SUCCESS Value="Map Activated Successfully!" Details="true"/>
                  </APPEND_TO_XML>
                  <APPEND_TO_XML DocVar="details">
                    <DETAILS>
                      <TO_XML SelectList="$values/*"/>
                    </DETAILS>
                  </APPEND_TO_XML>
                </THEN>
                <ELSE>
                  <IF_TEST Test="$res/@Status = 'Error'">
                    <THEN>
                      <APPEND_TO_XML DocVar="message1">
                        <_ERRORS Value="SEVERE_ERROR">
                          <_ERROR Value="{$res/@Description}" Severity="SEVERE_ERROR"/>
                        </_ERRORS>
                      </APPEND_TO_XML>
                      <APPEND_TO_XML DocVar="details">
                        <DETAILS>
                          <TO_XML SelectList="$values/*"/>
                        </DETAILS>
                      </APPEND_TO_XML>
                    </THEN>
                    <ELSE>
                      <APPEND_TO_XML DocVar="message1">
                        <_ERRORS Value="SEVERE_ERROR">
                          <_ERROR Value="{$res/_RESULT/_ERROR/@Value}" Severity="SEVERE_ERROR"/>
                        </_ERRORS>
                      </APPEND_TO_XML>
                      <APPEND_TO_XML DocVar="details">
                        <DETAILS>
                          <TO_XML SelectList="$values/*"/>
                        </DETAILS>
                      </APPEND_TO_XML>
                    </ELSE>
                  </IF_TEST>
                </ELSE>
              </IF_TEST>
            </ELSE>
          </IF_TEST>
        </action>
      </actions>
      <next_nodes OutputVar="{nodeOutput,xml}">
        <next_node Name="Manage CrossRef Map" Description=""/>
      </next_nodes>
    </task>
    <task Name="delete" InputVar="{nodeInput,xml}">
      <actions>
        <action>
          <SET Var="mapid" FromValue="{strlen($nodeInput/SELECTED_MAP_ID/@Value)}"/>
          <IF_TEST Test="$mapid>0">
            <THEN>
              <FOR_EACH CurrentElement="cur" SelectList="$readResults/P_CrossReferenceMap[MapIdentifier/@Value = $nodeInput/SELECTED_MAP_ID/@Value]">
                <TO_DOCVAR AssignToVar="createInfo">
                  <INFO>
                    <ACTIONTOBDONE Value="DELETE"/>
                    <MapStatus Value="{$cur/MapStatus/@Value}"/>
                    <MapCardinality Value="{$cur/MapCardinality/@Value}"/>
                    <CrossReferenceSourceSystemMnemonicValue Value="{$cur/CrossReferenceSourceSystemMnemonicValue/@Value}"/>
                    <CrossReferenceSourceObjectMnemonicValue Value="{$cur/CrossReferenceSourceObjectMnemonicValue/@Value}"/>
                    <TargetSystemMnemonicValue Value="{$cur/TargetSystemMnemonicValue/@Value}"/>
                    <TargetObjectMnemonicValue Value="{$cur/TargetObjectMnemonicValue/@Value}"/>
                    <MapUsage Value="{$cur/MapUsage/@Value}"/>
                  </INFO>
                </TO_DOCVAR>
              </FOR_EACH>
            </THEN>
          </IF_TEST>
          <REQUEST AssignToVar="res" Name="deleteXrefMap" ReturnRowCount="yes" ServiceName="BCM_MASTER" HandleException="yes">
            <TO_XML SelectList="$createInfo/*"/>
          </REQUEST>
          <!--<IF_TEST Test="$res/@Status = 'Success' and $res/@RowCount = 1"> -->
          <IF_TEST Test="$res/@Status = 'Success' and count($res/_RESULT/_ERROR) = 0">
            <THEN>
              <APPEND_TO_XML DocVar="message">
                <!-- <USER_ACTION Value="{$userAction}"/> -->
                <_SUCCESS1 Value="Map Deleted Successfully!" Details="true"/>
              </APPEND_TO_XML>
            </THEN>
            <ELSE>
              <IF_TEST Test="$res/@Status = 'Error'">
                <THEN>
                  <APPEND_TO_XML DocVar="message">
                    <_ERRORS Value="SEVERE_ERROR">
                      <_ERROR Value="{$res/@Description}" Severity="SEVERE_ERROR"/>
                    </_ERRORS>
                  </APPEND_TO_XML>
                </THEN>
                <ELSE>
                  <APPEND_TO_XML DocVar="message">
                    <_ERRORS Value="SEVERE_ERROR">
                      <_ERROR Value="{$res/_RESULT/_ERROR/@Value}" Severity="SEVERE_ERROR"/>
                    </_ERRORS>
                  </APPEND_TO_XML>
                </ELSE>
              </IF_TEST>
            </ELSE>
          </IF_TEST>
        </action>
      </actions>
      <next_nodes OutputVar="{nodeOutput,xml}">
        <next_node Name="Manage CrossRef Map" Description=""/>
      </next_nodes>
    </task>
    <task Name="update" InputVar="{nodeInput,xml}">
      <actions>
        <action>
          <TO_DOCVAR AssignToVar="createInfo">
            <INFO>
              <ACTIONTOBDONE Value="UPDATE"/>
