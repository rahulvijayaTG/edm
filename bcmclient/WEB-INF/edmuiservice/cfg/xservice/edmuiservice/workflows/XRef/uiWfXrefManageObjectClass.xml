              </TO_DOCVAR>
            </THEN>
          </IF_TEST>
          <FOR_EACH CurrentElement="tempElem" SelectList="$CIfilters/*">
            <SET Var="thisValue" FromValue="{$tempElem/@Value}"/>
            <REMOVE_ATTRIBUTE DocVar="tempElem" Name="Value"/>
            <SET Attribute="ScalarFn" FromValue="upperCase" DocVar="tempElem"/>
            <SET Attribute="Value" FromValue="{upperCase($thisValue)}" DocVar="tempElem"/>
          </FOR_EACH>
          <IF_TEST Test="strlen($sortBy) != 0">
