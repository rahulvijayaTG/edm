              <REQUEST AssignToVar="modsys" Name="readObjectClass" ServiceName="BCM_MASTER" ReturnRowCount="yes" MaxRows="{$pgMaxRows}" StartAtRow="{ifElse($exportTableId='',$paginateStart,'0')}">
