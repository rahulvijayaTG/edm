<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="xrefManageComments.pgl">
  <ui:container id="cont" displayText="Cont" height="50" width="500">
    <ui:step id="s1" displayText="Comments">
      <ui:field-group id="fg" width="50">
        <ui:textarea id="mapCmnt" value="{$root/COMMENT/@Value}" name="mapCmnt" displayText="Map Comments" rows="10" columns="50" />
      </ui:field-group>
      <ui:buttons>
        <ui:button id="Save" name="Save" displayText="Save" onClick="javascript:on_save();" />
        <ui:button id="Close" name="Close" displayText="Close" onClick="javascript:window.close();" />
      </ui:buttons>
    </ui:step>
  </ui:container>
  <ui:script>function on_save()
  {
			var cmnt = this.form.mapCmnt.value;		
		parent.opener.form.comments.value = cmnt;
		parent.opener.onValueChange('Comment');	  
		window.close();
}</ui:script>
</ui:page-group>

