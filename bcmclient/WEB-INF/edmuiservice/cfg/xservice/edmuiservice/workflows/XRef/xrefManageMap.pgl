<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="xrefManageMap.pgl">
  <ui:table id="table1" name="table1" displayText="Search CrossRef Maps" doPaging="true" filter="true" rowSrc="P_CrossReferenceMap" select="ROOT" rowId="MapIdentifier" scrollable="true" exportable="true" selectable="Single" collapsable="true" postRowIdAs="SELECTED_MAP_ID" rememberSelections="true" maxRows="10" startAtRow="$root/ROOT/START_ROW_COUNT/@Value">
    <ui:validation successMessage="{$root/_SUCCESS1/@Value}" anyFieldIsRequired="false" displayCondition="{$root/USER_ACTION/@Value = 'DELETE'}" />
    <ui:header id="head1">
      <ui:link id="link1" displayCondition="{contains($root/ACCESS_LEVEL/@Value,'Remove') or contains($root/ACCESS_LEVEL/@Value,'Add') or contains($root/ACCESS_LEVEL/@Value,'Update')}">
        <ui:image id="img1" displayText="Import From Excel" src="/upld_avail.gif" />
        <ui:url id="UploadFile" displayText="Upload File" page="{concat($pages:upload_local_transaction_details,'?TEMPLATE_NAME=EntityE_MapTemplate&amp;DISPLAY_NAME=E_Map&amp;DATA_TYPE=xls')}" />
      </ui:link>
    </ui:header>
    <ui:field-group id="fgt">
      <ui:hidden-field id="MapIdentifier" name="MapIdentifier" value="{MapIdentifier/@Value}" />
      <ui:hidden-field id="CrossReferenceObjectIdentifier" name="CrossReferenceObjectIdentifier" displayText="ObjectTypeId" filter="true" />
      <ui:display-field id="ObjectClassMnemonicValue" sortable="true" name="ObjectClassMnemonicValue" displayText="ObjectClass" />
      <ui:dropdown id="ObjectClassCategory" sortable="true" name="ObjectClassCategory" size="1" selectOne="true" editable="false" displayText="Category">
        <ui:option id="N" value="CodeDecode" selected="{$root/Category/@Value='Y'}" />
        <ui:option id="Y" value="Xref" selected="{$root/Category/@Value='N'}" />
      </ui:dropdown>
      <ui:dropdown displayText="Usage" name="MapUsage" size="1" sortable="true" optionSrc="$root/USG/USG_LIST/Usg_List" selectOne="true" editable="false" onChange="javascript:chkUsageValue(this);" />
      <ui:entry-field id="DataCount" name="DataCount" displayText="Record Count" editable="false" filter="false" sortable="false" />
      <ui:display-field id="CrossReferenceSourceSystemMnemonicValue" name="CrossReferenceSourceSystemMnemonicValue" sortable="true" displayText="SourceSystem" />
      <ui:display-field id="CrossReferenceSourceObjectMnemonicValue" name="CrossReferenceSourceObjectMnemonicValue" sortable="true" displayText="SourceObject" />
      <ui:display-field id="TargetSystemMnemonicValue" name="TargetSystemMnemonicValue" sortable="true" displayText="TargetSystem" />
      <ui:display-field id="TargetObjectMnemonicValue" name="TargetObjectMnemonicValue" sortable="true" displayText="TargetObject" />
      <ui:dropdown id="MapStatus" name="MapStatus" optionSrc="$root/STS/STS_LIST/*" sortable="true" displayText="Status" size="1" selectOne="true" editable="false" onChange="javascript:chkStatusValue(this);" />
      <ui:display-field id="lastModifiedDate" name="lastModifiedDate" sortable="true" displayText="Last Modified Date" />
      <ui:display-field id="lastModifiedBy" name="lastModifiedBy" sortable="true" displayText="Last Modified By" />
      <ui:hidden-field name="mode" value="" />
      <ui:hidden-field name="FIELD_VALUE" value="" />
    </ui:field-group>
    <ui:buttons id="bg1">
      <ui:button id="SHOW_DETAILS" name="SHOW_DETAILS" displayText="Show Details" validate="false" enableBySelections="yes" />
      <ui:button id="DELETE" name="DELETE" displayText="Delete" validate="false" displayCondition="{contains($root/ACCESS_LEVEL/@Value,'Remove')}" onClick="javascript:on_Delete()" enabledBySelections="true" />
    </ui:buttons>
  </ui:table>
  <ui:container id="createContainer" displayText="Create or Modify Map" collapsable="true">
    <ui:step id="step2">
      <ui:validation successMessage="{$root/_SUCCESS/@Value}" displayCondition="true" />
      <!-- the constraint {$root/USER_ACTION/@Value != 'DELETE'} -->
      <!-- bootstrap field -->
      <!-- these should even be hidden from templates -->
      <ui:field-group select="$root">
        <ui:hidden-field name="EV_NAME" />
        <ui:hidden-field name="EV_KEY" />
        <ui:hidden-field name="CURRENT_USER_ID" value="{identity-user-id()}" />
        <ui:hidden-field name="isCreate" value="false" />
        <ui:hidden-field name="isUpdate" value="false" />
        <ui:hidden-field name="dataCnt" value="{$root/ROOT/DETAILS/P_CrossReferenceMap/DataCount/@Value}" />
        <ui:hidden-field name="errSts" value="{$root/ERR_STS/@Value}" />
      </ui:field-group>
      <!-- bootstrap fields done-->
      <ui:field-group id="disp">
        <ui:display-field id="d1" name="d1" displayText="" value="# denotes primary key field" />
      </ui:field-group>
      <ui:hr id="h" />
      <ui:field-group columns="1">
        <ui:field-group id="fgCreate" columns="4">
          <ui:entry-field id="ObjectClass" name="ObjectClass" readOnly="{$root/ROOT/DETAILS/P_CrossReferenceMap/DataCount/@Value&gt;0}" colSpan="35" displayText="Object Class" value="{$root/ROOT/DETAILS/P_CrossReferenceMap/ObjectClassMnemonicValue/@Value}" onKeyUp="javascript:onValueChange('ObjectClass');">
            <ui:links>
              <ui:link displayText="Select Object Class" targetType="popup" targetName="orderPopup">
                <ui:image src="pop_up_window.gif" />
                <ui:url page="view.x2ps">
                  <BUTTON_ID select="'SelectObjectClass'" />
                  <FIELD_NAME select="'ObjectClass'" />
                  <ENTITY_NAME select="'ObjectClass'" />
                  <SELECTABLE select="'Single'" />
                  <!--                <FIELD_VALUE select="{ObjectClass/@Value}"/>-->
                </ui:url>
              </ui:link>
            </ui:links>
          </ui:entry-field>
          <ui:dropdown id="Status" name="Status" optionSrc="$root/STS/STS_LIST/*" disabled="{$root/ROOT/DETAILS/P_CrossReferenceMap/DataCount/@Value&gt;0}" displayText="Status" value="{$root/ROOT/DETAILS/P_CrossReferenceMap/MapStatus/@Value}" selectOne="true" required="true" onChange="javascript:onValueChange('Status');" />
          <ui:dropdown id="CARDINALITY" name="CARDINALITY" optionSrc="$root/CRDNLTY/CARD_LIST/*" disabled="{$root/ROOT/DETAILS/P_CrossReferenceMap/DataCount/@Value&gt;0}" displayText="Cardinality" value="{$root/ROOT/DETAILS/P_CrossReferenceMap/MapCardinality/@Value}" selectOne="true" required="true" onChange="javascript:onValueChange('CARDINALITY');" />
          <ui:dropdown id="Usage" name="Usage" displayText="Usage (#)" optionSrc="$root/USG/USG_LIST/*" value="{$root/ROOT/DETAILS/P_CrossReferenceMap/MapUsage/@Value}" selectOne="true" required="true" onChange="javascript:onValueChange('Usage');" />
        </ui:field-group>
        <ui:field-group id="fg2" columns="3" width="100%">
          <ui:hidden-field name="mode" value="" />
          <ui:entry-field id="SourceSystem" name="SourceSystem" displayText="Source System (#)" value="{$root/ROOT/DETAILS/P_CrossReferenceMap/CrossReferenceSourceSystemMnemonicValue/@Value}" required="true" align="left" onKeyUp="javascript:onValueChange('SourceSystem');" />
          <ui:display-field id="g1" name="g1" />
          <ui:entry-field displayText="Source Object (#)" id="SourceObject" name="SourceObject" value="{$root/ROOT/DETAILS/P_CrossReferenceMap/CrossReferenceSourceObjectMnemonicValue/@Value}" required="true" align="right" onKeyUp="javascript:onValueChange('SourceObject');">
            <ui:links>
              <ui:link id="SelectSourceObject" displayText="Select Source Object" onClick="javascript:openPopUpForSource()">
                <ui:image src="pop_up_window.gif" />
              </ui:link>
            </ui:links>
          </ui:entry-field>
          <!--<ui:field-space id="fs1" />-->
          <ui:entry-field id="TargetSystem" name="TargetSystem" displayText="Target System (#)" value="{$root/ROOT/DETAILS/P_CrossReferenceMap/TargetSystemMnemonicValue/@Value}" required="true" align="left" onKeyUp="javascript:onValueChange('TargetSystem');" />
          <ui:display-field id="g3" name="g3" />
          <ui:entry-field id="TargetObject" name="TargetObject" displayText="Target Object (#)" value="{$root/ROOT/DETAILS/P_CrossReferenceMap/TargetObjectMnemonicValue/@Value}" required="true" align="right" onKeyUp="javascript:onValueChange('TargetObject');">
            <ui:links>
              <ui:link id="SelectTargetObject" displayText="Select Target Object" onClick="javascript:openPopUpForTarget()">
                <ui:image src="pop_up_window.gif" />
              </ui:link>
            </ui:links>
          </ui:entry-field>
          <!--<ui:field-space id="fs2"/>-->
          <!-- </ui:field-group>-->
          <ui:entry-field id="ViewName" readOnly="{$root/ROOT/DETAILS/P_CrossReferenceMap/DataCount/@Value&gt;0}" name="ViewName" displayText="View Name" value="{$root/ROOT/DETAILS/P_CrossReferenceMap/DataBaseViewName/@Value}" required="true" align="left" onChange="javascript:onValueChange('ViewName');">
            <ui:links>
              <ui:button id="GenerateName" name="GenerateName" displayText="GenerateName" validate="false" onClick="javascript:on_generate()" />
            </ui:links>
          </ui:entry-field>
          <ui:display-field id="g4" name="g4" />
          <ui:textarea id="comments" name="comments" displayText="Comments/Notes" columns="22" value="{$root/ROOT/DETAILS/P_CrossReferenceMap/ConversionSystemNotes/@Value}" align="right" onKeyDown="javascript:onValueChange('comments');">
            <ui:links>
              <ui:link id="ShowComments" displayText="ShowComments" onClick="javascript:openPopUpForComments()">
                <ui:image src="pop_up_window.gif" />
              </ui:link>
            </ui:links>
          </ui:textarea>
        </ui:field-group>
      </ui:field-group>
      <ui:buttons>
        <!--        <ui:button id="GenerateName" name="GenerateName" displayText="GenerateName" validate="false" onClick="javascript:on_click_generate()"/>-->
        <ui:button id="Clear" name="Clear" displayText="Clear" validate="false" />
        <ui:button id="Create" name="Create" displayText="Create" disabled="{$root/Button/@Value='False' or ($root/USER_ACTION/@Value = 'Update' and count($root/_ERRORS)&gt;0) or count($root/_SUCCESS)&gt;0}" displayCondition="{contains($root/ACCESS_LEVEL/@Value,'Add')}" />
        <ui:divider id="div1" />
        <ui:button id="Update" name="Update" disabled="{$root/Button/@Value='True' or $root/Button/@Value='False' or ($root/USER_ACTION/@Value = 'Create' and count($root/_ERRORS)&gt;0) or count($root/_SUCCESS)&gt;0}" displayText="Update" displayCondition="{contains($root/ACCESS_LEVEL/@Value,'Update')}" onClick="javascript:on_Update();" />
      </ui:buttons>
    </ui:step>
  </ui:container>
  <ui:script>var btnTypes = new Array();
 var tableButtons = new Array(); 
		function on_Delete(){
					var response = core_confirm('Are you sure you want to delete this records?');
					if ( response == 'no' ) {
						canSubmit = 'false';
					} 
				  if( response == 'yes' ) {
						canSubmit = 'true';
					}
				
					if (canSubmit == 'true') {
								document.form.BUTTON_ID.value = 'DELETE'; 
							document.form.action = 'view.x2ps';
							document.form.submit();  						
					}
		else{
						document.form.SUBMIT_AS_XML.value = 'false';		
					}
					return;				
		}
		
 function on_showDetails()
{
    var x = document.getElementsByName( 'SELECTED_MAP_ID' );
		var length = x.length;
    var selectedMap = null;
		var temp=0;
		
		for(i=0; i&lt;length; i++)
    {				 var t = x[ i ];	
					  if ( t.checked )
				      {		alert('chkd');
				        	show_details();	
				      }	
							else
							{
									temp = temp +1;  				
							}	
		}
		
		if(temp &gt; 0)
				{  
					alertforNonSelection();				
					}
		

}	

		function alertforNonSelection()
		{
		var response = core_alert('Please select a map to proceed further');
			
		if(response == 'ok')
						{ 
							show_details();	 }
						else
						{alertforNonSelection();}
		}			
		
function show_details()
		{
			var bIsValid = true;
 											document.form.SUBMIT_AS_XML.value = 'false';

											if ( bIsValid == true) 
											{
											 disableButtons(); 
											 trapExcelPivotChanges(); 
											document.form.BUTTON_ID.value = 'SHOW_DETAILS'; 
											document.form.action = 'view.x2ps';
											document.form.submit();  
											}
											
											onResize();  
											return; 
		}			
	
function onMapUpdate()
{
	form.Status.disabled=false;		
	form.CARDINALITY.disabled=false;	
		on_Update();	
}	
function on_Update()
{
				form.Status.disabled=false;		
	form.CARDINALITY.disabled=false;	
			 var bIsValid = true;
			 document.form.SUBMIT_AS_XML.value = 'false';

			bIsValid = (isValid_step2());
 
			if( bIsValid == false )	
			{
  				validation_alert('step2');
			}
			if ( bIsValid == true) 
			{
 						disableButtons(); 
 						trapExcelPivotChanges(); 
						document.form.BUTTON_ID.value = 'Update'; 
						document.form.action = 'view.x2ps';
						document.form.submit();  
			}

			onResize();  
			return; 
}			
		
	function onValueChange(thisObj)
{
			disableButtons(); 
      enableButton('Clear');
			enableButton('SHOW_DETAILS');	   	 
			enableButton('DELETE');
			var cnt=0;

		if (thisObj == 'Usage' || thisObj == 'SourceSystem' || thisObj == 'SourceObject' || thisObj == 'TargetSystem' || thisObj == 'TargetObject')				
		{						
					form.isCreate.value='true';
					createEnabled();			
			    makeNonPkEditable();	
				
			    if(form.isUpdate.value == 'true')	
			    {
							createEnabled();
				   }
				   form.isUpdate.value == 'false'
		 }
		else
		{ 			
							if(form.isCreate.value == 'true')
							{
								createEnabled();	
							}
							else
							{
												if(form.errSts.value != 'True')
												{															
														form.isUpdate.value='true';	
														updateEnabled();
														form.ObjectClass.readOnly='false';
																	if(form.dataCnt.value &gt; 0)
																	{																		
																			makeNonPkNotEditable();
																		updateEnabled();
																	}								
											}
											else
											{
													createEnabled();	
											}
									}		
				
		}
	
		}
		
		function makeNonPkEditable()
		{
				form.ObjectClass.readOnly=false;
				form.Status.disabled=false;		
				form.CARDINALITY.disabled=false;					
				form.ViewName.readOnly=false;		  
		}
		
		function makeNonPkNotEditable()
		{
				form.ObjectClass.readOnly='true';
				form.Status.readOnly='true';
				form.CARDINALITY.readOnly='true';																			
				form.ViewName.readOnly='true';
		}
		
		function createEnabled()
		{
							enableButton('Clear');	   	 
     	 				enableButton('Create');
							enableButton('GenerateName');
							enableButton('SHOW_DETAILS');	   	 
							enableButton('DELETE');
		}

		function updateEnabled()
		{						
						enableButton('Clear');	
						enableButton('Update');
						enableButton('GenerateName');
						enableButton('SHOW_DETAILS');	   	 
						enableButton('DELETE');
		}
		
		function chkUsageValue(thisObj)
		{
						if(thisObj.value != 'Both' &amp;&amp; thisObj.value != 'Interface' &amp;&amp; thisObj.value != 'Conversion')
						 {
								 core_alert('Please select either Both or Interface or Conversion as Usage Value');
								 thisObj.options[0].selected = true; 
							}		
							else{return;}			
		
		}
		function chkStatusValue(thisObj)
		{
					var cnt=0;
					if(thisObj == 'Status')
						 {
											var statusList = document.getElementById('Status');
                      var selectedStatus = statusList.options[statusList.selectedIndex].value;
									
											if(selectedStatus != 'Active' &amp;&amp; selectedStatus != 'Deleted')
											{
											 core_alert('This operation is currently not handled. Please select Active/Deleted status');
											 statusList.options[0].selected = true; 
											 }		
											else{return;}										
													
							}	
						else
						{
											if(thisObj.value != 'Active' &amp;&amp; thisObj.value != 'Deleted')
											{
											 core_alert('This operation is currently not handled. Please select Active/Deleted status');
											 thisObj.options[0].selected = true; 
											 }		
											else{return;}				
							}			
		}
		function on_generate(){
		var objClasMnVal = this.form.ObjectClass.value;
		var mapUsageVal = this.form.Usage.value;
		var srcSysVal = this.form.SourceSystem.value;
		var trgtSysVal = this.form.TargetSystem.value;	
		var usgVal = null;
		if(mapUsageVal == 'Conversion')
		{
				 usgVal = 'C';
		}
		else
		{
					if(mapUsageVal == 'Interface')
					{
								usgVal = 'I';
					}
					else
					{
								if(mapUsageVal == 'Both')
								{
										usgVal = 'B';
									}
									else{
											usgVal = '';
									}
						}
		}		
	  var lenOfObjClas = objClasMnVal.length ;	
		var objClas= null;
		if(lenOfObjClas &gt; 22)
		{
				objClas = objClasMnVal.substr(0,22);				
		}
		else
		{
						objClas = objClasMnVal;			
		}
		
		var len = objClas.length ;		
		
		var underScoreIndexSrc = srcSysVal.indexOf('_');	
		var underScoreIndexTrgt = trgtSysVal.indexOf('_');			
	
		if(underScoreIndexSrc &gt;= 0)
		{		
			var src = srcSysVal.substr(0,srcSysVal.indexOf('_'));
			if(src == 'ORA')
			{		
				var srcval = srcSysVal.substr(srcSysVal.lastIndexOf('_')+1,srcSysVal.length); 
			}
			else
			{		
				var srcval = srcSysVal;				
			}
		}
		else
		{		
		var srcval = srcSysVal;			
		}			

		if(underScoreIndexTrgt &gt;= 0)
		{		
		var trgt = trgtSysVal.substr(0,trgtSysVal.indexOf('_'));		
			if(trgt == 'ORA')
			{				
				var trgtVal = trgtSysVal.substr(trgtSysVal.lastIndexOf('_')+1,trgtSysVal.length);				
			}
			else
			{		
				var trgtVal = trgtSysVal;				
			}
		}
		else
		{				
		var trgtVal = trgtSysVal;			
		}	

		var roundOffObjClass = Math.round((29 - (len + 5))/2);
		var calculateLeftforSrc = 29 - (len + 5 + trgtVal.length);
		var calculateLeftforTrgt = 29 - (len + 5 + srcval.length);
		var left_for_src = Math.max(roundOffObjClass,calculateLeftforSrc);
		var left_for_trgt = Math.max(roundOffObjClass,calculateLeftforTrgt);
		var Source = null;
				var Target = null;
				if(left_for_src &gt; srcval.lemgth)
		{
				Source = srcval;			
		}
		else
		{
				var Source = srcval.substr(0,left_for_src);				
		}
		
		if(left_for_trgt &gt; trgtVal.lemgth)
		{
				Target= trgtVal;			
		}
		else
		{
				var Target = trgtVal.substr(0,left_for_trgt);			
		}				
			var finalName = objClas+'_'+usgVal+'_'+Source+'_'+Target+'_'+'V';
				
		if(objClasMnVal != '' &amp;&amp; mapUsageVal != '' &amp;&amp; srcSysVal != '' &amp;&amp; trgtSysVal != '' )
		{	
		this.form.ViewName.value = finalName;
		}
		
		if(objClasMnVal == '')
				{		
					core_alert('Please Enter a Value for Object Class');
				}	
		
		if(mapUsageVal == '')
					{	
						core_alert('Please Enter a Value for Usage Value');
					}
		
		if(srcSysVal == '')
							{		
								core_alert('Please Enter a Value for Source Object');
							}
		if(trgtSysVal == '')
							{	
												core_alert('Please Enter a Value for Target Object');
							}


			
}    
	
		function openPopUpForSource(){
		
		var desc = this.form.ObjectClass.value;
		var sys = this.form.SourceSystem.value;

		window.open("start.x2ps?SERVICE_NAME=edmuiservice&amp;START_WORKFLOW=uiWfXrefManageSourceObject&amp;POPUP=true&amp;FIELD_NAME=SourceObject&amp;FIELD_DESC="+desc+"&amp;FIELD_SYS="+sys,null,"height=400,width=700,screenX=40,screenY=50,top=125,left=200,toolbar=no,menubar=no");
		}
		function openPopUpForTarget(){
		
		var desc = this.form.ObjectClass.value;
		var sys = this.form.TargetSystem.value;		
	
  	window.open("start.x2ps?SERVICE_NAME=edmuiservice&amp;START_WORKFLOW=uiWfXrefManageTargetObject&amp;POPUP=true&amp;FIELD_NAME=TargetObject&amp;FIELD_DESC="+desc+"&amp;FIELD_SYS="+sys,null,"height=400,width=700,screenX=40,screenY=50,top=125,left=200,toolbar=no,menubar=no");
		}

		function openPopUpForComments()
		{		
				var cmnt = this.form.comments.value;	
		  	window.open("start.x2ps?SERVICE_NAME=edmuiservice&amp;START_WORKFLOW=uiWfXrefManageComments&amp;POPUP=true&amp;FIELD_NAME=ShowComments&amp;FIELD_DESC="+cmnt+"&amp;",null,'height=500,width=600,screenX=30,screenY=30,top=100,left=150,toolbar=no,menubar=no');
		}
		
		function registerButton(btn, type, tableId )
 {
   btnTypes[btn] = type;
   var btnArray = tableButtons[tableId];

   if (btnArray == null)
   {
     btnArray = new Array();
     tableButtons[tableId] = btnArray;
   }

   var currIndex = btnArray.length;
   btnArray[currIndex] = btn;
 }

 function enableButtonsIfRowSelected()
 {
   for (var i in tableButtons)
   {
     i2uiRowSelectionCallback(i);
   }
 }

 function i2uiRowSelectionCallback(tableId)
 {
   var btnArray = tableButtons[tableId];

   if( btnArray != null )
   {
     var hasNoSelections = (i2uiGetSelectedRowNums(tableId).length == 0);

     for( i=0; i &lt; btnArray.length; i++ )
     {
       var buttonId = btnArray[i];
       pglToggleButton( buttonId, hasNoSelections );
     }
   }
 }

 function pglToggleButton( buttonId, hasNoSelections )
 {
   var type = btnTypes[buttonId];

   if (hasNoSelections == true)
   {
     i2uiToggleButtonState(buttonId, 'disabled');
   }
   else
   {
     i2uiToggleButtonState(buttonId, 'enabled', type);
   }
 }
		
		function on_click_generate()
		{
		
		}</ui:script>
</ui:page-group>