  <DEFINE_METHOD Name="createTransLane" Comment="Wrapper API to redirect the call to create a new Lane record in PEDM through UI">
		<RULE>
			<ACTION>
      <REQUEST Name="getTransLanes" AssignToVar="isTLExists" ServiceName="PEDM_MASTER">
        <OriginLocationIdentifier Value="{$thisParam/OriginLocationIdentifier/@Value}"/>
        <DestinationLocationIdentifier Value="{$thisParam/DestinationLocationIdentifier/@Value}"/>
        <TransportModeIdentifier Value="{$thisParam/TransportModeIdentifier/@Value}"/>
      </REQUEST>
      <IF_TEST Test="$isTLExists/TL_EXISTS/@Value = 'no' or $isTLExists/TL_EXISTS/@Value = 'yes' and $isTLExists/ENTITY_STATE/@Value != 'DELETED'">			
        <THEN>
          <REQUEST Name="createTransLanePedm" ServiceName="BCM_MASTER" AssignToVar="thisReturn">
            <TO_XML SelectList="$thisParam/*"/>
            <FROM_UI Value="true"/>
            <ACTIONTOBDONE Value="INSERT"/>
              <!--<SYS_TYPE Value="INSERT"/>-->
            <SOURCE Value="UI"/>
            <SourceKeyName Value="TLNE_ID"/>
            <SourceObjectMnemonicValue Value="P_M_TLNE"/>
            <SourceSystemMnemonicValue Value="{$ui_sourceSystemMnemonicVal}"/>
          </REQUEST>
        </THEN>
        <ELSE>
			<!-- DYanez RIC#237750 Retrieving appropriate CLASS_MN_VAL from TLNE_CLAS table-->
			  	<EXECUTE_SQL_QUERY AssignToVar="tlclassmnval" Value="select tlne_clas_mn_val from P_M_tlne_clas where tlne_clas_id = '{$thisParam/TransportLaneClassIdentifier/@Value}'"/>
						<IF_TEST Test="$tlclassmnval/@Status != 'Success'">
								<THEN>
	                <APPEND_TO_XML DocVar="thisReturn">
	                   <_ERRORS Value="SEVERE_ERROR">
	                     <_ERROR Value="ERROR: Unable to identify TLNE_CLAS_MN_VAL using this value: {$thisParam/TransportLaneClassIdentifier/@Value} "/>
	                   </_ERRORS>
                   </APPEND_TO_XML>
	     				  </THEN>
						<ELSE>
					<!-- RIC#237750 End -->
          <REQUEST Name="updateTransLanePedm" ServiceName="BCM_MASTER" AssignToVar="updResponse">
            <TransportLaneIdentifier Value="{$isTLExists/TL_ID/@Value}"/>
            <TransportDurationTimeCount Value="{$thisParam/TransportDurationTimeCount/@Value}"/>
				<!--	<TransLaneClass Value="{$thisParam/TransLaneClass/@Value}"/>-->
            <TransLaneClass Value="{$tlclassmnval/SQL_RESULT/TLNE_CLAS_MN_VAL/@Value}"/>
						<TransportLaneClassIdentifier Value="{$thisParam/TransportLaneClassIdentifier/@Value}"/>
						<TransportModeIdentifier Value="{$thisParam/TransportModeIdentifier/@Value}"/>
							<!-- RIC#237750 End -->
            <TransportLaneStartDate Value=""/>
            <TransportLaneEndDate Value=""/>
            <TransportLaneCommentText Value="{$thisParam/TransportLaneCommentText/@Value}"/>
            <SOURCE Value="UI"/>
            <FROM_UI Value="true"/>
            <ACTIONTOBDONE Value="UPDATE"/>
            <SYS_TYPE Value="ACTIVATE"/>
          </REQUEST>
						<TO_DOCVAR AssignToVar="thisReturn">
							<RESULT>
								<TL_ID Value="{$isTLExists/TL_ID/@Value}"/>
							</RESULT>
						</TO_DOCVAR>
				 	</ELSE>
				 </IF_TEST>	
        </ELSE>
      </IF_TEST>
			</ACTION>
		</RULE>
	</DEFINE_METHOD>
</DOCUMENTS>
