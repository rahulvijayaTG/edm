  <DEFINE_METHOD Name="createTransAsset" Comment="Wrapper API for UI to redirect the call to create new asset in interface and PEDM master tables through UI">
    <RULE>
      <ACTION>
        <REQUEST Name="genericCreateTransAsset" ServiceName="BCM_MASTER" AssignToVar="thisReturn" DocumentName="E_TransportationAsset" Action="INSERT" HandleException="true">
          <TO_XML SelectList="$thisParam/*"/>
          <CUSTOM_UI Value="true"/>
          <SYS_TYPE Value="INSERT"/>
          <SOURCE Value="UI"/>
          <SourceKeyName Value="TRNSPEQMTITM_ID"/>
          <SourceObjectMnemonicValue Value="P_M_TRNSPEQMTITM"/>
          <SourceSystemMnemonicValue Value="{$ui_sourceSystemMnemonicVal}"/>
        </REQUEST>
        <IF_TEST Test="count($thisReturn/*/_ERRORS) = 0 and $thisReturn/@Status != 'Error'">
          <THEN/>
          <ELSE>
            <EXCEPTION ForceRollback="true">
              <TO_XML DocVar="thisReturn"/>
            </EXCEPTION>
          </ELSE>
        </IF_TEST>
      </ACTION>
    </RULE>
  </DEFINE_METHOD>
