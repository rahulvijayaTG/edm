<DOCUMENTS>
  <DEFINE_METHOD Name="getSearchResults" Comment="Getting the search results for the UI">
    <RULE>
      <ACTION>
        <TO_DOCVAR AssignToVar="xmlWklyBktInfo">
          <TO_XML Select="$thisParam/BKTINFO"/>
        </TO_DOCVAR>
        <SET Var="paginateStart" FromValue="{ifElse($thisParam/START_COUNT/@Value = '-1', '0', $thisParam/START_COUNT/@Value)}"/>
        <SET Var="pgMaxRows" FromValue="{ifElse($thisParam/MAX_ROWS/@Value = null, '2', $thisParam/MAX_ROWS/@Value)}"/>
        <FORM_SEARCH_FILTER Value="{$thisParam}" AssignToVar="locFilter">
          <LocationIdentificationValue MultiValued="true" InputName="LOCID"/>
        </FORM_SEARCH_FILTER>
        <IF_TEST Test="count($locFilter/FILTER/OR) > 0">
          <THEN>
            <PRINTLN Value="multivalue"/>
            <FOR_EACH CurrentElement="currElem" SelectList="$locFilter/FILTER/OR/LocationIdentificationValue">
              <SET Attribute="ScalarFn" FromValue="upperCase" DocVar="currElem"/>
              <SET Attribute="Value" FromValue="{upperCase($currElem/@Value)}" DocVar="currElem"/>
            </FOR_EACH>
          </THEN>
          <ELSE>
            <PRINTLN Value="single value"/>
            <FOR_EACH CurrentElement="currElem" SelectList="$locFilter/FILTER/LocationIdentificationValue">
              <SET Attribute="ScalarFn" FromValue="upperCase" DocVar="currElem"/>
              <SET Attribute="Value" FromValue="{upperCase($currElem/@Value)}" DocVar="currElem"/>
            </FOR_EACH>
          </ELSE>
        </IF_TEST>
        <FORM_SEARCH_FILTER Value="{$thisParam}" AssignToVar="segFilter">
          <PartyIdentificationValue MultiValued="true" InputName="SEGID"/>
        </FORM_SEARCH_FILTER>
        <IF_TEST Test="count($segFilter/FILTER/OR) > 0">
          <THEN>
            <PRINTLN Value="multivalue"/>
            <FOR_EACH CurrentElement="currElem" SelectList="$segFilter/FILTER/OR/PartyIdentificationValue">
              <SET Attribute="ScalarFn" FromValue="upperCase" DocVar="currElem"/>
              <SET Attribute="Value" FromValue="{upperCase($currElem/@Value)}" DocVar="currElem"/>
            </FOR_EACH>
          </THEN>
          <ELSE>
            <PRINTLN Value="single value"/>
            <FOR_EACH CurrentElement="currElem" SelectList="$segFilter/FILTER/PartyIdentificationValue">
              <SET Attribute="ScalarFn" FromValue="upperCase" DocVar="currElem"/>
              <SET Attribute="Value" FromValue="{upperCase($currElem/@Value)}" DocVar="currElem"/>
            </FOR_EACH>
          </ELSE>
        </IF_TEST>
        <REQUEST Name="getLocationDetailsForSrch" AssignToVar="xmlLocationData" HandleException="true" ServiceName="PEDM_MASTER">
          <!--REQUEST Name="getLocationDetailsForSrch" AssignToVar="xmlMainLocData" HandleException="true" ServiceName="PEDM_MASTER"-->
          <LOCFILT>
            <TO_XML SelectList="$locFilter/FILTER/*"/>
          </LOCFILT>
          <!--Start P1Up Defect 117969 Code to filter on locations that do not have the specified segments -->
          <SEGFILT>
            <TO_XML SelectList="$segFilter/FILTER/*"/>
          </SEGFILT>
          <!--Endt P1Up Defect 117969 Code to filter on locations that do not have the specified segments -->
          <STARTDATE Value="{$thisParam/STARTDATE/@Value}"/>
          <ENDDATE Value="{$thisParam/ENDDATE/@Value}"/>
          <STARTATROW Value="{$paginateStart}"/>
          <MAXROWS Value="{$pgMaxRows}"/>
        </REQUEST>
        <!-- FOR HANDLING IF NO LOC RETURNED START -->
        <IF_TEST Test="$xmlLocationData/_RESULT/@Value = 'ERROR'">
          <THEN>
            <TO_DOCVAR AssignToVar="noRecExist">
              <_ERRORS>
                <_ERROR Value="Record(s) not present in the selected bucket. Please create  record(s) for selected weekly bucket(s)  or Select a different horizon to create record(s)."/>
              </_ERRORS>
            </TO_DOCVAR>
            <EXCEPTION Value="NO_RECORD_EXIST">
              <TO_XML DocVar="noRecExist"/>
            </EXCEPTION>
          </THEN>
          <ELSE/>
        </IF_TEST>
        <!-- FOR HANDLING IF NO LOC RETURNED ENDS  -->
        <REQUEST Name="getSrchUIXml" AssignToVar="xmlMainLocData" HandleException="true" ServiceName="PEDM_MASTER">
          <TO_XML SelectList="$xmlLocationData/*"/>
          <SEGFILT>
            <TO_XML SelectList="$segFilter/FILTER/*"/>
          </SEGFILT>
          <TO_XML SelectList="$xmlWklyBktInfo/*"/>
          <STARTDATE Value="{$thisParam/STARTDATE/@Value}"/>
          <ENDDATE Value="{$thisParam/ENDDATE/@Value}"/>
          <TOTALROWCOUNT Value="{$xmlLocationData/TOTALROWCOUNT/@Value}"/>
          <STARTATROW Value="{$paginateStart}"/>
        </REQUEST>
        <SET Var="thisReturn" FromDocVar="xmlMainLocData"/>
      </ACTION>
    </RULE>
  </DEFINE_METHOD>
