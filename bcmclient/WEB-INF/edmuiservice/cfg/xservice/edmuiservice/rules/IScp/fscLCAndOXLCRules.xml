  <DEFINE_METHOD Name="MapLCAndOXLCEdmUI" Comment="UI formatter for Location Storage and Oragnization x location storate">
    <RULE>
      <ACTION>
        <TO_DOCVAR AssignToVar="thisReturn">
          <UIFRMT>
            <LocationStorageStartDate Value="{substringBefore($thisParam/STRTDATE/@Value, ' ')}"/>
            <LocationStorageEndDate Value="{substringBefore($thisParam/ENDTVAL/@Value, ' ')}"/>
            <LocationStorageUnitCapacityMeasure Value="{$thisParam/OrganizationXAllocatedLocationCapacityMeasure/@Value}"/>
            <CapacityUnitOfMeasureValue Value="{$thisParam/CapacityUnitOfMeasureIdentifier/@Value}"/>
            <TargetUtilizationPercent Value="{$thisParam/OrganizationXLocationCapacityTargetUtilizationPercent/@Value}"/>
            <LocationValue Value="{$thisParam/LocationIdentifier/@Value}"/>
            <LocationStorageCommentText Value="{$thisParam/CMMNT/@Value}"/>
            <DOCUMENTNAME Value="E_LocationStorage"/>
	    <!-- Multi User Enhancement Dt:02/11/2008 Venkat Start -->
	    <LAST_MODIFIED_DATE Value="{$thisParam/LAST_MODIFIED_DATE/@Value}"/>
	    <!-- Multi User Enhancement Dt:02/11/2008 Venkat End -->
          </UIFRMT>
        </TO_DOCVAR>
      </ACTION>
    </RULE>
  </DEFINE_METHOD>
  <DEFINE_METHOD Name="MapOXLCEdmUI" Comment="UI formatter for Organization x location storage">
    <RULE>
      <ACTION>
        <TO_DOCVAR AssignToVar="thisReturn">
          <UIFRMT>
            <SegmentXLocationStorageEndDate Value="{substringBefore($thisParam/ENDTVAL/@Value, ' ')}"/>
            <SegmentLocationStorageUnitCapacityMeasure Value="{$thisParam/OrganizationXAllocatedLocationCapacityMeasure/@Value}"/>
            <TargetUtilizationPercentage Value="{$thisParam/OrganizationXLocationCapacityTargetUtilizationPercent/@Value}"/>
            <ConstraintTypeValue Value="{$thisParam/LimitClassMnemonicValue/@Value}"/>
            <BusinessOrganizationValue Value="{$thisParam/OrganizationPartyIdentifier/@Value}"/>
            <LocationValue Value="{$thisParam/LocationIdentifier/@Value}"/>
            <LocationStorageStartDate Value="{substringBefore($thisParam/STRTDATE/@Value, ' ')}"/>
            <SegmentXLocationStorageCommentText Value="{$thisParam/CMMNT/@Value}"/>
            <DOCUMENTNAME Value="E_SegmentXLocationStorage"/>
	    <!-- Multi User Enhancement Dt:02/11/2008 Venkat Start -->
	    <LAST_MODIFIED_DATE Value="{$thisParam/LAST_MODIFIED_DATE/@Value}"/>
	    <!-- Multi User Enhancement Dt:02/11/2008 Venkat End -->
          </UIFRMT>
        </TO_DOCVAR>
      </ACTION>
    </RULE>
  </DEFINE_METHOD>
