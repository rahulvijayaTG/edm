  <!--Method to sort results of the getSrchUIXml, first by segment name, then by limit class capacity type. Location comes sorted from the db. Refer to rule getLocationDetailsForSrch in pedmmaster-->
  <DEFINE_METHOD Name="sortSearch" ValidateSignature="false">
    <RULE>
      <ACTION>
        <SET Var="locationSlas" FromValue="{$thisParam/REAL_DATA/MULTI_COLLAB_DATA/LOCATION_SLAS}"/>
        <REMOVE_CHILDREN DocVar="locationSlas" ChildName="BUFFER_SLA" AssignToVar="bufSlas"/>
        <SORT_DOCS SelectList="$bufSlas" AssignToVar="newBufSlas">
          <LocationIdentifier/>
        </SORT_DOCS>
        <APPEND_TO_XML DocVar="locationSlas">
          <TO_XML SelectList="$newBufSlas"/>
        </APPEND_TO_XML>
        <FOR_EACH SelectList="$newBufSlas" CurrentElement="e">
          <SET Var="segmentSlas" FromValue="{$e/SEGMENT_SLAS}"/>
          <REMOVE_CHILDREN DocVar="segmentSlas" ChildName="BUFFER_SLA" AssignToVar="segBufSlas"/>
          <SORT_DOCS SelectList="$segBufSlas" AssignToVar="newSegBufSlas">
            <SGMNAME/>
            <OrganizationXLocationCapacityLimitClassIdentifier/>
          </SORT_DOCS>
          <APPEND_TO_XML DocVar="segmentSlas">
            <TO_XML SelectList="$newSegBufSlas"/>
          </APPEND_TO_XML>
        </FOR_EACH>
        <APPEND_TO_XML DocVar="thisReturn">
          <TO_XML SelectList="$thisParam/*"/>
        </APPEND_TO_XML>
      </ACTION>
    </RULE>
  </DEFINE_METHOD>
  <!--Method to sort results of the getSrchUIXml, first by segment name, then by limit class capacity type-->
</DOCUMENTS>