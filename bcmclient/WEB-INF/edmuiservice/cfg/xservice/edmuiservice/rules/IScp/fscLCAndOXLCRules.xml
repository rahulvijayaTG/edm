  <DEFINE_METHOD Name="createLCAndOXLC" Comment="Delegate method from UI to create records in PEDM and Master Table">
    <RULE>
      <ACTION>
        <REQUEST Name="createLCAndOXLC" ServiceName="BCM_MASTER" AssignToVar="thisReturn" HandleException="true">
          <TO_XML SelectList="$thisParam/*"/>
          <FROM_UI Value="true"/>
          <ACTIONTOBDONE Value="INSERT"/>
          <SOURCE Value="UI"/>
          <SourceKeyName Value="loccpcty_id"/>
          <SourceObjectMnemonicValue Value="P_M_loccpcty"/>
          <SourceSystemMnemonicValue Value="{$ui_sourceSystemMnemonicVal}"/>
        </REQUEST>
        <IF_TEST Test="count($thisReturn/*/_ERRORS) = 0 and $thisReturn/@Status != 'Error'">
          <THEN/>
          <ELSE>
            <EXCEPTION ForceRollback="true">
              <TO_XML DocVar="thisReturn"/>
            </EXCEPTION>
          </ELSE>
        </IF_TEST>
      </ACTION>
    </RULE>
  </DEFINE_METHOD>
