<DOCUMENTS>
	<DEFINE_METHOD Name="validateLocCapacity">
		<RULE>
			<ACTION>
				<INVOKE_VALIDATION_FRAMEWORK AssignToVar="thisReturn" DocVar="thisParam" ServiceName="PEDM_MASTER"/>
			</ACTION>
		</RULE>
	</DEFINE_METHOD>
	<DEFINE_METHOD Name="validateOrgXLocCapacity">
		<RULE>
			<ACTION>
				<INVOKE_VALIDATION_FRAMEWORK AssignToVar="thisReturn" DocVar="thisParam" ServiceName="PEDM_MASTER"/>
				<SET Var="thisParam" FromSelect="$thisReturn/REQUEST"/>
			</ACTION>
		</RULE>
	</DEFINE_METHOD>
	<DEFINE_METHOD Name="MapUICreateLCLCAndOXLCEdmUI">
		<RULE>
			<ACTION>
				<TO_DOCVAR AssignToVar="thisReturn">
          <UIFRMT>
            <DOCUMENTNAME Value="E_LocationStorage"/>
            <ACTIONTOBDONE Value="INSERT"/>
            <LocationStorageEndDate Value="{substringBefore($thisParam/OrganizationXLocationCapacityEndDate/@Value, ' ')}"/>
            <LocationStorageUnitCapacityMeasure Value="{$thisParam/OrganizationXAllocatedLocationCapacityMeasure/@Value}"/>
            <CapacityUnitOfMeasureValue Value="{$defUOMMnemonicValue}"/>
            <TargetUtilizationPercent Value="{$thisParam/OrganizationXLocationCapacityTargetUtilizationPercent/@Value}"/>
            <SourceObjectMnemonicValue Value="default"/>
            <SourceKeyName Value="default"/>
            <SourceKeyValue Value="default"/>
            <SYS_TARGET_ID/>
            <SYS_AUTH_ID/>
            <SOURCE Value="UI"/>
            <SYS_TYPE Value="INSERT"/>
            <SYS_DOCUMENT Value="E_LocationStorage"/>
            <EffectiveStartDate Value="{substringBefore($thisParam/LocationCapacityStartDate/@Value, ' ')}"/>
            <LocationIdentification Value="{$thisParam/LocationIdentifier/@Value}"/>
            <SourceSystemMnemonicValue Value="default"/>
          </UIFRMT>
        </TO_DOCVAR>
			</ACTION>
		</RULE>
	</DEFINE_METHOD>
	<DEFINE_METHOD Name="MapUICreateOXLCEdmUI">
		<RULE>
			<ACTION>
				<TO_DOCVAR AssignToVar="thisReturn">
          <UIFRMT>
            <DOCUMENTNAME Value="E_SegmentXLocationStorage"/>
            <ACTIONTOBDONE Value="INSERT"/>
            <SegmentXLocationStorageEndDate Value="{substringBefore($thisParam/OrganizationXLocationCapacityEndDate/@Value, ' ')}"/>
            <SegmentLocationStorageUnitCapacityMeasure Value="{$thisParam/OrganizationXAllocatedLocationCapacityMeasure/@Value}"/>
          <!--  <StorageUnitOfMeasure Value="{$defUOMMnemonicValue}"/>-->
            <TargetUtilizationPercentage Value="{$thisParam/OrganizationXLocationCapacityTargetUtilizationPercent/@Value}"/>
            <SourceObjectMnemonicValue Value="default"/>
            <SourceKeyName Value="default"/>
            <SourceKeyValue Value="default"/>
            <SYS_TARGET_ID/>
            <SYS_AUTH_ID/>
            <SOURCE Value="UI"/>
            <SYS_TYPE Value="INSERT"/>
            <SYS_DOCUMENT Value="E_SegmentXLocationStorage"/>
            <LocationStorageStartDate Value="{substringBefore($thisParam/LocationCapacityStartDate/@Value, ' ')}"/>
            <LocationValue Value="{$thisParam/LocationIdentifier/@Value}"/>
            <SourceSystemMnemonicValue Value="default"/>
						<BusinessOrganizationValue Value="{$thisParam/OrganizationPartyIdentifier/@Value}"/>
						<ConstraintTypeValue Value="{$thisParam/OrganizationXLocationCapacityLimitClassIdentifier/@Value}"/>
          </UIFRMT>
        </TO_DOCVAR>
			</ACTION>
		</RULE>
	</DEFINE_METHOD>
</DOCUMENTS>

