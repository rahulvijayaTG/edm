<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" 
xmlns:xcore="http://www.i2.com/xcore" 
xmlns:xcore-db="http://www.i2.com/xcore-db" 
xmlns:xapl="http://www.i2.com/xapl" 
xmlns:web="http://www.i2.com/web"
xmlns:util="http://www.i2.com/util" 
xmlns:i18n="http://www.i2.com/i18n" description="_">  

<x2:command name="init" public="yes" description="load xcore parameters">



  <xapl:print>Loading xcore init params...xxxx</xapl:print>
  <util:set-system-property name="com.i2.x2.util.identity" value="com.i2.bcm.x2.util.BcmIdentity"/>
  <util:set-system-property name="com.i2.x2.i18n.locale.source" value="com.i2.x2.util.i18n.IdentityLocaleSource"/>
  <util:set-system-property name="com.i2.x2.util.xcore.formatter" value="com.i2.bcm.x2.util.BcmRequestFormatter"/>

  <xcore:locator-config xmlns:util="http://www.i2.com/util" name="xcore">
    <util:create-properties>
      <property name="locatorURL" value="http://localhost:12000/"/>
    </util:create-properties>
  </xcore:locator-config>

	<xcore:initialize xmlns:util="http://www.i2.com/util" name="xcore">
				<util:create-properties>
					<!--<property name="xcoreArgs" value="ui_in_process.xml"/> -->
					<property name="xcoreArgs" value="xserver.xml,ui_workflow.xml,edmuiservice.xml"/>
				</util:create-properties>
	</xcore:initialize>

    <xapl:print>xxxx... done loading xcore init params.</xapl:print>
    <xapl:print>Loading metadata...</xapl:print>
    <x2:execute command="bcm.framework.services:defineServices"/>
    <x2:execute command="bcm.framework.metadata.controller:defineMetadata"/>
    <xapl:print>... done loading metadata.</xapl:print>

</x2:command>

</x2:commands>
