<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:identity="http://www.i2.com/identity" xmlns:cis="http://www.i2.com/cis" xmlns:i18n="http://www.i2.com/i18n" description="_">




  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="init">
    <!--omx:init-recent-list max="15"/-->
  </x2:command>


 

<!-- Changing below to point to siteminder logout-->

  <x2:command public="yes" description="_" name="logout">
    <xapl:if test="$ssoEnabled = 'true'">
      <cis:sso-logout/>
    </xapl:if>  
    <web:invalidate-session/>
    <web:display-page>
      <web:get-page name="siteminder_logout">
        <FROM Value="logout"/>
      </web:get-page>
    </web:display-page>
  </x2:command>

   
  
  <!-- ********************************************************************** 
  *********************************************************************** -->
</x2:commands>
