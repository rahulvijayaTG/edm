<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" description="_">
	<x2:command name="init" public="yes" description="_">
		<xapl:print>Defining EDM Permissions....</xapl:print>
		<!-- **********************************************************************
    *********************************************************************** -->
		<perm:define-permissions document="EDM_TASKS">
			<perm:state value="*">
				<perm:action value="edmDomainTable">
					<perm:allow role="edmDomainTable"/>
				</perm:action>
				<perm:action value="edmManageXRef">
					<perm:allow role="edmManageXRef"/>
				</perm:action>
				<perm:action value="edmXrefAudit">
					<perm:allow role="edmXrefAudit"/>
				</perm:action>
				<!-- iscp common activity -->
				<perm:action value="iscpWorkflow">
					<perm:allow role="iscpWorkflow"/>
				</perm:action>
				<!-- iscp TL activities -->
				<perm:action value="iscpTL">
					<perm:allow role="iscpTL"/>
				</perm:action>
				<perm:action value="iscpTransLane">
					<perm:allow role="iscpTransLane"/>
				</perm:action>
				<perm:action value="iscpTransAsset">
					<perm:allow role="iscpTransAsset"/>
				</perm:action>
				<perm:action value="iscpTransLaneXAsset">
					<perm:allow role="iscpTransLaneXAsset"/>
				</perm:action>
				<perm:action value="iscpTransLaneXProduct">
					<perm:allow role="iscpTransLaneXProduct"/>
				</perm:action>
				<perm:action value="iscpTransLaneShowHist">
					<perm:allow role="iscpTransLaneShowHist"/>
				</perm:action>
				<!-- iscp IP activities -->
				<perm:action value="iscpIP">
					<perm:allow role="iscpIP"/>
				</perm:action>
				<perm:action value="iscpIPItemLocParams">
					<perm:allow role="iscpIPItemLocParams"/>
				</perm:action>
				<perm:action value="iscpIPLocParams">
					<perm:allow role="iscpIPLocParams"/>
				</perm:action>
				<perm:action value="iscpIPManageParams">
					<perm:allow role="iscpIPManageParams"/>
				</perm:action>
				<perm:action value="iscpIPSegParams">
					<perm:allow role="iscpIPSegParams"/>
				</perm:action>
				<perm:action value="iscpIPShowHist">
					<perm:allow role="iscpIPShowHist"/>
				</perm:action>
				<!-- iscp RP activities -->
				<perm:action value="iscpRP">
					<perm:allow role="iscpRP"/>
				</perm:action>
				<perm:action value="iscpRPConfig">
					<perm:allow role="iscpRPConfig"/>
				</perm:action>
				<perm:action value="iscpRPInvPolicy">
					<perm:allow role="iscpRPInvPolicy"/>
				</perm:action>
				<perm:action value="iscpRPLayers">
					<perm:allow role="iscpRPLayers"/>
				</perm:action>
				<perm:action value="iscpRPTopLevel">
					<perm:allow role="iscpRPTopLevel"/>
				</perm:action>
				<perm:action value="iscpRPManageParams">
					<perm:allow role="iscpRPManageParams"/>
				</perm:action>
				<perm:action value="iscpRPShowHist">
					<perm:allow role="iscpRPShowHist"/>
				</perm:action>
				<!-- iscp PI activities -->
				<perm:action value="iscpPI">
					<perm:allow role="iscpPI"/>
				</perm:action>
				<perm:action value="iscpPICreateGrp">
					<perm:allow role="iscpPICreateGrp"/>
				</perm:action>
				<perm:action value="iscpPISearchEdit">
					<perm:allow role="iscpPISearchEdit"/>
				</perm:action>
				<perm:action value="iscpPIStatus">
					<perm:allow role="iscpPIStatus"/>
				</perm:action>
				<perm:action value="iscpPIShowHist">
					<perm:allow role="iscpPIShowHist"/>
				</perm:action>
				<!-- iscp FSC activities -->
				<perm:action value="iscpFSC">
					<perm:allow role="iscpFSC"/>
				</perm:action>
				<perm:action value="iscpFSCSearchEdit">
					<perm:allow role="iscpFSCSearchEdit"/>
				</perm:action>
				<perm:action value="iscpFSCShowHist">
					<perm:allow role="iscpFSCShowHist"/>
				</perm:action>
				<perm:action value="iscpFSCCreate">
					<perm:allow role="iscpFSCCreate"/>
				</perm:action>
			</perm:state>
		</perm:define-permissions>
		<!-- **********************************************************************
    *********************************************************************** -->
	</x2:command>
</x2:commands>
