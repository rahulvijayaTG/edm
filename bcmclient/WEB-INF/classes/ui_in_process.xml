<dom-config >
	<locator-config Value="xcore" >
		<property Value="http://localhost:12015/" Key="locatorURL" />
	</locator-config>
	<client-config >
		<protocol-preferences>
			<protocol Value="xrmp" />
			<protocol Value="tcpa" />
			<protocol Value="http" />
		</protocol-preferences>
		<create-soc-timeout Value="2" />
		<max-conn Value="2" />
		<service-refresh-rate Value="60" />
	</client-config>
	<appserver-config Name="MyUIServer" >
		<logger >
			<file Name="ui_process_server.log" />
			<logLevels >
				<logLevel Value="Exception" />
				<logLevel Value="Error" />
			</logLevels>
			<brief-console Value="true" />
		</logger>
		<cmdLineInput Value="false"/>
	</appserver-config>
</dom-config>
