<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:identity="http://www.i2.com/identity" xmlns:i18n="http://www.i2.com/i18n" description="_">
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getLinks">
    <x2:param name="selectedActivity"/>
    <xapl:variable name="tasks">
      <TASKS>
        <PAD Name="Tasks" DisplayText="Examples" Scrollable="yes">
          <PAD_ITEM OnClick="/base/examples/metadata_screen/studio_ui/startWf.x2c?WF_NAME=searchOrganizationsWf" DisplayText="Search Organizations"/>
          <PAD_ITEM OnClick="/base/examples/metadata_screen/studio_ui/startWf.x2c?WF_NAME=testwf1" DisplayText="Run Test1"/>
        </PAD>
      </TASKS>
    </xapl:variable>
    <xapl:return>
      <xapl:if test="count($tasks/PAD/PAD_ITEM)  >0">
        <xapl:value-of select="$tasks"/>
      </xapl:if>
    </xapl:return>
  </x2:command>
</x2:commands>
