<?xml version="1.0" encoding="UTF-8"?>

<!-- <!DOCTYPE resolvers SYSTEM "../dtd/resolvers.dtd"> -->

<resolvers>
  <resolver name="pages" class="com.i2.x2.util.web.PageMapResolver" description="Resolve via page map"/>
  <resolver name="xsl" class="com.i2.x2.util.web.XslMapResolver" description="Resolve via xsl map"/>

  <resolver name="application" class="com.i2.x2.context.resolvers.MapResolver"
    description="Resolve via a global static HashMap instance; will serve as application-wide resolver"/>

  <resolver name="I18N" class="com.i2.x2.context.resolvers.ResourceBundleResolver" description="Resource Bundle Support"/>
  <resolver name="session" class="com.i2.x2.context.resolvers.HttpSessionResolver" description="Resolve via session"/>
  <resolver name="request" class="com.i2.x2.context.resolvers.HttpRequestResolver" description="Resolve via request">
    <include resolver="session"/>
  </resolver>

  <resolver 
      name="ConfigContext" 
      class="com.i2.x2.context.resolvers.ConfigContextResolver"
      description="Resolve via current configuration context"
  >
    <init>
      <attribute name="CONFIGALIAS" value="ConfigContext" />
      <attribute name="CONFIGFILE" value="config-context.cfg" />
      <attribute name="CONFIGPATH" value="/WEB-INF/system/context/xml" />
    </init>
  </resolver> 

  <resolver name="default" class="com.i2.x2.context.resolvers.DefaultResolverProxy" description="Resolve via the default resolver">
    <include resolver="request"/>
    <include resolver="session"/>
  </resolver>

