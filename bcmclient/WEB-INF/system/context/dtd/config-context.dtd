<!-- CONFIG-CONTEXT DTD Version 1.0 -->
<!ELEMENT x2:config-context (x2:attribute)*>
<!ATTLIST x2:config-context
	xmlns:x2 CDATA #REQUIRED
  name ID #REQUIRED
	description CDATA #REQUIRED
>
<!ELEMENT x2:attribute EMPTY>
<!ATTLIST x2:attribute
	name ID #REQUIRED
	value CDATA #REQUIRED
	description CDATA #REQUIRED
  final (yes | no) "yes"
>
