<!ELEMENT resolvers (resolver+)>

<!ELEMENT resolver (init?, include*)>
<!ATTLIST resolver name ID #REQUIRED>
<!ATTLIST resolver class CDATA #REQUIRED>
<!ATTLIST resolver description CDATA #REQUIRED>

<!ELEMENT include EMPTY>
<!ATTLIST include resolver IDREF #REQUIRED>


<!ELEMENT init (attribute+)>
<!ELEMENT attribute EMPTY>
<!ATTLIST attribute name CDATA #REQUIRED
                    value CDATA #REQUIRED
>