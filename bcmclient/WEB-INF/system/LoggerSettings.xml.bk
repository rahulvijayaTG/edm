<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE log4j:configuration SYSTEM "log4j.dtd">

<!--##################  Logger settings  #######################-->

<log4j:configuration xmlns:log4j='http://jakarta.apache.org/log4j/'>

<!--##################  Appenders  #######################-->

  <appender name="Console" class="org.apache.log4j.ConsoleAppender">
    <layout class="org.apache.log4j.PatternLayout">
      <param name="ConversionPattern" value="%d{HH:mm:ss} %-20.30c [%-5p] %m\n"/>
    </layout>    
  </appender>

  <appender name="Filer" class="org.apache.log4j.RollingFileAppender">
    <param name="File" value="Server.log"/>
    <param name="MaxFileSize" value="10MB" />
    <param name="MaxBackupIndex" value="1" />
    <layout class="org.apache.log4j.TTCCLayout">
      <param name="ContextPrinting" value="true"/>
      <param name="DateFormat" value="ISO8601"/>
    </layout>    
  </appender>


<!--##################  Overall settings  #######################-->

  <category name="com.i2">
    <!--possible priority values: "warn" "error" /-->
    <priority value="warn" />
    <appender-ref ref="Filer" />
  </category>


<!--##################  Class settings  #######################-->

  <category name="com.i2.x2.engine.X2Engine">
    <!--possible priority values: "debug" "info" "fatal" /-->
    <priority value="fatal" />
  </category>

  <category name="com.i2.ui.pgl.util.PGLUtil">
    <!--possible priority values: "debug" "info" "fatal" /-->
    <priority value="fatal" />
  </category>

  <!-- ************  Message classes  ************ -->     

  <category name="com.i2.x2.model.sax.X2Parser"> 
    <priority value="warn"/>
  </category>

  <category name="com.i2.x2.util.omx.OmxRequestFormatter">
    <!--possible priority values: "debug" "fatal" /-->
    <priority value="fatal" />
  </category>

  <category name="com.i2.bcm.x2.util.BcmRequestFormatter">
      <!--possible priority values: "debug" "fatal" /-->
      <priority value="fatal" />
  </category>

  <category name="com.i2.x2.xrequest.RequestList">
    <!--possible priority values: "warn" "fatal" /-->
    <priority value="fatal" />
  </category>

  <category name="com.i2.x2.xrequest.ExecuteMethod">
    <!--possible priority values: "debug" "fatal" /-->
    <priority value="fatal" />
  </category>

  <category name="com.i2.x2.xrequest.ExecuteCommand">
    <!--possible priority values: "debug" "fatal" /-->
    <priority value="fatal" />
  </category>

  <category name="com.i2.x2.xrequest.GetDocument">
    <!--possible priority values: "debug" "fatal" /-->
    <priority value="fatal" />
  </category>

  <category name="com.i2.x2.components.util.XMapGet">
    <!--possible priority values: "debug" "fatal" /-->
    <priority value="fatal" />
  </category>

<!--###################  Theme settings  #######################-->

  <category name="com.i2.x2.util.logger.LogTheme$XaplMsgs" additivity="false">
    <!--possible priority values: "debug" "info" "fatal" /-->
    <priority value="fatal" />
    <appender-ref ref="Filer" />
  </category>

  <category name="com.i2.x2.util.logger.LogTheme$ParamFilters">
    <!--possible priority values: "info" "fatal" /-->
    <priority value="fatal" />
  </category>

  <!-- ************  UI Print themes  ************ -->     

  <category name="com.i2.x2.util.logger.LogTheme$UIPrint">
    <!--possible priority values: "debug" "info" "fatal" /-->
    <priority value="fatal" />
  </category>

  <category name="com.i2.x2.util.logger.LogTheme$UIPrint$Initization">
    <!--possible priority values: "debug" "info" "fatal" /-->
    <priority value="fatal" />
  </category>

  <category name="com.i2.x2.util.logger.LogTheme$UIPrint$Alerts">
    <!--possible priority values: "debug" "info" "fatal" /-->
    <priority value="fatal" />
  </category>

  <category name="com.i2.x2.util.logger.LogTheme$UIPrint$Codes">
    <!--possible priority values: "debug" "info" "fatal" /-->
    <priority value="fatal" />
  </category>

  <category name="com.i2.x2.util.logger.LogTheme$UIPrint$Permissions">
    <!--possible priority values: "debug" "info" "fatal" /-->
    <priority value="fatal" />
  </category>

  <category name="com.i2.x2.util.logger.LogTheme$UIPrint$Orders">
    <!--possible priority values: "debug" "info" "fatal" /-->
    <priority value="fatal" />
  </category>

  <category name="com.i2.x2.util.logger.LogTheme$UIPrint$Items">
    <!--possible priority values: "debug" "info" "fatal" /-->
    <priority value="fatal" />
  </category>

  <category name="com.i2.x2.util.logger.LogTheme$UIPrint$Preferences">
    <!--possible priority values: "debug" "info" "fatal" /-->
    <priority value="fatal" />
  </category>

  <category name="com.i2.x2.util.logger.LogTheme$UIPrint$Deployment">
    <!--possible priority values: "debug" "info" "fatal" /-->
    <priority value="fatal" />
  </category>

  <category name="com.i2.x2.util.logger.LogTheme$UIPrint$Reports">
    <!--possible priority values: "debug" "info" "fatal" /-->
    <priority value="fatal" />
  </category>

  <!-- ************  WebStressor themes  ************ -->     

  <category name="com.i2.x2.util.logger.LogTheme$WebStressor">
    <!--possible priority values: "debug" "fatal" /-->
    <priority value="fatal" />
  </category>

  <category name="com.i2.x2.util.logger.LogTheme$WebStressor$MsgIO" additivity="false">
    <!--possible priority values: "info" "fatal" /-->
    <priority value="fatal" />
    <appender-ref ref="Filer" />
  </category>

  <category name="com.i2.x2.util.logger.LogTheme$WebStressor$Search">
    <!--possible priority values: "debug" "fatal" /-->
    <priority value="fatal" />
  </category>

</log4j:configuration>
