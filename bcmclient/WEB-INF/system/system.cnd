<?xml version="1.0" encoding="UTF-8"?>
<x2:commands description="X2 system level workflows"
               xmlns:system="http://www.i2.com/system"
               xmlns:util="http://www.i2.com/util"
               xmlns:xapl="http://www.i2.com/xapl"
               xmlns:web="http://www.i2.com/web"
               xmlns:test.engine="http://www.i2.com/testl"
               xmlns:x2="http://www.i2.com/x2">

<x2:command name="ProcessRequest" 
            public="yes"  
            description="Processes requests from the X2 Servlet using the command from the request's path info">
  <system:retrieve-config-context />
  <system:get-requested-command />
  <system:execute-request />
</x2:command>

<x2:command name="AltProcessRequest" 
            public="yes"  
            description="Processes requests from the X2 Servlet using the command from the request parameter named 'command'">
  <system:retrieve-config-context />
  <system:execute-request requested-command="{$com.i2.x2.REQUEST/parameter/command}"/>
</x2:command>


<x2:command name="HandleCommandNotFound" 
            public="yes"  
            description="handles the command not found exception">

  <xapl:choose>
    <xapl:when test="{$com.i2.x2.RequestedFrom = 'servlet'}" >
      <x2:execute command="system:GotoNotFoundPage" />
    </xapl:when>
    <xapl:when test="{$com.i2.x2.RequestedFrom = 'test'}" >
      <xapl:print>   Command Not Found Handled for Test</xapl:print>
      <test.engine:test-handler />
    </xapl:when>
    <xapl:otherwise>
      <xapl:print>   Command Not Found was not handled</xapl:print>
    </xapl:otherwise>
  </xapl:choose>

</x2:command>

<x2:command name="HandleException" 
            public="yes"  
            description="handles java.lang.Throwable exception">

  <xapl:choose>
    <xapl:when test="{$com.i2.x2.RequestedFrom = 'servlet'}" >
      <x2:execute command="system:GotoErrorPage" />
    </xapl:when>
    <xapl:when test="{$com.i2.x2.RequestedFrom = 'test'}" >
      <xapl:print>   Exception Handled for Test</xapl:print>
      <test.engine:test-handler />
    </xapl:when>
    <xapl:otherwise>
      <xapl:print>   Exception was not handled</xapl:print>
    </xapl:otherwise>
  </xapl:choose>

</x2:command>

<!--x2:command name="GotoNotFoundPage" 
            public="yes"  
            description="Forwards the browser to the not found page.">
            
  <util:goto-page next-page="{$ConfigContext:CommandNotFoundPage}" />
</x2:command-->

