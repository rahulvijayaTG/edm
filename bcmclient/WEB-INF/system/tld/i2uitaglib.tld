<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE taglib
    PUBLIC "-//Sun Microsystems, Inc.//DTD JSP Tag Library 1.1//EN"
    "http://java.sun.com/j2ee/dtds/web-jsptaglibrary_1_1.dtd">

<taglib> 
  <tlibversion>1.0</tlibversion> 
  <jspversion>1.1</jspversion>
  <shortname>i2uitaglib</shortname>
  <info>taglib for ui web components</info>
      
  <tag>
    <name>xslt</name>
    <tagclass>com.i2.x2.taglib.xsl.XsltTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <attribute>
      <name>xslfile</name>
      <required>true</required>
      <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag>  


<tag>
    <name>buttonbardivider</name> 
    <tagclass>com.i2.ui.web.taglib.ButtonbarDividerTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>button bar divider </info>
     
  </tag>

  <tag>
    <name>buttonbar</name> 
    <tagclass>com.i2.ui.web.taglib.ButtonbarTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>a container of multiple buttons</info>
    <attribute>
      <name>nopadding</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
    </attribute>
  <attribute>
      <name>aligncontents</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag>
  
  <tag> 
    <name>button</name>
    <tagclass>com.i2.ui.web.taglib.ButtonTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>a button tag</info> 
    <attribute>
      <name>onclick</name>
      <required>true</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>target</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>tabindex</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>disabled</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>emphasized</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>regular</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>small</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>id</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag> 
  
  <tag>
    <name>shell</name> 
    <tagclass>com.i2.ui.web.taglib.ShellTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>the main visual container for application</info>
    <attribute>
      <name>logo</name>
      <required>true</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>background</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>username</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>actions</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>onload</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>framed</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag>
  
  <tag>
    <name>container</name> 
    <tagclass>com.i2.ui.web.taglib.ContainerTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>a simple container</info>
    <attribute>
      <name>title</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>titlesuffix</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>footer</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>

    <attribute>
      <name>collapsable</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>width</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>height</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>scrollable</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>id</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>indentcontent</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>inner</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>stretch</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>editable</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>toplevel</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>

  </tag>

  <tag>
    <name>tabbedcontainer</name> 
    <tagclass>com.i2.ui.web.taglib.TabbedContainerTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>a container with multiple tabs</info>
    <attribute>
      <name>collapsable</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>align</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag>

  <tag>
    <name>table</name> 
    <tagclass>com.i2.ui.web.taglib.TableTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>a table</info>
    <attribute>
      <name>title</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>id</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>scrollablerows</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>scrollablecolumns</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>scrollablesyncedtable</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>relatedtableids</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>width</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag>

 <tag>
    <name>treecell</name> 
    <tagclass>com.i2.ui.web.taglib.TreeCellTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>a treecell</info>
    <attribute>
      <name>onclick</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>column</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>depth</name>
      <required>true</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>name</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>nochildren</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag>
  
  <tag>
    <name>tr</name> 
    <tagclass>com.i2.ui.web.taglib.TableRowTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>table row</info>
    <attribute>
      <name>header</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>highlight</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>  
    <attribute>
      <name>class</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>  
  </tag>

  <tag>
    <name>rowselector</name>
    <tagclass>com.i2.ui.web.taglib.RowSelectorTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>table row selector</info>
    <attribute>
        <name>global</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>treecell</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>select</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>name</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>value</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
  <attribute>
        <name>checked</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>    
  </tag>

  <tag>
    <name>tree</name>
    <tagclass>com.i2.ui.web.taglib.TreeTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>tree</info>
    <attribute>
        <name>id</name>
        <required>true</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>width</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag>

  <tag>
    <name>tabset</name> 
    <tagclass>com.i2.ui.web.taglib.TabsetTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>a container of tabs</info>
    <attribute>
      <name>id</name>
      <required>true</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>tabwidth</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>onclick</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>field</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>type</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag>
  
  <tag> 
    <name>tab</name>
    <tagclass>com.i2.ui.web.taglib.TabTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>a tab</info> 
    <attribute>
      <name>onclick</name>
      <required>true</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>selected</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>target</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>alttext</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>  
  </tag> 

  <tag>
    <name>header</name> 
    <tagclass>com.i2.ui.web.taglib.HeaderTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>a container of html</info>
  </tag>
  
  <tag>
    <name>footer</name> 
    <tagclass>com.i2.ui.web.taglib.FooterTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>a container of html</info>
  </tag>
  
  <tag>
    <name>attribute</name> 
    <tagclass>com.i2.ui.web.taglib.AttributeTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>a parent tag's attribute</info>
    <attribute>
      <name>name</name>
      <required>true</required>
      <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>value</name>
      <required>no</required>
      <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag>

  <tag>
    <name>img</name> 
    <tagclass>com.i2.ui.web.taglib.ImgTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>an image</info>
    <attribute>
      <name>id</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>src</name>
      <required>true</required>
      <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>alt</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>border</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>width</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>height</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>align</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>onclick</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>disabled</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag>
  
  <tag> 
    <name>popupmenu</name>
    <tagclass>com.i2.ui.web.taglib.PopupMenuTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>popup menu</info> 
    <attribute>
      <name>name</name>
      <required>true</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag> 

  <tag> 
    <name>popupmenuoption</name>
    <tagclass>com.i2.ui.web.taglib.PopupMenuOptionTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>options for popup menu</info> 
    <attribute>
      <name>text</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>url</name>
      <required>true</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag> 

  <tag> 
    <name>navarea</name>
    <tagclass>com.i2.ui.web.taglib.NavAreaTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>draws navigational area that contains pad tags</info> 
  </tag> 

  <tag> 
    <name>pad</name>
    <tagclass>com.i2.ui.web.taglib.PadTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>container</info> 
    <attribute>
      <name>type</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>title</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>tooltip</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>name</name>
      <required>true</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>width</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>onedit</name>
    	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag> 

  <tag> 
    <name>paditem</name>
    <tagclass>com.i2.ui.web.taglib.PadItemTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>item within a pad</info> 
    <attribute>
      <name>text</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>onclick</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>target</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>selected</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>tooltip</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
      <name>disabled</name>
      <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag> 

  <tag> 
    <name>dhtml</name>
    <tagclass>com.i2.ui.web.taglib.DhtmlTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>includes dhtml javascript file and sets various globals</info> 
    <attribute>
       <name>padsupport</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>owcsupport</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag> 

  <tag>
    <name>javascript</name> 
    <tagclass>com.i2.ui.web.taglib.JavaScriptLinkTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>Generates links to javascript files or inlines their contents</info>
    <attribute>
       <name>path</name>
       <required>true</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>version</name>
       <required>false</required>
    </attribute>
    <attribute>
       <name>absolute</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>inline</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag>

  <tag>
    <name>stylesheet</name> 
    <tagclass>com.i2.ui.web.taglib.StyleSheetLinkTag</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>Generates links to javascript files or inlines their contents</info>
    <attribute>
       <name>path</name>
       <required>true</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>absolute</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>inline</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>default</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag>
  <tag>
    <name>pivot</name>
  <tagclass>com.i2.ui.web.taglib.PivotTag</tagclass>
    
<bodycontent>JSP</bodycontent>
    <info>pivot package</info>
    <attribute>
        <name>id</name>
        <required>true</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    
    
  </tag>


</taglib>
