<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE taglib
    PUBLIC "-//Sun Microsystems, Inc.//DTD JSP Tag Library 1.1//EN"
    "http://java.sun.com/j2ee/dtds/web-jsptaglibrary_1_1.dtd">

<taglib> 
  <tlibversion>1.0</tlibversion> 
  <jspversion>1.1</jspversion>
  <shortname>configurability</shortname>
  <info>Configurability Tag Libarary</info>
  
  <!--  
  <tag> 
    <name>tagname</name>
    <tagclass>com.i2.xservice.proposal.taglib.TagClass</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>Information</info> 
    <attribute>
    	<name>attributeName</name>
    	<required>true</required>
		<rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag>  
	-->

  <tag> 
    <name>generate-page</name>
    <tagclass>com.i2.x2.taglib.configurability.GeneratePage</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>generates a configured page</info> 
    <attribute>
      <name>pageName</name>
      <required>true</required>
      <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag>  

</taglib>
