<?xml version="1.0" encoding="ISO-8859-1" ?>

<!DOCTYPE taglib
  PUBLIC "-//Sun Microsystems, Inc.//DTD JSP Tag Library 1.1//EN"
  "http://java.sun.com/j2ee/dtds/web-jsptaglibrary_1_1.dtd">

<!-- Must register uri/location within web.xml -->
<!-- 
<taglib>
    <taglib-uri>webgantt.tld</taglib-uri>
    <taglib-location>/WEB-INF/tld/webgantt.tld</taglib-location>
</taglib>
-->

<taglib>
  <tlibversion>1.0</tlibversion>
  <jspversion>1.2</jspversion>
  <shortname>webgantt</shortname>
  
  <tag>
    <name>gantt</name>
    <tagclass>com.i2.web.gantt.GanttTag</tagclass>
    <bodycontent>empty</bodycontent>
    <info>Generate a gantt chart</info>
    <attribute>
       <name>model</name>
       <required>true</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>

    <attribute>
         <name>config</name>
         <required>true</required>
         <rtexprvalue>true</rtexprvalue>
    </attribute>

    <attribute>
       <name>printable</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>attribute</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>type</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>scrollable</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>title</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>rowHeight</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>x</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>y</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>showTitle</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>showGridline</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>txtWrapup</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>slotWidth</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
   <attribute>
         <name>rowGap</name>
         <required>false</required>
         <rtexprvalue>true</rtexprvalue>
   </attribute>
   <attribute>
     <name>width</name>
     <required>false</required>
     <rtexprvalue>true</rtexprvalue>
   </attribute>
  <attribute>
       <name>height</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
   </attribute>
   <attribute>
     <name>editable</name>
     <required>false</required>
     <rtexprvalue>true</rtexprvalue>
   </attribute>
   <attribute>
     <name>zoomMin</name>
     <required>false</required>
     <rtexprvalue>true</rtexprvalue>
   </attribute>
   <attribute>
     <name>zoomMax</name>
     <required>false</required>
     <rtexprvalue>true</rtexprvalue>
   </attribute>
   <attribute>
     <name>timeZoneID</name>
     <required>false</required>
     <rtexprvalue>true</rtexprvalue>
   </attribute>
  </tag>
</taglib>
