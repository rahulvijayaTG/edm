<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- *************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    <x2:param name="this"/>

    <xapl:return>
      <x2:execute command="core.history:register">
        <x2:with-param name="this" select="$this"/>
        <x2:with-param name="pPage" select="'correction_page'"/>
        <x2:with-param name="pPageName" select="'Error Correction'"/>
      </x2:execute>
    </xapl:return>
  </x2:command>

    <!--************************************************************************-->
    <x2:command public="yes" description="_" name="submit">
        <xapl:variable name="correctedForm">
            <docutil:to-xml select="$this/CORRECTED_FORM/@Value"/>
        </xapl:variable>
        <xapl:variable name="result">
            <xcore:execute-method name="//DataUploadService/executeCorrection" entireResponse="true">
                <REPORT_ID Value="{$this/ID/@Value}"/>
                <INDEX Value="{$this/INDEX/@Value}"/>
                <xapl:value-of select="$correctedForm"/>
            </xcore:execute-method>
        </xapl:variable>
        <xapl:choose>
            <xapl:when test="$result/RESPONSE/ERROR_CORRECTION_SUCCESS/@Value='false'">
                <xapl:variable name="correctionPage">
                    <web:get-page name="correction_page">
                        <REPORT_ID Value="{$this/ID/@Value}"/>
                        <INDEX Value="{$this/INDEX/@Value}"/>
                    </web:get-page>
                </xapl:variable>
                <web:display-page>
                    <web:get-page name="core_message">
                        <MESSAGE Value="Your Correction has been unsuccessful, Please try again"/>
                        <TITLE Value="Upload Message"/>
                        <ID Value="{$this/ID/@Value}"/>
                        <ID_LINK Value="{$correctionPage}"/>
                        <OK Value="true"/>
                        <OK_LINK Value="{$pages:upload_reports}"/>
                    </web:get-page>
                </web:display-page>
            </xapl:when>
            <xapl:otherwise>
                <xapl:variable name="nextPage">
                    <web:get-page name="upload_report_details">
                        <REPORT_ID Value="{$this/ID/@Value}"/>
                    </web:get-page>
                </xapl:variable>
                <web:display-page>
                    <web:get-page name="core_message">
                        <MESSAGE Value="Your Correction has been successful"/>
                        <OK Value="true"/>
                        <TITLE Value="Upload Message"/>
                        <ID Value="{$this/ID/@Value}"/>
                        <ID_LINK Value="{$nextPage}"/>
                        <OK_LINK Value="{$pages:upload_reports}"/>
                    </web:get-page>
                </web:display-page>
            </xapl:otherwise>
        </xapl:choose>
    </x2:command>

    <!--************************************************************************-->
    <x2:command public="yes" description="Reprocess all error records associated with a report" name="reprocess">
        <xapl:variable name="result">
            <xcore:execute-method name="//DataUploadService/reprocessTransaction" entireResponse="true">
                <FILTER>
                    <xapl:value-of select="$this/ID"/>
                </FILTER>
            </xcore:execute-method>
        </xapl:variable>
        <xapl:variable name="msg">
            <xapl:choose>
                <xapl:when test="$result/RESPONSE/PROCESS_STARTED/@Value='true'">
                    <xapl:value-of select="'Reprocess for Reports that were selected has started'"/>
                </xapl:when>
                <xapl:otherwise>
                    <xapl:value-of select="'Reprocess for Reports that were selected has failed please check the log files on the server'"/>
                </xapl:otherwise>
            </xapl:choose>
        </xapl:variable>

        <web:display-page>
            <web:get-page name="core_message">
                <MESSAGE Value="{$msg}"/>
                <TITLE Value="Reprocess Message"/>
                <OK Value="true"/>
                <OK_LINK Value="{$pages:upload_reports}"/>
            </web:get-page>
        </web:display-page>
    </x2:command>
</x2:commands>
