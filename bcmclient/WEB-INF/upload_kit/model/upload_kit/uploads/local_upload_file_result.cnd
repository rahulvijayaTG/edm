<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">    

  <!--******************************************************************************
  ********************************************************************************-->
  <x2:command public="yes" description="_" name="load">
     <xapl:print select="$this"/>
     <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
         <x2:with-param name="display" select="'Upload Confirmation'"/>
         <x2:with-param name="page" select="'local_upload_file_result'"/>
         <x2:with-param name="this" select="{$this}"/>
     </x2:execute>
     <xapl:variable name="uploadResponse">
      <x2:execute command="upload_kit.uploads.upload_details:uploadFile" >
        <x2:with-param name="contentType" select="$this/CONTENT_TYPE/@Value" />
	<x2:with-param name="templateName" select="$this/TEMPLATE_NAME/@Value" />
	<x2:with-param name="fileName" select="$this/FILE_NAME/@Value" />
  	<x2:with-param name="fileSize" select="$this/FILE_SIZE/@Value" />
      </x2:execute>
     </xapl:variable>
	
  <xapl:return>
     <!-- Header -->
     <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
     <!--x2:execute command="core.history:clear"/-->
     <!--x2:execute command="core.history:register">
       <x2:with-param name="this" select="$this"/>
       <x2:with-param name="pPage" select="'local_upload_file_result'"/>
       <x2:with-param name="pPageName" select="'Upload Confirmation'"/>
     </x2:execute-->

      <!-- Container -->
     <x2:execute command="upload_kit.uploads.local_upload_file_result:getContainer"/>

      <!-- response -->
      <xapl:choose>
        <xapl:when test="$uploadResponse/@Status='Error'">
          <WARNING Value="{$uploadResponse/@Description}"/>
        </xapl:when>
        <xapl:otherwise>
          <REPORT_ID Value="{$uploadResponse/REPORT_ID/@Value}"/>
        </xapl:otherwise>
      </xapl:choose>
      <xapl:value-of select="$uploadResponse/DISPLAY_TEXT"/>
      <STATUS Value="{$uploadResponse/@Status}"/>
  </xapl:return>
  </x2:command>

  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    
    <xapl:return>
      <!-- Container -->
      <CONTAINER Scrollable="yes" Editable="false">
        <!-- HELP Url="{$pages:local_upload_file_result_help}"/-->
        <STEP DisplayText="Upload Results" Selected="true">
    		  <BUTTONS>
  	        <BUTTON
              Name="OK"
              DisplayText="OK"
              OnClick="javascript:showReports();"
        			/>
          </BUTTONS>
        </STEP>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  
</x2:commands>
