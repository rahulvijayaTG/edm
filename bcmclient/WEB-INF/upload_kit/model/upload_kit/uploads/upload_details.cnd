<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
	<!--************************************************************************-->
	<x2:command public="yes" description="_" name="init">
		<xapl:variable name="dataType" global="true"/>
		<xapl:variable name="uploadContentFile" resolver="session" global="true"/>
		<xapl:variable name="batchFileRequest" resolver="session" global="true"/>
		<xapl:variable name="displayName" global="true"/>
		<xapl:variable name="details" global="true"/>
	</x2:command>
	<!-- ******************************************************************************************** -->
	<x2:command public="yes" description="_" name="getContainer">
		<x2:param name="pPage"/>
		<x2:param name="pDataType"/>
		<x2:param name="pTemplateName"/>
		<x2:param name="pDisplayName"/>
		<xapl:variable name="url_local_upload_data">
			<xapl:choose>
				<xapl:when test="$pDataType='CSV'">
					<web:get-page name="upload_local_transaction_details">
						<TEMPLATE_NAME Value="{$pTemplateName}"/>
						<DATA_TYPE Value="{$pDataType}"/>
						<DISPLAY_NAME Value="{$pDisplayName}"/>
					</web:get-page>
				</xapl:when>
				<xapl:otherwise>
					<web:get-page name="upload_local_transaction_details">
						<TEMPLATE_NAME Value="{$pTemplateName}"/>
						<DATA_TYPE Value="{$pDataType}"/>
						<DISPLAY_NAME Value="{$pDisplayName}"/>
					</web:get-page>
				</xapl:otherwise>
			</xapl:choose>
		</xapl:variable>
		<xapl:variable name="url_server_upload_data">
			<xapl:choose>
				<xapl:when test="$pDataType='CSV'">
					<web:get-page name="upload_server_transaction_details">
						<TEMPLATE_NAME Value="{$pTemplateName}"/>
						<DATA_TYPE Value="{$pDataType}"/>
						<DISPLAY_NAME Value="{$pDisplayName}"/>
					</web:get-page>
				</xapl:when>
				<xapl:otherwise>
					<web:get-page name="upload_server_transaction_details">
						<TEMPLATE_NAME Value="{$pTemplateName}"/>
						<DATA_TYPE Value="{$pDataType}"/>
						<DISPLAY_NAME Value="{$pDisplayName}"/>
					</web:get-page>
				</xapl:otherwise>
			</xapl:choose>
		</xapl:variable>
		<xapl:variable name="help">
			<xapl:choose>
				<xapl:when test=" $pPage = 'local_upload_details' ">
					<web:get-page name="upload_local_transaction_details_help"/>
				</xapl:when>
				<xapl:otherwise>
					<web:get-page name="upload_server_transaction_details_help"/>
				</xapl:otherwise>
			</xapl:choose>
		</xapl:variable>
		<xapl:variable name="pages">
			<CONTAINER Scrollable="yes">
				<HELP Url="{$help}"/>
				<STEP DisplayText="Local Upload" OnClick="{$url_local_upload_data}" Selected="{($pPage = 'local_upload_details')}">
					<BUTTONS>
						<xapl:if test="$pDataType='CSV'">
							<BUTTON Name="TemplateDetails" DisplayText="Template Details" OnClick="javascript:templateDetails();" TabIndex="202" Disabled="no"/>
						</xapl:if>
						<BUTTON Name="Upload" DisplayText="Upload" OnClick="javascript:uploadFile();" TabIndex="201" Disabled="no"/>
					</BUTTONS>
				</STEP>
			</CONTAINER>
		</xapl:variable>
		<xapl:return>
			<xapl:value-of select="$pages"/>
			<DATA_TYPE Value="{$pDataType}"/>
		</xapl:return>
	</x2:command>
	<!-- ******************************************************************************************** -->
	<x2:command public="yes" description="_" name="getStaticContainer">
		<x2:param name="pPage"/>
		<x2:param name="pDataType"/>
		<x2:param name="pTemplateName"/>
		<x2:param name="pDisplayName"/>
		<xapl:variable name="url_local_upload_data">
			<web:get-page name="upload_local_details">
				<TEMPLATE_NAME Value="{$pTemplateName}"/>
				<DATA_TYPE Value="{$pDataType}"/>
				<DISPLAY_NAME Value="{$pDisplayName}"/>
			</web:get-page>
		</xapl:variable>
		<xapl:variable name="url_server_upload_data">
			<web:get-page name="upload_server_details">
				<TEMPLATE_NAME Value="{$pTemplateName}"/>
				<DATA_TYPE Value="{$pDataType}"/>
				<DISPLAY_NAME Value="{$pDisplayName}"/>
			</web:get-page>
		</xapl:variable>
		<xapl:variable name="help">
			<xapl:choose>
				<xapl:when test=" $pPage = 'local_upload_details' ">
					<web:get-page name="upload_local_details_help"/>
				</xapl:when>
			</xapl:choose>
		</xapl:variable>
		<xapl:variable name="pages">
			<CONTAINER Scrollable="yes">
				<HELP Url="{$help}"/>
				<STEP DisplayText="Local Upload" OnClick="{$url_local_upload_data}" Selected="{($pPage = 'local_upload_details')}">
					<BUTTONS>
						<BUTTON Name="TemplateDetails" DisplayText="Template Details" OnClick="javascript:templateDetails();" TabIndex="202" Disabled="no"/>
						<BUTTON Name="Upload" DisplayText="Upload" OnClick="javascript:uploadFile();" TabIndex="201" Disabled="no"/>
					</BUTTONS>
				</STEP>
			</CONTAINER>
		</xapl:variable>
		<xapl:return>
			<xapl:value-of select="$pages"/>
			<DATA_TYPE Value="{$pDataType}"/>
		</xapl:return>
	</x2:command>
	<!--************************************************************************-->
	<x2:command public="yes" description="_" name="getDataType">
		<x2:param name="pDataType"/>
		<x2:param name="pDisplayName"/>
		<xapl:set-variable name="dataType" resolver="session">
			<xapl:choose>
				<xapl:when test="{string-length($pDataType) > 0}">
					<xapl:value-of select="{$pDataType}"/>
				</xapl:when>
				<xapl:otherwise>CSV</xapl:otherwise>
			</xapl:choose>
		</xapl:set-variable>
		<docutil:remove select="{$display_name}"/>
		<xapl:set-variable name="displayName" resolver="session">
			<xapl:value-of select="{$pDisplayName}"/>
		</xapl:set-variable>
		<xapl:return>
			<DATA_TYPE Value="{$dataType}"/>
			<DISPLAY_NAME Value="{$display_name}"/>
		</xapl:return>
	</x2:command>
	<!--************************************************************************-->
	<x2:command public="yes" description="_" name="uploadFile">
		<x2:param name="contentType" select="$this/CONTENT_TYPE/@Value"/>
		<x2:param name="templateName" select="$this/TEMPLATE_NAME/@Value"/>
		<x2:param name="fileName" select="$this/FILE_NAME/@Value"/>
		<x2:param name="fileSize" select="$this/FILE_SIZE/@Value"/>
		<xapl:print>TEMPLATE NAME  <xapl:value-of select="$templateName"/>
		</xapl:print>
		<xapl:print>File Content From Session  <xapl:value-of select="$uploadContentFile"/>
		</xapl:print>
		<xapl:variable name="uploadResponse">
			<xcore:execute-method name="//DataUploadService/uploadBatchRequestsMem" Template="{$templateName}" FileFragment="{$fileName}" entireResponse="true" >
				<CONTENT>
					<xapl:value-of select="{$uploadContentFile}"/>
				</CONTENT>
			</xcore:execute-method>
		</xapl:variable>
    <xapl:print select="$uploadResponse"/>
		<xapl:return>
			<xapl:value-of select="{$uploadResponse/RESPONSE}"/>
			<DISPLAY_NAME Value="{$displayName}"/>
		</xapl:return>
	</x2:command>
</x2:commands>
