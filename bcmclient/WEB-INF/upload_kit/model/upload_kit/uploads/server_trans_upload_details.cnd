<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">    

  <!--******************************************************************************
  ********************************************************************************-->
  <x2:command public="yes" description="_" name="load">

  	<xapl:return>
      <!-- Header -->
      <x2:execute command="upload_kit.uploads.server_trans_upload_details:getHeader"/>
      
      <!-- Container -->
	    <x2:execute command="upload_kit.uploads.upload_details:getContainer">
    		<x2:with-param name="pPage" select="'server_upload_details'"/>
    		<x2:with-param name="pDataType" select="$this/DATA_TYPE/@Value"/>
    		<x2:with-param name="pTemplateName" select="$this/TEMPLATE_NAME/@Value"/>
        <x2:with-param name="pDisplayName" select="$this/DISPLAY_NAME/@Value"/>
      </x2:execute>

      <x2:execute command="upload_kit.uploads.server_trans_upload_details:loadServerUploadDataDetails">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
  	</xapl:return>
  </x2:command>

  <!-- *************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
     
    <!-- <xapl:variable name="origHeader" enforceList="true">       
        <x2:execute command="core.page.view:getHeader" />
    </xapl:variable> -->

    <xapl:return>
	    <!-- <HEADER>
        <HEADING Value="Transaction Templates"/>
        <xapl:value-of select="$origHeader/*"/>
	    </HEADER> -->
      <x2:execute command="upload_kit.templates.static_templates:getHeader" />
    </xapl:return>
  </x2:command>
  
  <!-- ********************************************************************** 
  *********************************************************************** -->
 	<x2:command public="yes" description="_" name="loadServerUploadDataDetails">
    <x2:param name="this"/>
    
    <xapl:return>
      <xapl:value-of select="$this/*" />
      
 		  <x2:execute command="upload_kit.uploads.upload_details:getDataType">
    		<x2:with-param name="pDataType" select="$this/DATA_TYPE/@Value"/>
    		<x2:with-param name="pDisplayName" select="$this/DISPLAY_NAME/@Value"/>
 		  </x2:execute>
      
  	  <xcore:execute-method  name="//DataUploadService/getTemplate">
  	    <TEMPLATE Name="{$this/TEMPLATE_NAME/@Value}"/>
  	  </xcore:execute-method>
    </xapl:return>
	</x2:command>
    
  
</x2:commands>
