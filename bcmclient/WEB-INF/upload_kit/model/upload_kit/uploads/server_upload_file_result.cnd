<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">

  <!--******************************************************************************
  ********************************************************************************-->
  <x2:command public="yes" description="_" name="load">

  	<xapl:return>
      <!-- Header -->
      <x2:execute command="upload_kit.uploads.server_upload_file_result:getHeader"/>

      <!-- Container -->
	    <x2:execute command="upload_kit.uploads.server_upload_file_result:getContainer"/>

      <x2:execute command="upload_kit.uploads.server_upload_file_result:loadServerUploadReport" >
        <x2:with-param name="this" select="$this" />
      </x2:execute>
  	</xapl:return>
  </x2:command>

  <!-- *************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">

    <xapl:variable name="origHeader" enforceList="true">
      <x2:execute command="core.page.view:getHeader" />
    </xapl:variable>

    <xapl:return>
	    <HEADER>
        <HEADING Value="Server Upload Result"/>
        <xapl:value-of select="$origHeader/*"/>
	    </HEADER>
    <!--   <x2:execute command="upload_kit.templates.static_templates:getHeader" /> -->
    </xapl:return>
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">

    <xapl:return>
      <!-- Container -->
      <CONTAINER>
        <!--HELP Url="{$pages:server_upload_file_result_help}"/-->
        <STEP DisplayText="Upload Confirmation" Selected="true">
    		  <BUTTONS>
  	        <BUTTON
              Name="OK"
              DisplayText="OK"
              OnClick="javascript:showReports();"
        			/>
          </BUTTONS>
        </STEP>
  	  </CONTAINER>
    </xapl:return>
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
	<x2:command public="yes" description="_" name="loadServerUploadReport">
    <x2:param name="this"/>
		<xapl:print select="$this"/>
	  <xapl:variable name="uploadResponse">
  		<xcore:execute-method name="//DataUploadService/uploadFileWithoutBatchRequests" entireResponse="true">
	      <FILE_PATH Value="{$this/serverFile/@Value}"/>
	      <NAME Value="{$this/serverFile/@Value}"/>
	      <DATA_TYPE Value="{$this/DATA_TYPE/@Value}"/>
	    </xcore:execute-method>
	  </xapl:variable>

	  <xapl:return>
      <xapl:choose>
        <xapl:when test="$uploadResponse/@Status = 'Error'">
          <WARNING Value="{$uploadResponse/RESPONSE/@Description}"/>
        </xapl:when>
        <xapl:otherwise>
          <xapl:value-of select="{$uploadResponse/RESPONSE/*}"/>
        </xapl:otherwise>
      </xapl:choose>
	  </xapl:return>

	</x2:command>

</x2:commands>
