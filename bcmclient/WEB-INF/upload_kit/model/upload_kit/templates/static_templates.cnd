<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">    

  <!--******************************************************************************
  ********************************************************************************-->
  <x2:command public="yes" description="_" name="load">

    <xapl:return>
      <!-- Header -->
      <x2:execute command="upload_kit.templates.static_templates:getHeader"/>
      <!-- Container -->
      <x2:execute command="upload_kit.templates.static_templates:getContainer"/>

      <x2:execute command="upload_kit.templates.static_templates:loadStaticTemplates">
        <x2:with-param name="pDataType" select="$this/DATA_TYPE/@Value"/>
      </x2:execute>

    </xapl:return>
  </x2:command>

  <!-- *************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">

    <xapl:variable name="origHeader" enforceList="true">
      <x2:execute command="core.page.view:getHeader">
      </x2:execute>
    </xapl:variable>

    <xapl:return>
    <HEADER>
        <HEADING Value="Static Templates"/>
        <xapl:value-of select="$origHeader/*"/>
    </HEADER>
    </xapl:return>
  </x2:command>
  
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    
    <xapl:return>
      <!-- Container -->
      <CONTAINER Scrollable="yes" Editable="false">
        <HELP Url="{$pages:upload_static_templates_help}"/>
        <STEP
             DisplayText="Static Templates" 
             OnClick="{$pages:upload_static_templates_}" 
             Selected="true">
        </STEP>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="loadStaticTemplates">
    <x2:param name="pDataType" select="$this/DATA_TYPE/@Value"/>
    
    <xapl:variable name="templates">
      <xcore:execute-method  name="//DataUploadService/getAllTemplates">
      </xcore:execute-method>
    </xapl:variable>
    <xapl:variable name="staticTemplates">
      <STATIC_TEMPLATES/>
    </xapl:variable>
    <xapl:variable name="dataType">
      <DATA_TYPE>
        <xapl:value-of select="$pDataType"/>
      </DATA_TYPE>
    </xapl:variable>
    <xapl:for-each varName="templateType" select="{$templates}">
      <xapl:if test="starts-with($templateType/@Value,'Static')">
        <docutil:add select="{$staticTemplates}">
          <xapl:value-of select="{$templateType}"/>
        </docutil:add>
      </xapl:if>
    </xapl:for-each>  
  
    <xapl:return>
      <TEMPLATES>
        <xapl:value-of select="{$staticTemplates}" />
      </TEMPLATES>
      <xapl:value-of select="{$dataType}" />
    </xapl:return>
  </x2:command>  
       
</x2:commands>
