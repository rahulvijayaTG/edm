<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">    

  <!--******************************************************************************
  ********************************************************************************-->
  <x2:command public="yes" description="_" name="load">

  	<xapl:return>
      <!-- Header -->
      <x2:execute command="upload_kit.templates.add_template:getHeader"/>
      
      <!-- Container -->
      <x2:execute command="upload_kit.templates.add_template:getContainer"/>

      <x2:execute command="upload_kit.templates.add_template:loadAddTemplatePageData" />     
  	</xapl:return>
  </x2:command>

  <!-- *************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">

    <xapl:variable name="origHeader" enforceList="true">
      <x2:execute command="upload_kit.templates.templates:getHeader">
      </x2:execute>
    </xapl:variable>
	
	  <xapl:variable name="templatesPage">
      <web:get-page name="upload_templates" />
    </xapl:variable>

    <xapl:return>
	    <HEADER>
        <HEADING2 Value="Add Template"/>
        <HEADING_LINK Value="{$templatesPage}" />	
        <xapl:value-of select="$origHeader/*"/>
	    </HEADER>
    </xapl:return>
  </x2:command>
    
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    
    <xapl:return>
      <!-- Container -->
      <CONTAINER Scrollable="yes" Editable="true">
        <HELP Url="{$pages:add_upload_templates_help}"/>
        <STEP
             DisplayText="Add Template" 
             Selected="true">
          <BUTTONS>
  	        <BUTTON
              Name="submit"
              DisplayText="Submit"
              OnClick="javascript:addTemplate();"
        			/>
           </BUTTONS>
        </STEP>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="loadAddTemplatePageData">
  	<xapl:variable name="addTemp">
  	  <TEMPLATE Name="{$this/TEMPLATE_NAME/@Value}" DisplayName="{$this/DISPLAY_NAME/@Value}"
  	    TemplateType="{$this/TEMPLATE_TYPE/@Value}" DataType="{$this/DATA_TYPE/@Value}"
  		  ServiceName="{$this/SERVICE_NAME/@Value}" ApiName="{$this/API_NAME/@Value}">
  	  </TEMPLATE>
  	</xapl:variable>
  	<xapl:variable name="selectedTempType">
  	  <SELECTED_TEMPLATE_TYPE Value="{$this/SELECTED_TEMPLATE_TYPE/@Value}"/>
  	</xapl:variable>
  	<xapl:variable name="selectedRefTemp">
  	  <SELECTED_REF_TEMPLATE Value="{$this/SELECTED_REF_TEMPLATE/@Value}"/>
  	</xapl:variable>
  	<xapl:variable name="selectedTempGroupType">
  	  <TEMPLATE_GROUP_TYPE Value="{$this/TEMPLATE_GROUP_TYPE/@Value}"/>
  	</xapl:variable>
  	
  	<xapl:variable name="allTemplates">
  	  <ALL_TEMPLATES>
  	    <xcore:execute-method  name="//DataUploadService/getAllTemplates">
  	    </xcore:execute-method>
  	  </ALL_TEMPLATES>
  	</xapl:variable>
    
    <xapl:return>
  	  <xapl:value-of select="$addTemp" />
  	  <xapl:value-of select="$allTemplates"/>
  	  <xapl:value-of select="$selectedTempType"/>
  	  <xapl:value-of select="$selectedRefTemp"/>
  	  <xapl:value-of select="$tempProperty"/>
  	  <xapl:value-of select="$tempType"/>
  	  <xapl:value-of select="$selectedTempGroupType"/>
    </xapl:return>
  </x2:command>

  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="addTemplate">
    <xapl:variable name="properties">
    	<xapl:for-each varName="property" select="{$tempProperty/TEMPLATE_PROPERTY/@Name}">
  		  <PROPERTY Name="{$property}"/>
  		</xapl:for-each>
  	</xapl:variable>
  	
  	<xapl:variable name="templateType">
  	  <xapl:value-of select="concat($this/TEMPLATE_GROUP_TYPE/@Value,'.', $this/TEMPLATE_TYPE/@Value)"/>
  	</xapl:variable>
  	
  	<xcore:execute-method name="//DataUploadService/addTemplate">
  	  <REF_TEMPLATE Name="{$this/SELECTED_REF_TEMPLATE/@Value}"/>
  	  <TEMPLATE Name="{$this/TEMPLATE_NAME/@Value}" 
  	    DisplayName="{$this/DISPLAY_NAME/@Value}" 
  		TemplateType="{$templateType}"
  		DataType="{$this/DATA_TYPE/@Value}"
  		ServiceName="{$this/SERVICE_NAME/@Value}"
  		ApiName="{$this/API_NAME/@Value}">
  		<xapl:value-of select="$properties"/>
  	  </TEMPLATE>
  	</xcore:execute-method>
    	
  	<web:display-page>
      <web:get-page name="upload_templates">
      </web:get-page>
    </web:display-page>
  </x2:command>
  
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="addTemplateProperty">
	  <docutil:add select="{$tempProperty}">
      <TEMPLATE_PROPERTY Name="{$this/PROPERTY_VALUE/@Value}">
      </TEMPLATE_PROPERTY>
    </docutil:add>
	
	  <web:display-page>
      <web:get-page name="add_upload_templates">
    	  <TEMPLATE_NAME Value="{$this/TEMPLATE_NAME/@Value}"/>
    		<DISPLAY_NAME Value="{$this/DISPLAY_NAME/@Value}"/>
    		<TEMPLATE_TYPE Value="{$this/TEMPLATE_TYPE/@Value}"/>
    		<DATA_TYPE Value="{$this/DATA_TYPE/@Value}"/>
    		<SERVICE_NAME Value="{$this/SERVICE_NAME/@Value}"/>
    		<API_NAME Value="{$this/API_NAME/@Value}"/>
    		<SELECTED_TEMPLATE_TYPE Value="{$this/SELECTED_TEMPLATE_TYPE/@Value}"/>
    		<SELECTED_REF_TEMPLATE Value="{$this/SELECTED_REF_TEMPLATE/@Value}"/>
    		<TEMPLATE_GROUP_TYPE Value="{$this/TEMPLATE_GROUP_TYPE/@Value}"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="addTemplateType">
    <xapl:variable name="templateType">
  	  <xapl:value-of select="concat($this/TEMPLATE_GROUP_TYPE/@Value,'.', $this/ADD_TEMPLATE_TYPE/@Value)"/>
  	</xapl:variable>
  	<docutil:add select="{$tempType}">
      <TEMPLATE_TYPE Value="{$templateType}">
      </TEMPLATE_TYPE>
    </docutil:add>
	
   <web:display-page>
      <web:get-page name="add_upload_templates">
    	  <TEMPLATE_NAME Value="{$this/TEMPLATE_NAME/@Value}"/>
    		<DISPLAY_NAME Value="{$this/DISPLAY_NAME/@Value}"/>
    		<TEMPLATE_TYPE Value="{$this/TEMPLATE_TYPE/@Value}"/>
    		<DATA_TYPE Value="{$this/DATA_TYPE/@Value}"/>
    		<SERVICE_NAME Value="{$this/SERVICE_NAME/@Value}"/>
    		<API_NAME Value="{$this/API_NAME/@Value}"/>
    		<SELECTED_TEMPLATE_TYPE Value="{$this/SELECTED_TEMPLATE_TYPE/@Value}"/>
    		<SELECTED_REF_TEMPLATE Value="{$this/SELECTED_REF_TEMPLATE/@Value}"/>
    		<TEMPLATE_GROUP_TYPE Value="{$this/TEMPLATE_GROUP_TYPE/@Value}"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="updateTemplateType">
	  <web:display-page>
      <web:get-page name="add_upload_templates">
    	  <TEMPLATE_NAME Value="{$this/TEMPLATE_NAME/@Value}"/>
    		<DISPLAY_NAME Value="{$this/DISPLAY_NAME/@Value}"/>
    		<TEMPLATE_TYPE Value="{$this/TEMPLATE_TYPE/@Value}"/>
    		<DATA_TYPE Value="{$this/DATA_TYPE/@Value}"/>
    		<SERVICE_NAME Value="{$this/SERVICE_NAME/@Value}"/>
    		<API_NAME Value="{$this/API_NAME/@Value}"/>
    		<SELECTED_TEMPLATE_TYPE Value="{$this/SELECTED_TEMPLATE_TYPE/@Value}"/>
    		<SELECTED_REF_TEMPLATE Value="{$this/SELECTED_REF_TEMPLATE/@Value}"/>
    		<TEMPLATE_GROUP_TYPE Value="{$this/TEMPLATE_GROUP_TYPE/@Value}"/>
      </web:get-page>
    </web:display-page>
  </x2:command>

  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="deleteTemplateProperty">
    <xapl:for-each varName="propName" select="{$this/PROPERTY_NAME/@Value}">
	  <docutil:remove select="$tempProperty/TEMPLATE_PROPERTY[@Name = $propName]"/>
    </xapl:for-each>
	
  	<web:display-page>
      <web:get-page name="add_upload_templates">
  	    <TEMPLATE_NAME Value="{$this/TEMPLATE_NAME/@Value}"/>
    		<DISPLAY_NAME Value="{$this/DISPLAY_NAME/@Value}"/>
    		<TEMPLATE_TYPE Value="{$this/TEMPLATE_TYPE/@Value}"/>
    		<DATA_TYPE Value="{$this/DATA_TYPE/@Value}"/>
    		<SERVICE_NAME Value="{$this/SERVICE_NAME/@Value}"/>
    		<API_NAME Value="{$this/API_NAME/@Value}"/>
    		<SELECTED_TEMPLATE_TYPE Value="{$this/SELECTED_TEMPLATE_TYPE/@Value}"/>
    		<SELECTED_REF_TEMPLATE Value="{$this/SELECTED_REF_TEMPLATE/@Value}"/>
    		<TEMPLATE_GROUP_TYPE Value="{$this/TEMPLATE_GROUP_TYPE/@Value}"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  		 
</x2:commands>
