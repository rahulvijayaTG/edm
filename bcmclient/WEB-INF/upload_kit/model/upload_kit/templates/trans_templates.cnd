<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">

  <x2:command public="yes" description="_" name="init">
    <xapl:variable name="permTemplates" resolver="session" global="true"/>
	</x2:command>

  <!--******************************************************************************
  ********************************************************************************-->
  <x2:command public="yes" description="_" name="load">

  	<xapl:return>
      <!-- Header -->
      <x2:execute command="upload_kit.templates.trans_templates:getHeader"/>
      <!-- Container -->
      <x2:execute command="upload_kit.templates.trans_templates:getContainer"/>

      <x2:execute command="upload_kit.templates.trans_templates:loadTransTemplates">
        <x2:with-param name="pDataType" select="$this/DATA_TYPE/@Value"/>
      </x2:execute>

  	</xapl:return>
  </x2:command>

  <!-- *************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
     
    <xapl:return>
      <x2:execute command="core.history:clear"/>
      <x2:execute command="core.history:register">
        <x2:with-param name="this" select="$this"/>
        <x2:with-param name="pPage" select="'upload_transaction_templates'"/>
        <x2:with-param name="pPageName" select="'Transaction Templates'"/>
      </x2:execute>
    </xapl:return>
  </x2:command>

  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">

    <xapl:return>
      <!-- Container -->
      <CONTAINER Scrollable="no" Editable="false">
        <HELP Url="{$pages:upload_transaction_templates_help}"/>
        <STEP
             DisplayText="Templates" 
             OnClick="{$pages:upload_transaction_templates}" 
             Selected="true">
        </STEP>
      </CONTAINER>
    </xapl:return>
  </x2:command>

  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="loadTransTemplates">
    <x2:param name="pDataType" select="$this/DATA_TYPE/@Value"/>

		<xapl:variable name="dataType">
			<DATA_TYPE>
					<xapl:value-of select="$pDataType"/>
			</DATA_TYPE>
		</xapl:variable>

		<xapl:if test="count($permTemplates/*) = 0">
			<xapl:variable name="templates">
				<xcore:execute-method  name="//DataUploadService/getAllTemplates">
				</xcore:execute-method>
			</xapl:variable>

			<xapl:variable name="transTemplates">
				<TRANSACTION_TEMPLATES/>
			</xapl:variable>

			<xapl:for-each varName="templateType" select="$templates">
				<xapl:if test="starts-with($templateType/@Value,'Transaction')">
					<docutil:add select="$transTemplates">
						<xapl:value-of select="$templateType"/>
					</docutil:add>
				</xapl:if>
			</xapl:for-each>  

			<!-- Upload Permissibility -->
			<xapl:set-variable name="permTemplates">
				<TRANSACTION_TEMPLATES>
					<xapl:for-each varName="templateType" select="$transTemplates/TEMPLATE_TYPE">
						<TEMPLATE_TYPE Value="{$templateType/@Value}">
							<xapl:for-each varName="template" select="$templateType/TEMPLATE">
								<xapl:print select="$template"/>
								<xapl:if test="isAllowed('UPLOAD_KIT', $template/@UserData)">
									<xapl:value-of select="$template"/>
								</xapl:if>
							</xapl:for-each>
						</TEMPLATE_TYPE>
					</xapl:for-each>
				</TRANSACTION_TEMPLATES>
			</xapl:set-variable>

			<docutil:remove select="$permTemplates/TEMPLATE_TYPE[not(TEMPLATE)]"/>
		</xapl:if>

    <xapl:return>
			<TEMPLATES>
				<xapl:value-of select="$permTemplates" />
			</TEMPLATES>
	  	<xapl:value-of select="$dataType" />
    </xapl:return>
  </x2:command>

</x2:commands>
