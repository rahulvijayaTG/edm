<?xml version="1.0" encoding="UTF-8"?>
<x2:commands
	xmlns:x2="http://www.i2.com/x2"
	xmlns:core="http://www.i2.com/core"
	xmlns:xcore="http://www.i2.com/xcore"
	xmlns:xcore-db="http://www.i2.com/xcore-db"
	xmlns:xapl="http://www.i2.com/xapl"
	xmlns:web="http://www.i2.com/web"
	xmlns:docutil="http://www.i2.com/docutil"
	xmlns:util="http://www.i2.com/util"
	xmlns:FUNCTION="http://www.i2.com/FUNCTION"
	xmlns:REMOVE="http://www.i2.com/REMOVE"
	xmlns:xudl="http://www.i2.com/xudl"
	xmlns:cfg="http://www.i2.com/configurability"
	xmlns:perm="http://www.i2.com/permissibility"
	xmlns:omx="http://www.i2.com/omx"
	xmlns:i18n="http://www.i2.com/i18n"
	description="_">

  <!-- ********************************************************************************************
  ******************************************************************************************** -->
  <x2:command public="yes" description="_" name="init">

    <x2:execute command="upload_kit.pages:defineCore"/>

  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="defineCore" public="yes" description="_">

    <!-- Upload Status Report -->
    <web:define-page name="upload_reports" url="/upload_kit/reports/reports.jsp?ID=*&amp;DO_SEARCH=Yes"/>
		<web:define-page name="upload_reports_back" url="/upload_kit/reports/reports.jsp"/>
    <web:define-xsl name="upload_reports" url="/upload_kit/reports/xsl/select.xsl"/>
    <web:define-page name="upload_reports_help" url="/core/help/upstat_error.html"/>

    <!-- Upload Status Report Details -->
    <web:define-page name="upload_report_details" url="/upload_kit/reports/report_details.jsp"/>
    <web:define-xsl name="upload_report_details" url="/upload_kit/reports/xsl/reportDetails.xsl"/>
    <web:define-page name="upload_report_details_help" url="/core/help/search_upload_status.html"/>
    <web:define-page name="upload_select_reports_help" url="/core/help/result_upload_status.html"/>

    <!-- Upload Static Templates -->
  	<web:define-page name="upload_static_templates" url="/upload_kit/templates/static_templates.jsp?DATA_TYPE=STATIC"/>
    <web:define-xsl name="upload_static_templates" url="/upload_kit/templates/xsl/templatesTree.xsl"/>
    <web:define-page name="upload_static_templates_help" url="/core/help/upload_file.html"/>

    <!-- Upload Transaction Templates -->
  	<web:define-page name="upload_transaction_templates" url="/upload_kit/templates/trans_templates.jsp?DATA_TYPE=TRANSACTION"/>
    <web:define-xsl name="upload_transaction_templates" url="/upload_kit/templates/xsl/templatesTree.xsl"/>
    <web:define-page name="upload_transaction_templates_help" url="/core/help/upload_file.html"/>

    <!-- Local Static Upload Detail -->
  	<web:define-page name="upload_local_details" url="/upload_kit/uploads/local_upload_details.jsp"/>
    <web:define-xsl name="upload_local_details" url="/upload_kit/uploads/xsl/localUploadDetails.xsl"/>
    <web:define-page name="upload_local_details_help" url="/core/help/upload_trans_file.html"/>

    <!-- Server Static Upload Detail -->
  	<web:define-page name="upload_server_details" url="/upload_kit/uploads/server_upload_details.jsp"/>
    <web:define-xsl name="upload_server_details" url="/upload_kit/uploads/xsl/serverUploadDetails.xsl"/>
    <web:define-page name="upload_server_details_help" url="/core/help/upload_trans_file.html"/>

    <!-- Local Transaction Upload Detail -->
  	<web:define-page name="upload_local_transaction_details" url="/upload_kit/uploads/local_trans_upload_details.jsp"/>
    <web:define-xsl name="upload_local_transaction_details" url="/upload_kit/uploads/xsl/localUploadDetails.xsl"/>
    <web:define-page name="upload_local_transaction_details_help" url="/core/help/upload_trans_file.html"/>

    <!-- Local Upload Result -->
  	<web:define-page name="local_upload_file_result" url="/upload_kit/uploads/local_upload_file_result.jsp"/>
    <web:define-xsl name="local_upload_file_result" url="/upload_kit/uploads/xsl/uploadResult.xsl"/>
    <web:define-page name="local_upload_file_result_help" url="/core/help/upload_file.html"/>

    <!-- Server Transaction Upload Detail -->
  	<web:define-page name="upload_server_transaction_details" url="/upload_kit/uploads/server_trans_upload_details.jsp"/>
    <web:define-xsl name="upload_server_transaction_details" url="/upload_kit/uploads/xsl/serverUploadDetails.xsl"/>
    <web:define-page name="upload_server_transaction_details_help" url="/core/help/upload_trans_file.html"/>

    <!-- Server Upload Result -->
  	<web:define-page name="server_upload_file_result" url="/upload_kit/uploads/server_upload_file_result.jsp"/>
    <web:define-xsl name="server_upload_file_result" url="/upload_kit/uploads/xsl/uploadResult.xsl"/>
    <web:define-page name="server_upload_file_result_help" url="/core/help/upload_file.html"/>

    <!-- Upload Templates -->
  	<web:define-page name="upload_templates" url="/upload_kit/templates/templates.jsp"/>
    <web:define-xsl name="upload_templates" url="/upload_kit/templates/xsl/templates.xsl"/>
    <web:define-page name="upload_templates_help" url="/core/help/upload_file.html"/>

    <!-- Add Upload Templates -->
  	<web:define-page name="add_upload_templates" url="/upload_kit/templates/add_template.jsp"/>
    <web:define-xsl name="add_upload_templates" url="/upload_kit/templates/xsl/addTemplate.xsl"/>
    <web:define-page name="add_upload_templates_help" url="/core/help/upload_file.html"/>

    <!-- Upload Template Details -->
  	<web:define-page name="upload_template_details" url="/upload_kit/templates/template_details.jsp"/>
    <web:define-xsl name="upload_template_details" url="/upload_kit/templates/xsl/templateDetails.xsl"/>
    <web:define-page name="upload_template_details_help" url="/core/help/upload_template_details.html"/>

    <!-- Static Error Correction -->
  	<web:define-page name="static_error_correction" url="/upload_kit/reports/static_error_correction.jsp"/>
    <web:define-xsl name="static_error_correction" url="/upload_kit/reports/xsl/staticErrorCorrection.xsl"/>
    <web:define-page name="static_error_correction_help" url="/core/help/upload_error.html"/>

    <!-- Static Correction Report -->
  	<web:define-page name="static_correction_report" url="/upload_kit/reports/static_correction_report.jsp"/>
    <web:define-xsl name="static_correction_report" url="/upload_kit/uploads/xsl/uploadResult.xsl"/>
    <web:define-page name="static_correction_report_help" url="/core/help/upload_error.html"/>

  	<!-- Correction Report -->
  	<web:define-page name="correction_page" url="/upload_kit/uploads/uploadcorrection/upload_correction.jsp"/>
  </x2:command>

  <!-- ********************************************************************************************
  ******************************************************************************************** -->

</x2:commands>
