<?xml version="1.0" encoding="UTF-8"?>
<x2:commands 
	xmlns:x2="http://www.i2.com/x2" 
	xmlns:core="http://www.i2.com/core" 
	xmlns:xcore="http://www.i2.com/xcore" 
	xmlns:xcore-db="http://www.i2.com/xcore-db" 
	xmlns:xapl="http://www.i2.com/xapl" 
	xmlns:web="http://www.i2.com/web" 
	xmlns:docutil="http://www.i2.com/docutil" 
	xmlns:util="http://www.i2.com/util" 
	xmlns:FUNCTION="http://www.i2.com/FUNCTION" 
	xmlns:REMOVE="http://www.i2.com/REMOVE" 
	xmlns:xudl="http://www.i2.com/xudl" 
	xmlns:cfg="http://www.i2.com/configurability" 
	xmlns:perm="http://www.i2.com/permissibility" 
	xmlns:omx="http://www.i2.com/omx" 
	xmlns:i18n="http://www.i2.com/i18n" 
	description="_">

  <!--************************************************************************-->
  <x2:command name="uploadCorrectedData" public="yes" description="_" >
    <xapl:variable name="valueWithEndingComma">
      <xapl:for-each varName="newValue" select="{$this/NEW_VALUE}">
 		    <xapl:value-of select="concat($valueWithEndingComma, '&quot;', $newValue/@Value, '&quot;,')"/>
      </xapl:for-each>
    </xapl:variable>
     
    <xapl:variable name="correctedValues">   
      <xapl:value-of select="substring($valueWithEndingComma, 1, string-length($valueWithEndingComma)-1)" />
    </xapl:variable>
	 
    <xapl:variable name="correctedRequest">
      <BATCH_REQUEST Template="{$this/TEMPLATE_NAME/@Value}" Index="{$this/INDEX/@Value}">
        <xapl:value-of select="$valueWithEndingComma" />
      </BATCH_REQUEST>
    </xapl:variable>
	 	
    <xapl:variable name="correctedResponse">
      <xcore:execute-method name="//DataUploadService/uploadBatchRequestsMem" ReportId="{$this/REPORT_ID/@Value}">
        <xapl:value-of select="$correctedRequest"/>
      </xcore:execute-method>
    </xapl:variable>
	 
    <web:display-page>
	    <web:get-page name="static_correction_report">
	      <REPORT_ID Value="{$this/REPORT_ID/@Value}" />
	    </web:get-page>
    </web:display-page>
  </x2:command> 

</x2:commands>
