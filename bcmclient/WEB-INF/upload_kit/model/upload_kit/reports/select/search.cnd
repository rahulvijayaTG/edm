<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">

  <x2:command public="yes" description="_" name="init">
    <xapl:variable name="permTemplateList" resolver="session" global="true"/>
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getFormConfig">
    <x2:param name="this"/>
    <xapl:return>
      <!-- Search Fields -->
      <FORM MethodName="//DataUploadService/getUploadReports" Name="search_form" Target="appFrame">
        <FIELD Type="Text" DisplayText="Report ID" Name="ID" Value="{$this/ID/@Value}" Visibility="Simple"/>
        <FIELD Type="Select" SelectAll="Yes" DisplayText="Template" Name="TEMPLATE_NAME" Value="{$this/TEMPLATE_NAME/@Value}" DataSourceType="Command" DataSourceName="upload_kit.reports.select.search:getUploadTemplates" Visibility="Simple"/>
        <FIELD Type="Select" SelectAll="Yes" DisplayText="Upload Status" Name="PROGRESS" Value="{$this/PROGRESS/@Value}" DataSourceType="Command" DataSourceName="upload_kit.reports.select.search:getUploadStatusValues" Visibility="Simple"/>
        <FIELD Type="DateRange" DisplayText="Start Date" Name="START_TIME" Value1="{$this/START_TIME_FIRST/@Value}" Value2="{$this/START_TIME_LAST/@Value}" Visibility="Simple"/>
        <!-- Always Put hidden at the end -->
        <FIELD Type="Hidden" Name="UPLOAD_RET_PAGE" Value="{$this/UPLOAD_RET_PAGE/@Value}"/>
        <x2:execute command="upload_kit.reports.select.search:getHiddenFields">
          <x2:with-param name="this" select="$this"/>
        </x2:execute>
        <!-- Form Buttons -->
        <BUTTONS>
          <BUTTON Id="search_button" Name="search" DisplayText="Search" OnClick="javascript:onSearch()" Emphasized="yes"/>
        </BUTTONS>
      </FORM>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportConfig">
    <x2:param name="this"/>
    <xapl:variable name="helpUrl">
      <web:get-page name="upload_select_reports_help"/>
    </xapl:variable>
    <xapl:return>
      <REPORT Selectable="Single" Scrollable="yes" Id="ID">
        <HELP Url="{$helpUrl}"/>
        <FIELDS>
          <FIELD Name="ID" DisplayText="Report Id" Url="{concat($pages:upload_report_details, $this/UPLOAD_RET_PAGE/@Value)}" UrlParamName="REPORT_ID"/>
          <FIELD Name="TEMPLATE_NAME" DisplayText="Template Name" UrlParam="All"/>
          <FIELD Name="START_TIME" DisplayText="Report Time" DisplayType="Date" Format="datetime"/>
          <FIELD Name="PROGRESS" DisplayText="Progress"/>
          <FIELD DisplayType="Hidden" Type="None" Name="PROGRESS"/>
          <FIELD Name="TOTAL_RECORDS" DisplayText="Total Records" DisplayType="text"/>
          <FIELD Name="TOTAL_ERROR_RECORDS" DisplayText="Errors" DisplayType="text"/>
          <FIELD Name="TOTAL_PURGED_ERROR_RECORDS" DisplayText="Purged" DisplayType="text"/>
          <!-- Hidden Fields -->
          <x2:execute command="core.report.view:getHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
          <x2:execute command="upload_kit.reports.select.search:getHiddenFields_export"/>
        </FIELDS>
        <BUTTONS>
          <BUTTON Name="PurgeReport" DisplayText="Purge" Emphasized="no" Id="purgeButton" DisableOnClick="true" OnClick="javascript:purgeReports();" Disabled="report"/>
          <BUTTON Name="ReprocessReport" DisplayText="Reprocess" Emphasized="yes" Id="reprocessButton" DisableOnClick="true" OnClick="javascript:reprocessReports();" Disabled="report"/>
        </BUTTONS>
        <PAGINATION/>
      </REPORT>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportData">
    <x2:param name="pForm"/>
    <x2:param name="this"/>
    <xapl:print select="$this"/>
    <xapl:variable name="filters">
      <FILTERS>
        <xapl:if test="{string-length($this/ID/@Value) != 0}">
          <FILTER Name="ID">
            <xcore:search-by property="ID" value="{$this/ID/@Value}"/>
          </FILTER>
        </xapl:if>
        <FILTER Name="TEMPLATE_NAME">
          <OR>
            <!-- Get Records with null -->
            <TEMPLATE_NAME/>
            <xapl:choose>
              <xapl:when test="{string-length($this/TEMPLATE_NAME/@Value) != 0}">
                <xcore:search-by property="TEMPLATE_NAME" value="{$this/TEMPLATE_NAME/@Value}"/>
              </xapl:when>
              <xapl:otherwise>
                <xapl:for-each varName="txnType" select="$permTemplateList/TXN_TYPE">
                  <TEMPLATE_NAME Value="{$txnType/VALUE_ID/@Value}"/>
                </xapl:for-each>
              </xapl:otherwise>
            </xapl:choose>
          </OR>
        </FILTER>
        <xapl:variable name="toDate">
          <xapl:if test="{string-length($this/START_TIME_LAST/@Value) > 0}">
            <xapl:value-of select="concat($this/START_TIME_LAST/@Value,' 23:59:59')"/>
          </xapl:if>
        </xapl:variable>
        <xapl:if test="{(string-length($this/START_TIME_FIRST/@Value) != 0) or (string-length($this/START_TIME_LAST/@Value) != 0)}">
          <FILTER Name="START_TIME">
            <xcore:search-by property="START_TIME" value="{$this/START_TIME_FIRST/@Value}" matchby="GREATER"/>
            <xcore:search-by property="START_TIME" value="{$toDate}" matchby="LESS"/>
          </FILTER>
        </xapl:if>
        <xapl:if test="{string-length($this/PROGRESS/@Value) != 0}">
          <FILTER Name="PROGRESS">
            <xcore:search-by property="PROGRESS" value="{$this/PROGRESS/@Value}"/>
          </FILTER>
        </xapl:if>
        <ORDER_BY>
          <docutil:element name="{$pForm/FIELD[@Name = 'SORT_BY']/@Value}" Sort="{$pForm/FIELD[@Name = 'SORT_ORDER']/@Value}"/>
        </ORDER_BY>
      </FILTERS>
    </xapl:variable>
    <xapl:variable name="data">
      <xcore:execute-method name="{$pForm/@MethodName}" StartAtRow="{$pForm/FIELD[@Name = 'START_COUNT']/@Value}" MaxRows="{$pForm/FIELD[@Name = 'MAX_ROWS']/@Value}" ReturnRowCount="{$this/RETURN_ROW_COUNT/@Value}">
        <xapl:value-of select="$filters/*"/>
      </xcore:execute-method>
    </xapl:variable>

    <!-- Add the total record count  -->
    <xapl:return>
      <xapl:value-of select="{$data}"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getUploadTemplates">
    <xapl:if test="{count($permTemplateList/*) = 0}">
      <!-- retrieve all the templates from the database -->
      <xapl:variable name="templateList">
        <HOME>
          <!-- Opportunity for optimization as this method is called mutiple times.
                This method being used here returns all the templates in the database.
                Ideally, the method that returns a restricted number of templates is
          desirable. -->
          <xcore:execute-method name="//DataUploadService/getAllTemplates"/>
        </HOME>
      </xapl:variable>
      <!-- retrieve the names of each template -->
      <xapl:set-variable name="permTemplateList">
        <TXN_TYPES/>
      </xapl:set-variable>
      <xapl:for-each varName="aTemplate" select="$templateList/TEMPLATE_TYPE/TEMPLATE">
        <xapl:variable name="templateName">
          <perm:is-allowed document="UPLOAD_KIT" action="{$aTemplate/@UserData}">
            <TXN_TYPE>
              <VALUE_ID Value="{$aTemplate/@Name}"/>
              <DESCRIPTION Value="{$aTemplate/@DisplayName}"/>
            </TXN_TYPE>
          </perm:is-allowed>
        </xapl:variable>
      <xapl:print select="$templateName"/>
        <docutil:add select="$permTemplateList">
          <xapl:value-of select="$templateName"/>
        </docutil:add>
      </xapl:for-each>
    </xapl:if>
    <xapl:return>
      <xapl:value-of select="$permTemplateList"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
         *********************************************************************** -->
  <x2:command public="yes" description="_" name="getUploadStatusValues">
    <xapl:return>
      <UPLOAD_STATUS_LIST>
        <UPLOAD_STATUS ExistingDocument="yes">
          <VALUE_ID Value="Aborted"/>
          <DESCRIPTION Value="Aborted"/>
        </UPLOAD_STATUS>
        <UPLOAD_STATUS ExistingDocument="yes">
          <VALUE_ID Value="Completed"/>
          <DESCRIPTION Value="Completed"/>
        </UPLOAD_STATUS>
        <UPLOAD_STATUS ExistingDocument="yes">
          <VALUE_ID Value="Completed with gaps"/>
          <DESCRIPTION Value="Completed with gaps"/>
        </UPLOAD_STATUS>
        <UPLOAD_STATUS ExistingDocument="yes">
          <VALUE_ID Value="Initialized"/>
          <DESCRIPTION Value="Initialized"/>
        </UPLOAD_STATUS>
        <UPLOAD_STATUS ExistingDocument="yes">
          <VALUE_ID Value="Processing"/>
          <DESCRIPTION Value="Processing"/>
        </UPLOAD_STATUS>
        <UPLOAD_STATUS ExistingDocument="yes">
          <VALUE_ID Value="Processing with gaps"/>
          <DESCRIPTION Value="Processing with gaps"/>
        </UPLOAD_STATUS>
        <UPLOAD_STATUS ExistingDocument="yes">
          <VALUE_ID Value="Waiting for start signal"/>
          <DESCRIPTION Value="Waiting for start signal"/>
        </UPLOAD_STATUS>
        <UPLOAD_STATUS ExistingDocument="yes">
          <VALUE_ID Value="ReserveReportId"/>
          <DESCRIPTION Value="Reserve Report"/>
        </UPLOAD_STATUS>
      </UPLOAD_STATUS_LIST>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
   *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHiddenFields_export">
    <xapl:return>
      <FIELD Type="Hidden" Name="ID_FILTER_NAME" Value="ID" Visibility="Simple"/>
      <FIELD Type="Hidden" Name="OBJECT_NAME" Value="UPLOAD_PROGRESS_REPORT" Visibility="Simple"/>
      <FIELD Type="Hidden" Name="DATA_SOURCE_NAME" Value="//DataUploadService/getUploadReports" Visibility="Simple"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportData_Ids">
    <x2:param name="pIds"/>
    <x2:param name="pForm"/>
    <x2:param name="this"/>
    <xapl:print select="$permTempateList"/>
    <xapl:variable name="template">
      <OR>
        <xapl:for-each varName="txnType" select="$permTemplateList/TXN_TYPE">
          <TEMPLATE_NAME Value="{$txnType/VALUE_ID/@Value}"/>
        </xapl:for-each>
      </OR>
    </xapl:variable>
    <xapl:variable name="data">
      <xcore:execute-method name="{$pForm/@MethodName}" ReturnRowCount="{$this/RETURN_ROW_COUNT/@Value}">
        <FILTER Name="ID">
          <OR>
            <xapl:value-of select="{$this/ID}"/>
          </OR>
        </FILTER>
        <FILTER Name="TEMPLATE_NAME">
          <xapl:value-of select="$template"/>
        </FILTER>
        <ORDER_BY>
          <docutil:element name="{$pForm/FIELD[@Name = 'SORT_BY']/@Value}" Sort="{$pForm/FIELD[@Name = 'SORT_ORDER']/@Value}"/>
        </ORDER_BY>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:return>
      <xapl:value-of select="{$data}"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHiddenFields">
    <xapl:return>
      <!-- Always Put hidden at the end -->
      <FIELD
             Type="Hidden"
             Name="DIRECTORY"
             Value="{$this/DIRECTORY[position() = 1]/@Value}"
             Visibility="Simple"/>

      <FIELD
             Type="Hidden"
             Name="FILE"
             Value="{$this/FILE[position() = 1]/@Value}"
             Visibility="Simple"/>

      <FIELD
             Type="Hidden"
             Name="DO_SEARCH"
             Value="{$this/DO_SEARCH[position() = 1]/@Value}"
             Visibility="Simple"/>

      <FIELD
             Type="Hidden"
             Name="SEARCH_TYPE"
             Value="{$this/SEARCH_TYPE[position() = 1]/@Value}"
             Visibility="Simple"/>

      <FIELD
             Type="Hidden"
             Name="SORT_BY"
             Value="{$this/SORT_BY[position() = 1]/@Value}"
             Visibility="Simple"/>

      <FIELD
             Type="Hidden"
             Name="SORT_ORDER"
             Value="{$this/SORT_ORDER[position() = 1]/@Value}"
             Visibility="Simple"/>

      <FIELD
             Type="Hidden"
             Name="START_COUNT"
             Value="{$this/START_COUNT[position() = 1]/@Value}"
             Visibility="Simple"/>

      <FIELD
             Type="Hidden"
             Name="MAX_ROWS"
             Value="{$this/MAX_ROWS[position() = 1]/@Value}"
             Visibility="Simple"/>

      <FIELD
             Type="Hidden"
             Name="DOC_TYPE"
             Value="{$this/DOC_TYPE[position() = 1]/@Value}"
             Visibility="Simple"/>

      <FIELD
             Type="Hidden"
             Name="PAGE"
             Value="{$this/PAGE[position() = 1]/@Value}"
             Visibility="Simple"/>

      <FIELD
             Type="Hidden"
             Name="OBJECT_TYPE"
             Value="{$this/OBJECT_TYPE[position() = 1]/@Value}"
             Visibility="Simple"/>

       <FIELD
             Type="Hidden"
             Name="JSCRIPT"
             Value="{$this/JSCRIPT[position() = 1]/@Value}"
             Visibility="Simple"/>

       <FIELD
             Type="Hidden"
             Name="SHOW_HEADER"
             Value="{$this/SHOW_HEADER[position() = 1]/@Value}"
             Visibility="Simple"/>

       <FIELD
             Type="Hidden"
             Name="RET_PAGE"
             Value="{$this/RET_PAGE[position() = 1]/@Value}"
             Visibility="Simple"/>

       <FIELD
              Type="Hidden"
              Name="ORDER_TYPE_ID"
              Value="{$this/ORDER_TYPE_ID[position() = 1]/@Value}"
              Visibility="Simple"/>

    <xapl:variable name="dateFormat"><identity:get-date-format format="common"/></xapl:variable>

    <FIELD
              Type="Hidden"
              Name="DATE_FORMAT"
              Value="{$dateFormat}"
              Visibility="Simple"/>

    </xapl:return>

  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->

</x2:commands>
