<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">    

  <!--******************************************************************************
  ********************************************************************************-->
  <x2:command public="yes" description="_" name="load">
  
    <xapl:variable name="reports">
	    <xcore:execute-method name="//DataUploadService/getConciseReport">
	    </xcore:execute-method>
    </xapl:variable>	
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
           <x2:with-param name="display" select="'Reports'"/>
           <x2:with-param name="page" select="'upload_reports'"/>
           <x2:with-param name="this" select="{$this}"/>
    </x2:execute>
    <xapl:for-each varName="report" select="$reports/REPORT">
      <xapl:variable name="templateDetails">
  	    <xcore:execute-method name="//DataUploadService/getTemplates">
  	      <REPORT_ID Value="{$report/@ReportId}"/>
  	    </xcore:execute-method>
  	  </xapl:variable>
      <docutil:add select="$report">
        <xapl:value-of select="$templateDetails"/>
      </docutil:add>
    </xapl:for-each>
	
    <xapl:return>
      <!-- Header -->
      <!--x2:execute command="upload_kit.reports.reports:getHeader"/-->
      <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
      <!-- Container -->
      <x2:execute command="upload_kit.reports.reports:getContainer">
        <x2:with-param name="pNumReports" select="count($reports/REPORT)"/>
      </x2:execute>

	    <xapl:value-of select="$reports"/>
    </xapl:return>
  </x2:command>

  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">

    <xapl:variable name="origHeader" enforceList="true">
        <x2:execute command="core.page.view:getHeader" />
    </xapl:variable>

    <xapl:return>
	  <HEADER>
        <HEADING Value="Reports"/>
        <xapl:value-of select="$origHeader/*"/>
	  </HEADER>
    </xapl:return>
  </x2:command>
  
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <x2:param name="pNumReports" select="'0'"/>
      
    <xapl:return>
      <!-- Container -->
      <CONTAINER Scrollable="yes">
        <HELP Url="{$pages:upload_reports_help}"/>
        <STEP
             DisplayText="Upload Status" 
             OnClick="{$pages:upload_reports}" 
             Selected="true">
          <BUTTONS>
            <xapl:if test="$pNumReports > 0">
              <BUTTON DisplayText="Delete" Emphasized="yes" OnClick="javascript:deleteReport()"/>
            </xapl:if>
          </BUTTONS>
        </STEP>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  	
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="deleteReport">
    <xapl:for-each varName="reportId" select="{$this/REPORT_ID/@Value}">  
      <xcore:execute-method name="//DataUploadService/deleteReport">
        <REPORT_ID Value="{$reportId}"/>
      </xcore:execute-method>
    </xapl:for-each>
	<web:display-page>
      <web:get-page name="upload_reports">
      </web:get-page>
    </web:display-page>
  </x2:command>
  
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="showReports">
    <web:display-page>
      <web:get-page name="upload_reports">
      	<REPORT_ID Value="{$this/REPORT_ID/@Value}"/>
      </web:get-page>
    </web:display-page>
  </x2:command>	
  
  <!--************************************************************************-->
    <x2:command public="yes" description="_" name="showReportDetails">
      <web:display-page>
        <web:get-page name="upload_report_details">
          <REPORT_ID Value="{$this/REPORT_ID/@Value}"/>
        </web:get-page>
      </web:display-page>
  </x2:command>
  
</x2:commands>
