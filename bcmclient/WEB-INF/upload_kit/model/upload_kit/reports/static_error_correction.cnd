<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">    

  <!--******************************************************************************
  ********************************************************************************-->
  <x2:command public="yes" description="_" name="load">

  	<xapl:return>
      <!-- Header -->
      <x2:execute command="upload_kit.reports.static_error_correction:getHeader">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
      
      <!-- Container -->
	    <x2:execute command="upload_kit.reports.static_error_correction:getContainer"/>

      <x2:execute command="upload_kit.reports.static_error_correction:loadErrorUploadDetails">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
  	</xapl:return>
  </x2:command>

  <!-- *************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    <x2:param name="this"/>
  
    <xapl:variable name="origHeader" enforceList="true">
      <x2:execute command="upload_kit.reports.report_details:getHeader"/>
    </xapl:variable>
	
	  <xapl:variable name="reportId">
	    <xapl:if test="string-length($this/REPORT_ID/@Value)">
	      <xapl:value-of select="$this/REPORT_ID"/>
      </xapl:if>
	  </xapl:variable>
	
	  <xapl:variable name="reportDetailsPage">
      <web:get-page name="upload_report_details">
	      <xapl:value-of select="$reportId"/>
	    </web:get-page>
    </xapl:variable>

    <xapl:return>
	    <HEADER>
	      <HEADING3 Value="Error Details"/>
        <HEADING2_LINK Value="{$reportDetailsPage}"/>	
        <xapl:value-of select="$origHeader/*"/>
	    </HEADER>
    </xapl:return>
	
  </x2:command>
  
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    
    <xapl:return>
      <!-- Container -->
      <CONTAINER Scrollable="yes" Editable="false">
        <HELP Url="{$pages:static_error_correction_help}"/>
        <STEP
             DisplayText="Static Error Detail" 
             Selected="true">
    		  <BUTTONS>
      			<BUTTON
                    Name="Submit"
                    DisplayText="Submit"
                    OnClick="javascript:uploadNewData();"
                    TabIndex="201"
                    Disabled="no"
      			/>
    	    </BUTTONS>          
        </STEP>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="loadErrorUploadDetails">

    <xapl:variable name="reportDetails">
      <REPORT_DETAILS>
 	      <REPORT_ID Value="{$this/REPORT_ID/@Value}"/>
 	      <INDEX Value="{$this/INDEX/@Value}"/>
 	      <TEMPLATE_NAME Value="{$this/TEMPLATE_NAME/@Value}"/>
 	    </REPORT_DETAILS>
    </xapl:variable>
     
    <xapl:return>
      <xapl:value-of select="$errorReport"/>
	    <xapl:value-of select="$reportDetails"/>
    </xapl:return>
  </x2:command>	
  
</x2:commands>
