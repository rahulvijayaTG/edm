<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">  
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="init">
    <xapl:variable name="errorReport" resolver="session" global="true"/>
  </x2:command>
	
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="loadErrorDetails">
  
    <xapl:variable name="templateDetails">
	  <xcore:execute-method name="//DataUploadService/getTemplates">
  	    <REPORT_ID Value="{$this/REPORT_ID/@Value}"/>
  	  </xcore:execute-method>
  	</xapl:variable>
    <xapl:set-variable name="errorReport">
  	  <xcore:execute-method name="//DataUploadService/getReport">
  	    <REPORT_ID Value="{$this/REPORT_ID/@Value}"/>
  		<INDEX Value="{$this/INDEX/@Value}"/>
  	  </xcore:execute-method>
  	</xapl:set-variable>
    
  	<!--
  	<xapl:set-variable name="errorResponse">
  	  <RESPONSES Status="Error" >
  	    <RESPONSE Status="Error" >
  		  <_RESULT Value="SEVERE_ERROR" >
  		    <_ERROR Value="INVALID_FIELD_VALUE" Severity="SEVERE_ERROR" />
  		  </_RESULT>
  	    </RESPONSE>
  	  </RESPONSES>
  	</xapl:set-variable>
  	
  	<xapl:set-variable name="errorRequest">
  	  <REQUESTS ServiceName="EM" Template="CODE_MASTER_TYPE" UploadIndex="0" >
  	    <REQUEST Name="addCodeMasterType" >
  		  <DESCRIPTION Value="This is for testing Code Master Type for Upload/Deployment" />
  		  <IS_EDITABLE Value="false" />
  		  <TYPE_ID Value="TEST_CODE_MASTER_TYPE2" />
  		</REQUEST>
  	  </REQUESTS>
  	</xapl:set-variable>
  	-->
	
  	<xapl:variable name="errorTemplateName">
  	  <xapl:value-of select="substring-after($templateDetails[1]/@TemplateType,'.')"/>
  	</xapl:variable>
  	<xapl:choose>
  	  <xapl:when test="substring-before($templateDetails[1]/@TemplateType,'.')='Static'">
    		<x2:execute command ="upload_kit.reports.errors:loadStaticErrorCorrection">
    		  <x2:with-param name="reportId" select="{$this/REPORT_ID/@Value}"/>
    		  <x2:with-param name="index" select="{$this/INDEX/@Value}"/>
    		  <x2:with-param name="template" select="{$templateDetails[1]/@Name}" />
    		</x2:execute>
  	  </xapl:when>
      <xapl:when test="$errorTemplateName='Order'">
        <xapl:set-variable name="currentOrder">
    			  <xapl:value-of select="{$errorResponse/ERROR_REPORT/ERROR_RESPONSE/RESPONSES/RESPONSE/CUSTOMER_ORDER}"/>
    			</xapl:set-variable>
    			<!--x2:execute command ="omx.order_review.order_review:view">
    		  </x2:execute-->
      </xapl:when>
  	</xapl:choose>	
  </x2:command>
  
   <!--************************************************************************
  <x2:command public="yes" description="_" name="viewStaticErrors">
  </x2:command>
  -->
  
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="loadCommonErrors">
    <xapl:variable name="errorPageData">
      <xapl:choose>
        <xapl:when test="$errorTemplateName='Order'">
		  <!--x2:execute command ="omx.order_review.order_review:view">
		    <x2:with-param name="this" select="$this"/>
		  </x2:execute-->
		</xapl:when>
		<xapl:otherwise>
		  <!--x2:execute command ="omx.order_review.order_review:view">
		    <x2:with-param name="this" select="$this"/>
		  </x2:execute-->
		</xapl:otherwise>
      </xapl:choose>
	</xapl:variable>
	<xapl:return>
	  <xapl:value-of select="$errorPageData"/>
	</xapl:return>
  </x2:command>
  
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="loadStaticErrorCorrection">
    <x2:param name="reportId"/>
	<x2:param name="index"/>
	<x2:param name="template"/>
    <web:display-page>
	  <web:get-page name="static_error_correction">
	    <REPORT_ID Value="{$reportId}"/>
		<INDEX Value="{$index}"/>
		<TEMPLATE_NAME Value="{$template}"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="downloadErrorRecord">
     <xapl:variable name="data">
	   <DATAUPLOAD>
 	     <xapl:for-each varName="errorIndex" select="{$this/INDEX}">
		   <xapl:variable name="errorRecord">
		     <xcore:execute-method name="//DataUploadService/getReport">
			   <REPORT_ID Value="{$this/REPORT_ID/@Value}" />
			   <INDEX Value="{$errorIndex/@Value}"/>
			 </xcore:execute-method>
		   </xapl:variable>
		   <xapl:value-of select="{$errorRecord/ERROR_REPORT/ERROR_RESPONSE/*}"/>
		 </xapl:for-each>
	   </DATAUPLOAD>
     </xapl:variable>		
	 			
	 <xapl:variable name="fileType">
	   <xapl:choose>
	     <xapl:when test="{$this/DATA_TYPE/@Value='XML'}">
		   <xapl:value-of select="'xml'"/>
		 </xapl:when>
		 <xapl:otherwise>
		   <xapl:value-of select="'text'"/>
		 </xapl:otherwise>
	   </xapl:choose>
	 </xapl:variable>
	 
	 <xapl:variable name="fileName">
	   <xapl:choose>
	     <xapl:when test="{$this/DATA_TYPE/@Value='XML'}">
		   <xapl:value-of select="'upload_data_errors.xml'"/>
		 </xapl:when>
		 <xapl:otherwise>
		   <xapl:value-of select="'upload_data_errors.txt'"/>
		 </xapl:otherwise>
	   </xapl:choose>
	 </xapl:variable>
	 
	 <!-- downloadFile-->
    <x2:execute command="core.common:downloadFile">
      <x2:with-param name="pFileContents" select="$data"/>
      <x2:with-param name="pFileName" select="$fileName"/>
	  <x2:with-param name="pFileType" select="$fileType"/>
    </x2:execute>
  </x2:command>
</x2:commands>
