<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">

  <!--******************************************************************************
  ********************************************************************************-->
  <x2:command public="yes" description="_" name="load">
    <xapl:variable name="criteria"/>
    <xapl:variable name="startAtRow">
      <xapl:choose>
        <xapl:when test="count($this/START_COUNT)>0">
            <xapl:value-of select="$this/START_COUNT/@Value"/>
        </xapl:when>
        <xapl:otherwise>
            <xapl:value-of select="'0'"/>
        </xapl:otherwise>
      </xapl:choose>
    </xapl:variable>
    <xapl:variable name="maxRows">
      <xapl:choose>
          <xapl:when test="count($this/MAX_ROWS)>0">
              <xapl:value-of select="$this/MAX_ROWS/@Value"/>
          </xapl:when>
          <xapl:otherwise>
              <xapl:value-of select="'10'"/>
          </xapl:otherwise>
        </xapl:choose>
    </xapl:variable>
    <xapl:set-variable name="criteria">
      <CRITERIA Value="{concat('ID=', $this/ID/@Value,'&amp;TEMPLATE_NAME=', $this/TEMPLATE_NAME/@Value,'&amp;PROGRESS=', $this/PROGRESS/@Value,'&amp;START_TIME_FIRST=',$this/START_TIME_FIRST/@Value,'&amp;START_TIME_LAST=',$this/START_TIME_LAST/@Value,'&amp;START_COUNT_RPT=',$this/START_COUNT_RPT/@Value,'&amp;MAX_ROWS_RPT=',$this/MAX_ROWS_RPT/@Value)}"/>
    </xapl:set-variable>
    <xapl:set-variable name="criteria">
      <CRITERIA Value="{concat('?DO_SEARCH=yes&amp;',$criteria/@Value)}"/>
    </xapl:set-variable>
    <docutil:add select="$this">
      <xapl:value-of select="$criteria"/>
    </docutil:add>
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
       <x2:with-param name="display" select="'Report Details'"/>
       <x2:with-param name="page" select="'upload_report_details'"/>
       <x2:with-param name="this" select="{$this}"/>
    </x2:execute>
    <xapl:return>
      <!-- Header -->
      <!--x2:execute command="upload_kit.reports.report_details:getHeader">
        <x2:with-param name="this" select="$this"/>
      </x2:execute-->
      <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
      <!-- Container -->
      <x2:execute command="upload_kit.reports.report_details:getContainer">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>

      <!-- Report Details -->
      <xcore:execute-method  name="//DataUploadService/getReport" StartAtRow="{$startAtRow}" MaxRows="{$maxRows}" ReturnRowCount="yes">
        <REPORT_ID Value="{$this/REPORT_ID/@Value}"/>
      </xcore:execute-method>
      <REPORT_ID Value="{$this/REPORT_ID/@Value}"/>
    </xapl:return>
  </x2:command>

  <!-- *************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    <x2:param name="this"/>

    <xapl:return>
      <x2:execute command="core.history:register">
        <x2:with-param name="this" select="$this"/>
        <x2:with-param name="pPage" select="'upload_report_details'"/>
        <x2:with-param name="pPageName" select="'Report Details'"/>
      </x2:execute>
    </xapl:return>
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <x2:param name="this"/>

    <xapl:return>
      <!-- Container -->
      <CONTAINER Scrollable="yes" Editable="false">
        <HELP Url="{$pages:upload_report_details_help}"/>
        <STEP
             DisplayText="Upload Status"
             OnClick="{$pages:upload_report_details}"
             Selected="true">
          <BUTTONS>
            <xapl:choose>
              <xapl:when test="count($this/GO_BACK)>0">
                <BUTTON DisplayText="Back" Emphasized="yes" OnClick="javascript:history.back()"/>
              </xapl:when>
              <xapl:otherwise>
                <BUTTON DisplayText="Back" Emphasized="yes" OnClick="{concat($pages:upload_reports_back, $this/CRITERIA/@Value)}"/>
              </xapl:otherwise>
            </xapl:choose>
          </BUTTONS>
        </STEP>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
</x2:commands>
