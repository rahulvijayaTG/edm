<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2"
             xmlns:xcore="http://www.i2.com/xcore"
             xmlns:xcore-db="http://www.i2.com/xcore-db"
             xmlns:xapl="http://www.i2.com/xapl"
             xmlns:web="http://www.i2.com/web"
             xmlns:util="http://www.i2.com/util"
             xmlns:i18n="http://www.i2.com/i18n" description="_">


  <x2:command name="init" public="yes" description="load x2 parameters">

    <!-- system properties for UI configurability engine -->
    <util:set-system-property name="com.i2.x2.util.configurability.render-studio-xsl" value="core/controls/layout.xsl"/>
    <util:set-system-property name="com.i2.x2.util.configurability.doSearch" value="false"/>
    <util:set-system-property name="com.i2.x2.util.configurability.searchType" value="Simple"/>
    <util:set-system-property name="com.i2.x2.util.configurability.updateSearchButton" value="false"/>
    <util:set-system-property name="com.i2.x2.util.configurability.savedSearchHiddenFields" value="false"/>
    <util:set-system-property name="com.i2.x2.util.configurability.sortOrder" value="Descending"/>
    <util:set-system-property name="com.i2.x2.util.configurability.sortBy" value="ID"/>
    <util:set-system-property name="com.i2.x2.util.configurability.startAtRow" value="0"/>
    <util:set-system-property name="com.i2.x2.util.configurability.maxRows" value="10"/>
    <util:set-system-property name="com.i2.x2.util.configurability.returnRowCount" value="yes"/>
    <util:set-system-property name="com.i2.x2.util.configurability.uploadPath" value="/"/>
    <util:set-system-property name="com.i2.x2.util.configurability.uploadPathType" value="relative"/>
    <util:set-system-property name="com.i2.x2.util.configurability.maximumUploadSize" value="10"/>
    <util:set-system-property name="com.i2.x2.util.configurability.exportable" value="false"/>
    <util:set-system-property name="com.i2.x2.util.configurability.maxRowsExportable" value="1000"/>
    <util:set-system-property name="com.i2.x2.util.configurability.javascript" value="false"/>
    <util:set-system-property name="com.i2.xservice.ui.service-name" value="UI"/>

    <!-- application variables for cnd files :: need to make the system param specified above
    to be available part of other services and cnd files -->
    <xapl:variable name="maxRows" resolver="application" global="true">10</xapl:variable>
    <xapl:variable name="maxRowsExportable" resolver="application" global="true">1000</xapl:variable>

    <!-- Specify the date, datetime and time format if you want to override the default behaviour -->
    <!-- some date format examples : ddMMMyyyy, M/d/yyyy, MM/dd/yyyy -->
    <!--util:set-system-property name="DEFAULT_INCOMING_DATE_FORMAT" value="ddMMMyyyy"/>
    <util:set-system-property name="DEFAULT_INCOMING_DATE_TIME_FORMAT" value="ddMMMyyyy HH:mm:ss"/>
    <util:set-system-property name="DEFAULT_INCOMING_TIME_FORMAT" value="HH:mm:ss"/-->

  </x2:command>

</x2:commands>
