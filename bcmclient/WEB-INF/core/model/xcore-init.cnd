<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2"
xmlns:xcore="http://www.i2.com/xcore"
xmlns:xcore-db="http://www.i2.com/xcore-db"
xmlns:xapl="http://www.i2.com/xapl"
xmlns:web="http://www.i2.com/web"
xmlns:util="http://www.i2.com/util"
xmlns:i18n="http://www.i2.com/i18n" description="_">

	<x2:command name="init" public="yes" description="load x2 parameters">
		<xapl:print>Loading x2 init params...</xapl:print>

		<x2:execute command="xcore-init:initIdentity"/>
		<x2:execute command="xcore-init:initXcore"/>
        
		<xapl:print>... done loading x2 init params.</xapl:print>
	</x2:command>

	<x2:command name="initIdentity" public="no" description="Initialize Identity properties.">
		<util:set-system-property name="com.i2.x2.util.identity" value="com.i2.x2.util.omx.OmxIdentity"/>
		<util:set-system-property name="com.i2.x2.i18n.locale.source" value="com.i2.x2.util.i18n.IdentityLocaleSource"/>
		<util:set-system-property name="com.i2.x2.util.xcore.formatter" value="com.i2.x2.util.omx.OmxRequestFormatter"/>
	</x2:command>

	<x2:command name="initXcore" public="no" description="Initialize Locator properties.">
			<xcore:initialize xmlns:util="http://www.i2.com/util" name="xcore"/>
	</x2:command>
 
</x2:commands>


