<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:identity="http://www.i2.com/identity" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" description="_">  

  <x2:command name="init" public="yes" description="_">
    <web:define-page name="core_nav_pgl" url="/navigation.x2ps"/>
    
    <!-- For use with x2 only -->
    <!-- <web:define-page name="core_nav_pgl" url="/core/navigation/navigation.x2p"/> -->
  </x2:command>


  <!-- ********************************************************************** 
       *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
    <x2:param name="selectedActivity" select="$this/ACTIVITY/@Value"/>
    <x2:param name="contentUrl" select="$this/CONTENT_URL/@Value"/>

    <xapl:set-variable name="sSelectedActivity"><xapl:value-of select="$selectedActivity"/></xapl:set-variable>

    <xapl:variable name="user">
      <i18n:text>User</i18n:text>
    </xapl:variable>  
    <xapl:variable name="userName">
      <xapl:value-of select="concat($user,': ',identity-username())"/>
    </xapl:variable>

    <xapl:variable name="nav_url">
      <web:get-page name="core_nav_pgl">
        <ACTIVITY Value="{$selectedActivity}"/>
        <CONTENT_URL Value="{$contentUrl}"/>
      </web:get-page>
    </xapl:variable>
    
    <!-- get system properties :: should this be called everytime the shell is rendered? -->
    <xapl:variable name="abppSysProps">
      <xcore:execute-method name="//BPE_UIService/getSystemProperties"/>
    </xapl:variable>

    <xapl:if test="string-length($abppSysProps/MAX_ROWS/@Value) &gt; 0">
      <util:set-system-property name="com.i2.x2.util.configurability.maxRows" value="{$abppSysProps/MAX_ROWS/@Value}"/>
    </xapl:if>
    <xapl:if test="string-length($abppSysProps/MAX_ROWS_EXPORTABLE/@Value) &gt; 0">
      <util:set-system-property name="com.i2.x2.util.configurability.maxRowsExportable" value="{$abppSysProps/MAX_ROWS_EXPORTABLE/@Value}"/>
    </xapl:if>
    <xapl:if test="string-length($abppSysProps/UPLOAD_PATH/@Value) &gt; 0">
      <util:set-system-property name="com.i2.x2.util.configurability.uploadPath" value="{$abppSysProps/UPLOAD_PATH/@Value}"/>
    </xapl:if>
    
    <xapl:return>
      <SHELL Logo="../i2/images/masthead_fivetwo.gif"
             Background ="../i2/images/i2shellbackground.gif"
             Framed="true"    
             nav-url="{$nav_url}"
             UserName="{$userName}"
             ForcedLogout="true">
        <LOGOUT_ACTION Value="{$pages:core_logout}"/>
        <HELP_ACTION Value="{$pages:core_shell_help}"/>
        <ABOUT_ACTION Value="{$pages:core_shell_about}"/>
      </SHELL>  
    </xapl:return>
    
  </x2:command>
<!-- ********************************************************************** 
     *********************************************************************** -->  
</x2:commands>
