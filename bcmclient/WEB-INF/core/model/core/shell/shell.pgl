<?xml version="1.0" encoding="UTF-8"?>
<ui:page-group xmlns:ui="http://www.i2.com/ui" displayText="Navigation" source="core.shell.view:load" type="Shell" title="i2 Technologies">
  <ui:shell logo="../../i2/images/masthead_fivetwo.gif"
    background="../../i2/images/i2shellbackground.gif"
    user-name="{SHELL/@UserName}"
    forced-logout="true"
    logout-action="{SHELL/LOGOUT_ACTION/@Value}"
    help-action="{SHELL/HELP_ACTION/@Value}"
    about-action="{SHELL/ABOUT_ACTION/@Value}"
    nav-url="{SHELL/@nav-url}"
    app-url="{SHELL/@app-url}"
    framed="true"/>
</ui:page-group>