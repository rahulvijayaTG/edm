<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:report="http://www.i2.com/report" xmlns:ui="http://www.i2.com/ui"  xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n"  xmlns:identity="http://www.i2.com/identity"  description="_">

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="init">
     <web:define-page name="core_configure_table" url="/core/configure.jsp"/>
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
    <x2:param name="tableId" select="$this/TABLE_ID/@Value"></x2:param>
    <x2:param name="pageId" select="$this/PAGE_ID/@Value"></x2:param>
    <x2:param name="sysId" select="$this/SYS_ID/@Value"></x2:param>

    <xapl:variable name="table">
     <cfg:get-cfg-fields name="{$pageId}" id="{$tableId}" sys-id="{$sysId}"/>
    </xapl:variable>

    <!-- Remove already configured fields from avaliable list-->
    <xapl:for-each select="$table/CFG/FIELDS/FIELD" varName="configuredField">
      <xapl:variable name="configuredFieldName">
        <xapl:value-of select="$configuredField/@name"/>
      </xapl:variable>
      <docutil:remove select="$table/MASTER/FIELDS/FIELD[@name = $configuredFieldName]"/>
    </xapl:for-each>

    <xapl:return>
     <xapl:value-of select="$table"/>
     <TABLE_ID Value="{$tableId}"/>
     <PAGE_ID Value="{$pageId}"/>
     <xapl:value-of select="$this/SYSTEM_LEVEL"/>
    </xapl:return>
  </x2:command>

<!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="apply">
    
    <xcore:execute-method name="//BPE_UIService/addConfiguredTable" entireResponse="true">
      <xapl:if test="$this/SYSTEM_LEVEL/@Value='TRUE'">
        <USER_ID Value="SYSTEM"/>
      </xapl:if>
      <xapl:choose>
        <!-- For studio ui -->
        <xapl:when test="string-length($this/SYS_ID/@Value) &gt; 0">
          <TABLE_ID Value="{concat($this/PAGE_ID/@Value,'.',$this/TABLE_ID/@Value)}"/>
        </xapl:when>
        <xapl:otherwise>
          <TABLE_ID Value="{concat($this/PAGE_ID/@Value,'.',$this/TABLE_ID/@Value)}"/>
        </xapl:otherwise>
      </xapl:choose>

      <xapl:for-each select = "$this/tolistbox/@Value" varName="field">
      <FIELD_ID Value="{$field}"/>
      </xapl:for-each>
    </xcore:execute-method>

    <web:display-page>
      <web:get-page name="core_close_and_refresh"/>
    </web:display-page>

  </x2:command>

  <!-- **********************************************************************
    *********************************************************************** -->
    <x2:command public="yes" description="_" name="loadOld">
      <x2:param name="tableId" select="$this/TABLE_ID/@Value"></x2:param>

      <xapl:variable name="masterTable">
        <x2:execute command="{$tableId}">
        </x2:execute>
      </xapl:variable>

       <xapl:variable name="configuredTable">
         <TABLE>
           <xcore:execute-method name="//BPE_UIService/getConfiguredTable">
             <TABLE_ID  Value="{$tableId}"/>
           </xcore:execute-method>
         </TABLE>
        </xapl:variable>

      <xapl:for-each select="$configuredTable/FIELDS/FIELD" varName="configuredField">
        <xapl:variable name="configuredFieldName">
          <xapl:value-of select="$configuredField/@Value"/>
        </xapl:variable>
        <xapl:variable name="masterField">
          <xapl:value-of select="$masterTable/FIELDS/FIELD[@Name = $configuredFieldName]"/>
        </xapl:variable>
         <docutil:set select="$configuredField/@DisplayText">
           <xapl:value-of select="$masterField/@DisplayText"/>
         </docutil:set>
         <docutil:set select="$configuredField/@Name">
           <xapl:value-of select="$masterField/@Name"/>
         </docutil:set>
         <docutil:set select="$configuredField/@Description">
           <xapl:value-of select="$masterField/@Description"/>
         </docutil:set>

        <docutil:remove select="$masterTable/FIELDS/FIELD[@Name = $configuredFieldName]"/>
      </xapl:for-each>

      <!-- If not configured-->
      <xapl:if test="count($configuredTable/FIELDS/FIELD[1]) = 0">
       <xapl:set-variable name="configuredTable">
        <TABLE>
         <FIELDS>
          <xapl:value-of select="$masterTable/FIELDS/FIELD[(not(@Configurable) or @Configurable != 'false') and (not(@Type) or  (@Type != 'Hidden' and @Type !='None'))]"/>
        </FIELDS>
        </TABLE>
       </xapl:set-variable>
       <xapl:set-variable name="masterTable" />
      </xapl:if>

      <xapl:return>
      <TABLE_ID  Value="{$tableId}"/>
        <TO_LIST>
          <xapl:value-of select="$configuredTable/FIELDS"/>
        </TO_LIST>
        <FROM_LIST>
          <FIELDS>
            <xapl:value-of select="$masterTable/FIELDS/FIELD[(not(@Configurable) or @Configurable != 'false') and (not(@Type) or  (@Type != 'Hidden' and @Type !='None'))]"/>
          </FIELDS>
        </FROM_LIST>
      </xapl:return>
    </x2:command>


  <!-- **********************************************************************
     *********************************************************************** -->
</x2:commands>