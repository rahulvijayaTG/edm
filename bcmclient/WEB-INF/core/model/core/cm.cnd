        <xcore:get-document name="//EMService/CODE_MASTER_VALUE">
          <STATUS Value="ACTIVE"/>
          <TYPE_ID Value="NOTE_TYPE"/>
        </xcore:get-document>
      </ORDER_TYPES>
    </xapl:return>
  </x2:command>
