  <!-- TODO Use getStatesForCountry Inside -->
  <x2:command public="yes" description="_" name="getStates">
    <x2:param name="pUserId"/>
    <x2:param name="pRESET"/>
    <xapl:variable name="codeMasterEntry"/>
    <xapl:variable name="currentUser"/>
    <xapl:choose>
      <xapl:when test="(string-length($pUserId) != 0) and ($pRESET = 'true')">
        <xapl:set-variable name="currentUser">
          <xcore:get-document name="//EMService/USER_PROFILE">
            <ID Value="{$pUserId}"/>
            <FETCH_DOCUMENT_LINK Name="CONTACT_INFO_LINK">
              <FETCH_DOCUMENT_LINK Name="ADDRESS_LINK"/>
            </FETCH_DOCUMENT_LINK>
          </xcore:get-document>
        </xapl:set-variable>
        <xapl:set-variable name="currentCountry">
          <xapl:value-of select="$currentUser/CONTACT_INFO_LINK/CONTACT/ADDRESS_LINK/ADDRESS/COUNTRY/@Value"/>
        </xapl:set-variable>
      </xapl:when>
      <xapl:otherwise>
        <xapl:if test="{string-length($currentCountry) = 0}">
          <xapl:set-variable name="currentCountry">USA</xapl:set-variable>
        </xapl:if>
      </xapl:otherwise>
    </xapl:choose>
    <xapl:set-variable name="codeMasterEntry">
      <xcore:get-document name="//EMService/CODE_MASTER_VALUE">
        <STATUS Value="ACTIVE"/>
        <TYPE_ID Value="COUNTRY"/>
        <VALUE_ID Value="{$currentCountry}"/>
        <ORDER_BY>
          <VALUE_ID Sort="Ascending"/>
        </ORDER_BY>
      </xcore:get-document>
    </xapl:set-variable>
    <xapl:variable name="states">
      <STATES Type="State">
        <xcore:execute-method name="//EMService/getCodeMasterValue">
          <PARENT_ID Value="{$codeMasterEntry/ID/@Value}"/>
        </xcore:execute-method>
      </STATES>
    </xapl:variable>
    <!-- add in the i18n text for the states so they can be sorted correctly -->
    <xapl:for-each select="$states/CODE_MASTER_VALUE" varName="state">
      <docutil:add select="$state">
        <xapl:variable name="text">
          <i18n:text>
            <xapl:value-of select="$state/DESCRIPTION/@Value"/>
          </i18n:text>
        </xapl:variable>
        <DISPLAY_TEXT Value="{$text}"/>
      </docutil:add>
    </xapl:for-each>
    <xapl:return>
      <xapl:value-of select="$states"/>
    </xapl:return>
  </x2:command>
  
<!-- ********************************************************************** 
     *********************************************************************** -->  
  <x2:command public="yes" description="_" name="getStatesForCountry">
    <x2:param name="pCountry" select="'USA'"/>
    <x2:param name="pCountryId"/>
  
    <xapl:variable name="countryId" select="$pCountryId"/>
    
    <xapl:if test="string-length($pCountryId) = 0">
      <xapl:variable name="country">
        <xcore:get-document name="//EMService/CODE_MASTER_VALUE">
          <STATUS Value="ACTIVE"/>
          <TYPE_ID Value="COUNTRY"/>
          <VALUE_ID Value="{$pCountry}"/>
        </xcore:get-document>
      </xapl:variable>
       <xapl:set-variable name="countryId" select="$country/ID/@Value"/>
     </xapl:if>
  
    <xapl:if test="string-length($sessionCMVStates/CODE_MASTER_VALUE[1]/ID/@Value) = 0 or $countryId != $sessionCMVStates/CODE_MASTER_VALUE/PARENT_ID/@Value">
        
      <xapl:set-variable name="sessionCMVStates">
        <STATES Type="State">
          <xcore:execute-method name="//EMService/getCodeMasterValue">
            <PARENT_ID Value="{$countryId}"/>
          </xcore:execute-method>
        </STATES>
      </xapl:set-variable>
      
      <!-- add in the i18n text for the states so they can be sorted correctly -->
      <xapl:for-each select="$sessionCMVStates/CODE_MASTER_VALUE" varName="state">
        <docutil:add select="$state">
          <xapl:variable name="text">
            <i18n:text>
              <xapl:value-of select="$state/DESCRIPTION/@Value"/>
            </i18n:text>
          </xapl:variable>
          <DISPLAY_TEXT Value="{$text}"/>
        </docutil:add>
      </xapl:for-each>
    </xapl:if>
        
    <xapl:return>
      <xapl:value-of select="$sessionCMVStates"/>
    </xapl:return>

  </x2:command>


  <!-- ********************************************************************** 
       *********************************************************************** -->
  <x2:command public="yes" description="_" name="getTaxCodes">

    <xapl:if test="count($appCMVTaxCodes/*) = 0">
      <xapl:set-variable name="appCMVTaxCodes">
      <TAX_CODES>
        <xcore:get-document name="//EMService/CODE_MASTER_VALUE">
          <STATUS Value="ACTIVE"/>
          <TYPE_ID Value="TAX_CODE"/>
        </xcore:get-document>
      </TAX_CODES>
      </xapl:set-variable>
    </xapl:if>
    <xapl:return>
      <xapl:value-of select="$appCMVTaxCodes"/>
    </xapl:return>
  </x2:command>

<!-- ********************************************************************** 
     *********************************************************************** -->  
