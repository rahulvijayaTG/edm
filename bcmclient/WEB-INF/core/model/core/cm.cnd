          <VALUE_ID Value="CUSTOMER"/>
          <DESCRIPTION Value="CUSTOMER"/>
        </ORG_TYPE>
        <ORG_TYPE ExistingDocument="yes">
          <TYPE_ID Value="ORG_TYPE"/>
          <VALUE_ID Value="SELLER"/>
          <DESCRIPTION Value="SELLER"/>
        </ORG_TYPE>
        <ORG_TYPE ExistingDocument="yes">
          <TYPE_ID Value="ORG_TYPE"/>
          <VALUE_ID Value="BOTH"/>
          <DESCRIPTION Value="SELLER/CUSTOMER"/>
        </ORG_TYPE>
      </ORG_TYPES>
    </xapl:return>
  </x2:command>
