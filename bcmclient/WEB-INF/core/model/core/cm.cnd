  <x2:command public="yes" description="_" name="getLocales">
    <xapl:if test="count($appCMVLocales/*) = 0">
      <xapl:set-variable name="appCMVLocales">
      <LOCALES>
        <xcore:get-document name="//EMService/CODE_MASTER_VALUE">
          <STATUS Value="ACTIVE"/>
          <TYPE_ID Value="LOCALE"/>
          <ORDER_BY>
            <DESCRIPTION Sort="Ascending"/>
          </ORDER_BY>
        </xcore:get-document>
      </LOCALES>
      </xapl:set-variable>
    </xapl:if>  

    <!-- Set default locale for this user -->
    <xapl:if test="{count($currentLocale) = 0}">
      <xapl:variable name="currentLocale" resolver="session">
        <xapl:value-of select="{$identity/LOCALE/@Value}"/>
      </xapl:variable>
    </xapl:if>
    
    
    <xapl:return>
      <LOCALES>
        <LOCALE_DEFAULT Value="{$currentLocale/@Value}"/>
        <xapl:value-of select="$appCMVLocales/*"/>
      </LOCALES>
    </xapl:return>

    
  </x2:command>
  
