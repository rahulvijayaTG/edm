<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:tree="http://www.i2.com/tree" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">

 <!-- ******************************************* -->
  <!-- This file contains Code Master get commands -->
  <!-- ******************************************* -->
  <!-- Static variables -->
  <x2:command public="yes" description="_" name="init">
    <x2:execute command="core.cm:defineCodeMasterValues"/>    
  </x2:command>

  <!-- **************************************************************************
  ********************************************************************************* -->  
  <x2:command public="yes" description="_" name="defineCodeMasterValues">

    <!-- Order --> 
    <xapl:variable name="appCMVOrderTypes" resolver="application" global="true"/>
    
    <!-- Codes -->
    <xapl:variable name="appCMVCurrencyCodes" resolver="application" global="true"/>
    <xapl:variable name="appCMVChangeReasonCodes" resolver="application" global="true"/>
    <xapl:variable name="appCMVCancelReasonCodes" resolver="application" global="true"/>

    <!-- Requests -->
    <xapl:variable name="appCMVShipTerms" resolver="application" global="true"/>
    <xapl:variable name="appCMVShipVias" resolver="application" global="true"/>
    <xapl:variable name="appCMVShipModes" resolver="application" global="true"/>

    <!-- User Admin -->
    <xapl:variable name="appCMVCountries" resolver="application" global="true"/>
    <xapl:variable name="appCMVDesignations" resolver="application" global="true"/>
    <xapl:variable name="appCMVLocales" resolver="application" global="true"/>
    <xapl:variable name="sessionCMVStates" resolver="session" global="true"/>
    
    <!-- Bill to  -->
    <xapl:variable name="appCMVCustomerTypes" resolver="application" global="true"/>
    <xapl:variable name="appCMVCreditTypes" resolver="application" global="true"/>
    <xapl:variable name="appCMVCreditRatings" resolver="application" global="true"/>
    <xapl:variable name="appCMVPresentmentMethods" resolver="application" global="true"/>
    <xapl:variable name="appCMVPresentmentFrequencies" resolver="application" global="true"/>
    <xapl:variable name="appCMVInvoiceMethods" resolver="application" global="true"/>
    <xapl:variable name="appCMVInvoiceTriggers" resolver="application" global="true"/>
    <xapl:variable name="appCMVInvoiceFrequencies" resolver="application" global="true"/>
    <xapl:variable name="appCMVInvoiceSpans" resolver="application" global="true"/>

    <!-- Org -->    
    <xapl:variable name="appCMVTaxCodes" resolver="application" global="true"/>
    <xapl:variable name="appCMVPricingTemplates" resolver="application" global="true"/>
    <xapl:variable name="appCMVConversionMethods" resolver="application" global="true"/>

    <!-- Session variable -->
    <xapl:variable name="currentCountry" resolver="session" global="true"/>
    
  </x2:command>
 
  <!-- **************************************************************************
  ********************************************************************************* -->  
  <x2:command public="yes" description="_" name="load">
    <x2:execute command="core.cm:loadCodeMasterValues"/>    
  </x2:command>

  <!-- **************************************************************************
  ********************************************************************************* -->  
  <x2:command public="yes" description="_" name="loadCodeMasterValues">
    <x2:execute command="core.cm:getOrderTypes"/>
    <x2:execute command="core.cm:getCurrencyCodes"/>
    <x2:execute command="core.cm:getChangeReasonCodes"/>
    <x2:execute command="core.cm:getCancelReasonCodes"/>

    <x2:execute command="core.cm:getShipModes"/>
    <x2:execute command="core.cm:getShipTerms"/>
    <x2:execute command="core.cm:getShipVias"/>

    <!-- User Admin -->
    <x2:execute command="core.cm:getCountries"/>
    <x2:execute command="core.cm:getDesignations"/>
    <x2:execute command="core.cm:getLocales"/>

    <!-- Bill To -->
    <x2:execute command="core.cm:getCustomerTypes"/>
    <x2:execute command="core.cm:getCreditTypes"/>
    <x2:execute command="core.cm:getCreditRatings"/>
    <x2:execute command="core.cm:getPresentmentMethods"/>
    <x2:execute command="core.cm:getPresentmentFrequencies"/>
    <x2:execute command="core.cm:getInvoiceMethods"/>
    <x2:execute command="core.cm:getInvoiceTriggers"/>
    <x2:execute command="core.cm:getInvoiceFrequencies"/>
    <x2:execute command="core.cm:getInvoiceSpans"/>
    
    <!-- Org -->
    <x2:execute command="core.cm:getTaxCodes"/>
    <x2:execute command="core.cm:getPricingTemplates"/>
    <x2:execute command="core.cm:getConversionMethods"/>
    
  </x2:command>

  <!-- **************************************************************************
  ********************************************************************************* -->  
  <!-- Call this whenever cached values needs to be refreshed -->
  <x2:command public="yes" description="_" name="refresh">
    <x2:execute command="core.cm:refreshCodeMasterValues"/>    
  </x2:command>

  <!-- **************************************************************************
  ********************************************************************************* -->  
  <x2:command public="yes" description="_" name="refreshCodeMasterValues">
    <!-- Order --> 
    <xapl:set-variable name="appCMVOrderTypes"/>

    <!-- Codes -->
    <xapl:set-variable name="appCMVCurrencyCodes"/>
    <xapl:set-variable name="appCMVChangeReasonCodes"/>
    <xapl:set-variable name="appCMVCancelReasonCodes"/>

    <!-- Requests -->
    <xapl:set-variable name="appCMVShipTerms"/>
    <xapl:set-variable name="appCMVShipVias"/>
    <xapl:set-variable name="appCMVShipModes"/>

    <!-- User Admin -->
    <xapl:set-variable name="appCMVCountries"/>
    <xapl:set-variable name="appCMVDesignations"/>
    <xapl:set-variable name="appCMVLocales"/>

    <!-- Bill To -->
    <xapl:set-variable name="appCMVCustomerTypes"/>
    <xapl:set-variable name="appCMVCreditTypes"/>
    <xapl:set-variable name="appCMVCreditRatings"/>
    <xapl:set-variable name="appCMVPresentmentMethods"/>
    <xapl:set-variable name="appCMVPresentmentFrequencies"/>
    <xapl:set-variable name="appCMVInvoiceMethods"/>
    <xapl:set-variable name="appCMVInvoiceTriggers"/>
    <xapl:set-variable name="appCMVInvoiceFrequencies"/>
    <xapl:set-variable name="appCMVInvoiceSpans"/>
    
    <!-- Org -->
    <xapl:set-variable name="appCMVTaxCodes"/>
    <xapl:set-variable name="appCMVPricingTemplates"/>
    <xapl:set-variable name="appCMVConversionMethods"/>
  </x2:command>

  <!-- **************************************************************************
  ********************************************************************************* -->  
  <x2:command public="yes" description="_" name="refreshCodeMasterValuesByTypes">
    <x2:param name="pCodeMasterType"/>
  
    <xapl:choose>
      <xapl:when test="$pCodeMasterType = 'ORDER_TYPE'">
        <xapl:set-variable name="appCMVOrderTypes"/>
      </xapl:when>
      <xapl:when test="$pCodeMasterType = 'CURRENCY'">
        <xapl:set-variable name="appCMVCurrencyCodes"/>
      </xapl:when>
      <xapl:when test="$pCodeMasterType = 'CHANGE_REASON_CODE'">
        <xapl:set-variable name="appCMVChangeReasonCodes"/>
      </xapl:when>
      <xapl:when test="$pCodeMasterType = 'CANCEL_REASON_CODE'">
        <xapl:set-variable name="appCMVCancelReasonCodes"/>
      </xapl:when>
      <xapl:when test="$pCodeMasterType = 'SHIP_TERMS'">
        <xapl:set-variable name="appCMVShipTerms"/>
      </xapl:when>
      <xapl:when test="$pCodeMasterType = 'SHIP_VIA'">
        <xapl:set-variable name="appCMVShipVias"/>
      </xapl:when>
      <xapl:when test="$pCodeMasterType = 'SHIP_MODE'">
        <xapl:set-variable name="appCMVShipModes"/>
      </xapl:when>
      <xapl:when test="$pCodeMasterType = 'COUNTRY'">
        <xapl:set-variable name="appCMVCountries"/>
      </xapl:when>
      <xapl:when test="$pCodeMasterType = 'DESIGNATION'">
        <xapl:set-variable name="appCMVDesignations"/>
      </xapl:when>
      <xapl:when test="$pCodeMasterType = 'LOCALE'">
        <xapl:set-variable name="appCMVLocales"/>
      </xapl:when>
      <xapl:when test="$pCodeMasterType = 'CUSTOMER_TYPE'">
        <xapl:set-variable name="appCMVCustomerTypes"/>
      </xapl:when>
      <xapl:when test="$pCodeMasterType = 'CREDIT_TYPE'">
        <xapl:set-variable name="appCMVCreditTypes"/>
      </xapl:when>
      <xapl:when test="$pCodeMasterType = 'CREDIT_RATING'">
        <xapl:set-variable name="appCMVCreditRatings"/>
      </xapl:when>
      <xapl:when test="$pCodeMasterType = 'PRESENTMENT_METHOD'">
        <xapl:set-variable name="appCMVPresentmentMethods"/>
      </xapl:when>
      <xapl:when test="$pCodeMasterType = 'PRESENTATION_FREQUENCY'">
        <xapl:set-variable name="appCMVPresentmentFrequencies"/>
      </xapl:when>
      <xapl:when test="$pCodeMasterType = 'INVOICE_METHOD'">
        <xapl:set-variable name="appCMVInvoiceMethods"/>
      </xapl:when>
      <xapl:when test="$pCodeMasterType = 'INVOICE_TRIGGER'">
        <xapl:set-variable name="appCMVInvoiceTriggers"/>
      </xapl:when>
      <xapl:when test="$pCodeMasterType = 'INVOICE_FREQUENCY'">
        <xapl:set-variable name="appCMVInvoiceFrequencies"/>
      </xapl:when>
      <xapl:when test="$pCodeMasterType = 'INVOICE_SPAN'">
        <xapl:set-variable name="appCMVInvoiceSpans"/>
      </xapl:when>
      <xapl:when test="$pCodeMasterType = 'TAX_CODE'">
        <xapl:set-variable name="appCMVTaxCodes"/>
      </xapl:when>
      <xapl:when test="$pCodeMasterType = 'PRICING_TEMPLATE'">
        <xapl:set-variable name="appCMVPricingTemplates"/>
      </xapl:when>
      <xapl:when test="$pCodeMasterType = 'CONVERSION_METHOD'">
        <xapl:set-variable name="appCMVConversionMethods"/>
      </xapl:when>
      <xapl:otherwise>
        <x2:execute command="core.cm:refreshCodeMasterValues"/>
      </xapl:otherwise>
    </xapl:choose>    
  </x2:command>

<!-- **************************************************************************
  ********************************************************************************* -->  
  <x2:command public="yes" description="_" name="getOrderTypes">

    <xapl:if test="count($appCMVOrderTypes/*) = 0">
      <xapl:set-variable name="appCMVOrderTypes">
        <xcore:get-document name="//EMService/CODE_MASTER_VALUE">
          <STATUS Value="ACTIVE"/>
          <TYPE_ID Value="ORDER_TYPE"/>
        </xcore:get-document>
      </xapl:set-variable>
    </xapl:if>

    <xapl:return>
      <ORDER_TYPES>
        <xapl:value-of select="$appCMVOrderTypes"/>
      </ORDER_TYPES>
    </xapl:return>
  </x2:command>

<!-- ********************************************************************** 
     *********************************************************************** -->
