        <CUSTOMER_TYPES>
          <xcore:get-document name="//EMService/CODE_MASTER_VALUE">
            <STATUS Value="ACTIVE"/>
            <TYPE_ID Value="CUSTOMER_TYPE"/>
          </xcore:get-document>
        </CUSTOMER_TYPES>
      </xapl:set-variable>
    </xapl:if>
    <xapl:return>
      <xapl:value-of select="$appCMVCustomerTypes"/>
    </xapl:return>
  </x2:command>
  
  
  <x2:command public="yes" description="_" name="getCreditCardTypes">
    <xapl:return>
      <CREDIT_CARD_TYPES>
