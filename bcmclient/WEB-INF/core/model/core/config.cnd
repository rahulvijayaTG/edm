<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:identity="http://www.i2.com/identity" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" description="_">  

<!-- ********************************************************************** 
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="getChangePasswordPage">
    
    <xapl:return>
      <CHANGE_PWD_INFO>
        <MASTHEAD_IMAGE Value="../i2/images/masthead_fivetwo.gif"/>
        <PANEL_IMAGE Value="../i2/images/login_panel_simple.jpg"/>
        <COMMAND Value="change_password/changePassword.x2c"/>
        <FROM Value="{$this/FROM/@Value}"/>
        <ERROR Value="{$this/ERROR/@Value}"/>
        <DESCRIPTION Value="{$this/DESCRIPTION/@Value}"/>
        <ID Value="{$this/USER_NAME/@Value}"/>
      </CHANGE_PWD_INFO>
    </xapl:return>
    
  </x2:command>
  
<!-- ********************************************************************** 
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="getMiddlePage">
    <x2:param name="selectedActivity" select="$this/ACTIVITY/@Value"/>
    <x2:param name="contentUrl" select="$this/CONTENT_URL/@Value"/>

    <xapl:variable name="navURL">
      <web:get-page name="core_nav">
        <ACTIVITY Value="{$selectedActivity}"/>
      </web:get-page>
    </xapl:variable>

     <xapl:variable name="homeURL">
       <xapl:choose>
         <xapl:when test="string-length($contentUrl) > 0">
          <xapl:value-of select="$contentUrl"/>
         </xapl:when>
         <xapl:otherwise>
           <x2:execute command="core.home.controller:getHomeURL">
             <x2:param name="pActivity" select="$selectedActivity"/>
           </x2:execute>
         </xapl:otherwise>
       </xapl:choose>
      </xapl:variable>


    <xapl:return>
      <MIDDLE_PAGE_INFO>
        <NAV_FRAME Value="show"/> <!-- show | hide -->
        <NAV_PAGE_URL Value="{$navURL}"/>
        <HOME_PAGE_URL Value="{$homeURL}"/>
      </MIDDLE_PAGE_INFO>
    </xapl:return>
    
  </x2:command>
  <!-- ********************************************************************** 
       *********************************************************************** -->
</x2:commands>
