<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" description="_">  
  
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="setDefaults">
    <x2:param name="this" />

    <!-- Give Defaults - Start:-->
    <xapl:choose>
      <xapl:when test="{count($this/START_COUNT) = 0}">
        <docutil:add select="{$this}">
          <START_COUNT Value="0"/>
        </docutil:add>
      </xapl:when>
      <xapl:when test="{string-length($this/START_COUNT/@Value) = 0}">
        <docutil:set select="{$this/START_COUNT}">0</docutil:set>
      </xapl:when>
    </xapl:choose>

    <xapl:choose>
      <xapl:when test="{count($this/MAX_ROWS) = 0}">
        <docutil:add select="{$this}">
          <MAX_ROWS Value="10"/>
        </docutil:add>
      </xapl:when>
      <xapl:when test="{string-length($this/MAX_ROWS/@Value) = 0}">
        <docutil:set select="{$this/MAX_ROWS}">10</docutil:set>
      </xapl:when>
    </xapl:choose>

    <xapl:choose>
      <xapl:when test="{count($this/RETURN_ROW_COUNT) = 0}">
        <docutil:add select="{$this}">
          <RETURN_ROW_COUNT Value="yes"/>
        </docutil:add>
      </xapl:when>
      <xapl:when test="{string-length($this/RETURN_ROW_COUNT/@Value) = 0}">
        <docutil:set select="{$this/RETURN_ROW_COUNT}">yes</docutil:set>
      </xapl:when>
    </xapl:choose>

    <!-- Give Defaults: End-->

</x2:command>  

<!-- ********************************************************************** 
     *********************************************************************** -->
  </x2:commands>