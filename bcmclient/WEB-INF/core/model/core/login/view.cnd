<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:identity="http://www.i2.com/identity" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:cis="http://www.i2.com/cis" description="_">

<!-- **********************************************************************
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
    <xapl:return>
      <xapl:choose>
        <!-- when sso enabled -->
        <xapl:when test="$ssoEnabled = 'true'">
          <x2:execute command="core.login.view:getSSOLoginPage">
            <x2:with-param name="from" select="$this/FROM/@Value"/>
            <x2:with-param name="error" select="$this/ERROR/@Value"/>
            <x2:with-param name="desc" select="$this/DESCRIPTION/@Value"/>
            <x2:with-param name="contentUrl" select="$this/CONTENT_URL/@Value"/>
          </x2:execute>
        </xapl:when>
        <!-- sso not enabled -->
        <xapl:otherwise>
          <x2:execute command="core.login.view:getLoginPage">
            <x2:with-param name="from" select="$this/FROM/@Value"/>
            <x2:with-param name="error" select="$this/ERROR/@Value"/>
            <x2:with-param name="desc" select="$this/DESCRIPTION/@Value"/>
            <x2:with-param name="contentUrl" select="$this/CONTENT_URL/@Value"/>
          </x2:execute>
          <xapl:value-of select="$this/USER_NAME"/>
        </xapl:otherwise>
      </xapl:choose>
    </xapl:return>
  </x2:command>

<!-- **********************************************************************
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="getLoginPage">
    <x2:param name="from" select="$this/FROM/@Value"/>
    <x2:param name="error" select="$this/ERROR/@Value"/>
    <x2:param name="desc" select="$this/DESCRIPTION/@Value"/>
    <x2:param name="contentUrl" select="$this/CONTENT_URL/@Value"/>

    <!-- This command gets called only when the user needs to be logged in.
    This command helps in generating the normal login page. -->
    <xapl:return>
      <LOGIN_PAGE_INFO>
        <MASTHEAD_IMAGE Value="../i2/images/masthead_fivetwo.gif"/>
        <PANEL_IMAGE Value="../i2/images/login_panel_simple.jpg"/>
        <COMMAND Value="../core/login/controller/login.x2c"/>
        <CHANGE_PWD Value="yes"/>
        <CONTENT_URL Value="{$contentUrl}"/>
        <FROM Value="{$from}"/>
        <ERROR Value="{$error}"/>
        <DESCRIPTION Value="{$desc}"/>
      </LOGIN_PAGE_INFO>
    </xapl:return>
  </x2:command>

<!-- **********************************************************************
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="getSSOLoginPage">
    <x2:param name="from" select="$this/FROM/@Value"/>
    <x2:param name="error" select="$this/ERROR/@Value"/>
    <x2:param name="desc" select="$this/DESCRIPTION/@Value"/>
    <x2:param name="contentUrl" select="$this/CONTENT_URL/@Value"/>

    <!-- This command gets called only when the user needs to be logged in.
    This command helps in generating the sso login page. -->

    <xapl:variable name="loginFormString">
      <cis:sso-login processLogin=""/>
    </xapl:variable>

    <xapl:if test="$loginFormString='true'">
      <xapl:variable name="userName"><cis:get-user-name/></xapl:variable>
      <identity:create-identity userId="{$userName}"/>

      <web:display-page>
        <web:get-page name="core_shell_display"/>
      </web:display-page>
    </xapl:if>


    <xapl:variable name="loginController">
      <xapl:choose>
        <xapl:when test="$bbyLogin = 'true' ">../core/login/controller/bbyssoLogin.x2c</xapl:when>
        <xapl:otherwise>../core/login/controller/ssoLogin.x2c</xapl:otherwise>
      </xapl:choose>
    </xapl:variable>
    <xapl:return>
      <LOGIN_PAGE_INFO>
        <MASTHEAD_IMAGE Value="../i2/images/masthead_fivetwo.gif"/>
        <PANEL_IMAGE Value="../i2/images/login_panel_simple.jpg"/>
        <COMMAND Value="{$loginController}"/>
        <CHANGE_PWD Value="yes"/>
        <CONTENT_URL Value="{$contentUrl}"/>
        <FROM Value="{$from}"/>
        <ERROR Value="{$error}"/>
        <DESCRIPTION Value="{$desc}"/>
        <DISPLAY_PAGE Value="{$loginFormString}"/>
      </LOGIN_PAGE_INFO>
    </xapl:return>
  </x2:command>

</x2:commands>
