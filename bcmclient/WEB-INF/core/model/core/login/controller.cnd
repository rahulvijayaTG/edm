<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:identity="http://www.i2.com/identity" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:cis="http://www.i2.com/cis" description="_">


  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="init">
    <xapl:variable name="gCanChangeRole" resolver="session" global="true"/>
    <xapl:variable name="gSelectedRole" resolver="session" global="true"/>

    <xapl:variable name="gScreenWidth" resolver="session" global="true"/>
  </x2:command>


<!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="display">
    <xapl:if test="$ssoEnabled = 'true'">
      <cis:sso-logout/>
    </xapl:if>

    <web:invalidate-session/>
    <web:display-page>
      <web:get-page name="core_login"/>
    </web:display-page>
  </x2:command>

<!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="validateSession">
    <xapl:variable name="identityId" select="identity-user-id()"/>

    <xapl:choose>
      <xapl:when test="$ssoEnabled = 'true'">
        <!-- If sso enabled, get user name from cis -->
        <xapl:variable name="userName"><cis:get-user-name/></xapl:variable>

        <xapl:choose>
          <!-- If sso username is invalid, then redirect user to login page -->
          <xapl:when test="string-length($userName) = 0">
            <web:display-page>
              <web:get-page name="core_login"/>
            </web:display-page>
          </xapl:when>
          <!-- If sso username is valid and its different from identity, then refresh identity -->
          <xapl:when test="string-length($userName) &gt; 0 and $userName != $identityId">
            <identity:create-identity userId="{$userName}"/>
          </xapl:when>
        </xapl:choose>

      </xapl:when>
      <xapl:otherwise>
        <!-- If sso not enabled, check if identity object is valid -->
        <xapl:if test="string-length($identityId) = 0">
          <web:display-page>
            <web:get-page name="core_login"/>
          </web:display-page>
        </xapl:if>
      </xapl:otherwise>
    </xapl:choose>

  </x2:command>

<!-- **********************************************************************
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="login">

    <web:invalidate-session/>

    <!-- Capturing the screen resolution width when the user logs in. This width can be used
    for rendering of charts -->
    <xapl:set-variable name="gScreenWidth" select="{$this/SCR_WIDTH/@Value}"/>

    <xapl:choose>
      <xapl:when test="$this/CHANGE_PASSWD/@Value='yes'">
        <web:display-page>
          <web:get-page name="core_change_passwd">
            <xapl:value-of select="$this/USER_NAME"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:otherwise>
        <xapl:variable name="isValid">
          <xcore:execute-method name="//EMService/validateLogin" entireResponse="true">
            <LOGIN_NAME Value="{$this/USER_NAME/@Value}"/>
            <PASSWORD Value="{$this/PASSWORD/@Value}"/>
          </xcore:execute-method>
        </xapl:variable>

        <xapl:choose>
         <xapl:when test="string-length($isValid/RESPONSE/_RESULT/_ERROR/@Value) = 0">
           <identity:create-identity userId="{$isValid/RESPONSE/LOGIN_NAME/@Value}"/>
           <!-- Fix for eQ :: 542228 - Need to enable this later if needed by a system property -->
           <!--cfg:load-recent-entries/-->
         </xapl:when>
         <xapl:otherwise>
          <xapl:choose>
            <!-- If password has expired, force them to change password -->
            <xapl:when test="$isValid/RESPONSE/_RESULT/_ERROR/@Value = 'PASSWORD_EXPIRED'">
              <web:display-page>
                <web:get-page name="core_change_passwd">
                  <ERROR Value="true"/>
                  <xapl:value-of select="{$isValid/RESPONSE/LOGIN_NAME}"/>
                  <DESCRIPTION Value="{$isValid/RESPONSE/_RESULT/_ERROR/@Value}"/>
                </web:get-page>
              </web:display-page>
            </xapl:when>
            <xapl:otherwise>
              <web:display-page>
                <web:get-page name="core_login">
                  <ERROR Value="true"/>
                  <xapl:value-of select="{$this/USER_NAME}"/>
                  <DESCRIPTION Value="{$isValid/RESPONSE/_RESULT/_ERROR/@Value}"/>
                </web:get-page>
              </web:display-page>
            </xapl:otherwise>
            </xapl:choose>
          </xapl:otherwise>
        </xapl:choose>
      </xapl:otherwise>
    </xapl:choose>

    <web:display-page>
      <web:get-page name="core_shell_display">
        <CONTENT_URL Value="{$this/CONTENT_URL/@Value}"/>
      </web:get-page>
    </web:display-page>
  </x2:command>

  <!--****************************************************************
  ****************************************************************** -->
  <x2:command public="yes" description="_" name="ssoLogin">

    <web:invalidate-session/>

    <xapl:variable name="isValid">
      <cis:sso-login processLogin="true"/>
    </xapl:variable>

    <xapl:choose>
      <xapl:when test="$isValid = 'true'">
        <xapl:variable name="userName"><cis:get-user-name/></xapl:variable>
        <identity:create-identity userId="{$userName}"/>
        <!-- Fix for eQ :: 542228 - Need to enable this later if needed by a system property -->
        <!--cfg:load-recent-entries/-->
      </xapl:when>
      <xapl:otherwise>
        <web:display-page>
          <web:get-page name="core_login">
            <ERROR Value="true"/>
            <xapl:value-of select="{$this/USER_NAME}"/>
            <DESCRIPTION Value="{$isValid}"/>
          </web:get-page>
        </web:display-page>
      </xapl:otherwise>
    </xapl:choose>

    <xapl:if test="{$this/CHANGE_PASSWD/@Value='yes'}">
      <web:display-page>
        <web:get-page name="core_change_passwd"/>
      </web:display-page>
    </xapl:if>

    <web:display-page>
      <web:get-page name="core_shell_display">
        <CONTENT_URL Value="{$this/CONTENT_URL/@Value}"/>
      </web:get-page>
    </web:display-page>
  </x2:command>


  <!--****************************************************************
  ****************************************************************** -->
  <x2:command public="yes" description="_" name="bbyssoLogin">

    <web:invalidate-session/>


    <xapl:variable name="isValid" select="'false'"/>
    <xapl:variable name="errorMsg"/>
    <xapl:variable name="user"/>

    <xapl:set-variable name="isValid"><cis:sso-login processLogin="true"/></xapl:set-variable>

    <xapl:choose>
      <!-- If LDAP pass - check with EM-->
      <xapl:when test="$isValid = 'true'">
        <xapl:set-variable name="user"><cis:get-user/></xapl:set-variable>
        <xapl:variable name="responses">
          <xcore:execute-method name="//EAIService/setUserInformationFromLDAP" entireResponse="true">
             <xapl:value-of select="$user"/>
          </xcore:execute-method>
        </xapl:variable>

        <xapl:if test="string($user/role)  = 'POWERUSER'">
          <xapl:set-variable name="gCanChangeRole">true</xapl:set-variable>
          <xapl:set-variable name="gSelectedRole"><xapl:value-of select="$responses/RESPONSE/ROLE/@Value"/></xapl:set-variable>
        </xapl:if>

        <xapl:if test="string-length($responses/RESPONSE/_RESULT/_ERROR/@Value) > 0">
            <xapl:set-variable name="errorMsg">
            <xapl:value-of select="$responses/RESPONSE/_RESULT/_ERROR/@Value"/>
          </xapl:set-variable>
          <xapl:set-variable name="isValid" select="'false'"/>
        </xapl:if>
        <xapl:if test="($responses/@Status != 'Success')">
            <xapl:set-variable name="errorMsg">
            <xapl:value-of select="$responses/@Description"/>
          </xapl:set-variable>
          <xapl:set-variable name="isValid" select="'false'"/>
        </xapl:if>

        <xapl:if test="($responses/RESPONSE/@Status != 'Success')">
            <xapl:set-variable name="errorMsg">
            <xapl:value-of select="$responses/RESPONSE/@Description"/>
              <xapl:value-of select="$responses/RESPONSE/_RESULT/_ERROR/@Value"/>
          </xapl:set-variable>
          <xapl:set-variable name="isValid" select="'false'"/>
        </xapl:if>

      </xapl:when>
      <xapl:otherwise>
        <xapl:set-variable name="errorMsg">
          <xapl:value-of select="$isValid"/>
        </xapl:set-variable>
      </xapl:otherwise>
    </xapl:choose>

    <xapl:if test="$isValid != 'true'">
     <web:display-page>
      <web:get-page name="core_login">
        <ERROR Value="true"/>
        <xapl:value-of select="{$this/USER_NAME}"/>
        <DESCRIPTION Value="{$errorMsg}"/>
      </web:get-page>
    </web:display-page>
    </xapl:if>

    <xapl:if test="{$this/CHANGE_PASSWD/@Value='yes'}">
      <web:display-page>
        <web:get-page name="core_change_passwd"/>
      </web:display-page>
    </xapl:if>

    <xapl:if test="$isValid = 'true'">
      <xapl:variable name="userName"><cis:get-user-name/></xapl:variable>
      <identity:create-identity userId="{$userName}"/>
      <!-- Fix for eQ :: 542228 - Need to enable this later if needed by a system property -->
      <!--cfg:load-recent-entries/-->

      <web:display-page>
        <web:get-page name="core_shell_display">
            <CONTENT_URL Value="{$this/CONTENT_URL/@Value}"/>
        </web:get-page>
      </web:display-page>
    </xapl:if>

  </x2:command>

  <!--****************************************************************
    ****************************************************************** -->
    <x2:command public="yes" description="_" name="changeRole">

      <xapl:variable name="userName"><cis:get-user-name/></xapl:variable>

       <xapl:variable name="responses">

         <xcore:execute-method name="//EMService/changeRoleOfUser" entireResponse="true">
           <USER_ID Value="{$userName}"/>
           <xapl:value-of select="$this/ROLE_ID"/>
         </xcore:execute-method>

        </xapl:variable>

        <identity:clear-identity/>
        <identity:create-identity userId="{$userName}"/>
        <xapl:set-variable name="gSelectedRole"><xapl:value-of select="$this/ROLE_ID/@Value"/></xapl:set-variable>

      <web:display-page>
        <web:get-page name="core_shell_display">
          <CONTENT_URL Value="{$this/CONTENT_URL/@Value}"/>
        </web:get-page>
      </web:display-page>

    </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="logout">

    <!-- Fix for eQ :: 542228 - Need to enable this later if needed by a system property -->
    <!--cfg:store-recent-entries/-->

    <xapl:if test="$ssoEnabled = 'true'">
      <cis:sso-logout/>
    </xapl:if>

    <web:invalidate-session/>
    <web:display-page>
      <web:get-page name="core_login">
        <xapl:choose>
          <xapl:when test="$this/FROM">
            <xapl:value-of select="$this/FROM"/>
          </xapl:when>
          <xapl:otherwise>
            <FROM Value="logout"/>
          </xapl:otherwise>
        </xapl:choose>
      </web:get-page>
    </web:display-page>
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getTopLevelActivity">
    <xapl:return>
      <xapl:choose>
        <xapl:when test="isAllowed('TOP_LEVEL_ACTIVITY', 'manage_orders')">manage_orders</xapl:when>
        <xapl:when test="isAllowed('TOP_LEVEL_ACTIVITY', 'manage_enterprise')">manage_enterprise</xapl:when>
        <xapl:when test="isAllowed('TOP_LEVEL_ACTIVITY', 'configure_system')">configure_system</xapl:when>
        <xapl:when test="isAllowed('TOP_LEVEL_ACTIVITY', 'manage_inventory')">manage_inventory</xapl:when>
        <xapl:when test="isAllowed('TOP_LEVEL_ACTIVITY', 'manage_events_order')">manage_events_order</xapl:when>
        <xapl:when test="isAllowed('TOP_LEVEL_ACTIVITY', 'manage_events')">manage_events</xapl:when>
        <xapl:when test="isAllowed('TOP_LEVEL_ACTIVITY', 'manage_events_admin')">manage_events_admin</xapl:when>
        <xapl:otherwise>manage_enterprise</xapl:otherwise>
     </xapl:choose>
    </xapl:return>
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getSelectedActivity">
    <x2:para name="pSelectedActivity"/>

    <xapl:return>
        <xapl:choose>
          <xapl:when test="string-length($pSelectedActivity) > 0 ">
            <xapl:value-of select="$pSelectedActivity"/>
           </xapl:when>
          <xapl:when test="string-length($sSelectedActivity) > 0 ">
            <xapl:value-of select="$sSelectedActivity"/>
           </xapl:when>
          <xapl:otherwise>
            <x2:execute command="core.login.controller:getTopLevelActivity">
            </x2:execute>
          </xapl:otherwise>
        </xapl:choose>
    </xapl:return>

  </x2:command>

  <!-- **********************************************************************
       *********************************************************************** -->

</x2:commands>
