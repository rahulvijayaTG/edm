<?xml version="1.0" encoding="UTF-8"?>

<x2:commands description="_" 
             xmlns:cfg="http://www.i2.com/configurability" 
             xmlns:core="http://www.i2.com/core" 
             xmlns:omx="http://www.i2.com/omx" 
             xmlns:perm="http://www.i2.com/permissibility" 
             xmlns:util="http://www.i2.com/util" 
             xmlns:web="http://www.i2.com/web" 
             xmlns:x2="http://www.i2.com/x2" 
             xmlns:xapl="http://www.i2.com/xapl" 
             xmlns:xcore="http://www.i2.com/xcore" 
             xmlns:xcore-db="http://www.i2.com/xcore-db" 
             xmlns:docutil="http://www.i2.com/docutil" 
             xmlns:xudl="http://www.i2.com/xudl"
             xmlns:identity="http://www.i2.com/identity">  
  

<!-- ********************************************************************** 
     *********************************************************************** -->  
  <x2:command public="yes" description="_" name="load">
    <x2:param name="pType" select="$this/ALERT_TYPE/@Value"/>
    <xapl:print> prompt.view:load this <xapl:value-of select="{$this}"/> </xapl:print>
    <xapl:return>
         <BUTTONS>
            <BUTTON 
                    Id="ok_button"
                    DisplayText="Cancel" 
                    />
            
            <BUTTON 
                    Id="cancel_button"
                    DisplayText="OK" 
                    />
          </BUTTONS>
          <FIELDS>
            <FIELD DisplayText="{$this/FIELD_LABEL/@Value}"  Value="" Name="userinput"  Type="Text" Editable="true" Size="9" MaxLength="64"/>
          </FIELDS>

      <x2:execute command="core.page.controller:getParameters">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
    </xapl:return>
    
  </x2:command>

<!-- ********************************************************************** 
     *********************************************************************** -->  
</x2:commands>
