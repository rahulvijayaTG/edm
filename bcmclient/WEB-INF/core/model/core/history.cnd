<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n"  xmlns:identity="http://www.i2.com/identity"  description="_">

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="init">
    <xapl:variable name="currentPageStack" resolver="session" global="true"/>
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="register">
    <x2:param name="pTab" />
    <x2:param name="pPage" select="$this/PAGE/@Value" />
    <x2:param name="pPageType"  select="'STAND_ALONE'"/>
    <x2:param name="pPageName"/>
    <x2:param name="this" />
    <x2:param name="pCurrentDate"/> <!-- Temp-->

    <!-- Init -->
    <xapl:if test="count($currentPageStack/*) = 0">
      <xapl:set-variable name="currentPageStack">
        <PAGES/>
      </xapl:set-variable>
    </xapl:if>

    <!-- Add this page to the stack -->
    <xapl:if test="$pPageType = 'STAND_ALONE'">
      <!-- If this is in stack remove this and all other subsequent pages in the stack -->
      <xapl:variable name="foundPage" select="'false'"/>
      <xapl:for-each select="$currentPageStack/*" varName="page">
        <xapl:if test="$page/@Value = $pPage">
          <xapl:set-variable name="foundPage" select="'true'"/>
        </xapl:if>
        <xapl:if test="$foundPage = 'true'">
        <docutil:set select="$page/@Remove">true</docutil:set>
        </xapl:if>
      </xapl:for-each>
      <docutil:remove select="$currentPageStack/PAGE[@Remove ='true']"/>
      <docutil:remove select="$currentPageStack/PAGE[@Value = $pPage]"/>
      <docutil:add select="$currentPageStack">
        <PAGE Value="{$pPage}" DisplayText="{$pPageName}" IsX2Page="true">
          <PARAM>
            <xapl:value-of select="$this/*" />
          </PARAM>
        </PAGE>
      </docutil:add>
    </xapl:if>

    <xapl:if test="$pPageType = 'TABBED'">

      <!-- If this is in stack remove this and all other subsequent pages in the stack -->
      <xapl:variable name="foundPage" select="'false'"/>
    <!--   for each tab/page   -->
      <xapl:for-each select="$currentPageStack/*" varName="page">
        <xapl:choose>
          <xapl:when test="name($page) = 'TAB'">
            <xapl:if test="$page/PAGE/@Value = $pPage">
              <xapl:set-variable name="foundPage" select="'true'"/>
            </xapl:if>
          </xapl:when>
        </xapl:choose>
        <xapl:if test="$foundPage = 'true'">
          <docutil:set select="$page/@Remove">true</docutil:set>
        </xapl:if>
      </xapl:for-each>

      <docutil:remove select="$currentPageStack/TAB/PAGE[@Remove ='true']"/>
      <docutil:remove select="$currentPageStack/PAGE[@Remove ='true']"/>


      <!-- Add this tab if not in stack-->
      <xapl:if test="count($currentPageStack/TAB[@Value = $pTab]) = 0">
      <docutil:add select="$currentPageStack">
        <TAB Value="{$pTab}" DisplayText="{$pPageName}">
        </TAB>
      </docutil:add>
      </xapl:if>

      <xapl:variable name="tab">
        <xapl:value-of select="$currentPageStack/TAB[@Value = $pTab]"/>
      </xapl:variable>

      <!-- Remove this step-->
      <docutil:remove select="$tab/PAGE[@Value = $pPage]"/>

      <!-- Add this step -->
      <docutil:add select="$tab">
        <PAGE Value="{$pPage}" DisplayText="{$pPageName}" IsX2Page="true">
          <PARAM>
            <xapl:value-of select="$this/*" />
          </PARAM>
        </PAGE>
      </docutil:add>
    </xapl:if>

    <xapl:print>  currentPageStack <xapl:value-of select="{$currentPageStack}"/> </xapl:print>
    <xapl:variable name="backUrl">
      <x2:execute command="core.history:getBackUrl">
       </x2:execute>
    </xapl:variable>

    <xapl:print>  backUrl <xapl:value-of select="{$backUrl}"/> </xapl:print>

    <xapl:variable name="aheader">
      <HEADER>
        <HOME Value="{$session:com.i2.ui.pgl.home-page}"/>
        <APP_NAME Value="{$session:com.i2.ui.pgl.app-name}"/>
      </HEADER>
    <!-- <util:map-execute map="ACTIVITY_HEADER" key="{$sSelectedActivity}"/> -->
    </xapl:variable>

    <!-- Return the current BackUrl -->
    <xapl:return>

      <HEADER>
      <xapl:value-of select="$aheader/*"/>
      <BREADCRUMBS>
        <xapl:for-each select="$currentPageStack/*[name() = 'PAGE' or name() = 'TAB']" varName="page">
          <BREADCRUMB>

            <xapl:variable name="lastPage">
              <xapl:choose>
                <xapl:when test="name($page) = 'TAB'">
                  <xapl:value-of select="$page/PAGE[position() = last()]"/>
                </xapl:when>
                <xapl:otherwise>
                  <xapl:value-of select="$page"/>
                </xapl:otherwise>
              </xapl:choose>
            </xapl:variable>

            <xapl:variable name="url">
              <xapl:choose>
                <xapl:when test="$lastPage/@IsX2Page = 'true'">
                  <web:get-page name="{$lastPage/@Value}">
                    <xapl:value-of select="$lastPage/PARAM/*"/>
                  </web:get-page>
                </xapl:when>
                <xapl:otherwise>
                  <xapl:value-of select="$lastPage/@Value"/>
                </xapl:otherwise>
              </xapl:choose>
            </xapl:variable>
            <DISPLAY_TEXT Value="{$lastPage/@DisplayText}"/>
            <URL Value="{$url}"/>
          </BREADCRUMB>
        </xapl:for-each>
      </BREADCRUMBS>
      </HEADER>
      <LINKS>
          <LINK Name="Return" Value="{$backUrl}" />
          <xapl:variable name="dateFormat"><identity:get-date-format format="common"/></xapl:variable>
          <xapl:variable name="dateTime"><identity:get-date-format format="datetime"/></xapl:variable>
          <xapl:variable name="time"><identity:get-date-format format="time"/></xapl:variable>
          <FORMAT  Date="{$dateFormat}" DateTime="{$dateTime}" Time="{$time}"/>
          <CURRENT_DATE  Value="{$pCurrentDate}"/> <!-- Later Use x2 current-date which in turn will use xcore current-date-->
      </LINKS>
    </xapl:return>
  </x2:command>



  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getBackUrl">

    <xapl:variable name="lastNode">
      <xapl:value-of select="$currentPageStack/*[position() = (last()-1)]"/>
    </xapl:variable>

   <xapl:return>
    <xapl:if test="$lastNode">
     <xapl:choose>
       <xapl:when test="name($lastNode) = 'PAGE'">
         <xapl:value-of select="$lastNode"/>
       </xapl:when>
       <xapl:when test="name($lastNode) = 'TAB'">
         <xapl:value-of select="$lastNode/PAGE[position() = last()]"/>
       </xapl:when>
       <xapl:otherwise>
       </xapl:otherwise>
     </xapl:choose>
    </xapl:if>
   </xapl:return>

  </x2:command>


 <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="back">


    <!-- The Current BackUrl -->
    <xapl:variable name="backPAGE">
      <x2:execute command="core.history:getBackUrl">
       </x2:execute>
    </xapl:variable>

    <xapl:print>  backPAGE <xapl:value-of select="{$backPAGE}"/> </xapl:print>

    <xapl:if test="string-length($backPAGE/@Value) > 0">
      <!-- Remove Current -->
      <docutil:remove select="$currentPageStack/*[position() = last()]"/>
      <!-- Remove Last -->
      <docutil:remove select="$currentPageStack/*[position() = last()]"/>

        <web:display-page>
          <web:get-page name="{$backPAGE/@Value}">
            <xapl:value-of select="$backPAGE/PARAM/*"/>
          </web:get-page>
        </web:display-page>
     </xapl:if>
    <xapl:if test="string-length($backPAGE/@Value) = 0">
      <x2:execute command="core.home.controller:display">
      </x2:execute>
    </xapl:if>

  </x2:command>


  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="clear">
    <xapl:set-variable name="currentPageStack"/>
  </x2:command>

<!-- **********************************************************************
     *********************************************************************** -->
</x2:commands>