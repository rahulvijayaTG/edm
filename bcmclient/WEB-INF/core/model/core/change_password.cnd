<?xml version="1.0" encoding="utf-8"?>
<x2:commands description="_" 
             xmlns:FUNCTION="http://www.i2.com/FUNCTION" 
             xmlns:REMOVE="http://www.i2.com/REMOVE" 
             xmlns:cfg="http://www.i2.com/configurability" 
             xmlns:core="http://www.i2.com/core" 
             xmlns:omx="http://www.i2.com/omx" 
             xmlns:perm="http://www.i2.com/permissibility" 
             xmlns:util="http://www.i2.com/util" 
             xmlns:web="http://www.i2.com/web" 
             xmlns:x2="http://www.i2.com/x2" 
             xmlns:xapl="http://www.i2.com/xapl" 
             xmlns:xcore="http://www.i2.com/xcore" 
             xmlns:xcore-db="http://www.i2.com/xcore-db" 
             xmlns:docutil="http://www.i2.com/docutil" 
             xmlns:xudl="http://www.i2.com/xudl">  
  
  <!--************************************************************************-->
  
  <x2:command public="yes" description="_" name="changePassword">

    <xapl:variable name="isSuccess">
      <xcore:execute-method name="//EMService/changePasswordForUser" entireResponse="true">
        <LOGIN_NAME Value="{$this/ID/@Value}"/>
        <xapl:value-of select="$this/OLD_PASSWORD"/>
        <xapl:value-of select="$this/NEW_PASSWORD"/>
      </xcore:execute-method>
    </xapl:variable>
      
    <xapl:choose>
      <xapl:when test="{$isSuccess/RESPONSE/@Status = 'Error'}">
        <web:display-page>
          <web:get-page name="core_change_passwd">
            <ERROR Value="true"/>
            <DESCRIPTION Value="{$isSuccess/RESPONSE/_RESULT/_ERROR/@Value}"/>
            <USER_NAME Value="{$this/ID/@Value}"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:otherwise>
        <web:display-page>
          <web:get-page name="core_login">
            <FROM Value="change_passwd"/>
            <USER_NAME Value="{$this/ID/@Value}"/>
          </web:get-page>
        </web:display-page>
      </xapl:otherwise>
    </xapl:choose>
    
  </x2:command>
  
  <!--************************************************************************-->
  
</x2:commands>







