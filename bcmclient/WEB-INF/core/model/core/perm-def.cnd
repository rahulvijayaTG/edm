<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" description="_">
  <x2:command name="init" public="yes" description="_">
    <xapl:print>Defining Core Permissions....</xapl:print>
    <perm:define-permissions document="TOP_LEVEL_ACTIVITY">
      <perm:state value="*">
        <perm:action value="configure_system">
          <perm:allow role="configure_system"/>
        </perm:action>
        <perm:action value="financial_collaboration">
          <perm:allow role="financial_collaboration"/>
        </perm:action>
        <perm:action value="manage_enterprise">
          <perm:allow role="manage_enterprise"/>
        </perm:action>
        <perm:action value="manage_inventory">
          <perm:allow role="manage_inventory"/>
        </perm:action>
        <perm:action value="manage_orders">
          <perm:allow role="manage_orders"/>
        </perm:action>
        <perm:action value="manage_pricing">
          <perm:allow role="manage_pricing"/>
        </perm:action>
        <perm:action value="manage_events">
          <perm:allow role="manage_events"/>
        </perm:action>
        <perm:action value="manage_events_admin">
          <perm:allow role="manage_events_admin"/>
        </perm:action>
        <perm:action value="manage_events_order">
          <perm:allow role="manage_events_order"/>
        </perm:action>
        <perm:action value="cpm_manage_programs">
          <perm:allow role="cpm_manage_programs"/>
        </perm:action>
        <perm:action value="cpm_manage_cpe_programs">
          <perm:allow role="cpm_manage_cpe_programs"/>
        </perm:action>
        <perm:action value="cpm_replenishment_planning">
          <perm:allow role="cpm_replenishment_planning"/>
        </perm:action>
        <perm:action value="cpm_documents_processing">
          <perm:allow role="cpm_documents_processing"/>
        </perm:action>
      </perm:state>
    </perm:define-permissions>    
  </x2:command>
</x2:commands>
