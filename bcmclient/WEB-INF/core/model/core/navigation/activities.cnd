<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:identity="http://www.i2.com/identity" xmlns:i18n="http://www.i2.com/i18n" description="_">  
  
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getLinks">
    <x2:param name="selectedActivity"/>
 
    <xapl:variable name="url"/>
   
    <xapl:variable name="activities">
      <ACTIVITIES>
        <xapl:if test="string-length($selectedActivity) > 0">
          <ACTIVITY Value="{$selectedActivity}"/>
        </xapl:if>
    
        <PAD DisplayText="Order Management" Name="solutions" Scrollable="yes" Type="solution">
  
          <!-- Configure System -->
          <xapl:if test="isAllowed('TOP_LEVEL_ACTIVITY', 'configure_system')">
            <util:map-execute map="NAV_ACTIVITY" key="configure_system">
              <util:map-with-param name="selectedActivity" select="$selectedActivity"/>            
            </util:map-execute>
          </xapl:if>
        
          <!-- Financial Collaboration -->
<!--           <xapl:if test="isAllowed('TOP_LEVEL_ACTIVITY', 'financial_collaboration')">
            <PAD_ITEM
              OnClick="{$pages:financial_collaboration_shell}"
              Selected="{$selectedActivity = 'financial_collaboration'}"
              Target="_top"
              DisplayText="Financial Collaboration">          
            </PAD_ITEM>		
          </xapl:if>
 -->          
          <!-- Manage Enterprise -->
          <xapl:if test="isAllowed('TOP_LEVEL_ACTIVITY', 'manage_enterprise')">
            <util:map-execute map="NAV_ACTIVITY" key="manage_enterprise">
              <util:map-with-param name="selectedActivity" select="$selectedActivity"/>            
            </util:map-execute>
          </xapl:if>
          
          <!-- Manage Inventory -->
          <xapl:if test="isAllowed('TOP_LEVEL_ACTIVITY', 'manage_inventory')">
            <util:map-execute map="NAV_ACTIVITY" key="manage_inventory">
              <util:map-with-param name="selectedActivity" select="$selectedActivity"/>            
            </util:map-execute>
          </xapl:if>
          
          <!-- Manage Orders -->
          <xapl:if test="isAllowed('TOP_LEVEL_ACTIVITY', 'manage_orders')">
            <util:map-execute map="NAV_ACTIVITY" key="manage_orders">
              <util:map-with-param name="selectedActivity" select="$selectedActivity"/>            
            </util:map-execute>
          </xapl:if>
          
          <!-- Manage Pricing -->
          <xapl:if test="isAllowed('TOP_LEVEL_ACTIVITY', 'manage_pricing')">
            <util:map-execute map="NAV_ACTIVITY" key="manage_pricing">
              <util:map-with-param name="selectedActivity" select="$selectedActivity"/>            
            </util:map-execute>
          </xapl:if>
          
          <!-- Program Set Up -->
          <xapl:if test="isAllowed('TOP_LEVEL_ACTIVITY', 'cpm_manage_programs')">
            <util:map-execute map="NAV_ACTIVITY" key="cpm_manage_programs">
              <util:map-with-param name="selectedActivity" select="$selectedActivity"/>            
            </util:map-execute>
          </xapl:if>
          
          <!-- Program Execution -->
          <xapl:if test="isAllowed('TOP_LEVEL_ACTIVITY', 'cpm_replenishment_planning')">
            <util:map-execute map="NAV_ACTIVITY" key="cpm_replenishment_planning">
              <util:map-with-param name="selectedActivity" select="$selectedActivity"/>            
            </util:map-execute>
          </xapl:if>          

          <!-- Administer Events -->
          <xapl:if test="isAllowed('TOP_LEVEL_ACTIVITY', 'manage_events_admin')">
            <util:map-execute map="NAV_ACTIVITY" key="manage_events_admin">
              <util:map-with-param name="selectedActivity" select="$selectedActivity"/>            
            </util:map-execute>
          </xapl:if>
          
          <!-- Manage Events for Order -->
          <xapl:if test="isAllowed('TOP_LEVEL_ACTIVITY', 'manage_events_order')">
            <util:map-execute map="NAV_ACTIVITY" key="manage_events_order">
              <util:map-with-param name="selectedActivity" select="$selectedActivity"/>            
            </util:map-execute>
          </xapl:if>

          <!-- Manage Events -->
          <xapl:if test="isAllowed('TOP_LEVEL_ACTIVITY', 'manage_events')">
            <util:map-execute map="NAV_ACTIVITY" key="manage_events">
              <util:map-with-param name="selectedActivity" select="$selectedActivity"/>            
            </util:map-execute>
          </xapl:if>
        </PAD>
      </ACTIVITIES>
    </xapl:variable>  

    <xapl:return>
      <xapl:choose>
        <xapl:when test="count($activities/PAD/PAD_ITEM) > 0">
        <xapl:value-of select="$activities"/>
        </xapl:when>
      </xapl:choose>
    </xapl:return>
    
  </x2:command>	
  
  <x2:command public="yes" description="_" name="i18n">
    <i18n:text>Financial Collaboration</i18n:text>
    <i18n:text>Order Management</i18n:text>
    <i18n:text>Manage Events</i18n:text>
    <i18n:text>Administer Events</i18n:text>
  </x2:command>	


</x2:commands>	
