<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:identity="http://www.i2.com/identity" xmlns:omx="http://www.i2.com/omx" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:i18n="http://www.i2.com/i18n" description="_">  
  
  <x2:command public="yes" description="_" name="login">
    
    <web:invalidate-session/>
    
    <!-- validate the username and password -->
<!--
    <xapl:variable name="isValid">
      <xcore:execute-method name="//EMService/validateLogin" entireResponse="true">
        <LOGIN_NAME Value="{$this/USER_NAME/@Value}"/>
        <PASSWORD Value="{$this/PASSWORD/@Value}"/>
      </xcore:execute-method> 
    </xapl:variable>

    <xapl:if test="string-length($isValid/RESPONSE/_RESULT/_ERROR/@Value) != 0">
      <web:display-page>
        <web:get-page name="login">
          <ERROR Value="true"/>
          <xapl:value-of select="{$this/USER_NAME}"/>
          <DESCRIPTION Value="{$isValid/RESPONSE/_RESULT/_ERROR/@Value}"/>
        </web:get-page> 
      </web:display-page>
    </xapl:if>
-->
    
    <!-- create the identity object -->
    <identity:create-empty-identity userId="{$this/USER_NAME/@Value}"/>
    <identity:set-user-id userId="{$this/USER_NAME/@Value}"/>
    <identity:set-user-name userName="i2er"/>
    <identity:set-org userOrg="i2 Technologies Inc."/>
    <identity:set-roles roles="edit_profile"/>

<!--
    <identity:create-identity userId="{$this/USER_NAME/@Value}"/>
-->

    <xapl:if test="{$this/CHANGE_PASSWD/@Value='yes'}">
      <web:display-page>
        <web:get-page name="change_passwd"/>
      </web:display-page>
    </xapl:if>

<!--    
    <x2:execute command="core.domain.domains:setIdentityDomain"/>
-->

    <web:display-page>
      <web:get-page name="loginSuccess"/>
    </web:display-page>
    
  </x2:command>
  
</x2:commands>
