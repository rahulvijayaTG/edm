<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" description="_">

  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="display">
  
      <xapl:variable name="activity">    
        <x2:execute command="core.login.controller:getSelectedActivity"/>
      </xapl:variable>
     <xapl:variable name="homeURL">
        <x2:execute command="core.home.controller:getHomeURL">
          <x2:with-param name="pActivity" select="$activity"/>
        </x2:execute>
      </xapl:variable>
      <web:display-page>
        <xapl:value-of select="$homeURL"/>
      </web:display-page>

  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="Returns the URL to the home page that is registered for the given activity." name="getHomeURL">
    <x2:param name="pActivity"/>
  
    <!-- Try to retrieve the home page registered for the given activity -->
    <xapl:variable name="home_page">
      <util:map-get map="NAV_HOME_PAGE" key="{$pActivity}"/>
    </xapl:variable>
    
    <!-- If no home page is registered for the given activity, use the base-level core home page -->
    <xapl:if test="string-length($home_page) = 0">
      <xapl:set-variable name="home_page">core_home</xapl:set-variable>
    </xapl:if>
  
    <xapl:return>  
      <web:get-page name="{$home_page}" />
    </xapl:return>
  </x2:command>

<!-- ********************************************************************** 
     *********************************************************************** -->

</x2:commands>