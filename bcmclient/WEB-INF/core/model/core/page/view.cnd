<?xml version="1.0" encoding="UTF-8"?>

<x2:commands description="_" 
             xmlns:cfg="http://www.i2.com/configurability" 
             xmlns:core="http://www.i2.com/core" 
             xmlns:omx="http://www.i2.com/omx" 
             xmlns:perm="http://www.i2.com/permissibility" 
             xmlns:util="http://www.i2.com/util" 
             xmlns:web="http://www.i2.com/web" 
             xmlns:x2="http://www.i2.com/x2" 
             xmlns:xapl="http://www.i2.com/xapl" 
             xmlns:xcore="http://www.i2.com/xcore" 
             xmlns:xcore-db="http://www.i2.com/xcore-db" 
             xmlns:docutil="http://www.i2.com/docutil" 
             xmlns:xudl="http://www.i2.com/xudl"
             xmlns:identity="http://www.i2.com/identity">  
  
<!-- ********************************************************************** 
     *********************************************************************** -->		    
  <x2:command public="yes" description="_" name="getPageHeader">
		<x2:param name="pPageHeaderInfo"/>

    <!-- HEADER INFO - $pPageHeaderInfo -->   
    <!--
      <PAGE_HEADER>
    		<BREADCRUMBS>
  				<BREADCRUMB>
  					<DISPLAY_TEXT Value="Heading 1"/>
  					<URL Value="Heading url 1"/>
  				</BREADCRUMB>
  				<BREADCRUMB>
  					<DISPLAY_TEXT Value="Heading 2"/>
  					<URL Value="Heading url 2"/>
  				</BREADCRUMB>
          .
          .
          .
    		</BREADCRUMBS>
    		<LINKS>
  				<LINK>
  					<DISPLAY_TEXT Value="refresh"/>
  					<URL Value="refresh_order_review_url"/>
  					<IMG_PATH Value="refresh_icon_img_url"/>
  				</LINK>
  				<LINK>
  					<DISPLAY_TEXT Value="print"/>
  					<URL Value="print_url"/>
  					<IMG_PATH Value="print_icon_img_url"/>
  				</LINK>
          .
          .
          .
    		</LINKS>
      </PAGE_HEADER>
    -->

    <!-- $activityHeader - 
      <ACTIVITY_HEADER>
        <APP_NAME Value="Manage Orders"/>
  	  	<HOME Value="omx/home.jsp"/>
      </ACTIVITY_HEADER>
    -->
    <xapl:variable name="activityHeader">
      <util:map-execute map="ACTIVITY_HEADER" key="{$sSelectedActivity}"/>
    </xapl:variable>      

    <xapl:return>
      <!--
      <HEADER>
        <APP_NAME Value="Manage Orders"/>
  	  	<HOME Value="omx/home.jsp"/>
    		<BREADCRUMBS>
  				<BREADCRUMB>
  					<DISPLAY_TEXT Value="Heading 1"/>
  					<URL Value="Heading url 1"/>
  				</BREADCRUMB>
  				<BREADCRUMB>
  					<DISPLAY_TEXT Value="Heading 2"/>
  					<URL Value="Heading url 2"/>
  				</BREADCRUMB>
          .
          .
          .
    		</BREADCRUMBS>
    		<LINKS>
  				<LINK>
  					<DISPLAY_TEXT Value="refresh"/>
  					<URL Value="refresh_order_review_url"/>
  					<IMG_PATH Value="refresh_icon_img_url"/>
  				</LINK>
  				<LINK>
  					<DISPLAY_TEXT Value="print"/>
  					<URL Value="print_url"/>
  					<IMG_PATH Value="print_icon_img_url"/>
  				</LINK>
          .
          .
          .
    		</LINKS>
      </HEADER>
      -->
      <HEADER>
        <xapl:value-of select="$activityHeader/*"/>
				<xapl:value-of select="$pPageHeaderInfo/*"/>
      </HEADER>		
    </xapl:return>
	</x2:command>

<!-- ********************************************************************** 
     *********************************************************************** -->  
  <x2:command public="yes" description="_" name="getHeader">
		<x2:param name="pHeading"/>
		<x2:param name="pHeadingUrl"/>
		<x2:param name="pHeading2"/>
		<x2:param name="this"/>    
		<x2:param name="pToggle" select="'../../'"/>
   
  	<xapl:variable name="links">
  		<docutil:collate name="LINK_DETAILS">
  			<xapl:value-of select="{$this/LINK}"/>
  			<xapl:value-of select="{$this/LINK_URL}"/>
  			<xapl:value-of select="{$this/LINK_IMG_PATH}"/>
  		</docutil:collate>
  	</xapl:variable>

  	<xapl:variable name="link">
  		<LINKS>
  			<xapl:for-each varName="linkDetail" select="{$links/LINK_DETAILS}">
  				<LINK>
  					<DISPLAY_TEXT Value="{$linkDetail/LINK/@Value}"/>
  					<URL Value="{$linkDetail/LINK_URL/@Value}"/>
  					<IMG_PATH Value="{$linkDetail/LINK_IMG_PATH/@Value}"/>
  				</LINK>
  			</xapl:for-each>
  		</LINKS>
  	</xapl:variable>

    <xapl:variable name="activityHeader">
      <util:map-execute map="ACTIVITY_HEADER" key="{$sSelectedActivity}"/>
    </xapl:variable>      

    <xapl:return>
      <HEADER>
        <!--xapl:value-of select="$activityHeader/*"/-->
        <HOME Value="{$session:com.i2.ui.pgl.home-page}"/>
        <APP_NAME Value="{$session:com.i2.ui.pgl.app-name}"/>
				<TOGGLE_NAV Value="{$pToggle}"/>
				<HEADING Value="{$pHeading}"/>
        <xapl:if test="string-length($pHeadingUrl) > 0">
	  			<HEADING_LINK Value="{$pHeadingUrl}"/>
        </xapl:if>
        <xapl:if test="string-length($pHeading2) > 0">
  				<HEADING2 Value="{$pHeading2}"/>
        </xapl:if>
				<xapl:value-of select="{$link}"/>
      </HEADER>		
    </xapl:return>

  </x2:command>

<!-- ********************************************************************** 
     *********************************************************************** -->  
</x2:commands>
