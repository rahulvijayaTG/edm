  <!-- ********************************************************************** 
       *********************************************************************** -->
    <x2:command public="yes" description="_" name="getTypes">
    <xapl:return>
      <TYPES>
        <TYPE ExistingDocument="yes">
          <VALUE_ID Value="TYPE1"/>
          <DESCRIPTION Value="Type1"/>
        </TYPE>
        <TYPE ExistingDocument="yes">
          <VALUE_ID Value="TYPE2"/>
          <DESCRIPTION Value="Type2"/>
        </TYPE>
      </TYPES>
    </xapl:return>
  </x2:command>
  
