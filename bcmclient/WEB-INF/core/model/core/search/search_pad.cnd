<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:identity="http://www.i2.com/identity" xmlns:i18n="http://www.i2.com/i18n" description="_">

  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="init">
    <!-- SAVED SEARCHES PAGES -->
    <web:define-page name="core_refresh_navframe" url="/core/search/refresh_navframe.x2p"/>
    <web:define-page name="core_search_select_name" url="/core/search/save.x2p"/>
    <web:define-page name="core_select_searches" url="/core/search/select/searches.x2p"/>
    <web:define-page name="core_organize_searches" url="/core/search/organize/searches.x2p"/>
  </x2:command>
  
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getPAD">

    <xapl:variable name="pad">
      <PAD Name="Favorites" DisplayText="Favorites" Scrollable="yes">
        <PAD_ITEM OnClick="{$pages:core_select_searches}" DisplayText="Manage Favorites"/>
        <PAD_ITEM OnClick="{$pages:core_organize_searches}" DisplayText="Organize Favorites"/>
        <xapl:variable name="userId"><identity:get-user-id/></xapl:variable>
        <xapl:variable name="savedSearches">
          <xcore:execute-method name="//BPE_UIService/getSavedSearches">
            <FILTER Name="USER_ID">
              <USER_ID Value="{$userId}"/>
            </FILTER>
            <FILTER Name="SEQUENCE_NUMBER">
              <SEQUENCE_NUMBER Value="0" MatchBy="GREATER"/>
            </FILTER>
            <ORDER_BY>
              <SEQUENCE_NUMBER Sort="Ascending"/>
            </ORDER_BY>
          </xcore:execute-method>
        </xapl:variable>

        <xapl:variable name="categories">
          <x2:execute command="core.search.select.searches:getCategories"/>
        </xapl:variable>

        <xapl:for-each select="$savedSearches/FAVORITE" varName="search">
          <xapl:variable name="page" select="$search/FAVORITE_PARAMS_LINK/FAVORITE_PARAMETERS[FIELD_NAME/@Value='PAGE_NAME']/FIELD_VALUE/@Value"/>
          <xapl:variable name="name" select="$search/NAME/@Value"/>
          <xapl:variable name="url">
            <web:get-page name="core_search_view">
              <ID Value="{$search/ID/@Value}"/>
              <NAME Value="{$name}"/>
            </web:get-page>
          </xapl:variable>
          <xapl:variable name="category">
            <x2:execute command="core.search.select.searches:getCategory">
              <x2:with-param name="page" select="$page"/>
              <x2:with-param name="categories" select="$categories"/>
            </x2:execute>
          </xapl:variable>
          <docutil:add select="$category">
            <PAD_ITEM OnClick="{$url}" DisplayText="{$name}"/>
          </docutil:add>
        </xapl:for-each>

        <xapl:for-each select="$categories/OPTION[PAD_ITEM]" varName="category">
          <PAD_ITEM DisplayText="{$category/@Id}">
            <xapl:value-of select="$category/*"/>
          </PAD_ITEM>
        </xapl:for-each>
      </PAD>
    </xapl:variable>

    <xapl:return>
      <xapl:value-of select="$pad"/>
    </xapl:return>
  </x2:command>

  <!-- ********************************************************************** 
  *********************************************************************** -->
</x2:commands>
