<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:oa="http://www.i2.com/oa" xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHiddenFields">
    <xapl:return>
   
      <FIELD 
             Type="Hidden" 
             Name="DO_SEARCH" 
             Value="{$this/DO_SEARCH[position() = 1]/@Value}" 
             Visibility="Simple"/>
      
        <FIELD 
             Type="Hidden" 
             Name="SEARCH_TYPE" 
             Value="{$this/SEARCH_TYPE[position() = 1]/@Value}" 
             Visibility="Simple"/>
        
      <FIELD 
             Type="Hidden" 
             Name="SORT_BY" 
             Value="{$this/SORT_BY[position() = 1]/@Value}" 
             Visibility="Simple"/>
      
      <FIELD 
             Type="Hidden" 
             Name="SORT_ORDER" 
             Value="{$this/SORT_ORDER[position() = 1]/@Value}" 
             Visibility="Simple"/>
      
      <FIELD 
             Type="Hidden" 
             Name="START_COUNT" 
             Value="{$this/START_COUNT[position() = 1]/@Value}" 
             Visibility="Simple"/>
      
      <FIELD 
             Type="Hidden" 
             Name="MAX_ROWS" 
             Value="{$this/MAX_ROWS[position() = 1]/@Value}" 
             Visibility="Simple"/>
      
      <FIELD 
             Type="Hidden" 
             Name="DOC_TYPE" 
             Value="{$this/DOC_TYPE[position() = 1]/@Value}" 
             Visibility="Simple"/>
      
      <FIELD 
             Type="Hidden" 
             Name="PAGE" 
             Value="{$this/PAGE[position() = 1]/@Value}" 
             Visibility="Simple"/>
      
      <FIELD 
             Type="Hidden" 
             Name="OBJECT_TYPE" 
             Value="{$this/OBJECT_TYPE[position() = 1]/@Value}" 
             Visibility="Simple"/>
             
       <FIELD 
             Type="Hidden" 
             Name="RET_PAGE" 
             Value="{$this/RET_PAGE[position() = 1]/@Value}" 
             Visibility="Simple"/>
          
   <xapl:variable name="dateFormat"><identity:get-date-format format="common"/></xapl:variable>
       
	   <FIELD 
              Type="Hidden" 
              Name="DATE_FORMAT" 
              Value="{$dateFormat}" 
              Visibility="Simple"/>
             
    </xapl:return>      
    
  </x2:command>


 <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHiddenFields_save">
  <xapl:return>
  
       <FIELD 
               Type="Hidden" 
               Name="SAVED_SEARCH_NAME" 
               Value="{$this/SAVED_SEARCH_NAME/@Value}" 
               Visibility="Simple"/>
        
        <FIELD 
               Type="Hidden" 
               Name="SAVED_SEARCH_ID" 
               Value="{$this/SAVED_SEARCH_ID/@Value}" 
               Visibility="Simple"/>
        
        <FIELD  
               Type="Hidden" 
               Name="SAVED_DOC_TYPE" 
               Value="{$this/SAVED_DOC_TYPE/@Value}" 
               Visibility="Simple"/>



               
  </xapl:return>          
  </x2:command>        

  
  
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHiddenFields_old">
    <xapl:return>
      <!-- Always Put hidden at the end -->
      <FIELD 
             Type="Hidden" 
             Name="DIRECTORY" 
             Value="{$this/DIRECTORY[position() = 1]/@Value}" 
             Visibility="Simple"/>
      
      <FIELD 
             Type="Hidden" 
             Name="FILE" 
             Value="{$this/FILE[position() = 1]/@Value}" 
             Visibility="Simple"/>
      
      <FIELD 
             Type="Hidden" 
             Name="DO_SEARCH" 
             Value="{$this/DO_SEARCH[position() = 1]/@Value}" 
             Visibility="Simple"/>
      
      <FIELD 
             Type="Hidden" 
             Name="SEARCH_TYPE" 
             Value="{$this/SEARCH_TYPE[position() = 1]/@Value}" 
             Visibility="Simple"/>
      
      <FIELD 
             Type="Hidden" 
             Name="SORT_BY" 
             Value="{$this/SORT_BY[position() = 1]/@Value}" 
             Visibility="Simple"/>
      
      <FIELD 
             Type="Hidden" 
             Name="SORT_ORDER" 
             Value="{$this/SORT_ORDER[position() = 1]/@Value}" 
             Visibility="Simple"/>
      
      <FIELD 
             Type="Hidden" 
             Name="START_COUNT" 
             Value="{$this/START_COUNT[position() = 1]/@Value}" 
             Visibility="Simple"/>
      
      <FIELD 
             Type="Hidden" 
             Name="MAX_ROWS" 
             Value="{$this/MAX_ROWS[position() = 1]/@Value}" 
             Visibility="Simple"/>
      
      <FIELD 
             Type="Hidden" 
             Name="DOC_TYPE" 
             Value="{$this/DOC_TYPE[position() = 1]/@Value}" 
             Visibility="Simple"/>
      
      <FIELD 
             Type="Hidden" 
             Name="PAGE" 
             Value="{$this/PAGE[position() = 1]/@Value}" 
             Visibility="Simple"/>
      
      <FIELD 
             Type="Hidden" 
             Name="OBJECT_TYPE" 
             Value="{$this/OBJECT_TYPE[position() = 1]/@Value}" 
             Visibility="Simple"/>
             
       <FIELD 
             Type="Hidden" 
             Name="JSCRIPT" 
             Value="{$this/JSCRIPT[position() = 1]/@Value}" 
             Visibility="Simple"/>
      
       <FIELD 
             Type="Hidden" 
             Name="SHOW_HEADER" 
             Value="{$this/SHOW_HEADER[position() = 1]/@Value}" 
             Visibility="Simple"/>

       <FIELD 
             Type="Hidden" 
             Name="RET_PAGE" 
             Value="{$this/RET_PAGE[position() = 1]/@Value}" 
             Visibility="Simple"/>
             
       <FIELD 
              Type="Hidden" 
              Name="ORDER_TYPE_ID" 
              Value="{$this/ORDER_TYPE_ID[position() = 1]/@Value}" 
              Visibility="Simple"/>

	   <xapl:variable name="dateFormat"><identity:get-date-format format="common"/></xapl:variable>
       
	   <FIELD 
              Type="Hidden" 
              Name="DATE_FORMAT" 
              Value="{$dateFormat}" 
              Visibility="Simple"/>

    </xapl:return>      
    
  </x2:command>

  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="i18n">
    <i18n:text>Your Search Criteria has been successfully updated!</i18n:text>
    <i18n:text>Confimation</i18n:text>
    <i18n:text>Saving Search Error</i18n:text>
    <i18n:text>Delete Custom Report</i18n:text>
    <i18n:text>Your Custom Report has been deleted!</i18n:text>
    <i18n:text>Updating Search Error</i18n:text>
    <i18n:text>Orders</i18n:text>
    <i18n:text>Quotes</i18n:text>
    <i18n:text>Templates</i18n:text>
    <i18n:text>Drafts</i18n:text>
    <i18n:text>Activity Orders</i18n:text>
    <i18n:text>Shipments</i18n:text>
    <i18n:text>Invoices</i18n:text>
    <i18n:text>Errors</i18n:text>
    <i18n:text>RMAs</i18n:text>
  </x2:command>
	
<!-- ********************************************************************** 
     *********************************************************************** -->
</x2:commands>

