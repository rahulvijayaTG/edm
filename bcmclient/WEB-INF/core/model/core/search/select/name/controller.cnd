<?xml version="1.0" encoding="UTF-8"?>
<x2:commands 
             xmlns:x2="http://www.i2.com/x2" 
             xmlns:core="http://www.i2.com/core" 
             xmlns:xcore="http://www.i2.com/xcore" 
             xmlns:xcore-db="http://www.i2.com/xcore-db" 
             xmlns:xapl="http://www.i2.com/xapl" 
             xmlns:web="http://www.i2.com/web" 
             xmlns:docutil="http://www.i2.com/docutil" 
             xmlns:util="http://www.i2.com/util" 
             xmlns:xudl="http://www.i2.com/xudl" 
             xmlns:cfg="http://www.i2.com/configurability" 
             xmlns:perm="http://www.i2.com/permissibility" 
             xmlns:omx="http://www.i2.com/omx" 
             xmlns:identity="http://www.i2.com/identity" description="_">  

 <!-- ********************************************************************** 
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="display">

    <web:display-page>
      <web:get-page name="core_search_select_name">
        <xapl:value-of select="$this/*"/>
      </web:get-page>
    </web:display-page>

  </x2:command>

<!-- ********************************************************************** 
  *********************************************************************** -->    
  <x2:command public="yes" description="_" name="ok">
  
  	<!-- If doc type not sent in -->
  	<xapl:variable name="docType">
  		<xapl:choose>
  			<xapl:when test="string-length($this/DOC_TYPE/@Value) = 0">SAVED_SEARCH_DOC</xapl:when>
  			<xapl:otherwise><xapl:value-of select="$this/DOC_TYPE/@Value"/></xapl:otherwise>
  		</xapl:choose>
  	</xapl:variable>
  	
  	
    <x2:execute command="core.search.controller:save">
      <x2:with-param name="pFilters" select="$sSearchCriteria"/>
      <x2:with-param name="pDocType" select="$docType"/>
      <x2:with-param name="pName" select="$this/NAME/@Value"/>
    </x2:execute>
  
  </x2:command>

<!-- ********************************************************************** 
     *********************************************************************** -->  
  </x2:commands>
     
