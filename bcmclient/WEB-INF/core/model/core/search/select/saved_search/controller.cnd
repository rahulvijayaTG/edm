<?xml version="1.0" encoding="UTF-8"?>
<x2:commands
             xmlns:x2="http://www.i2.com/x2"
             xmlns:core="http://www.i2.com/core"
             xmlns:xcore="http://www.i2.com/xcore"
             xmlns:xcore-db="http://www.i2.com/xcore-db"
             xmlns:xapl="http://www.i2.com/xapl"
             xmlns:web="http://www.i2.com/web"
             xmlns:docutil="http://www.i2.com/docutil"
             xmlns:util="http://www.i2.com/util"
             xmlns:xudl="http://www.i2.com/xudl"
             xmlns:cfg="http://www.i2.com/configurability"
             xmlns:perm="http://www.i2.com/permissibility"
             xmlns:omx="http://www.i2.com/omx"
             xmlns:identity="http://www.i2.com/identity" description="_">


  <!-- ********************************************************************** 
      *********************************************************************** -->
  <x2:command public="yes" description="_" name="display">
    <web:display-page>
      <web:get-page name="core_search_select_saved_search">
        <xapl:value-of select="$this/*"/>
        <SAVED_SEARCH_NAME Value="*"/>
        <SAVED_DOC_TYPE Value="*"/>
        <DO_SEARCH Value="Yes" />
      </web:get-page>
    </web:display-page>

  </x2:command>


  <!--  ********************************************************************** 
   *********************************************************************** -->
  <x2:command public="yes" description="_" name="view">

    <x2:execute command="core.search.controller:view">
      <x2:with-param name="this" select="$this"/>
    </x2:execute>

  </x2:command>
  
  
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="delete">
    <xapl:variable name="userId">
      <identity:get-user-id/>
    </xapl:variable>
    <!-- Name is passed as ID -->
    <xapl:for-each varName="name" select="{$this/ID}">
      <xcore:execute-method name="//BPE_UIService/deleteSavedSearch">
        <NAME Value="{$name/@Value}"/>
      </xcore:execute-method>
    </xapl:for-each>
    <web:display-page>
      <web:get-page name="message_page">
        <MESSAGE Value="Your Custom Report has been deleted!"/>
        <TITLE Value="Delete Custom Report"/>
        <OK Value="true"/>
        <DOC_TYPE Value="SAVED_SEARCH"/>        
      </web:get-page>
    </web:display-page>
  </x2:command>


  <!-- ********************************************************************** 
         *********************************************************************** -->
</x2:commands>
