<?xml version="1.0" encoding="UTF-8"?>
<x2:commands
             xmlns:x2="http://www.i2.com/x2"
             xmlns:core="http://www.i2.com/core"
             xmlns:xcore="http://www.i2.com/xcore"
             xmlns:xcore-db="http://www.i2.com/xcore-db"
             xmlns:xapl="http://www.i2.com/xapl"
             xmlns:web="http://www.i2.com/web"
             xmlns:docutil="http://www.i2.com/docutil"
             xmlns:util="http://www.i2.com/util"
             xmlns:xudl="http://www.i2.com/xudl"
             xmlns:cfg="http://www.i2.com/configurability"
             xmlns:perm="http://www.i2.com/permissibility"
             xmlns:omx="http://www.i2.com/omx"
             xmlns:identity="http://www.i2.com/identity" description="_">


  <!-- ********************************************************************** 
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="getFormConfig">

    <xapl:return>

      <!-- Search Fields -->
      <FORM DataSourceName="BPE_UIService//FAVORITE" DataSourceType="Document" Name="search_form"  Method="GET" Target="appFrame">
        <FIELD Type="Text" DisplayText="Name" Name="SAVED_SEARCH_NAME" Value="{$this/SAVED_SEARCH_NAME/@Value}" Visibility="Simple"/>
        <FIELD Type="Select" DisplayText="Doc Type" Name="SAVED_DOC_TYPE" Value="{$this/SAVED_DOC_TYPE/@Value}" Visibility="Simple" DataSourceType="Command" DataSourceName="core.search.controller:getDocTypes"/>
        <!-- Always Put hidden at the end -->
        <x2:execute command="core.search.view:getHiddenFields">
          <x2:with-param name="this" select="$this"/>
        </x2:execute>
        <!-- Form Buttons -->
        <BUTTONS>
          <BUTTON Name="search" DisplayText="Search" OnClick="javascript:onSearch()" Emphasized="yes"/>
        </BUTTONS>
      </FORM>
    </xapl:return>

  </x2:command>


  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportConfig">

    <xapl:return>

      <REPORT Selectable="All" Id="NAME">
        <!--HELP Url="../help/search_res.htm"/-->
        <FIELDS>
          <FIELD Name="NAME" DisplayText="Name" Sortable="yes" Url="{$pages:core_search_select_saved_search_view}" UrlParam="All"/>
          <FIELD Name="DOC_TYPE" Sortable="yes" DisplayText="Doc Type"/>
          <!-- Hidden Fields -->
          <FIELD Name="NAME" Type="Hidden" DisplayType="Hidden"/>
          <FIELD Name="DOC_TYPE" Type="Hidden" DisplayType="Hidden"/>
          <x2:execute command="core.report.view:getHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
          
        </FIELDS>
        
            <BUTTONS>
              <BUTTON
                      Id="delete_button"
                      DisableOnClick="true"
                      DisplayText="Delete"
                      OnClick="javascript:onDelete()"
                      Disabled="report"/>
            </BUTTONS>
        <PAGINATION/>
        
      </REPORT>
    </xapl:return>
  </x2:command>

  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportData">
    <x2:param name="pForm"/>
    <x2:param name="this"/>

    <xapl:variable name="userId">
      <identity:get-user-id/>
    </xapl:variable>

    <xapl:variable name="data1">
        <xapl:choose>
          <xapl:when test="{($pForm/FIELD[@Name = 'DO_SEARCH']/@Value = 'Yes' ) and count($pForm/FIELD[@Type !='Hidden' and (string-length(@Value) > 0  or string-length(@Value1) >0 or string-length(@Value2) > 0)]) > 0}">
            <xcore:get-document name="//BPE_UIService/FAVORITE" ReturnRowCount="{$this/RETURN_ROW_COUNT/@Value}" StartAtRow="{$pForm/FIELD[@Name = 'START_COUNT']/@Value}" MaxRows="{$pForm/FIELD[@Name = 'MAX_ROWS']/@Value}" entireResponse="true">
              <USER_ID Value="{$userId}"/>
              <xcore:search-by property="NAME" value="{$pForm/FIELD[@Name = 'SAVED_SEARCH_NAME']/@Value}"/>
              <xcore:search-by property="NAME" value="I2_CORE_RECENT" matchby="NOT_EQUAL"/>
              <xcore:search-by property="DOC_TYPE" value="{$pForm/FIELD[@Name = 'SAVED_DOC_TYPE']/@Value}"/>
            </xcore:get-document>
          </xapl:when>
        </xapl:choose>
    </xapl:variable>


    <!--  Make data similar to execute-method-->
    <xapl:variable name="data">
      <SAVED_SEARCHES>
      <xapl:value-of select="$data1/RESPONSE/*"/>
      </SAVED_SEARCHES>
    </xapl:variable>

    <docutil:set select="$data/@TotalRowCount">
      <xapl:value-of select="$data1/RESPONSE/@TotalRowCount"/>
    </docutil:set>
    <!--  Make data similar to execute-method-->
    
    <xapl:return>
      <xapl:value-of select="{$data}"/>
    </xapl:return>

  </x2:command>

<!-- ********************************************************************** 
     *********************************************************************** -->

</x2:commands>