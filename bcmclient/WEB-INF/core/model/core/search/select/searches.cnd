<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:identity="http://www.i2.com/identity" xmlns:i18n="http://www.i2.com/i18n" description="_">

  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">

    <xapl:variable name="favorites">
      <xcore:execute-method name="//BPE_UIService/getSavedSearches" StartAtRow="{$this/START_COUNT/@Value}" MaxRows="10" ReturnRowCount="yes">
        <xapl:variable name="userId"><identity:get-user-id/></xapl:variable>
        <FILTER Name="USER_ID">
          <USER_ID Value="{$userId}"/>
        </FILTER>
        <xapl:variable name="x" select="$this/NAME/@Value"/>
        <xapl:if test="string-length($x)>0">
          <FILTER Name="NAME">
            <xcore:search-by property="NAME" value="{$x}"/>
          </FILTER>
        </xapl:if>
        <xapl:set-variable name="x" select="$this/PAGE_NAME_SEARCH/@Value"/>
        <xapl:if test="string-length($x)>0">
          <x2:execute command="core.search.select.searches:getPageNameFilter">
            <x2:with-param name="category" select="$x"/>
          </x2:execute>
        </xapl:if>
        <xapl:set-variable name="x" select="$this/STATUS_SEARCH/@Value"/>
        <xapl:if test="string-length($x)>0">
          <FILTER Name="STATUS">
            <xapl:choose>
              <xapl:when test="$x='ACTIVE'">
                <OR>
                  <STATUS/>
                  <STATUS Value="ACTIVE"/>
                </OR>
              </xapl:when>
              <xapl:otherwise>
                <STATUS Value="INACTIVE"/>
              </xapl:otherwise>
            </xapl:choose>
          </FILTER>
        </xapl:if>
        <ORDER_BY>
          <SEQUENCE_NUMBER Sort="Ascending"/>
        </ORDER_BY>
      </xcore:execute-method>
    </xapl:variable>

    <xapl:for-each select="$favorites/FAVORITE" varName="favorite">
      <docutil:set select="$favorite">
        <PAGE_NAME Value="{$favorite/FAVORITE_PARAMS_LINK/FAVORITE_PARAMETERS[FIELD_NAME/@Value='PAGE_NAME']/FIELD_VALUE/@Value}"/>
        <xapl:if test="string-length($favorite/STATUS/@Value)=0">
          <STATUS Value="ACTIVE"/>
        </xapl:if>
      </docutil:set>
    </xapl:for-each>

		<x2:execute command="core.history:clear"/>
    <xapl:return>
      <!-- TODO This need to happen automatically -->
      <x2:execute command="core.history:register">
        <x2:with-param name="this" select="$this"/>
        <x2:with-param name="pPage" select="'core_select_searches'"/>
        <x2:with-param name="pPageName" select="'Manage Favorites'"/>
      </x2:execute>
      <xapl:value-of select="$favorites"/>
      <x2:execute command="core.search.select.searches:getCategories"/>
    </xapl:return>
  </x2:command>

  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="delete">

  <xapl:variable name="assignResult">
    <xcore:execute-method name="//BPE_UIService/deleteSavedSearches" entireResponse="true">
      <IDS>
        <xapl:value-of select="$this/ID"/>
      </IDS>
    </xcore:execute-method>
  </xapl:variable>
    
  <xapl:choose>
    <xapl:when test="$assignResult/RESPONSE/@Status='Error'">
			<xapl:variable name="msg">
				<xapl:choose>
					<xapl:when test="string-length($assignResult/RESPONSE/_RESULT/_ERROR/@Value) > 0">
						<xapl:value-of select="$assignResult/RESPONSE/_RESULT/_ERROR/@Value"/>
					</xapl:when>
					<xapl:otherwise>
						<xapl:value-of select="$assignResult/RESPONSE/@Description"/>
					</xapl:otherwise>
				</xapl:choose>
			</xapl:variable>
			<web:display-page>
				<web:get-page name="message_page">
					<MESSAGE Value="{$msg}"/>
					<TITLE Value="Saving Favotites Error"/>
					<RETURN Value="true"/>
					<CANCEL/>
				</web:get-page>
			</web:display-page>
    </xapl:when>
    <xapl:otherwise>
      <docutil:set select="$this">
        <NAVRELOAD Value="TRUE"/>
      </docutil:set>
      <web:display-page>
        <web:get-page name="core_select_searches">
          <SUCCESS_MESSAGE Value="Deleted Successfully"/>
          <xapl:value-of select="$this/*"/>
        </web:get-page>
      </web:display-page>
    </xapl:otherwise>
  </xapl:choose>

  </x2:command>
  

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="activate">

    <xapl:variable name="assignResult">
      <xcore:execute-method name="//BPE_UIService/setSavedSearchStatus" entireResponse="true">
        <STATUS Value="ACTIVE"/>
        <IDS>
          <xapl:value-of select="$this/ID"/>
        </IDS>
      </xcore:execute-method>
    </xapl:variable>
    
    <xapl:choose>
      <xapl:when test="$assignResult/RESPONSE/@Status='Error'">
				<xapl:variable name="msg">
					<xapl:choose>
						<xapl:when test="string-length($assignResult/RESPONSE/_RESULT/_ERROR/@Value) > 0">
							<xapl:value-of select="$assignResult/RESPONSE/_RESULT/_ERROR/@Value"/>
						</xapl:when>
						<xapl:otherwise>
							<xapl:value-of select="$assignResult/RESPONSE/@Description"/>
						</xapl:otherwise>
					</xapl:choose>
				</xapl:variable>
				<web:display-page>
					<web:get-page name="message_page">
						<MESSAGE Value="{$msg}"/>
						<TITLE Value="Saving Favotites Error"/>
						<RETURN Value="true"/>
						<CANCEL/>
					</web:get-page>
				</web:display-page>
      </xapl:when>
     <xapl:otherwise>
       <web:display-page>
        <web:get-page name="core_select_searches">
          <SUCCESS_MESSAGE Value="Activated Successfully"/>
          <xapl:value-of select="$this/*"/>
        </web:get-page>
       </web:display-page>
     </xapl:otherwise>
   </xapl:choose>

  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="deactivate">

  <xapl:variable name="assignResult">
    <xcore:execute-method name="//BPE_UIService/setSavedSearchStatus" entireResponse="true">
      <STATUS Value="INACTIVE"/>
      <IDS>
        <xapl:value-of select="$this/ID"/>
      </IDS>
    </xcore:execute-method>
  </xapl:variable>
    
  <xapl:choose>
    <xapl:when test="$assignResult/RESPONSE/@Status='Error'">
			<xapl:variable name="msg">
				<xapl:choose>
					<xapl:when test="string-length($assignResult/RESPONSE/_RESULT/_ERROR/@Value) > 0">
						<xapl:value-of select="$assignResult/RESPONSE/_RESULT/_ERROR/@Value"/>
					</xapl:when>
					<xapl:otherwise>
						<xapl:value-of select="$assignResult/RESPONSE/@Description"/>
					</xapl:otherwise>
				</xapl:choose>
			</xapl:variable>
			<web:display-page>
				<web:get-page name="message_page">
					<MESSAGE Value="{$msg}"/>
					<TITLE Value="Saving Favotites Error"/>
					<RETURN Value="true"/>
					<CANCEL/>
				</web:get-page>
			</web:display-page>
    </xapl:when>
    <xapl:otherwise>
      <docutil:set select="$this">
        <NAVRELOAD Value="TRUE"/>
      </docutil:set>
      <web:display-page>
        <web:get-page name="core_select_searches">
          <SUCCESS_MESSAGE Value="Deactivated Successfully"/>
          <xapl:value-of select="$this/*"/>
        </web:get-page>
       </web:display-page>
     </xapl:otherwise>
  </xapl:choose>

  </x2:command>

  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getCategories">

    <xapl:return>
      <FAVORITE_CATEGORIES>
      	<OPTION Id="Favorites"/>
      </FAVORITE_CATEGORIES>
    </xapl:return>
  </x2:command>

  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getCategory">
    <x2:param name="page"/>
    <x2:param name="categories"/>

    <xapl:variable name="cats" select="$categories"/>
    <xapl:if test="not($cats)">
      <xapl:set-variable name="cats">
        <x2:execute command="core.search.select.searches:getCategories"/>
      </xapl:set-variable>
    </xapl:if>
    
    <xapl:variable name="catName"/>
    <xapl:for-each select="$cats/OPTION" varName="category">
    	<xapl:variable name="pageNames">
    		<PAGE_NAMES>
    			<x2:execute command="core.search.select.searches:getPageNameFilter">
    				<x2:with-param name="category" select="$category/@Id"/>
    			</x2:execute>
    		</PAGE_NAMES>
    	</xapl:variable>
    	<xapl:if test="count($pageNames/FILTER/OR/PAGE_NAME[@Value = $page]) &gt; 0">
	    	<xapl:set-variable name="catName" select="$category"/> 
    	</xapl:if>
    </xapl:for-each>
    
    <xapl:if test="string-length($catName/@Id) = 0">
     <xapl:set-variable name="catName" select="$cats/OPTION[@Id='Favorites']"/>
    </xapl:if>
    
    <xapl:return>
      <xapl:value-of select="$catName"/>
    </xapl:return>
  </x2:command>

  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getPageNameFilter">
    <x2:param name="category"/>

    <xapl:return>
      <FILTER Name="PAGE_NAME"/>
    </xapl:return>
  </x2:command>

  <!-- ********************************************************************** 
  *********************************************************************** -->
</x2:commands>
