<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:oa="http://www.i2.com/oa" xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">

  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="init">
    <xapl:variable name="sSearchCriteria" resolver="session" global="true"/>
    <web:define-page name="start_xcore_workflow" url="/start.x2ps"/>
  </x2:command>


  <!-- ********************************************************************** 
       *********************************************************************** -->
  <x2:command public="yes" description="_" name="display">
    <x2:param name="pPage"/>
    <x2:param name="pFilters"/>
    <x2:param name="pName"/>
    <x2:param name="pId"/>

    <xapl:choose>
      <!-- If SYS_ID exists, then its studio page -->
      <xapl:when test="count($pFilters/SYS_ID) > 0">
        <!-- PAGE_NAME - serviceName.workflowName.pglName -->
        <xapl:variable name="serviceName" select="substring-before($pPage, '.')"/>
        <xapl:variable name="serviceStrLen" select="string-length($serviceName)"/>
        <xapl:variable name="wfPglStr" select="substring($pPage, $serviceStrLen + 2)"/>
        <xapl:variable name="wfName" select="substring-before($wfPglStr, '.')"/>
        
        <xapl:variable name="activityHeader">
          <util:map-execute map="ACTIVITY_HEADER" key="{$sSelectedActivity}"/>
        </xapl:variable>      

         <!-- Display Page -->
        <web:display-page>
          <web:get-page name="start_xcore_workflow">
            <SERVICE_NAME Value="{$serviceName}"/>
            <START_WORKFLOW Value="{$wfName}"/>
            <SOLUTION_NAME Value="{$activityHeader/APP_NAME/@Value}"/>
            <SOLUTION_URL Value="{$activityHeader/HOME/@Value}"/>
            <xapl:value-of select="{$pFilters/*}"/>
            <xapl:if test="{string-length($pName) !=0}">
              <SAVED_SEARCH_NAME Value="{$pName}"/>
            </xapl:if>
            <xapl:if test="{string-length($pId) !=0}">
              <SAVED_SEARCH_ID Value="{$pId}"/>
            </xapl:if>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:otherwise>
       <!-- Display Page -->
        <web:display-page>
          <web:get-page name="{$pPage}">
            <xapl:value-of select="{$pFilters/*}"/>
            <xapl:if test="{string-length($pName) !=0}">
              <SAVED_SEARCH_NAME Value="{$pName}"/>
            </xapl:if>
            <xapl:if test="{string-length($pId) !=0}">
              <SAVED_SEARCH_ID Value="{$pId}"/>
            </xapl:if>
          </web:get-page>
        </web:display-page>
      </xapl:otherwise>
    </xapl:choose>
    
  </x2:command>
  
  
  <!-- ********************************************************************** 
 *********************************************************************** -->
  <x2:command public="yes" description="_" name="displayCurrent">
    <x2:param name="pFilters" select="$sSearchCriteria"/>

    <!-- Construct the Search Parameters -->
    <xapl:variable name="params">
      <PARAMETERS>
        <xapl:for-each varName="field" select="{$pFilters/FIELDS/FIELD}">
          <docutil:element name="{$field/FIELD_NAME/@Value}" Value="{$field/FIELD_VALUE/@Value}"/>
        </xapl:for-each>
      </PARAMETERS>
    </xapl:variable>

    <!-- Display the Page -->
    <x2:execute command="core.search.controller:display">
      <x2:with-param name="pFilters" select="{$params}"/>
      <x2:with-param name="pPage" select="{$params/PAGE/@Value}"/>
    </x2:execute>

  </x2:command>

  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="view">
    <x2:param name="pId" select="$this/ID[1]/@Value"/>
    <x2:param name="pName" select="$this/NAME[1]/@Value"/>

    <!-- First get the custom report -->
    <xapl:variable name="responses">
      <xcore:execute-method name="//BPE_UIService/getSavedSearch" entireResponse="true">
        <ID Value="{$pId}"/>
        <NAME Value="{$pName}"/>
      </xcore:execute-method>
    </xapl:variable>

    <!-- If error give message -->
    <xapl:if test="{$responses/@Status = 'Error'}">
      <web:display-page>
        <web:get-page name="message_page">
          <MESSAGE Value="{$responses/RESPONSE/_RESULT/_ERROR/@Value}"/>
          <TITLE Value="Retrieving Saved Search Error"/>
          <RETURN Value="true"/>
          <CANCEL/>
        </web:get-page>
      </web:display-page>
    </xapl:if>

   <xapl:for-each select="$responses/RESPONSE/FAVORITE/VARIABLES/VARIABLE" varName="var">
      <xapl:set-variable name="{$var/NAME/@Value}">
        <xapl:value-of select="$var/VARIABLE_VALUE/*"/>
      </xapl:set-variable>
    </xapl:for-each>
        
    <!-- Unwrap the result into page parameters -->
    <xapl:variable name="param">
      <PARAMETERS>
        <xapl:for-each varName="field" select="{$responses/RESPONSE/FAVORITE/FAVORITE_PARAMS_LINK/FAVORITE_PARAMETERS}">
          <docutil:element name="{$field/FIELD_NAME/@Value}" Value="{$field/FIELD_VALUE/@Value}"/>
        </xapl:for-each>
        <DOC_TYPE Value="{$responses/RESPONSE/FAVORITE/DOC_TYPE/@Value}"/>
      </PARAMETERS>
    </xapl:variable>

    <!-- Display search page with the parameters -->
    <x2:execute command="core.search.controller:display">
      <x2:with-param name="pFilters" select="{$param}"/>
      <x2:with-param name="pPage" select="{$param/PAGE/@Value}"/>
      <x2:with-param name="pName" select="{$responses/RESPONSE/FAVORITE/NAME/@Value}"/>
      <x2:with-param name="pId" select="{$responses/RESPONSE/FAVORITE/ID/@Value}"/>
    </x2:execute>

  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="saveInSession">
    <x2:param name="this" select="$this"/>
    <docutil:set select="$this">
      <DO_SEARCH Value="Yes"/>
    </docutil:set>

    <xapl:variable name="docType" select="$this/OBJECT_TYPE[1]/@Value"/>
    <xapl:if test="string-length($docType)=0">
      <xapl:set-variable name="docType" select="'SAVED_SEARCH_DOC'"/>
    </xapl:if>
  
    <xapl:set-variable name="sSearchCriteria">
      <ROOT>
        <xapl:if test="{string-length($this/SAVED_SEARCH_NAME/@Value) != 0}">
          <SAVED_SEARCH_NAME Value="{$this/SAVED_SEARCH_NAME[1]/@Value}"/>
        </xapl:if>
        <xapl:if test="{string-length($this/SAVED_SEARCH_ID/@Value) != 0}">
          <SAVED_SEARCH_ID Value="{$this/SAVED_SEARCH_ID[1]/@Value}"/>
        </xapl:if>
        <SAVED_DOC_TYPE Value="{$docType}"/>
        <FIELDS>
          <xapl:for-each varName="param" select="{$this/*[name() != 'SAVED_SEARCH_NAME' and name() != 'SAVED_SEARCH_ID'  and name() != 'SAVED_DOC_TYPE']}">
            <xapl:if test="{string-length($param/@Value) !=0}">
              <xapl:if test="{name($param) != 'DOC_TYPE'}">
                <xapl:variable name="fieldName">
                  <xapl:value-of select="{name($param)}"/>
                </xapl:variable>
                <FIELD>
                  <FIELD_NAME Value="{$fieldName}"/>
                  <FIELD_VALUE Value="{$param/@Value}"/>
                </FIELD>
              </xapl:if>
            </xapl:if>
          </xapl:for-each>
        </FIELDS>
        <RETURN_ADDR Value="{$this/RETURN_ADDR/@Value}"/>
      </ROOT>
    </xapl:set-variable>

    <xapl:choose>
      <!-- If in create mode. Ask for the search name  -->
      <xapl:when test="$this/NEW_SEARCH/@Value = 'true' or string-length($this/SAVED_SEARCH_NAME/@Value) = 0">
        <web:display-page>
          <web:get-page name="core_search_select_name"/>
        </web:display-page>
      </xapl:when>
      <!-- If in update mode. -->
      <xapl:otherwise>
        <x2:execute command="core.search.controller:update">
          <x2:with-param name="pFilters" select="$sSearchCriteria"/>
        </x2:execute>
      </xapl:otherwise>
    </xapl:choose>
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="save">
    <x2:param name="pName" select="$this/SAVED_SEARCH_NAME/@Value"/>
    <x2:param name="pFilters" select="$sSearchCriteria"/>
    <x2:param name="pDocType" select="$pFilters/SAVED_DOC_TYPE/@Value"/>

    <xapl:variable name="responses">
      <xcore:execute-method name="//BPE_UIService/addSavedSearch" entireResponse="true">
        <NAME Value="{$pName}"/>
        <DOC_TYPE Value="{$pDocType}"/>
        <xapl:value-of select="{$pFilters/*}"/>
      </xcore:execute-method>
    </xapl:variable>

    <xapl:if test="{count($responses/RESPONSE/_RESULT/_ERROR) > 0 or $responses/@Status = 'ERROR' or $responses/@Status = 'Error'}">

      <xapl:variable name="msg">
        <xapl:choose>
          <xapl:when test="string-length($responses/RESPONSE/_RESULT/_ERROR/@Value) > 0">
            <xapl:value-of select="$responses/RESPONSE/_RESULT/_ERROR/@Value"/>
          </xapl:when>
          <xapl:otherwise>
            <xapl:value-of select="$responses/RESPONSE/@Description"/>
          </xapl:otherwise>
        </xapl:choose>
      </xapl:variable>
      <web:display-page>
        <web:get-page name="message_page">
          <MESSAGE Value="{$msg}"/>
          <TITLE Value="Saving Search Error"/>
          <RETURN Value="true"/>
          <CANCEL/>
        </web:get-page>
      </web:display-page>
    </xapl:if>

    <xapl:variable name="id" select="$responses/RESPONSE/ID/@Value"/>
    <xapl:variable name="userId"><identity:get-user-id/></xapl:variable>

    <xapl:variable name="page" select="$pFilters/FIELDS/FIELD[FIELD_NAME/@Value='PAGE_NAME']/FIELD_VALUE/@Value"/>
    <xapl:variable name="category">
      <x2:execute command="core.search.select.searches:getCategory">
        <x2:with-param name="page" select="$page"/>
      </x2:execute>
    </xapl:variable>

    <xapl:set-variable name="responses">
      <xcore:execute-method name="//BPE_UIService/setSavedSearchVisible">
        <USER_ID Value="{$userId}"/>
        <x2:execute command="core.search.select.searches:getPageNameFilter">
          <x2:with-param name="category" select="$category"/>
        </x2:execute>
        <ID Value="{$id}"/>
      </xcore:execute-method>
    </xapl:set-variable>

    <xapl:variable name="idLink">
      <web:get-page name="core_search_view">
        <ID Value="{$id}"/>
        <NAME Value="{$pName}"/>
      </web:get-page>
    </xapl:variable>

    <omx:touch userId="{$userId}">
      <SAVED_SEARCH id="{$pName}"/>
    </omx:touch>

    <web:display-page>
      <web:get-page name="core_refresh_navframe">
        <REDIRECT_COMMAND Value="{$idLink}"/>
        <RETURN_ADDR Value="{$sSearchCriteria/RETURN_ADDR/@Value}"/>
      </web:get-page>
    </web:display-page>
  </x2:command>

  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="update">
    <x2:param name="pFilters"/>

    <!-- API CAll -->
    <xapl:variable name="responses">
      <xcore:execute-method name="//BPE_UIService/setSavedSearch" entireResponse="true">
        <NAME Value="{$pFilters/SAVED_SEARCH_NAME/@Value}"/>
        <DOC_TYPE Value="{$pFilters/SAVED_DOC_TYPE/@Value}"/>
        <xapl:value-of select="{$pFilters/*}"/>
      </xcore:execute-method>
    </xapl:variable>

    <!-- Error Message -->
    <xapl:if test="{count($responses/RESPONSE/_RESULT/_ERROR) > 0}">
      <web:display-page>
        <web:get-page name="message_page">
          <MESSAGE Value="{$responses/RESPONSE/_RESULT/_ERROR/@Value}"/>
          <TITLE Value="Updating Search Error"/>
          <RETURN Value="true"/>
          <CANCEL Value="true"/>
        </web:get-page>
      </web:display-page>
    </xapl:if>

    <!-- Success Message -->
    <xapl:variable name="docType">
      <xapl:value-of select="{$pFilters/SAVED_DOC_TYPE}"/>
    </xapl:variable>

    <xapl:variable name="idLink">
      <web:get-page name="core_search_view">
        <ID Value="{$pFilters/SAVED_SEARCH_ID/@Value}"/>
        <NAME Value="{$pFilters/SAVED_SEARCH_NAME/@Value}"/>
      </web:get-page>
    </xapl:variable>

    <web:display-page>
      <web:get-page name="message_page">
        <MESSAGE Value="Your Search Criteria has been successfully updated!"/>
        <TITLE Value="Confimation"/>
        <OK Value="true"/>
        <ID Value="{$pFilters/SAVED_SEARCH_ID/@Value}"/>
        <ID_LINK Value="{$idLink}"/>
        <DOC_TYPE Value="SAVED_SEARCH"/>
      </web:get-page>
    </web:display-page>

  </x2:command>

  
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getDocTypes">
    <xapl:return>
      <DOC_TYPES>
        <perm:is-allowed document="SEARCH" action="goods_receipt">
          <DOC_TYPE>
            <VALUE_ID Value="RECEIPT"/>
            <DESCRIPTION Value="Receipts"/>
          </DOC_TYPE>
        </perm:is-allowed>
        <perm:is-allowed document="SEARCH" action="invoice_line_items">
          <DOC_TYPE>
            <VALUE_ID Value="INVOICE_LINE_ITEM"/>
            <DESCRIPTION Value="Invoice Line Items"/>
          </DOC_TYPE>
        </perm:is-allowed>
        <perm:is-allowed document="SEARCH" action="search_consumption_plans">
