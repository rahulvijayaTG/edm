<?xml version="1.0" encoding="UTF-8"?>
<ui:page-group xmlns:ui="http://www.i2.com/ui" displayText="Organize Favorites" source="core.search.organize.searches:load">
  <ui:container id="container" displayText="Organize Favorites" scrollable="true">
    <ui:step id="organize" displayCondition="{$root/FAVORITES_COUNT/@Value>0}">
      <ui:validation anyFieldIsRequired="false" successMessage="{$this/SUCCESS_MESSAGE/@Value}"/>
      <ui:field-group columns="5" select="$root">
        <ui:hidden-field name="NAVRELOAD" value="{$this/NAVRELOAD/@Value}"/>
        <ui:dropdown name="CATEGORY" displayText="Category" optionSrc="FAVORITE_CATEGORIES/*" onChange="javascript:onChange( )" selectOne="true"/>
      </ui:field-group>
      <ui:grid id="one" width="100%">
        <ui:row>
          <ui:cell width="5%" valign="top" align="left">
            <ui:container>
              <ui:step id="step_active" displayText="Active Favorites">
                <ui:field-group>
                  <ui:dropdown size="20" name="ACTIVE" optionSrc="$root/ACTIVE_SEARCHES/*" id="active" onChange="javascript:selectActive( );"/>
                </ui:field-group>
              </ui:step>
            </ui:container>
          </ui:cell>
          <ui:cell width="5%">
            <ui:grid>
              <ui:row>
                <ui:cell>
                  <ui:field-group>
                    <ui:button displayText=">>" id="add_all" enabledBySelections="true" onClick="javascript:addAll( )"/>
                  </ui:field-group>
                </ui:cell>
              </ui:row>
              <ui:row>
                <ui:cell>
                  <ui:field-group>
                    <ui:button displayText=">" id="add_selected" enabledBySelections="true" onClick="javascript:addSelected( )"/>
                  </ui:field-group>
                </ui:cell>
              </ui:row>
              <ui:row>
                <ui:cell>
                  <ui:field-group>
                    <ui:button displayText="&lt;" id="remove_selected" enabledBySelections="true" onClick="javascript:removeSelected( )"/>
                  </ui:field-group>
                </ui:cell>
              </ui:row>
              <ui:row>
                <ui:cell>
                  <ui:field-group>
                    <ui:button displayText="&lt;&lt;" id="remove_all" enabledBySelections="true" onClick="javascript:removeAll( )"/>
                  </ui:field-group>
                </ui:cell>
              </ui:row>
            </ui:grid>
          </ui:cell>
          <ui:cell width="5%" valign="top" align="left">
            <ui:container>
              <ui:step id="step_visible" displayText="Visible Favorites">
                <ui:field-group>
                  <ui:dropdown size="20" name="VISIBLE" optionSrc="$root/VISIBLE_SEARCHES/*" id="visible" onChange="javascript:selectVisible( );"/>
                </ui:field-group>
              </ui:step>
            </ui:container>
          </ui:cell>
          <ui:cell width="5%">
            <ui:grid>
              <ui:row>
                <ui:cell>
                  <ui:field-group>
                    <ui:button displayText="Up" id="up" enabledBySelections="true" onClick="javascript:moveUp( )"/>
                  </ui:field-group>
                </ui:cell>
              </ui:row>
              <ui:row>
                <ui:cell>
                  <ui:field-group>
                    <ui:button displayText="Down" id="down" enabledBySelections="true" onClick="javascript:moveDown( )"/>
                  </ui:field-group>
                </ui:cell>
              </ui:row>
            </ui:grid>
          </ui:cell>
          <ui:cell width="75%">
            <ui:field-group>
              <ui:display-field displayText="" name="DUMMY"/>
            </ui:field-group>
          </ui:cell>
        </ui:row>
      </ui:grid>
      <ui:buttons>
        <ui:button id="save" displayText="Save" submitTo="javascript:saveOrder( )"/>
      </ui:buttons>
      <ui:script>
        <![CDATA[
          var active = document.getElementById( 'ACTIVE' );
          var visible = document.getElementById( 'VISIBLE' );

          function onLoad( )
          {
            onLoadSuper( );
            toggleAll( );
            var x = document.getElementById( 'NAVRELOAD' );
            if( x.value == 'TRUE' ){
              parent.navFrame.history.go( 0 );
              x.value = 'FALSE';
            }
            scrollHelper( );
          }

          function onChange( )
          {
            form.action = "searches/onChange.x2c";
            form.submit( );
          }

          function emptyOption( )
          {
            return new Option( '                                             ', 0 );
          }

          function fixWidth( )
          {
            var x = active.options;
            x[ x.length ] = emptyOption( );
            x = visible.options;
            x[ x.length ] = emptyOption( );
            setTimeout( "deleteEmpty( )", 1 );
          }

          function deleteEmpty( )
          {
            var x = active.options;
            x.length = x.length - 1;
            x = visible.options;
            x.length = x.length - 1;
          }

          function copyAll( from, to )
          {
            var fl = from.length;
            var tl = to.length;
            for( var i = 0; i < fl; ++i ){
              var f = from[ i ];
              to[ tl ] = new Option( f.text, f.value );
              to[ tl++ ].selected = true;
            }
            from.length = 0;
          }

          function copySelected( from, to )
          {
            var fl = from.length;
            var tl = to.length;
            for( var i = 0; i < fl; ++i ){
              var f = from[ i ];
              if( f.selected ){
                to[ tl ] = new Option( f.text, f.value );
                to[ tl++ ].selected = true;
              }
            }
            deleteSelected( from );
          }

          function addAll( )
          {
            clearAll( active );
            clearAll( visible );
            copyAll( active.options, visible.options );
            toggleAll( );
          }

          function deleteSelected( x )
          {
            var l = x.length;
            while( --l >= 0 )
              if( x[ l ].selected )
                x[ l ] = null;
          }

          function addSelected( )
          {
            copySelected( active.options, visible.options );
            toggleAll( );
          }

          function removeSelected( )
          {
            copySelected( visible.options, active.options );
            toggleAll( );
          }

          function removeAll( )
          {
            clearAll( active );
            clearAll( visible );
            copyAll( visible.options, active.options );
            toggleAll( );
          }

          function clearAll( x )
          {
            x = x.options;
            var l = x.length;
            while( --l >= 0 )
              x[ l ].selected = false;
          }

          function toggleAll( )
          {
            var a = active.options;
            var v = visible.options;
            i2uiToggleButtonState( 'add_all','enabled' );
            var al = a.length;
            if( al == 0 )
              i2uiToggleButtonState( 'add_all','disabled' );
            i2uiToggleButtonState( 'add_selected','enabled' );
            if( al == 0 || anySelected( a ) == false )
              i2uiToggleButtonState( 'add_selected','disabled' );
            i2uiToggleButtonState( 'remove_all','enabled' );
            var vl = v.length;
            if( vl == 0 )
              i2uiToggleButtonState( 'remove_all','disabled' );
            i2uiToggleButtonState( 'remove_selected','enabled' );
            var x = vl == 0 || anySelected( v ) == false;
            if( x )
              i2uiToggleButtonState( 'remove_selected','disabled' );
            i2uiToggleButtonState( 'up','enabled' );
            if( x || v[ 0 ].selected )
              i2uiToggleButtonState( 'up','disabled' );
            i2uiToggleButtonState( 'down','enabled' );
            if( x || v[ v.length - 1 ].selected )
              i2uiToggleButtonState( 'down','disabled' );
            fixWidth( );
          }

          function anySelected( x )
          {
            var l = x.length;
            while( --l >= 0 )
              if( x[ l ].selected )
                return true;
            return false;
          }

          function selectActive( )
          {
            clearAll( visible );
            toggleAll( );
          }

          function selectVisible( )
          {
            clearAll( active );
            toggleAll( );
          }

          function moveUp( )
          {
            var v = visible.options;
            var l = v.length;
            var e = 0;
            var t = null;
            for( var i = 0; i <= l; ++i ){
              var x = i < l ? v[ i ] : null;
              if( x && x.selected ){
                var p = i - 1;
                v[ p ] = new Option( x.text, x.value );
                v[ p ].selected = true;
              }
              else{
                if( t && e < i )
                  v[ i - 1 ] = new Option( t.text, t.value );
                t = x;
                e = i + 1;
              }
            }
            toggleAll( );
          }

          function moveDown( )
          {
            var v = visible.options;
            var l = v.length;
            var e = 0;
            var t = null;
            while( l-- >= 0 ){
              var x = l < 0 ? null : v[ l ];
              if( x && x.selected ){
                var p = l + 1;
                v[ p ] = new Option( x.text, x.value );
                v[ p ].selected = true;
              }
              else{
                if( t && e > l )
                  v[ l + 1 ] = new Option( t.text, t.value );
                t = x;
                e = l - 1;
              }
            }
            toggleAll( );
          }

          function selectAll( x )
          {
            var l = x.length;
            while( --l >= 0 )
              x[ l ].selected = true;
          }

          function saveOrder( )
          {
            selectAll( active.options );
            selectAll( visible.options );
            var x = document.getElementById( 'NAVRELOAD' );
            x.value = 'TRUE';
            form.action = "searches/save.x2c";
            form.submit( );
          }
        ]]>
      </ui:script>
    </ui:step>
    <ui:step id="no_searches" displayCondition="{$root/FAVORITES_COUNT/@Value = '0' or string-length($root/FAVORITES_COUNT/@Value) = 0}">
      <ui:field-group columns="5" select="$root">
        <ui:dropdown name="CATEGORY" displayText="Category" optionSrc="FAVORITE_CATEGORIES/*" onChange="javascript:onChange( )" selectOne="true"/>
      </ui:field-group>
      <ui:field-group>
        <ui:display-field value="No Active Favorites"/>
      </ui:field-group>
      <ui:script>
        <![CDATA[
          function onChange( )
          {
            form.action = "searches/onChange.x2c";
            form.submit( );
          }
        ]]>
      </ui:script>
    </ui:step>
  </ui:container>
</ui:page-group>
