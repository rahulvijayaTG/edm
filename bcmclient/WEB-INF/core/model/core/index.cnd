    <xapl:return>
      <HEADER>
				<APP_NAME Value="Solution Name"/>
				<HOME Value="core/home.jsp"/>
				<xapl:value-of select="$pPageHeaderInfo/*"/>
      </HEADER>		
    </xapl:return>
