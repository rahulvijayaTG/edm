<ui:page-group xmlns:ui="http://www.i2.com/ui" name="studio.templates.simple_entry" source="studio.controller:load">
  
  
  <ui:container id="container">
    
    
    <ui:step id="top_container" displayText="Manage Mapping " select="$root">
      
      
      <!-- ************** -->
      
      
      <!-- needed by studio -->
      
      
      <ui:field-group select="$root">
        
        
        <ui:hidden-field name="EV_NAME" />
        
        
        <ui:hidden-field name="EV_KEY" />
        
        
        <ui:hidden-field name="CURRENT_USER_ID" value="{identity-user-id()}" />
        
        
        <ui:hidden-field name="SelectedMember" value="" id="SelectedMember" />
        
        <ui:hidden-field name="MAX_Rows" />
        
      
      </ui:field-group>
      
      
      <!-- needed by studio -->
      
      
      <!-- ************** -->
      
      
      <ui:container id="innerContainer">
        
        <ui:help displayPage="{$pages:Manage_mapset_definition_help}" />
        <ui:step displayText="Search Members" id="searchContainer">
          
          
          <ui:field-group columns="2" id="fieldGroups">
            
            
            <ui:field-group id="leftFields">
              
              
              <ui:entry-field id="Dimension" displayText="Dimension Name" name="Dimension" value="{$root/DIMENSION/@Value}" editable="false" />
              
              
              <ui:entry-field id="Level" displayText="Level Name" name="Level" value="{$root/LEVEL/@Value}" editable="false" />
              
            
            </ui:field-group>
            
            
            <ui:field-group id="RightFields">
              
              
              <ui:dropdown displayText="Using" id="Using" name="Using" optionSrc="$root/USING/*" />
              
              
              <ui:dropdown displayText="Condition" id="Condition" name="Condition" optionSrc="$root/CONDITION/*" />
              
              
              <ui:entry-field displayText="Search String" id="SearchString" name="SearchString" />
              
            
            </ui:field-group>
            
          
          </ui:field-group>
          
          
          <ui:buttons id="searchButtons">
            
            
            <ui:button displayText="Show Members" id="SEARCH" name="SEARCH" />
            
          
          </ui:buttons>
          
        
        </ui:step>
        
      
      </ui:container>
      
      
      <ui:table id="bottomTable" displayText="Member List" select="MEMBERS" collapsable="true" selectable="Single" scrollable="true" displayTextNoRecords="No Members Found" postRowIdAs="Id" rowId="Id" maxRows="$root/MAX_Rows/@Value">
        
        
        <ui:help id="bottomTableHelp" />
        
        
        <ui:field-group id="tableColumns">
          
          
          <ui:display-field name="Name" displayText="Name" id="Name" />
          
          
          <ui:display-field name="Description" displayText="Description" id="Description" />
          
        
        </ui:field-group>
        
        
        <ui:buttons id="tableButtons">
          
          
          <ui:button displayText="Cancel" id="CANCEL" name="CANCEL" />
          
          
          <ui:button displayText="Ok" id="SUBMIT" name="SUBMIT" enabledBySelections="true" />
          
        
        </ui:buttons>
        
      
      </ui:table>
      
    
    </ui:step>
    
  
  </ui:container>
  
  
  <ui:script>

   var selectedMember = null ;   
   function i2uiRowSelectionCallback (tableID)
   {
        if (tableID == null)
                return ;
        
        else if(tableID == 'bottomTable')
	{
	 try
         {	hasNoSelections = (i2uiGetSelectedRowNums(tableID).length == 0);
         	if (hasNoSelections == true)
         	{
                        i2uiToggleButtonState('SUBMIT','disabled');
                }
                else
                {
                	i2uiToggleButtonState('CANCEL','enabled','Regular');	
			i2uiToggleButtonState('SUBMIT','enabled','Regular');	                    
			selectedMemberTable = tableID + "_data" ;
			var tableobj = document.getElementById(selectedMemberTable);
			if (tableobj != null)
			{
			    var checkboxes;

			    // IE has a document object per element
			    if(tableobj.document)
				checkboxes = tableobj.document.getElementsByTagName("INPUT");
			    else
				checkboxes = document.getElementsByTagName("INPUT");

			    if (checkboxes != null)
			    {
				var len = checkboxes.length;
				for(var i=0; i &lt; len; i++)
				{
				    var id = tableID + "_rowselector" ;
				    if (checkboxes[i].id == id)
				    {
					if (checkboxes[i].checked)
					{
					    populateSelectedMember(checkboxes [i]) ;
					}
				    }
				}    
			    }
			}
		}
	 }catch(e){}
	}
   }
   
   function setMemberData (index, data)
   {
        if (data != null) 
        {
            if (selectedMember == null)
            {
                selectedMember = new Member () ;
            }
            
            if (index == 0)
            {
                selectedMember.id = data ;
            }
            else if (index == 1)
            {
                selectedMember.name = data ;
            }
            else if (index == 2)
            {
                selectedMember.description = data ;
            }
        }
   }
   
   function Member ()
   {
      this.id   = "" ;  
      this.name = "" ;
      this.description = "" ;
   }
   
   function populateSelectedMember (selectedCheckbox)
   {
        if (selectedCheckbox == null)
            return ; 
        
        var rowObj = selectedCheckbox ;
        if(rowObj.parentElement) 
            rowObj = rowObj.parentElement.parentElement ;
        else    
            rowObj = rowObj.parentNode.parentNode ;

        if (selectedMember == null)    
            selectedMember = new Member () ;
        var cellsCount = rowObj.cells.length ;
        for (var i = 0; i &lt; cellsCount; i++)
        {
            if (rowObj.cells[i].tagName == 'TD')
            {
                if (rowObj.cells[i].innerText != null)
                {
                    setMemberData (i, rowObj.cells[i].innerText) ;
                }
            }
        }
        document.form.SelectedMember.value = selectedMember.name ;
   }
   
	
   </ui:script>
  

</ui:page-group>

