<ui:page-group xmlns:ui="http://www.i2.com/ui" name="studio.templates.simple_entry" source="studio.controller:load">
  <ui:container>
    <ui:help displayPage="{$pages:Manage_member_details_help}" />
    <ui:step id="outerStep" displayText="Merge Members">
      <ui:container id="container1" collapsable="true">
        <ui:step id="containerstep1" displayText="Search Members" select="$root">
          <!-- ************** -->
          <!-- needed by studio -->
          <ui:field-group select="$root">
            <ui:hidden-field name="EV_NAME" />
            <ui:hidden-field name="EV_KEY" />
            <ui:hidden-field name="CURRENT_USER_ID" value="{identity-user-id()}" />
            <ui:hidden-field name="MAX_Rows" />
            <ui:hidden-field name="iserror" id="iserror" value="{$root/Error/Error/@Value}" />
            <ui:hidden-field name="mergeToMemberID" />
            <ui:hidden-field name="mergeToMemberName" />
          </ui:field-group>
          <!-- needed by studio -->
          <!-- ************** -->
          <ui:grid>
            <ui:row>
              <ui:cell width="20%">
                <ui:field-group>
                  <ui:display-field align="left" name="dimension_name" id="dimension_name" displayText="Dimension" />
                </ui:field-group>
              </ui:cell>
              <ui:cell width="20%">
                <ui:field-group>
                  <ui:entry-field size="15" align="left" name="dimension_value" displayText="" editable="false" dataType="String" maxlength="13" id="dimension_value" />
                </ui:field-group>
              </ui:cell>
              <ui:cell width="10%">
                <ui:field-group>
                  <ui:display-field displayText="" id="__dummy" name="__dummy" />
                </ui:field-group>
              </ui:cell>
              <ui:cell width="20%">
                <ui:field-group>
                  <ui:display-field align="left" name="using2" displayText="Using" id="using2" />
                </ui:field-group>
              </ui:cell>
              <ui:cell width="20%">
                <ui:field-group>
                  <ui:dropdown align="left" id="test" name="test" displayText="">
                    <ui:option id="1" value="NAME" />
                    <ui:option id="2" value="DESCRIPTION" />
                  </ui:dropdown>
                </ui:field-group>
              </ui:cell>
              <ui:cell width="20%">
                <ui:field-group>
                  <ui:display-field displayText="" id="__dummy" name="__dummy" />
                </ui:field-group>
              </ui:cell>
            </ui:row>
            <ui:row>
              <ui:cell width="20%">
                <ui:field-group>
                  <ui:display-field align="left" name="member_level" displayText="Member Level" id="member_level" />
                </ui:field-group>
              </ui:cell>
              <ui:cell width="20%">
                <ui:field-group>
                  <ui:entry-field size="15" align="left" name="member_level_value" displayText="" dataType="String" editable="false" id="member_level_value" />
                </ui:field-group>
              </ui:cell>
              <ui:cell width="10%">
                <ui:field-group>
                  <ui:display-field displayText="" id="__dummy" name="__dummy" />
                </ui:field-group>
              </ui:cell>
              <ui:cell width="20%">
                <ui:field-group>
                  <ui:display-field align="left" name="condition1" displayText="Condition" id="condition1 " />
                </ui:field-group>
              </ui:cell>
              <ui:cell width="20%">
                <ui:field-group>
                  <ui:dropdown align="left" id="condition" name="condition" displayText="">
                    <ui:option id="CONTAINS" value="CONTAINS" />
                  </ui:dropdown>
                </ui:field-group>
              </ui:cell>
              <ui:cell width="20%">
                <ui:field-group>
                  <ui:display-field align="left" displayText="" id="__dummy" name="__dummy" />
                </ui:field-group>
              </ui:cell>
            </ui:row>
            <ui:row>
              <ui:cell width="20%">
                <ui:field-group>
                  <ui:display-field align="left" name="member_name" displayText="Member Name" id="member_name" />
                </ui:field-group>
              </ui:cell>
              <ui:cell width="20%">
                <ui:field-group>
                  <ui:entry-field size="15" align="left" name="member_name_value" id="member_name_value" displayText="" style="10" editable="false" />
                </ui:field-group>
              </ui:cell>
              <ui:cell width="10%">
                <ui:field-group>
                  <ui:display-field displayText="" id="__dummy" name="__dummy" />
                </ui:field-group>
              </ui:cell>
              <ui:cell width="20%">
                <ui:field-group>
                  <ui:display-field align="right" name="search_string" displayText="Search String" id="search_string" />
                </ui:field-group>
              </ui:cell>
              <ui:cell width="20%">
                <ui:field-group>
                  <ui:entry-field size="15" align="left" name="search_string_value" displayText="" style="10" id="search_string_value" />
                </ui:field-group>
              </ui:cell>
              <ui:cell width="20%">
                <ui:field-group>
                  <ui:display-field displayText="" id="__dummy" name="__dummy" />
                </ui:field-group>
              </ui:cell>
            </ui:row>
          </ui:grid>
          <ui:buttons>
            <ui:button displayText="Show Members" id="search" name="search" />
          </ui:buttons>
        </ui:step>
      </ui:container>
      <ui:container id="Container2">
        <ui:step id="containerstep2" displayText="Valid 'Merge-to' Members" select="$root" scrollable="true">
          <ui:table select="MEMBERMERGE" selectable="Single" scrollable="true" rowId="member_name_table" postRowIdAs="member_name_table" maxRows="$root/MAX_Rows/@Value" id="tab2">
            <ui:field-group>
              <ui:display-field displayText="Name" name="member_name_table" id="member_name_table" />
              <ui:hidden-field displayText="Id" name="member_id" id="member_id" />
              <ui:display-field displayText="Description" name="member_description" id="member_description" />
              <ui:display-field displayText="State" name="member_status" id="member_status" />
              <ui:display-field displayText="Has Child" name="has_child" id="has_child" />
            </ui:field-group>
            <ui:buttons>
              <ui:button displayText="Close" id="cancel" name="cancel" />
              <ui:button displayText="Save" id="save" name="save" enabledBySelections="true" />
            </ui:buttons>
          </ui:table>
        </ui:step>
      </ui:container>
    </ui:step>
  </ui:container>
  <ui:script>
    function onLoad()
       {
		

		
         onLoadSuper();
         scrollHelper();
		     switch (	document.form.iserror.value)
		  { 
		    case "3": 
		             alert(" Merge not possible at this level " );
		            break;
		    case "4": 
		             alert(" No valid parent members to merge to " );
		            break;		  	  
		  } 
  }
function on_save() {
		//alert("arun");
		//debugger;
		 var bIsValid = true; 
		 document.form.SUBMIT_AS_XML.value = 'false'; 
		 bIsValid = (isValid_tab2()); 
		 if (bIsValid == false)  validation_alert('result_form_table'); 
		 if ( bIsValid == true)
		 { 
		i2uiGetSelectedRowIds1('tab2');
		disableButtons(); 
		document.form.BUTTON_ID.value = 'save' ;
		 document.form.action = 'view.x2ps'; 
		 document.form.submit();
		  }  
		onResize();
		  return;
		 }
				
		function i2uiGetSelectedRowIds1(tableid)
{
		//debugger;
  var selected = new Array();

  // NS4 browser not supported
  if (document.layers != null)
    return selected;

  var tableobj = document.getElementById(tableid);
  if (tableobj != null)
  {
    var checkboxes;   
    // IE has a document object per element
    if(tableobj.document)
      checkboxes = tableobj.document.getElementsByTagName("INPUT");
    else
      checkboxes = document.getElementsByTagName("INPUT");

    if (checkboxes != null)
    {
      var len = checkboxes.length;
      var j = 0;
      for(var i=0; i&lt;len; i++)
      {
         if (checkboxes[i].id == tableid+"_rowselector")
        {       
		      j++;
          if (checkboxes[i].checked)
          {
    	   <!-- alert('amit');
		alert(checkboxes[i+1].value);
		alert(checkboxes[i+2].value);
		alert(checkboxes[i+3].value);-->
    document.form.mergeToMemberID.value =checkboxes[i+1].value;
			     //document.form.parent_level_id1.value =checkboxes[i+3].value;
				//	document.form.parent_member_id1.value =checkboxes[i+4].value;
		        // get owning row
            var rowobj = checkboxes[i];
		      while (rowobj != null &amp; rowobj.tagName != "TR")
            {
              if (rowobj.parentElement)
              {
                rowobj = rowobj.parentElement;
              }
              else
              {
                rowobj = rowobj.parentNode;
              }
            }
//            alert(rowobj.cells[2].innerHTML); 
//		       document.form.parent.value=rowobj.cells[2].innerHTML;
//		alert(rowobj.cells[1].innerHTML);
//alert(		rowobj.cells[2].innerHTML );
	//	alert(		rowobj.cells[3].innerHTML );
		     // alert("arun");
		      //alert(  document.form.fromECRI.value); 
		       // document.form.hierarchy_id1.value =document.getElementById('hierarchy_id').value;
		 				document.form.mergeToMemberName.value =rowobj.cells[1].innerHTML;
		 				//document.form.parent_level_name1.value =rowobj.cells[2].innerHTML;
		 				//document.form.parent_level_id1.value =document.getElementById('parent_level_id').value;
		 				//document.form.parent_member_name1.value =rowobj.cells[3].innerHTML;
		 				//document.form.parent_member_id1.value =document.getElementById('parent_member_id').value;
		     //  alert(document.form.hierarchy_name1.value);      
		     //alert(document.form.hierarchy_id1.value);      
		//alert(document.form.parent_level_name1.value);      
		//alert(document.form.parent_level_id1.value);      
	//	alert(document.form.parent_member_name1.value);      
	//	alert(document.form.parent_member_id1.value);      
          }
        }
		  
      }
    }
  }
  return selected;
}
  </ui:script>
</ui:page-group>

