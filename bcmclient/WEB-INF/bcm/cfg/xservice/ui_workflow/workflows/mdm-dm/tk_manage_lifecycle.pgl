<ui:page-group xmlns:ui="http://www.i2.com/ui" name="studio.templates.simple_entry" source="studio.controller:load">
  
  
  <ui:container id="container">
    
    <ui:help displayPage="{$pages:Manage_Lifecycle_help}"/>

    <ui:step id="top_container" displayText="Manage Member Lifecycle" select="$root">
      
      
      <ui:field-group>
        
        
        <!--<ui:image src="/information_sml.gif"/>-->
        
        
        <ui:display-field value="Select appropriate operation before fetching members!" />
        
      
      </ui:field-group>
      
      
      <!-- ************** -->
      
      
      <!-- needed by studio -->
      
      
      <ui:field-group select="$root">
        
        
        <ui:hidden-field name="EV_NAME" />
        
        
        <ui:hidden-field name="EV_KEY" />
        
        
        <ui:hidden-field name="CURRENT_USER_ID" value="{identity-user-id()}" />
        
        
        <ui:hidden-field name="OP_ID" />
        
        
        <ui:hidden-field name="MEM_NAME" />
        
        
        <ui:hidden-field name="MAX_Rows" />
        
      
      </ui:field-group>
      
      
      <!-- needed by studio -->
      
      
      <!-- ************** -->
      
      
      <ui:container id="innerContainer" collapsable="true">
        
        
        <ui:step displayText="Search Members" id="searchContainer">
          
          
          <ui:field-group columns="2" id="fieldGroups">
            
            
            <ui:field-group id="leftFields">
              
              
              <ui:dropdown displayText="Dimension" optionSrc="$root/DIMENSION/*" name="dimension" id="dimension" onChange="javaScript:ondimensionchange()" />
              
              
              <ui:dropdown displayText="Level" optionSrc="$root/LEVEL/*" name="Level" id="Level" onChange="javaScript:onlevelchange()"/>
              
              
              <ui:dropdown displayText="Operation" selectOne="true" id="OPTN" name="OPTN">
                
                
                <ui:option id="DE-ACTIVATE" value="De-Activate" />
                
                
                <ui:option id="PURGE" value="Purge" />
                
                
                <ui:option id="DELETE" value="Delete" />
                
                
                <!--  <ui:option id="ACTIVATE" value="ACTIVATE"/>-->
                
              
              </ui:dropdown>
              
            
            </ui:field-group>
            
            
            <ui:field-group id="RightFields">
              
              
              <ui:dropdown displayText="Using" selectOne="true" id="USING" name="USING">
                
                
                <ui:option id="NAME" value="Name" />
                
                
                <ui:option id="DESCRIPTION" value="Description" />
                
              
              </ui:dropdown>
              
              
              <ui:dropdown displayText="Condition" selectOne="true" id="CONDITION" name="CONDITION" value="CONTAINS">
                
                
                <ui:option id="CONTAINS" value="CONTAINS" />
                
              
              </ui:dropdown>
              
              
              <ui:entry-field displayText="Search String" doremove="true" id="SEARCH_STRING" name="SEARCH_STRING" />
              
            
            </ui:field-group>
            
          
          </ui:field-group>
          
          
          <ui:buttons id="searchButtons">
            
            
            <ui:button displayText="Show Members" id="SEARCH" name="SEARCH" emphasized="false" validate="true" />
            
          
          </ui:buttons>
          
        
        </ui:step>
        
      
      </ui:container>
      
      
      <ui:table id="bottomTable" displayText="Member List" select="MEMBERS" collapsable="false" selectable="All" scrollable="true" displayTextNoRecords="No Members Found" postRowIdAs="Name" rowId="Name" maxRows="$root/MAX_Rows/@Value">
        
        
        <ui:help id="bottomTableHelp" />
        
        
        <ui:field-group id="tableColumns">
          
          
          <ui:link-field name="Name" displayText="Name" id="Name" sortable="true">
            
            
            <ui:url page="view.x2ps">
              
              
              <MEM_NAME select="./Name/@Value" />
              
            
            </ui:url>
            
          
          </ui:link-field>
          
          
          <ui:display-field name="Description" displayText="Description" id="Description" />
          
          
          <ui:display-field displayText="Status" name="Status" id="Status" sortable="true" />
          
          
          <ui:display-field name="State" displayText="Member State" id="State" />
          
        
        </ui:field-group>
        
        
        <ui:buttons id="tableButtons">
          
          
          <ui:button displayText="Close" id="CANCEL" name="CANCEL" />
          
          
          <ui:divider />
          
          
          <ui:button id="DELETE" name="DELETE" displayText="Delete" enabledBySelections="true" displayCondition="{$root/OP_ID/@Value = 'DELETE'}" emphasized="true" />
          
          
          <ui:button id="PURGE" name="PURGE" displayText="Purge" enabledBySelections="true" displayCondition="{$root/OP_ID/@Value = 'PURGE'}" emphasized="true" />
          
          
          <ui:button id="DEACTIVATE" name="DE-ACTIVATE" displayText="De-Activate" enabledBySelections="true" displayCondition="{$root/OP_ID/@Value = 'DE-ACTIVATE'}" emphasized="true" />
          
          
          <ui:button id="OPERATION" name="ACTIVATE" displayText="Activate" enabledBySelections="true" displayCondition="{$root/OP_ID/@Value = 'ACTIVATE'}" emphasized="true" />
          
        
        </ui:buttons>
        
      
      </ui:table>
      
    
    </ui:step>
    
  
  </ui:container>
  
  
  <ui:script>
		function ondimensionchange()
	{
		 document.form.action = "view.x2ps";
		document.form.BUTTON_ID.value = "LOOP";
		document.form.submit();
	}
	
	function onlevelchange()
	{
		document.form.action = "view.x2ps";
		document.form.BUTTON_ID.value = "LOOP_LEVEL";
		document.form.submit();
	}
	
	
	
	
	
		
 function on_SEARCH()
  {
					if(document.form.OPTN.value == '')core_alert('Please Select An Operation....');
				
					var bIsValid = true; 
					document.form.SUBMIT_AS_XML.value = 'false'; 
					bIsValid = (isValid_searchContainer()); 
					if (bIsValid == false)  validation_alert('searchContainer'); 
					if ( bIsValid == true)
					{ disableButtons();
					document.form.BUTTON_ID.value = 'SEARCH' ;
					document.form.action = 'view.x2ps'; 
					document.form.submit(); 
					}  
					onResize(); 
					return; 
  } 
		
		function on_DEACTIVATE()
		 { 
					var result = core_confirm('All descendants will be De-Activated !!!');
				var bIsValid = true; 
				document.form.SUBMIT_AS_XML.value = 'false';  
				bIsValid = (isValid_bottomTable()); 
				if (bIsValid == false)  validation_alert('bottomTable'); 
				 if ( (bIsValid == true) &amp;&amp;  (result == 'yes')) 
				{ 
					disableButtons();
					document.form.BUTTON_ID.value = 'DEACTIVATE' ; 
					document.form.action = 'view.x2ps'; 
					document.form.submit();
				}
				onResize(); 
				return; 
		}
		
		function on_PURGE()
		{ 
					var result = core_confirm('All descendants will be Purged !!!');
				var bIsValid = true; 
				document.form.SUBMIT_AS_XML.value = 'false'; 
				bIsValid = (isValid_bottomTable());
				if (bIsValid == false)  validation_alert('bottomTable'); 
			 if ( (bIsValid == true) &amp;&amp;  (result == 'yes')) 
				{ 
					disableButtons(); 
					document.form.BUTTON_ID.value = 'PURGE' ; 
					document.form.action = 'view.x2ps';  
					document.form.submit(); 
				}  
				onResize(); 
				return; 
		}
		
		
		function on_DELETE() 
		{
				var result = core_confirm('All descendants will be marked for DELETE !!!');
				var bIsValid = true;  
				document.form.SUBMIT_AS_XML.value = 'false'; 
				bIsValid = (isValid_bottomTable());  
				if (bIsValid == false)  validation_alert('bottomTable'); 
			 if ( (bIsValid == true) &amp;&amp;  (result == 'yes')) 
				{ 
					disableButtons();
					document.form.BUTTON_ID.value = 'DELETE' ; 
					document.form.action = 'view.x2ps'; 
					document.form.submit();
				}  
				onResize();  
				return; 
		}
	

		</ui:script>
  

</ui:page-group>

