<ui:page-group xmlns:ui="http://www.i2.com/ui" name="studio.templates.simple_entry" source="studio.controller:load">
  
  
  <ui:container scrollable="true" collapsable="true">
    
    
    <ui:help displayPage="{$pages:measuredim_help}" />
    
    
    <ui:step id="Outer" displayText="" scrollable="true" editable="false">
      
      
      <ui:field-group select="$root">
        
        
        <ui:hidden-field name="EV_NAME" />
        
        
        <ui:hidden-field name="EV_KEY" />
        
        
        <ui:hidden-field name="iocount" id="iocount" />
        
        
        <ui:hidden-field name="measuretype" id="measuretype" />
        
        
        <ui:hidden-field name="CURRENT_USER_ID" value="{identity-user-id()}" />
        
      
      </ui:field-group>
      
      
      <ui:dynamic-pgl select="$root/PGL/*" />
      
      
      <ui:buttons>
        
        
        <ui:button displayText="Remove" name="Remove" id="Remove" submitTo="summary_results/select.cmd" />
        
        
        <ui:button displayText="New" name="New" id="New" disabled="{($root/iocount/@Value&gt;='1') and ($root/measuretype/@Value='BDM')}" />
        
        
        <ui:divider />
        
      
      </ui:buttons>
      
      
      <ui:buttons>
        
        
        <ui:button displayText="Apply" id="Submit" />
        
        
        <ui:divider />
        
      
      </ui:buttons>
      
    
    </ui:step>
    
  
  </ui:container>
  
  
  <ui:script>
		  function onLoad()
       {
	//	alert(document.form.iocount.value);
		//if(document.form.iocount.value=='1')
		//{alert('in');
		//document.form.New.disabled=true;
//		}
         onLoadSuper();
         scrollHelper();
         autoCollapseRows();
         }
		
		function on_New() 
		{ 
		var bIsValid = true; 
		 document.form.SUBMIT_AS_XML.value = 'false';  
		bIsValid = (isValid_Outer()); 
		 if (bIsValid == false)
		  validation_alert('Outer');
		  if ( bIsValid == true) 
		{ 
		disableButtons(); 
		document.form.BUTTON_ID.value = 'New' ; 
		document.form.action = 'view.x2ps'; 
		 document.form.submit();  
		}  
		onResize();  
		return; 
		}  
  </ui:script>
  

</ui:page-group>

