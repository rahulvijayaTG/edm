                      <ui:dropdown displayText="" name="SourceDimensionLBox" id="SourceDimensionLBox" size="6" editable="true" required="false" selectOne="false" optionSrc="$root/SOURCE/DIMENSIONS/*" />
                    </ui:field-group>
