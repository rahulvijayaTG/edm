<ui:page-group xmlns:ui="http://www.i2.com/ui" name="studio.templates.simple_entry" source="studio.controller:load">
  <ui:container id="create_buffer" selectedStep="{$root/STEP_NUM/@Value}" displayText="{$root/CAPTION/@Value}" scrollable="false" type="Wizard">
    <ui:step displayText="Basic And Dimensionality" id="step1" scrollable="false" editable="true">
      <!-- ************** -->
      <!-- needed by studio -->
      <ui:field-group select="$root">
        <ui:hidden-field name="EV_NAME" />
        <ui:hidden-field name="EV_KEY" />
        <ui:hidden-field name="CURRENT_USER_ID" value="{identity-user-id()}" />
      </ui:field-group>
      <ui:field-group select="$root/MAPSET">
        <ui:entry-field displayText="Name" name="NAME" required="true" editable="{$root/OPERATION/@Value != 'EDIT'}" />
        <ui:entry-field displayText="Description" name="DESCRIPTION" />
        <ui:dropdown displayText="Status" name="STATUS" selectAll="false" value="BI-DIRECTIONAL" id="STATUS">
          <ui:option id="ACTIVE" value="ACTIVE" />
          <ui:option id="INACTIVE" value="INACTIVE" />
        </ui:dropdown>
      </ui:field-group>
      <ui:container collapsable="false">
        <ui:help displayPage="{$pages:Manage_mapset_definition_help}" />
        <ui:help displayPage="{$pages:Manage_mapset_definition_help}" />
        <ui:step id="Dimensionality" select="$root" editable="true" displayText="Dimensionality">
          <ui:field-group select="$root">
            <ui:hidden-field name="EV_NAME" />
            <ui:hidden-field name="EV_KEY" />
            <ui:hidden-field name="CURRENT_USER_ID" value="{identity-user-id()}" />
            <ui:hidden-field id="operation" name="operation" value="{$root/OPERATION/@Value}" />
          </ui:field-group>
          <ui:grid id="one" cellSpacing="10%">
            <ui:row>
              <ui:cell valign="top" align="left">
                <ui:container collapsable="false">
