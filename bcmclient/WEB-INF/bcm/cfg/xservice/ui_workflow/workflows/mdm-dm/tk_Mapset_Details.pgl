    <ui:step id="step2" displayText="Mappings" select="$root" editable="true">
      <ui:field-group select="$root">
        <ui:hidden-field name="EV_NAME" />
        <ui:hidden-field name="EV_KEY" />
        <ui:hidden-field name="CURRENT_USER_ID" value="{identity-user-id()}" />
        <ui:hidden-field name="MAX_Rows" />
        <ui:hidden-field id="operation" name="operation" value="{$root/OPERATION/@Value}" />
      </ui:field-group>
      <ui:field-group select="$root">
        <ui:hidden-field name="EV_NAME" />
        <ui:hidden-field name="EV_KEY" />
        <ui:hidden-field name="CURRENT_USER_ID" value="{identity-user-id()}" />
        <ui:hidden-field name="MAX_Rows" />
        <ui:hidden-field id="operation" name="operation" value="{$root/OPERATION/@Value}" />
      </ui:field-group>
      <ui:script>var nSelectedRows = 0 ; 
           var selectedMapinfo = null ;   
           var selectedCheckbox = null ;
	   
	  function onLoad()
       {
         onLoadSuper();
         scrollHelper();
	 //debugger;
	  if((document.form.operation.value == 'DUPLICATE'))
		i2uiToggleButtonState('FINISH','enabled','Regular');		
	  else
		i2uiToggleButtonState('FINISH','disabled');
         }	

           function i2uiRowSelectionCallback (tableID)
           {
                if (tableID == null)
                        return ;
		
		try
		{
			hasNoSelections = (i2uiGetSelectedRowNums(tableID).length == 0);
              
			if (hasNoSelections == true)
			{
				i2uiToggleButtonState('Copy','disabled');
				i2uiToggleButtonState('Modify','disabled');
				i2uiToggleButtonState('Remove','disabled');
			}
			else
			{
				i2uiToggleButtonState('Copy','enabled','Regular');
				i2uiToggleButtonState('Modify','enabled','Regular');
				i2uiToggleButtonState('Remove','enabled','Regular');
			

                if (i2uiGetSelectedRowNums(tableID).length &gt; 1)                
                {
                    disableButton ('Copy') ;
                    disableButton ('Modify') ;
                    return ;
                }
                
                if (i2uiGetSelectedRowNums(tableID).length &lt; 2)                
                {
                    enableButton ('Copy') ;
                    enableButton ('Modify') ;
                }
                
                selectedMapinfoTable = tableID + "_rowselector" ;
                var tableobj = document.getElementById(selectedMapinfoTable);
                if (tableobj != null)
                {
                    var checkboxes;

                    // IE has a document object per element
                    if(tableobj.document)
                        checkboxes = tableobj.document.getElementsByTagName("INPUT");
                    else
                        checkboxes = document.getElementsByTagName("INPUT");

                    if (checkboxes != null)
                    {
                        var len = checkboxes.length;
                        for(var i=0; i &lt; len; i++)
                        {
                            var id = tableID + "_rowselector" ;
                            if (checkboxes[i].id == id)
                            {
                                if (checkboxes[i].checked)
                                {
                                    selectedCheckbox = checkboxes [i] ;
                                    populateSelectedMapinfo (selectedCheckbox) ;                
                                }
                            }
                        }    
                    }
                } 
		} // end of else
		}catch(e){}	
           }

           function setMapinfoData (index, data)
           {
                if (data != null) 
                {
                    if (selectedMapinfo == null)
                    {
                        selectedMapinfo = new Mapinfo () ;
                    }

                    if (index == 0)
                    {
                        selectedMapinfo.id = data ;
                    }
                }
           }

           function Mapinfo ()
           {
              this.id   = "" ;  
           }

           function populateSelectedMapinfo (selectedCheckbox)
           {
                if (selectedCheckbox == null)
                    return ; 

                var rowObj = selectedCheckbox ;
                if(rowObj.parentElement) 
                    rowObj = rowObj.parentElement.parentElement ;
                else    
                    rowObj = rowObj.parentNode.parentNode ;

                if (selectedMapinfo == null)    
                    selectedMapinfo = new Mapinfo () ;
                var cellsCount = rowObj.cells.length ;
                for (var i = 0; i &lt; cellsCount; i++)
                {
                    if (rowObj.cells[i].tagName == 'TH')                    
                    {
                        if (rowObj.cells[i].innerText != null)
                        {
                            setMapinfoData (i, rowObj.cells[i].innerText) ;
                        }
                    }
                }
           }
   
          var definedMappingRow = null ;
          function selectDefineMappingRow ()
          {
              var defineMappingTable = document.getElementById ('DefineMapping') ;
          }
          
          function on_APPLY ()
          {
                //debugger;
              var defineMappingTable = document.getElementById ('DefineMapping') ;
              var inputs = defineMappingTable.getElementsByTagName('INPUT');
              for (var i = 0; i &lt; inputs.length; i++)
              {
                  if ((inputs[i].type == 'text') &amp;&amp; (inputs[i].value == ''))
                  {
                      core_alert ('Empty Field [' + inputs[i].name + ']') ;
                      inputs[i].focus () ;
                      return ;
                  }    
              }
	      if(!isValidDefineMappings())
	      {
			core_alert('Source and Target Mappings cannot be same');
			return;
	      }
              disableButtons(); 
              document.form.BUTTON_ID.value = 'APPLY' ; 
              document.form.action = 'view.x2ps';  
              document.form.submit();  
              onResize();  
              return; 
          }

          function isValidDefineMappings()
	  {
	  	var tmpSrcLevel = null ;
		var tmpTgtLevel = null ;
		var tmpSrcMember = null ;
		var tmpTgtMember = null ;

		var tmpSrcValue = null ;
		var tmpTgtValue = null ;
		var tmpSrcMemberValue = null ;
		var tmpTgtMemberValue = null ;

		var srcLevel = "SourceLevel" ;
		var tgtLevel = "TargetLevel"  ;
		var srcMember = "SourceMember" ;
		var tgtMember = "TargetMember" ;
		
		var found = false ;
		var inputElement = null ;
		var nSrcLevelCount = 0 ;
		var nTgtLevelCount = 0 ;
		for (var i = 1; i &lt; 9; i++)
		{
			tmpTgtLevel = tgtLevel + i ;
			inputElement = document.getElementById (tmpTgtLevel) ;
			if (inputElement != null)
			{
				nTgtLevelCount++ ;
			}
			
			tmpSrcLevel = srcLevel + i ;
			inputElement = document.getElementById (tmpSrcLevel) ;
			if (inputElement != null)
			{
				nSrcLevelCount++ ;
			}
			
		}
		if (nTgtLevelCount != nSrcLevelCount)
		{
			return true ;
		}

		for (var i = 1; i &lt; 9; i++)
		{
			tmpSrcLevel = srcLevel + i ;
			inputElement = document.getElementById (tmpSrcLevel) ;
			if (inputElement == null)
			{
				break ;
			}
			tmpSrcValue = inputElement.value ;

			tmpTgtLevel = tgtLevel + i ;
			inputElement = document.getElementById (tmpTgtLevel) ;
			tmpTgtValue = inputElement.value ;
			if (tmpSrcValue != tmpTgtValue)
				return true ;

			tmpSrcMember = srcMember + i ;
			inputElement = document.getElementById (tmpSrcMember) ;
			tmpSrcMemberValue = inputElement.value ;

			tmpTgtMember = tgtMember + i ;
			inputElement = document.getElementById (tmpTgtMember) ;
			tmpTgtMemberValue = inputElement.value ;
			if (tmpSrcMemberValue == tmpTgtMemberValue)
				return false ;
                        found = true ;
		}
		return found ;
	  }

	  
	  function on_CLEARALL() 
	  { 
		var bIsValid = true;  
		document.form.SUBMIT_AS_XML.value = 'false';  
		 bIsValid = (isValid_step2());  
	  if (bIsValid == false)  
		validation_alert('step2');  
	  if ( bIsValid == true) 
	  { 
		  var inputs = document.getElementsByTagName('INPUT');
		  for (var i = 0; i &lt; inputs.length; i++)
		  {
			  if (inputs[i].type == 'text')
			     inputs[i].value = "" ;
		   }
		  disableButtons(); 
		  document.form.BUTTON_ID.value = 'CLEARALL' ; 
		  document.form.action = 'view.x2ps';  
		  document.form.submit();  
	  }  
		onResize();  
		return; 
	  }


          function on_COPY ()
          {
                i2uiRowSelectionCallback('ExistingMapping');
		document.form.SelectedMapping.value = selectedMapinfo.id ;
                disableButtons(); 
                document.form.BUTTON_ID.value = 'COPY' ; 
                document.form.action = 'view.x2ps';  
                document.form.submit();  
                onResize();  
                return; 
          }

          function on_MODIFY ()
          {
                i2uiRowSelectionCallback('ExistingMapping');
		document.form.SelectedMapping.value = selectedMapinfo.id ;
                disableButtons(); 
                document.form.BUTTON_ID.value = 'MODIFY' ; 
                document.form.action = 'view.x2ps';  
                document.form.submit();  
                onResize();  
                return; 
          }

          function on_REMOVE ()
          {
                i2uiRowSelectionCallback('ExistingMapping');
		document.form.SelectedMapping.value = selectedMapinfo.id ;
                disableButtons(); 
                document.form.BUTTON_ID.value = 'REMOVE' ; 
                document.form.action = 'view.x2ps';  
                document.form.submit();  
                onResize();  
                return; 
          }

          function on_SearchMember (dimName, SrcLevelField)
          {
            if ((SrcLevelField == null) || (dimName == null))
                return ;
            
            var levelField = document.getElementById(SrcLevelField);
            document.form.SelectedField.value = SrcLevelField ;
            document.form.SelectedDimension.value = dimName ;
            document.form.SelectedLevel.value = levelField.value ;
            disableButtons(); 
            document.form.BUTTON_ID.value = 'SEARCH_MEMBER' ; 
            document.form.action = 'view.x2ps';  
            document.form.submit();  
            onResize();  
            return; 
          }</ui:script>
