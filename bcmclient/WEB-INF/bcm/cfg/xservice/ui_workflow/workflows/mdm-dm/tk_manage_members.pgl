<ui:page-group xmlns:ui="http://www.i2.com/ui" name="studio.templates.simple_entry" source="studio.controller:load">
  
  
  <ui:container id="container1">
    
    
    <ui:help displayPage="{$pages:Manage_members_help}" />
    
    
    <ui:step id="containerstep1" displayText="Manage Members" select="$root" editable="true">
      
      
      <ui:container id="container2" collapsable="true">
        
        
        <ui:step id="containerstep2" displayText="Search Members" select="$root" editable="true">
          
          
          <!-- ************** -->
          
          
          <!-- needed by studio -->
          
          
          <ui:field-group select="$root">
            
            
            <ui:hidden-field name="EV_NAME" />
            
            
            <ui:hidden-field name="EV_KEY" />
            
            
            <ui:hidden-field name="CURRENT_USER_ID" value="{identity-user-id()}" />
            
            
            <ui:hidden-field name="MAX_Rows" />
	     <ui:hidden-field name="Success_flag" />
            
            
            <ui:hidden-field name="mem_name" />
            
            
            <ui:hidden-field name="Success_message" />
            
          
          </ui:field-group>
          
          
          <!-- needed by studio -->
          
          
          <!-- ************** -->

	   <ui:field-group name="mesg" select="$root" displayCondition="{$root/Success_flag/@Value='true'}">
            
            
            <ui:display-field displayText="" name="SUCCESSMESSAGE" value="{$root/Success_message/@Value}" class="requiredIndicator" />
            
          
          </ui:field-group>
          
          
          <ui:field-group columns="2" id="fieldGroups">
            
            
            <ui:field-group id="leftFields">
              
              
              <ui:dropdown id="dimension_name" name="dimension_name" displayText="Dimension Name" optionSrc="$root/DIMENSION/*" onChange="javaScript:ondimensionchange()">
                
                
                <!-- <ui:option id="1" value="1"/>
                <ui:option id="10" value="10"/>
                <ui:option id="20" value="20"/>-->
                
                
                <!--<ui:option id="4" value="COMPONENT"/>-->
                
              
              </ui:dropdown>
              
              
              <ui:dropdown id="level_name" name="level_name" displayText="Level Name" optionSrc="$root/LEVEL/*" onChange="javaScript:onlevelchange()">
                
                
                <!-- <ui:option id="1" value="1"/>
                <ui:option id="2" value="2"/>
                <ui:option id="3" value="3"/>
                <ui:option id="4" value="4"/>-->
                
              
              </ui:dropdown>
              
              
              <ui:dropdown id="member_status" name="member_status" displayText="Member Status">
                
                
                <ui:option id="3" value="Any" />
                
                
                <ui:option id="2" value="Un-Assigned" />
                
                
                <ui:option id="1" value="Partially-Assigned" />
                
                
                <ui:option id="0" value="Assigned" />
                
              
              </ui:dropdown>
              
              
              <ui:dropdown id="member_state" name="member_state" displayText="Member State">
                
                
                <ui:option id="ANY" value="Any" />
                
                
                <ui:option id="ACTIVE" value="Active" />
                
                
                <ui:option id="INACTIVE" value="Inactive" />
                
              
              </ui:dropdown>
              
            
            </ui:field-group>
            
            
            <ui:field-group id="rightFields">
              
              
              <ui:dropdown id="using" name="using" displayText="Using">
                
                
                <ui:option id="NAME" value="Name" />
                
                
                <ui:option id="DESCRIPTION" value="Description" />
                
              
              </ui:dropdown>
              
              
              <ui:dropdown id="condition" name="condition" displayText="Condition">
                
                
                <ui:option id="CONTAINS" value="CONTAINS" />
                
              
              </ui:dropdown>
              
              
              <ui:entry-field id="search_string" name="search_string" displayText="Search String" />
              
            
            </ui:field-group>
            
          
          </ui:field-group>
          
          
          <ui:buttons id="searchButtons">
            
            
            <ui:button displayText="Manage Lifecycle" id="manageLifecycle" name="manageLifecycle" />
            
            
            <ui:divider />
            
            
            <ui:button displayText="Show Members" id="Search" name="Search" />
            
          
          </ui:buttons>
          
        
        </ui:step>
        
      
      </ui:container>
      
      
      <!--<ui:container id="container3">
        <ui:step id="containerstep3" displayText="Member List" select="$root" scrollable="true">-->
      
      
      <ui:table displayText="Member List" collapsable="false" displayTextNoRecords="No Members found" select="MEMBERS" selectable="Single" rowId="name" postRowIdAs="name" maxRows="$root/MAX_Rows/@Value" help="{$pages:Manage_members_help}">
        
        
        <ui:help id="bottomTableHelp" />
        
        
        <ui:field-group>
          
          
          <ui:link-field displayText="Name" sortable="true" id="name" name="name">
            
            
            <ui:url page="view.x2ps">
              
              
              <member_name select="name/@Value" />
              
            
            </ui:url>
            
          
          </ui:link-field>
          
          
          <ui:display-field displayText="Description" name="member_description" id="member_description" />
          
          
          <ui:display-field displayText="Status" name="member_status" sortable="true" id="member_status" />
          
          
          <ui:display-field displayText="State" name="member_state" id="member_state" />
          
        
        </ui:field-group>
        
        
        <ui:buttons>
          
          
          <ui:button displayText="Duplicate" id="Duplicate" name="Duplicate" enabledBySelections="true" />
          
          
          <ui:divider />
          
          
          <ui:button displayText="New" id="New" name="New" />
          
        
        </ui:buttons>
        
      
      </ui:table>
      
      
      <!--</ui:step>
      </ui:container>-->
      
    
    </ui:step>
    
  
  </ui:container>
  
  
  <ui:script>
	function ondimensionchange()
	{
		document.form.action = "view.x2ps";
		document.form.BUTTON_ID.value = "LOOP";
		document.form.submit();
	}
	
	
	function onlevelchange()
	{
		document.form.action = "view.x2ps";
		document.form.BUTTON_ID.value = "LOOP_LEVEL";
		document.form.submit();
	}
	
	
	
	
</ui:script>
  

</ui:page-group>

