<ui:page-group xmlns:ui="http://www.i2.com/ui" name="studio.templates.simple_entry" source="studio.controller:load" version="2">
  <ui:container id="parent" displayText="Measure Definition" scrollable="true">
    <ui:help displayPage="{$pages:measuredim_help}" />
    <ui:step id="step2" displayText="{$root/headertitle/@Value}" select="$root" editable="true">
      <ui:field-group select="$root">
        <ui:hidden-field name="EV_NAME" />
        <ui:hidden-field name="EV_KEY" />
        <ui:hidden-field name="CURRENT_USER_ID" value="{identity-user-id()}" />
        <ui:hidden-field name="displayc" id="displayc" />
        <ui:hidden-field name="buttonAction" id="buttonAction" />
        <ui:hidden-field name="lowerCount" id="lowerCount" value="{$root/lowerCount/@Value}" />
        <!--  <ui:hidden-field name="hid1" id="hid1"/>
        <ui:hidden-field name="hid2" id="hid2"/>
        <ui:hidden-field name="hid3" id="hid3"/>-->
        <ui:hidden-field name="source" id="source" />
        <ui:hidden-field name="ioadded" id="ioadded" />
        <ui:hidden-field name="headertitle" id="headertitle" />
        <ui:hidden-field name="footertitle" id="footertitle" />
        <ui:hidden-field name="midtitle" id="midtitle" />
        <ui:hidden-field name="is_time" id="is_time" value="{$root/is_time/@Value}" />
        <ui:hidden-field name="measuretype" id="measuretype" value="{$root/measuretype/@Value}" />
        <ui:hidden-field name="uboundval" id="uboundval" />
      </ui:field-group>
      <ui:field-group name="mesg" select="$root" displayCondition="{string-length($root/SUCCESSMESSAGE/@Value) != 0}">
        <ui:choose-field name="SUCCESSMESSAGE">
          <ui:when test="string-length($root/SUCCESSMESSAGE/@Value) != 0">
            <ui:display-field displayText="" name="SUCCESSMESSAGE" value="{$root/SUCCESSMESSAGE/@Value}" class="requiredIndicator" />
          </ui:when>
          <ui:otherwise />
        </ui:choose-field>
      </ui:field-group>
      <ui:field-group name="mesg" select="$root" displayCondition="{string-length($root/IOLEVELMESSAGE/@Value) != 0}">
        <ui:choose-field name="IOLEVELMESSAGE">
          <ui:when test="string-length($root/IOLEVELMESSAGE/@Value) != 0">
            <ui:display-field displayText="" name="IOLEVELMESSAGE" value="{$root/IOLEVELMESSAGE/@Value}" class="requiredIndicator" />
          </ui:when>
          <ui:otherwise />
        </ui:choose-field>
      </ui:field-group>
      <ui:table id="bottomTable" displayText="{$root/midtitle/@Value}" rowSrc="$root/SCHEDULES/SCHEDULE" rowSubTreeSrc="ORDER_SCHEDULES/LINE" maxRows="-1" selectable="Single" postRowIdAs="ID" rowId="ID" scrollable="true">
        <ui:field-group id="tableColumns">
          <!-- <ui:hidden-field id="RID" name="RID" value="{$root/SCHEDULES/SCHEDULE/ID/@Value}"/>-->
          <ui:treecell displayText="Dimension" name="ID" noChildren="{count(ORDER_SCHEDULES/LINE) = 0}" depth="{count(ancestor::node()[name()='ORDER_SCHEDULES'] )}" column="0" />
          <ui:display-field id="Types" name="Types" displayText="Type" />
          <ui:display-field id="Aggregation" name="Aggregation" displayText="Aggregation" />
          <ui:display-field id="Upper Bound" name="ubound" displayText="Upper Bound" />
          <ui:display-field id="Lower Bound" name="lbound" displayText="Lower Bound" />
          <ui:display-field id="Lookup" name="level" displayText="Lookup Levels" />
        </ui:field-group>
        <ui:buttons id="buttons0">
          <ui:button id="Remove" displayText="Remove" name="Remove" displayCondition="{$root/buttonAction/@Value!='edit'}" enabledBySelections="true" />
          <ui:button id="Modify" displayText="Modify" name="Modify" enabledBySelections="true" />
          <ui:button id="New" displayText="New" name="New" enabledBySelections="false" displayCondition="false" />
          <ui:divider />
        </ui:buttons>
      </ui:table>
      <ui:container id="container2">
        <ui:step id="bottom1" displayText="{$root/footertitle/@Value}" select="$root" editable="true">
          <ui:field-group id="tableColumns" columns="3">
            <ui:dropdown displayText="Dimension" id="Dimension" name="Dimension" selectAll="false" optionSrc="$root/DIMENSION/*" onChange="JavaScript:on_dimensionDetails()" />
            <ui:dropdown displayText="Dimension Type" id="Dimension" name="Types" selectAll="false">
              <ui:option id="BLOCK" value="BLOCK" />
              <ui:option id="KEY" value="KEY" />
            </ui:dropdown>
            <ui:dropdown displayText="Aggregation" name="Agre" selectAll="false">
              <ui:option id="NONE" value="NONE" />
              <ui:option id="AVERAGE" value="AVERAGE" />
              <ui:option id="SUM" value="SUM" />
            </ui:dropdown>
          </ui:field-group>
          <ui:field-group name="MESSAGE" select="$root" displayCondition="{string-length($root/MESSAGE/@Value) != 0}">
            <ui:choose-field name="MESSAGE">
              <ui:when test="string-length($root/MESSAGE/@Value) != 0">
                <ui:display-field displayText="" name="MESSAGE" value="{$root/MESSAGE/@Value}" class="requiredIndicator" align="right" />
              </ui:when>
            </ui:choose-field>
          </ui:field-group>
          <ui:grid id="one">
            <ui:row>
              <ui:cell width="30%" valign="top" align="left">
                <ui:container collapsable="false">
                  <ui:step id="ubound" displayText="Upper Bound">
                    <ui:field-group>
                      <ui:dropdown displayText="" size="12" name="ubound" optionSrc="$root/LEVELS/*" value="{$root/ubound/@Value}" />
                    </ui:field-group>
                  </ui:step>
                </ui:container>
              </ui:cell>
              <ui:cell width="30%" valign="top" align="left">
                <ui:container collapsable="false">
                  <ui:step id="__step" displayText="Lower Bound">
                    <ui:field-group>
                      <ui:dropdown displayText="" size="12" name="lbound" optionSrc="$root/LEVELS/*" value="{$root/lbound/@Value}" />
                    </ui:field-group>
                  </ui:step>
                </ui:container>
              </ui:cell>
              <ui:cell width="40%" valign="top" align="left">
                <ui:container collapsable="false">
                  <ui:step id="__step" displayText="">
                    <ui:table id="tab6" displayText="Lookup Levels" selectable="All" postRowIdAs="level" select="$root/ORDERS" rowId="level" maxRows="-1" scrollable="false" displayTextNoRecords="" displayCondition="{$root/measuretype/@Value!='BDM'}">
                      <ui:field-group id="tableColumns" columns="2">
                        <ui:display-field id="level" name="level" displayText="Level Name" size="8" />
                        <ui:entry-field id="rank" name="rank" displayText="Rank" size="4" dataType="Number" />
                      </ui:field-group>
                    </ui:table>
                    <ui:buttons>
                      <ui:button id="levels" displayText="IO Levels..." name="levels" disabled="{$root/source/@Value='no'}" />
                      <ui:button id="Apply" displayText="Apply" name="Apply" />
                      <ui:divider />
                    </ui:buttons>
                  </ui:step>
                </ui:container>
              </ui:cell>
            </ui:row>
          </ui:grid>
          <ui:buttons>
            <!--<ui:button id="levels" displayText="Levels" name="levels"/>
            <ui:button id="Apply" displayText="Apply" name="Apply"/>-->
            <ui:button displayText="Close" id="CANCEL" name="CANCEL" />
            <ui:button displayText="Previous" id="PREVIOUS" name="PREVIOUS" disabled="false" />
            <ui:button displayText="Next" id="NEXT" name="NEXT" disabled="true" enabledBySelections="true" />
            <ui:button displayText="Finish" id="FINISH" name="FINISH" disabled="{$root/ioadded/@Value='false'}" />
            <ui:divider />
          </ui:buttons>
        </ui:step>
      </ui:container>
    </ui:step>
  </ui:container>
  <ui:script>
    function on_FINISH() 
		{
		 document.form.Types.disabled=false;
			document.form.Agre.disabled=false;
		 var bIsValid = true; 
		 document.form.SUBMIT_AS_XML.value = 'false';  
		bIsValid = (isValid_bottom1());  
		if (bIsValid == false)  
		validation_alert('bottom1');
		  if ( bIsValid == true)
		 { 
		
		
		var n2=0;
for(var i = 0;i &lt; document.form.elements.length; i++) 
		{
		if(document.form.elements[i].name=='ID')
		n2++;
		
		}
	if(n2==0)
		{
		core_alert('Please Add a Dimension');
		return;
		}
		
		disableButtons(); 
		document.form.BUTTON_ID.value = 'FINISH' ;
		 document.form.action = 'view.x2ps';  
		document.form.submit();
		  }  
		onResize();  
		return; 
		}  
    

          function onLoad()
       {
	
	for(var i = 0;i &lt; document.forms[1].elements.length; i++)
		  {
		//	alert(document.forms[1].elements[i].name);
			if (document.forms[1].elements[i].name=="rank_N0")
		 {
		//alert(document.forms[1].elements[i].value);
				if (document.forms[1].elements[i].value.length!=0) {
		document.forms[1].elements[i-2].checked=true;
				}
			}
		}
		
//	alert(document.form.source.value);
		if(document.form.source.value=='no')
		{
		document.form.ioadded.value='abc';}
		 
  var strval='';
		
		for(j=0;j&lt;document.form.ubound.length;j++)
		{
		if(document.form.ubound.options[j].selected)
		{
		if(strval=='')
		strval=document.form.ubound.options[j].value;
		else
		{
		strval=strval+'#'+document.form.ubound.options[j].value;
 
		}
	}
		}
			document.form.uboundval.value=strval;
    <!--if(document.form.Dimension.value=='Time')-->
    <!--alert(document.form.is_time.value);-->
    if(document.form.is_time.value=='true')
			{
		
		
		 document.form.Types.value='BLOCK';
		 document.form.Types.disabled=true;
		}
		else
		{
			 document.form.Types.value='KEY';	 
		document.form.Types.disabled=true;
		}
    <!--alert(document.form.measuretype.value);-->
    if(document.form.measuretype.value=='CMN')
		{
 
		document.form.Agre.value='NONE';
	document.form.Agre.disabled=true;
		 document.form.Types.value='KEY';	 
		document.form.Types.disabled=true;
		}
		
		 if(document.form.measuretype.value=='BDM')
		{
		 
		document.form.Agre.value='SUM';
	document.form.Agre.disabled=true;
		}
		 if(document.form.measuretype.value=='SPM')
		{
		if(document.form.Dimension.value!='Time')
		{
		
			document.form.Agre.value='NONE';
	document.form.Agre.disabled=true;
	
		}
		else
		{
	 
	document.form.Agre.disabled=false;
		}
		}
         onLoadSuper();
         scrollHelper();
         }
    <!--    function onLoadSuper()
       {
       
         initFrameToggleGif();
         i2uiSetBreadcrumbsWidth();
       
       enableButtonsIfRowSelected();
       }
     	-->
    function on_levels()
				{
			
          
        var url = "view.x2ps?"; 
          
				
				for(var i = 0;i &lt; document.forms[1].elements.length; i++)  {
			if (document.forms[1].elements[i].name=="ID") {
	//	alert(document.forms[1].elements[i].value);
				url=url+"ID="  + document.forms[1].elements[i].value ;
			}
		}
				
			
      // alert(url);
		
   url = url + "&amp;BUTTON_ID=levels&amp;SYS_ID=" + document.form.SYS_ID.value;
	 popUpWindow(url,'planPopUp');   
				} 
				function on_Modify()
		{
//	for(i=
	
		var i=i2uiGetSelectedRowIds1('bottomTable');
			//	alert(i);
	 disableButtons(); 
		   document.form.BUTTON_ID.value = 'Modify' ; 
 document.form.action = 'view.x2ps';  
	  document.form.submit();  
	 
	 onResize(); 	
	 		return;
		}
		
function i2uiGetSelectedRowIds1(tableid)
{
  var selected = new Array();

  // NS4 browser not supported
  if (document.layers != null)
    return selected;

  var tableobj = document.getElementById(tableid);
  if (tableobj != null)
  {
    var checkboxes;   
    // IE has a document object per element
    if(tableobj.document)
      checkboxes = tableobj.document.getElementsByTagName("INPUT");
    else
      checkboxes = document.getElementsByTagName("INPUT");

    if (checkboxes != null)
    {
      var len = checkboxes.length;
      var j = 0;
      for(var i=0; i&lt;len; i++)
      {
         if (checkboxes[i].id == tableid+"_rowselector")
        {       
		      j++;
          if (checkboxes[i].checked)
          {
            // get owning row
            var rowobj = checkboxes[i];
		      while (rowobj != null &amp; rowobj.tagName != "TR")
            {
              if (rowobj.parentElement)
              {
                rowobj = rowobj.parentElement;
              }
              else
              {
                rowobj = rowobj.parentNode;
              }
            }

		      
		 			
		 				document.form.Types.value =rowobj.cells[2].innerHTML;
		 		
		 				document.form.Agre.value =rowobj.cells[3].innerHTML;
		 
		     
          }
        }
		  
      }
    }
  }
 // return selected;
}
		
     function  on_dimensionDetails()
				{
				   document.form.BUTTON_ID.value = 'Details' ; 
 document.form.action = 'view.x2ps';  
	  document.form.submit();  
				}
        
		function uboundChange()
		{
		
		
    for(var i = 0;i &lt; document.form.ubound.options.length; i++) { 
		 
			if (document.form.ubound.options[i].selected) {
	 
					n1++;
		 }
			}
	 
		
		
		
		}

   function on_Apply() { 
		
		
	 for(var i = 0;i &lt; document.forms[1].elements.length; i++)
		  {
			if (document.forms[1].elements[i].name=="level") 
		{
				if (document.forms[1].elements[i].checked)
		 {
		if(document.forms[1].elements[i+2].value.length==0)
		{
		core_alert('Please enter a rank for this Level');
		return;
		}
	 
	 
				}
			}
		}
			 		
		if(hasuboundChanged(document.forms[1])==true) {
		
	 core_alert('Cannot deselect an Upper Bound ');
	 	return;
		}
			 document.form.Types.disabled=false;
			
			document.form.Agre.disabled=false;
		
				var bIsValid = true; 
				 document.form.SUBMIT_AS_XML.value = 'false';
				  bIsValid = (isValid_bottom1()); 
				 if (bIsValid == false)
				  validation_alert('bottom1');
				  if ( bIsValid == true)
				 { 
		var n1=0;
		
	//n1=document.form.lbound.selectedIndex;

    
//int j;
		for(var i = 0;i &lt; document.form.lbound.options.length; i++) { 
		 
			if (document.form.lbound.options[i].selected) {
	 
					n1++;
		 }
			}
	 
			
    
		 
		if (n1&gt;1) {
			core_alert("Please select one lower bound");
			return;
		}
	
		
				disableButtons();
				 document.form.BUTTON_ID.value = 'Apply' ;
				 document.form.action = 'view.x2ps'; 
				 document.form.submit();  
				}  
				onResize(); 
				 return; 
				} 
      
      
      
      function hasuboundChanged(form) {
			 
	 
		var string1=form.uboundval.value;	
	var selecteduboundCount=0;  //Count of currently selected ubounds
	var saveduboundCount=0;		//Count of currently saved ubounds
	var ubound_array = string1.split("#");

	if(string1!='') {
		saveduboundCount=ubound_array.length;		
	}

	//calclate the count of selected ubounds in dropdown
	for(j=0;j&lt;form.ubound.length;j++)
if(form.ubound.options[j].selected)
		selecteduboundCount++;

		//If count of selected ubounds in dropdown not equal to count of saved reasons implies ubounds have changed
		//if(selecteduboundCount!=saveduboundCount)
			 //return true;

		//If count of selected reasons in dropdown is zero and no reasons have been saved implies ubounds have not changed
		if(selecteduboundCount==0) {
			return false;
		}
		if(saveduboundCount==0) {
			return false;
		}

		var isPresent;
		isPresent=false;
		for(i=0;i&lt;ubound_array.length;i++) {
			
			for(j=0;j&lt;form.ubound.length;j++) {

				if(form.ubound.options[j].selected==false)
					continue;
//alert('ubound_array[i]'+ubound_array[i]);
		//alert('form.ubound.options[j].value'+form.ubound.options[j].value);
				if(ubound_array[i]==form.ubound.options[j].value) {
					isPresent=true;			
				}
			}
		//alert(isPresent);
			if(isPresent==false) {
				return true;			
			}
		}

		return (false);
}
  </ui:script>
</ui:page-group>

