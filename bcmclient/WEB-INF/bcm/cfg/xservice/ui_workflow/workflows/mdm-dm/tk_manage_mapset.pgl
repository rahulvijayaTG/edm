<ui:page-group xmlns:ui="http://www.i2.com/ui" name="studio.templates.simple_entry" source="core.report.pgl:pgl">
  <ui:container id="TopContainer">
    <ui:step id="TopContainerPanel" displayText="Manage Mapsets" select="$root" editable="true">
      <ui:container id="SearchContainer" collapsable="true">
        <ui:help displayPage="{$pages:Manage_mapsets_help}" />
        <ui:step id="SearchContainerPanel" displayText="Search Mapsets" select="$root" editable="true">
          <ui:field-group select="$root">
            <ui:hidden-field name="EV_NAME" />
            <ui:hidden-field name="EV_KEY" />
            <ui:hidden-field name="MAX_Rows" />
            <ui:hidden-field name="CURRENT_USER_ID" value="{identity-user-id()}" />
          </ui:field-group>
          <ui:grid id="one" cellSpacing="12%">
            <ui:row>
              <ui:cell width="3%" valign="top" align="left">
                <ui:container collapsable="false">
                  <ui:step id="SourceDimensionStep" displayText="Source Dimension">
                    <ui:field-group>
                      <ui:dropdown size="5" id="SourceDimensionLBox" name="SourceDimensionLBox" dataType="Constant" editable="true" required="false" selectOne="false" optionSrc="$root/SOURCE/DIMENSIONS/*" />
                    </ui:field-group>
                  </ui:step>
                </ui:container>
              </ui:cell>
              <ui:cell width="3%" valign="top" align="left">
                <ui:container collapsable="false">
                  <ui:step id="TargetDimensionStep" displayText="Target Dimension">
                    <ui:field-group>
                      <ui:dropdown displayText="" id="TargetDimensionLBox" name="TargetDimensionLBox" size="5" dataType="Constant" editable="true" required="false" selectOne="false" optionSrc="$root/TARGET/DIMENSIONS/*" />
                    </ui:field-group>
                  </ui:step>
                </ui:container>
              </ui:cell>
              <ui:cell width="1%" />
              <ui:cell width="5%" valign="top" align="right">
                <ui:field-group columns="1" id="fieldGroups">
                  <ui:dropdown id="UsingCBox" name="Using" displayText="Using" optionSrc="$root/SEARCH-BY/*" />
                  <ui:field-space displayText="Space" />
                  <ui:dropdown id="ConditionCBox" name="Condition" displayText="Condition" optionSrc="$root/SEARCH-CONSTRAINTS/*" />
                  <ui:field-space displayText="Space" />
                  <ui:entry-field id="SearchStringTBox" name="SearchString" displayText="Search String" size="20" />
                </ui:field-group>
              </ui:cell>
            </ui:row>
          </ui:grid>
          <ui:buttons id="searchButtons">
            <ui:button displayText="Show Mapsets" id="Search" name="Search" validate="true" />
          </ui:buttons>
        </ui:step>
      </ui:container>
      <ui:script>var selectedMapset = null ;
    var selectedMapsetTable = null ;
        
    function isAnyPresentAsDimension (listBox) 
    {
        if (listBox != null)
        {
            count = 0 ;
            for (var i = 0; i &lt; listBox.options.length; i++)
            {
                if (listBox.options[i].selected)
                {
                    if (count &gt; 0)
                    {
                        if (isAnyPresent (listBox.options))
                        {
                            core_alert ('ANY cannot be selected with other dimensions') ;
                            return true;
                        }    
                    }
                    count++ ;
                }
            }
        }
        return false ;
    }
    
    function isAnyPresent (option)
    {
        for (var i = 0; i &lt; option.length; i++)
        {
            if ((option[i].selected == true) &amp;&amp; (option[i].value == 'ANY'))
            {
                return true ;
            }
        }
        return false ;
    }
    
    function on_Delete() 
    {
        if (selectedMapset == null)
        {
            core_alert("Please select Mapset for deletion") ;
            return ;
        }
        
        var ret = core_confirm ('Are you sure to delete Mapset:' +  selectedMapset.name) ;
        if ((ret == 'no') || (ret == 'No'))
            return ;
            
        var bIsValid = true;  
        document.form.SUBMIT_AS_XML.value = 'false';  
        bIsValid = (isValid_result_form_table());  
        if (bIsValid == true)  
            validation_alert('result_form_table');  
            
        if ( bIsValid == true) 
        { 
            disableButtons(); 
            document.form.BUTTON_ID.value = 'Delete' ; 
            document.form.action = 'view.x2ps';  
            selectedMapset = null ;
            document.form.submit();  
        }
        onResize();  
        return ; 
    }

    function on_Edit ()
    {
        var bIsValid = true;  
        document.form.SUBMIT_AS_XML.value = 'false';  
        bIsValid = (isValid_result_form_table());  
        if (bIsValid == true)  
            validation_alert('result_form_table');  
            
        if ( bIsValid == true) 
        { 
            document.form.MapsetID.value = selectedMapset.id ;
            document.form.MapsetDescription.value = selectedMapset.description;
            document.form.MapsetSourceDimension.value = selectedMapset.srcDimensions ;
            document.form.MapsetTargetDimension.value = selectedMapset.tgtDimensions ;
            disableButtons(); 
            document.form.BUTTON_ID.value = 'Edit' ; 
            document.form.action = 'view.x2ps';  
            selectedMapset = null ;
            document.form.submit();  
        }
        onResize();  
        return ; 
    }
    
    function on_Duplicate ()
    {
        var bIsValid = true;  
        document.form.SUBMIT_AS_XML.value = 'false';  
        bIsValid = (isValid_result_form_table());  
        if (bIsValid == true)  
            validation_alert('result_form_table');  
            
        if ( bIsValid == true) 
        { 
            document.form.MapsetID.value = selectedMapset.id ;
            document.form.MapsetName.value = selectedMapset.name;
            document.form.MapsetDescription.value = selectedMapset.description;
            document.form.MapsetSourceDimension.value = selectedMapset.srcDimensions ;
            document.form.MapsetTargetDimension.value = selectedMapset.tgtDimensions ;
            disableButtons(); 
            document.form.BUTTON_ID.value = 'Duplicate' ; 
            document.form.action = 'view.x2ps';  
            selectedMapset = null ;
            document.form.submit();  
        }
        onResize();  
        return ; 
    }
    
    function on_Search() 
    {
        if (isAnyPresentAsDimension (document.form.SourceDimensionLBox))
            return ;
            
        if (isAnyPresentAsDimension (document.form.TargetDimensionLBox))
            return ;

        if (document.form.SourceDimensionLBox.value == '')
        {
            core_alert ('Please select at least one Source Dimension') ;
            return ;
        }

        if (document.form.TargetDimensionLBox.value == '')
        {
            core_alert ('Please select at least one Target Dimension') ;
            return ;
        }

        var bIsValid = true;  
        document.form.SUBMIT_AS_XML.value = 'false';  
        bIsValid = (isValid_SearchContainerPanel());  
        if (bIsValid == false)  
            validation_alert('SearchContainerPanel');  
        if ( bIsValid == true) 
        { 
            disableButtons(); 
            document.form.BUTTON_ID.value = 'Search' ; 
            document.form.action = 'view.x2ps';  
            document.form.submit();  
        }  
        onResize();  
        return; 
   }
   
   function i2uiRowSelectionCallback (tableID)
   {
        if (tableID == null)
                return ;
                
        selectedMapsetTable = tableID + "_data" ;
        var tableobj = document.getElementById(selectedMapsetTable);
        if (tableobj != null)
        {
            var checkboxes;

            // IE has a document object per element
            if(tableobj.document)
                checkboxes = tableobj.document.getElementsByTagName("INPUT");
            else
                checkboxes = document.getElementsByTagName("INPUT");

            if (checkboxes != null)
            {
                var len = checkboxes.length;
                for(var i=0; i &lt; len; i++)
                {
                    var id = tableID + "_rowselector" ;
                    if (checkboxes[i].id == id)
                    {
                        if (checkboxes[i].checked)
                        {
                            setMapsetData (0, checkboxes[i].value) ;
                            populateSelectedMapset(checkboxes [i]) ;
                        }
                    }
                }    
            }
            
            if (i2uiGetSelectedRowNums(tableID).length &gt; 0)
            {
                enableButton ('Delete') ;
                enableButton ('Duplicate') ;
            }
        }
   }
   
   function setMapsetData (index, data)
   {
        if (data != null) 
        {
            if (selectedMapset == null)
            {
                selectedMapset = new Mapset () ;
            }
            
            if (index == 0)
            {
                selectedMapset.id = data ;
            }
            else if (index == 1)
            {
                selectedMapset.name = data ;
            }
            else if (index == 2)
            {
                selectedMapset.description = data ;
            }
            else if (index == 4)
            {
                selectedMapset.srcDimensions = data ;
            }
            else if (index == 5)
            {
                selectedMapset.tgtDimensions = data ;
            }
        }
   }
   
   function Mapset ()
   {
      this.id   = "" ;  
      this.name = "" ;
      this.description = "" ;
      this.srcDimensions = "" ;
      this.tgtDimensions = "" ;
   }
   
   function populateSelectedMapset (selectedCheckbox)
   {
        if (selectedCheckbox == null)
            return ; 
        
        var rowObj = selectedCheckbox ;
        if(rowObj.parentElement) 
            rowObj = rowObj.parentElement.parentElement ;
        else    
            rowObj = rowObj.parentNode.parentNode ;

        if (selectedMapset == null)    
            selectedMapset = new Mapset () ;
        var cellsCount = rowObj.cells.length ;
        for (var i = 0; i &lt; cellsCount; i++)
        {
            if (rowObj.cells[i].tagName == 'TD')
            {
                if (rowObj.cells[i].innerText != null)
                {
                    setMapsetData (i, rowObj.cells[i].innerText) ;
                }
            }
            
        }
   }</ui:script>
      <ui:container id="MapsetsContainer">
        <ui:help displayPage="{$pages:Manage_mapsets_help}" />
        <ui:step id="MapsetsList" displayText="Mapset List" select="$root" scrollable="true">
          <ui:field-group>
            <ui:hidden-field name="MapsetID" />
            <!-- <ui:hidden-field name="MapsetName" id="MapsetName" value="ABC"/>-->
            <ui:hidden-field name="MapsetDescription" />
            <ui:hidden-field name="MapsetSourceDimension" />
            <ui:hidden-field name="MapsetTargetDimension" />
          </ui:field-group>
          <ui:table displayText="Search Results" collapsable="false" displayTextNoRecords="No Mapsets found" select="MAPSETS" selectable="Single" rowId="MapsetName" postRowIdAs="MapsetName" maxRows="$root/MAX_Rows/@Value" scrollable="true">
            <ui:field-group>
              <ui:link-field displayText="Name" sortable="true" id="MapsetName">
                <ui:url page="{$pages:edit_mapset_details}">
                  <MapsetName select="MapsetName/@Value" />
                  <MapsetId select="MapsetId/@Value" />
                  <MapsetDescription select="MapsetDescription/@Value" />
                </ui:url>
              </ui:link-field>
              <ui:display-field displayText="Description" name="MapsetDescription" id="MapsetDescription" />
              <ui:display-field displayText="Source Dimension(s)" name="SourceDimension" id="SourceDimension" />
              <ui:display-field displayText="Target Dimension(s)" name="TargetDimension" id="TargetDimension" />
            </ui:field-group>
            <ui:buttons>
              <ui:button displayText="Delete" id="Delete" name="Delete" disabled="true" />
              <ui:divider />
              <ui:button displayText="Duplicate" id="Duplicate" name="Duplicate" disabled="true" />
              <ui:button displayText="New" id="AddNew" name="AddNew" />
            </ui:buttons>
          </ui:table>
        </ui:step>
      </ui:container>
    </ui:step>
  </ui:container>
</ui:page-group>

