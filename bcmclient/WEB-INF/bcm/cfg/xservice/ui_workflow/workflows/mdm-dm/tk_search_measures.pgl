<ui:page-group xmlns:ui="http://www.i2.com/ui" name="studio.templates.simple_entry" source="studio.controller:load" version="2">
  <ui:container id="container" collapsable="false">
    <ui:help displayPage="{$pages:managemeasure_help}" />
    <ui:step id="top_container" displayText="Manage Measures" select="$root">
      <!-- ************** -->
      <!-- needed by studio -->
      <ui:field-group select="$root">
        <ui:hidden-field name="EV_NAME" />
        <ui:hidden-field name="EV_KEY" />
        <ui:hidden-field name="PARAMETER" />
        <ui:hidden-field name="CURRENT_USER_ID" value="{identity-user-id()}" />
        <ui:hidden-field name="MAX_Rows" />
      </ui:field-group>
      <!-- needed by studio -->
      <!-- ************** -->
      <ui:container id="innerContainer">
        <ui:step displayText="Search Measures" id="searchContainer">
          <ui:field-group columns="2" id="fieldGroups">
            <ui:field-group id="leftFields">
              <ui:dropdown displayText="Type" id="TYPE" onChange="JavaScript:typeCheck()" name="TYPE">
                <ui:option id="ANY" value="ANY" />
                <ui:option id="BDM" value="BI-DIRECTIONAL" />
                <ui:option id="SPM" value="SINGLE POINT" />
                <ui:option id="CMN" value="COMMENT" />
              </ui:dropdown>
              <ui:dropdown displayText="DB DataType" id="DB_TYPE" name="DB_TYPE">
                <ui:option id="ANY" value="ANY" />
                <ui:option id="DOUBLE" value="DOUBLE" />
                <ui:option id="STRING" value="STRING" />
              </ui:dropdown>
            </ui:field-group>
            <ui:field-group id="RightFields">
              <ui:dropdown displayText="Using" id="USING" selectOne="TRUE" name="USING">
                <ui:option id="NAME" value="NAME" />
                <ui:option id="DESCRIPTION" value="DESCRIPTION" />
              </ui:dropdown>
              <ui:dropdown displayText="Condition" id="CONDITION" name="CONDITION">
                <ui:option id="CONTAINS" value="CONTAINS" />
              </ui:dropdown>
              <ui:entry-field displayText="Search String" id="SEARCH_STRING" name="SEARCH_STRING" doremove="true" />
            </ui:field-group>
          </ui:field-group>
          <ui:buttons id="searchButtons">
            <ui:button displayText="Show Measures" id="SEARCH" name="SEARCH" />
          </ui:buttons>
        </ui:step>
      </ui:container>
      <ui:table id="bottomTable" displayText="Measure List" select="MEASURE" collapsable="false" selectable="Single" scrollable="true" maxRows="$root/MAX_Rows/@Value" displayTextNoRecords="" postRowIdAs="Name" rowId="Name" help="{$pages:managemeasure_help}">
        <ui:help id="bottomTableHelp" />
        <ui:field-group id="tableColumns">
          <ui:link-field sortable="true" name="Name" displayText="Name" id="Name">
            <ui:url page="view.x2ps">
              <measurename select="Name/@Value" />
            </ui:url>
          </ui:link-field>
          <ui:display-field name="Description" displayText="Description" />
          <ui:display-field sortable="true" name="Type" displayText="Type" />
          <ui:display-field sortable="true" name="DB_datatype" displayText="DB datatype" />
          <ui:display-field sortable="true" name="Sign" displayText="Sign" />
        </ui:field-group>
        <ui:buttons id="tableButtons">
          <ui:button displayText="Delete" id="DELETE" name="DELETE" />
          <ui:divider />
          <ui:button displayText="Duplicate" id="DUPLICATE" name="DUPLICATE" enabledBySelections="true" />
          <ui:button displayText="New" id="NEW" name="NEW" />
        </ui:buttons>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:script>function typeCheck()
				{	  
				
			 
		if(document.form.TYPE.value=='CMN')
				{
			
				 
					 
				document.form.DB_TYPE.value="STRING";
	

				
				}
		 }
			 
		
		
		
		function on_DELETE() 
		{
		var measurename;
		for(var i = 0;i &lt; document.form.elements.length; i++)  {
			if (document.form.elements[i].name=="Name") {
			
			if(document.form.elements[i].checked)
			{
			//alert(document.form.elements[i].value);
		measurename=document.form.elements[i].value;
		}
		
		}
		}
		var mess="Are you sure you want to delete measure ";
		var message=mess+measurename;
		var result=core_confirm(message);
				if(result=='yes') {
				  
				 disableButtons();
				 document.form.BUTTON_ID.value = 'DELETE' ; 
				document.form.action = 'view.x2ps';  
				document.form.submit(); 
				 } 
				 onResize(); 
		 return;
		 }</ui:script>
</ui:page-group>

