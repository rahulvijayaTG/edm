<?xml version="1.0" encoding="UTF-8"?>
<workflow mgcCount="240" ShowInBreadCrumbs="true" Version="1.0" Name="ManageAttributeSets" Description="" Type="" PrimaryDocument="" IsStartAllowed="Yes">
  <variables>
    <variable Name="AllAttributesDocVar" Type="xml" Comment=""/>
    <variable Name="DocNames" Type="xml" Comment=""/>
    <variable Name="DocPropertiesVar" Type="xml" Comment=""/>
    <variable Name="attrSetIdDocVar" Type="xml" Comment=""/>
    <variable Name="currentPage" Type="string" Comment=""/>
    <variable Name="displayStringsDocVar" Type="xml" Comment=""/>
    <variable Name="getTablesDocVar" Type="xml" Comment=""/>
    <variable Name="global_availableAttrSet" Type="xml" Comment=""/>
    <variable Name="global_selectedAttrSet" Type="xml" Comment=""/>
    <variable Name="staticTableNamesData" Type="xml" Comment=""/>
    <variable Name="tablesDocVar" Type="xml" Comment=""/>
  </variables>
  <nodes>
    <start Name="start2">
      <actions>
      </actions>
      <next_nodes OutputVar="{,xml}">
        <next_node Name="Manage Attribute Sets" Description=""/>
      </next_nodes>
    </start>
    <done Name="done4">
      <actions>
      </actions>
      <next_nodes/>
    </done>
    <ui_form2 Name="Manage Attribute Sets" OutputFormVar="pglFormOutput" InputFormVar="pglFormInput" ShowInBreadCrumbs="SHOW" Template="ManageAttributeSets.pgl" InputVar="{nodeInputXml,xml}">
      <pre_actions>
        <action>
          <IF_TEST Test="($currentPage/@Value!='ManageAttrSets') or ($currentPage/@Value=null)">
            <THEN>
              <TO_DOCVAR AssignToVar="displayStringsDocVar">
                <DISPLAY_STRINGS>
                </DISPLAY_STRINGS>
              </TO_DOCVAR>
              <TO_DOCVAR AssignToVar="global_availableAttrSet">
                <AVAILABLE_ATTRIBUTES/>
              </TO_DOCVAR>
              <TO_DOCVAR AssignToVar="global_selectedAttrSet">
                <SELECTED_ATTRIBUTES/>
              </TO_DOCVAR>get
      <TO_DOCVAR AssignToVar="attrSetIdDocVar">
                <ATTRIBUTE_SETS/>
              </TO_DOCVAR>
              <TO_DOCVAR AssignToVar="staticTableNamesData">
                <TABLE_NAMES>
                  <OPTION Value="Select"/>
                </TABLE_NAMES>
              </TO_DOCVAR>
              <TO_DOCVAR AssignToVar="tableNames">
                <TABLE_NAMES/>
              </TO_DOCVAR>
              <!-- Getting Document Names for BCM_MASTER -->
              <REQUEST Name="getDocNames" ServiceName="BCM_MASTER" AssignToVar="DocNames"/>
              <PRINTLN Value="Printing DocNames from Command"/>
              <PRINTLN Value="{$DocNames}"/>
              <FOR_EACH SelectList="$DocNames/DOCUMENTS/*" CurrentElement="docName">
                <TO_DOCVAR AssignToVar="eachEntity">
                  <OPTION Value="{$docName/@Name}"/>
                </TO_DOCVAR>
                <ADD_CHILDREN DocVar="tableNames" FromValue="{$eachEntity}"/>
              </FOR_EACH>
              <!-- Sorting Table Names-->
              <SORT DataType="String" Key="@Value" SelectList="$tableNames/*"/>
              <ADD_CHILDREN DocVar="staticTableNamesData" FromSelectList="$tableNames/*"/>
            </THEN>
            <ELSE>
              <SET Var="clickOnCreate" FromValue="FALSE"/>
              <IF_TEST Test="$thisParam/BUTTON_ID/@Value = 'NEW_TABLE_AS_INPUT'">
                <THEN>
                  <REMOVE_CHILDREN DocVar="global_selectedAttrSet" ChildName="COLUMN_DETAIL"/>
                  <REMOVE_CHILDREN DocVar="global_availableAttrSet" ChildName="ATTRIBUTES"/>
                  <SET Var="currentTableName" FromValue="{$thisParam/Tablename/@Value}"/>
                  <!--Get all attribute Sets for selected Table -->
                  <REQUEST Name="getAttributeSets" ServiceName="BCM_MASTER" AssignToVar="AttSetsDocVar">
                    <updatedLogicalTableName Value="{$currentTableName/@Value}"/>
                  </REQUEST>
                  <TO_DOCVAR AssignToVar="attrSetIdDocVar">
                    <ATTRIBUTE_SETS>
                      <TO_XML SelectList="$AttSetsDocVar/*"/>
                    </ATTRIBUTE_SETS>
                  </TO_DOCVAR>
                  <!-- Get all properties of the selected table. This is one time action. Further maintained as pipeline variable  -->
                  <REQUEST Name="getDocProperties" ServiceName="BCM_MASTER" AssignToVar="DocPropertiesVar">
                    <tableName Value="{$currentTableName/@Value}"/>
                  </REQUEST>-->
									<SORT DataType="String" Key="@Name" SelectList="$DocPropertiesVar/*/*"/>
                  <PRINTLN Value="Printing DocPropertiesVar thru Command after Sorting ########.."/>
                  <PRINTLN Value="{$DocPropertiesVar}"/>
                  <!-- AllAttributesDocVar contains only attribute names whereas DocPropertiesVar contains logical name and physical name-->
                  <TO_DOCVAR AssignToVar="AllAttributesDocVar">
                    <SELECTED_TABLE_ATTRIBUTES Value="{$currentTableName}">
                    </SELECTED_TABLE_ATTRIBUTES>
                  </TO_DOCVAR>
                  <FOR_EACH SelectList="$DocPropertiesVar/*/*" CurrentElement="selectedTableProperty">
                    <TO_DOCVAR AssignToVar="selectedTableAttr">
                      <AttrName Value="{$selectedTableProperty/@Name}"/>
                    </TO_DOCVAR>
                    <ADD_CHILDREN DocVar="AllAttributesDocVar" FromValue="{$selectedTableAttr}"/>
                  </FOR_EACH>
                  <!-- Sorting AllAttributesDocVar -->
                  <SORT DataType="String" Key="@Value" SelectList="$AllAttributesDocVar/*"/>
                  <!-- Setting displayStringsDocVar as per count of attributeSets that exists for selected table. This is used as header msg on Attribute Sets container -->
                  <SET DocVar="displayStringsDocVar" Property="ATTRIBUTE_SETS" FromValue="{ifElse(count($attrSetIdDocVar/*)=0,concat('No Attribute Set exists for Table - ',$currentTableName),concat('Attribute Sets for Table - ',$currentTableName))}"/>
                  <SET Var="showAttSetDetails" FromValue="FALSE"/>
                </THEN>
              </IF_TEST>
              <IF_TEST Test="$thisParam/BUTTON_ID/@Value = 'GET_DETAILS_ATTR_SET'">
                <THEN>
                  <SET Var="currentTableName" FromValue="{$thisParam/Tablename/@Value}"/>
                  <SET Var="selectedAttrSetID" FromValue="{$thisParam/attributeSetID/@Value}"/>
                  <!-- Fetch existing selected Attributes for selected attribute Set -->
                  <!-- ############ This part of processing is done once in the end ################# -->
                  <!--  GETTING ALL AVAILABLE ATTRIBUTES. (AVAILABLE ATTRIBUTES = ALL ATTRIBUTES OF TABLE - SELECTED ATTRIBUTES FROM THIS TABLE) -->
                  <!-- ############ This part of processing is done once in the end ################# -->
                  <SET DocVar="displayStringsDocVar" Property="ATTRIBUTES" FromValue="{concat('Attributes for ',$selectedAttrSetID)}"/>
                  <SET Var="showAttSetDetails" FromValue="TRUE"/>
                  <!--<SET Var="actionTaken" FromValue="GET_DETAILS_ATTR_SET"/>-->
                </THEN>
              </IF_TEST>
              <IF_TEST Test="$thisParam/BUTTON_ID/@Value = 'SELECT_AVAIL_ATTR'">
                <THEN>
                  <SET Var="currentTableName" FromValue="{$thisParam/Tablename/@Value}"/>
                  <SET Var="selectedAttrSetID" FromValue="{$thisParam/attributeSetID/@Value}"/>
                  <!-- This DocVar contains all attributes selected by user from Available Attributes List -->
                  <TO_DOCVAR AssignToVar="selAvailAttributes">
                    <SEL_AVAIL_ATTRS>
                    </SEL_AVAIL_ATTRS>
                  </TO_DOCVAR>
                  <ADD_CHILDREN DocVar="selAvailAttributes" FromSelectList="$thisParam/availAttrName"/>
                  <!-- Setting the Details of attributes selected by user from Available Attributes List like Physical Name of Column from DocPropertiesVar-->
                  <TO_DOCVAR AssignToVar="selAttributesDetail">
                    <SEL_ATTRIBUTES_DETAILS/>
                  </TO_DOCVAR>
                  <FOR_EACH SelectList="$selAvailAttributes/*" CurrentElement="selAttr">
                    <TO_DOCVAR AssignToVar="temp">
                      <ATTRIBUTE_DETAIL>
                        <selAttr_logicalName Value="{$selAttr/@Value}"/>
                        <selAttr_physicalName Value="{$DocPropertiesVar/*/*[@Name=$selAttr/@Value]/@ColumnName}"/>
                      </ATTRIBUTE_DETAIL>
                    </TO_DOCVAR>
                    <ADD_CHILDREN DocVar="selAttributesDetail" FromValue="{$temp}"/>
                  </FOR_EACH>
                  <!-- Save Selected Attributes -->
                  <REQUEST Name="saveSelectedAttributes" ServiceName="BCM_MASTER">
                    <attributeSetID Value="{$selectedAttrSetID/@Value}"/>
                    <TO_XML SelectList="$selAttributesDetail"/>
                  </REQUEST>
                  <!-- Fetching Selected Attributes List after persisiting newly selected attributes -->
                  <!-- ############ This part of processing is done once in the end ################# -->
                  <!-- Fetching Available Attributes after persisting selected attributes into DB -->
                  <!-- ############ This part of processing is done once in the end ################# -->
                  <!-- Setting displayStringsDocVar -->
                  <SET DocVar="displayStringsDocVar" Property="ATTRIBUTES" FromValue="{concat('Attributes for ',$selectedAttrSetID)}"/>
                  <SET Var="showAttSetDetails" FromValue="TRUE"/>
                </THEN>
              </IF_TEST>
              <IF_TEST Test="$thisParam/BUTTON_ID/@Value = 'DESELECT_SEL_ATTR'">
                <THEN>
                  <SET Var="currentTableName" FromValue="{$thisParam/Tablename/@Value}"/>
                  <SET Var="selectedAttrSetID" FromValue="{$thisParam/attributeSetID/@Value}"/>
                  <TO_DOCVAR AssignToVar="deselectedAttributes">
                    <DESEL_ATTRS>
                    </DESEL_ATTRS>
                  </TO_DOCVAR>
                  <ADD_CHILDREN DocVar="deselectedAttributes" FromSelectList="$thisParam/selectedAttrName"/>
                  <REQUEST Name="saveDeselectedAttributes" ServiceName="BCM_MASTER">
                    <attributeSetID Value="{$selectedAttrSetID/@Value}"/>
                    <TO_XML SelectList="$deselectedAttributes"/>
                  </REQUEST>
                  <!-- Fetching Selected Attributes List after persisiting newly selected attributes -->
                  <!-- ############ This part of processing is done once in the end ################# -->
                  <!-- Fetching Available Attributes after persisting selected attributes into DB -->
                  <!-- ############ This part of processing is done once in the end ################# -->
                  <!-- Setting displayStringsDocVar -->
                  <SET DocVar="displayStringsDocVar" Property="ATTRIBUTES" FromValue="{concat('Attributes for ',$selectedAttrSetID)}"/>
                  <SET Var="showAttSetDetails" FromValue="TRUE"/>
                </THEN>
              </IF_TEST>
              <IF_TEST Test="$thisParam/BUTTON_ID/@Value = 'CREATE_ATT_SET'">
                <THEN>
                  <SET Var="currentTableName" FromValue="{$thisParam/Tablename/@Value}"/>
                  <!-- Checking if there exist any attribute not selected in any other Attribute Set for this table. If not, then Attribute Set cannot be created -->
                  <REQUEST Name="getAvailableAttributes" ServiceName="BCM_MASTER" AssignToVar="availableAttributesDocVar">
                    <TO_XML DocVar="attrSetIdDocVar"/>
                    <TO_XML DocVar="DocPropertiesVar"/>
                    <tableName Value="{$currentTableName/@Value}"/>
                  </REQUEST>
                  <IF_TEST Test="count($availableAttributesDocVar/*)=0">
                    <THEN>
                      <TO_DOCVAR AssignToVar="MsgDocVar">
                        <MESSAGES Status="ERROR">
                          <MESSAGE Value="Sorry. CANNOT be created as all attributes of selected table are being used by other Attribute Sets."/>
                        </MESSAGES>
                      </TO_DOCVAR>
                    </THEN>
                    <ELSE>
                      <!-- Adding blank row to existing attribute sets DocVar-->
                      <TO_DOCVAR AssignToVar="newAttSetRow">
                        <AttributeSet clickOnCreate="TRUE">
                          <attributeSetID Value=""/>
                          <description Value=""/>
                        </AttributeSet>
                      </TO_DOCVAR>
                      <ADD_CHILDREN DocVar="attrSetIdDocVar" FromValue="{$newAttSetRow}"/>
                      <!-- Emptying Available Attributes DocVar and Selected Attributes DocVar -->
                      <REMOVE_CHILDREN DocVar="global_selectedAttrSet" ChildName="COLUMN_DETAIL"/>
                      <REMOVE_CHILDREN DocVar="global_availableAttrSet" ChildName="ATTRIBUTES"/>
                      <SET Var="clickOnCreate" FromValue="TRUE"/>
                      <SET Var="showAttSetDetails" FromValue="FALSE"/>
                    </ELSE>
                  </IF_TEST>
                </THEN>
              </IF_TEST>
              <IF_TEST Test="$thisParam/BUTTON_ID/@Value = 'CANCEL'">
                <THEN>
                  <!-- This cancels the create action only and fetches the attribute sets for given table again -->
                  <SET Var="currentTableName" FromValue="{$thisParam/Tablename/@Value}"/>
                  <REMOVE_CHILDREN DocVar="global_selectedAttrSet" ChildName="ROW_DATA"/>
                  <REMOVE_CHILDREN DocVar="global_availableAttrSet" ChildName="ROW_DATA"/>
                  <SET Var="showAttSetDetails" FromValue="FALSE"/>
                </THEN>
              </IF_TEST>
              <IF_TEST Test="$thisParam/BUTTON_ID/@Value = 'SAVE'">
                <THEN>
                  <SET Var="currentTableName" FromValue="{$thisParam/Tablename/@Value}"/>
                  <SET Var="newAttrSetID" FromValue="{$thisParam/attributeSetID[@Value != '']/@Value}"/>
                  <SET Var="newAttrSetDesc" FromValue="{$thisParam/description/@Value}"/>
                  <SET Var="currTablePhysicalName" FromValue="{$DocNames/DOCUMENTS/*[@Name=$currentTableName/@Value]/@TableName}"/>
                  <!-- Saving new atttribute set details -->
                  <REQUEST Name="saveAttrSetDetails" ServiceName="BCM_MASTER" AssignToVar="response">
                    <attributeSetID Value="{$newAttrSetID/@Value}"/>
                    <description Value="{$newAttrSetDesc/@Value}"/>
                    <updatedLogicalTableName Value="{$currentTableName/@Value}"/>
                    <updatedPhysicalTableName Value="{$currTablePhysicalName/@Value}"/>
                  </REQUEST>
                  <TO_DOCVAR AssignToVar="MsgDocVar">
                    <MESSAGES>
                    </MESSAGES>
                  </TO_DOCVAR>
                  <SET DocVar="MsgDocVar" FromSelect="$response/MESSAGES"/>
                  <IF_TEST Test="$response/MESSAGES/@Status='SUCCESS'">
                    <THEN>
                      <SET Var="showAttSetDetails" FromValue="TRUE"/>
                      <!-- If saved successfully, then fetch all available attributes and display -->
                      <REQUEST Name="getAvailableAttributes" ServiceName="BCM_MASTER" AssignToVar="availableAttributesDocVar">
                        <TO_XML DocVar="attrSetIdDocVar"/>
                        <TO_XML DocVar="DocPropertiesVar"/>
                        <tableName Value="{$currentTableName/@Value}"/>
                      </REQUEST>
                      <TO_DOCVAR AssignToVar="availableAttrSet">
                        <AVAILABLE_ATTRIBUTES>
                          <TO_XML SelectList="$availableAttributesDocVar/*"/>
                        </AVAILABLE_ATTRIBUTES>
                      </TO_DOCVAR>
                      <SET DocVar="global_availableAttrSet" FromValue="{$availableAttrSet}"/>
                      <REMOVE_CHILDREN DocVar="global_selectedAttrSet" ChildName="ROW_DATA"/>
                      <!-- Setting displayStringsDocVar -->
                      <SET DocVar="displayStringsDocVar" Property="ATTRIBUTES" FromValue="{concat('Attributes for ',$selectedAttrSetID)}"/>
                    </THEN>
                    <ELSE>
                      <SET Var="showAttSetDetails" FromValue="FALSE"/>
                    </ELSE>
                  </IF_TEST>
                  <!-- Fetching Attribute Sets for the given table -->
                </THEN>
              </IF_TEST>
              <IF_TEST Test="$thisParam/BUTTON_ID/@Value = 'DELETE'">
                <THEN>
                  <SET Var="currentTableName" FromValue="{$thisParam/Tablename/@Value}"/>
                  <SET Var="selectedAttrSetID" FromValue="{$thisParam/attributeSetID/@Value}"/>
                  <!-- Check if the selected Attribute set is associated with any Group Class or not. If yes, then DONT delete otherwise delete.-->
                  <REQUEST Name="validateAndDelete" ServiceName="BCM_MASTER" AssignToVar="response">
                    <attributeSetID Value="{$selectedAttrSetID/@Value}"/>
                  </REQUEST>
                  <TO_DOCVAR AssignToVar="MsgDocVar">
                    <MESSAGES>
                    </MESSAGES>
                  </TO_DOCVAR>
                  <SET DocVar="MsgDocVar" FromSelect="$response/MESSAGES"/>
                  <SET Var="showAttSetDetails" FromValue="FALSE"/>
                </THEN>
              </IF_TEST>
            </ELSE>
          </IF_TEST>
          <!-- this part of code fetches attribute sets for the given table for selecetd events -->
          <IF_TEST Test="($thisParam/BUTTON_ID/@Value='DELETE') or ($thisParam/BUTTON_ID/@Value='SAVE') or ($thisParam/BUTTON_ID/@Value='CANCEL')">
            <THEN>
              <REQUEST Name="getAttributeSets" ServiceName="BCM_MASTER" AssignToVar="AttSetsDocVar">
                <updatedLogicalTableName Value="{$currentTableName/@Value}"/>
              </REQUEST>
              <TO_DOCVAR AssignToVar="attrSetIdDocVar">
                <ATTRIBUTE_SETS>
                  <TO_XML SelectList="$AttSetsDocVar/*"/>
                </ATTRIBUTE_SETS>
              </TO_DOCVAR>
            </THEN>
          </IF_TEST>
          <IF_TEST Test="($thisParam/BUTTON_ID/@Value='GET_DETAILS_ATTR_SET') or ($thisParam/BUTTON_ID/@Value='SELECT_AVAIL_ATTR') or ($thisParam/BUTTON_ID/@Value='DESELECT_SEL_ATTR')">
            <THEN>
              <REQUEST Name="getSelectedAttributes" ServiceName="BCM_MASTER" AssignToVar="existingSelectedAttributes">
                <attributeSetID Value="{$selectedAttrSetID/@Value}"/>
              </REQUEST>
              <TO_DOCVAR AssignToVar="tempSelectedAttributes">
                <SELECTED_ATTRIBUTES>
                  <TO_XML SelectList="$existingSelectedAttributes/*"/>
                </SELECTED_ATTRIBUTES>
              </TO_DOCVAR>
              <SET DocVar="global_selectedAttrSet" FromValue="{$tempSelectedAttributes}"/>
              <REQUEST Name="getAvailableAttributes" ServiceName="BCM_MASTER" AssignToVar="availableAttributesDocVar">
                <TO_XML DocVar="attrSetIdDocVar"/>
                <TO_XML DocVar="DocPropertiesVar"/>
                <tableName Value="{$currentTableName/@Value}"/>
              </REQUEST>
              <TO_DOCVAR AssignToVar="availableAttrSet">
                <AVAILABLE_ATTRIBUTES>
                  <TO_XML SelectList="$availableAttributesDocVar/*"/>
                </AVAILABLE_ATTRIBUTES>
              </TO_DOCVAR>
              <SET DocVar="global_availableAttrSet" FromValue="{$availableAttrSet}"/>
            </THEN>
          </IF_TEST>
          <TO_DOCVAR AssignToVar="pglFormInput">
            <this>
              <TO_XML DocVar="displayStringsDocVar"/>
              <TO_XML DocVar="MsgDocVar"/>
              <TO_XML SelectList="$attrSetIdDocVar"/>
              <TO_XML SelectList="$staticTableNamesData"/>
              <TO_XML SelectList="$global_availableAttrSet"/>
              <TO_XML SelectList="$global_selectedAttrSet"/>
              <clickOnCreate Value="{$clickOnCreate/@Value}"/>
              <Tablename Value="{$currentTableName/@Value}"/>
              <showAttSetDetails Value="{$showAttSetDetails/@Value}"/>
              <actionTaken Value="{$thisParam/BUTTON_ID/@Value}"/>
            </this>
          </TO_DOCVAR>
        </action>
      </pre_actions>
      <post_actions>
        <action>
          <SET Var="currentPage" FromValue="ManageAttrSets"/>
          <SET Var="userAction" FromValue="SAMEPAGE"/>
        </action>
      </post_actions>
      <if_cond Value="$userAction='SAMEPAGE'">
        <next_nodes OutputVar="{pglFormOutput,xml}">
          <next_node Name="Manage Attribute Sets" Description=""/>
        </next_nodes>
      </if_cond>
      <else_if_cond Value="$userAction ='getDetails'">
        <next_nodes OutputVar="{outputXml,xml}"/>
      </else_if_cond>
      <else_if_cond Value="$userAction ='createAttrSet'">
        <next_nodes OutputVar="{outputXml,xml}"/>
      </else_if_cond>
      <else_if_cond Value="$userAction ='save'">
        <next_nodes OutputVar="{outputXml,xml}"/>
      </else_if_cond>
      <else_if_cond Value="$userAction ='delete'">
        <next_nodes OutputVar="{outputXml,xml}"/>
      </else_if_cond>
      <else_if_cond Value="$userAction ='cancel'">
        <next_nodes OutputVar="{outputXml,xml}"/>
      </else_if_cond>
      <else_if_cond Value="$userAction ='selectAvailAttr'">
        <next_nodes OutputVar="{outputXml,xml}"/>
      </else_if_cond>
      <else_if_cond Value="$userAction ='deselectSelAttr'">
        <next_nodes OutputVar="{outputXml,xml}"/>
      </else_if_cond>
      <else_if_cond Value="$userAction ='GET_DETAILS_ATTR_SET'">
        <next_nodes OutputVar="{outputXml,xml}"/>
      </else_if_cond>
      <else_if_cond Value="$userAction ='CREATE_ATT_SET'">
        <next_nodes OutputVar="{outputXml,xml}"/>
      </else_if_cond>
      <else_if_cond Value="$userAction ='SAVE'">
        <next_nodes OutputVar="{outputXml,xml}"/>
      </else_if_cond>
      <else_if_cond Value="$userAction ='DELETE'">
        <next_nodes OutputVar="{outputXml,xml}"/>
      </else_if_cond>
      <else_if_cond Value="$userAction ='CANCEL'">
        <next_nodes OutputVar="{outputXml,xml}"/>
      </else_if_cond>
      <else_if_cond Value="true()">
        <next_nodes OutputVar="{outputXml,xml}">
          <next_node Name="done4" Description=""/>
        </next_nodes>
      </else_if_cond>
    </ui_form2>
  </nodes>
