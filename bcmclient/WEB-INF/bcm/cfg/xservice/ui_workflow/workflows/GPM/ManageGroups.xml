<?xml version="1.0" encoding="UTF-8"?>
<workflow mgcCount="362" ShowInBreadCrumbs="true" Version="1.0" Name="ManageGroups" Description="" Type="" PrimaryDocument="" IsStartAllowed="Yes">
  <variables>
    <variable Name="availableMemberDataVar" Type="xml" Comment=""/>
    <variable Name="currentPage" Type="string" Comment=""/>
    <variable Name="displayStringsDocVar" Type="xml" Comment=""/>
    <variable Name="dynamicGroupClassDocVar" Type="xml" Comment=""/>
    <variable Name="dynamicGroupInstanceDocVar" Type="xml" Comment=""/>
    <variable Name="global_availableMembers" Type="xml" Comment=""/>
    <variable Name="global_groupDesc" Type="string" Comment=""/>
    <variable Name="global_groupName" Type="string" Comment=""/>
    <variable Name="global_selectedMembers" Type="xml" Comment=""/>
    <variable Name="startCountDocVar" Type="xml" Comment=""/>
    <variable Name="staticGroupDimDocVar" Type="xml" Comment=""/>
  </variables>
  <nodes>
    <done Name="done2">
      <actions>
      </actions>
      <next_nodes/>
    </done>
    <start Name="start4">
      <actions>
      </actions>
      <next_nodes OutputVar="{,xml}">
        <next_node Name="Manage Groups" Description=""/>
      </next_nodes>
    </start>
    <ui_form2 Name="Manage Groups" OutputFormVar="pglFormOutput" InputFormVar="pglFormInput" ShowInBreadCrumbs="SHOW" Template="ManageGroups.pgl" InputVar="{nodeInputXml,xml}">
      <pre_actions>
        <action>
          <IF_TEST Test="($currentPage/@Value!='ManageGroups') or ($currentPage/@Value=null)">
            <THEN>
              <SET Var="global_groupName" FromValue=""/>
              <SET Var="global_groupDesc" FromValue=""/>
              <PRINTLN Value="Printing ENABLED !!!!!!!"/>
              <TO_DOCVAR AssignToVar="startCountDocVar">
                <START_COUNTS>
                  <startRow_GroupInstances Value="0"/>
                  <startRow_SelectedMembers Value="0"/>
                  <startRow_AvailableMembers Value="0"/>
                </START_COUNTS>
              </TO_DOCVAR>
              <TO_DOCVAR AssignToVar="displayStringsDocVar">
                <DISPLAY_STRINGS/>
              </TO_DOCVAR>
              <TO_DOCVAR AssignToVar="staticGroupDimDocVar">
                <GROUP_DIMENSIONS>
                  <groupDimension Value="Select"/>
                </GROUP_DIMENSIONS>
              </TO_DOCVAR>
              <TO_DOCVAR AssignToVar="dynamicGroupClassDocVar">
                <GROUP_CLASSES>
                  <groupClassID Value="Select"/>
                </GROUP_CLASSES>
              </TO_DOCVAR>
              <TO_DOCVAR AssignToVar="dynamicGroupInstanceDocVar">
                <GROUP_INSTANCES/>
              </TO_DOCVAR>
              <TO_DOCVAR AssignToVar="global_availableMembers">
                <AVAIL_MEMBERS/>
              </TO_DOCVAR>
              <TO_DOCVAR AssignToVar="global_selectedMembers">
                <SELECTED_MEMBERS/>
              </TO_DOCVAR>
              <!-- Populate the Group Dimension dropdown on Page Load -->
              <GET_DOCUMENT Name="ValidGroupDimensions" AssignToVar="groupDimensions" ServiceName="BCM_MASTER"/>
              <IF_TEST Test="count($groupDimensions/*) != 0">
                <THEN>
                  <ADD_CHILDREN DocVar="staticGroupDimDocVar" FromSelectList="$groupDimensions/ValidGroupDimensions/groupDimension"/>
                </THEN>
              </IF_TEST>
              <TO_DOCVAR AssignToVar="pglFormInput">
                <this>
                  <showGroupResults Value="FALSE"/>
                  <showMembers Value="FALSE"/>
                  <showParams Value="FALSE"/>
                  <TO_XML DocVar="staticGroupDimDocVar"/>
                  <TO_XML DocVar="dynamicGroupClassDocVar"/>
                  <TO_XML DocVar="dynamicGroupInstanceDocVar"/>
                </this>
              </TO_DOCVAR>
            </THEN>
            <ELSE>
              <SET Var="selectedGroupDimension" FromValue="{$thisParam/groupDimension/@Value}"/>
              <SET Var="selectedGroupClass" FromValue="{$thisParam/groupClass/@Value}"/>
              <SET Var="selectedGroupInstance" FromValue="{$thisParam/groupID5/@Value}"/>
              <SET Var="actionTaken" FromValue="{$thisParam/BUTTON_ID/@Value}"/>
              <SET Var="dimPhysicalTableName" FromValue="{$thisParam/dimPhysicalTableName/@Value}"/>
              <SET Var="dimPhysicalKeyColumns" FromValue="{$thisParam/dimPhysicalKeyColumns/@Value}"/>
              <SET Var="showGroupResults" FromValue="FALSE"/>
              <SET Var="showMembers" FromValue="FALSE"/>
              <SET Var="showParams" FromValue="FALSE"/>
              <SET Var="clickOnCreate" FromValue="FALSE"/>
              <IF_TEST Test="$thisParam/BUTTON_ID/@Value = 'SYS_RELOAD'">
                <THEN>
                  <SET Var="startRow_GroupInstances" FromValue="{ifElse($thisParam/START_COUNT/@Value = null, '0', $thisParam/START_COUNT/@Value)}"/>
                  <SET Var="startRow_AvailableMembers" FromValue="{ifElse($thisParam/AvailableMembersTable_START_COUNT/@Value = null, '0', $thisParam/AvailableMembersTable_START_COUNT/@Value)}"/>
                  <SET Var="startRow_SelectedMembers" FromValue="{ifElse($thisParam/SelectedMembersTable_START_COUNT/@Value = null, '0', $thisParam/SelectedMembersTable_START_COUNT/@Value)}"/>
                  <SET Var="showGroupResults" FromValue="{$thisParam/showGroupResults/@Value}"/>
                  <SET Var="showMembers" FromValue="{$thisParam/showMembers/@Value}"/>
                  <SET Var="showParams" FromValue="{$thisParam/showParams/@Value}"/>
                  <TO_DOCVAR AssignToVar="startCounts_thisParam">
                    <START_COUNTS_THIS_PARAM>
                      <startRow_GroupInstances Value="{$startRow_GroupInstances}"/>
                      <startRow_AvailableMembers Value="{$startRow_AvailableMembers}"/>
                      <startRow_SelectedMembers Value="{$startRow_SelectedMembers}"/>
                    </START_COUNTS_THIS_PARAM>
                  </TO_DOCVAR>
                  <REQUEST Name="getTableFor_SYS_RELOAD" ServiceName="BCM_MASTER" AssignToVar="tableChangedForSYS_RELOAD">
                    <TO_XML DocVar="startCountDocVar"/>
                    <TO_XML DocVar="startCounts_thisParam"/>
                  </REQUEST>
                  <SET Var="grp_name" FromValue="{ifElse($global_groupName/@Value='','%',$global_groupName/@Value)}"/>
                  <SET Var="grp_desc" FromValue="{ifElse($global_groupDesc/@Value='','%',$global_groupDesc/@Value)}"/>
                  <!-- IF PAGINATION IS DONE ON GROUP_INSTANCES TABLE -->
                  <IF_TEST Test="$tableChangedForSYS_RELOAD/PAGINATED_TABLE_START_COUNT/@Value = 'startRow_GroupInstances'">
                    <THEN>
                      <REQUEST Name="getAllGroupInstances" ServiceName="BCM_MASTER" AssignToVar="groupInstanceDocVar">
                        <startRow Value="{$startRow_GroupInstances/@Value}"/>
                        <groupClassID Value="{$selectedGroupClass/@Value}"/>
                        <groupName Value="{$grp_name/@Value}"/>
                        <groupDesc Value="{$grp_desc/@Value}"/>
                      </REQUEST>
                      <TO_DOCVAR AssignToVar="groupInstances">
                        <GROUP_INSTANCES TotalRowCount="{$groupInstanceDocVar/@TotalRowCount}">
                          <TO_XML SelectList="$groupInstanceDocVar/*"/>
                        </GROUP_INSTANCES>
                      </TO_DOCVAR>
                      <SET DocVar="displayStringsDocVar" Property="GROUP_INSTANCES" FromValue="{concat('Group Instances for - ',$selectedGroupClass)}"/>
                      <SET DocVar="dynamicGroupInstanceDocVar" FromDocVar="groupInstances"/>
                      <SET DocVar="startCountDocVar" Property="startRow_GroupInstances" FromValue="{$startRow_GroupInstances}"/>
                      <SET Var="showMembers" FromValue="FALSE"/>
                      <SET Var="showParams" FromValue="FALSE"/>
                    </THEN>
                  </IF_TEST>
                  <!-- IF PAGINATION IS DONE ON AVAILABLE_MEMBERS TABLE -->
                  <IF_TEST Test="$tableChangedForSYS_RELOAD/PAGINATED_TABLE_START_COUNT/@Value = 'startRow_AvailableMembers'">
                    <THEN>
                      <REQUEST Name="getAvailableMembers" AssignToVar="availableMemberDataVar" ServiceName="BCM_MASTER">
                        <startRow Value="{$startRow_AvailableMembers}"/>
                        <dimPhysicalKeyColumns Value="{$dimPhysicalKeyColumns}"/>
                        <dimPhysicalTableName Value="{$dimPhysicalTableName}"/>
                        <selectedGroupClass Value="{$selectedGroupClass}"/>
                      </REQUEST>
                      <TO_DOCVAR AssignToVar="availMemDocVar">
                        <AVAIL_MEMBERS TotalRowCount="{$availableMemberDataVar/@TotalRowCount}">
                          <TO_XML SelectList="$availableMemberDataVar/*"/>
                        </AVAIL_MEMBERS>
                      </TO_DOCVAR>
                      <SET DocVar="global_availableMembers" FromDocVar="availMemDocVar"/>
                      <SET DocVar="startCountDocVar" Property="startRow_AvailableMembers" FromValue="{$startRow_AvailableMembers}"/>
                    </THEN>
                  </IF_TEST>
                  <!-- IF PAGINATION IS DONE ON SELECTED_MEMBERS TABLE -->
                  <IF_TEST Test="$tableChangedForSYS_RELOAD/PAGINATED_TABLE_START_COUNT/@Value = 'startRow_SelectedMembers'">
                    <THEN>
                      <REQUEST Name="getGroupMembersForGrpInstance" ServiceName="BCM_MASTER" AssignToVar="groupMembersForSelectedInstance">
                        <startRow Value="{$startRow_SelectedMembers/@Value}"/>
                        <groupID Value="{$selectedGroupInstance/@Value}"/>
                      </REQUEST>
                      <TO_DOCVAR AssignToVar="selectedMembersDocVar">
                        <SELECTED_MEMBERS TotalRowCount="{$groupMembersForSelectedInstance/@TotalRowCount}">
                          <TO_XML SelectList="$groupMembersForSelectedInstance/*"/>
                        </SELECTED_MEMBERS>
                      </TO_DOCVAR>
                      <SET DocVar="global_selectedMembers" FromDocVar="selectedMembersDocVar"/>
                      <SET DocVar="startCountDocVar" Property="startRow_SelectedMembers" FromValue="{$startRow_SelectedMembers}"/>
                    </THEN>
                  </IF_TEST>
                </THEN>
              </IF_TEST>
              <IF_TEST Test="$thisParam/BUTTON_ID/@Value = 'SHOW_PARAMS'">
                <THEN>
                  <REQUEST Name="getParamsDetailsForGrpInstance" ServiceName="BCM_MASTER" AssignToVar="paramsDocVar">
                    <groupID Value="{$selectedGroupInstance/@Value}"/>
                  </REQUEST>
                  <TO_DOCVAR AssignToVar="GrpInstanceParameters">
                    <PARAMETERS>
                      <TO_XML SelectList="$paramsDocVar/*"/>
                    </PARAMETERS>
                  </TO_DOCVAR>
                  <SET DocVar="displayStringsDocVar" Property="PARAMETERS" FromValue="{concat('Parameter Values for ',$selectedGroupInstance)}"/>
                  <SET Var="showGroupResults" FromValue="TRUE"/>
                  <SET Var="showParams" FromValue="TRUE"/>
                </THEN>
              </IF_TEST>
              <IF_TEST Test="$thisParam/BUTTON_ID/@Value = 'SAVE_PARAMETERS'">
                <THEN>
                  <TO_DOCVAR AssignToVar="ParameterNames">
                    <PARAMETER_NAME_VALUE_PAIRS>
                      <INPUT>
                        <TO_XML SelectList="$thisParam/POST_PARAM_NAME_AS"/>
                        <TO_XML SelectList="$thisParam/param_value"/>
                      </INPUT>
                      <COLLATE_LIST Value="PARAM_DETAILS">
                        <POST_PARAM_NAME_AS/>
                        <param_value/>
                      </COLLATE_LIST>
                    </PARAMETER_NAME_VALUE_PAIRS>
                  </TO_DOCVAR>
                  <COLLATE_XML DocVar="ParameterNames" AssignToVar="collatedParams"/>
                  <REQUEST Name="saveParams" ServiceName="BCM_MASTER" AssignToVar="response">
                    <groupID Value="{$selectedGroupInstance/@Value}"/>
                    <TO_XML SelectList="$collatedParams"/>
                  </REQUEST>
                  <TO_DOCVAR AssignToVar="MsgDocVar">
                    <MESSAGES/>
                  </TO_DOCVAR>
                  <SET DocVar="MsgDocVar" FromSelect="$response/MESSAGES"/>
                  <REQUEST Name="getParamsDetailsForGrpInstance" ServiceName="BCM_MASTER" AssignToVar="paramsDocVar">
                    <groupID Value="{$selectedGroupInstance/@Value}"/>
                  </REQUEST>
                  <TO_DOCVAR AssignToVar="GrpInstanceParameters">
                    <PARAMETERS>
                      <TO_XML SelectList="$paramsDocVar/*"/>
                    </PARAMETERS>
                  </TO_DOCVAR>
                  <SET DocVar="displayStringsDocVar" Property="PARAMETERS" FromValue="{concat('Parameter Values for ',$selectedGroupInstance)}"/>
                  <SET Var="showParams" FromValue="TRUE"/>
                  <SET Var="showGroupResults" FromValue="TRUE"/>
                </THEN>
              </IF_TEST>
              <IF_TEST Test="$thisParam/BUTTON_ID/@Value = 'CREATE_GRP_INST'">
                <THEN>
                  <SET Var="grp_name" FromValue="{ifElse($global_groupName/@Value='','%',$global_groupName/@Value)}"/>
                  <SET Var="grp_desc" FromValue="{ifElse($global_groupDesc/@Value='','%',$global_groupDesc/@Value)}"/>
                  <SET Var="startRow_GroupInstances" FromValue="{$thisParam/START_COUNT/@Value}"/>
                  <REQUEST Name="getAllGroupInstances" ServiceName="BCM_MASTER" AssignToVar="groupInstanceDocVar">
                    <startRow Value="{$startRow_GroupInstances/@Value}"/>
                    <groupClassID Value="{$selectedGroupClass/@Value}"/>
                    <groupName Value="{$grp_name/@Value}"/>
                    <groupDesc Value="{$grp_desc/@Value}"/>
                  </REQUEST>
                  <SET Var="totalRowCount" FromValue="{int(int($groupInstanceDocVar/@TotalRowCount)+1)}"/>
                  <TO_DOCVAR AssignToVar="groupInstances">
                    <GROUP_INSTANCES TotalRowCount="{$totalRowCount}">
                      <TO_XML SelectList="$groupInstanceDocVar/*"/>
                      <GroupMaster clickOnCreate="TRUE">
                        <groupID Value=""/>
                        <description Value=""/>
                        <groupClassID Value=""/>
                        <name Value=""/>
                      </GroupMaster>
                    </GROUP_INSTANCES>
                  </TO_DOCVAR>
                  <SET DocVar="dynamicGroupInstanceDocVar" FromDocVar="groupInstances"/>
                  <SET Var="clickOnCreate" FromValue="TRUE"/>
                  <SET Var="showGroupResults" FromValue="TRUE"/>
                </THEN>
              </IF_TEST>
              <IF_TEST Test="$thisParam/BUTTON_ID/@Value = 'SAVE_GRP_INSTANCE'">
                <THEN>
                  <SET Var="newGroupID" FromValue="{$thisParam/groupID/@Value}"/>
                  <SET Var="newGroupName" FromValue="{$thisParam/name/@Value}"/>
                  <SET Var="newGroupDesc" FromValue="{$thisParam/description/@Value}"/>
                  <SET Var="newGroupClassID" FromValue="{$thisParam/groupClassID/@Value}"/>
                  <!-- Performing Save -->
                  <REQUEST Name="saveGroupInstanceDetails" ServiceName="BCM_MASTER" AssignToVar="response">
                    <groupID Value="{$newGroupID/@Value}"/>
                    <name Value="{$newGroupName/@Value}"/>
                    <description Value="{$newGroupDesc/@Value}"/>
                    <groupClassID Value="{$selectedGroupClass/@Value}"/>
                  </REQUEST>
                  <TO_DOCVAR AssignToVar="MsgDocVar">
                    <MESSAGES>
                    </MESSAGES>
                  </TO_DOCVAR>
                  <SET DocVar="MsgDocVar" FromSelect="$response/MESSAGES"/>
                  <!-- do the getDoc on GroupMaster table for newly added GroupInstance and add it to the workflow variable dynamicGroupInstanceDocVar  !! -->
                  <SET Var="grp_name" FromValue="{ifElse($global_groupName/@Value='','%',$global_groupName/@Value)}"/>
                  <SET Var="grp_desc" FromValue="{ifElse($global_groupDesc/@Value='','%',$global_groupDesc/@Value)}"/>
                  <SET Var="startRow_GroupInstances" FromValue="{$thisParam/START_COUNT/@Value}"/>
                  <REQUEST Name="getAllGroupInstances" ServiceName="BCM_MASTER" AssignToVar="GroupInstancesDocVar">
                    <startRow Value="{$startRow_GroupInstances/@Value}"/>
                    <groupClassID Value="{$selectedGroupClass/@Value}"/>
                    <groupName Value="{$grp_name/@Value}"/>
                    <groupDesc Value="{$grp_desc/@Value}"/>
                  </REQUEST>
                  <TO_DOCVAR AssignToVar="grpInstDocVar">
                    <GROUP_INSTANCES TotalRowCount="{$GroupInstancesDocVar/@TotalRowCount}">
                      <TO_XML SelectList="$GroupInstancesDocVar/*"/>
                    </GROUP_INSTANCES>
                  </TO_DOCVAR>
                  <SET DocVar="dynamicGroupInstanceDocVar" FromDocVar="grpInstDocVar"/>
                  <SET Var="showGroupResults" FromValue="TRUE"/>
                  <SET Var="selectedGroupInstance" FromValue="{$newGroupID/@Value}"/>
                </THEN>
              </IF_TEST>
              <IF_TEST Test="$thisParam/BUTTON_ID/@Value = 'DELETE'">
                <THEN>
                  <SET Var="" FromValue="{$thisParam/groupID5}"/>
                  <REQUEST Name="validateAndDeleteGroupInstance" ServiceName="BCM_MASTER" AssignToVar="response">
                    <groupID Value="{$selectedGroupInstance/@Value}"/>
                  </REQUEST>
                  <TO_DOCVAR AssignToVar="MsgDocVar">
                    <MESSAGES>
                    </MESSAGES>
                  </TO_DOCVAR>
                  <SET DocVar="MsgDocVar" FromSelect="$response/MESSAGES"/>
                  <SET Var="grp_name" FromValue="{ifElse($global_groupName/@Value='','%',$global_groupName/@Value)}"/>
                  <SET Var="grp_desc" FromValue="{ifElse($global_groupDesc/@Value='','%',$global_groupDesc/@Value)}"/>
                  <SET Var="startRow_GroupInstances" FromValue="0"/>
                  <SET DocVar="thisParam" Property="START_COUNT" FromValue="0"/>
                  <PRINTLN Value="Printing thisParam after setting.."/>
                  <PRINTLN Value="{$thisParam}"/>
                  <REQUEST Name="getAllGroupInstances" ServiceName="BCM_MASTER" AssignToVar="groupInstanceDocVar">
                    <startRow Value="{$startRow_GroupInstances/@Value}"/>
                    <groupClassID Value="{$selectedGroupClass/@Value}"/>
                    <groupName Value="{$grp_name/@Value}"/>
                    <groupDesc Value="{$grp_desc/@Value}"/>
                  </REQUEST>
                  <SET Var="totalRowCount" FromValue="{$groupInstanceDocVar/@TotalRowCount}"/>
                  <TO_DOCVAR AssignToVar="groupInstances">
                    <GROUP_INSTANCES TotalRowCount="{$groupInstanceDocVar/@TotalRowCount}">
                      <TO_XML SelectList="$groupInstanceDocVar/*"/>
                    </GROUP_INSTANCES>
                  </TO_DOCVAR>
                  <SET DocVar="dynamicGroupInstanceDocVar" FromDocVar="groupInstances"/>
                  <SET DocVar="startCountDocVar" Property="startRow_GroupInstances" FromValue="{$startRow_GroupInstances}"/>
                  <SET Var="showGroupResults" FromValue="TRUE"/>
                </THEN>
              </IF_TEST>
              <IF_TEST Test="$thisParam/BUTTON_ID/@Value = 'SHOW_MEMBERS'">
                <THEN>
                  <!--(i) Get all the selected Members from table GroupMember and store them in global_selectedMembers
						(ii) Get all the ItemIDs from the database and remove those which are there in the global_selectedMembers.. or in the instances of the same GroupClass. The filtered ones will be saved to the global_availableMembers -->
                  <!-- Step (i) -->
                  <SET Var="startRow_SelectedMembers" FromValue="{$thisParam/SelectedMembersTable_START_COUNT/@Value}"/>
                  <REQUEST Name="getGroupMembersForGrpInstance" ServiceName="BCM_MASTER" AssignToVar="groupMembersForSelectedInstance">
                    <startRow Value="{$startRow_SelectedMembers/@Value}"/>
                    <groupID Value="{$selectedGroupInstance/@Value}"/>
                  </REQUEST>
                  <TO_DOCVAR AssignToVar="selectedMembersDocVar">
                    <SELECTED_MEMBERS TotalRowCount="{$groupMembersForSelectedInstance/@TotalRowCount}">
                      <TO_XML SelectList="$groupMembersForSelectedInstance/*"/>
                    </SELECTED_MEMBERS>
                  </TO_DOCVAR>
                  <SET DocVar="global_selectedMembers" FromDocVar="selectedMembersDocVar"/>
                  <SET DocVar="startCountDocVar" Property="startRow_SelectedMembers" FromValue="{$startRow_SelectedMembers}"/>
                  <!-- Step(ii) -->
                  <!-- ##############################################################################################################
							THIS GET_DOC_SMART WILL BE DONE ON THAT TABLE WHICH IS THE ROOT TABLE FOR THE GIVEN DIMENSION AND THERE
							WILL BE AN ADDITIONAL COLUMN IN ValidGroupDimensions Table which will be Primary Key of that ROOT TABLE
						############################################################################################################## -->
                  <!--  CODE AFTER CHANGE IN SCHEMA..CONSIDERING DIMENSION TABLE NAME AND KEY COLUMN NAME EXISTS IN ValidGroupDimensions table -->
                  <REQUEST Name="getGroupClassDimension" ServiceName="BCM_MASTER" AssignToVar="GroupClassDimVar">
                    <groupClassID Value="{$selectedGroupClass/@Value}"/>
                  </REQUEST>
                  <REQUEST Name="getGroupDimensionTable" ServiceName="BCM_MASTER" AssignToVar="GrpDimTableVar">
                    <groupDimension Value="{$GroupClassDimVar/GroupClass/groupDimension/@Value}"/>
                  </REQUEST>
                  <SET Var="dimPhysicalTableName" FromValue="{$GrpDimTableVar/ValidGroupDimensions/dimensionPhysicalTableName/@Value}"/>
                  <SET Var="dimPhysicalKeyColumns" FromValue="{$GrpDimTableVar/ValidGroupDimensions/physicalKeyColumns/@Value}"/>
                  <SET Var="startRow_AvailableMembers" FromValue="{ifElse($thisParam/AvailableMembersTable_START_COUNT/@Value = null, '0', $thisParam/AvailableMembersTable_START_COUNT/@Value)}"/>
                  <REQUEST Name="getAvailableMembers" AssignToVar="availableMemberDataVar" ServiceName="BCM_MASTER">
                    <startRow Value="{$startRow_AvailableMembers}"/>
                    <dimPhysicalKeyColumns Value="{$dimPhysicalKeyColumns}"/>
                    <dimPhysicalTableName Value="{$dimPhysicalTableName}"/>
                    <selectedGroupClass Value="{$selectedGroupClass}"/>
                  </REQUEST>
                  <TO_DOCVAR AssignToVar="availMemDocVar">
                    <AVAIL_MEMBERS TotalRowCount="{$availableMemberDataVar/@TotalRowCount}">
                      <TO_XML SelectList="$availableMemberDataVar/*"/>
                    </AVAIL_MEMBERS>
                  </TO_DOCVAR>
                  <SET DocVar="global_availableMembers" FromDocVar="availMemDocVar"/>
                  <SET DocVar="startCountDocVar" Property="startRow_AvailableMembers" FromValue="{$startRow_AvailableMembers}"/>
                  <SET DocVar="displayStringsDocVar" Property="MEMBERS" FromValue="{concat('Group Members for ',$selectedGroupInstance)}"/>
                  <SET Var="showGroupResults" FromValue="TRUE"/>
                  <SET Var="showMembers" FromValue="TRUE"/>
                </THEN>
              </IF_TEST>
              <IF_TEST Test="$thisParam/BUTTON_ID/@Value = 'AVAIL_TO_SELECT'">
                <THEN>
                  <!-- (i) Save the selected Items in Group Member Table and update the global_availableMembers and global_selectedMembers DocVar-->
                  <TO_DOCVAR AssignToVar="selectedAvailableMembers">
                    <SEL_AVAIL_MEMBERS>
                      <TO_XML SelectList="$thisParam/AVAILMEMBER"/>
                    </SEL_AVAIL_MEMBERS>
                  </TO_DOCVAR>
                  <PRINTLN Value="Printing SEL_AVAIL_MEMBERS..."/>
                  <PRINTLN Value="{$selectedAvailableMembers}"/>
                  <REQUEST Name="saveSelectedMembers" ServiceName="BCM_MASTER">
                    <groupID Value="{$selectedGroupInstance/@Value}"/>
                    <groupClassID Value="{$selectedGroupClass/@Value}"/>
                    <TO_XML DocVar="selectedAvailableMembers"/>
                  </REQUEST>
                  <!-- get selected members from database -->
                  <SET Var="startRow_SelectedMembers" FromValue="{$thisParam/SelectedMembersTable_START_COUNT/@Value}"/>
                  <REQUEST Name="getGroupMembersForGrpInstance" ServiceName="BCM_MASTER" AssignToVar="groupMembersForSelectedInstance">
                    <startRow Value="{$startRow_SelectedMembers/@Value}"/>
                    <groupID Value="{$selectedGroupInstance/@Value}"/>
                  </REQUEST>
                  <TO_DOCVAR AssignToVar="selectedMembersDocVar">
                    <SELECTED_MEMBERS TotalRowCount="{$groupMembersForSelectedInstance/@TotalRowCount}">
                      <TO_XML SelectList="$groupMembersForSelectedInstance/*"/>
                    </SELECTED_MEMBERS>
                  </TO_DOCVAR>
                  <SET DocVar="global_selectedMembers" FromDocVar="selectedMembersDocVar"/>
                  <SET DocVar="startCountDocVar" Property="startRow_SelectedMembers" FromValue="{$startRow_SelectedMembers}"/>
                  <!-- Fetching Available Members -->
                  <!--<TO_DOCVAR AssignToVar="newAvailableMembers">
                    <AVAIL_MEMBERS/>
                  </TO_DOCVAR>-->
                  <SET Var="startRow_AvailableMembers" FromValue="0"/>
                  <SET DocVar="thisParam" Property="AvailableMembersTable_START_COUNT" FromValue="0"/>
                  <REQUEST Name="getAvailableMembers" AssignToVar="availableMemberDataVar" ServiceName="BCM_MASTER">
                    <startRow Value="{$startRow_AvailableMembers}"/>
                    <dimPhysicalKeyColumns Value="{$dimPhysicalKeyColumns}"/>
                    <dimPhysicalTableName Value="{$dimPhysicalTableName}"/>
                    <selectedGroupClass Value="{$selectedGroupClass}"/>
                  </REQUEST>
                  <TO_DOCVAR AssignToVar="availMemDocVar">
                    <AVAIL_MEMBERS TotalRowCount="{$availableMemberDataVar/@TotalRowCount}">
                      <TO_XML SelectList="$availableMemberDataVar/*"/>
                    </AVAIL_MEMBERS>
                  </TO_DOCVAR>
                  <SET DocVar="global_availableMembers" FromDocVar="availMemDocVar"/>
                  <SET DocVar="startCountDocVar" Property="startRow_AvailableMembers" FromValue="{$startRow_AvailableMembers}"/>
                  <SET Var="showGroupResults" FromValue="TRUE"/>
                  <SET Var="showMembers" FromValue="TRUE"/>
                </THEN>
              </IF_TEST>
              <IF_TEST Test="$thisParam/BUTTON_ID/@Value = 'SELECT_TO_AVAIL'">
                <THEN>
                  <TO_DOCVAR AssignToVar="deselectedMembers">
                    <DESEL_MEMBERS>
                      <TO_XML SelectList="$thisParam/selectedMember"/>
                    </DESEL_MEMBERS>
                  </TO_DOCVAR>
                  <REQUEST Name="saveDeselectedMembers" ServiceName="BCM_MASTER">
                    <groupID Value="{$selectedGroupInstance/@Value}"/>
                    <TO_XML DocVar="deselectedMembers"/>
                  </REQUEST>
                  <!--  ################# UPDATING SELECTED MEMBERS WORKFLOW VARIABLE ######################-->
                  <SET Var="startRow_SelectedMembers" FromValue="0"/>
                  <SET DocVar="thisParam" Property="SelectedMembersTable_START_COUNT" FromValue="0"/>
                  <REQUEST Name="getGroupMembersForGrpInstance" ServiceName="BCM_MASTER" AssignToVar="groupMembersForSelectedInstance">
                    <startRow Value="{$startRow_SelectedMembers/@Value}"/>
                    <groupID Value="{$selectedGroupInstance/@Value}"/>
                  </REQUEST>
                  <TO_DOCVAR AssignToVar="selectedMembersDocVar">
                    <SELECTED_MEMBERS TotalRowCount="{$groupMembersForSelectedInstance/@TotalRowCount}">
                      <TO_XML SelectList="$groupMembersForSelectedInstance/*"/>
                    </SELECTED_MEMBERS>
                  </TO_DOCVAR>
                  <SET DocVar="global_selectedMembers" FromDocVar="selectedMembersDocVar"/>
                  <SET DocVar="startCountDocVar" Property="startRow_SelectedMembers" FromValue="{$startRow_SelectedMembers}"/>
                  <!--  ################# UPDATING AVAILABLE MEMBERS WORKFLOW VARIABLE ######################-->
                  <!-- <TO_DOCVAR AssignToVar="newAvailableMembers">
                    <AVAIL_MEMBERS/>
                  </TO_DOCVAR>-->
                  <SET Var="startRow_AvailableMembers" FromValue="{ifElse($thisParam/AvailableMembersTable_START_COUNT/@Value = null, '0', $thisParam/AvailableMembersTable_START_COUNT/@Value)}"/>
                  <REQUEST Name="getAvailableMembers" AssignToVar="availableMemberDataVar" ServiceName="BCM_MASTER">
                    <startRow Value="{$startRow_AvailableMembers}"/>
                    <dimPhysicalKeyColumns Value="{$dimPhysicalKeyColumns}"/>
                    <dimPhysicalTableName Value="{$dimPhysicalTableName}"/>
                    <selectedGroupClass Value="{$selectedGroupClass}"/>
                  </REQUEST>
                  <TO_DOCVAR AssignToVar="availMemDocVar">
                    <AVAIL_MEMBERS TotalRowCount="{$availableMemberDataVar/@TotalRowCount}">
                      <TO_XML SelectList="$availableMemberDataVar/*"/>
                    </AVAIL_MEMBERS>
                  </TO_DOCVAR>
                  <SET DocVar="global_availableMembers" FromDocVar="availMemDocVar"/>
                  <SET DocVar="startCountDocVar" Property="startRow_AvailableMembers" FromValue="{$startRow_AvailableMembers}"/>
                  <SET Var="showGroupResults" FromValue="TRUE"/>
                  <SET Var="showMembers" FromValue="TRUE"/>
                </THEN>
              </IF_TEST>
