  </ui:container>
  <ui:script>function onLoad()
		{
		
		var buttonsList = 'CREATE_GRP_CLASS#cancelGrpClass#SAVE_GRP_CLASS#GET_DETAILS_OF_GRP_CLASS#DELETE_GRP_CLASS#CREATE_ATT_SET_FOR_GRP_CLASS' ;
