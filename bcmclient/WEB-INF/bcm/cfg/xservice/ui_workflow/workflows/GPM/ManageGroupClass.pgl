			     	var b_stat_arr = disableAllButtons(buttonsList);
		var buttonlistVar = 'CREATE_ATT_SET_FOR_GRP_CLASS';
				     enableAllButtons(b_stat_arr,buttonlistVar);
			}
			else if(document.form.actionTaken.value == '')
			{
			      
				var buttonsList = 'CREATE_GRP_CLASS#cancelGrpClass';
			     	var b_stat_arr = disableAllButtons(buttonsList);
			}
		
			
			
		}
		
		
		onLoadSuper();
     scrollHelper();
     autoCollapseRows();
		}	
	
	
		function onAttributeSetTableNameChange()
		{
	
			form.BUTTON_ID.value = 'ATT_SET_TABLENAME_CHANGED' ; 
				form.SUBMIT_AS_XML.value = 'false';
				form.action = 'view.x2ps';
				form.submit();
		}
		
	
    function clickOnUpButton()
		{

		var isRowSelected='FALSE';
		
		for(i=0;i&lt;document.form.elements.length;i++)
			{
				if(document.form.elements[i].name==&quot;updatePriority_attSet&quot;)
				{
						if(document.form.elements[i].checked)
						{
								isRowSelected='TRUE';
								break;
						}
						else
						{
								continue;
						}
				}
		}
		
		if(isRowSelected=='TRUE')
		{
				form.BUTTON_ID.value = 'CLICK_ON_UP_BUTTON' ; 
								form.SUBMIT_AS_XML.value = 'false';
								form.action = 'view.x2ps';
								form.submit();
		}
		else
		{
			core_alert('Please select an Attribute Set to update the priority');
				return;
		}	
		
		
			
		}

		function clickOnDownButton()
		{
		var isRowSelected='FALSE';
		
		for(i=0;i&lt;document.form.elements.length;i++)
			{
				if(document.form.elements[i].name==&quot;updatePriority_attSet&quot;)
				{
						if(document.form.elements[i].checked)
						{
								isRowSelected='TRUE';
								break;
						}
						else
						{
								continue;
						}
				}
		}
		
		if(isRowSelected=='TRUE')
		{
				form.BUTTON_ID.value = 'CLICK_ON_DOWN_BUTTON' ; 
								form.SUBMIT_AS_XML.value = 'false';
								form.action = 'view.x2ps';
								form.submit();
		}
		else
		{
			core_alert('Please select an Attribute Set to update the priority');
				return;
		}	
		
		}
    function onDimensionChange()
		{
			

			form.BUTTON_ID.value = 'NEW_DIM_AS_INPUT' ; 
				form.SUBMIT_AS_XML.value = 'false';
				form.action = 'view.x2ps';
				form.submit();
		}
  
    
    function on_getAttSetDetails()
	{
				form.BUTTON_ID.value = 'NEW_ATT_SET_AS_INPUT' ; 
				form.SUBMIT_AS_XML.value = 'false';
				form.action = 'view.x2ps';
				form.submit();
		
	}
	
		function on_cancelAttSetForGrpClass()
		{
			form.BUTTON_ID.value = 'GET_DETAILS_OF_GRP_CLASS' ; 
				form.SUBMIT_AS_XML.value = 'false';
				form.action = 'view.x2ps';
				form.submit();
		
		}
		
		function on_cancelGrpClass()
		{
		form.BUTTON_ID.value = 'NEW_DIM_AS_INPUT' ; 
				form.SUBMIT_AS_XML.value = 'false';
				form.action = 'view.x2ps';
				form.submit();
		
		}
		
		function onSelectingAttSetForNewTableName()
	{
					
		if(!document.form.attributeSetID.value==&quot;&quot;)
		{
		
		
						form.BUTTON_ID.value = 'ATT_SET_SELECTED_FOR_NEW_TABLE' ; 
						form.SUBMIT_AS_XML.value = 'false';
						form.action = 'view.x2ps';
						form.submit();
		}
		else
		{
		var buttonsList = 'saveAttSetForGrpClass';
    var b_stat_arr1 = disableAllButtons(buttonsList);		
		//alert('blank');
		return;
		}
		
		}

		function enableAllButtons(buttons_stat_array, buttons){
	var buttons_array = buttons.split('#');

	for (b_count = 0; b_count&lt;buttons_array.length; b_count++) {
		if (buttons_stat_array[b_count] == 'enabled')
			i2uiToggleButtonState( buttons_array[b_count], 'enabled');
		if (buttons_stat_array[b_count] == 'enabled_bold')
			i2uiToggleButtonState( buttons_array[b_count], 'enabled','Emphasized');
	}
}

 function disableAllButtons(buttons) {

	var buttons_array = buttons.split('#');
	var b_stat_array = new Array(buttons_array.length);
	var b_count = 0 ;
	while (b_count &lt; buttons_array.length) {
		b_stat_array[b_count] = i2uiShowItemVisibility(buttons_array[b_count]) ;
		if (b_stat_array[b_count].indexOf('enabled') != -1)
			i2uiToggleButtonState( buttons_array[b_count], 'disabled');
			b_count++ ;
	}
	return b_stat_array ;
}
 
		function i2uiToggleButtonState(id, desiredState, desiredType)
{
		
	//alert('id '+id.value);	
  // valid for IE alone
  if (!document.all)  return;
  var obj = document.getElementById(id);
  if (obj == null) return;
		//alert('object ki value.. '+obj.value)
  var cell = obj.rows[0].cells[0];
  var anchor = cell.childNodes[0];
  var state = obj.className;
  if (desiredState == null)
  {
    if (state == &quot;buttonBorder&quot;)
      desiredState = &quot;disabled&quot;;
    else
      desiredState = &quot;enabled&quot;;
  }
  if (desiredState == &quot;disabled&quot;)
  {
  	//checking if it is already disabled.
  	if (state == &quot;buttonBorder&quot;)
  	{
	    obj.className = &quot;buttonBorderDisabled&quot;;
	    cell.id = &quot;buttonDisabled&quot;;
	    cell.className = &quot;buttonTextDisabled&quot;;
	    var href = anchor.getAttribute(&quot;href&quot;);
	    if (href != null)
	    {
	      anchor.setAttribute(&quot;href2&quot;, href);
	      anchor.removeAttribute(&quot;href&quot;);
	    }
  	}
  }
  else
  {
    obj.className = &quot;buttonBorder&quot;;
    if (desiredType == null)
      desiredType = &quot;Regular&quot;;
    cell.id = &quot;button&quot;+desiredType;
    cell.className = &quot;buttonText&quot;;
    var href = anchor.getAttribute(&quot;href2&quot;);
    if (href != null)
    {
      anchor.setAttribute(&quot;href&quot;, href);
      anchor.removeAttribute(&quot;href2&quot;);
    }
  }
}
		
		
		
function i2uiShowItemVisibility(id) {
	var item;
	var status = 'no item' ;
	var debug = false ;
	if (document.layers) {
		item = document.layers[id];
		if (item != null) {
			if (item.visibility == 'hide')
				status = 'disabled' ;
			else
				status = 'enabled' ;
		}
	}

	item = document.getElementById(id);
	if (item != null) {
		if (debug == true) alert('id..item.className..'+id+'..'+item.className) ;
		
		if (item.className == 'buttonBorderDisabled')
			status = 'disabled' ;
		else {
			status = 'enabled' ;
			var cell = item.rows[0].cells[0];
			if(cell.id.indexOf('Emphasized') != -1)
				status = 'enabled_bold' ;
		}
	}
	if (debug == true) alert('id..status..'+id+'..'+status) ;
	return status;
}</ui:script>
</ui:page-group>