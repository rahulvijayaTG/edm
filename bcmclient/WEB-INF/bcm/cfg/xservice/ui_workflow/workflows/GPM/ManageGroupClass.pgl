                  <ui:field-group>
                    <!--<ui:hidden-field name="attributeSetID" id="attributeSetID"/>-->
                    <!--<ui:display-field name="" id="" displayText=""/>-->
                    <ui:display-field name="updatedLogicalColumnName" id="updatedLogicalColumnName" displayText="Attributes"/>
