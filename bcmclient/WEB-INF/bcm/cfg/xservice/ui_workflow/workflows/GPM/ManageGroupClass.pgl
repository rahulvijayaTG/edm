			var buttonlistVar = 'CREATE_GRP_CLASS#cancelGrpClass#CREATE_ATT_SET_FOR_GRP_CLASS';
	 	        enableAllButtons(b_stat_arr,buttonlistVar);
		
		
			if(document.forms[1].actionTaken.value == 'CREATE_GRP_CLASS')
			{
			  
		            for(i=0;i&lt;document.form.elements.length;i++)
			    {
				if(document.form.elements[i].name==&quot;groupClassID5&quot;)
				{
					if((document.form.elements[i].checked)&amp;&amp;(document.form.elements[i].value!=&quot;&quot;))
					{
						document.form.elements[i].checked=false;
					}
					else if(document.form.elements[i].value==&quot;&quot;)
					{
						document.form.elements[i].checked=true;
					}
				}
			    }
			    var buttonlistVar = 'SAVE_GRP_CLASS';
			    enableAllButtons(b_stat_arr,buttonlistVar);
			    var buttonsList = 'CREATE_GRP_CLASS';
			    var b_stat_arr = disableAllButtons(buttonsList);
			}
			else if(document.forms[1].actionTaken.value == 'NEW_DIM_AS_INPUT')
			{
				
				var buttonlistVar = 'CREATE_GRP_CLASS#cancelGrpClass';
 			        enableAllButtons(b_stat_arr,buttonlistVar);
			}
	
			else if(document.forms[1].actionTaken.value == 'GET_DETAILS_OF_GRP_CLASS')
			{
				
				var buttonsList = 'SAVE_NEW_ATT_SET_FOR_GRP_CLASS';
				var b_stat_arr1 = disableAllButtons(buttonsList);
				var buttonlistVar = 'CREATE_GRP_CLASS#CREATE_ATT_SET_FOR_GRP_CLASS';
			//	alert(buttonlistVar);
			//	enableAllButtons(b_stat_arr,buttonlistVar);
		
				
			}
	
			else if(document.forms[1].actionTaken.value == 'NEW_ATT_SET_AS_INPUT')
			{
			var buttonsList = 'SAVE_NEW_ATT_SET_FOR_GRP_CLASS';
				var b_stat_arr1 = disableAllButtons(buttonsList);
				var buttonlistVar = 'CREATE_GRP_CLASS#CREATE_ATT_SET_FOR_GRP_CLASS';
			        enableAllButtons(b_stat_arr,buttonlistVar);
			}

			else if(document.forms[1].actionTaken.value == 'CREATE_ATT_SET_FOR_GRP_CLASS')
			{
			
				for(i=0;i&lt;document.form.elements.length;i++)
				{
					if(document.form.elements[i].name==&quot;attributeSetID5&quot;)
					{
						if((document.form.elements[i].checked)&amp;&amp;(document.form.elements[i].value!=&quot;&quot;))
						{
							document.form.elements[i].checked=false;
						}
						else if(document.form.elements[i].value==&quot;&quot;)
						{
							document.form.elements[i].checked=true;
						}
					}
				}
		
	                	 buttonsList = 'CREATE_ATT_SET_FOR_GRP_CLASS#SAVE_GRP_CLASS#SAVE_NEW_ATT_SET_FOR_GRP_CLASS';
			     	var b_stat_arr = disableAllButtons(buttonsList);
		
		
			}

			else if(document.forms[1].actionTaken.value == 'ATT_SET_TABLENAME_CHANGED')
			{
			
				for(i=0;i&lt;document.form.elements.length;i++)
				{
					if(document.form.elements[i].name==&quot;attributeSetID5&quot;)
					{
						if((document.form.elements[i].checked)&amp;&amp;(document.form.elements[i].value!=&quot;&quot;))
							document.form.elements[i].checked=false;
						else
							document.form.elements[i].checked=true;
						
					}
				}
				buttonsList = 'SAVE_NEW_ATT_SET_FOR_GRP_CLASS#CREATE_ATT_SET_FOR_GRP_CLASS';
			     	 var b_stat_arr = disableAllButtons(buttonsList);
			}
		
			else if(document.forms[1].actionTaken.value == 'ATT_SET_SELECTED_FOR_NEW_TABLE')
			{
				
			buttonsList = 'SAVE_NEW_ATT_SET_FOR_GRP_CLASS#CREATE_ATT_SET_FOR_GRP_CLASS';
	
     				var b_stat_arr = disableAllButtons(buttonsList);
				var buttonlistVar = 'SAVE_NEW_ATT_SET_FOR_GRP_CLASS';
		                enableAllButtons(b_stat_arr,buttonlistVar);
				
			}

			else if(document.forms[1].actionTaken.value == 'SAVE_NEW_ATT_SET_FOR_GRP_CLASS')
			{
			
				var buttonlistVar = 'CREATE_ATT_SET_FOR_GRP_CLASS';
			        enableAllButtons(b_stat_arr,buttonlistVar);
				buttonsList = 'SAVE_GRP_CLASS#SAVE_NEW_ATT_SET_FOR_GRP_CLASS';
			     	var b_stat_arr = disableAllButtons(buttonsList);
			}
		
			else if(document.forms[1].actionTaken.value == 'DELETE_ATT_SET_FOR_GRP_CLASS')
			{
			
				var buttonlistVar = 'CREATE_ATT_SET_FOR_GRP_CLASS';
				     enableAllButtons(b_stat_arr,buttonlistVar);
				 buttonsList = 'SAVE_GRP_CLASS#SAVE_NEW_ATT_SET_FOR_GRP_CLASS';
			     	var b_stat_arr = disableAllButtons(buttonsList);
			}
			
			else if(document.forms[1].actionTaken.value == 'DELETE_GRP_CLASS')
			{
			
				buttonsList = 'SAVE_GRP_CLASS';
     				var b_stat_arr = disableAllButtons(buttonsList);
		
		
			}
	else if(document.form.actionTaken.value == 'CLICK_ON_UP_BUTTON')
			{
			      
				var buttonsList = 'SAVE_NEW_ATT_SET_FOR_GRP_CLASS';
			     	var b_stat_arr = disableAllButtons(buttonsList);
		var buttonlistVar = 'CREATE_ATT_SET_FOR_GRP_CLASS';
				     enableAllButtons(b_stat_arr,buttonlistVar);
			}
		
			else if(document.form.actionTaken.value == 'CLICK_ON_DOWN_BUTTON')
			{
			      
