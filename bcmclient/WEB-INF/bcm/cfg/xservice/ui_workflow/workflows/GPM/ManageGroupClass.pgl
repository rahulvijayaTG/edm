                        <ui:field-group>
                          <ui:display-field id="groupDimension_attSet" name="groupDimension_attSet" displayText="Group Dimension"/>
                          <ui:display-field name="groupClass_attSet" id="groupClass_attSet" displayText="Group Class"/>
