<ui:page-group xmlns:ui="http://www.i2.com/ui" name="studio.templates.ecriwizard" source="studio.controller.load" version="2">
  <ui:container scrollable="true" collapsable="true">
    <ui:step id="Outer" displayText="Manage Group Class" scrollable="true" editable="false">
      <ui:field-group name="mesg" select="$root">
        <ui:choose-field name="BUTTON_ID">
          <ui:when test="$root/MESSAGES/@Status = 'ERROR'">
            <ui:display-field displayText="" name="error" value="{$root/MESSAGES/MESSAGE/@Value}" class="requiredIndicatorRed"/>
          </ui:when>
          <ui:when test="$root/MESSAGES/@Status= 'SUCCESS'">
            <ui:display-field displayText="" name="success" value="{$root/MESSAGES/MESSAGE/@Value}" class="requiredIndicatorGreen"/>
          </ui:when>
          <ui:otherwise/>
        </ui:choose-field>
      </ui:field-group>
      <ui:field-group>
        <ui:hidden-field name="actionTaken" value="{$root/actionTaken/@Value}"/>
      </ui:field-group>
      <ui:grid>
        <ui:row>
          <ui:cell width="100%" valign="top" colSpan="3">
            <ui:field-group columns="1">
              <ui:dropdown id="groupDimension" name="groupDimension" displayText="Group Dimension" optionSrc="$root/GROUP_DIMENSIONS/*" required="true" onChange="Javascript:onDimensionChange()"/>
            </ui:field-group>
          </ui:cell>
        </ui:row>
        <ui:row>
          <ui:cell width="47%" valign="top">
            <ui:container collapsable="true">
              <ui:step id="rr" displayText="{$root/DISPLAY_STRINGS/GROUP_CLASS/@Value}">
                <ui:table id="GroupDescTable" name="GroupDescTable" displayText="Select Group Class" displayTextNoRecords="No records found" select="$root/GROUP_CLASSES" rowId="groupClassID" postRowIdAs="groupClassID5" selectable="Single" maxRows="5" doPaging="true" totalRowCount="$root/GROUP_CLASSES/@TotalRowCount" startAtRow="$root/startRow_GroupClasses/@Value">
                  <ui:field-group>
                    <ui:choose-field name="groupClassID" id="groupClassID" displayText="Group Class ID">
                      <ui:when test="./@clickOnCreate = 'TRUE'">
                        <ui:entry-field id="groupClassID" name="groupClassID" required="true"/>
                      </ui:when>
                      <ui:otherwise>
                        <ui:display-field name="groupClassID" id="groupClassID"/>
                      </ui:otherwise>
                    </ui:choose-field>
                    <ui:choose-field name="description" id="description" displayText="Group Class Description">
                      <ui:when test="./@clickOnCreate = 'TRUE'">
                        <ui:entry-field id="description" name="description"/>
                      </ui:when>
                      <ui:otherwise>
                        <ui:display-field name="description" id="description"/>
                      </ui:otherwise>
                    </ui:choose-field>
                  </ui:field-group>
                  <ui:buttons>
                    <ui:button id="cancelGrpClass" name="cancelGrpClass" displayText="Cancel" displayCondition="{$root/actionTaken/@Value='CREATE_GRP_CLASS'}"/>
                    <ui:button id="GET_DETAILS_OF_GRP_CLASS" displayText="Get Details" name="getGroupClassDetails" enabledBySelections="true" disabled="true" displayCondition="{$root/actionTaken/@Value!='CREATE_GRP_CLASS'}"/>
                    <ui:button id="CREATE_GRP_CLASS" displayText="Create" name="createGroupClass"/>
                    <ui:button id="SAVE_GRP_CLASS" displayText="Save" name="saveGroupClass"/>
                    <ui:button id="DELETE_GRP_CLASS" displayText="Delete" name="deleteGroupClass" enabledBySelections="true" disabled="true" displayCondition="{$root/actionTaken/@Value!='CREATE_GRP_CLASS'}"/>
                  </ui:buttons>
                </ui:table>
              </ui:step>
            </ui:container>
          </ui:cell>
          <ui:cell valign="top" width="5%"/>
          <ui:cell valign="top">
            <ui:container collapsable="true" scrollable="TRUE" displayCondition="{$root/showAttributeSets/@Value='TRUE'}">
              <ui:step id="abc" displayText="{$root/DISPLAY_STRINGS/ATTRIBUTE_SET/@Value}">
                <ui:table id="AttributeSetDescTable" displayText="Select Attribute Set" select="$root/ATTRIBUTE_SETS" displayTextNoRecords="" selectable="Single" rowId="attributeSetID" postRowIdAs="attributeSetID5" maxRows="5" doPaging="true" totalRowCount="$root/ATTRIBUTE_SETS/@TotalRowCount" startAtRow="$root/startRow_AttributeSets/@Value">
                  <ui:field-group>
                    <ui:choose-field name="updatedLogicalTableName" id="updatedLogicalTableName" displayText="Updated Table Name">
                      <ui:when test="./@clickOnCreate = 'TRUE'">
                        <ui:dropdown name="updatedLogicalTableName" id="updatedLogicalTableName" optionSrc="$root/TABLES/*" onChange="javaScript:onAttributeSetTableNameChange()" required="true">
                          <ui:option id="" value="Select"/>
                        </ui:dropdown>
                      </ui:when>
                      <ui:otherwise>
                        <ui:display-field name="updatedLogicalTableName" id="updatedLogicalTableName"/>
                      </ui:otherwise>
                    </ui:choose-field>
                    <ui:choose-field name="attributeSetID" id="attributeSetID" displayText="Attribute Set ID">
                      <ui:when test="./@clickOnCreate = 'TRUE'">
                        <ui:dropdown name="attributeSetID" id="attributeSetID" optionSrc="$root/ATT_SETS_FOR_CREATE/*" required="true" onChange="javaScript:onSelectingAttSetForNewTableName()">
                          <ui:option id="" value="Select"/>
                        </ui:dropdown>
                      </ui:when>
                      <ui:otherwise>
                        <ui:display-field name="attributeSetID" id="attributeSetID"/>
                      </ui:otherwise>
                    </ui:choose-field>
                  </ui:field-group>
                  <ui:buttons>
                    <ui:button name="cancelAttSetForGrpClass" id="cancelAttSetForGrpClass" displayText="Cancel" displayCondition="{($root/actionTaken/@Value='CREATE_ATT_SET_FOR_GRP_CLASS') or ($root/actionTaken/@Value='ATT_SET_TABLENAME_CHANGED') or ($root/actionTaken/@Value='ATT_SET_SELECTED_FOR_NEW_TABLE')}"/>
                    <ui:button id="getAttSetDetails" displayText="Get Details" name="getAttSetDetails" enabledBySelections="true" disabled="true" displayCondition="{$root/actionTaken/@Value!='CREATE_ATT_SET_FOR_GRP_CLASS' and $root/actionTaken/@Value!='ATT_SET_TABLENAME_CHANGED' and $root/actionTaken/@Value!='ATT_SET_SELECTED_FOR_NEW_TABLE'}"/>
                    <ui:button id="CREATE_ATT_SET_FOR_GRP_CLASS" displayText="Create" name="createAttSetForGrpClass"/>
                    <ui:button id="SAVE_NEW_ATT_SET_FOR_GRP_CLASS" displayText="Save" name="saveAttSetForGrpClass"/>
                    <ui:button id="DELETE_ATT_SET_FOR_GRP_CLASS" displayText="Delete" name="deleteAttSetForGrpClass" enabledBySelections="true" disabled="true" displayCondition="{$root/actionTaken/@Value!='CREATE_ATT_SET_FOR_GRP_CLASS' and $root/actionTaken/@Value!='ATT_SET_TABLENAME_CHANGED' and $root/actionTaken/@Value!='ATT_SET_SELECTED_FOR_NEW_TABLE'}"/>
                    <!--<ui:button id="updatePriorityButton" displayText="Update Priority" name="updatePriorityButton" enabledBySelections="true" disabled="true"/>-->
                  </ui:buttons>
