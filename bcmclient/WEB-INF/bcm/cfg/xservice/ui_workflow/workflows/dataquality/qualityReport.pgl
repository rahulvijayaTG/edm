<ui:page-group xmlns:ui="http://www.i2.com/ui" name="Data Quality Report" version="2">
  <ui:container id="container_top" scrollable="true" width="100%">
    <ui:help displayPage="{$pages:dataQualityReport}"/>
    <ui:step displayText="Data Quality Report" id="hview" scrollable="true" editable="true">
      <ui:grid cellSpacing="3">
        <ui:row>
          <ui:cell valign="top" width="30%">
            <ui:container id="acontainer" scrollable="true">
              <ui:step id="astep" displayText="Search Data Quality Report" select="$root" scrollable="true">
                <ui:field-group id="afieldgroup">
                  <ui:hidden-field name="REPORT_ID" value="{$root/DATA_QUALITY_REPORT/REPORT_ID/@Value}" />
                  <ui:dropdown name="SOURCE" id="SOURCE" selectAll="false" displayText="Source" optionSrc="$root/SOURCES/*" onChange="javascript:changeSource();" />
                  <ui:dropdown name="ENTITY" id="ENTITY" selectAll="true" displayText="Entity" optionSrc="$root/ENTITIES/*" />
                  <ui:display-field name="REPORT_ID" value="{$root/DATA_QUALITY_REPORT/REPORT_ID/@Value}" displayText="Report Id" displayCondition="{$root/DATA_QUALITY_REPORT}" />
                  <ui:display-field name="REPORT_DATE" value="{$root/DATA_QUALITY_REPORT/REPORT_DATE/@Value}" displayText="Report Date" displayCondition="{$root/DATA_QUALITY_REPORT}" />
                  <ui:display-field name="TOTAL_POSSIBLE" value="{$root/DATA_QUALITY_REPORT/TOTAL_POSSIBLE/@Value}" displayText="Total Possible" displayCondition="{$root/DATA_QUALITY_REPORT}" type="Percent" />
                  <ui:display-field name="RAW_DQ_SCORE" value="{$root/DATA_QUALITY_REPORT/RAW_DQ_SCORE/@Value}" displayText="Raw DQ Score" displayCondition="{$root/DATA_QUALITY_REPORT}" dataType="Percent" align="left" />
                  <ui:display-field name="WEIGHTED_DQ_SCORE" value="{$root/DATA_QUALITY_REPORT/WEIGHTED_DQ_SCORE/@Value}" displayText="Weighted DQ Score" displayCondition="{$root/DATA_QUALITY_REPORT}" dataType="Percent" align="left" />
                </ui:field-group>
                <ui:buttons>
                  <ui:button id="submit" name="submit" displayText="Submit" emphasized="true" />
                </ui:buttons>
              </ui:step>
            </ui:container>
          </ui:cell>
          <ui:cell valign="top" width="50%">
            <ui:container id="ccontainer" displayCondition="{$root/DATA_QUALITY_REPORT}">
              <ui:step id="cstep" displayText="Data Quality Chart" select="$root" scrollable="true">
                <ui:chart width="500" height="200" xLabelsWidth="100" yAxisNumTicks="5" displayText="" select="$root/DATA_QUALITY_REPORT/REPORT_BY_RULE_INFO" rowSrc="DQ_REPORT_BY_RULE" allowNegatives="true" displayCondition="{$root/SELECTED_STEP/@Value='rstep'}">
                  <ui:chart-field displayText="" name="RULE_NAME"/>
                  <ui:chart-field displayText="Occurrence" name="OCCURRENCE" color="#FFFF00"/>
                </ui:chart>
                <ui:chart width="500" height="200" xLabelsWidth="100" yAxisNumTicks="5" displayText="" select="$root/DATA_QUALITY_REPORT/REPORT_BY_SEVERITY_INFO" rowSrc="DQ_REPORT_BY_SEVERITY" allowNegatives="true" displayCondition="{$root/SELECTED_STEP/@Value='sstep'}">
                  <ui:chart-field displayText="" name="SEVERITY"/>
                  <ui:chart-field displayText="Pct. Occurrence" name="PCT_OCCURRENCE" color="#FFFF00"/>
                </ui:chart>
                <ui:chart width="500" height="200" xLabelsWidth="100" yAxisNumTicks="5" displayText="" select="$root/TREND_REPORT" rowSrc="DQ_TREND_REPORT" allowNegatives="true" displayCondition="{$root/SELECTED_STEP/@Value='search'}">
                  <ui:chart-field displayText="" name="REPORT_DATE" dataType="Date"/>
                  <ui:chart-field displayText="Acceptable DQ Score " name="ACCEPTABLE_DQ_SCORE" color="#006633" type="line"/>
                  <ui:chart-field displayText="DQ Score" name="RAW_DQ_SCORE" color="#FF3300" type="line"/>
                </ui:chart>
                <ui:chart width="500" height="200" xLabelsWidth="100" yAxisNumTicks="5" displayText="" select="$root/ALL_ENTITIES" rowSrc="ENTITY" allowNegatives="true" displayCondition="{$root/SELECTED_STEP/@Value='estep' and $root/ENTITY/@Value=''}">
                  <ui:chart-field displayText="" name="ENTITY"/>
                  <ui:chart-field displayText="Raw DQ Score" name="RAW_DQ_SCORE" color="#006633"/>
                  <ui:chart-field displayText="Weighted DQ Score" name="WEIGHTED_DQ_SCORE" color="#FF3300"/>
                </ui:chart>
              </ui:step>
            </ui:container>
          </ui:cell>
        </ui:row>
        <ui:row>
          <ui:cell colSpan="2" valign="top" width="90%">
            <ui:container id="tcontainer" displayCondition="{$root/DATA_QUALITY_REPORT}">
              <ui:step id="rstep" displayText="Quality Rule Report" select="$root" scrollable="true">
                <ui:table id="rTable" displayText="" select="$root/DATA_QUALITY_REPORT/REPORT_BY_RULE_INFO" maxRows="-1" exportable="true">
                  <ui:help id="rTableHelp" />
                  <ui:field-group id="tableColumns">
                        <ui:display-field displayText="Quality Rule" name="RULE_NAME" />
                        <ui:display-field displayText="Occurrence" name="OCCURRENCE" dataType="Constant" sortable="true" />
                        <ui:display-field displayText="Total Possible" name="TOTAL_POSSIBLE" sortable="true" />
                        <ui:display-field displayText="Pct. Occurrence" name="PCT_OCCURRENCE" dataType="Percent" align="left" sortable="true" />
                        <ui:display-field displayText="Severity Weight" name="SEVERITY" />
                    <ui:display-field displayText="Entity" name="DOCUMENT_NAME" />
                  </ui:field-group>
                </ui:table>
              </ui:step>
              <ui:step id="sstep" displayText="Quality Severity Report" select="$root" scrollable="true">
                <ui:table id="sTable" displayText="" select="$root/DATA_QUALITY_REPORT/REPORT_BY_SEVERITY_INFO" maxRows="-1" exportable="true">
                  <ui:help id="sTableHelp" />
                  <ui:field-group id="tableColumns">
                    <ui:display-field displayText="Severity Weight" name="SEVERITY" sortable="true" />
                    <ui:display-field displayText="Total Possible" name="TOTAL_POSSIBLE" sortable="true" />
                    <ui:display-field displayText="Occurrence" name="OCCURRENCE" sortable="true" />
                    <ui:display-field displayText="Pct. Occurrence" name="PCT_OCCURRENCE" dataType="Percent" align="left" sortable="true" />
                  </ui:field-group>
                </ui:table>
              </ui:step>
              <ui:step id="search" displayText="QualityTrend Report" select="$root" scrollable="true">
                <ui:field-group id="tableColumns" columns="2">
                  <ui:date-range displayText="Date Range" name="REPORT_DATE" />
                </ui:field-group>
                <ui:hr />
                <ui:table id="tTable" displayText="" invert="true" select="$root/TREND_REPORT" maxRows="-1" exportable="true">
                  <ui:help id="tTableHelp" />
                  <ui:field-group id="tableColumns">
                    <ui:display-field displayText="Date" name="REPORT_DATE" style="{{font:bold}" dataType="Date" />
                    <ui:link-field name="REPORT_ID" id="REPORT_ID" displayText="Report Id" style="{{font:bold}">
                      <ui:url page="view.x2ps">
                        <REPORT_ID select="REPORT_ID/@Value" />
                        <BUTTON_ID select="'change_report'" />
                        <SOURCE select="$root/SOURCE/@Value" />
                        <ENTITY select="$root/ENTITY/@Value" />
                      </ui:url>
                    </ui:link-field>
                    <ui:display-field displayText="DQ Score" name="RAW_DQ_SCORE" dataType="Percent" align="left" />
                    <ui:display-field displayText="Acceptable DQ Score" name="ACCEPTABLE_DQ_SCORE" dataType="Percent" align="left" />
                    <ui:choose-field name="STATUS" displayText="Status">
                      <ui:when test="STATUS/@Value='GREEN'">
                        <ui:image-link-field displayText="" src="/green_circle.gif" name="STATUS" dataType="Constant" />
                      </ui:when>
                      <ui:when test="STATUS/@Value='RED'">
                        <ui:image-link-field displayText="" src="/red_circle.gif" name="STATUS" dataType="Constant" />
                      </ui:when>
                    </ui:choose-field>
                  </ui:field-group>
                </ui:table>
                <ui:buttons>
                  <ui:button id="get_reports" name="get_reports" displayText="Get Report" emphasized="true" />
                </ui:buttons>
              </ui:step>
              <ui:step id="estep" displayText="Quality Report By Entity" select="$root" displayCondition="{$root/ENTITY/@Value=''}">
                <ui:grid>
                  <ui:row>
                    <ui:cell width="50%">
                      <ui:table id="eTable1" scrollable="true" displayText="High Data Quality Entities" select="$root/BEST_ENTITIES" maxRows="-1" exportable="true">
                        <ui:help id="eTableHelp1" />
                        <ui:field-group id="etableColumns1">
                          <ui:display-field displayText="Entity" name="ENTITY" />
                          <ui:display-field displayText="Raw DQ Score" name="RAW_DQ_SCORE" dataType="Percent" align="left" />
                          <ui:display-field displayText="Weighted DQ Score" name="WEIGHTED_DQ_SCORE" dataType="Percent" align="left" />
                        </ui:field-group>
                      </ui:table>
                    </ui:cell>
                    <ui:cell width="50%">
                      <ui:table id="eTable2" scrollable="true" displayText="Poor Data Quality Entities" select="$root/WORST_ENTITIES" maxRows="-1" exportable="true">
                        <ui:help id="eTableHelp2" />
                        <ui:field-group id="etableColumns2">
                          <ui:display-field displayText="Entity" name="ENTITY" />
                          <ui:display-field displayText="Raw DQ Score" name="RAW_DQ_SCORE" dataType="Percent" align="left" />
                          <ui:display-field displayText="Weighted DQ Score" name="WEIGHTED_DQ_SCORE" dataType="Percent" align="left" />
                        </ui:field-group>
                      </ui:table>
                    </ui:cell>
                  </ui:row>
                </ui:grid>
                <!--ui:script>function scrollHelper()
                     {
                       var totalAvailWidth = document.body.offsetWidth ;
                       var totalAvailHeight = document.body.offsetHeight - 350;
                       var width = totalAvailWidth/2 - 30;
                       i2uiResizeScrollableArea('etable1', totalAvailHeight,width, null, 23);
                       i2uiResizeScrollableArea('etable2', totalAvailHeight,width , null, 23);
                     }</ui:script-->
              </ui:step>
            </ui:container>
          </ui:cell>
        </ui:row>
      </ui:grid>
    </ui:step>
  </ui:container>
  <ui:script>function changeSource()
    {
      form.BUTTON_ID.value = "change_source";
      form.submit();
    }
    function test_date_range(from,to,datatype)
    {
      var x = document.getElementsByName(from);
      var y = document.getElementsByName(to);
      var fromDate = x[0].value;
      var toDate = y[0].value;
    
      var bValid = &quot;true&quot;;
    
      //check for errors
      if( typeof( validate_search ) == 'undefined' )
      {
        if (!isValid_field(from,null) || !isValid_field(to,null))
        {
          bValid = &quot;false&quot;;
        }
      }
      else
      {
        validation_clearMessages('search');
        if ( validate_search() == false )
        {
          validation_alert('search');
          bValid = &quot;false&quot;;
        }
        
      }
    
      if ( bValid == &quot;true&quot; )
      {
        if(toDate != null &amp;&amp; toDate != '' &amp;&amp; fromDate != null &amp;&amp; fromDate != '')
        {
          var dateFormat = datatype == 'DateTime' ? datatype : null;
    
          var result = datecompare(fromDate, dateFormat, toDate, dateFormat);
          if(result > 0)
          {
            core_alert('From Date should be less than To Date');
            y[0].value = x[0].value;
          }
        }
      }
      else
      {
        onResize();
        return;
      }
    }</ui:script>
</ui:page-group>

