<ui:page-group xmlns:ui="http://www.i2.com/ui" name="Data Audit Report">
  <ui:container id="container_top" scrollable="true" width="100%" collapsable="true">
    <ui:help displayPage="{$pages:dataAuditReport}" />
    <ui:step displayText="Audit Report Filter" id="hview" scrollable="true" editable="true">
      <ui:field-group columns="2" id="validation" displayCondition="{count($root/ERROR_TAG) &gt; 0}">
        <ui:image name="validationImg" src="/alert_static.gif" />
        <ui:display-field value="{$root/ERROR_TAG/@Value}" />
      </ui:field-group>
      <ui:container displayText="Search" collapsable="true">
        <ui:step id="search" displayText="Search" select="$root" scrollable="true">
          <ui:field-group id="sfieldgroup" columns="2">
            <ui:field-group id="sfieldGroup1">
              <ui:dropdown name="ENTITY" id="ENTITY" selectAll="true" displayText="Entity" optionSrc="$root/ENTITIES/*" size="5" onChange="javascript:changeEntity();" sort="ascending" />
              <ui:dropdown name="COLUMN" id="COLUMN" selectAll="false" displayText="Column Filter" optionSrc="$root/COLUMNS/*" onChange="javascript:changeColumnFilter();" sort="ascending" displayCondition="{$root/SINGLE_ENTITY/@Value='true'}" />
              <ui:entry-field name="COLUMN_VALUE" displayText="Filter Value" displayCondition="{(($root/SINGLE_ENTITY/@Value='true') and (( count($root/COLUMN_DATATYPE)=0) or ($root/COLUMN_DATATYPE/@Value!='boolean')))}" />
              <ui:dropdown name="COLUMN_VALUE" id="COLUMN_VALUE" selectOne="true" displayText="Filter Value" displayCondition="{$root/SINGLE_ENTITY/@Value='true' and $root/COLUMN_DATATYPE/@Value='boolean'}">
                <ui:option id="1" value="true" />
                <ui:option id="0" value="false" />
              </ui:dropdown>
            </ui:field-group>
            <ui:field-group id="sfieldGroup2" rows="2">
              <ui:dropdown name="USER" id="USER" selectAll="true" displayText="User" optionSrc="$root/USERS/*" size="5" />
              <ui:date-range id="DATE" displayText="Date Range" name="DATE" toDate="{$root/TO_DATE/@Value}" fromDate="{$root/FROM_DATE/@Value}" />
            </ui:field-group>
          </ui:field-group>
          <ui:buttons>
            <ui:button id="search_button" name="search_button" displayText="Search" emphasized="true" />
          </ui:buttons>
        </ui:step>
      </ui:container>
      <ui:table id="bottomTable" displayText="Audit Report Results" selectedId="ID" rowId="ID" postRowIdAs="ID" rowSrc="$root/AUDIT_ENTITIES/*[ROW_COUNT/@Value &gt; 0]" selectable="Single" displayTextNoRecords="">
        <ui:field-group id="tableColumns">
          <ui:display-field displayText="Name" name="NAME" />
          <ui:display-field displayText="Row Count" name="ROW_COUNT" />
        </ui:field-group>
        <ui:buttons id="tableButtons">
          <ui:button displayText="View Details" validate="false" id="view" enabledBySelections="true" />
        </ui:buttons>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:container id="auditData" scrollable="true" width="100%" displayCondition="{$root/AUDIT_DATA}">
    <ui:step displayText="{$root/ENTITY_NAME}" id="tview" scrollable="true">
      <ui:dynamic-pgl select="$root/DYNAMIC_PGL_DATA/*" />
    </ui:step>
  </ui:container>
  <ui:script>function onLoad()
    {
      onLoadSuper();
      scrollHelper();
      var auditTable1 = document.getElementById( 'auditTable' );
      if (auditTable1 != null)
      {
        i2uiCollapseContainer('hview');
      }
    }
        //Pagination
    function getRecords(actionName, startCount,tableElement)
    {
      var page_form = null;
      var search_form = null;
      if(page_form == null)  page_form = document.form;
      if(search_form == null)  search_form = document.form;
      jumpTo(actionName, startCount, search_form, page_form,tableElement);
    }
      function changeEntity()
    {
      form.BUTTON_ID.value = "change_entity";
      form.submit();
    }
      function changeColumnFilter()
    {
      form.BUTTON_ID.value = "change_column";
      form.submit();
    }
		
		 function on_search_button()
 {
 var bIsValid = true;
 document.form.SUBMIT_AS_XML.value = 'false';
	if (document.form.TO_DATE_DC.value != '' &amp;&amp; document.form.TO_DATE_DC.value!=null)
		{
var toDate = document.form.TO_DATE_DC.value;
		}
		if (document.form.FROM_DATE_DC.value != '' &amp;&amp; document.form.FROM_DATE_DC.value!=null)
		{
		var fromDate = document.form.FROM_DATE_DC.value;
		}

bIsValid = (isValid_search());
 
if( bIsValid == false )
{
  validation_alert('search');
}
if ( bIsValid == true) 
{
     if(toDate != null &amp;&amp; toDate != '' &amp;&amp; fromDate != null &amp;&amp; fromDate != '')
            {
              var dateFormat = 'Date' == 'DateTime' ? 'Date' : null;
        
              var result = datecompare(fromDate, dateFormat, toDate, dateFormat);
              if(result &gt; 0)
              {
                core_alert('From Date should be less than or equal to To Date');
                document.form.TO_DATE_DC.value = document.form.FROM_DATE_DC.value;
		          onResize();  
return; 
              }
		        }
 disableButtons(); 
 trapExcelPivotChanges(); 
document.form.BUTTON_ID.value = 'search_button'; 
document.form.action = 'view.x2ps';
document.form.submit();  
}

onResize();  
return; 
}
    function test_date_range(from,to,datatype)
        {
          var x = document.getElementsByName(from);
          var y = document.getElementsByName(to);
          var fromDate = x[0].value;
          var toDate = y[0].value;
        
          var bValid = "true";
        
          //check for errors
          if( typeof( validate_search ) == 'undefined' )
          {
            if (!isValid_field(from,null) || !isValid_field(to,null))
            {
              bValid = "false";
            }
          }
          else
          {
            validation_clearMessages('search');
            if ( validate_search() == false )
            {
              validation_alert('search');
              bValid = "false";
            }
            
          }
        
          if ( bValid == "true" )
          {
            if(toDate != null &amp;&amp; toDate != '' &amp;&amp; fromDate != null &amp;&amp; fromDate != '')
            {
              var dateFormat = datatype == 'DateTime' ? datatype : null;
        
              var result = datecompare(fromDate, dateFormat, toDate, dateFormat);
              if(result &gt; 0)
              {
                core_alert('From Date should be less than or equal to To Date');
                y[0].value = x[0].value;
              }
            }
          }
          else
          {
            onResize();
            return;
          }
    }</ui:script>
</ui:page-group>

