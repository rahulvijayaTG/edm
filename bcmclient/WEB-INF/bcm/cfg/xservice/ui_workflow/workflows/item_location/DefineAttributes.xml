        <nextNodeView fade="false" startpoint="179,107" endpoint="245,118" ctrlRect1Dirty="false" ctrlRect2Dirty="false" textRectDirty="false" textRect="160,106,102,12" showCaption="false" captionText="[$userAction ='next']"/>
