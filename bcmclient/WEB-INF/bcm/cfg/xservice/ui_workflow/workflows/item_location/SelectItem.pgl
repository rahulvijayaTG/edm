<ui:page-group xmlns:ui="http://www.i2.com/ui">
  <ui:table id="table" displayText="Select Item" displayTextNoRecords="No Items found." selectable="Single" select="items" rowSrc="Item" rowId="itemID" postRowIdAs="S_itemID" scrollable="true" collapsable="true" configurable="false" exportable="false" filter="true" sortBy="$root/DEFAULTS/SORT_BY/@Value" sortOrder="$root/DEFAULTS/SORT_ORDER/@Value" help="{$pages:ItemLocation_SelectItem}">
    <ui:validation anyFieldIsRequired="false" successMessage="{$root/ERROR_MESSAGE/@Value}" />
    <ui:field-group>
      <ui:link-field displayText="Item ID" name="itemID" dataType="Text" sortable="true" />
      <ui:display-field displayText="Item Name" name="name" dataType="Text" sortable="true" />
      <ui:display-field displayText="Description" name="description" dataType="Text" sortable="true" />
      <ui:display-field displayText="Category" name="category" dataType="Text" sortable="true" />
      <ui:display-field displayText="SubCategory" name="subCategory" dataType="Text" sortable="true" />
      <ui:display-field displayText="Status" name="status" dataType="Text" sortable="true" />
    </ui:field-group>
    <ui:buttons>
      <ui:button displayText="Next" id="next" enabledBySelections="true" />
    </ui:buttons>
  </ui:table>
  <ui:script><![CDATA[function onLoad()
  {
    onLoadSuper();
    scrollHelper();
    setFocus();
  }

  function onResize()
  {
    onResizeSuper();
    scrollHelper();
  }
  function onBack()
  {
    document.location='view.x2ps?BUTTON_ID=SYS_BACK&PAGE=' + document.form.PAGE.value;
  }]]></ui:script>
</ui:page-group>

