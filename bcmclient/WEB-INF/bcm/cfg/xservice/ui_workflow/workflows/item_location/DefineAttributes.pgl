<?xml version="1.0" encoding="UTF-8"?>
<ui:page-group xmlns:ui="http://www.i2.com/ui">

  <ui:table id="table1" displayText="Selected Item"  select="items" rowSrc="item" scrollable="true" collapsable="true" configurable="false" exportable="false" help="{$pages:ItemLocation_DefineAttributes}" maxRows="-1">
    <ui:field-group>
      <ui:link-field displayText="Item ID" name="itemID" dataType="Text" sortable="false" />
      <ui:display-field displayText="Item Name" name="name" dataType="Text" sortable="false" />
      <ui:display-field displayText="Description" name="description" dataType="Text" sortable="false" />
      <ui:display-field displayText="Category" name="category" dataType="Text" sortable="false" />
      <ui:display-field displayText="SubCategory" name="subcategory" dataType="Text" sortable="false" />
      <ui:display-field displayText="Status" name="status" dataType="Text" sortable="false" />
    </ui:field-group>
  </ui:table> 

  <ui:table id="table2" displayText="Selected Locations" select="locations" rowSrc="location" scrollable="true"   collapsable="true" configurable="false" exportable="false" maxRows="-1" sortBy="$root/DEFAULTS/SORT_BY/@Value" sortOrder="$root/DEFAULTS/SORT_ORDER/@Value" help="{$pages:todo}"
    >
    <ui:validation anyFieldIsRequired="false"/>
    <ui:field-group>

    <ui:link-field
         displayText="Location ID" name="locationID"
         dataType="Text" 
         sortable="false"  
         >
    </ui:link-field>

    <ui:display-field
         displayText="Name"
         name="name"
         dataType="Text"
         sortable="false"  
    />

    <ui:display-field
         displayText="Type"
         name="type"
         dataType="Text"
         sortable="false"  
    />
    </ui:field-group>
 
  </ui:table>

  <ui:container inner="true" id="container1" collapsable="true" scrollable="true" >
    <ui:step id="container1_step" select="." displayText="Define Item Location Attributes" scrollable="true" selected="true" collapsable="true" editable="true">

      <ui:validation/>
      <ui:field-group columns="2">
        <ui:field-group displayText="Policies" >
            
          <ui:dropdown sort="true" 
                displayText="Replenishment Policy"
                dataType="Text"
                name="replenishmentPolicy"
                selectAll="false" 
                optionSrc="$root/OPTIONS/ITEMLOC_REP_POLICY/*" 
                onChange="javascript:onChangeReplenishmentPolicy()"/>

          <ui:dropdown
                displayText="Safety Stock Type"
                dataType="Text"  selectOne="false" 
                name="safetyStockType"  optionSrc="$root/OPTIONS/ITEMLOC_SAFETY_STOCK_TYPE/*"
                onChange="javascript:onChangeSafetyStockType()"/>

          <ui:dropdown
                displayText="Demand Type"
                dataType="Text"  selectOne="true"
                name="demandType"  optionSrc="$root/OPTIONS/DEMAND_TYPE/*"
                />

          <ui:dropdown
                displayText="Storage Class"
                dataType="Text"  selectOne="true"
                name="storageClass"  optionSrc="$root/OPTIONS/STORAGE_CLASS/*"
                />
          <ui:dropdown
                displayText="Inventory Policy"
                dataType="Text"  selectOne="true"
                name="inventoryPolicy"  optionSrc="$root/OPTIONS/ITEMLOC_INVENTORY_POLICY/*"
                />
                
          <ui:dropdown
                displayText="Is Production Buffer"
                dataType="Text" selectOne="false"
                name="isProductionPlanBuffer" optionSrc="$root/OPTIONS/BOOLEAN/*" defaultValue="FALSE"
                />
          <ui:dropdown
                displayText="Is Sellable"
                dataType="Text" selectOne="false"
                name="isSellable" optionSrc="$root/OPTIONS/BOOLEAN/*" defaultValue="FALSE"
          />
        </ui:field-group>
        
        <ui:field-group displayText="Properties">
          <ui:entry-field  
                displayText="Description"
                dataType="Constant"
                name="description"
                />

          <ui:entry-field  
                displayText="Planner Code"
                dataType="Constant"
                name="plannerCode"
                />
          <ui:dropdown
                displayText="Supply Chain Stage"
                dataType="Text"
                name="udSupplyChainStage" optionSrc="$root/OPTIONS/SUPPLY_CHAIN_STAGE/*"
                />

          <ui:dropdown
                displayText="BERI Point"
                dataType="Text"
                name="udBERIPoint" optionSrc="$root/OPTIONS/BOOLEAN/*"
                />
          <ui:entry-field  
                displayText="Demand Priority"
                dataType="Number"
                name="demandPriority"
                >
                  <ui:custom-validator
                validationFunction="validateDemandPriority"
                severity="STOP"
                />
          </ui:entry-field>
          <ui:entry-field  
                displayText="Average Selling Price"
                dataType="Currency"
                name="averageSellingPrice">
               <ui:custom-validator
                validationFunction="validateAverageSellingPrice"
                severity="STOP"
                />
          </ui:entry-field>

        </ui:field-group>


        <ui:field-group displayText="Release Parameters">
          <ui:entry-field  
                displayText="Release Fence" id="releaseFence"
                dataType="Number"
                name="releaseFence">
            <ui:custom-validator
                validationFunction="validateReleaseFence"
                severity="STOP"
                />
          </ui:entry-field>

          <ui:dropdown
                displayText="Release Fence UOM" id="udReleaseFenceUOM"
                dataType="Text" selectOne="true"
                name="udReleaseFenceUOM" optionSrc="$root/OPTIONS/TIME_UOM/*" defaultValue="DAY"
                />
 
          <ui:dropdown
                displayText="Release Block"
                dataType="Text"
                name="releaseBlock" optionSrc="$root/OPTIONS/BOOLEAN/*"  
                />
          <ui:dropdown
                displayText="Rel Agnst Sched Receipts"
                dataType="Text"
                name="releaseAgainstScheduledReceiptsFlag" optionSrc="$root/OPTIONS/BOOLEAN/*"  
                />

          <ui:dropdown
                displayText="Release Co Product"
                dataType="Text"
                name="udReleaseCoProductPO" optionSrc="$root/OPTIONS/BOOLEAN/*" 
                />

        </ui:field-group>
 
        <ui:field-group displayText="Safety Stock Parameters">
          <ui:entry-field
                displayText="Min On Hand"
                dataType="Number"  id="minOnHand"
                name="minOnHand">
            <ui:custom-validator
                validationFunction="validateMinOnHand"
                severity="STOP"
                />
          </ui:entry-field>
          <ui:entry-field
                displayText="Max On Hand" id="maxOnHand"
                dataType="Constant"
                name="maxOnHand"
                > 
            <ui:custom-validator
                validationFunction="validateMaxOnHand"
                severity="STOP"
                />
          </ui:entry-field>


          <ui:entry-field
                displayText="Coverage Period"
                dataType="Number" defaultValue="1"  minValue="1" maxValue="80"
                name="coveragePeriod" id="coveragePeriod">
            <ui:custom-validator
                validationFunction="validateCoveragePeriod"
                severity="STOP"
                />
          </ui:entry-field>


          <ui:entry-field
                displayText="Look Ahead Period"
                dataType="Number" defaultValue="1" minValue="1" maxValue="80"
                name="lookAheadPeriod" id="lookAheadPeriod">
                
            <ui:custom-validator
                validationFunction="validateLookAheadPeriod"
                severity="STOP"
              />
          </ui:entry-field>


          <ui:entry-field
                displayText="Days Of Coverage"
                dataType="Number"
                name="daysOfCoverage"  id="daysOfCoverage"  minValue="0">
             <ui:custom-validator
                validationFunction="validateDaysOfCoverage"
                severity="STOP"
                />
          </ui:entry-field>
          <ui:entry-field
                displayText="Max Days Of Coverage"
                dataType="Number"     minValue="0"
                name="maxDaysOfCoverage" id="maxDaysOfCoverage">
            <ui:custom-validator
                validationFunction="validateMaxDaysOfCoverage"
                severity="STOP"
                />
          </ui:entry-field>
          <ui:dropdown
                displayText="Period UOM" massEntry="true"
                dataType="Text"  id="periodUOM"
                name="periodUOM" optionSrc="$root/OPTIONS/TIME_UOM/*" defaultValue="WK"
                />
          <ui:dropdown
                displayText="Quantity UOM" 
                dataType="Text"   id="qtyUOM" selectOne="true"
                name="qtyUOM" optionSrc="$root/OPTIONS/QTY_UOM/*" defaultValue="EA"
                />
 
          <ui:entry-field
                displayText="Safety Stock Policy"
                dataType="Text"  id="safetyStockPolicy"  editable="false"
                name="safetyStockPolicy" displayNoWrap="false"
                />

        </ui:field-group>
      </ui:field-group>
      <ui:buttons>
        <ui:button id="next" displayText="Next"/>
<!--        <ui:button id="test" displayText="test " onClick="javascript:test()" />-->
      </ui:buttons>
    </ui:step>
  </ui:container>

 <!-- Common Functions- move it to a pgl.js-->
  <ui:script>
  <![CDATA[
  function isValidNumber(elemValue)
  {
    if ( elemValue != "" && isNaN(elemValue) )
    {
      return false;
    }
    else return true;
  }
  function getNumericValue(elemValue)
  {
    return parseInt(elemValue.replace(/[,\.]+/g, ""));
  }
  function hideField(id)
  {
    toggleField(id,'hide');
  }
  function showField(id)
  {
    toggleField(id,'show');
  }
  function toggleField(id,state)
  {
    fieldCell  = document.getElementById(id + '_td');
    fieldRow = fieldCell.parentNode;
    toggleItemVisibility(fieldRow, state);

    var i = document.getElementById(id);
    if (state=="hide") 
    {
      //validation_clearFieldErrors(i);
      i.disabled = true;
    }
    else 
    {
        i.disabled = false;
        i.enabled = true;
    }
  }

   function makeFieldSelectable(id)
  {
    var field  = document.getElementById(id);
    var fieldCell = field.parentNode;
    var fieldRow = fieldCell.parentNode;

    toggleItemVisibility(fieldRow, state);

    var i = document.getElementById(id);
    if (state=="hide") 
    {
      //validation_clearFieldErrors(i);
      i.disabled = true;
    }
    else 
    {
        i.disabled = false;
        i.enabled = true;
    }
  }

  ]]>
  </ui:script>

 <!-- Page Functions-->
 <ui:script>
  <![CDATA[
   var safetyStockType_previous = document.form.safetyStockType.value;
   var replenishmentPolicy_previous = document.form.replenishmentPolicy.value;
      
  function onLoad()
  {
    onLoadSuper();
    scrollHelper();
    setFocus();
    toggleSafetyStockParameters();
  }
  function onResize()
  {
    onResizeSuper();
    scrollHelper();
  }

  function onChangeReplenishmentPolicy()
  {
    if( core_confirm("You have changed the Replenishment Policy. Parameters specific to this type will be reset. Do you want to continue?") == 'yes' )
    {
     replenishmentPolicy_previous = document.form.replenishmentPolicy.value;
     javascript:ui_submit('SYS_RELOAD')
    }
    else
    {
       document.form.replenishmentPolicy.value=replenishmentPolicy_previous;
    }
  }

  function onChangeSafetyStockType()
  {
    if( core_confirm("You have changed the Safety Stock Type. Parameters specific to this type will be reset. Do you want to continue?") == 'yes' )
    {
      safetyStockType_previous = document.form.safetyStockType.value;
      validation_clearMessages('container1_step');
      toggleSafetyStockParameters();
    }
    else
    {
      document.form.safetyStockType.value=safetyStockType_previous;
    }
  }

  function hideAllSafetyStockParameters()
  {
    hideField('minOnHand');
    hideField('maxOnHand');
    hideField('coveragePeriod');
    hideField('lookAheadPeriod');
    hideField('daysOfCoverage');
    hideField('maxDaysOfCoverage');
    hideField('periodUOM');
    hideField('qtyUOM');
    hideField('safetyStockPolicy');
  }
  function toggleSafetyStockParameters()
  {
    hideAllSafetyStockParameters();
    if(document.form.safetyStockType.value == 'Fixed' )
    {
      showField('minOnHand');
      showField('maxOnHand');
//      if ( trimString(document.form.maxOnHand.value) =='') document.form.maxOnHand.value='Infinite';
      showField('daysOfCoverage');
      showField('maxDaysOfCoverage');
      showField('qtyUOM');
      showField('safetyStockPolicy');
    }
    else if(document.form.safetyStockType.value == 'Infinite')
    {
      showField('safetyStockPolicy');
    }
    else if(document.form.safetyStockType.value == 'TimePhasedIP')
    {
      showField('coveragePeriod');
      showField('lookAheadPeriod');
      showField('daysOfCoverage');
      showField('maxDaysOfCoverage');
      showField('periodUOM');
      showField('safetyStockPolicy');
    }
    else if(document.form.safetyStockType.value == 'TimePhasedUser')
    {
      showField('maxOnHand');
      if ( document.form.maxOnHand.value.toUpperCase() == 'INFINITE') document.form.maxOnHand.value='';
      showField('daysOfCoverage');
      showField('maxDaysOfCoverage');
      showField('qtyUOM');
      showField('safetyStockPolicy');
    }
    else if(document.form.safetyStockType.value == 'SupplyCalendar')
    {
      showField('maxOnHand');
      if ( document.form.maxOnHand.value.toUpperCase() == 'INFINITE') document.form.maxOnHand.value='';
      showField('qtyUOM','show');
      showField('safetyStockPolicy');
    }
  }


  function validateMinMaxOnHand(validator, field)
  {
    var max= document.form.maxOnHand;
    var min= document.form.minOnHand_N0;
    if(!max.disabled && !min.disabled)
    { 
      if (trimString(max.value) == '' ) return true;
      if (max.value.toUpperCase() == 'INFINITE') return true;

      if(max.value-min.value < 0)
      {
        validator.message="Max Qty On Hand must be greater than Min Qty On Hand";
        return false;
      }
      else
      {
        return true;
      }
    }           
    return true;
  }

  function validateMaxOnHand(validator, field)
  {   
    if(trimString(field.value) !='')
    {
     if (isValidNumber(field.value) &&  field.value < 0)
      {                  
        validator.message="Max On Hand must be Positive"; 
        return false;
      }
      else if (!isValidNumber(field.value) && field.value.toUpperCase() != 'INFINITE')
      {                  
        validator.message="Max On Hand must be numeric or Infinite"; 
        return false;
      }
      else
      {
         return validateMinMaxOnHand(validator,field);
      }
    } 
    return true;
  }

  function validateMinOnHand(validator, field)
  {
     if (field.value < 0)
     {                  
        validator.message="Min On Hand must be Positive"; 
        return false;
      }
      else
        return  validateMinMaxOnHand(validator,field);
  }

  function validateCoveragePeriod(validator, field)
  {
     if (getNumericValue(field.value) < 1 || getNumericValue(field.value) > 80)
     {                  
        validator.message="Coverage Period must be between 1 and 80."; 
        return false;
      }
      else
        return  true;
  }

 function validateMaxDaysOfCoverage(validator, field)
  {
     if (getNumericValue(field.value) < 0)
     {                  
        validator.message="Max Days Of Coverage must be >= 0."; 
        return false;
      }
      else
        return  true;
  }

 function validateDaysOfCoverage(validator, field)
  {
     if (getNumericValue(field.value) < 0)
     {                  
        validator.message="Days Of Coverage must be >= 0."; 
        return false;
      }
      else
        return true;
  }

 function validateLookAheadPeriod(validator, field)
  {
     if (getNumericValue(field.value) < 1 || getNumericValue(field.value) > 80)
     {                  
        validator.message="Look Ahead Period must be between 1 and 80."; 
        return false;
      }
      else
        return  true;
  }
  
  function validateReleaseFence(validator, field)
  {
     if (getNumericValue(field.value) < 1 || getNumericValue(field.value) > 365)
     {                  
        validator.message="Release Fence must be between 1 and 365."; 
        return false;
      }
      else
        return  true;
  }
   function validateDemandPriority(validator, field)
  {
     if (getNumericValue(field.value) < 0)
     {                  
        validator.message="Demand Priority must be >= 0."; 
        return false;
      }
      else
        return true;
  }
 function validateAverageSellingPrice(validator, field)
  {
     if (getNumericValue(field.value) < 0)
     {                  
        validator.message="Average Selling Price must be >= 0."; 
        return false;
      }
      else
        return true;
  }
  
  ]]>
<!--   10)	Min Time and Max Time-->
  </ui:script>

 <!-- Test Functions-->
  <ui:script>
  <![CDATA[
  function test()
  {
    var bIsValid = true;
    document.form.SUBMIT_AS_XML.value = 'false';
    bIsValid = (isValid_container1_step());
    if( bIsValid == false )
    {
      validation_alert('container1_step');
    }
  }
  ]]>
  </ui:script>

  <ui:script select="string(JAVASCRIPT)"/>
</ui:page-group>