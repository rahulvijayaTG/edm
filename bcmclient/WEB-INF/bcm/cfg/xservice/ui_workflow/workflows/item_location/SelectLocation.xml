    <ui_form2 Name="Select Location" Description="Select Location" OutputFormVar="pglFormOutput" InputFormVar="pglFormInput" Template="SelectLocation.pgl" InputVar="{nodeInput,xml}" ShowInBreadCrumbs="SHOW">
      <pre_actions>
        <action>
          <REQUEST Name="setPaginationAndSortingDefaults" ServiceName="UI_WORKFLOW" AssignToVar="defaults" UserId="{$userId}">
            <DEFAULTS>
              <SORT_BY Value="locationID"/>
            </DEFAULTS>
            <TO_XML SelectList="$thisParam/*"/>
          </REQUEST>
          <FORM_SEARCH_FILTER Value="{$thisParam}" AssignToVar="filters">
            <locationID MultiValued="true" InputName="FILTER_locationID"/>
            <name MultiValued="true" InputName="FILTER_name"/>
            <type MultiValued="true" InputName="FILTER_type"/>
          </FORM_SEARCH_FILTER>
          <REQUEST Name="getDocSmart" ServiceName="BCM_MASTER" DocumentName="Location" AssignToVar="response" UserId="{$userId}" ReturnRowCount="yes" MaxRows="{$defaults/DEFAULTS/MAX_ROWS/@Value}" StartAtRow="{$defaults/DEFAULTS/START_COUNT/@Value}">
            <TO_XML SelectList="$filters/FILTER/*"/>
            <TO_XML Select="$defaults/DEFAULTS/ORDER_BY"/>
            <NOT_EXISTS_QDL Name="FK_LOCATION_ITEM_LOC_MASTER">
              <itemID Value="{$thisParam/itemID/@Value}"/>
            </NOT_EXISTS_QDL>
          </REQUEST>
          <PRINT Value="$response sudhir"/>
          <PRINT Value="{$response}"/>
          <TO_DOCVAR AssignToVar="pglFormInput">
            <ROOT>
              <TO_XML SelectList="$defaults/*"/>
              <TO_XML SelectList="$thisParam/*"/>
              <LOCATIONS TotalRowCount="{$response/@TotalRowCount}">
                <TO_XML SelectList="$response/*"/>
              </LOCATIONS>
              <IF_TEST Test="count($response/Location) = 0">
                <THEN>
                  <APPEND_TO_XML>
                    <ERROR_MESSAGE Value="All existing locations already have ItemLocation defined for the selected item."/>
                  </APPEND_TO_XML>
                </THEN>
              </IF_TEST>
            </ROOT>
          </TO_DOCVAR>
        </action>
      </pre_actions>
      <post_actions>
        <TO_DOCVAR AssignToVar="nodeOutput">
          <PARAMETERS>
            <TO_XML SelectList="$thisParam/*"/>
          </PARAMETERS>
        </TO_DOCVAR>
      </post_actions>
      <if_cond Value="$userAction = 'search_button'">
        <next_nodes OutputVar="{pglFormOutput,xml}">
          <next_node Name="Select Location" Description=""/>
        </next_nodes>
      </if_cond>
      <else_if_cond Value="true()">
        <next_nodes OutputVar="{pglFormOutput,xml}">
          <next_node Name="done4" Description=""/>
        </next_nodes>
      </else_if_cond>
    </ui_form2>
    <done Name="done4">
      <actions>
        <action>
          <FORM_SEARCH_FILTER Value="{$thisParam}" AssignToVar="filters">
            <locationID MultiValued="true" InputName="S_locationID"/>
          </FORM_SEARCH_FILTER>
          <REQUEST Name="getDocSmart" ServiceName="BCM_MASTER" DocumentName="Location" AssignToVar="response" UserId="{$userId}">
            <TO_XML SelectList="$filters/FILTER/*"/>
          </REQUEST>
          <APPEND_TO_XML DocVar="thisReturn">
            <locations>
              <FOR_EACH CurrentElement="loc" SelectList="$thisParam/S_locationID">
                <APPEND_TO_XML>
                  <location>
                    <TO_XML SelectList="$response/Location[locationID/@Value = $loc/@Value]/*"/>
                  </location>
                </APPEND_TO_XML>
              </FOR_EACH>
            </locations>
          </APPEND_TO_XML>
        </action>
      </actions>
      <next_nodes/>
    </done>
