<?xml version="1.0" encoding="UTF-8"?>
<workflow mgcCount="289" Version="1.0" Name="SelectItem" Description="" Type="" PrimaryDocument="" IsStartAllowed="Yes">
  <nodes>
    <start Name="start">
      <next_nodes OutputVar="{nodeOutput,xml}">
        <next_node Name="Select Item" Description=""/>
      </next_nodes>
      <actions>
        <action>
          <TO_DOCVAR AssignToVar="nodeOutput">
            <PARAMETERS>
              <TO_XML SelectList="$thisParam/*"/>
            </PARAMETERS>
          </TO_DOCVAR>
        </action>
      </actions>
    </start>
    <done Name="done4">
      <next_nodes/>
      <actions>
        <action>
          <REQUEST Name="getDocSmart" ServiceName="BCM_MASTER" DocumentName="Item" AssignToVar="response" UserId="{$userId}">
            <itemID Value="{$thisParam/S_itemID/@Value}"/>
          </REQUEST>
          <APPEND_TO_XML SelectList="$thisReturn">
            <items>
              <item>
                <TO_XML SelectList="$response/Item/*"/>
              </item>
            </items>
          </APPEND_TO_XML>
        </action>
      </actions>
    </done>
    <ui_form2 Name="Select Item" Description="Select Item" OutputFormVar="pglFormOutput" InputFormVar="pglFormInput" Template="SelectItem.pgl" InputVar="{nodeInput,xml}" ShowInBreadCrumbs="SHOW">
      <pre_actions>
        <action>
          <REQUEST Name="setPaginationAndSortingDefaults" ServiceName="UI_WORKFLOW" AssignToVar="defaults" UserId="{$userId}">
            <DEFAULTS>
              <SORT_BY Value="ITEM_ID"/>
            </DEFAULTS>
            <TO_XML SelectList="$thisParam/*"/>
          </REQUEST>
          <FORM_SEARCH_FILTER Value="{$thisParam}" AssignToVar="filters">
            <itemID MultiValued="true" InputName="FILTER_itemID"/>
            <name MultiValued="true" InputName="FILTER_name"/>
            <description MultiValued="true" InputName="FILTER_description"/>
            <category MultiValued="true" InputName="FILTER_category"/>
            <subCategory MultiValued="true" InputName="FILTER_subCategory"/>
            <status MultiValued="true" InputName="FILTER_status"/>
          </FORM_SEARCH_FILTER>
          <REQUEST Name="getDocSmart" ServiceName="BCM_MASTER" DocumentName="Item" AssignToVar="response" UserId="{$userId}" ReturnRowCount="yes" MaxRows="{$defaults/DEFAULTS/MAX_ROWS/@Value}" StartAtRow="{$defaults/DEFAULTS/START_COUNT/@Value}">
            <TO_XML SelectList="$filters/FILTER/*"/>
            <TO_XML Select="$defaults/DEFAULTS/ORDER_BY"/>
          </REQUEST>
          <TO_DOCVAR AssignToVar="pglFormInput">
            <ROOT>
              <TO_XML SelectList="$nodeInput/*"/>
              <TO_XML SelectList="$defaults/*"/>
              <TO_XML SelectList="$thisParam/*"/>
              <items TotalRowCount="{$response/@TotalRowCount}">
                <TO_XML SelectList="$response/*"/>
              </items>
            </ROOT>
          </TO_DOCVAR>
        </action>
      </pre_actions>
      <post_actions>
        <action>
          <SET Var="userAction" FromValue="SAMEPAGE"/>
          <IF_TEST Test="$pglFormOutput/BUTTON_ID/@Value = 'next'">
            <THEN>
              <REQUEST Name="getDocSmart" ServiceName="BCM_MASTER" DocumentName="Location" AssignToVar="responseVar" ReturnRowCount="yes" MaxRows="{$pglFormOutput/MAX_ROWS/@Value}" StartAtRow="{$pglFormOutput/START_COUNT/@Value}">
                <NOT_EXISTS_QDL Name="FK_LOCATION_ITEM_LOC_MASTER">
                  <itemID Value="{$pglFormOutput/S_itemID/@Value}"/>
                </NOT_EXISTS_QDL>
              </REQUEST>
            </THEN>
          </IF_TEST>
          <TO_DOCVAR AssignToVar="pglFormOutput">
            <ROOT>
              <TO_XML SelectList="$responseVar/*"/>
              <IF_TEST Test="count($responseVar/Location) = 0">
                <THEN>
                  <APPEND_TO_XML>
                    <ERROR_MESSAGE Value="All existing locations already have ItemLocation defined for the selected item."/>
                  </APPEND_TO_XML>
                </THEN>
                <ELSE>
                  <SET Var="userAction" FromValue="next"/>
                </ELSE>
              </IF_TEST>
            </ROOT>
          </TO_DOCVAR>
        </action>
      </post_actions>
      <if_cond Value="$userAction='next'">
        <next_nodes OutputVar="{pglFormOutput,xml}">
          <next_node Name="done4" Description=""/>
        </next_nodes>
      </if_cond>
      <else_if_cond Value="$userAction ='SAMEPAGE'">
        <next_nodes OutputVar="{pglFormOutput,xml}">
          <next_node Name="Select Item" Description=""/>
        </next_nodes>
      </else_if_cond>
      <else_if_cond Value="true()">
        <next_nodes OutputVar="{pglFormOutput,xml}"/>
      </else_if_cond>
    </ui_form2>
  </nodes>
