<ui:page-group xmlns:ui="http://www.i2.com/ui">
  <ui:container scrollable="true">
    <ui:step id="main" displayText="Audit Trail Search">
      <ui:search displayText="Search" saveSearch="false" exportSearch="false" anyFieldIsRequired="true">
        <ui:field-group rows="1" select="$root" columns="3">
          <ui:hidden-field name="TABLE_NAME" id="TABLE_NAME" />
          <ui:hidden-field name="SERVICE_NAME" id="SERVICE_NAME" />
          <ui:hidden-field name="AUDIT_DAYS" id="AUDIT_DAYS" />
          <ui:field-group>
            <ui:dropdown name="AUDIT_TRAIL_NAME" id="AUDIT_TRAIL_NAME" selectAll="false" displayText="Entity Name" selectOne="true" optionSrc="$root/ENTITIES/*" onChange="javascript:changeEntity();" sort="ascending" required="true" onFocus="javascript:onEntityListFocus();" onClick="javascript:onEntityListFocus();" />
            <ui:date-range id="DATE" name="DATE" toDate="{$root/DATES/TO_DATE/@Value}" fromDate="{$root/DATES/FROM_DATE/@Value}" displayText="Date Range" required="true" />
            <ui:dropdown displayText="Search Condition" id="SEARCH_COND" name="SEARCH_COND" size="1" displayNoWrap="true">
              <ui:option id="SEARCH_COND_ANY" value="Any" />
              <ui:option id="SEARCH_COND_ALL" value="All" />
            </ui:dropdown>
          </ui:field-group>
          <ui:dropdown displayText="Audit Fields" id="AUDIT_FIELD_FILTER" name="AUDIT_FIELD_FILTER" size="5" optionSrc="$root/AUDIT_FIELDS/*" preferredWidth="60" />
        </ui:field-group>
      </ui:search>
      <ui:dynamic-pgl select="$root/PGL/*" />
      <!--ui:buttons>
        <ui:button id="back" displayText="Back" onClick="javascript:history.back()"/>
      </ui:buttons-->
    </ui:step>
  </ui:container>
  <ui:script>
    function onKeyPress( target )
   {
   }
   
    function popUpWindow(url,popUp) {
		
    var h = screen.availHeight;
    var w = screen.availWidth;
    
    var popW;
    var popH;
    var leftPos;
    var topPos;
    var bScrollbars;
    var bResizable;
    if (popUp=="popUp6") 
                { 
                
                    popW = 800;
                    popH = 600;
                    
                    leftPos = (w-popW)/2;
                    topPos = (h-popH)/2;
                    
                    if (window.popUp6) 
                        { 
                            window.popUp6.close(); 
                            } 
                    window.popUp6 = window.open(url,'popUp','height=160, width=800, top=' + topPos + ', left=' + leftPos + ', scrollbars=yes, resizable=yes');
                   

    		}
    }
		function changeEntity()
    		{
    		
    		validation_clearMessages('search');
		if (isValid_search())
		{
      			form.BUTTON_ID.value = "change_entity";
      			form.submit();
		}
		}
		
		function onSearch()
		{
		validation_clearMessages('search');
		        if ( validate_search() == true )
		            {
		                disableButton('search_button');
		               try
				{
		                  document.form.START_COUNT.value=0;
		                  document.form.SORT_ORDER.disabled=true;
		                  document.form.SORT_BY.disabled=true;
		                } catch(e){}
		                document.form.DO_SEARCH.value='Yes';
		                document.form.BUTTON_ID.value="search_button";
		                document.form.submit();
		            }
		            else
		            {
		              validation_alert('search');
		            }
    			}
    			
    		function onEntityListFocus()
    		{
    			validation_clearMessages('search');
    			if (!isValid_field('FROM_DATE_DC',null) )
    			{
    				core_alert("Please populate the Date range before changing the Entity");
    				form.FROM_DATE_DC.focus();
    				return true;
    				}
    			if (!isValid_field('TO_DATE_DC',null) )
    			{
    				core_alert("Please populate the Date range before changing the Entity");
    				form.TO_DATE_DC.focus();
    				return true;
    				}
    		}
    <!-- Start custom javascript: Insert your custom javascript functions here -->
    function onChangeCREATION_DATE_DT()
       {
         addTime(document.form.FILTER_FROM_CREATION_DATE_DT, '00:00:00');
         addTime(document.form.FILTER_TO_CREATION_DATE_DT, '23:59:59');
         ui_switch_image_date_range(document.form.FILTER_FROM_CREATION_DATE_DT.value, document.form.FILTER_TO_CREATION_DATE_DT.value,document.form.IMG_CREATION_DATE_DT);
       }
    
    function addTime(dateField, timeComponent)
    {
      var elemValue = dateField.value.trim();
      if (elemValue.length &gt; 0)
     {
       if ( isDate(elemValue, page_dateTimeFormat) == false )
       {
          if (isDate(elemValue, page_dateFormat) == true)
              dateField.value     = formatDate(new Date(getDateFromFormat(elemValue + ' '+timeComponent, page_dateFormat + ' HH:mm:ss')), page_dateTimeFormat);
        }
       else if (timeComponent == '23:59:59')
       {
           var newDate = new Date(getDateFromFormat(elemValue,page_dateTimeFormat));
           if ((newDate.getHours() == 0) &amp;&amp; (newDate.getMinutes() ==0))
          {
             newDate.setHours(23);
             newDate.setMinutes(59);
             newDate.setSeconds(59);
             dateField.value = formatDate(newDate, page_dateTimeFormat);
          }
       }
    }
    
    }

		
		  function onChangeDATE_td()
   {
     addTime(document.form.FROM_DATE_DC, '00:00:00');
     addTime(document.form.TO_DATE_DC, '23:59:59');
     ui_switch_image_date_range(document.form.FROM_DATE_DC.value, document.form.TO_DATE_DC.value,document.form.IMG_DATE_TD);
   }
    <!-- End custom javascript: -->
  </ui:script>
</ui:page-group>

