<ui:page-group xmlns:ui="http://www.i2.com/ui" Id="viewCurrentValue.pgl">
  
 <ui:script>function onLoad()
		{
		  window.document.title='Current Value';
		  onLoadSuper();
		    scrollHelper();
  			autoCollapseRows(); // may be empty (default impl)
		  
		}</ui:script>
<ui:container id="auditData" scrollable="true">
    <ui:step id="tview" scrollable="true" >
      <ui:dynamic-pgl select="$root/DYNAMIC_PGL_DATA/*" />
      <ui:buttons>
        <ui:button id="back" name="back" displayText="Close" />
      </ui:buttons>
    </ui:step>
  </ui:container>
</ui:page-group>

