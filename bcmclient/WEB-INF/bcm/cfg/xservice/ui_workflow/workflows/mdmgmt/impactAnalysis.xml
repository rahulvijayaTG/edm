<workflow mgcCount="63" ShowInBreadCrumbs="true" Version="1.0" Name="ImpactAnalysis" Description="">
  <variables/>
  <nodes>
    <start Name="start" Description="start">
      <actions>
        <action>
          <TO_DOCVAR AssignToVar="pglFormOutput">
            <TO_XML SelectList="$thisParam"/>
          </TO_DOCVAR>
        </action>
      </actions>
      <next_nodes OutputVar="{pglFormOutput,xml}">
        <next_node Name="Impact Analysis Details" Description=""/>
      </next_nodes>
    </start>
    <done Name="done" Description="done">
      <actions>
      </actions>
      <next_nodes/>
    </done>
    <ui_form2 Name="Impact Analysis Details" OutputFormVar="pglFormOutput" InputFormVar="pglFormInput" ShowInBreadCrumbs="SHOW" Template="impactAnalysis.pgl" Description="Impact Analysis Details Form" InputVar="{root,xml}">
      <pre_actions>
        <action>
          <PRINTLN Value="$root: {$root}"/>
          <PRINTLN Value="$thisParam: {$thisParam}"/>
          <SET Var="paginateStart" FromValue="{ifElse($thisParam/START_COUNT/@Value = null, '0', $thisParam/START_COUNT/@Value)}"/>
          <SET Var="maxRows" FromValue="{ifElse($thisParam/MAX_ROWS/@Value = null, '10', $thisParam/MAX_ROWS/@Value)}"/>
          <TO_DOCVAR AssignToVar="pglFormInput">
            <ROOT>
            </ROOT>
          </TO_DOCVAR>
          <!-- collect data element details for header display -->
          <REQUEST ServiceName="BPE_META" Name="getEntityDetails" AssignToVar="response" UserId="{$userId}">
            <ID Value="{$root/ID/@Value}"/>
          </REQUEST>
          <APPEND_CHILDREN DocVar="pglFormInput" FromDocVar="response"/>
          <SET Var="headerDoc" FromSelect="$pglFormInput/META_DATA_SEARCH"/>
          <REQUEST ServiceName="BPE_META" Name="getDataElemRelationDetails" AssignToVar="response" UserId="{$userId}" HandleException="true">
            <DATA_ELEMENT Value="{$headerDoc/ENTITY_NAME/@Value}"/>
            <DATA_GRP Value="{$headerDoc/DATA_GRP/@Value}"/>
            <DATA_PKG Value="{$headerDoc/DATA_PKG/@Value}"/>
          </REQUEST>
          <IF_TEST Test="$response/@Status = 'Error'">
            <THEN>
             <SET DocVar="pglFormInput" Property="ERROR_TAG" FromValue="No entry exists in thesaurusDef for this entity. You cannot perform Impact Analysis on it."/>
            </THEN>
            <ELSE>
              <APPEND_CHILDREN DocVar="pglFormInput" FromDocVar="response"/>
              <SET Var="targets" FromSelect="$pglFormInput/DATA_ELEMENT/TARGETS"/>
              <SET Attribute="TotalRowCount" DocVar="targets" FromValue="{count($targets/DATA_ELEMENT)}"/>
              <SET Var="sources" FromSelect="$pglFormInput/DATA_ELEMENT/SOURCES"/>
              <SET Attribute="TotalRowCount" DocVar="sources" FromValue="{count($sources/DATA_ELEMENT)}"/>
              <SET DocVar="pglFormInput" Property="ID" FromValue="{$root/ID/@Value}"/>
             </ELSE>
          </IF_TEST>
        </action>
      </pre_actions>
      <if_cond Value="true()">
        <next_nodes OutputVar="">
          <next_node Name="done" Description=""/>
        </next_nodes>
      </if_cond>
    </ui_form2>
  </nodes>
