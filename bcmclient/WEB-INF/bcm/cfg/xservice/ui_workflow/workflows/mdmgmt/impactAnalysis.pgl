<ui:page-group xmlns:ui="http://www.i2.com/ui" name="studio.templates.simple_entry" source="studio.controller:load">
  <ui:container collapsable="false">
    <ui:help displayPage="{$pages:impactAnalysis}"/>
    <ui:step id="header" displayText="Impact Analysis" select="$root/META_DATA_SEARCH">
      <ui:field-group columns="2" id="validation" displayCondition="{count($root/ERROR_TAG) > 0}">
          <ui:image name="validationImg" src="/alert_static.gif"/>
          <ui:display-field value="{$root/ERROR_TAG/@Value}"/>
      </ui:field-group>
      <ui:field-group columns="2" id="fieldGroups">
        <ui:field-group id="LeftFields">
          <ui:display-field displayText="Data Element" name="ENTITY_NAME" />
          <ui:display-field displayText="Physical Name" name="PHYSICAL_NAME" />
          <ui:display-field displayText="Data Group Name" name="DATA_GRP" />
          <ui:display-field displayText="Data Package Name" name="DATA_PKG" />
        </ui:field-group>
        <ui:field-group id="RightFields">
          <ui:display-field displayText="Data Steward" name="DATA_STEWARD" />
          <ui:display-field displayText="Last Modified" name="LAST_MODIFIED_DATE" />
          <ui:display-field displayText="Comments" name="COMMENTS" displayNoWrap="false"/>
        </ui:field-group>
      </ui:field-group>
      <ui:container id="details" collapsable="false">
        <ui:step id="sources_tab" displayText="Sources" displayCondition="{count($root/ERROR_TAG) = 0}">
          <ui:table id="bottomTable" displayText="Sources Details" select="$root/DATA_ELEMENT/SOURCES" collapsable="false" scrollable="true" displayTextNoRecords="" rowId="ID" postRowIdAs="ID" maxRows="{count($root/DATA_ELEMENT/SOURCES/DATA_ELEMENT)}">
            <ui:field-group id="sourceTableColumns">
              <ui:display-field name="ELEMENT_NAME" displayText="Data Element" />
              <ui:display-field name="DATA_STEWARD" displayText="Data Steward" />
              <ui:display-field name="GRP_NAME" displayText="Data Group" />
              <ui:display-field name="PKG_NAME" displayText="Data Package" />
              <ui:display-field name="PHYSICAL_NAME" displayText="Physical Name" />
              <ui:display-field name="TYPE" displayText="Type" />
              <ui:display-field name="RELATION_NAME" displayText="Relationship" />
              <ui:display-field name="RELATION_CARDINALITY" displayText="Relation Cardinality" />
              <ui:display-field name="RELATION_TYPE" displayText="Relation Type" />
              <ui:image-link-field displayText="Impact Analysis" src="/view_details.gif" name="ImpactAnalysis" dataType="Constant">
                <ui:url page="{$pages:ImpactAnalysis}">
                  <ID select="ID/@Value" />
                </ui:url>
              </ui:image-link-field>
              <ui:display-field name="RELATION_COMMENTS" displayText="Relation Comments" />
            </ui:field-group>
          </ui:table>
        </ui:step>
        <ui:step id="targets_tab" displayText="Targets" displayCondition="{count($root/ERROR_TAG) = 0}">
          <ui:table id="bottomTable" displayText="Targets Details" select="$root/DATA_ELEMENT/TARGETS" collapsable="false" scrollable="true" displayTextNoRecords="" rowId="ID" postRowIdAs="ID" maxRows="{count($root/DATA_ELEMENT/TARGETS/DATA_ELEMENT)}">
            <ui:field-group id="targetTableColumns">
              <ui:display-field name="ELEMENT_NAME" displayText="Data Element" />
              <ui:display-field name="DATA_STEWARD" displayText="Data Steward" />
              <ui:display-field name="GRP_NAME" displayText="Data Group" />
              <ui:display-field name="PKG_NAME" displayText="Data Package" />
              <ui:display-field name="PHYSICAL_NAME" displayText="Physical Name" />
              <ui:display-field name="TYPE" displayText="Type" />
              <ui:display-field name="RELATION_NAME" displayText="Relationship" />
              <ui:display-field name="RELATION_CARDINALITY" displayText="Relation Cardinality" />
              <ui:display-field name="RELATION_TYPE" displayText="Relation Type" />
              <ui:image-link-field displayText="Impact Analysis" src="/view_details.gif" name="ImpactAnalysis" dataType="Constant">
                <ui:url page="{$pages:ImpactAnalysis}">
                  <ID select="ID/@Value" />
                </ui:url>
              </ui:image-link-field>
              <ui:display-field name="RELATION_COMMENTS" displayText="Relation Comments" />
            </ui:field-group>
          </ui:table>
        </ui:step>
      </ui:container>
    </ui:step>
  </ui:container>
  <ui:script>function scrollHelper()
		{
      var totalAvailWidth = document.body.offsetWidth - 25; //scrollbars, frame border and padding width subtracted from the total allowed width
 		  var totalAvailHeight = document.body.offsetHeight - 90; //scrollbars, header, frame border and padding height is subtracted
      i2uiResizeScrollableContainer( 'header', 0.5 * totalAvailHeight, null, totalAvailWidth, true, 'yes');
			var searchContHt = getContainerHeight('header');
      i2uiResizeScrollableArea( 'bottomTable', totalAvailHeight - searchContHt - 90, totalAvailWidth - 21, null, 21,null,null,50);
		}</ui:script>
</ui:page-group>

