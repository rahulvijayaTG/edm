<ui:page-group xmlns:ui="http://www.i2.com/ui" name="studio.templates.simple_entry" source="studio.controller:load">
  <ui:container collapsable="false">
    <ui:help displayPage="{$pages:dataGrpDetails}" />
    <ui:step id="header" displayText="Data Group Details" select="$root/META_DATA_SEARCH">
      <ui:field-group columns="2" id="fieldGroups">
        <ui:field-group id="LeftFields">
          <ui:display-field displayText="Name" name="ENTITY_NAME" />
          <ui:display-field displayText="Physical Name" name="PHYSICAL_NAME" />
          <ui:display-field displayText="Data Package Name" name="DATA_PKG" />
        </ui:field-group>
        <ui:field-group id="RightFields">
          <ui:display-field displayText="Data Steward" name="DATA_STEWARD" />
          <ui:display-field displayText="Last Modified" name="LAST_MODIFIED_DATE" />
          <ui:display-field displayText="Comments" name="COMMENTS" displayNoWrap="false" />
        </ui:field-group>
      </ui:field-group>
      <ui:container id="details" collapsable="false">
        <ui:step id="data_elements_tab" displayText="Data Element Details">
          <ui:table id="bottomTable" displayText="Data Element Details" select="$root/MDS" collapsable="false" scrollable="true" maxRows="$root/MAX_Rows/@Value" displayTextNoRecords="" rowId="ID" postRowIdAs="ID">
            <ui:field-group id="detableColumns">
              <ui:display-field name="ENTITY_NAME" displayText="Data Element" sortable="true" />
              <ui:display-field name="DATA_STEWARD" displayText="Data Steward" />
              <ui:display-field name="PHYSICAL_NAME" displayText="Physical Name" />
              <ui:display-field name="TYPE" displayText="Type" />
              <ui:display-field name="PRIMARY_KEY" displayText="Is Primary" />
              <ui:display-field name="REQUIRED" displayText="Required" />
              <ui:display-field name="LAST_MODIFIED_DATE" displayText="Last Modified" sortable="true" />
              <ui:image-link-field displayText="Impact Analysis" src="/view_details.gif" name="ImpactAnalysis" dataType="Constant">
                <ui:url page="{$pages:ImpactAnalysis}">
                  <ID select="ID/@Value" />
                </ui:url>
              </ui:image-link-field>
              <ui:display-field name="COMMENTS" displayText="Comments" />
            </ui:field-group>
          </ui:table>
        </ui:step>
        <ui:step id="business_rules_tab" displayText="Business Rules">
          <ui:table id="bottomTable" displayText="Business Rules" select="$root/MDS" collapsable="false" scrollable="true" maxRows="$root/MAX_Rows/@Value" displayTextNoRecords="" rowId="ID" postRowIdAs="ID">
            <ui:field-group id="brtableColumns">
              <ui:link-field name="RULE_NAME" displayText="Business Rule">
                <ui:url page="{$pages:BusinessRuleDetails}">
                  <ID select="RULE_ID/@Value" />
                </ui:url>
              </ui:link-field>
              <ui:display-field name="DATA_STEWARD" displayText="Data Steward" />
              <ui:display-field name="CATEGORY" displayText="Category" />
              <ui:display-field name="TOUCH_DATE" displayText="Last Modified" />
              <ui:display-field name="RULE_TYPE" displayText="Type" />
              <ui:display-field name="DESCRIPTION" displayText="Comments" />
            </ui:field-group>
          </ui:table>
        </ui:step>
      </ui:container>
    </ui:step>
  </ui:container>
  <ui:script>function scrollHelper()
		{
      var totalAvailWidth = document.body.offsetWidth - 25; //scrollbars, frame border and padding width subtracted from the total allowed width
 		  var totalAvailHeight = document.body.offsetHeight - 90; //scrollbars, header, frame border and padding height is subtracted
      i2uiResizeScrollableContainer( 'header', 0.5 * totalAvailHeight, null, totalAvailWidth, true, 'yes');
			var searchContHt = getContainerHeight('header');
      i2uiResizeScrollableArea( 'bottomTable', totalAvailHeight - searchContHt - 90, totalAvailWidth - 21, null, 21,null,null,50);
		}</ui:script>
</ui:page-group>

