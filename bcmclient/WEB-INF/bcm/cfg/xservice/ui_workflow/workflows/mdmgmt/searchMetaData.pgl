<ui:page-group xmlns:ui="http://www.i2.com/ui" name="studio.templates.simple_entry" source="studio.controller:load">
  <ui:container id="container" collapsable="false">
    <ui:help displayPage="{$pages:metadataMngmt}" />
    <ui:step id="top_container" displayText="Search Metadata" select="$root">
      <ui:search displayText="Search" exportSearch="false" saveSearch="false">
        <ui:field-group columns="2" id="fieldGroups">
          <ui:field-group id="leftFields">
            <ui:entry-field displayText="Search String" name="SEARCH_STRING" required="true" />
            <ui:checkbox displayText="Exact Match" name="EXACT_MATCH" checkedValue="Yes" />
            <ui:checkbox displayText="Case Sensitive" name="CASE_SENSITIVE" checkedValue="Yes" />
            <!--
              <ui:entry-field displayText="No. of Result" name="NO_OF_RESULT"/>
              <ui:date-range displayText="Last Modified" name="LAST_MODIFIED_DATE" fromDate="{FROM_LAST_MODIFIED_DATE/@Value}" toDate="{TO_LAST_MODIFIED_DATE/@Value}" dataType="Date"/>
							-->
          </ui:field-group>
          <ui:field-group id="RightFields">
            <ui:checkbox displayText="Data Package" name="INCLUDE_DATA_PKG" checkedValue="Yes" />
            <ui:checkbox displayText="Data Group" name="INCLUDE_DATA_GRP" checkedValue="Yes" />
            <ui:checkbox displayText="Data Element" name="INCLUDE_DATA_ELEM" checkedValue="Yes" />
            <ui:checkbox displayText="Business Rules" name="INCLUDE_BUSINESS_RULE" checkedValue="Yes" />
            <!--
              <ui:checkbox displayText="Stewards" name="STEWARDS" checkedValue="Yes"/>
							-->
          </ui:field-group>
        </ui:field-group>
        <!--
          <ui:buttons id="searchButtons">
            <ui:button displayText="Search" id="SEARCH" name="SEARCH" />
          </ui:buttons>
          -->
      </ui:search>
      <ui:table id="bottomTable" displayText="Metadata Search Results" select="$root/MDS" collapsable="false" scrollable="true" maxRows="$root/MAX_Rows/@Value" displayTextNoRecords="" rowId="ID" postRowIdAs="ID">
        <ui:help id="bottomTableHelp" />
        <ui:field-group id="tableColumns">
          <ui:display-field name="ENTITY_TYPE" displayText="Entity Type" />
          <!-- dispplay the appropriate link -->
          <ui:choose-field name="ENTITY_NAME" displayText="Entity Name" filter="false" sortable="true">
            <ui:when test="ENTITY_TYPE_CODE/@Value='DATA_PKG'">
              <ui:link-field name="ENTITY_NAME" displayText="Entity Name">
                <ui:url page="{$pages:DataPkgDetails}">
                  <DATA_PKG select="ENTITY_NAME/@Value" />
                  <DATA_STEWARD select="DATA_STEWARD/@Value" />
                </ui:url>
              </ui:link-field>
            </ui:when>
            <ui:when test="ENTITY_TYPE_CODE/@Value='DATA_GRP'">
              <ui:link-field name="ENTITY_NAME" displayText="Entity Name">
                <ui:url page="{$pages:DataGrpDetails}">
                  <DATA_GRP select="ENTITY_NAME/@Value" />
                  <DATA_PKG select="DATA_PKG/@Value" />
                </ui:url>
              </ui:link-field>
            </ui:when>
            <ui:when test="ENTITY_TYPE_CODE/@Value='BUSINESS_RULE'">
              <ui:link-field name="ENTITY_NAME" displayText="Entity Name">
                <ui:url page="{$pages:BusinessRuleDetails}">
                  <ID select="RULE_ID/@Value" />
                </ui:url>
              </ui:link-field>
            </ui:when>
            <ui:otherwise>
              <ui:display-field name="ENTITY_NAME" displayText="Entity Name" sortable="true" />
            </ui:otherwise>
          </ui:choose-field>
          <ui:display-field name="DATA_STEWARD" displayText="Data Steward" />
          <ui:link-field name="DATA_PKG" displayText="Data Package" sortable="true">
            <ui:url page="{$pages:DataPkgDetails}">
              <DATA_PKG select="DATA_PKG/@Value" />
              <DATA_STEWARD select="DATA_STEWARD/@Value" />
            </ui:url>
          </ui:link-field>
          <ui:link-field name="DATA_GRP" displayText="Data Group" sortable="true">
            <ui:url page="{$pages:DataGrpDetails}">
              <DATA_GRP select="DATA_GRP/@Value" />
              <DATA_PKG select="DATA_PKG/@Value" />
            </ui:url>
          </ui:link-field>
          <ui:display-field name="ENTITY_GROUP" displayText="Entity Group" />
        </ui:field-group>
      </ui:table>
    </ui:step>
  </ui:container>
  <ui:script>
  function scrollHelper()
  {
      var totalAvailWidth = document.body.offsetWidth - 25; //scrollbars, frame border and padding width subtracted from the total allowed width
     var totalAvailHeight = document.body.offsetHeight - 120; //scrollbars, header, frame border and padding height is subtracted
   i2uiResizeScrollableContainer( 'search',0.5* totalAvailHeight, null, totalAvailWidth, true, 'yes');
   var searchContHt = getContainerHeight('search');
      i2uiResizeScrollableArea( 'bottomTable', totalAvailHeight - searchContHt - 80, totalAvailWidth - 21, null, 21);
  }
		function on_search_button()
		{
			onSearch();
		}
		function on_save_search_button()
		{
			onSaveSearch();
		}
		function on_save_report()
		{
    prevAction = document.form.action;
    document.form.target = "i2ui_shell_bottom";
    document.form.action = omxContextPath + '/buy/export_to_excel/shipments/load.x2c';
    document.form.submit();
    document.form.action = prevAction;
    document.form.target = "appFrame";
		}
 </ui:script>
</ui:page-group>

