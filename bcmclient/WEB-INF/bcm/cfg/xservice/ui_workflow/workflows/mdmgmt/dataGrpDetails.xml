          <TO_DOCVAR AssignToVar="pglFormInput">
            <ROOT>
            </ROOT>
          </TO_DOCVAR>
          <REQUEST ServiceName="BPE_META" Name="getEntityDetails" AssignToVar="response">
            <DATA_PKG Value="{$root/DATA_PKG/@Value}"/>
            <ENTITY_NAME Value="{$root/DATA_GRP/@Value}"/>
            <ENTITY_TYPE Value="DATA_GRP"/>
          </REQUEST>
          <APPEND_CHILDREN DocVar="pglFormInput" FromDocVar="response"/>
          <IF_TEST Test="$thisParam/details_STEP_ID/@Value != 'business_rules_tab'">
            <THEN>
              <!-- code for data elements -->
              <SET Var="sortBy" FromValue="{ifElse($thisParam/SORT_BY/@Value = null or $thisParam/SORT_BY/@Value = 'ID', 'ENTITY_NAME', $thisParam/SORT_BY/@Value)}"/>
              <SET Var="sortOrder" FromValue="{ifElse($thisParam/SORT_ORDER/@Value = null, 'Ascending', $thisParam/SORT_ORDER/@Value)}"/>
              <TO_DOCVAR AssignToVar="orderBy">
                <ORDER_BY>
                </ORDER_BY>
              </TO_DOCVAR>
              <TO_DOCVAR AssignToVar="orderProp">
                <TEMP_PROP Sort="{$sortOrder}"/>
              </TO_DOCVAR>
              <SET_NAME Value="{$orderProp}" FromValue="{$sortBy}"/>
              <ADD_CHILD DocVar="orderBy" ChildDocVar="orderProp"/>
              <REQUEST ServiceName="BPE_META" Name="getMetaDataSearchResult" AssignToVar="response" UserId="{$userId}" ReturnRowCount="yes" MaxRows="{$maxRows}" StartAtRow="{$paginateStart}">
                <FILTER Name="DATA_PKG">
                  <DATA_PKG Value="{$root/DATA_PKG/@Value}" MatchBy="EQUAL"/>
                </FILTER>
                <FILTER Name="DATA_GRP">
                  <DATA_GRP Value="{$root/DATA_GRP/@Value}" MatchBy="EQUAL"/>
                </FILTER>
                <FILTER Name="ENTITY_TYPE">
                  <ENTITY_TYPE Value="DATA_ELMNT" MatchBy="EQUAL"/>
                </FILTER>
                <TO_XML Select="$orderBy"/>
              </REQUEST>
              <APPEND_CHILDREN DocVar="pglFormInput" FromDocVar="response"/>
            </THEN>
            <ELSE>
              <!-- code for business rules -->
              <GET_DOCUMENT ServiceName="BPE_META" Name="DATA_RULE_TEMPLATE" AssignToVar="response" UserId="{$userId}" ReturnRowCount="yes" MaxRows="{$maxRows}" StartAtRow="{$paginateStart}">
                <SELECT>
                  <RULE_ID/>
                  <RULE_NAME/>
                  <CATEGORY/>
                  <TOUCH_DATE/>
                  <RULE_TYPE/>
                  <DESCRIPTION/>
                </SELECT>
                <SERVICE Value="{$root/DATA_PKG/@Value}"/>
                <DOCUMENT Value="{$root/DATA_GRP/@Value}"/>
                <ORDER_BY>
                  <RULE_NAME Sort="Ascending"/>
                </ORDER_BY>
              </GET_DOCUMENT>
              <APPEND_TO_XML Select="$pglFormInput">
                <MDS TotalRowCount="{$response/@TotalRowCount}">
                  <TO_XML SelectList="$response/*"/>
                </MDS>
              </APPEND_TO_XML>
            </ELSE>
          </IF_TEST>
          <SET DocVar="pglFormInput" Property="DATA_PKG" FromValue="{$root/DATA_PKG/@Value}"/>
          <SET DocVar="pglFormInput" Property="DATA_GRP" FromValue="{$root/DATA_GRP/@Value}"/>
        </action>
      </pre_actions>
      <if_cond Value="true()">
        <next_nodes>
          <next_node Name="done" Description=""/>
        </next_nodes>
      </if_cond>
