<ui:page-group xmlns:ui="http://www.i2.com/ui" name="studio.templates.simple_entry" source="studio.controller:load">
  <ui:container collapsable="false">
    <ui:help displayPage="{$pages:dataPckgDetails}" />
    <ui:step id="header" displayText="Data Package Details" select="$root">
      <ui:field-group columns="2" id="fieldGroups">
        <ui:field-group id="LeftFields">
          <ui:display-field displayText="Name" name="DATA_PKG" />
        </ui:field-group>
        <ui:field-group id="RightFields">
          <ui:display-field displayText="Data Steward" name="DATA_STEWARD" />
        </ui:field-group>
      </ui:field-group>
      <ui:table id="detailstable" displayText="Data Group Details" select="$root/MDS" collapsable="false" scrollable="true" maxRows="$root/MAX_Rows/@Value" displayTextNoRecords="" rowId="ID" postRowIdAs="ID">
        <ui:help id="bottomTableHelp" />
        <ui:field-group id="tableColumns">
          <ui:link-field name="ENTITY_NAME" displayText="Data Group" id="DataPackage" sortable="true">
            <ui:url page="{$pages:DataGrpDetails}">
              <DATA_GRP select="ENTITY_NAME/@Value" />
              <DATA_PKG select="DATA_PKG/@Value" />
            </ui:url>
          </ui:link-field>
          <ui:display-field name="LAST_MODIFIED_DATE" displayText="Last Modified" sortable="true" />
          <ui:display-field name="DATA_STEWARD" displayText="Data Steward" sortable="true" />
          <ui:display-field name="COMMENTS" displayText="Comments" />
        </ui:field-group>
      </ui:table>
    </ui:step>
  </ui:container>
</ui:page-group>

