<ui:page-group xmlns:ui="http://www.i2.com/ui" name="Profile Details">
<ui:container id="top_container" scrollable="true">
  <ui:step id="top_step" scrollable="true" displayText="Data Profile Details">
    <ui:container id="hcontainer" collapsable="true">
      <ui:step id="hstep" displayText="Data Profile : Entity Details" select="$root">
        <ui:field-group columns="2" showDivider="true" select="$root/DATA_PROFILE">
          <ui:field-group>
            <ui:hidden-field displayText="" name="ID"/>
            <ui:display-field displayText="Service Name" name="SERVICE_NAME"/>
            <ui:display-field displayText="Template Name" name="TEMPLATE_NAME"/>
            <ui:display-field displayText="Total Records" name="TOTAL_RECORDS"/>
          </ui:field-group>
          <ui:field-group>
            <ui:display-field displayText="Entity" name="ENTITY_NAME"/>
            <ui:display-field displayText="Profile Date" name="CREATTION_DATE"/>
            <ui:display-field displayText="Size" name="TOTAL_SIZE"/>
          </ui:field-group>
        </ui:field-group>
        <ui:buttons id="profileButtons">
          <ui:button displayText="Back" validate="false" id="back"/>
          <ui:button displayText="Delete Profile" validate="true" id="delete" onClick="javascript:onDelete();"/>
        </ui:buttons>
      </ui:step>
    </ui:container>
    <ui:container id="acontainer" collapsable="true">
      <ui:step id="astep" displayText="Data Profile : Attribute Details" select="$root" scrollable="true">
        <ui:table id="atable" displayText="" numRows="5" rowSrc="$root/DATA_PROFILE/COLUMN" exportable="true" collapsable="false" maxRows="-1" selectable="None" height="100">
          <ui:field-group id="afieldgroup">
            <ui:choose-field name="FIELD" displayText="Field">
              <ui:when test="./@Name = $root/CHART_DATA/COLUMN/@Name">
                <ui:link-field name="FIELD" id="FIELD" displayText="Field" value="{@Name}" style="{{font:bold}">
                  <ui:url page="view.x2ps">
                    <FIELD select="./@Name"/>
                    <ID select="$root/DATA_PROFILE/ID/@Value"/>
                    <BUTTON_ID select="'change_field'"/>
                  </ui:url>
                </ui:link-field>
              </ui:when>
              <ui:when test="./@Name != $root/CHART_DATA/COLUMN/@Name">
                <ui:link-field name="FIELD" id="FIELD" displayText="Field" value="{@Name}">
                  <ui:url page="view.x2ps">
                    <FIELD select="./@Name"/>
                    <ID select="$root/DATA_PROFILE/ID/@Value"/>
                    <BUTTON_ID select="'change_field'"/>
                  </ui:url>
                </ui:link-field>
              </ui:when>
            </ui:choose-field>
            <ui:display-field displayText="Type" name="DATA_TYPE" value="{DATA_TYPE/@Value}"/>
            <ui:display-field displayText="Primary Key" name="PRIMARY_KEY"/>
            <ui:display-field displayText="Unique Count" name="NUM_DISTINCT"/>
            <ui:display-field displayText="Non-null Count" name="COUNT"/>
            <ui:display-field displayText="Data Availability %" name="DATA_AVAILABILITY"/>
            <ui:choose-field name="STATUS" displayText="Status">
              <ui:when test="STATUS/@Value='LOW'">
                <ui:image-link-field displayText="" src="/green_circle.gif" name="STATUS" dataType="Constant"/>
              </ui:when>
              <ui:when test="STATUS/@Value='MEDIUM'">
                <ui:image-link-field displayText="" src="/yellow_circle.gif" name="STATUS" dataType="Constant"/>
              </ui:when>
              <ui:when test="STATUS/@Value='HIGH'">
                <ui:image-link-field displayText="" src="/red_circle.gif" name="STATUS" dataType="Constant"/>
              </ui:when>
            </ui:choose-field>
          </ui:field-group>
        </ui:table>    
      </ui:step>
    </ui:container>
    <ui:container id="ccontainer" collapsable="true" selectedStep="{$root/SELECTED_STEP/@Value}">
      <ui:step id="vstep" displayText="Data Value Analysis" select="$root" scrollable="true">
        <ui:chart width="900" height="235" xLabelsWidth="400" yAxisNumTicks="5" displayText="" select="$root/CHART_DATA" rowSrc="COLUMN" allowNegatives="true">
          <ui:chart-field displayText="" name="FIELD" value="{./@Name}"/>
          <ui:chart-field displayText="Min" name="MIN" color="#FFFF00" />
          <ui:chart-field displayText="Max" name="MAX" color="#EE82EE"/>
          <ui:chart-field displayText="Average" name="AVG" color="#66FFFF"/>
          <ui:chart-field displayText="Most Common" name="MOST_COMMON" color="#DC143C"/>
        </ui:chart>      
      </ui:step>
      <ui:step id="lstep" displayText="Data Length Analysis" select="$root" scrollable="true">
        <ui:chart width="900" height="235" xLabelsWidth="400" yAxisNumTicks="5" displayText="" select="$root/CHART_DATA" rowSrc="COLUMN" allowNegatives="true">
          <ui:chart-field displayText="" name="FIELD" value="{./@Name}"/>
          <ui:chart-field displayText="Min Length" name="MIN_LENGTH" color="#FFFF00"/>
          <ui:chart-field displayText="Max Length" name="MAX_LENGTH" color="#EE82EE"/>
          <ui:chart-field displayText="Average Length" name="AVG_LENGTH" color="#66FFFF"/>
        </ui:chart>      
      </ui:step>
    </ui:container>
  </ui:step>  
</ui:container>  
  <ui:script>
    function table_export(table, bool1, bool2)
    {
      prevAction = document.form.action;
      document.form.target = "i2ui_shell_bottom";
      document.form.action = omxContextPath + '/bcm/dataprofiling/export_profile/load.x2c';
      document.form.submit();
      document.form.action = prevAction;
      document.form.target = "appFrame";
    }
    function onDelete()
    {
     var message = &quot;Are you sure you want to delete this profile?&quot;;
     if(core_confirm(message)==&quot;yes&quot;)
     {
      document.form.BUTTON_ID.value = &quot;delete&quot;;
      document.form.submit();
     }
    }
  </ui:script>
</ui:page-group>
