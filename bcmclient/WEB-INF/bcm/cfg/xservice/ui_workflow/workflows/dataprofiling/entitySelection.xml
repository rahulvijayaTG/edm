    <ui_form2 Name="CollectProfile" Description="Collect Profile" InputVar="{root,xml}" OutputFormVar="pglFormOutput" InputFormVar="pglFormInput" ShowInBreadCrumbs="SHOW" Template="collectProfile.pgl">
      <pre_actions>
        <action>
          <REQUEST Name="getDataProfileTemplates" ServiceName="DATA_PROFILING" AssignToVar="templates"/>
          <TO_DOCVAR AssignToVar="pglFormInput">
            <ROOT>
              <SERVICE_NAME Value="{$service}"/>
              <ENTITY_NAME Value="{$entity}"/>
              <ID Value="{$root/ID/@Value}"/>
              <TEMPLATES>
                <FOR_EACH SelectList="$templates/DATA_PROFILE_TEMPLATE" CurrentElement="template">
                  <APPEND_TO_XML>
                    <OPTION Id="{$template/ID/@Value}" Value="{$template/TEMPLATE_NAME/@Value}"/>
                  </APPEND_TO_XML>
                </FOR_EACH>
              </TEMPLATES>
            </ROOT>
          </TO_DOCVAR>
        </action>
      </pre_actions>
      <post_actions>
        <action>
          <IF_TEST Test="$pglFormOutput/BUTTON_ID/@Value = 'collect'">
            <THEN>
              <REQUEST Name="profileEntity" UserId="{$UserId}" ServiceName="DATA_PROFILING">
                <ENTITY_NAME Value="{$entity}"/>
                <SERVICE_NAME Value="{$service}"/>
                <TEMPLATE_ID Value="{$pglFormOutput/ID/@Value}"/>
                <PROFILE_NAME Value="{$pglFormOutput/PROFILE_NAME/@Value}"/>
              </REQUEST>
              <REMOVE_CHILDREN DocVar="pglFormOutput" ChildName="BUTTON_ID"/>
              <APPEND_TO_XML Select="$pglFormOutput">
                <BUTTON_ID Value="back"/>
              </APPEND_TO_XML>
            </THEN>
          </IF_TEST>
        </action>
      </post_actions>
      <if_cond Value="$userAction ='back'">
        <next_nodes OutputVar="{pglFormOutput,xml}">
          <next_node Name="DisplayEntitySelectionForm" Description=""/>
        </next_nodes>
      </if_cond>
      <else_if_cond Value="$userAction ='collect'">
