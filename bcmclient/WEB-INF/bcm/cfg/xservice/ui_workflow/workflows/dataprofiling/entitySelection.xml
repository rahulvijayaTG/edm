        </next_nodes>
      </else_if_cond>
      <else_if_cond Value="true()">
        <next_nodes OutputVar="{pglFormOutput,xml}"/>
      </else_if_cond>
    </ui_form2>
    <task Name="DeleteProfile" Description="Delete profile" InputVar="{root,xml}">
