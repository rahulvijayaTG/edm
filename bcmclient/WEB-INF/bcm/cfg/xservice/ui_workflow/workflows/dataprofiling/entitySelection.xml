    </ui_form2>
    <ui_form2 Name="ViewDataProfile" Description="Display the template details in read only mode." InputVar="{root,xml}" OutputFormVar="pglFormOutput" InputFormVar="pglFormInput" ShowInBreadCrumbs="SHOW" Template="viewProfile.pgl">
      <pre_actions>
        <action>
          <PRINTLN Value="$root"/>
          <PRINTLN Value="printing Root"/>
          <REQUEST Name="getDataProfile" ServiceName="DATA_PROFILING" AssignToVar="dpDetails">
            <ID Value="{$root/ID/@Value}"/>
          </REQUEST>
          <IF_TEST Test="$root/FIELD/@Value != null">
            <THEN>
              <SET Var="selectedFieldForChartDisplay" FromValue="{$dpDetails/DATA_PROFILE/COLUMN[@Name=$root/FIELD/@Value]}"/>
            </THEN>
            <ELSE>
              <SET Var="selectedFieldForChartDisplay" FromValue="{$dpDetails/DATA_PROFILE/COLUMN[1]}"/>
            </ELSE>
          </IF_TEST>
          <FOR_EACH SelectList="$dpDetails/DATA_PROFILE/COLUMN" CurrentElement="column">
            <SET Var="da" FromValue="{float($column/DATA_AVAILABILITY/@Value)}"/>
            <IF_TEST Test="$da >= 0 and $da &lt; 40">
              <THEN>
                <APPEND_TO_XML Select="$column">
                  <STATUS Value="HIGH"/>
                </APPEND_TO_XML>
              </THEN>
            </IF_TEST>
            <IF_TEST Test="$da >= 40 and $da &lt; 80">
              <THEN>
                <APPEND_TO_XML Select="$column">
                  <STATUS Value="MED"/>
                </APPEND_TO_XML>
              </THEN>
            </IF_TEST>
            <IF_TEST Test="$da >= 80">
              <THEN>
                <APPEND_TO_XML Select="$column">
                  <STATUS Value="LOW"/>
                </APPEND_TO_XML>
              </THEN>
            </IF_TEST>
          </FOR_EACH>
          <TO_DOCVAR AssignToVar="pglFormInput">
            <ROOT>
              <SELECTED_STEP Value="{$root/container_SELECTED_STEP/@Value}"/>
              <TO_XML SelectList="$dpDetails/*"/>
              <CHART_DATA>
                <TO_XML Select="$selectedFieldForChartDisplay"/>
              </CHART_DATA>
            </ROOT>
          </TO_DOCVAR>
        </action>
      </pre_actions>
      <post_actions>
        <action>
        </action>
      </post_actions>
      <if_cond Value="$userAction ='back'">
        <next_nodes OutputVar="{pglFormOutput,xml}">
          <next_node Name="DisplayEntitySelectionForm" Description=""/>
        </next_nodes>
      </if_cond>
      <else_if_cond Value="$userAction ='delete'">
        <next_nodes OutputVar="{pglFormOutput,xml}">
          <next_node Name="DeleteProfile" Description=""/>
        </next_nodes>
      </else_if_cond>
      <else_if_cond Value="$userAction='change_field'">
