    <ui_form2 Name="DisplayEntitySelectionForm" Description="Display the entity selection form based on service name selected." InputVar="{root,xml}" OutputFormVar="pglFormOutput" InputFormVar="pglFormInput" ShowInBreadCrumbs="SHOW" Template="entitySelection.pgl">
      <pre_actions>
        <action>
          <IF_TEST Test="$root/BUTTON_ID/@Value = 'search_button'">
            <THEN>
              <IF_TEST Test="$thisParam/BUTTON_ID/@Value = 'SYS_RELOAD'">
                <THEN>
                  <SET Var="paginateStart" FromValue="{ifElse($thisParam/START_COUNT/@Value = null, '0', $thisParam/START_COUNT/@Value)}"/>
                </THEN>
                <ELSE>
                  <SET Var="paginateStart" FromValue="0"/>
                  <SET DocVar="thisParam" Property="START_COUNT" FromValue="0"/>
                </ELSE>
              </IF_TEST>
              <SET Var="maxRows" FromValue="{ifElse($root/MAX_ROWS/@Value = null, '10', $root/MAX_ROWS/@Value)}"/>
              <SET Var="service" FromValue="{$root/SERVICE/@Value}"/>
              <SET Var="entity" FromValue="{$root/DOCUMENT/@Value}"/>
              <REQUEST ServiceName="DATA_PROFILING" Name="getDataProfiles" AssignToVar="dps" UserId="{$userId}" ReturnRowCount="yes" MaxRows="{$maxRows}" StartAtRow="{$paginateStart}">
                <SERVICE_NAME Value="{$root/SERVICE/@Value}"/>
                <ENTITY_NAME Value="{$root/DOCUMENT/@Value}"/>
              </REQUEST>
              <TO_DOCVAR AssignToVar="pglFormInput">
                <ROOT>
                  <SERVICE Value="{$root/SERVICE/@Value}"/>
                  <DOCUMENT Value="{$root/DOCUMENT/@Value}"/>
                  <SERVICES>
                    <TO_XML SelectList="$services/*"/>
                  </SERVICES>
                  <DOCUMENTS>
                    <TO_XML SelectList="$entityNames/*"/>
                  </DOCUMENTS>
                  <TO_XML Select="$dps/*"/>
                </ROOT>
              </TO_DOCVAR>
            </THEN>
            <ELSE>
              <IF_TEST Test="$root/BUTTON_ID/@Value = 'back'">
                <THEN>
                  <!-- To solve some more pagination issue -->
                  <IF_TEST Test="$thisParam/BUTTON_ID/@Value = 'SYS_RELOAD'">
                    <THEN>
                      <SET Var="paginateStart" FromValue="{ifElse($thisParam/START_COUNT/@Value = null, '0', $thisParam/START_COUNT/@Value)}"/>
                    </THEN>
                    <ELSE>
                      <SET Var="paginateStart" FromValue="0"/>
                      <SET DocVar="thisParam" Property="START_COUNT" FromValue="0"/>
                    </ELSE>
                  </IF_TEST>
                  <!-- To solve some more pagination issue -->
                  <REQUEST ServiceName="DATA_PROFILING" Name="getDataProfiles" AssignToVar="dps" UserId="{$userId}" ReturnRowCount="yes" MaxRows="{$maxRows}" StartAtRow="{$paginateStart}">
                    <SERVICE_NAME Value="{$service}"/>
                    <ENTITY_NAME Value="{$entity}"/>
                  </REQUEST>
                  <TO_DOCVAR AssignToVar="pglFormInput">
                    <ROOT>
                      <TO_XML Select="$dps/*"/>
                      <SERVICE Value="{$service}"/>
                      <DOCUMENT Value="{$entity}"/>
                      <SERVICES>
                        <TO_XML SelectList="$services/*"/>
                      </SERVICES>
                      <DOCUMENTS>
                        <TO_XML SelectList="$entityNames/*"/>
                      </DOCUMENTS>
                    </ROOT>
                  </TO_DOCVAR>
                </THEN>
                <ELSE>
                  <IF_TEST Test="$root/SERVICE/@Value = null">
                    <THEN>
                      <REQUEST ServiceName="BPE_META" Name="getServiceNames" AssignToVar="services"/>
                      <REQUEST Name="getDocumentNames" ServiceName="BPE_META" AssignToVar="entityNames">
                        <SERVICE Value="{$services/SERVICE/@Value}"/>
                      </REQUEST>
                    </THEN>
                  </IF_TEST>
                  <IF_TEST Test="$root/SERVICE/@Value != null">
                    <THEN>
                      <REQUEST ServiceName="BPE_META" Name="getServiceNames" AssignToVar="services"/>
                      <REQUEST Name="getDocumentNames" ServiceName="BPE_META" AssignToVar="entityNames">
                        <SERVICE Value="{$root/SERVICE/@Value}"/>
                      </REQUEST>
                    </THEN>
                  </IF_TEST>
                  <TO_DOCVAR AssignToVar="pglFormInput">
                    <ROOT>
                      <SERVICE Value="{$root/SERVICE/@Value}"/>
                      <SERVICES>
                        <TO_XML SelectList="$services/*"/>
                      </SERVICES>
                      <DOCUMENTS>
                        <TO_XML SelectList="$entityNames/*"/>
                      </DOCUMENTS>
                    </ROOT>
                  </TO_DOCVAR>
                </ELSE>
              </IF_TEST>
            </ELSE>
          </IF_TEST>
          <PRINTLN Value="#####INXML######"/>
          <PRINTLN DocVar="pglFormInput"/>
        </action>
      </pre_actions>
      <post_actions>
        <action>
          <IF_TEST Test="$pglFormOutput/BUTTON_ID/@Value='collect'">
            <THEN>
              <SET Var="service" FromValue="{$pglFormOutput/SERVICE/@Value}"/>
              <SET Var="entity" FromValue="{$pglFormOutput/DOCUMENT/@Value}"/>
              <REQUEST Name="getTemplateIdForDataProfile" ServiceName="DATA_PROFILING" AssignToVar="template">
                <ID Value="{$pglFormOutput/ID/@Value}"/>
              </REQUEST>
              <REMOVE_CHILDREN DocVar="pglFormOutput" ChildName="ID"/>
              <APPEND_TO_XML Select="$pglFormOutput">
                <ID Value="{$template/DATA_PROFILE/TEMPLATE_ID/@Value}"/>
              </APPEND_TO_XML>
            </THEN>
          </IF_TEST>
        </action>
      </post_actions>
      <if_cond Value="$userAction= 'search_button'">
        <next_nodes OutputVar="{pglFormOutput,xml}">
          <next_node Name="DisplayEntitySelectionForm" Description=""/>
        </next_nodes>
      </if_cond>
      <else_if_cond Value="$userAction='change_service'">
        <next_nodes OutputVar="{pglFormOutput,xml}">
          <next_node Name="DisplayEntitySelectionForm" Description=""/>
        </next_nodes>
      </else_if_cond>
      <else_if_cond Value="$userAction='template_details'">
        <next_nodes OutputVar="{pglFormOutput,xml}">
          <next_node Name="DisplayTemplate" Description=""/>
        </next_nodes>
      </else_if_cond>
      <else_if_cond Value="$userAction='collect'">
        <next_nodes OutputVar="{pglFormOutput,xml}">
          <next_node Name="CollectProfile" Description=""/>
        </next_nodes>
      </else_if_cond>
      <else_if_cond Value="$userAction='view'">
        <next_nodes OutputVar="{pglFormOutput,xml}">
          <next_node Name="ViewDataProfile" Description=""/>
        </next_nodes>
      </else_if_cond>
      <else_if_cond Value="true()">
        <next_nodes OutputVar="{pglFormOutput,xml}">
          <next_node Name="done6" Description=""/>
        </next_nodes>
      </else_if_cond>
    </ui_form2>
    <ui_form2 Name="DisplayTemplate" Description="Display the template details in read only mode." InputVar="{root,xml}" OutputFormVar="pglFormOutput" InputFormVar="pglFormInput" ShowInBreadCrumbs="SHOW" Template="viewTemplate.pgl">
      <pre_actions>
        <action>
          <REQUEST Name="getDataProfileTemplateForUI" ServiceName="DATA_PROFILING" AssignToVar="templateDetails">
            <ID Value="{$root/ID/@Value}"/>
          </REQUEST>
          <TO_DOCVAR AssignToVar="pglFormInput">
            <ROOT>
              <TO_XML Select="$templateDetails/*"/>
            </ROOT>
          </TO_DOCVAR>
        </action>
      </pre_actions>
      <post_actions>
        <action>
        </action>
      </post_actions>
      <if_cond Value="$userAction ='back'">
