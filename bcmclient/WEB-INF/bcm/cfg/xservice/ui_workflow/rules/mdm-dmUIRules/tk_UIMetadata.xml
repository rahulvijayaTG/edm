<DOCUMENTS>

		<DEFINE_METHOD Access="public" Name="GetAllDimensionsForMapSet">
		<RULE>
				<ACTION>
							<REQUEST ServiceName="{$ServiceName}" AssignToVar="allDimensions" Name="GetAllDimensions" />
		          <TO_DOCVAR AssignToVar="dimensions">
		            <DIMENSIONS/>
		          </TO_DOCVAR>
		          <TO_DOCVAR AssignToVar="optionSrc">
		            <OPTION Id="" Name=""/>
		          </TO_DOCVAR>
				  <IF_TEST Test="(count($thisParam/WANT_ANY) = 0) or ($thisParam/WANT_ANY/@Value = 'true') ">
					<THEN>
							<TO_DOCVAR AssignToVar="any">
										<OPTION Id="ANY" Name="0" />
							</TO_DOCVAR>
					        <ADD_CHILDREN DocVar="dimensions" FromDocVar="any" />
				   </THEN>
				</IF_TEST>
		          <FOR_EACH CurrentElement="dimData" SelectList="$allDimensions/*">
		            <CLONE_XML AssignToVar="tOption" DocVar="optionSrc"/>
		            <SET DocVar="tOption" Attribute="Id" FromValue="{$dimData/Name/@Value}"/>
		            <SET DocVar="tOption" Attribute="Name" FromValue="{$dimData/Id/@Value}"/>
		            <ADD_CHILDREN DocVar="dimensions" FromDocVar="tOption"/>
		          </FOR_EACH>
							
		          <ADD_CHILDREN DocVar="thisReturn" FromDocVar="dimensions" />
				</ACTION>	
		</RULE>
		</DEFINE_METHOD>	
	
		<DEFINE_METHOD Access="public" Name="GetSearchParameters">
		<RULE>
			<ACTION>
						
						<SET Var="caller" FromSelect="$thisParam/CALLEE/@Value" />
						<TO_DOCVAR AssignToVar="SearchParameters">
									<SEARCH-BY />
						</TO_DOCVAR>
						<TO_DOCVAR AssignToVar="optionSrc">
									<OPTION Id="" Name="" />
						</TO_DOCVAR>
				
						<IF_TEST Test="$caller = 'MAPSET'">
						<THEN>
											<CLONE_XML AssignToVar="tOption" DocVar="optionSrc" />
											<SET Attribute="Id" DocVar="tOption" FromValue="NAME" />
											<SET Attribute="Name" DocVar="tOption" FromValue="1" />
											<ADD_CHILDREN DocVar="SearchParameters" FromDocVar="tOption" />
						
											<CLONE_XML AssignToVar="tOption" DocVar="optionSrc" />
											<SET Attribute="Id" DocVar="tOption" FromValue="DESCRIPTION" />
											<SET Attribute="Name" DocVar="tOption" FromValue="2" />
											<ADD_CHILDREN DocVar="SearchParameters" FromDocVar="tOption" />

						</THEN>
						</IF_TEST>
				
						<ADD_CHILDREN DocVar="thisReturn" FromDocVar="SearchParameters" />
			</ACTION>
		</RULE>
		</DEFINE_METHOD>
	
		<DEFINE_METHOD Access="public" Name="GetSearchQualifier">
		<RULE>
			<ACTION>
						
						<SET Var="caller" FromSelect="$thisParam/CALLEE/@Value" />
						<TO_DOCVAR AssignToVar="SearchParameters">
									<SEARCH-CONSTRAINTS />
						</TO_DOCVAR>
						<TO_DOCVAR AssignToVar="optionSrc">
									<OPTION Id="" Name="" />
						</TO_DOCVAR>
				
						<IF_TEST Test="$caller = 'MAPSET'">
						<THEN>
											<CLONE_XML AssignToVar="tOption" DocVar="optionSrc" />
											<SET Attribute="Id" DocVar="tOption" FromValue="CONTAINS" />
											<SET Attribute="Name" DocVar="tOption" FromValue="1" />
											<ADD_CHILDREN DocVar="SearchParameters" FromDocVar="tOption" />
						
						</THEN>
						</IF_TEST>
				
						<ADD_CHILDREN DocVar="thisReturn" FromDocVar="SearchParameters" />
			</ACTION>
		</RULE>
		</DEFINE_METHOD>
	
		<DEFINE_METHOD Access="private" Name="GetSearchBasisFields">
		<RULE>
				<ACTION>
							<IF_TEST Test="$thisParam/CALLEE/@Value = 'MAPSET'">
							<THEN>
													<IF_TEST Test="upperCase(trim($thisParam/SEARCH_BY/@Value)) = 'NAME'">
													<THEN>
																<TO_DOCVAR AssignToVar="searchFields">
																			<name Value="{$thisParam/SEARCH/@Value}" MatchBy="{$thisParam/SEARCH_CONSTRAINT/@Value}" />
																</TO_DOCVAR>
																<ADD_CHILDREN DocVar="thisReturn" FromDocVar="searchFields" />
														</THEN>
													</IF_TEST>
													<IF_TEST Test="upperCase(trim($thisParam/SEARCH_BY/@Value)) = 'DESCRIPTION'">
													<THEN>
																<TO_DOCVAR AssignToVar="searchFields">
																			<description Value="{$thisParam/SEARCH/@Value}" MatchBy="{$thisParam/SEARCH_CONSTRAINT/@Value}" />
																</TO_DOCVAR>
																<ADD_CHILDREN DocVar="thisReturn" FromDocVar="searchFields" />
														</THEN>
													</IF_TEST>
							</THEN>
							</IF_TEST>
							<IF_TEST Test="$thisParam/CALLEE/@Value = 'MEMBER'">
							<THEN>
													<IF_TEST Test="upperCase(trim($thisParam/SEARCH_BY/@Value)) = 'NAME'">
													<THEN>
																<TO_DOCVAR AssignToVar="searchFields">
																			<Name Value="{$thisParam/SEARCH/@Value}" MatchBy="{$thisParam/SEARCH_CONSTRAINT/@Value}" />
																</TO_DOCVAR>
																<ADD_CHILDREN DocVar="thisReturn" FromDocVar="searchFields" />
														</THEN>
													</IF_TEST>
													<IF_TEST Test="upperCase(trim($thisParam/SEARCH_BY/@Value)) = 'DESCRIPTION'">
													<THEN>
																<TO_DOCVAR AssignToVar="searchFields">
																			<Description Value="{$thisParam/SEARCH/@Value}" MatchBy="{$thisParam/SEARCH_CONSTRAINT/@Value}" />
																</TO_DOCVAR>
																<ADD_CHILDREN DocVar="thisReturn" FromDocVar="searchFields" />
														</THEN>
													</IF_TEST>
							</THEN>
							</IF_TEST>
				</ACTION>
		</RULE>	
		</DEFINE_METHOD>
	
		<DEFINE_METHOD Access="public" Name="GetLevelsForUI">
		<RULE>
				<ACTION>
							<REQUEST ServiceName="{$ServiceName}" AssignToVar="allLevels" Name="GetLevel">
										<DIMENSION Value="{$thisParam/DIMENSION/@Value}"  />
							</REQUEST>
				
		          <TO_DOCVAR AssignToVar="levels">
		            <LEVELS/>
		          </TO_DOCVAR>
		          <TO_DOCVAR AssignToVar="optionSrc">
		            <OPTION Id="" Name=""/>
		          </TO_DOCVAR>
		          <FOR_EACH CurrentElement="dimData" SelectList="$allLevels/DIMENSION/LEVEL">
		            <CLONE_XML AssignToVar="tOption" DocVar="optionSrc"/>
		            <SET DocVar="tOption" Attribute="Id" FromValue="{$dimData/NAME/@Value}"/>
		            <SET DocVar="tOption" Attribute="Name" FromValue="{$dimData/ID/@Value}"/>
		            <ADD_CHILDREN DocVar="levels" FromDocVar="tOption"/>
		          </FOR_EACH>

						  <ADD_CHILDREN DocVar="thisReturn" FromDocVar="levels" />
				</ACTION>	
		</RULE>
		</DEFINE_METHOD>	

		<!-- @ Fetch the members at the given level and the given dimension
					@ Params : DIMENSION, the name of the dimension where the fetch has to be made.
					@ Params : LEVEL, the name of the level where the fetch has to be made.
					@ Params : MAX_ROWS, the max rows ro fetch
					@ Params : START_AT_ROW, the max rows ro fetch
		 -->	
		<DEFINE_METHOD Access="public" Name="GetMembersForUI">
		<RULE>
				<ACTION>
									<SET Var="DIMENSION" FromValue="{$thisParam/DIMENSION/@Value}" />
									<SET Var="LEVEL" FromValue="{$thisParam/LEVEL/@Value}" />
									<REQUEST Name="GetMembers" AssignToVar="Members" ReturnRowCount="yes">
											<DIMENSION Value="{$DIMENSION}" />
											<LEVEL Value="{$LEVEL}" />
											<MAX_ROWS Value="{$thisParam/MAX_ROWS/@Value}" />
											<START_AT_ROW Value="{$thisParam/START_AT_ROW/@Value}" />
					            <TO_XML SelectList="$thisParam/CONDITION" />
								<startcount Value="{$thisParam/startcount/@Value}"/>
									</REQUEST>
												
									<TO_DOCVAR AssignToVar="listOfMembers">
												<MEMBERS TotalRowCount="{$Members/@TotalRowCount}">
															<TOTAL_COUNT Value="{$Members/@TotalRowCount}" />
															<FOR_EACH CurrentElement="currentMember" SelectList="$Members/*">
																			<TO_DOCVAR AssignToVar="member">
																								<MEMBER>
																											<ID Value="{$currentMember/Id/@Value}" />
																											<NAME Value="{$currentMember/Name/@Value}" />
																											<DESCRIPTION Value="{$currentMember/Description/@Value}" />
																								</MEMBER>
																			</TO_DOCVAR>
																			<TO_XML DocVar="member" />
															</FOR_EACH>
												</MEMBERS>
									</TO_DOCVAR>
									<SET DocVar="thisReturn" FromDocVar="listOfMembers" />
				</ACTION>	
		</RULE>
		</DEFINE_METHOD>		
	
		<DEFINE_METHOD Access="public" Name="GetMembersForUITable">
		<RULE>
				<ACTION>
									<TO_DOCVAR AssignToVar="condition">
										<CONDITION />
									</TO_DOCVAR>
									<IF_TEST Test="strlen(trim($thisParam/SEARCH_FILTER_VALUE/@Value)) != 0">
									<THEN>
														<REQUEST AssignToVar="SearchBasis"  Name="GetSearchBasisFields">
																		<CALLEE Value="MEMBER" />
																		<SEARCH Value="{$thisParam/SEARCH_FILTER_VALUE/@Value}" />
																		<SEARCH_BY Value="{$thisParam/SEARCH_BY/@Value}" />
																		<SEARCH_CONSTRAINT Value="{$thisParam/SEARCH_CONSTRAINT/@Value}" />
														</REQUEST>														
														<ADD_CHILDREN DocVar="condition" FromSelectList="$SearchBasis/*" />
										</THEN>
									</IF_TEST>	
									<!-- Collate the parameters needed to be passed -->
									<TO_DOCVAR AssignToVar="paramter2BePassed">
												<PARAM>															
															<IF_TEST Test="count($condition/*) > 0">
															<THEN>
																			<TO_XML DocVar="condition" />
															</THEN>
															</IF_TEST>	
												</PARAM>
									</TO_DOCVAR>								
									<SET Var="DIMENSION" FromValue="{$thisParam/DIMENSION/@Value}" />
									<SET Var="LEVEL" FromValue="{$thisParam/LEVEL/@Value}" />
									<REQUEST Name="GetMembersForUI" AssignToVar="Members" ReturnRowCount="yes">
											<DIMENSION Value="{$DIMENSION}" />
											<LEVEL Value="{$LEVEL}" />
											<MAX_ROWS Value="{$thisParam/MAX_ROWS/@Value}" />
											<START_AT_ROW Value="{$thisParam/START_AT_ROW/@Value}" />
											<TO_XML SelectList="$paramter2BePassed/*"/>
											<startcount Value="{$thisParam/startcount/@Value}"/>
									</REQUEST>
								
									<TO_DOCVAR AssignToVar="ListOfMembersForTable">
												<MEMBERS TotalRowCount="{$Members/@TotalRowCount}">
															<FOR_EACH CurrentElement="currentMember" SelectList="$Members/MEMBER">
																			<TO_DOCVAR AssignToVar="member">
																								<LINE>
																											<Id Value="{$currentMember/ID/@Value}" />
																											<Name Value="{$currentMember/NAME/@Value}" />
																											<Description Value="{$currentMember/DESCRIPTION/@Value}" />
																								</LINE>
																			</TO_DOCVAR>
																			<TO_XML DocVar="member" />
															</FOR_EACH>
												</MEMBERS>
									</TO_DOCVAR>
									<SET DocVar="thisReturn" Property="MAX_ROWS" FromValue="{$thisParam/MAX_ROWS/@Value}" />
									<SET DocVar="thisReturn" Property="MEMBER_COUNT" FromValue="{$Members/TOTAL_COUNT/@Value}" />
									<ADD_CHILDREN DocVar="thisReturn" FromDocVar="ListOfMembersForTable" />
				</ACTION>	
		</RULE>
		</DEFINE_METHOD>		
	
</DOCUMENTS>
