	   <!--
        @Function : Returns the List of users for the List Box.
        @                This function is the wrapper that converts the data(model) in the required format for showing the information in the List box
     -->
		<DEFINE_METHOD Access="private" Name="GetAllUsersAsList">
		<RULE>
					<ACTION>
									<TO_DOCVAR AssignToVar="listOfUsers">
												<USERS>
												<FOR_EACH CurrentElement="currentUser" SelectList="$thisParam/USERLIST/USER">
																<IF_TEST Test="$currentUser/@Type = 'Group'">
																<THEN>
																					<TO_DOCVAR AssignToVar="user">
																								<OPTION Value="{concat($currentUser/@Value, '[UG]')}" Id="{$currentUser/@Id}" />
																					</TO_DOCVAR>
																					<TO_XML DocVar="user" />
																</THEN>		
																<ELSE>
																					<TO_DOCVAR AssignToVar="user">
																								<OPTION Id="{$currentUser/@Id}" Value="{$currentUser/@Value}" />
																					</TO_DOCVAR>
																					<TO_XML DocVar="user" />
																</ELSE>
																</IF_TEST>			
												</FOR_EACH>
												</USERS>
									</TO_DOCVAR>
									<ADD_CHILDREN DocVar="thisReturn" FromDocVar="listOfUsers" />
					</ACTION>
		</RULE>
		</DEFINE_METHOD>
	
	  <DEFINE_METHOD Access="public" Name="concatString">
		<RULE>
					<ACTION>
											<SET Var="Separator" FromValue="," />
											<IF_TEST Test="strlen($thisParam/SEPARATOR/@Value) > 0">
											<THEN>
															<SET Var="Separator" FromValue="{$thisParam/SEPARATOR/@Value}" />
															<DELETE_ALL_CHILDREN Select="$thisParam">
																		<SEPARATOR />
															</DELETE_ALL_CHILDREN>
											</THEN>	
											</IF_TEST>
												<SET Var="return" FromValue=" " />
											<FOR_EACH CurrentElement="param" SelectList="$thisParam/*">
															<SET Var="return" FromValue="{concat(concat($return,$Separator), $param/@Value)}" />
											</FOR_EACH>
											<SET DocVar="thisReturn" Property="CONCATENATED" FromValue="{trim($return)}" />
					</ACTION>
		</RULE>
	  </DEFINE_METHOD>
		 
</DOCUMENTS>
