<DOCUMENTS>
  <DEFINE_METHOD Name="saveParameters">
    <RULE>
      <ACTION>
        <!--This api is passed the outxml and updates workflow variable with them -->
        <TO_DOCVAR AssignToVar="saveParameters">
          <PARAMS>
            <TO_XML SelectList="$thisParam/*"/>
          </PARAMS>
        </TO_DOCVAR>
      </ACTION>
    </RULE>
  </DEFINE_METHOD>
  <DEFINE_METHOD Name="getscreenHeader">
    <RULE>
      <ACTION>
        <TO_DOCVAR AssignToVar="measuredimensions">
          <DIMENSION/>
        </TO_DOCVAR>
        <REQUEST Name="getAlldimensions" ServiceName="BCM_MASTER" AssignToVar="dimoptions">
					<measureID Value="{$thisParam/measureID/@Value}"/> 
					 <buttonAction Value="{$thisParam/buttonAction/@Value}"/>
					</REQUEST>
        <TO_DOCVAR AssignToVar="measuredimensions">
          <DIMENSION>
            <TO_XML SelectList="$dimoptions/DIMENSION/*"/>
          </DIMENSION>
        </TO_DOCVAR>
        <ADD_CHILDREN DocVar="thisReturn" FromDocVar="measuredimensions"/>
        <ADD_CHILDREN DocVar="thisReturn" FromSelectList="$leveloptions/*"/>
      </ACTION>
    </RULE>
  </DEFINE_METHOD>
  <DEFINE_METHOD Name="modifymeasure">
    <API_DOC>
      <INPUT>
      </INPUT>
      <OUTPUT>
        <ON_SUCCESS>
        </ON_SUCCESS>
      </OUTPUT>
    </API_DOC>
    <RULE>
      <ACTION>
        <TO_DOCVAR AssignToVar="measureVar">
          <DIMENSIONS/>
        </TO_DOCVAR>
        <TO_DOCVAR AssignToVar="measuretempVar">
          <SCHEDULES>
            <TO_XML SelectList="$thisParam/NEW/SCHEDULES/*"/>
          </SCHEDULES>
        </TO_DOCVAR>
        <TO_DOCVAR AssignToVar="measuredimensions">
          <SCHEDULES>
            <TO_XML SelectList="$thisParam/OLD/RESPONSE/*"/>
          </SCHEDULES>
        </TO_DOCVAR>
        <TO_DOCVAR AssignToVar="temp">
          <abc/>
        </TO_DOCVAR>
        <FOR_EACH SelectList="$measuredimensions/*" CurrentElement="checkPresent">
          <IF_TEST Test="($measuretempVar/SCHEDULE/ID/@Value=$checkPresent/ID/@Value)">
            <THEN>
              <SET Var="isPresent" FromValue="true"/>
              <!--	 <SET_CHILD DocVar="measuredimensions" FromDocVar="measuretempVar"  /> -->
              <!--	 <REMOVE_CHILDREN ChildName="SCHEDULE" DocVar="measuredimensions"/>
							<APPEND_CHILDREN DocVar="measuredimensions"  FromDocVar="measuretempVar"/> -->
              <ADD_CHILDREN DocVar="temp" FromSelectList="$measuretempVar/*"/>
            </THEN>
            <ELSE>
              <ADD_CHILDREN DocVar="temp" FromDocVar="checkPresent"/>/>







              <!--<EXIT/>-->
            </ELSE>
          </IF_TEST>
        </FOR_EACH>
        <IF_TEST Test="($isPresent/@Value!='true')">
          <THEN>
            <ADD_CHILDREN DocVar="temp" FromSelectList="$measuretempVar/*"/>
          </THEN>
        </IF_TEST>
			
			
		 <TO_DOCVAR AssignToVar="temp1">
				<SCHEDULES/>
			</TO_DOCVAR>
				<TO_DOCVAR AssignToVar="temp2">
				<SCHEDULES/>
			</TO_DOCVAR>
			   <FOR_EACH SelectList="$temp/*" CurrentElement="checkTime">
				
				
				   <GET_DOCUMENT Name="Dimension" AssignToVar="is_Dim_info" ServiceName="BCM_MASTER" ReturnRowCount="Yes">
            <Name Value="{$checkTime/ID/@Value}" MatchBy="EQUAL"/>
            <SELECT>
              <isTime/>
            </SELECT>
          </GET_DOCUMENT>
				
				
				     <IF_TEST Test="($is_Dim_info/Dimension/isTime/@Value='true')">
            <THEN>
						<ADD_CHILDREN DocVar="temp1" FromDocVar="checkTime"/>
						</THEN>
					<ELSE>
						<ADD_CHILDREN DocVar="temp2" FromDocVar="checkTime"/>
					</ELSE>
					</IF_TEST>
				</FOR_EACH>
			 <ADD_CHILDREN DocVar="temp2" FromSelectList="$temp1/*"/>
			
        <TO_DOCVAR AssignToVar="measuredimensions">
          <SCHEDULES>
            <TO_XML SelectList="$temp2/*"/>
          </SCHEDULES>
        </TO_DOCVAR> 
			<!--
			 <TO_DOCVAR AssignToVar="measuredimensions">
          <SCHEDULES>
            <TO_XML SelectList="$temp/*"/>
          </SCHEDULES>
        </TO_DOCVAR>-->
        <ADD_CHILDREN DocVar="thisReturn" FromSelectList="$measuredimensions/*"/>
      </ACTION>
    </RULE>
  </DEFINE_METHOD>
