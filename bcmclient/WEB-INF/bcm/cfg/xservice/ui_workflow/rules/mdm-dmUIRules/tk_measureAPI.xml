  <DEFINE_METHOD Name="getTreelayout">
    <API_DOC>
      <INPUT>
      </INPUT>
      <OUTPUT>
        <ON_SUCCESS>
        </ON_SUCCESS>
      </OUTPUT>
    </API_DOC>
    <RULE>
      <ACTION>
        <TO_DOCVAR AssignToVar="listValues">
          <PARAMETERS>
            <TO_XML SelectList="$thisParam/PARAMETERS/*"/>
          </PARAMETERS>
        </TO_DOCVAR>
        <TO_DOCVAR AssignToVar="currentnewVar">
          <LOOKUPS/>
        </TO_DOCVAR>
        <TO_DOCVAR AssignToVar="uboundVar">
          <UBOUNDS/>
        </TO_DOCVAR>
        <TO_DOCVAR AssignToVar="mainVar">
          <OPTIONS/>
        </TO_DOCVAR>
        <TO_DOCVAR AssignToVar="subVar">
          <OPTIONS/>
        </TO_DOCVAR>
			 <TO_DOCVAR AssignToVar="mainRank">
          <LINE/>
        </TO_DOCVAR>
			<!--modify for rank -->
			<FOR_EACH SelectList="$thisParam/RANKS/*" CurrentElement="currentrank">
				<IF_TEST Test="strlen($currentrank/level/@Value)=0">
					<THEN>
					 
	<SET Var="result" FromValue="{$currentrank/@Value}"/>
						
						
						
					</THEN>
						<ELSE>
					
				<SET Var="levels" FromValue="{$currentrank/level/@Value}"/>
				<SET Var="ranks" FromValue="{$currentrank/rank/@Value}"/>
				<SET Var="result" FromValue="{concat($levels/@Value,'(',$ranks/@Value,')')}"/>
				</ELSE>
					</IF_TEST>
			<TO_DOCVAR AssignToVar="rankTemp">
				<LINE>
					<level Value="{$result/@Value}"/>
				</LINE>
			</TO_DOCVAR>
				<ADD_CHILDREN  DocVar="mainRank" FromSelectList="$rankTemp/*"/>
			</FOR_EACH>
        <SET Var="lookupcount" FromValue="{count($listValues/level)}"/>
        <SET Var="uboundcount" FromValue="{count($listValues/ubound)}"/>
        <IF_TEST Test="($uboundcount/@Value > $lookupcount/@Value)">
          <THEN>
            <SET Var="max" FromValue="ubound"/>
            <SET Var="mincount" FromValue="{$lookupcount/@Value}"/>
            <ADD_CHILDREN DocVar="mainVar" FromSelectList="$listValues/*[name() = 'ubound']"/>
            <ADD_CHILDREN DocVar="subVar" FromSelectList="$mainRank/*"/>
            <!--  <ADD_CHILDREN DocVar="subVar" FromSelectList="$listValues/*[name() = 'rank']"/>-->
          </THEN>
          <ELSE>
            <SET Var="max" FromValue="level"/>
            <SET Var="mincount" FromValue="{$uboundcount/@Value}"/>
            <ADD_CHILDREN DocVar="mainVar" FromSelectList="$mainRank/*"/>
            <!--	   <ADD_CHILDREN DocVar="mainVar" FromSelectList="$listValues/*[(name() = 'rank') and @Value  !=null]"/>-->
            <ADD_CHILDREN DocVar="subVar" FromSelectList="$listValues/*[name() = 'ubound']"/>
          </ELSE>
        </IF_TEST>
        <SET Var="countmain" FromValue="0"/>
        <FOR_EACH SelectList="$mainVar/*" CurrentElement="current">
          <TO_DOCVAR AssignToVar="currentVar">
            <LINES/>
          </TO_DOCVAR>
          <SET Var="countsub" FromValue="0"/>
				<IF_TEST Test="(count($subVar/*)!=0)">
					<THEN>
          <FOR_EACH SelectList="$subVar/*" CurrentElement="current1">
            <IF_TEST Test="(($countmain/@Value='0') and ($countsub/@Value='0'))">
              <THEN>
                <TO_DOCVAR AssignToVar="currentVar">
                  <LINES>
                    <LINE>
                      <lbound Value="{$thisParam/PARAMETERS/lbound/@Value}"/>
                  
                      <TO_XML Select="$current"/>
                      <TO_XML Select="$current1"/>
                    </LINE>
                  </LINES>
                </TO_DOCVAR>
              </THEN>
              <ELSE>
                <IF_TEST Test="($countmain/@Value=$countsub/@Value)">
                  <THEN>
                    <TO_DOCVAR AssignToVar="uboundVar">
                      <LINES>
                        <LINE>
                          <TO_XML Select="$current"/>
                          <TO_XML Select="$current1"/>
                        </LINE>
                      </LINES>
                    </TO_DOCVAR>
                    <ADD_CHILDREN DocVar="currentVar" FromSelectList="$uboundVar/*"/>
                  </THEN>
                </IF_TEST>
              
              </ELSE>
            </IF_TEST>
            <SET Var="countsub" FromValue="{int($countsub+1)}"/>
          </FOR_EACH>
						</THEN>
					<ELSE>
						  <IF_TEST Test="($countmain/@Value='0')">
              <THEN>
                <TO_DOCVAR AssignToVar="currentVar">
                  <LINES>
                    <LINE>
                      <lbound Value="{$thisParam/PARAMETERS/lbound/@Value}"/>
                    
                      <TO_XML Select="$current"/>
                   
                    </LINE>
                  </LINES>
                </TO_DOCVAR>
              </THEN>
              <ELSE>
             
                    <TO_DOCVAR AssignToVar="uboundVar">
                      <LINES>
                        <LINE>
                          <TO_XML Select="$current"/>
                          
                        </LINE>
                      </LINES>
                    </TO_DOCVAR>
                    <ADD_CHILDREN DocVar="currentVar" FromSelectList="$uboundVar/*"/>
                 
                
              </ELSE>
            </IF_TEST>
            <SET Var="countsub" FromValue="{int($countsub+1)}"/>
					</ELSE>
					</IF_TEST>
				<IF_TEST Test="($mincount/@Value!=0)">
					<THEN>
          <IF_TEST Test="($countmain/@Value >= $mincount/@Value)">
            <THEN>
              <TO_DOCVAR AssignToVar="uboundVar">
                <LINES>
                  <LINE>
                    <TO_XML Select="$current"/>
                  </LINE>
                </LINES>
              </TO_DOCVAR>
              <ADD_CHILDREN DocVar="currentVar" FromSelectList="$uboundVar/*"/>
            </THEN>
          </IF_TEST>
						</THEN>
					</IF_TEST>
					
          <ADD_CHILDREN DocVar="currentnewVar" FromSelectList="$currentVar/*"/>
          <SET Var="countmain" FromValue="{int($countmain+1)}"/>
        </FOR_EACH>
        <ADD_CHILDREN DocVar="thisReturn" FromDocVar="currentnewVar"/>
      </ACTION>
    </RULE>
  </DEFINE_METHOD>
  <DEFINE_METHOD Name="getlinelayout">
    <API_DOC>
      <INPUT>
      </INPUT>
      <OUTPUT>
        <ON_SUCCESS>
        </ON_SUCCESS>
      </OUTPUT>
    </API_DOC>
    <RULE>
      <ACTION>
        <TO_DOCVAR AssignToVar="temps">
          <LINES/>
        </TO_DOCVAR>
        <TO_DOCVAR AssignToVar="parentVar">
          <LINE/>
        </TO_DOCVAR>
			
			<TO_DOCVAR AssignToVar="dimVar1">
				<DIMS>
					<TO_XML SelectList="$thisParam/DIMS/*"/>
				</DIMS>
			</TO_DOCVAR>
				<TO_DOCVAR AssignToVar="dimVar2">
				<DIMS/>
					 
				 
			</TO_DOCVAR>
		 	<FOR_EACH SelectList="$thisParam/CURRENT/*" CurrentElement="currdim">
				 	<FOR_EACH SelectList="$dimVar1/*" CurrentElement="currdim1">
				<SET Var="curr" FromValue="{$currdim/name()}"/>
						 
				<IF_TEST Test="($currdim1/name()=$curr/@Value)">
					<THEN>
						<ADD_CHILDREN DocVar="dimVar2" FromDocVar="currdim"/>
					</THEN>
				</IF_TEST>
				</FOR_EACH>
			
					</FOR_EACH>
        <TO_DOCVAR AssignToVar="listValues">
          <MAIN>
            <INPUT>
						<TO_XML SelectList="$dimVar2/*"/>
             <!-- <TO_XML SelectList="$thisParam/CURRENT/*[(name()='Product') or (name()='Manufacturing') or (name()='Access') or (name()='Time') or (name()='Retail') or (name()='CustProduct')]"/>-->
						 <TO_XML SelectList="$thisParam/OLD/LINE/*[name()='ID']"/>
						 <TO_XML SelectList="$thisParam/CURRENT/*[name()='Access']"/>
            </INPUT>
            <COLLATE_LIST Value="LINE">
						<ID/>
              <Access/>
						<TO_XML SelectList="$thisParam/DIMS/*"/>
           <!--   <Time/>
              <Product/>
              <Retail/>
              <CustProduct/>
              <Manufacturing/>-->
            </COLLATE_LIST>
          </MAIN>
        </TO_DOCVAR>
        <COLLATE_XML Var="listValues" AssignToVar="currentVar"/>
			   
        <FOR_EACH SelectList="$currentVar/*" CurrentElement="curr">
          <FOR_EACH SelectList="$thisParam/OLD/*" CurrentElement="curr1">
            <TO_DOCVAR AssignToVar="temps">
              <LINE>
               <!-- <ID Value="{$curr1/ID/@Value}"/>-->
                <TO_XML SelectList="$curr/*"/>
              </LINE>
            </TO_DOCVAR>
          </FOR_EACH>
          <ADD_CHILDREN DocVar="parentVar" FromDocVar="temps"/>
        </FOR_EACH>
        <ADD_CHILDREN DocVar="thisReturn" FromSelectList="$parentVar/*"/>
      </ACTION>
    </RULE>
  </DEFINE_METHOD>
  <DEFINE_METHOD Name="getranklayout">
    <API_DOC>
      <INPUT>
      </INPUT>
      <OUTPUT>
        <ON_SUCCESS>
        </ON_SUCCESS>
      </OUTPUT>
    </API_DOC>
    <RULE>
      <ACTION>
        <TO_DOCVAR AssignToVar="temps">
          <LINES/>
        </TO_DOCVAR>
        <TO_DOCVAR AssignToVar="parentVar">
          <LINE/>
        </TO_DOCVAR>
        <TO_DOCVAR AssignToVar="rankValues">
          <MAIN/>
        </TO_DOCVAR>
        <FOR_EACH SelectList="$thisParam/PARAMETERS/rank" CurrentElement="curr1">
          <IF_TEST Test="strlen($curr1/@Value) !=0">
            <THEN>
              <ADD_CHILDREN DocVar="rankValues" FromSelect="$curr1"/>
            </THEN>
          </IF_TEST>
        </FOR_EACH>
        <TO_DOCVAR AssignToVar="listValues">
          <MAIN>
            <INPUT>
              <!--
											<TO_XML SelectList="$levelValues/*"/>-->
              <TO_XML SelectList="$rankValues/*"/>
              <TO_XML SelectList="$thisParam/PARAMETERS/*[(name()='level')]"/>
              <!-- <TO_XML SelectList="$thisParam/PARAMETERS/*[(((name()='level') and (level/@Value!=null)) or ((name()='rank')  and (rank/@Value!=null)))]"/> -->
            </INPUT>
            <COLLATE_LIST Value="LINE">
              <level/>
              <rank/>
            </COLLATE_LIST>
          </MAIN>
        </TO_DOCVAR>
        <COLLATE_XML Var="listValues" AssignToVar="currentVar"/>
        <ADD_CHILDREN DocVar="thisReturn" FromSelectList="$currentVar/*"/>
      </ACTION>
    </RULE>
  </DEFINE_METHOD>
<DEFINE_METHOD Name="removeexistLevels">
	<RULE>
		<ACTION>
			
	 	<TO_DOCVAR AssignToVar="mainVar">
				<ALL>
				<TO_XML SelectList="$thisParam/OLD/*"/>
					</ALL>
			</TO_DOCVAR> 
	 
			<REMOVE_CHILDREN DocVar="mainVar" ChildName="ORDERS"/>
						<TO_DOCVAR AssignToVar="tempVar">
				<ORDERS/>
	 	</TO_DOCVAR>
			<FOR_EACH SelectList="$thisParam/OLD/ORDERS/*" CurrentElement="CURR1">
				
				<FOR_EACH SelectList="$thisParam/NEW/LINE/ORDERS/*" CurrentElement="CURR2">
					<IF_TEST Test="($CURR1/level/@Value=$CURR2/level/@Value)">
						<THEN>
						 
								 <IF_TEST Test="count($tempVar/LINE[level/@Value=$CURR2/level/@Value])=0">
								<THEN>
							<ADD_CHILDREN DocVar="tempVar" FromDocVar="CURR2"/>
											</THEN>
								</IF_TEST>
							
					
						</THEN>
				 
							
					 
					</IF_TEST>
				</FOR_EACH>
					 	 <IF_TEST Test="count($tempVar/LINE[level/@Value=$CURR1/level/@Value])=0">
								<THEN>
							<ADD_CHILDREN DocVar="tempVar" FromDocVar="CURR1"/>
									</THEN>
								</IF_TEST>
			</FOR_EACH>
			<ADD_CHILDREN DocVar="mainVar" FromDocVar="tempVar"/>
					<ADD_CHILDREN DocVar="thisReturn" FromSelectList="$mainVar/*"/>
			
		</ACTION>
	</RULE>
</DEFINE_METHOD>
</DOCUMENTS>
