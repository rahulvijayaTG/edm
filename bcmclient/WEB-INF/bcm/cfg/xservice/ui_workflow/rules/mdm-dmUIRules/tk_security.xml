								<TO_DOCVAR AssignToVar="usersList2Sort">
													<USERLIST>
													<FOR_EACH CurrentElement="tempUserList" SelectList="$UsersList/USER">
																<TO_DOCVAR AssignToVar="usersList2bSorted">	
																	<USERS>
																		<TO_XML SelectList="$tempUserList" />
																	</USERS>
																</TO_DOCVAR>
																<TO_XML DocVar="usersList2bSorted" />				
													</FOR_EACH>
													</USERLIST>
								</TO_DOCVAR>	
								<SORT SelectList="$usersList2Sort/USERS" DataType="string" Key="USER" SortOrder="ascending" ></SORT>
								
								<TO_DOCVAR AssignToVar="UsersList">
											<USERLIST>
									<FOR_EACH CurrentElement="tempUserList" SelectList="$usersList2Sort/USERS/USER">																
												<TO_XML DocVar="tempUserList" />				
									</FOR_EACH>
											</USERLIST>
								</TO_DOCVAR>
								
								<ADD_CHILDREN DocVar="thisReturn" FromDocVar="UsersList" />
												
						</ACTION>
			</RULE>
			</DEFINE_METHOD>	
</DOCUMENTS>
