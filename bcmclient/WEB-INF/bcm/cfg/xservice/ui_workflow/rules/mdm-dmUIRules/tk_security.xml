															<USERLIST>
																		<USER Type="User" Id="Arun" Value="Arun" />
																		<USER Type="User" Id="Neeraj" Value="Neeraj" />
																		<USER Type="User" Id="Rajiv" Value="Rajiv" />
																		<USER Type="User" Id="Sumesh" Value="Sumesh" />
																		<USER Type="Group" Id="i2DM" Value="i2DM" />
																		<USER Type="Group" Id="Public" Value="Public" />
																		<USER Type="User" Id="Sumesh1" Value="Sumesh1" />
																		<USER Type="Group" Id="i2DM1" Value="i2DM1" />
																		<USER Type="Group" Id="Public1" Value="Public2" />
															</USERLIST>		
				                 </TO_DOCVAR>
