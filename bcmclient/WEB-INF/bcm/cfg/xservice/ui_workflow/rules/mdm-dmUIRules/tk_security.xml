<DOCUMENTS>

			<DEFINE_METHOD Access="public" Name="GetAllUsers">
			<RULE>
						<ACTION>
							 				<GET_DOCUMENT Name="USER_GRP_PROFILE" AssignToVar="usrGrpDocs" ServiceName="USER_SECURITY">
							          <STATUS Value="ACTIVE"/>
							        </GET_DOCUMENT>	
				              <GET_DOCUMENT Name="USER_PROFILE" AssignToVar="usrDocs" ServiceName="USER_SECURITY">
        								<STATUS Value="ACTIVE"/>
      								</GET_DOCUMENT>	  	
											<TO_DOCVAR AssignToVar="UsersList">
												<USERLIST>
												

						
						
						
						
					<FOR_EACH CurrentElement="currentUserGroup" SelectList="$usrGrpDocs/USER_GRP_PROFILE">																
														<TO_DOCVAR AssignToVar="user">
																	<USER Type="Group" Value="{$currentUserGroup/GRP_NAME/@Value}" Id="{$currentUserGroup/GRP_NAME/@Value}" />
														</TO_DOCVAR>
														<TO_XML DocVar="user" />																	
												</FOR_EACH>
						
						
					<!--*****************************	-->
						<!--		ISSUE  (S2 Defect) 559340				-->
						<!--			LOGIN_NAME instead of ID	-->
					<!--*****************************	-->
						
						
												<FOR_EACH CurrentElement="currentUser" SelectList="$usrDocs/USER_PROFILE">																
													 <TO_DOCVAR AssignToVar="user">
																	<USER Type="User" Id="{$currentUser/LOGIN_NAME/@Value}" Value="{$currentUser/LOGIN_NAME/@Value}" />
														</TO_DOCVAR> 
														<TO_XML DocVar="user" />																	
												</FOR_EACH>
												</USERLIST>
										</TO_DOCVAR>	
										<!--<ADD_CHILDREN DocVar="thisReturn" FromDocVar="UsersList" />	-->
																																
