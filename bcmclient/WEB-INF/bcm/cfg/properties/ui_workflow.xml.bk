<?xml version="1.0" encoding="UTF-8"?>
<dom-config>
  <service-config Name="UI_WORKFLOW" Register="true" TransactionCache="false">
    <logger>
      <file Name="myservice.log"/>
      <brief-console Value="true"/>
      <logLevels>
        <logLevel Value="Exception"/>
        <logLevel Value="Error"/>
      </logLevels>
    </logger>
    <register-handlers>
      <handler TagName="workflow" ClassName="com.i2.xcore.workflow.WorkflowConfigHandler"/>
      <handler TagName="MDM" ClassName="com.i2.bcm.xcore.tool.MDMPreInitHandler"/>
    </register-handlers>
    <MDM/>
    <!-- required for handling REQUEST_HEADER under REQUESTS tag -->
    <ruleDefnFiles>
      <!--added for mdm-dm -->
      <ruleDefnFile Name="xservice/ui_workflow/rules/mdm-dmUIRules/tk_measureAPI.xml"/>
      <ruleDefnFile Name="xservice/ui_workflow/rules/mdm-dmUIRules/tk_mdm_dm_UIRules.xml"/>
      <!--   <ruleDefnFile Name="xservice/ui_workflow/rules/mdm-dmUIRules/tk_Measure_Rules.xml"/> -->
      <ruleDefnFile Name="xservice/ui_workflow/rules/mdm-dmUIRules/tk_HierarchyRules.xml"/>
      <ruleDefnFile Name="xservice/ui_workflow/rules/mdm-dmUIRules/tk_mapsetworkflowrules.xml"/>
      <ruleDefnFile Name="xservice/ui_workflow/rules/mdm-dmUIRules/tk_metadata.xml"/>
      <ruleDefnFile Name="xservice/ui_workflow/rules/mdm-dmUIRules/tk_security.xml"/>
      <ruleDefnFile Name="xservice/ui_workflow/rules/mdm-dmUIRules/tk_UIAPIsForMapsets.xml"/>
      <ruleDefnFile Name="xservice/ui_workflow/rules/mdm-dmUIRules/tk_UIMetadata.xml"/>
      <ruleDefnFile Name="xservice/ui_workflow/rules/mdm-dmUIRules/tk_Utility.xml"/>
      <ruleDefnFile Name="xservice/ui_workflow/rules/UINavigationRule.xml"/>
      <!--ruleDefnFile Name="xservice/ui_workflow/rules/tk_dataTraceability.xml"/-->
    </ruleDefnFiles>
    <docDefnFiles>
    </docDefnFiles>
    <workflow>
      <workflowDefnFiles>
        <!--Data Quality & Profiling-->
        <workflowDefnFile Name="xservice/ui_workflow/workflows/dataquality/qualityReport.xml"/>
        <workflowDefnFile Name="xservice/ui_workflow/workflows/dataprofiling/entitySelection.xml"/>
        <workflowDefnFile Name="xservice/ui_workflow/workflows/dataaudit/dataAuditReport.xml"/>
        <!--added for mdm-dm -->
        <workflowDefnFile Name="xservice/ui_workflow/workflows/mdm-dm/tk_Manage_Measure.xml"/>
        <workflowDefnFile Name="xservice/ui_workflow/workflows/mdm-dm/tk_Manage_Mapset.xml"/>
        <workflowDefnFile Name="xservice/ui_workflow/workflows/mdm-dm/tk_Manage_Member.xml"/>
        <!-- Added for GPM -->
        <workflowDefnFile Name="xservice/ui_workflow/workflows/GPM/ManageGroups.xml"/>
        <workflowDefnFile Name="xservice/ui_workflow/workflows/GPM/ManageGroupClass.xml"/>
        <workflowDefnFile Name="xservice/ui_workflow/workflows/GPM/ManageAttributeSets.xml"/>
        <workflowDefnFile Name="xservice/ui_workflow/workflows/item_location/SelectItem.xml"/>
        <workflowDefnFile Name="xservice/ui_workflow/workflows/item_location/SelectLocation.xml"/>
        <workflowDefnFile Name="xservice/ui_workflow/workflows/item_location/DefineAttributes.xml"/>
        <workflowDefnFile Name="xservice/ui_workflow/workflows/item_location/CreateItemLocation.xml"/>
        <!-- Added for Metadata -->
        <workflowDefnFile Name="xservice/ui_workflow/workflows/mdmgmt/searchMetaData.xml"/>
        <workflowDefnFile Name="xservice/ui_workflow/workflows/mdmgmt/dataPkgDetails.xml"/>
        <workflowDefnFile Name="xservice/ui_workflow/workflows/mdmgmt/dataGrpDetails.xml"/>
        <workflowDefnFile Name="xservice/ui_workflow/workflows/mdmgmt/impactAnalysis.xml"/>
        <workflowDefnFile Name="xservice/ui_workflow/workflows/mdmgmt/businessRuleDetails.xml"/>
        <workflowDefnFile Name="xservice/ui_workflow/workflows/datatraceability/dataTraceability.xml"/>
        <!--workflowDefnFile Name="xservice/ui_workflow/workflows/testWf.xml"/-->
      </workflowDefnFiles>
      <uiWorkflowDefnFiles>
      </uiWorkflowDefnFiles>
      <nodeHandlers>
        <nodeHandler Name="ui_form2" ClassName="com.i2.xcore.workflow.UINodeHandler"/>
      </nodeHandlers>
    </workflow>
    <eventDefnFiles/>
    <statetransition>
      <stateTransitionFiles/>
      <stateMappingFiles/>
    </statetransition>
    <messaging>
      <messageTemplateFiles/>
      <messageRecipientGroupFiles/>
      <messagingEventDefFiles/>
      <messagingEventFiles/>
    </messaging>
    <validationSpecFiles/>
    <extensionFiles/>
    <service-params>
      <param Name="Max_Rows" Value="5"/>
    </service-params>
    <schemaGenerate Value="true">
      <file Value="test.sql"/>
      <generateTables Value="true"/>
      <maxTableNameLength Value="25"/>
      <maxColumnNameLength Value="29"/>
    </schemaGenerate>
  </service-config>
</dom-config>