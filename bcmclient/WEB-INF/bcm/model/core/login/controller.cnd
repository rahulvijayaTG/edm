<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:scenario="http://www.i2.com/scenario" xmlns:identity="http://www.i2.com/identity" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:cis="http://www.i2.com/cis" description="_">

<!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="display">
    <xapl:if test="$ssoEnabled = 'true'">
      <cis:sso-logout/>
    </xapl:if>

    <web:invalidate-session/>
    <web:display-page>
      <web:get-page name="core_login"/>
    </web:display-page>
  </x2:command>

<!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="validateSession">
    <xapl:variable name="identityId" select="identity-user-id()"/>
    <xapl:choose>
      <xapl:when test="$ssoEnabled = 'true'">
        <!-- If sso enabled, get user name from cis -->
        <xapl:variable name="userName"><cis:get-user-name/></xapl:variable>

        <xapl:choose>
                    
          <!-- If sso username is invalid, then redirect user to login page -->
          <xapl:when test="string-length($userName) = 0">
          <web:display-page>
	  	<web:get-page name="scmPage"/>	  		  
           </web:display-page>                     
          </xapl:when>
          <!-- If sso username is valid and its different from identity, then refresh identity -->
          <xapl:when test="string-length($userName) &gt; 0 and $userName != $identityId">
            <identity:create-identity userId="{$userName}"/>
          </xapl:when>
        </xapl:choose>

      </xapl:when>
      <xapl:otherwise>
        <!-- If sso not enabled, check if identity object is valid -->
        <xapl:if test="string-length($identityId) = 0">
          <web:display-page>
            <web:get-page name="login">
                <FROM Value="SESSION"/>
            </web:get-page>
          </web:display-page>
        </xapl:if>
      </xapl:otherwise>
    </xapl:choose>

  </x2:command>

<!-- **********************************************************************
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="login">

    <web:invalidate-session/>

    <xapl:variable name="isValid">
      <xcore:execute-method name="//EMService/validateLogin" entireResponse="true">
        <LOGIN_NAME Value="{$this/USER_NAME/@Value}"/>
        <PASSWORD Value="{$this/PASSWORD/@Value}"/>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:print>PPPPPPPPPPPP inside login/controller/login!!!!</xapl:print>
    <xapl:choose>
      <xapl:when test="string-length($isValid/RESPONSE/_RESULT/_ERROR/@Value) = 0">
        <identity:create-identity userId="{$this/USER_NAME/@Value}"/>
      </xapl:when>
      <xapl:otherwise>
        <web:display-page>
          <web:get-page name="core_login">
            <ERROR Value="true"/>
            <xapl:value-of select="{$this/USER_NAME}"/>
            <DESCRIPTION Value="{$isValid/RESPONSE/_RESULT/_ERROR/@Value}"/>
          </web:get-page>
        </web:display-page>
      </xapl:otherwise>
    </xapl:choose>

    <xapl:if test="{$this/CHANGE_PASSWD/@Value='yes'}">
      <web:display-page>
        <web:get-page name="core_change_passwd"/>
      </web:display-page>
    </xapl:if>

    <web:display-page>
      <web:get-page name="core_shell_display"/>
    </web:display-page>
  </x2:command>

  <!--****************************************************************
  ****************************************************************** -->
  <x2:command public="yes" description="_" name="ssoLogin">

    <web:invalidate-session/>

    <xapl:variable name="isValid">
      <cis:sso-login processLogin="true"/>
    </xapl:variable>
    <xapl:choose>
        <xapl:when test="$loadTablesOnLogin='yes'">
            <xapl:set-variable name="firstTimeLoad" select="'no'"/>
        </xapl:when>
        <xapl:otherwise>
            <xapl:set-variable name="firstTimeLoad" select="'yes'"/>
        </xapl:otherwise>
    </xapl:choose>
    <xapl:choose>
      <xapl:when test="$isValid = 'true'">
        <xapl:variable name="userName"><cis:get-user-name/></xapl:variable>
        <identity:create-identity userId="{$userName}"/>
        <xapl:variable name="sIdAtEnd">
	          <scenario:get-scenario-id/>
        </xapl:variable>
        <!-- anish load the document access control list for user -->
        <xapl:print>
          Loading.... document access control list for user when ssoLogin anish
        </xapl:print>
        <!--x2:execute command="bcm.framework.authorization.auth_controller:loadUserDocAccessControlList"/-->
        </xapl:when>
      <xapl:otherwise>
        
       <web:display-page>
          <web:get-page name="login">
            <ERROR Value="true"/>
            <xapl:value-of select="{$this/USER_NAME}"/>
            <DESCRIPTION Value="{$isValid}"/>
          </web:get-page>
        </web:display-page>
      </xapl:otherwise>
    </xapl:choose>

    <xapl:if test="{$this/CHANGE_PASSWD/@Value='yes'}">
      <web:display-page>
        <web:get-page name="change_passwd"/>
      </web:display-page>
    </xapl:if>

    <x2:execute command="bcm.framework.login:setSecurityVars"/>
    
    <xapl:set-variable name="sessionInstanceVar" select="$appInstanceEnabled"/>
	<xapl:variable name="userFavoritesRes">
        <xcore:execute-method name="//UserSecurity/getFavoriteHierarchy" UserId="{$loginUserId}" entireResponse="true">
        </xcore:execute-method>
    </xapl:variable>
    <xapl:set-variable name="userFavorites">
        <xapl:value-of select="$userFavoritesRes/RESPONSE/*" />
    </xapl:set-variable>
    <xapl:print select="{$userFavorites}"/>
    <web:display-page>
      <web:get-page name="loginSuccess"/>
    </web:display-page>
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="logout">

    <xapl:if test="$ssoEnabled = 'true'">
      <cis:sso-logout/>
    </xapl:if>

    <web:invalidate-session/>
    <web:display-page>
      <web:get-page name="core_login">
        <FROM Value="logout"/>
      </web:get-page>
    </web:display-page>
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getTopLevelActivity">
    <xapl:return>
      <xapl:choose>
        <xapl:when test="isAllowed('TOP_LEVEL_ACTIVITY', 'manage_orders')">manage_orders</xapl:when>
        <xapl:when test="isAllowed('TOP_LEVEL_ACTIVITY', 'configure_system')">configure_system</xapl:when>
        <xapl:when test="isAllowed('TOP_LEVEL_ACTIVITY', 'manage_inventory')">manage_inventory</xapl:when>
        <xapl:when test="isAllowed('TOP_LEVEL_ACTIVITY', 'manage_enterprise')">manage_enterprise</xapl:when>
        <xapl:when test="isAllowed('TOP_LEVEL_ACTIVITY', 'manage_events')">manage_events</xapl:when>
        <xapl:when test="isAllowed('TOP_LEVEL_ACTIVITY', 'manage_events_order')">manage_events_order</xapl:when>
        <xapl:when test="isAllowed('TOP_LEVEL_ACTIVITY', 'manage_events_admin')">manage_events_admin</xapl:when>
        <xapl:otherwise>manage_enterprise</xapl:otherwise>
     </xapl:choose>
    </xapl:return>
  </x2:command>

  <!-- **********************************************************************
       *********************************************************************** -->

</x2:commands>
