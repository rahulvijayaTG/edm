<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:identity="http://www.i2.com/identity" xmlns:i18n="http://www.i2.com/i18n" description="_">
    <!-- ********************************************************************** 
*********************************************************************** -->
    <x2:command public="yes" description="_" name="getLinks">
        <x2:param name="selectedActivity" select="$this/ACTIVITY/@Value"/>
        <x2:param name="solution" select="$this/SOLUTION/@Value"/>
        <xapl:print>PRINTING ACTIVITY INSIDE INSTANCES GETLINKS <xapl:value-of select="$selectedActivity"/>
        </xapl:print>
        <xapl:variable name="pad">
            <PAD Name="instances" DisplayText="Repositories" Scrollable="yes">
                <!-- Instances -->
                <xapl:choose>
                  <xapl:when test="count($this/SOLUTION/@Value) = 0">
                      <PAD_ITEM OnClick="{concat($pages:reference_staging,'&amp;Auth_Enabled=true')}" Target="_top" DisplayText="Reference" Selected="{$selectedActivity = 'bcmReferenceStaging'}"/>
                  </xapl:when>
                  <xapl:otherwise>
                   <PAD_ITEM OnClick="{concat($pages:reference_staging,'&amp;Auth_Enabled=true','&amp;SOLUTION=',$solution)}" Target="_top" DisplayText="Reference" Selected="{$selectedActivity = 'bcmReferenceStaging'}"/>
                  </xapl:otherwise>
                </xapl:choose>
                <perm:is-allowed document="INSTANCES" action="staging">
                    <PAD_ITEM DisplayText="Staging">
                        <perm:is-allowed document="INSTANCES" action="bcmInboundTableEdits">
                <xapl:choose>            
                  <xapl:when test="count($this/SOLUTION/@Value) = 0">
                      <PAD_ITEM OnClick="{concat($pages:input_staging,'&amp;Auth_Enabled=true')}" Target="_top" DisplayText="Inbound Staging" Selected="{$selectedActivity = 'bcmInputStaging'}"/>
                  </xapl:when>
                  <xapl:otherwise>
                     <PAD_ITEM OnClick="{concat($pages:input_staging,'&amp;Auth_Enabled=true','&amp;SOLUTION=',$solution)}" Target="_top" DisplayText="Inbound Staging" Selected="{$selectedActivity = 'bcmInputStaging'}"/>
                  </xapl:otherwise>
                </xapl:choose>    
                        </perm:is-allowed>
                        <xapl:if test="$showOutputStaging='yes'">                        
                            <perm:is-allowed document="INSTANCES" action="bcmOutboundTableView">
                             
                             <xapl:choose>
                               <xapl:when test="count($this/SOLUTION/@Value) = 0">
                                <PAD_ITEM OnClick="{concat($pages:output_staging,'&amp;Auth_Enabled=true')}" Target="_top" DisplayText="Outbound Staging" Selected="{$selectedActivity = 'bcmOutputStaging'}"/>
                               </xapl:when>
                               <xapl:otherwise>
                                <PAD_ITEM OnClick="{concat($pages:output_staging,'&amp;Auth_Enabled=true','&amp;SOLUTION=',$solution)}" Target="_top" DisplayText="Outbound Staging" Selected="{$selectedActivity = 'bcmOutputStaging'}"/>
                               </xapl:otherwise>
                             </xapl:choose>
                                
                            </perm:is-allowed>
                        </xapl:if>
                    </PAD_ITEM>
                </perm:is-allowed>
                <!-- get the Extension PAD ITEMS (from inv opt or others-->
                <x2:execute command="core.navigation.instances:getPadItemExtension">
                    <x2:with-param name="selectedActivity" select="$selectedActivity"/>
                </x2:execute>
                <!-- get the Extension PAD ITEMS (for retail-->
                <x2:execute command="core.navigation.instances:getRetailPadItemExtension">
                    <x2:with-param name="selectedActivity" select="$selectedActivity"/>
                </x2:execute>
            </PAD>
        </xapl:variable>
        <xapl:return>
            <xapl:if test="count($pad/PAD_ITEM)  >0">
                <xapl:value-of select="$pad"/>
            </xapl:if>
        </xapl:return>
    </x2:command>
    <!-- ********************************************************************** 
*********************************************************************** -->
    <x2:command public="yes" description="_" name="getPadItemExtension">
        <x2:param name="selectedActivity" select="$this/ACTIVITY/@Value"/>
        <!-- left bank so that others/invopt etc can define it -->
    </x2:command>
    <!-- **********************************************************************
  *********************************************************************** -->
    <x2:command public="yes" description="_" name="getRetailPadItemExtension">
        <x2:param name="selectedActivity" select="$this/ACTIVITY/@Value"/>
        <!-- left bank so that others/invopt etc can define it -->
    </x2:command>
    <!-- **********************************************************************
  *********************************************************************** -->
</x2:commands>
