				<perm:is-allowed document="TASKS" action="bcmManageNpi">
				    <PAD_ITEM OnClick="{concat($pages:npiHomeFromNav,'&amp;MODE=START','&amp;Auth_Enabled=true','&amp;ACTION_ID=bcmManageNpi')}" DisplayText="Manage NPI"/>
