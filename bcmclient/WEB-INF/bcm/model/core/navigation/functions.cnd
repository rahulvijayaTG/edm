			<perm:is-allowed document="TASKS" action="bcmDistributionNetwork">
				<PAD_ITEM DisplayText="Manage Dist Network">
					<perm:is-allowed document="TASKS" action="bcmManageTransportationMode">
						<PAD_ITEM OnClick="{concat($pages:transportModeHomeFromNav,'&amp;Auth_Enabled=true')}" DisplayText="Transport Mode"/>
					</perm:is-allowed>
					<perm:is-allowed document="TASKS" action="bcmManageDL">
						<PAD_ITEM OnClick="{concat($pages:distributionLaneHomeFromNav,'&amp;Auth_Enabled=true')}" DisplayText="Distribution Lane"/>
					</perm:is-allowed>
					<perm:is-allowed document="TASKS" action="bcmManageBOD">
						<PAD_ITEM OnClick="{concat($pages:bodHomeFromNav,'&amp;Auth_Enabled=true')}" DisplayText="Bill of Distribution"/>
