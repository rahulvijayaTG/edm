						<PAD_ITEM OnClick="{concat($pages:resaltsearch, '&amp;MODE=START','&amp;Auth_Enabled=true')}" DisplayText="Resource Alternates"/>
					</perm:is-allowed>
					<perm:is-allowed document="TASKS" action="bcmManageBOR">
						<PAD_ITEM OnClick="{concat($pages:borsearch,'&amp;MODE=START','&amp;Auth_Enabled=true')}" DisplayText="BOR"/>
					</perm:is-allowed>
					<perm:is-allowed document="TASKS" action="bcmManageOperation">
						<PAD_ITEM OnClick="{concat($pages:operation_search, '&amp;MODE=START','&amp;Auth_Enabled=true')}" DisplayText="Operation"/>
					</perm:is-allowed>
					<perm:is-allowed document="TASKS" action="bcmManageRouting">
						<PAD_ITEM OnClick="{concat($pages:routingopsearch, '&amp;MODE=START','&amp;Auth_Enabled=true')}" DisplayText="Routing"/>
					</perm:is-allowed>
					<perm:is-allowed document="TASKS" action="bcmManageBOM">
						<PAD_ITEM OnClick="{concat($pages:bom_home, '&amp;MODE=START','&amp;Auth_Enabled=true')}" DisplayText="BOM"/>
					</perm:is-allowed>
					<perm:is-allowed document="TASKS" action="bcmManageSupplyChain">
						<PAD_ITEM OnClick="{concat($pages:ibr_search,'&amp;MODE=START','&amp;Auth_Enabled=true')}" DisplayText="Supply Chain"/>
					</perm:is-allowed>
					<!--
                                         <perm:is-allowed document="TASKS" action="bcmManageSellerSafety">
                                                <PAD_ITEM OnClick="{concat($pages:sellerproductsearch,'&amp;MODE=START')}" DisplayText="Seller Product"/>
                                        </perm:is-allowed>
                                        -->
				</PAD_ITEM>
			    <perm:is-allowed document="TASKS" action="bcmMaterialManagement">
