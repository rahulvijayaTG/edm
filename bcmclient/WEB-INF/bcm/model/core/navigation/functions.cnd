					</perm:is-allowed>
				</PAD_ITEM>
			</perm:is-allowed>
			<!-- scenario -->
			<!-- Master Data -->
			<perm:is-allowed document="TASKS" action="bcmManageMasterData">
				<PAD_ITEM DisplayText="Manage Master Data">
					<perm:is-allowed document="TASKS" action="bcmManageItem">
						<PAD_ITEM OnClick="{concat($pages:manage_items, '&amp;MODE=START','&amp;Auth_Enabled=true')}" DisplayText="Items"/>
					</perm:is-allowed>
					<perm:is-allowed document="TASKS" action="bcmManageChannel">
						<PAD_ITEM OnClick="{concat($pages:manage_channels, '&amp;MODE=START','&amp;Auth_Enabled=true')}" DisplayText="Channels"/>
					</perm:is-allowed>
					<perm:is-allowed document="TASKS" action="bcmManageSysProps">
						<PAD_ITEM OnClick="{concat($pages:manage_sysProps, '&amp;MODE=START','&amp;Auth_Enabled=true')}" DisplayText="SystemProperties"/>
					</perm:is-allowed>
					<!-- We don't need this extra tag (Naresh Malkoti commented out)
                    <PAD_ITEM DisplayText="Manage Location">
                        <perm:is-allowed document="TASKS" action="bcmManageLocation">
                            <PAD_ITEM OnClick="{concat( $pages:searchLocation , '&amp;MODE=START','&amp;Auth_Enabled=true') }" DisplayText="Locations"/>
                        </perm:is-allowed>
                        <perm:is-allowed document="TASKS" action="bcmManageHandling">
                            <PAD_ITEM DisplayText="Handling" OnClick="{concat($pages:searchLocationHandling, '&amp;MODE=START','&amp;Auth_Enabled=true')}"/>
                        </perm:is-allowed>
                        <perm:is-allowed document="TASKS" action="bcmManageStorage">
                            <PAD_ITEM DisplayText="Storage" OnClick="{concat($pages:searchLocationStorage, '&amp;MODE=START','&amp;Auth_Enabled=true')}"/>
                        </perm:is-allowed>
                                        </PAD_ITEM>
                    -->
					<perm:is-allowed document="TASKS" action="bcmManageOrganizationMaster">
						<PAD_ITEM OnClick="{concat($pages:manage_organizations, '&amp;MODE=START','&amp;Auth_Enabled=true')}" DisplayText="Organizations"/>
					</perm:is-allowed>
					<perm:is-allowed document="TASKS" action="bcmManageLocation">
						<PAD_ITEM OnClick="{concat( $pages:searchLocation , '&amp;MODE=START','&amp;Auth_Enabled=true') }" DisplayText="Locations"/>
					</perm:is-allowed>
					<!--EQ:569003-->
					<perm:is-allowed document="TASKS" action="bcmManageOrgLocRelation">
						<PAD_ITEM OnClick="{concat( $pages:manage_orgLocRelations , '&amp;MODE=START','&amp;Auth_Enabled=true') }" DisplayText="OrgLocationRelation"/>
					</perm:is-allowed>
					<!--EQ:569003-->
					<perm:is-allowed document="TASKS" action="bcmManageHandling">
						<PAD_ITEM DisplayText="Handling" OnClick="{concat($pages:searchLocationHandling, '&amp;MODE=START','&amp;Auth_Enabled=true')}"/>
					</perm:is-allowed>
					<perm:is-allowed document="TASKS" action="bcmManageStorage">
						<PAD_ITEM DisplayText="Storage" OnClick="{concat($pages:searchLocationStorage, '&amp;MODE=START','&amp;Auth_Enabled=true')}"/>
					</perm:is-allowed>
					<perm:is-allowed document="TASKS" action="bcmManageItemLocation">
						<PAD_ITEM OnClick="{concat($pages:bufferSearchView,'&amp;MODE=START','&amp;Auth_Enabled=true')}" DisplayText="ItemLocation"/>
					</perm:is-allowed>
					<perm:is-allowed document="TASKS" action="bcmManageBufferClass">
						<PAD_ITEM OnClick="{concat($pages:buffer_class_search,'&amp;MODE=START','&amp;Auth_Enabled=true')}" DisplayText="BufferClass"/>
					</perm:is-allowed>
					<perm:is-allowed document="TASKS" action="bcmManageItemLocationGroup">
						<PAD_ITEM OnClick="{concat($pages:item_location_group_search,'&amp;MODE=START','&amp;Auth_Enabled=true')}" DisplayText="ItemLocationGroup"/>
					</perm:is-allowed>
					<perm:is-allowed document="TASKS" action="bcmManageItemClass">
						<PAD_ITEM OnClick="{concat($pages:item_class_search,'&amp;MODE=START','&amp;Auth_Enabled=true')}" DisplayText="ItemClass"/>
					</perm:is-allowed>
					<perm:is-allowed document="TASKS" action="bcmManageItemGroup">
						<PAD_ITEM OnClick="{concat($pages:item_group_search,'&amp;MODE=START','&amp;Auth_Enabled=true')}" DisplayText="ItemGroup"/>
					</perm:is-allowed>
					<perm:is-allowed document="TASKS" action="bcmManageResource">
						<PAD_ITEM DisplayText="Resources" OnClick="{$pages:search_resource_leftnav}"/>
					</perm:is-allowed>
				</PAD_ITEM>
			</perm:is-allowed>
            <!--Data Quality-->
            <perm:is-allowed document="TASKS" action="bcmManageDataQuality">
            <PAD_ITEM DisplayText="Data Quality" >
                <PAD_ITEM OnClick="{$pages:DataProfiling}" DisplayText="Data Profiling"/>
                <PAD_ITEM OnClick="{$pages:DataQuality}" DisplayText="Data Quality Report"/>
            </PAD_ITEM>
            </perm:is-allowed>
            <!-- MetaData Management -->
            <perm:is-allowed document="TASKS" action="bcmManageMetaData">
            <PAD_ITEM DisplayText="Metadata Management">
                <PAD_ITEM OnClick="{$pages:SearchMetaData}" DisplayText="Search Metadata"/>
            </PAD_ITEM>
            </perm:is-allowed>
            
            
	<!--PAD_ITEM DisplayText="Test Workflow" OnClick="{$pages:ManagetestWf}"/-->
	
			<!-- GPM Administration -->
			<perm:is-allowed document="TASKS" action="bcmManageCodeMaster">
				<PAD_ITEM DisplayText="Group Parameter Mgmt">
					<PAD_ITEM OnClick="{concat($pages:ManageAttriSets,'&amp;Auth_Enabled=true')}" DisplayText="Manage Attribute Sets"/>
					<PAD_ITEM OnClick="{concat($pages:ManageGrpCls,'&amp;Auth_Enabled=true')}" DisplayText="Manage Group Class"/>
					<PAD_ITEM OnClick="{concat($pages:ManageGroup,'&amp;Auth_Enabled=true')}" DisplayText="Manage Groups"/>
				</PAD_ITEM>
			</perm:is-allowed>
			
		
	
			<!-- GPM Administration -->
			<!-- Manufacturing Models -->
			<perm:is-allowed document="TASKS" action="bcmManufacturingModel">
