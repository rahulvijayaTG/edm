<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:bcm="http://www.i2.com/bcm" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:identity="http://www.i2.com/identity" xmlns:i18n="http://www.i2.com/i18n" description="_">
	<!-- **********************************************************************
  *********************************************************************** -->
	<x2:command public="yes" description="_" name="init">
		<xapl:variable name="currentService" resolver="session" global="true"/>
	</x2:command>
	<!--  **********************************************************************
  *********************************************************************** -->
	<x2:command public="yes" description="_" name="getLinks">
		<x2:param name="selectedActivity" select="$this/ACTIVITY/@Value"/>
		<!--<xapl:print>
                      anish kumar::::
         selectedActivity::::<xapl:value-of select="$selectedActivity"/>
        </xapl:print>-->
		<!-- create pad-->
		<xapl:variable name="pad">
			<PAD Name="tasks" DisplayText="Tasks" Scrollable="yes">
				<xapl:choose>
					<xapl:when test="($selectedActivity = 'bcmDataManagement') or ($selectedActivity = 'bcmReferenceStaging')">
						<x2:execute command="core.navigation.functions:getReferencePadItem">
							<x2:with-param name="selectedActivity" select="$selectedActivity"/>
						</x2:execute>
						<!-- set this service session variable  for used as flag for calling serive related API -->
						<xapl:set-variable name="currentService">
							<xapl:value-of select="'BCMMasterService'"/>
						</xapl:set-variable>
					</xapl:when>
					<xapl:when test="($selectedActivity = 'bcmInputStaging')">
						<!-- load the document access control list for user -->
						<!--x2:execute command="bcm.framework.authorization.auth_controller:loadUserDocAccessControlList"/-->
						<x2:execute command="core.navigation.functions:getInboundPadItem">
							<x2:with-param name="selectedActivity" select="$selectedActivity"/>
						</x2:execute>
						<!-- set this service session variable  for used as flag for calling serive related API -->
						<xapl:set-variable name="currentService">
							<xapl:value-of select="'BCMINService'"/>
						</xapl:set-variable>
					</xapl:when>
					<xapl:when test="$selectedActivity = 'bcmOutputStaging'">
						<!-- load the document access control list for user -->
						<xapl:if test="$showOutputStaging='yes'">
							<!--x2:execute command="bcm.framework.authorization.auth_controller:loadUserDocAccessControlList"/-->
							<x2:execute command="core.navigation.functions:getOutBoundPadItem">
								<x2:with-param name="selectedActivity" select="$selectedActivity"/>
							</x2:execute>
							<!-- set this service session variable  for used as flag for calling serive related API -->
							<xapl:set-variable name="currentService">
								<xapl:value-of select="'BCMOutboundService'"/>
							</xapl:set-variable>
						</xapl:if>
					</xapl:when>
					<xapl:when test="$selectedActivity = 'bcmADWTableView'">
						<x2:execute command="core.navigation.functions:getADWPadItem">
							<x2:with-param name="selectedActivity" select="$selectedActivity"/>
						</x2:execute>
						<!-- set this service session variable  for used as flag for calling serive related API -->
						<xapl:set-variable name="currentService">
							<xapl:value-of select="'ADWService'"/>
						</xapl:set-variable>
					</xapl:when>
				</xapl:choose>
			</PAD>
		</xapl:variable>
		<xapl:print select="$pad"/>
		<xapl:return>
			<xapl:if test="count($pad/PAD_ITEM)  >0">
				<xapl:value-of select="$pad"/>
			</xapl:if>
		</xapl:return>
	</x2:command>
	<!-- get the Extension PAD ITEMS (for i2 Studio)-->
	<x2:command public="yes" description="_" name="getStudioExtensions">
		<x2:param name="selectedActivity" select="$this/ACTIVITY/@Value"/>
		<xapl:variable name="studioNavigation">
			<xcore:execute-method name="//UIWorkflowService/getNavigation" entireResponse="false">
				<user_id Value="{identity-user-id()}"/>
				<user_name Value="{identity-username()}"/>
			</xcore:execute-method>
		</xapl:variable>
		<xapl:return>
			<xapl:if test="count($pad/PAD_ITEM) >0">
				<xapl:value-of select="$pad"/>
			</xapl:if>
			<xapl:value-of select="$studioNavigation/*"/>
		</xapl:return>
	</x2:command>
	<!-- **********************************************************************
  *********************************************************************** -->
	<x2:command public="yes" description="_" name="getReferencePadItem">
		<x2:param name="selectedActivity" select="$this/ACTIVITY/@Value"/>
		<!-- create pad items -->
		<xapl:variable name="pad">
			<!-- table editors -->
			<perm:is-allowed document="TASKS" action="bcmTableEdit">
				<xapl:choose>
					<xapl:when test="$firstTimeLoad='yes'">
						<PAD_ITEM OnClick="{concat($pages:reference_staging,'&amp;Auth_Enabled=true')}" Target="_top" DisplayText="View Tables" Selected="{$selectedActivity = 'bcmReferenceStaging'}"/>
						<xapl:set-variable name="firstTimeLoad" select="'no'"/>
					</xapl:when>
					<xapl:otherwise>
						<!-- load the document access control list for user -->
						<xapl:choose>
							<xapl:when test="$loadedAccess = 'yes'"/>
							<xapl:otherwise>
								<x2:execute command="bcm.framework.authorization.auth_controller:loadUserDocAccessControlList"/>
							</xapl:otherwise>
						</xapl:choose>
						<perm:is-allowed document="TASKS" action="bcmViewTables">
							<PAD_ITEM DisplayText="View Tables">
								<perm:is-allowed document="INSTANCES" action="bcmReferenceTableEdits">
									<x2:execute command="bcm.framework.authorization.auth_controller:setAccessibleDocumentList">
										<x2:with-param name="foldersDoc" select="{$masterFolders}"/>
										<x2:with-param name="serviceName" select="'BCMMasterService'"/>
									</x2:execute>
									<PAD_ITEM DisplayText="Master Tables">
										<SERVICE Name="BCMMasterService">
											<xapl:value-of select="$userAccessibleDocuments/SERVICE[@Name = 'BCMMasterService']/*"/>
										</SERVICE>
									</PAD_ITEM>
								</perm:is-allowed>
								<perm:is-allowed document="TASKS" action="bcmAuditTrailMasterTableEdit">
                                    <PAD_ITEM DisplayText="Data Audit">
                                        <x2:execute command="bcm.framework.authorization.auth_controller:setAccessibleDocumentList">
                                          <x2:with-param name="foldersDoc" select="{$masterAuditTrailFolders}"/>
                                          <x2:with-param name="serviceName" select="'BCMMasterService'"/>
                                          <x2:with-param name="isAuditTrail" select="'yes'"/>
                                        </x2:execute>
                                        <PAD_ITEM OnClick="{$pages:DataAuditReport}" DisplayText="Data Audit Report"/>
                                        <PAD_ITEM OnClick="{$pages:DataTraceability}" DisplayText="Data Traceability"/>
                                        <PAD_ITEM DisplayText="Audit Trail Tables">
                                          <SERVICE Name="BCMMasterService">
                                            <xapl:value-of select="$userAccessibleAuditTrailDocuments/SERVICE[@Name = 'BCMMasterService']/*"/>
                                          </SERVICE>
                                        </PAD_ITEM>
                                    </PAD_ITEM>
								</perm:is-allowed>
							</PAD_ITEM>
						</perm:is-allowed>
					</xapl:otherwise>
				</xapl:choose>
			</perm:is-allowed>
			<!-- Table Editors -->
			<!-- system configuration (Code master)-->
			<perm:is-allowed document="TASKS" action="bcmManageCodeMaster">
				<PAD_ITEM DisplayText="Code Master">
					<PAD_ITEM OnClick="{concat($pages:editable_code_master,'&amp;Auth_Enabled=true')}" DisplayText="Manage Code Master"/>
				</PAD_ITEM>
			</perm:is-allowed>
			<!-- system configuration (Code master)-->
			<!-- Enterprise Model -->
			<perm:is-allowed document="TASKS" action="bcmManageEnterprise">
				<PAD_ITEM DisplayText="Enterprise Model">
					<perm:is-allowed document="TASKS" action="bcmManageRoles">
						<PAD_ITEM OnClick="{concat($pages:user_role_search,'&amp;MODE=START','&amp;Auth_Enabled=true')}" DisplayText="Manage Roles"/>
					</perm:is-allowed>
					<perm:is-allowed document="TASKS" action="bcmManageUsers">
						<PAD_ITEM OnClick="{concat($pages:user_search_view,'&amp;MODE=START','&amp;Auth_Enabled=true')}" DisplayText="Manage Users"/>
					</perm:is-allowed>
					<perm:is-allowed document="TASKS" action="bcmManageUserGroups">
