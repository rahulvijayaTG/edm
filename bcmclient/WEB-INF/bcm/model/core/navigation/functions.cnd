					<PAD_ITEM OnClick="{concat($pages:PIPORelationsSrch,'&amp;MODE=START','&amp;Auth_Enabled=true')}" DisplayText="PIPO"/>
				</PAD_ITEM>
			</perm:is-allowed>
			<!-- PIPO-->
			<!--EQ:582045  scenario -->
			<!--Eq:586551 uncommenting the scenario management link for 6.2.4 -->
			<perm:is-allowed document="TASKS" action="invOptEditScenarios">
