			</perm:is-allowed>
			<!-- Calendar Model  -->
			<!-- Authorization Security -->
			<xapl:if test="$securityCheck ='yes'">
				<perm:is-allowed document="TASKS" action="bcmManageAuthSecurity">
					<PAD_ITEM OnClick="{concat($pages:manage_security,'&amp;Auth_Enabled=true')}" DisplayText="Manage Security"/>
				</perm:is-allowed>
			</xapl:if>
			<!-- Authorization Security -->
			<!-- Manage Query -->
			<perm:is-allowed document="TASKS" action="bcmManageQuery">
				<PAD_ITEM OnClick="{concat($pages:manageQuery,'&amp;Auth_Enabled=true','&amp;MODE=START')}" DisplayText="Manage Query"/>
			</perm:is-allowed>
			<!-- Manage Query -->
			<!-- Data Validation Summary -->
			<perm:is-allowed document="TASKS" action="bcmDataValidation">
				<PAD_ITEM OnClick="{concat($pages:dataValidationSummary,'?Auth_Enabled=false','&amp;MODE=START')}" DisplayText="Data Validation Errors"/>
			</perm:is-allowed>
			<!-- Data Validation Summary -->
			<!-- Entity State View -->
			<perm:is-allowed document="TASKS" action="bcmReportEntityStateView">
				<PAD_ITEM OnClick="{concat($pages:bcm_home,'?Auth_Enabled=true')}" DisplayText="Reports">
					<PAD_ITEM OnClick="{concat($pages:bcm_home,'?Auth_Enabled=true')}" DisplayText="Entity State View"/>
				</PAD_ITEM>
			</perm:is-allowed>
			<!-- Added by Satish : Dummy PGL-based added for co-located mode support. Should not be in the installer -->
			<perm:is-allowed document="TASKS" action="bcmTestColocatedPGL">
				<PAD_ITEM OnClick="{$pages:TestWorkflow}" DisplayText="Test Workflow"/>
			</perm:is-allowed>
			<!-- get the Extension PAD ITEMS (from inv opt)-->
			<x2:execute command="core.navigation.functions:getPadItemExtension">
				<x2:with-param name="selectedActivity" select="$selectedActivity"/>
			</x2:execute>
			<!-- get the Extension PAD ITEMS (for retail)-->
			<x2:execute command="core.navigation.functions:getRetailPadItemExtension">
				<x2:with-param name="selectedActivity" select="$selectedActivity"/>
			</x2:execute>
			<x2:execute command="core.navigation.functions:getdmPadItemExtension">
				<x2:with-param name="selectedActivity" select="$selectedActivity"/>
			</x2:execute>
			<x2:execute command="core.navigation.functions:getStudioExtensions">
				<x2:with-param name="selectedActivity" select="$selectedActivity"/>
			</x2:execute>
			<perm:is-allowed document="TASKS" action="businessRules">
				<PAD_ITEM OnClick="{$pages:BusinessRules}" DisplayText="Business Rules"/>
			</perm:is-allowed>
			<perm:is-allowed document="UPLOAD_KIT" action="excelUpload">
				<PAD_ITEM DisplayText="Upload Documents">
					<PAD_ITEM OnClick="{$pages:upload_transaction_templates}" DisplayText="Upload Documents"/>
					<PAD_ITEM OnClick="{$pages:upload_reports}" DisplayText="View Reports"/>
				</PAD_ITEM>
			</perm:is-allowed>
		</xapl:variable>
		<xapl:print select="$pad"/>
		<xapl:return>
			<xapl:if test="count($pad/PAD_ITEM)  >0">
				<xapl:value-of select="$pad"/>
			</xapl:if>
		</xapl:return>
	</x2:command>
	<!-- **********************************************************************
  *********************************************************************** -->
	<x2:command public="yes" description="_" name="getInboundPadItem">
		<x2:param name="selectedActivity" select="$this/ACTIVITY/@Value"/>
		<!-- create pad items -->
		<xapl:choose>
			<xapl:when test="$loadedAccess = 'yes'"/>
			<xapl:otherwise>
				<x2:execute command="bcm.framework.authorization.auth_controller:loadUserDocAccessControlList"/>
			</xapl:otherwise>
		</xapl:choose>
		<xapl:variable name="perminputtables"/>
		<xapl:variable name="permnetchange"/>
		<xapl:variable name="permerrortables"/>
		<xapl:variable name="pad">
			<!-- table editors -->
			<perm:is-allowed document="TASKS" action="bcmTableEdit">
				<x2:execute command="bcm.framework.authorization.auth_controller:setAccessibleDocumentList">
					<x2:with-param name="foldersDoc" select="{$inputFolders}"/>
					<x2:with-param name="serviceName" select="'BCMINService'"/>
				</x2:execute>
				<perm:is-allowed document="INSTANCES" action="bcmInboundTableEdits">
					<perm:is-allowed document="TASKS" action="bcmManageInputTables">
						<xapl:set-variable name="perminputtables">
							<xapl:value-of select="'yes'"/>
						</xapl:set-variable>
					</perm:is-allowed>
					<perm:is-allowed document="TASKS" action="bcmManageNCTables">
						<xapl:set-variable name="permnetchange">
							<xapl:value-of select="'yes'"/>
						</xapl:set-variable>
					</perm:is-allowed>
					<perm:is-allowed document="TASKS" action="bcmManageErrorTables">
						<xapl:set-variable name="permerrortables">
							<xapl:value-of select="'yes'"/>
						</xapl:set-variable>
					</perm:is-allowed>
					<docutil:remove select="{$userAccessibleDocuments/SERVICE[@Name = 'BCMINService']/ALL_FOLDERS/FOLDER/DOCUMENTS/DOCUMENT[@AuditTrail='true']}"/>
					<docutil:remove select="{$userAccessibleDocuments/SERVICE[@Name = 'BCMINService']/ALL_FOLDERS/FOLDER[@Name ='Plan']}"/>
					<xapl:if test="$perminputtables='yes' or $permnetchange='yes' or $permerrortables='yes'">
						<PAD_ITEM DisplayText="View Tables">
							<xapl:if test="$perminputtables='yes'">
								<PAD_ITEM DisplayText="Inbound Staging Tables">
									<SERVICE Name="BCMINService">
										<xapl:value-of select="$userAccessibleDocuments/SERVICE[@Name = 'BCMINService']/*"/>
									</SERVICE>
								</PAD_ITEM>
							</xapl:if>
							<!-- Net Change Tables -->
							<xapl:if test="$permnetchange='yes'">
								<x2:execute command="bcm.framework.authorization.auth_controller:setAccessibleDocumentList">
									<x2:with-param name="foldersDoc" select="{$ncFolders}"/>
									<x2:with-param name="serviceName" select="'BCMNCService'"/>
								</x2:execute>
								<PAD_ITEM DisplayText="Net Change Tables">
									<SERVICE Name="BCMNCService">
										<xapl:value-of select="$userAccessibleDocuments/SERVICE[@Name = 'BCMNCService']/*"/>
									</SERVICE>
								</PAD_ITEM>
							</xapl:if>
							<xapl:if test="$permerrortables='yes'">
								<x2:execute command="bcm.framework.authorization.auth_controller:setAccessibleDocumentList">
									<x2:with-param name="foldersDoc" select="{$errorFolders}"/>
									<x2:with-param name="serviceName" select="'BCMINService'"/>
									<x2:with-param name="isError" select="'yes'"/>
								</x2:execute>
								<docutil:remove select="{$userAccessibleErrorDocuments/SERVICE[@Name = 'BCMINService']/ALL_FOLDERS/FOLDER[@Name ='Plan']}"/>
								<PAD_ITEM DisplayText="Error Tables">
									<SERVICE Name="BCMINService">
										<xapl:value-of select="$userAccessibleErrorDocuments/SERVICE[@Name = 'BCMINService']/*"/>
									</SERVICE>
								</PAD_ITEM>
							</xapl:if>
						</PAD_ITEM>
					</xapl:if>
				</perm:is-allowed>
			</perm:is-allowed>
			<!-- Data Load Workflow -->
			<perm:is-allowed document="TASKS" action="bcmExecuteDataLoadWorkflow">
				<PAD_ITEM OnClick="{concat($pages:controlPanel,'&amp;Auth_Enabled=true&amp;MODE=START')}" DisplayText="Data Load Workflow"/>
			</perm:is-allowed>
			<!-- Data Errors -->
			<!--
                        perm:is-allowed document="TASKS" action="bcmManageDataErrors">
                                <PAD_ITEM OnClick="{concat($pages:all_documents,'?Auth_Enabled=true')}" DisplayText="Data Errors"/>
                        </perm:is-allowed
                        -->
			<perm:is-allowed document="TASKS" action="bcmManageDataErrors">
				<PAD_ITEM OnClick="{concat($pages:errorSummary,'&amp;Auth_Enabled=true&amp;MODE=START')}" DisplayText="Data Load Error Report"/>
			</perm:is-allowed>
		</xapl:variable>
		<xapl:print select="$pad"/>
		<xapl:return>
			<xapl:if test="count($pad/PAD_ITEM)  >0">
				<xapl:value-of select="$pad"/>
			</xapl:if>
		</xapl:return>
	</x2:command>
	<!-- **********************************************************************
  *********************************************************************** -->
	<x2:command public="yes" description="_" name="getOutBoundPadItem">
		<x2:param name="selectedActivity" select="$this/ACTIVITY/@Value"/>
		<xapl:choose>
			<xapl:when test="$loadedAccess = 'yes'"/>
			<xapl:otherwise>
				<x2:execute command="bcm.framework.authorization.auth_controller:loadUserDocAccessControlList"/>
			</xapl:otherwise>
		</xapl:choose>
		<!-- create pad items -->
		<xapl:variable name="pad">
			<!-- table editors -->
			<perm:is-allowed document="TASKS" action="bcmTableEdit">
				<PAD_ITEM DisplayText="View Tables">
					<perm:is-allowed document="INSTANCES" action="bcmOutboundTableView">
						<x2:execute command="bcm.framework.authorization.auth_controller:setAccessibleDocumentList">
							<x2:with-param name="foldersDoc" select="{$outboundFolders}"/>
							<x2:with-param name="serviceName" select="'BCMOutboundService'"/>
						</x2:execute>
						<docutil:remove select="{$userAccessibleDocuments/SERVICE[@Name = 'BCMOutboundService']/ALL_FOLDERS/FOLDER/DOCUMENTS/DOCUMENT[@AuditTrail='true']}"/>
						<PAD_ITEM DisplayText="Outbound Staging Tables">
							<SERVICE Name="BCMOutboundService">
								<xapl:value-of select="$userAccessibleDocuments/SERVICE[@Name = 'BCMOutboundService']/*"/>
							</SERVICE>
						</PAD_ITEM>
					</perm:is-allowed>
				</PAD_ITEM>
			</perm:is-allowed>
			<!-- Synchronize Data -->
			<perm:is-allowed document="TASKS" action="bcmConductSynchronization">
				<PAD_ITEM OnClick="{concat($pages:outboundStagingRefreshPage,'?Auth_Enabled=true')}" DisplayText="Synchronize Data"/>
			</perm:is-allowed>
		</xapl:variable>
		<xapl:print select="$pad"/>
		<xapl:return>
			<xapl:if test="count($pad/PAD_ITEM)  >0">
				<xapl:value-of select="$pad"/>
			</xapl:if>
		</xapl:return>
	</x2:command>
	<!-- **********************************************************************
  *********************************************************************** -->
	<x2:command public="yes" description="_" name="getADWPadItem">
		<x2:param name="selectedActivity" select="$this/ACTIVITY/@Value"/>
		<!-- create pad items -->
		<xapl:variable name="pad">
			<!-- table editors -->
			<perm:is-allowed document="TASKS" action="bcmTableEdit">
				<PAD_ITEM DisplayText="View Tables">
					<perm:is-allowed document="INSTANCES" action="bcmADWTableView">
						<PAD_ITEM DisplayText="ADW Tables">
							<SERVICE Name="ADWService">
								<xapl:value-of select="$adwFolders"/>
							</SERVICE>
						</PAD_ITEM>
					</perm:is-allowed>
				</PAD_ITEM>
			</perm:is-allowed>
			<!-- Plan Work Order -->
			<perm:is-allowed document="TASKS" action="bcmADWPlanWorkOrder">
				<PAD_ITEM OnClick="{concat($pages:planworkordersearch, '&amp;MODE=START','&amp;Auth_Enabled=true')}" DisplayText="Plan Work Order"/>
			</perm:is-allowed>
		</xapl:variable>
		<xapl:print select="$pad"/>
		<xapl:return>
			<xapl:if test="count($pad)  >0">
				<xapl:value-of select="$pad"/>
			</xapl:if>
		</xapl:return>
	</x2:command>
	<!-- **********************************************************************
  *********************************************************************** -->
	<x2:command public="yes" description="_" name="getPadItemExtension">
		<x2:param name="selectedActivity" select="$this/ACTIVITY/@Value"/>
		<!-- left bank so that others/invopt etc can define it -->
	</x2:command>
	<!-- **********************************************************************
  *********************************************************************** -->
	<x2:command public="yes" description="_" name="getRetailPadItemExtension">
		<x2:param name="selectedActivity" select="$this/ACTIVITY/@Value"/>
		<!-- left bank so that others/invopt etc can define it -->
	</x2:command>
	<!-- **********************************************************************
  *********************************************************************** -->
	<!--  **********************************************************************
    *********************************************************************** -->
	<x2:command public="yes" description="_" name="getdmPadItemExtension">
	  <x2:param name="selectedActivity" select="$this/ACTIVITY/@Value"/>
	    <xapl:variable name="dm-pad">
	       <perm:is-allowed document="TASKS" action="bcmManageDMMeta">
		  <PAD_ITEM DisplayText="Manage DM Metadata">
			<perm:is-allowed document="TASKS" action="bcmMemMaintenance">
			   <PAD_ITEM OnClick="{$pages:MemberWf}" DisplayText="Member Maintenance"/>
			</perm:is-allowed>
			<perm:is-allowed document="TASKS" action="bcmMeasureMaintenance">
			    <PAD_ITEM OnClick="{$pages:MeasureWf}" DisplayText="Measure Maintenance"/>
			</perm:is-allowed>
			<perm:is-allowed document="TASKS" action="bcmMapSetMaintenance">
			    <PAD_ITEM OnClick="{$pages:MapsetWf}" DisplayText="Mapset Maintenance"/>
			</perm:is-allowed>
		  </PAD_ITEM>
		</perm:is-allowed>
	    </xapl:variable>
	    <!--xapl:print select="$dm-pad"/>
	    <xapl:print select="count($dm-pad/*)"/-->

	    <xapl:return>
		<xapl:if test="count($dm-pad/*)  >0">
		    <xapl:value-of select="$dm-pad"/>
		</xapl:if>
    	   </xapl:return>
	</x2:command>
</x2:commands>
