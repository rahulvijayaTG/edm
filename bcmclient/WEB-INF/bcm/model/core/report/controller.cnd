<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:report="http://www.i2.com/report" description="_">
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="-" name="generate">
    <xapl:param name="pReportFormat"/>
    <xapl:param name="pReportData"/>
    <xapl:param name="this"/>


   <xapl:if test="$pReportFormat/@Configurable = 'true'">
     <xapl:set-variable name="pReportFormat">        
      <x2:execute command="core.report.controller:configure">
        <x2:with-param name="pReportFormat" select="$pReportFormat"/>
      </x2:execute>  
     </xapl:set-variable>
   </xapl:if>
  
    <!-- TODO Do this dynamically only if timingStats are on. -->
    <xapl:variable name="reportData">
    <ROOT>
      <xapl:value-of select="$pReportData"/>
    </ROOT>
    </xapl:variable>

    <docutil:remove select="$reportData/TIMING_STATS"/>
    <docutil:remove select="$reportData/REQUEST"/>
    <docutil:remove select="$reportData/_RESULT"/>
    <docutil:remove select="$reportData/SERVER_TIMEZONE"/>
    <docutil:remove select="$reportData/SERVER_TIMEZONE_SHORT"/>
    <docutil:remove select="$reportData/*/SERVER_TIMEZONE"/>
    <docutil:remove select="$reportData/*/SERVER_TIMEZONE_SHORT"/>

    <xapl:return>
      <report:generate format="{$pReportFormat}" data="{$reportData/*}" param="{$this}"/>
    </xapl:return>
      
   </x2:command>

  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="generate_csv">
     <x2:param name="pReportFormat"/>
     <x2:param name="pReportData"/>
     <!-- Table -->
     <xapl:variable name="csvTable">
       <RESULT Value=""/>
     </xapl:variable>
     <!-- Table Header -->
     <xapl:variable name="tableHeader">
       <RESULT Value=""/>
     </xapl:variable>
     <!-- Issue 539192 -->
     <xapl:print>***********Checking Column Header*******************</xapl:print>
         <xapl:for-each varName="col" select="$pReportFormat/FIELDS/FIELD[string-length(@Type) = 0 or @Type !='Hidden']">
                 <!-- Get i18n col header -->
                 <xapl:variable name="colHeader">
                     <i18n:text>
                         <xapl:value-of select="$col/@DisplayText"/>
                     </i18n:text>
                 </xapl:variable>
                 <docutil:set select="$col/@DisplayText">
              <xapl:value-of select="$colHeader"/>
                 </docutil:set>
         </xapl:for-each>
     <!-- Issue 539192 -->
     <!-- EXPORT TO EXCEL PSR START-->
     <docutil:remove select="$pReportFormat/FIELDS/FIELD[string-length(@Type) != 0 and @Type ='Hidden']"/>
     <docutil:remove select="$pReportFormat/FIELDS/FIELD[string-length(@Hidden) != 0 and @Hidden ='yes']"/>
     <docutil:remove select="$pReportFormat/FIELDS/FIELD[string-length(@DisplayType) != 0 and @DisplayType ='Hidden']"/>
     <docutil:remove select="$pReportData/*[name() = 'TOTAL_RECORD_COUNT' or name() = 'START_AT_ROW']"/>

<!-- <xapl:print> EXPTEST<xapl:value-of select="$pReportFormat"/></xapl:print>
<xapl:print> EXPTEST1<xapl:value-of select="$pReportData"/></xapl:print>
 <xapl:print>EXPTEST2<xapl:value-of select="$currentPref"/></xapl:print>
 -->
 <xapl:variable name="selectedColumns">
  <REPORT>
    <FIELDS>
      <xapl:choose>
        <xapl:when test="string-length($currentPref/SERVICE/FORM/@Name) > 0 and count($currentPref/SERVICE/FORM/DISPLAY_CUST/FIELD) > 0"> <!-- this is query form -->
         <xapl:for-each varName="selectedField" select="$currentPref/SERVICE/FORM/DISPLAY_CUST/FIELD">
          <xapl:value-of select="$pReportFormat/FIELDS/FIELD[@Name = concat($selectedField/@Document,'.', $selectedField/@Name)]"/>        
         </xapl:for-each>
        </xapl:when>        
        <xapl:when test="string-length($currentPref/SERVICE/TABLE/@Name) > 0 and count($currentPref/SERVICE/TABLE/DISPLAY_CUST/FIELD) > 0"> <!-- this is TE -->
          <xapl:for-each varName="selectedField" select="$currentPref/SERVICE/TABLE/DISPLAY_CUST/FIELD">
            <xapl:value-of select="$pReportFormat/FIELDS/FIELD[@Name = $selectedField/@Name]"/>             
          </xapl:for-each>
        </xapl:when>
        <xapl:otherwise>
          <xapl:value-of select="$pReportFormat/FIELDS/FIELD"/>
        </xapl:otherwise>
      </xapl:choose>        
     </FIELDS>
   </REPORT>
 </xapl:variable>
 
 <!-- <xapl:print>EXPTEST3<xapl:value-of select="$selectedColumns"/></xapl:print> -->
     <xapl:return>
        <ROOT> 
       <xapl:value-of select="$selectedColumns"/>
       <xapl:value-of select="$pReportData"/>
       </ROOT>
     </xapl:return>
     <!-- EXPORT TO EXCEL PSR END-->
   </x2:command>

  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHiddenFields">
    <xapl:return>
      <FIELD Type="Hidden" Name="DIRECTORY" Value="{$this/DIRECTORY[position() = 1]/@Value}"/>
      <FIELD Type="Hidden" Name="FILE" Value="{$this/FILE[position() = 1]/@Value}"/>
      <FIELD Type="Hidden" Name="PAGE" Value="{$this/PAGE[position() = 1]/@Value}"/>
      <FIELD Name="SORT_BY" Type="Hidden" Value="{$this/SORT_BY[position() = 1]/@Value}"/>
      <!-- DOC_TYPE will go -->
      <FIELD Name="DOC_TYPE" Type="Hidden" Value="{$this/DOC_TYPE[position() = 1]/@Value}"/>
      <FIELD Name="OBJECT_TYPE" Type="Hidden" Value="{$this/OBJECT_TYPE[position() = 1]/@Value}"/>
      <FIELD Type="Hidden" Name="JSCRIPT" Value="{$this/JSCRIPT[position() = 1]/@Value}" Visibility="Simple"/>
      <FIELD Type="Hidden" Name="SHOW_HEADER" Value="{$this/SHOW_HEADER[position() = 1]/@Value}" Visibility="Simple"/>
      <FIELD Name="SORT_ORDER" Type="Hidden" Value="{$this/SORT_ORDER[position() = 1]/@Value}"/>
      <FIELD Type="Hidden" Name="RET_PAGE" Value="{$this/RET_PAGE[position() = 1]/@Value}" Visibility="Simple"/>
      <FIELD Type="Hidden" Name="DO_SEARCH" Value="{$this/DO_SEARCH/@Value}" Visibility="Simple"/>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHiddenFields_saveReport">
    <xapl:return/>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="saveReport">
    <x2:param name="directory" select="$this/DIRECTORY/@Value"/>
    <x2:param name="file" select="$this/FILE/@Value"/>
    <x2:param name="pFormat" select="'csv'"/>
    <xapl:variable name="getSearchFormConfig">
      <xapl:value-of select="concat($directory,'.', $file,':getSearchFormConfig')"/>
    </xapl:variable>
    <xapl:variable name="getSearchReportConfig">
      <xapl:value-of select="concat($directory,'.', $file,':getSearchReportConfig')"/>
    </xapl:variable>
    <xapl:variable name="getReportData">
      <xapl:value-of select="concat($directory,'.', $file,':getReportData')"/>
    </xapl:variable>
    <xapl:variable name="fileName" select="concat($file, '.', $pFormat)"/>
    <!-- Get Form Config-->
    <xapl:variable name="form">
      <x2:execute command="{$getSearchFormConfig}">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
    </xapl:variable>
    <!-- Get Report Config -->
    <xapl:variable name="reportFormat">
      <x2:execute command="{$getSearchReportConfig}">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
    </xapl:variable>
    <!-- Get Report Data -->
    <docutil:set select="$this/DO_SEARCH/@Value">No</docutil:set>
    <xapl:variable name="reportData">
      <x2:execute command="{$getReportData}">
        <x2:with-param name="pIds">
          <IDS>
            <xapl:value-of select="{$this/ID}"/>
          </IDS>
        </x2:with-param>
        <x2:with-param name="pForm" select="$form"/>
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
    </xapl:variable>
    <!-- get Actual Report-->
    <xapl:variable name="report">
      <xapl:choose>
        <xapl:when test="$pFormat = 'csv'">
          <x2:execute command="core.report.controller:generate_csv">
            <x2:with-param name="pReportData" select="$reportData"/>
            <x2:with-param name="pReportFormat" select="$reportFormat"/>
          </x2:execute>
        </xapl:when>
        <xapl:when test="$pFormat = 'xml'">
          <xapl:value-of select="$reportData"/>
        </xapl:when>
      </xapl:choose>
    </xapl:variable>
    <!-- downloadFile-->
    <x2:execute command="bcm.framework.common:downloadFile">
      <x2:with-param name="pFileContents" select="$report"/>
      <x2:with-param name="pFileName" select="$fileName"/>
      <x2:with-param name="pFileType" select="'text'"/>
    </x2:execute>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="downloadDocument">
    <x2:param name="pFile" select="$this/FILE/@Value"/>
    <x2:param name="pDataSourceName" select="$this/DATA_SOURCE_NAME/@Value"/>
    <x2:param name="pDataRootName" select="concat($this/OBJECT_TYPE/@Value, 'S')"/>
    <x2:param name="pIdFilterName" select="$this/ID_FILTER_NAME/@Value"/>
    <xapl:variable name="fileName" select="concat($pFile, '.', 'xml')"/>
    <!-- Get the data -->
    <xapl:variable name="data">
      <docutil:element name="{$pDataRootName}">
        <xapl:for-each varName="id" select="{$this/ID}">
          <xcore:execute-method name="{$pDataSourceName}">
            <docutil:element name="{$pIdFilterName}" Value="{$id/@Value}"/>
          </xcore:execute-method>
        </xapl:for-each>
      </docutil:element>
    </xapl:variable>
    <!-- downloadFile-->
    <x2:execute command="bcm.framework.common:downloadFile">
      <x2:with-param name="pFileContents" select="$data"/>
      <x2:with-param name="pFileName" select="$fileName"/>
      <x2:with-param name="pFileType" select="'xml'"/>
    </x2:execute>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="i18nize">
    <x2:param name="pData"/>
    <x2:param name="pType"/>
    <xapl:variable name="type">
      <xapl:choose>
        <xapl:when test="$pType/@Type">
          <xapl:value-of select="$pType/@Type"/>
        </xapl:when>
        <xapl:otherwise>Text</xapl:otherwise>
      </xapl:choose>
    </xapl:variable>
    <xapl:variable name="format">
      <xapl:choose>
        <xapl:when test="$pType/@Format">
          <xapl:value-of select="$pType/@Format"/>
        </xapl:when>
        <xapl:otherwise>common</xapl:otherwise>
      </xapl:choose>
    </xapl:variable>
    <xapl:return>
      <xapl:choose>
        <xapl:when test="$type='Text'">
          <i18n:text>
            <xapl:value-of select="$pData"/>
          </i18n:text>
        </xapl:when>
        <xapl:when test="$type='Currency'">
          <i18n:currency>
            <xapl:value-of select="$pData"/>
          </i18n:currency>
        </xapl:when>
        <xapl:when test="$type='Number'">
          <i18n:number>
            <xapl:value-of select="$pData"/>
          </i18n:number>
        </xapl:when>
        <xapl:when test="$type='Date'">
          <i18n:date format="{$format}">
            <xapl:value-of select="$pData"/>
          </i18n:date>
        </xapl:when>
      </xapl:choose>
    </xapl:return>
  </x2:command>
  
  
    <x2:command public="yes" description="_" name="configure">
    <x2:param name="pReportFormat"/>
    <x2:param name="configTableId" select="$pReportFormat/@ConfigTableId"/>
    
    <xapl:variable name="configuredTableFormat">
       <TABLE>
         <xcore:execute-method name="//UIService/getConfiguredTable">
           <TABLE_ID  Value="{$configTableId}"/>
         </xcore:execute-method>
       </TABLE>
    </xapl:variable>

    <xapl:variable name="displayOrder" select="'0'"/>

    <xapl:if test="count($configuredTableFormat/FIELDS/FIELD[1]) >0">
     <xapl:for-each select="$pReportFormat/FIELDS/FIELD[not(@Type) or (@Type != 'Hidden')]" varName="masterField">
      <xapl:set-variable name="displayOrder" select="$displayOrder + 1"/>
   
      <xapl:variable name="masterFieldName">
        <xapl:value-of select="$masterField/@Name"/>
      </xapl:variable>

      <xapl:variable name="configuredField">
        <xapl:value-of select="$configuredTableFormat/FIELDS/FIELD[@Value = $masterFieldName]"/>
      </xapl:variable>
      <docutil:set select="$masterField/@DisplayOrder"><xapl:value-of select="number($configuredField/@DisplayOrder)"/></docutil:set>

      <xapl:if test="string-length($configuredField/@Value) = 0">
      <docutil:set select="$masterField/@DisplayOrder"><xapl:value-of select="$displayOrder"/></docutil:set>
      <xapl:if test="string-length($masterField/@Configurable) = 0  or $masterField/@Configurable = 'true'">
        <docutil:remove select="$pReportFormat/FIELDS/FIELD[@Name = $masterFieldName]"/>  
      </xapl:if>  
      </xapl:if>  

      </xapl:for-each>

      <docutil:sort select="$pReportFormat/FIELDS" sort-element="FIELD" sort-by="@DisplayOrder" data-type="number" sort-order="Ascending"/>
      
     </xapl:if>  
    <xapl:print>afeter sort<xapl:value-of select="$pReportFormat"/></xapl:print>
     
     <xapl:return>
      <xapl:value-of select="$pReportFormat"/>
     </xapl:return>
   </x2:command>
  
</x2:commands>
