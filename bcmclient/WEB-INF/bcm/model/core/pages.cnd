<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" description="_">
	<!-- **********************************************************************
     *********************************************************************** -->
	<x2:command name="init" public="yes" description="_">
		<x2:execute command="core.pages:defineCore"/>
		<x2:execute command="core.pages:defineBCMCore"/>
	</x2:command>
	<!-- **********************************************************************
     *********************************************************************** -->
	<x2:command public="yes" description="_" name="defineBCMCore">
		<!-- Login -->
		<web:define-page name="loginSuccess" url="/core/pages/goToIndex.cmd"/>
		<web:define-page name="logout" url="/bcm/framework/common/logout.cmd"/>
		
		<!-- Nav -->
		<web:define-page name="nav_page" url="/bcm/framework/nav.jsp"/>
		<web:define-xsl name="nav_page" url="/bcm/framework/xsl/nav.xsl"/>
		<!-- Index -->
		<web:define-page name="solutionIndex" url="/bcm/framework/index.jsp"/>
		<!-- Nikhil start -->
		<!-- Instances -->
		<web:define-page name="input_staging" url="/core/pages/goToIndex.cmd?ACTIVITY=bcmInputStaging"/>
		<web:define-page name="reference_staging" url="/core/pages/goToIndex.cmd?ACTIVITY=bcmReferenceStaging"/>
		<web:define-page name="output_staging" url="/core/pages/goToIndex.cmd?ACTIVITY=bcmOutputStaging"/>
		<!--Sumanta start-->
		<web:define-page name="ADW" url="/core/pages/goToIndex.cmd?ACTIVITY=bcmADWTableView"/>
		<!--Sumanta end-->
		<!-- Nikhil end -->
		<web:define-page name="scmPage" url="/bcm/framework/transition.jsp"/>		
	</x2:command>
	<!-- **********************************************************************
       *********************************************************************** -->
	<x2:command public="yes" description="_" name="goToIndex">
		<x2:param name="selectedActivity" select="$this/ACTIVITY/@Value"/>
		
		<xapl:print>INSIDE BCM goToIndex PAGES ############
       TOP_LEVEL_ACTIVITY:::$selectedActivity:::::::::<xapl:value-of select="$selectedActivity"/>
		</xapl:print>
		
		<xapl:variable name="activity">
			<xapl:choose>
				<xapl:when test="string-length($selectedActivity) > 0">
					<xapl:value-of select="$selectedActivity"/>
				</xapl:when>
				<xapl:when test="isAllowed('TOP_LEVEL_ACTIVITY', 'bcmDataManagement')">bcmDataManagement</xapl:when>
				<xapl:when test="isAllowed('TOP_LEVEL_ACTIVITY', 'bcmConfigureSystem')">bcmConfigureSystem</xapl:when>
				<xapl:when test="isAllowed('TOP_LEVEL_ACTIVITY', 'bcmInputStaging')">bcmInputStaging</xapl:when>
				<xapl:when test="isAllowed('TOP_LEVEL_ACTIVITY', 'bcmReferenceStaging')">bcmReferenceStaging</xapl:when>
				<xapl:when test="isAllowed('TOP_LEVEL_ACTIVITY', 'bcmOutputStaging')">bcmOutputStaging</xapl:when>
				<xapl:when test="isAllowed('TOP_LEVEL_ACTIVITY', 'bcmADWTableView')">bcmADWTableView</xapl:when>
				<xapl:otherwise>bcmDataManagement</xapl:otherwise>
			</xapl:choose>
		</xapl:variable>
		<xapl:print>TOP_LEVEL_ACTIVITY::::: <xapl:value-of select="$activity"/>
		</xapl:print>
		<!-- Display parts master -->
		<web:display-page>
			<web:get-page name="solutionIndex">
				<ACTIVITY Value="{$activity}"/>
		         <xapl:choose>
			    <xapl:when test=" count($this/SOLUTION) &gt; 0 "> 
				<SOLUTION Value="{$this/SOLUTION/@Value}"/>
			    </xapl:when>
			    <xapl:otherwise>
			      <xapl:if test=" string-length($otherSolutions) &gt; 0 "> 
			      	<SOLUTION Value="{$otherSolutions}"/>
			      </xapl:if>	
			    </xapl:otherwise>
			 </xapl:choose>
			</web:get-page>
		</web:display-page>
	</x2:command>
	<!-- **********************************************************************
       *********************************************************************** -->
</x2:commands>
