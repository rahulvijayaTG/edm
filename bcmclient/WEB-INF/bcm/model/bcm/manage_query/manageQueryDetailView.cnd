<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" description="_">
  <!-- **********************************************************************
       *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
    <xapl:variable name="paramForm"/>
    <xapl:print select="$this"/>
    <!-- BREADCRUMBS AT TOP OR AFTER CLEAN-CONTEXT-->
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
      <x2:with-param name="display" select="'Query Details'"/>
      <x2:with-param name="page" select="'manageQueryDetail'"/>
      <x2:with-param name="this" select="{$this}"/>
    </x2:execute>


    <xapl:print select="$this"/>
    
    <xapl:print select="$queryDetail"/>

    <xapl:if test="$this/MODE/@Value = 'Edit' or $this/MODE/@Value = 'Save'">
      <docutil:set select="$this">
        <SERVICE Value="BCMMasterService"/>
        <FORM_NAME Value="QUERY_PARAMETER_FORM"/>
        <DO_SEARCH Value="Yes"/>
        <SORT_BY Value="QueryParam.sequence"/>
        <SORT_ORDER Value="Ascending"/>
        <F_QueryParam_queryID Value="{$queryDetail/QueryMaster/queryID/@Value}"/>
      </docutil:set>
      <xapl:set-variable name="paramForm">
        <x2:execute command="bcm.framework.queryform.Form:getFormContainer">
          <x2:with-param name="this" select="$this"/>
          <x2:with-param name="pSearchParam" select="$searchParam"/>
          <x2:with-param name="pFormName" select="'QUERY_PARAMETER_FORM'"/>
          <x2:with-param name="pServiceName" select="'BCMMasterService'"/>
          <x2:with-param name="pSearchFormConfigSource" select="'bcm.manage_query.manageQueryDetailView:getQueryParamFormConfig'"/>
          <x2:with-param name="pSearchReportConfigSource" select="'bcm.manage_query.manageQueryDetailView:getQueryParamReportConfig'"/>
          <x2:with-param name="pReportDataSource" select="'bcm.manage_query.manageQueryDetailView:getReportData'"/>
        </x2:execute>
      </xapl:set-variable>
    </xapl:if>
    <xapl:variable name="userPermissionAddForbcmManageQuery">
	<x2:execute command="bcm.framework.common:checkAccessPermissions">
	 <x2:with-param name="activityName" select="'bcmManageQuery'"/>
	 <x2:with-param name="accessLevel" select="'Add'"/>
	</x2:execute>
    </xapl:variable>  
    <xapl:variable name="userPermissionUpdateForbcmManageQuery">
	<x2:execute command="bcm.framework.common:checkAccessPermissions">
	 <x2:with-param name="activityName" select="'bcmManageQuery'"/>
	 <x2:with-param name="accessLevel" select="'Update'"/>
	</x2:execute>
    </xapl:variable>  
    <xapl:return>
      <!-- Page Header-->
      <x2:execute command="bcm.manage_query.manageQueryDetailView:getHeader">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
      <!-- Top Level Container -->
      <x2:execute command="bcm.manage_query.manageQueryDetailView:getContainer">
        <x2:with-param name="this" select="$this"/>
        <x2:with-param name="pPage" select="'manageQueryDetail'"/>
      </x2:execute>
      
      <xapl:print>
        inLOAD**************************##########################
        <xapl:value-of select="$queryDetail"/>
        inLOAD*****this
        <xapl:value-of select="$this"/>
        
      </xapl:print>
      <!-- return Query Details -->
      <QUERY_DETAILS>
        <xapl:value-of select="$queryDetail/QueryMaster/*"/>
      </QUERY_DETAILS>
      <!-- return Parameter Details -->
      <xapl:if test="$this/MODE/@Value = 'Edit' or $this/MODE/@Value = 'Save'">
      <xapl:print>
        Param List
        <!--xapl:value-of select="$paramForm"/-->
      </xapl:print>
        <PARAMETER_DETAILS>
          <xapl:value-of select="$paramForm"/>
        </PARAMETER_DETAILS>
      </xapl:if>
      <!-- add Parameters -->
      <xapl:if test="$this/ADD_PARAMDTL/@Value = 'True'">
        <xapl:print>
        AddParam <x2:execute command="bcm.manage_query.manageQueryController:getDataTypes"/>
        </xapl:print>
        <ADD_PARAMETER>
          <x2:execute command="bcm.manage_query.manageQueryController:getDataTypes"/>
        </ADD_PARAMETER>
      </xapl:if>
      <!-- pass all parameters-->
      <xapl:value-of select="$this/*"/>
      <userPermissionAddForbcmManageQuery Value="{$userPermissionAddForbcmManageQuery}"/>
      <userPermissionUpdateForbcmManageQuery Value="{$userPermissionUpdateForbcmManageQuery}"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    <xapl:return>
      <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getQueryDetails">
    <xapl:return>
      
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <xapl:print select="$this"/>
    <xapl:return>
      <CONTAINER Scrollable="yes">
        <HELP Url="../help/query_details_help.htm"/>
        <STEP Name="QueryDetails" DisplayText="Query Details" OnClick="{$pages:manageQueryDetail}" Selected="true">
	  <xapl:variable name="userPermissionAddForbcmManageQuery">
		<x2:execute command="bcm.framework.common:checkAccessPermissions">
		 <x2:with-param name="activityName" select="'bcmManageQuery'"/>
		 <x2:with-param name="accessLevel" select="'Add'"/>
		</x2:execute>
	  </xapl:variable>  
	  <xapl:variable name="userPermissionUpdateForbcmManageQuery">
		<x2:execute command="bcm.framework.common:checkAccessPermissions">
		 <x2:with-param name="activityName" select="'bcmManageQuery'"/>
		 <x2:with-param name="accessLevel" select="'Update'"/>
		</x2:execute>
	  </xapl:variable>  
          <BUTTONS>
            <BUTTON Id="cancel" Name="Cancel" DisplayText="Cancel" OnClick="javascript:onCancel()"/>
 	    <xapl:if test="$userPermissionAddForbcmManageQuery='True' or $userPermissionUpdateForbcmManageQuery='True'">	            
	      <BUTTON Id="save" Name="Save" DisplayText="Save" OnClick="javascript:onSave()"/>
	      <BUTTON Id="save_return" Name="Save" DisplayText="Save And Return" OnClick="javascript:onSaveAndReturn()"/>
	    </xapl:if>
          </BUTTONS>
        </STEP>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
   *********************************************************************** -->
  <x2:command public="yes" description="_" name="getQueryParamFormConfig">
    <x2:param name="this" select="$this"/>
    <xapl:print>
      Value of this in manageQueryParam getFormConfig
      <xapl:value-of select="$this"/>
    </xapl:print>
    <xapl:return>
      <Q_FORM Name="search_form" Action="manageQueryDetailView.jsp" method="GET" Target="appFrame">
        <!--get all search form fields -->
        <x2:execute command="bcm.framework.queryform.Form:getFormSearchFields">
          <x2:with-param name="this" select="$this"/>
        </x2:execute>
      </Q_FORM>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getQueryParamReportConfig">
    <xapl:print select="$this"/>
    <xapl:variable name="userPermissionAddForbcmManageQuery">
	<x2:execute command="bcm.framework.common:checkAccessPermissions">
	 <x2:with-param name="activityName" select="'bcmManageQuery'"/>
	 <x2:with-param name="accessLevel" select="'Add'"/>
	</x2:execute>
    </xapl:variable>  
    <xapl:variable name="userPermissionUpdateForbcmManageQuery">
	<x2:execute command="bcm.framework.common:checkAccessPermissions">
	 <x2:with-param name="activityName" select="'bcmManageQuery'"/>
	 <x2:with-param name="accessLevel" select="'Update'"/>
	</x2:execute>
    </xapl:variable>  
    <xapl:return>
      <REPORT SelectedId="SELECTED_ID" Id="QueryParam.queryID|QueryParam.parameter|QueryParam.sequence" Title="Parameters" Scrollable="no" ScrollableContainer="yes" NoRecordsTitle="No Parameters found" ShowMoveUpDown="yes" Selectable="Single">
        <FIELDS>
          <!--get form's report fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
          <!-- get Hidden Fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
        </FIELDS>
 	<xapl:if test="$userPermissionAddForbcmManageQuery='True' or $userPermissionUpdateForbcmManageQuery='True'">	                    
		<BUTTONS>
		  <BUTTON Id="add_param" Name="add_param" DisplayText="Add" OnClick="javascript:onAddParam()" DisableOnClick="true"/>
		  <BUTTON Id="del_param" Name="del_param" DisplayText="Delete" OnClick="javascript:onDelParam()" DisableOnClick="true" Disabled="report"/>
		</BUTTONS>
        </xapl:if>
        <PAGINATION/>
      </REPORT>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportData">
    <x2:param name="this"/>
    <xapl:set-variable name="paramSeq">  
      <x2:execute command="bcm.framework.queryform.Form:getFormReportData">
        <x2:with-param name="this" select="$this"/>
        <x2:with-param name="fromProperty" select="'RESULT_PROPERTY'"/>
        <x2:with-param name="delimeter" select="'_' "/>
      </x2:execute>
    </xapl:set-variable>
    <xapl:return>
      <xapl:value-of select="$paramSeq"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
</x2:commands>
