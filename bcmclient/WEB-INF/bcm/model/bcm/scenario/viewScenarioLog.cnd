<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:scenario="http://www.i2.com/scenario" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
    <xapl:print>PRINTING THIS INSIDE SCEANRIO LOG <xapl:value-of select="$this"/>
    </xapl:print>
    <docutil:set select="$this">
      <xapl:if test="string-length($this/SORT_BY/@Value) = 0">
        <SORT_BY Value="ScenarioLog.CREATION_DATE"/>
      </xapl:if>
      <xapl:if test="string-length($this/SORT_ORDER/@Value) = 0">
        <SORT_ORDER Value="Descending"/>
      </xapl:if>
      <xapl:if test="($this/DO_SEARCH/@Value != 'false') or (string-length($this/DO_SEARCH/@Value) = 0) ">
        <DO_SEARCH Value="Yes"/>
      </xapl:if>
      <FORM_NAME Value="MST_SCENARIO_LOG_FORM"/>
      <SERVICE Value="BCMMasterService"/>
    </docutil:set>
    <xapl:variable name="scenarioLogForm">
      <SCENARIO_LOGS>
        <x2:execute command="bcm.framework.queryform.Form:getFormContainer">
          <x2:with-param name="this" select="$this"/>
          <x2:with-param name="pSearchParam" select="{$searchParam}"/>
          <x2:with-param name="pFormName" select="$this/FORM_NAME/@Value"/>
          <x2:with-param name="pServiceName" select="$this/SERVICE/@Value"/>
          <x2:with-param name="pSearchReportConfigSource" select="'bcm.scenario.viewScenarioLog:getReportConfig'"/>
          <x2:with-param name="pReportDataSource" select="'bcm.scenario.viewScenarioLog:getReportData'"/>
        </x2:execute>
      </SCENARIO_LOGS>
    </xapl:variable>
    <xapl:return>
      <!-- Page Header-->
      <!--
      <x2:execute command="bcm.scenario.viewScenarioLog:getHeader">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
-->
      <!-- Container-->
      <x2:execute command="bcm.scenario.viewScenarioLog:getContainer">
        <x2:with-param name="this" select="{$this}"/>
        <x2:with-param name="pPage" select="'scenarioLog'"/>
      </x2:execute>
      <!-- return the form -->
      <xapl:value-of select="$scenarioLogForm"/>
      <!-- Success/Error messages -->
      <xapl:if test="string-length($this/ERROR_MESSAGE/@Value) &gt; 0">
        <ERROR_MESSAGE Value="{$this/ERROR_MESSAGE/@Value}"/>
      </xapl:if>
      <xapl:if test="string-length($this/SUCCESS_MESSAGE/@Value) &gt; 0">
        <SUCCESS_MESSAGE Value="{$this/SUCCESS_MESSAGE/@Value}"/>
      </xapl:if>
      <!-- eQ479235: Returning $this/* coz filter conditions were not being stored on this screen -->
      <xapl:value-of select="$this/*"/>
    </xapl:return>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    <xapl:return>
      <HEADER>
        <APP_NAME Value="BCM"/>
        <HEADING Value="Scenario Logs"/>
        <TOGGLE_NAV Value="../"/>
        <HOME Value="bcm/framework/home.jsp"/>
      </HEADER>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <x2:param name="pPage"/>
    <xapl:variable name="currentScenario">
      <scenario:get-scenario-id/>
    </xapl:variable>
    <xapl:variable name="currentScenarioDetails">
      <xcore:execute-method name="//BCMMasterService/getScenarioDetailsFromID" entireResponse="true">
        <scenarioID Value="{$currentScenario}"/>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:variable name="logtitle">
        <i18n:text>Scenario Log for</i18n:text>
    </xapl:variable>
    <xapl:variable name="title" select="{concat($logtitle,' : ', $currentScenarioDetails/RESPONSE/ScenarioMaster/name/@Value)}"/>
    <xapl:return>
      <CONTAINER>
        <HELP Url="../help/scenario_log_help.htm"/>
        <EXPRESSION_FILTER Value="no"/>
        <STEP Name="ViewForm" DisplayText="{$title}" OnClick="{$pages:scenarioLog}" Selected="{$pPage = 'scenarioLog'}"/>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportConfig">
    <xapl:return>
      <REPORT Action="scenarioLog.jsp" Selectable="None" Scrollable="yes" ScrollableContainer="no" ShowFilter="yes" Id="ID" SelectedId="SELECTED_LOG_ID" PagingTitle="yes">
        <FIELDS>
        	<OVERRIDDEN Value="yes"/>
          <!--get form's report fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
          <!-- get Hidden Fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
        </FIELDS>
        <BUTTONS>
          <!--
          <BUTTON Id="Close" Name="Close" DisplayText="Close" OnClick="javascript:onClose()" DisableOnClick="true"/>
          <DIVIDER/>
-->
          <BUTTON Id="Clear" Name="Clear" DisplayText="Clear" OnClick="javascript:onClear()" DisableOnClick="true"/>
          <BUTTON Id="Search" Name="Search" DisplayText="Search" OnClick="javascript:dispatchSearch()" DisableOnClick="true" Emphasized="yes"/>
        </BUTTONS>
        <PAGINATION/>
      </REPORT>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportData">
    <x2:param name="this"/>
    <xapl:variable name="currentScenario">
      <scenario:get-scenario-id/>
    </xapl:variable>
    <docutil:set select="$this">
      <F_ScenarioLog.scenarioID Value="{$currentScenario}"/>
    </docutil:set>
    <xapl:variable name="returnVar">
      <x2:execute command="bcm.framework.queryform.Form:getFormReportData">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
    </xapl:variable>
    <xapl:return>
      <xapl:value-of select="$returnVar"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
   *********************************************************************** -->
</x2:commands>
