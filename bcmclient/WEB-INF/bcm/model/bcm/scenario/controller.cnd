<?xml version="1.0" encoding="UTF-8"?>
<x2:commands description="_" xmlns:scenario="http://www.i2.com/scenario" xmlns:cfg="http://www.i2.com/configurability" xmlns:core="http://www.i2.com/core" xmlns:omx="http://www.i2.com/omx" xmlns:perm="http://www.i2.com/permissibility" xmlns:util="http://www.i2.com/util" xmlns:web="http://www.i2.com/web" xmlns:x2="http://www.i2.com/x2" xmlns:xapl="http://www.i2.com/xapl" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:docutil="http://www.i2.com/docutil" xmlns:oa="http://www.i2.com/oa" xmlns:xudl="http://www.i2.com/xudl" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity">
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="init">
    <xapl:variable name="scenarioContext" resolver="session" global="true"/>
    <x2:execute command="bcm.scenario.controller:initSessionVars"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="initSessionVars">
    <x2:execute command="bcm.scenario.controller:cleanScenarioContext"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="setScenarioContext">
    <x2:param name="selectedScenarioID"/>
    <x2:param name="parentScenarioID"/>
    <x2:param name="scenarioID"/>
    <x2:param name="name"/>
    <x2:param name="ACTION"/>
    <xapl:if test="count($scenarioContext/*) = 0 ">
      <xapl:set-variable name="scenarioContext">
        <SCENARIO/>
      </xapl:set-variable>
    </xapl:if>
    <docutil:set select="$scenarioContext">
      <selectedScenarioID Value="{$selectedScenarioID}"/>
      <scenarioID Value="{$scenarioID}"/>
      <name Value="{$name}"/>
      <parentScenarioID Value="{$parentScenarioID}"/>
      <ACTION Value="{$ACTION}"/>
    </docutil:set>
    <xapl:print select="{$scenarioContext}"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="cleanScenarioContext">
    <xapl:set-variable name="scenarioContext"/>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="copyScenario">
    <xapl:variable name="scId">
      <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
        <x2:with-param name="selectedId" select="{$this/SELECTED_ID/@Value}"/>
        <x2:with-param name="key" select="'ScenarioMaster.scenarioID'"/>
      </x2:execute>
    </xapl:variable>
    <xapl:variable name="response">
      <xcore:execute-method name="//BCMMasterService/getScenarioDetailsFromID" entireResponse="true">
        <scenarioID Value="{$scId}"/>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:choose>
      <xapl:when test="$response/RESPONSE/ScenarioMaster/status/@Value = 'ERROR' ">
        <web:display-page>
          <web:get-page name="scenarioSearch">
            <ERROR_MESSAGE Value="CANNOT_COPY_SCENARIO_IN_ERROR_STATUS"/>
          </web:get-page>
        </web:display-page>
        <xapl:return/>
      </xapl:when>
      <xapl:otherwise>
        <!-- Set session context -->
        <x2:execute command="bcm.scenario.controller:updateScenarioContextSession">
          <x2:with-param name="this" select="{$this}"/>
          <x2:with-param name="ACTION" select="'Copy'"/>
        </x2:execute>
        <web:display-page>
          <web:get-page name="createScenario"/>
        </web:display-page>
      </xapl:otherwise>
    </xapl:choose>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="createScenario">
    <!-- Set session context -->
    <x2:execute command="bcm.scenario.controller:updateScenarioContextSession">
      <x2:with-param name="this" select="{$this}"/>
      <x2:with-param name="ACTION" select="'Create'"/>
    </x2:execute>
    <xapl:return>
      <web:display-page>
        <web:get-page name="createScenario"/>
      </web:display-page>
    </xapl:return>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="updateScenarioContextSession">
    <x2:param name="this"/>
    <x2:param name="ACTION"/>
    <xapl:variable name="selectedScenarioID"/>
    <xapl:variable name="parentScenarioID"/>
    <xapl:variable name="scenarioID"/>
    <xapl:variable name="name"/>
    <xapl:set-variable name="parentScenarioID">
      <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
        <x2:with-param name="selectedId" select="{$this/SELECTED_ID/@Value}"/>
        <x2:with-param name="key" select="'ScenarioMaster.parentScenarioID'"/>
      </x2:execute>
    </xapl:set-variable>
    <xapl:set-variable name="scenarioID">
      <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
        <x2:with-param name="selectedId" select="{$this/SELECTED_ID/@Value}"/>
        <x2:with-param name="key" select="'ScenarioMaster.scenarioID'"/>
      </x2:execute>
    </xapl:set-variable>
    <xapl:set-variable name="name">
      <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
        <x2:with-param name="selectedId" select="{$this/SELECTED_ID/@Value}"/>
        <x2:with-param name="key" select="'ScenarioMaster.name'"/>
      </x2:execute>
    </xapl:set-variable>
    <!-- Set in session -->
    <x2:execute command="bcm.scenario.controller:setScenarioContext">
      <x2:with-param name="selectedScenarioID" select="{$this/SELECTED_ID/@Value}"/>
      <x2:with-param name="parentScenarioID" select="{$parentScenarioID}"/>
      <x2:with-param name="scenarioID" select="{$scenarioID}"/>
      <x2:with-param name="name" select="{$name}"/>
      <x2:with-param name="ACTION" select="{$ACTION}"/>
    </x2:execute>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="saveScenario">
    <xapl:variable name="response">
      <xcore:execute-method name="//BCMMasterService/createScenario" entireResponse="true">
        <name Value="{$this/name/@Value}"/>
        <scenarioDescription Value="{$this/scenarioDescription/@Value}"/>
        <xapl:choose>
          <xapl:when test="$appInstanceEnabled = 'true' ">
            <instanceID Value="{$currentInstance}"/>
          </xapl:when>
          <xapl:otherwise>
            <instanceID Value="0"/>
          </xapl:otherwise>
        </xapl:choose>
        <isPrimary Value="FALSE"/>
        <!-- Handle differently if multiple instances are enabled -->
        <xapl:choose>
          <xapl:when test="$scenarioContext/ACTION/@Value = 'Copy' ">
            <!-- If Copy, then five scenarioID of scenario being copied from as the parent scenario Id -->
            <parentScenarioId Value="{$scenarioContext/scenarioID/@Value}"/>
          </xapl:when>
          <xapl:when test="$scenarioContext/ACTION/@Value = 'Create' ">
            <xapl:if test="$appInstanceEnabled = 'true' ">
              <xapl:variable name="res">
                <xcore:execute-method name="//BCMMasterService/getBaseScenarioForInstance" entireResponse="true">
                  <instanceID Value="{$currentInstance}"/>
                </xcore:execute-method>
              </xapl:variable>
              <parentScenarioId Value="{$res/RESPONSE/ScenarioMaster/scenarioID/@Value}"/>
            </xapl:if>
          </xapl:when>
        </xapl:choose>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:variable name="responseStatus">
      <xapl:choose>
        <xapl:when test="$scenarioContext/ACTION/@Value = 'Create' ">
          <x2:execute command="bcm.framework.util:getResponseStatus">
            <x2:with-param name="response" select="$response"/>
            <x2:with-param name="successMessage" select="'SCENARIO_CREATED_SUCCESSFULLY'"/>
          </x2:execute>
        </xapl:when>
        <xapl:when test="$scenarioContext/ACTION/@Value = 'Copy' ">
          <x2:execute command="bcm.framework.util:getResponseStatus">
            <x2:with-param name="response" select="$response"/>
            <x2:with-param name="successMessage" select="'SCENARIO_COPIED_SUCCESSFULLY'"/>
          </x2:execute>
        </xapl:when>
      </xapl:choose>
    </xapl:variable>
    <xapl:choose>
      <xapl:when test="name($responseStatus) = 'SUCCESS_MESSAGE'">
        <web:display-page>
          <web:get-page name="scenarioSearch">
            <SUCCESS_MESSAGE Value="{$responseStatus/@Value}"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:when test="name($responseStatus) = 'ERROR_MESSAGE'">
        <web:display-page>
          <web:get-page name="createScenario">
            <ERROR_MESSAGE Value="{$responseStatus/@Value}"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
    </xapl:choose>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="selectScenario">
    <xapl:variable name="message"/>
    <xapl:variable name="scId">
      <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
        <x2:with-param name="selectedId" select="{$this/SELECTED_ID/@Value}"/>
        <x2:with-param name="key" select="'ScenarioMaster.scenarioID'"/>
      </x2:execute>
    </xapl:variable>
    <xapl:variable name="scName">
      <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
        <x2:with-param name="selectedId" select="{$this/SELECTED_ID/@Value}"/>
        <x2:with-param name="key" select="'ScenarioMaster.name'"/>
      </x2:execute>
    </xapl:variable>
    <!-- Nikhil Mar 03, 2003: Fix for TI: Not allowing to set context to scenario in ERROR status -->
    <xapl:variable name="response">
      <xcore:execute-method name="//BCMMasterService/getScenarioDetailsFromID" entireResponse="true">
        <scenarioID Value="{$scId}"/>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:choose>
      <xapl:when test="$response/RESPONSE/ScenarioMaster/status/@Value = 'ERROR' ">
        <web:display-page>
          <web:get-page name="scenarioSearch">
            <ERROR_MESSAGE Value="CANNOT_SWITCH_CONTEXT_TO_ERROR_SCENARIO"/>
          </web:get-page>
        </web:display-page>
        <xapl:return/>
      </xapl:when>
      <xapl:otherwise>
        <scenario:set-scenario ScenarioId="{$scId}"/>
        <xapl:variable name="currentScenario">
          <scenario:get-scenario-id/>
        </xapl:variable>
        <xapl:choose>
          <xapl:when test="$currentScenario = $scId">
            <xapl:variable name="i18nMessage">
                <i18n:text>Scenario set to</i18n:text>
            </xapl:variable>
            
            <xapl:set-variable name="message" select="{concat($i18nMessage,': ', $scName)}"/>
            <web:display-page>
              <web:get-page name="scenarioSearch">
                <SUCCESS_MESSAGE Value="{$message}"/>
              </web:get-page>
            </web:display-page>
          </xapl:when>
          <xapl:otherwise>
            <xapl:set-variable name="message" select="'SCENARIO_COULD_NOT_BE_SET'"/>
            <web:display-page>
              <web:get-page name="scenarioSearch">
                <ERROR_MESSAGE Value="{$message}"/>
              </web:get-page>
            </web:display-page>
          </xapl:otherwise>
        </xapl:choose>
      </xapl:otherwise>
    </xapl:choose>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="deleteScenario">
    <xapl:variable name="scId">
      <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
        <x2:with-param name="selectedId" select="{$this/SELECTED_ID/@Value}"/>
        <x2:with-param name="key" select="'ScenarioMaster.scenarioID'"/>
      </x2:execute>
    </xapl:variable>
    <xapl:variable name="currentScenario">
      <scenario:get-scenario-id/>
    </xapl:variable>
    <!-- If multiple instances are enabled, check if selected scenario is a base scenario -->
    <xapl:variable name="isBaseScenario">
      <xapl:if test="$appInstanceEnabled = 'true' ">
        <x2:execute command="bcm.scenario.controller:checkIfBaseScenario">
          <x2:with-param name="scenarioID" select="$scId"/>
        </x2:execute>
      </xapl:if>
    </xapl:variable>
    <xapl:choose>
      <xapl:when test="($scId = 0) or ($isBaseScenario = 'true')">
        <web:display-page>
          <web:get-page name="scenarioSearch">
            <ERROR_MESSAGE Value="BASE_SCENARIO_CANNOT_BE_DELETED"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:when test="($scId = $currentScenario) and not($scId = 0)">
        <web:display-page>
          <web:get-page name="scenarioSearch">
            <ERROR_MESSAGE Value="CURRENT_SCENARIO_CANNOT_BE_DELETED"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:otherwise>
        <xapl:variable name="response">
          <!-- call deleteScenario API with scId -->
          <xcore:execute-method name="//BCMMasterService/deleteScenario" entireResponse="true">
            <SCENARIO_ID Value="{$scId}"/>
          </xcore:execute-method>
        </xapl:variable>
        <xapl:variable name="responseStatus">
          <x2:execute command="bcm.framework.util:getResponseStatus">
            <x2:with-param name="response" select="$response"/>
            <x2:with-param name="successMessage" select="'SCENARIO_DELETED_SUCCESSFULLY'"/>
          </x2:execute>
        </xapl:variable>
        <xapl:choose>
          <xapl:when test="name($responseStatus) = 'SUCCESS_MESSAGE'">
            <web:display-page>
              <web:get-page name="scenarioSearch">
                <SUCCESS_MESSAGE Value="{$responseStatus/@Value}"/>
              </web:get-page>
            </web:display-page>
          </xapl:when>
          <xapl:when test="name($responseStatus) = 'ERROR_MESSAGE'">
            <web:display-page>
              <web:get-page name="scenarioSearch">
                <ERROR_MESSAGE Value="{$responseStatus/@Value}"/>
              </web:get-page>
            </web:display-page>
          </xapl:when>
        </xapl:choose>
      </xapl:otherwise>
    </xapl:choose>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="checkIfBaseScenario">
    <x2:param name="scenarioID"/>
    <xapl:print select="$scenarioID"/>
    <xapl:variable name="scDetails">
      <xcore:execute-method name="//BCMMasterService/getScenarioDetailsFromID" entireResponse="true">
        <scenarioID Value="{$scenarioID}"/>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:return>
      <xapl:choose>
        <xapl:when test="$scDetails/RESPONSE/ScenarioMaster/isPrimary/@Value = 'TRUE' ">
          <xapl:value-of select="'true'"/>
        </xapl:when>
        <xapl:otherwise>
          <xapl:value-of select="'false'"/>
        </xapl:otherwise>
      </xapl:choose>
    </xapl:return>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="setBaseScenario">
    <scenario:set-scenario ScenarioId="0"/>
    <!-- hard coded to 0 -->
    <web:display-page>
      <web:get-page name="scenarioSearch"/>
    </web:display-page>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="saveComment">
    <xapl:print select="$this"/>
    <xapl:variable name="currentScenario">
      <scenario:get-scenario-id/>
    </xapl:variable>
    <xapl:variable name="response">
      <xcore:execute-method name="//BCMMasterService/saveScenarioComments" entireResponse="true">
        <ScenarioLogs>
          <ScenarioLog>
            <scenarioID Value="{$currentScenario}"/>
            <comments Value="{$this/comments/@Value}"/>
          </ScenarioLog>
        </ScenarioLogs>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:variable name="responseStatus">
      <x2:execute command="bcm.framework.util:getResponseStatus">
        <x2:with-param name="response" select="$response"/>
        <x2:with-param name="successMessage" select="'SCENARIO_COMMENT_SAVED_SUCCESSFULLY'"/>
      </x2:execute>
    </xapl:variable>
    <xapl:choose>
      <xapl:when test="name($responseStatus) = 'SUCCESS_MESSAGE'">
        <web:display-page>
          <web:get-page name="scenarioLog">
            <SUCCESS_MESSAGE Value="{$responseStatus/@Value}"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:when test="name($responseStatus) = 'ERROR_MESSAGE'">
        <web:display-page>
          <web:get-page name="scenarioLog">
            <ERROR_MESSAGE Value="{$responseStatus/@Value}"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
    </xapl:choose>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="exportToExcel">
    <x2:execute command="bcm.framework.util:exportToExcel">
      <x2:with-param name="pFormat" select="'csv'"/>
      <x2:with-param name="pGetReportConfigSource" select="'bcm.scenario.viewScenarios:getReportConfig'"/>
      <x2:with-param name="pGetReportDataSource" select="'bcm.scenario.viewScenarios:getReportData'"/>
      <x2:with-param name="pFileNameWithExtension" select="'Scenarios.csv'"/>
      <x2:with-param name="this" select="{$this}"/>
    </x2:execute>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
</x2:commands>
