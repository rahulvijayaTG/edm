<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:scenario="http://www.i2.com/scenario" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
    <xapl:print select="$this"/>
    <xapl:variable name="breadcrumb1">
      <i18n:text>Create Scenario</i18n:text>    
    </xapl:variable> 
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
      <x2:with-param name="display" select="$breadcrumb1"/>
      <x2:with-param name="page" select=" 'createScenario' "/>
      <x2:with-param name="this" select="$this"/>
<!--      <x2:with-param name="erase" select=" 'TRUE' "/>-->
    </x2:execute>

    <xapl:return>
      <!-- Page Header-->
      <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
<!--
      <x2:execute command="bcm.scenario.viewCreateScenario:getHeader">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
-->
      <!-- Container-->
      <x2:execute command="bcm.scenario.viewCreateScenario:getContainer">
        <x2:with-param name="this" select="{$this}"/>
        <x2:with-param name="pPage" select="'createScenario'"/>
      </x2:execute>
      <!-- Return the session var holding the scenario's information -->
      <xapl:value-of select="{$scenarioContext}"/>
      <!-- Success/Error messages -->
      <xapl:if test="string-length($this/ERROR_MESSAGE/@Value) &gt; 0">
        <ERROR_MESSAGE Value="{$this/ERROR_MESSAGE/@Value}"/>
      </xapl:if>
      <xapl:if test="string-length($this/SUCCESS_MESSAGE/@Value) &gt; 0">
        <SUCCESS_MESSAGE Value="{$this/SUCCESS_MESSAGE/@Value}"/>
      </xapl:if>
    </xapl:return>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    <xapl:return>
      <HEADER>
        <APP_NAME Value="BCM"/>
        <HEADING Value="Scenarios"/>
        <HEADING_LINK Value="{$pages:scenarioSearch}"/>
        <HEADING2 Value="Scenario Details"/>
        <TOGGLE_NAV Value="../../"/>
        <HOME Value="bcm/framework/home.jsp"/>
      </HEADER>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <x2:param name="pPage"/>
    <xapl:return>
      <CONTAINER Scrollable="yes">
        <HELP Url="../help/create_scenario_help.htm"/>
        <STEP Name="scenarioDetail" DisplayText="Scenario Details" OnClick="{$pages:createScenario}" Selected="true"/>
        <BUTTONS>
          <BUTTON Name="Cancel" Id="Cancel" DisplayText="Cancel" DisableOnClick="true" OnClick="javascript:onCancel()"/>
          <BUTTON Name="Save" Id="Save" DisplayText="Save" DisableOnClick="true" OnClick="javascript:onSave()"/>
        </BUTTONS>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
   *********************************************************************** -->
   <x2:command public="yes" description="_" name="i18n">
       <i18n:text>Create Scenario</i18n:text>      
  </x2:command>
   
   
</x2:commands>
