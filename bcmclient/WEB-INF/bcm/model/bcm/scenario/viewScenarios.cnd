<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:scenario="http://www.i2.com/scenario" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
    <xapl:print>PRINTING THIS INSIDE SCEANRIO <xapl:value-of select="$this"/>
    </xapl:print>
    <!-- Initialize session vars -->
    <x2:execute command="bcm.scenario.controller:initSessionVars"/>
    <!-- Clean context if coming from left nav -->
    <xapl:if test="$this/MODE/@Value = 'START' ">
      <docutil:remove select="$this/MODE"/>
      <x2:execute command="bcm.context.controller:cleanContext"/>
    </xapl:if>
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
      <x2:with-param name="display" select=" 'Maintain Scenarios' "/>
      <x2:with-param name="page" select=" 'scenarioSearch' "/>
      <x2:with-param name="this" select="$this"/>
    </x2:execute>
    <xapl:variable name="userId">
      <identity:get-user-id/>
    </xapl:variable>
    <xapl:variable name="userName">
      <identity:get-user-name/>
    </xapl:variable>
    <docutil:set select="$this">
      <xapl:if test="string-length($this/SORT_BY/@Value) = 0">
        <SORT_BY Value="ScenarioMaster.name"/>
      </xapl:if>
      <xapl:if test="($this/DO_SEARCH/@Value != 'false') or (string-length($this/DO_SEARCH/@Value) = 0) ">
        <DO_SEARCH Value="Yes"/>
      </xapl:if>
      <FORM_NAME Value="MST_SCENARIO_SEARCH_FORM"/>
      <SERVICE Value="BCMMasterService"/>
    </docutil:set>
    <docutil:remove select="$this/SELECTED_ATTRIBUTE_ID"/>
    <xapl:variable name="scenarioForm">
      <SCENARIOS>
        <x2:execute command="bcm.framework.queryform.Form:getFormContainer">
          <x2:with-param name="this" select="$this"/>
          <x2:with-param name="pSearchParam" select="{$searchParam}"/>
          <x2:with-param name="pFormName" select="'MST_SCENARIO_SEARCH_FORM'"/>
          <x2:with-param name="pServiceName" select="$this/SERVICE/@Value"/>
          <x2:with-param name="pSearchReportConfigSource" select="'bcm.scenario.viewScenarios:getReportConfig'"/>
          <x2:with-param name="pReportDataSource" select="'bcm.scenario.viewScenarios:getReportData'"/>
        </x2:execute>
      </SCENARIOS>
    </xapl:variable>
    <!-- Disable radio-button if status is other than 'CREATED' or 'ERROR' -->
    <xapl:for-each select="$scenarioForm/SEARCH/REPORT/TABLE/TR[count(TD[@Type = 'Radio' and @Name='SELECTED_ID']) &gt; 0 ]" varName="child">
      <xapl:variable name="statusTD" select="{$child/TD[@Name = 'ScenarioMaster.status']}"/>
      <xapl:if test="($statusTD/@Value = 'PENDING_CREATION' ) or ($statusTD/@Value = 'DELETED' ) or ($statusTD/@Value = 'PENDING_DELETION' )">
        <docutil:set select="$child/TD[@Name='SELECTED_ID' and @Type='Radio']/@Disabled">
          <xapl:value-of select="'disabled'"/>
        </docutil:set>
      </xapl:if>
    </xapl:for-each>
    <!-- Return current scenario name to show in top header -->
    <xapl:variable name="currentScenario">
      <scenario:get-scenario-id/>
    </xapl:variable>
    <xapl:variable name="currentScenarioDetails">
      <xcore:execute-method name="//BCMMasterService/getScenarioDetailsFromID" entireResponse="true">
        <scenarioID Value="{$currentScenario}"/>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:return>
      <!-- Page Header-->
      <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
      <!--
      <x2:execute command="bcm.scenario.viewScenarios:getHeader">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
-->
      <!-- Container-->
      <x2:execute command="bcm.scenario.viewScenarios:getContainer">
        <x2:with-param name="this" select="{$this}"/>
        <x2:with-param name="pPage" select="'scenarioSearch'"/>
      </x2:execute>
      <!-- return the form -->
      <xapl:value-of select="$scenarioForm"/>
      <!-- Success/Error messages -->
      <!--
      <xapl:if test="string-length($this/ERROR_MESSAGE/@Value) &gt; 0">
        <ERROR_MESSAGE Value="{$this/ERROR_MESSAGE/@Value}"/>
      </xapl:if>
      <xapl:if test="string-length($this/SUCCESS_MESSAGE/@Value) &gt; 0">
        <SUCCESS_MESSAGE Value="{$this/SUCCESS_MESSAGE/@Value}"/>
      </xapl:if>
-->
      <scenarioName Value="{$currentScenarioDetails/RESPONSE/ScenarioMaster/name/@Value}"/>
      <scenarioID Value="{$currentScenario}"/>
      <userName Value="{$userName}"/>
      <!-- eQ479622: Returning $this/* coz filter conditions were not being stored on this screen -->
      <xapl:value-of select="$this/*"/>
      <!-- Tell xsl whether instances are enabled, and if yes, then which instance -->
      <xapl:if test="$appInstanceEnabled = 'true' ">
        <instanceEnabled Value="true"/>
        <instanceID Value="{$currentInstance}"/>
      </xapl:if>
    </xapl:return>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    <xapl:return>
      <HEADER>
        <APP_NAME Value="BCM"/>
        <HEADING Value="Scenarios"/>
        <TOGGLE_NAV Value="../"/>
        <HOME Value="bcm/framework/home.jsp"/>
      </HEADER>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <x2:param name="pPage"/>
    <xapl:variable name="scId">
      <scenario:get-scenario-id/>
    </xapl:variable>
    <xapl:variable name="currentScenarioDetails">
      <xcore:execute-method name="//BCMMasterService/getScenarioDetailsFromID" entireResponse="true">
        <scenarioID Value="{$scId}"/>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:variable name="scenarioName" select="{$currentScenarioDetails/RESPONSE/ScenarioMaster/name/@Value}"/>
    <xapl:variable name="title1">
      <i18n:text>Current Scenario: </i18n:text>
    </xapl:variable>
    <xapl:return>
      <CONTAINER Scrollable="yes">
        <HELP Url="../help/scenario_help.htm"/>
        <EXPRESSION_FILTER Value="no"/>
        <STEP Name="ViewForm" DisplayText="{concat($title1, ' ', $scenarioName)}" OnClick="{$pages:scenarioSearch}" Selected="{$pPage = 'scenarioSearch'}"/>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportConfig">
    <xapl:return>
      <REPORT Selectable="Single" Scrollable="no" ScrollableContainer="yes" ShowFilter="yes" Id="#" SelectedId="SELECTED_ID" PagingTitle="yes">
        <FIELDS>
          <!--get form's report fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
          <!-- get Hidden Fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
        </FIELDS>
        <BUTTONS>
          <!--
          <BUTTON Id="ExportToExcel" Name="ExportToExcel" DisplayText="Export To Excel" OnClick="javascript:onExportToExcel()" DisableOnClick="true"/>
          <DIVIDER/>
-->
          <BUTTON Id="Create" Name="Create" DisplayText="Create" OnClick="javascript:onCreate()" DisableOnClick="true" Disabled="report"/>
          <BUTTON Id="Copy" Name="Copy" DisplayText="Copy" OnClick="javascript:onCopy()" DisableOnClick="true" Disabled="report"/>
          <BUTTON Id="Delete" Name="Delete" DisplayText="Delete" OnClick="javascript:onDelete()" DisableOnClick="true" Disabled="report"/>
          <DIVIDER/>
          <BUTTON Id="SetContext" Name="SetContext" DisplayText="Set Current Scenario" OnClick="javascript:onSelect()" DisableOnClick="true" Disabled="report"/>
          <DIVIDER/>
          <BUTTON Id="Clear" Name="Clear" DisplayText="Clear" OnClick="javascript:onClear()" DisableOnClick="true"/>
          <BUTTON Id="Search" Name="Search" DisplayText="Search" OnClick="javascript:dispatchSearch()" DisableOnClick="true" Emphasized="yes"/>
        </BUTTONS>
        <PAGINATION/>
      </REPORT>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportData">
    <x2:param name="this"/>
    <!--
    <xapl:variable name="userId">
      <identity:get-user-id/>
    </xapl:variable>
    <docutil:set select="$this">
      <F_ScenarioMaster.CREATED_BY Value="{$userId}"/>
    </docutil:set>
-->
    <xapl:variable name="returnVar">
      <x2:execute command="bcm.scenario.viewScenarios:getFormReportData">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
    </xapl:variable>
    <xapl:return>
      <xapl:value-of select="$returnVar"/>
    </xapl:return>
  </x2:command>
  <!--**********************************************************************
    Nikhil on April 06, 2004: Overriding "getFormReportData" below coz I needed to put a NOT_EQUAL condition on "F_ScenarioMaster.scenarioID"
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getFormReportData">
    <x2:param name="this" select="$this"/>
    <x2:param name="fromProperty" select="'RESULT_PROPERTY'"/>
    <x2:param name="delimeter" select="'.'"/>
    <xapl:print>
        getFormReportData:::::::::::::::::::::::
        $fromProperty=<xapl:value-of select="$fromProperty"/>
        $delimeter=<xapl:value-of select="$delimeter"/>
        FORM=<xapl:value-of select="$this/FORM_NAME/@Value"/>
      <xapl:value-of select="$this"/>
    </xapl:print>
    <xapl:variable name="apiName"/>
    <xapl:set-variable name="apiName">
      <xapl:choose>
        <xapl:when test="string-length($this/API_NAME/@Value) &gt; 0">
          <xapl:value-of select="$this/API_NAME/@Value"/>
        </xapl:when>
        <xapl:otherwise>getFormData</xapl:otherwise>
      </xapl:choose>
    </xapl:set-variable>
    <xapl:variable name="request"/>
    <xapl:set-variable name="request" select="{concat('//' , $this/SERVICE[1]/@Value, '/', $apiName)}"/>
    <xapl:print select="$request"/>
    <xapl:variable name="currentData"/>
    <xapl:choose>
      <xapl:when test="$this/DO_SEARCH[1]/@Value = 'Yes' or $this/DO_SEARCH[1]/@Value = 'yes' ">
        <xapl:set-variable name="filtersApplied">
          <xapl:for-each varName="column" select="$currentForm/*/*[name() = $fromProperty ] ">
            <xapl:variable name="propName" select="$column/@Property"/>
            <xapl:variable name="docName" select="$column/@Document"/>
            <!-- get the type from x-doc-->
            <!-- TODO.. find a easier way to do this -->
            <xapl:variable name="type" select="$metaData/SERVICE[@Name=$this/SERVICE[1]/@Value]/DOCUMENTS/DOCUMENT[ @Name =$column/@Document ]/PROPERTY[@Name = $column/@Property]/@Type "/>
            <!-- construct the filter name -->
            <xapl:variable name="filterName" select="concat('F_',$column/@Document , $delimeter , $column/@Property)"/>
            <xapl:variable name="filterNameForDate" select="concat('F_',$column/@Document , '_', $column/@Property)"/>
            <xapl:if test="{string-length($this/*[name() = $filterName]/@Value) != 0 and ($type = 'string' or $type = 'LongString') }">
              <FILTER Name="{$propName}" Document="{$docName}">
                <xcore:search-by property="{$propName}" value="{$this/*[name() = $filterName]/@Value}"/>
              </FILTER>
            </xapl:if>
            <xapl:if test="{string-length($this/*[name() = $filterName]/@Value) != 0  and ($type = 'int' or $type = 'float' or $type='double')}">
              <FILTER Name="{$propName}" Document="{$docName}">
                <xcore:search-by property="{$propName}" value="{$this/*[name() = $filterName]/@Value}" matchby="{$this/*[name() = concat($filterName , '_OPERATOR')]/@Value}"/>
              </FILTER>
            </xapl:if>
            <xapl:if test="{$type = 'date' or $type = 'datetime'}">
              <xapl:if test="string-length($this/*[name() = concat($filterNameForDate , '_DS')]/@Value) > 0 ">
                <xapl:print select="$this/*[name() = concat($filterNameForDate, '_DS')]/@Value"/>
                <FILTER Name="{$propName}" Document="{$docName}">
                  <xcore:search-by property="{$propName}" value="{$this/*[name() = concat($filterNameForDate, '_DS')]/@Value}" matchby="GREATER_EQUAL"/>
                </FILTER>
              </xapl:if>
              <xapl:if test="string-length($this/*[name() = concat($filterNameForDate , '_DE')]/@Value) > 0 ">
                <xapl:variable name="toDate">
                  <xapl:value-of select="concat($this/*[name() = concat($filterNameForDate, '_DE')]/@Value,' 23:59:59')"/>
                </xapl:variable>
                <xapl:print select="$toDate"/>
                <FILTER Name="{$propName}" Document="{$docName}">
                  <xcore:search-by property="{$propName}" value="{$toDate}" matchby="LESS_EQUAL"/>
                </FILTER>
              </xapl:if>
            </xapl:if>
          </xapl:for-each>
        </xapl:set-variable>
        <xapl:set-variable name="currentData">
          <xcore:execute-method name="{$request}" StartAtRow="{$this/*[name() = 'START_COUNT']/@Value}" MaxRows="{$this/*[name() = 'MAX_ROWS']/@Value}" ReturnRowCount="yes" entireResponse="true">
            <ID Value="{$currentForm/@Id}"/>
            <xapl:value-of select="$filtersApplied"/>
            <xapl:print>
                EXPRESSION FILTERS::
                <xapl:value-of select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/FORM[@Name= $this/FORM_NAME[1]/@Value]/FILTERS/FILTER_DETAILS"/>
            </xapl:print>
            <xapl:if test="count($currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/FORM[@Name= $this/FORM_NAME[1]/@Value]/FILTERS/FILTER_DETAILS) > 0">
              <FILTER_DETAILS>
                <xapl:value-of select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/FORM[@Name= $this/FORM_NAME[1]/@Value]/FILTERS/FILTER_DETAILS/LOGICAL"/>
              </FILTER_DETAILS>
            </xapl:if>
            <xapl:if test="string-length($this/*[name() = 'SORT_BY']/@Value) > 0
                  and $currentForm/RESULT_PROPERTIES/RESULT_PROPERTY
                  [@Property = substring-after( ($this/*[name() = 'SORT_BY']/@Value) , '.' )]
                  and $currentForm/RESULT_PROPERTIES/RESULT_PROPERTY
                  [@Document = substring-before( ($this/*[name() = 'SORT_BY']/@Value) , '.' )]
                  ">
              <ORDER_BY>
                <docutil:element name="{$this/*[name() = 'SORT_BY']/@Value}" Document="{substring-before($this/*[name() = 'SORT_BY']/@Value, '.' )}" Sort="{$this/*[name() = 'SORT_ORDER']/@Value}"/>
              </ORDER_BY>
            </xapl:if>
            <!-- Nikhil on April 06, 2004: Filtering out scenario 0 (zero) if multiple instances are enabled -->
            <xapl:if test="$appInstanceEnabled = 'true' ">
              <FILTER Document="ScenarioMaster" Name="scenarioID">
                <scenarioID Value="0" MatchBy="NOT_EQUAL"/>
              </FILTER>
              <FILTER Document="ScenarioMaster" Name="instanceID">
                <instanceID Value="{$currentInstance}"/>
              </FILTER>
            </xapl:if>
          </xcore:execute-method>
        </xapl:set-variable>
        <!-- Add the total record count  -->
        <docutil:set select="$currentData/RESPONSE">
          <TOTAL_RECORD_COUNT Value="{$currentData/RESPONSE/@TotalRowCount}"/>
          <START_AT_ROW Value="{$this/START_COUNT[position() = 1 ] /@Value}"/>
        </docutil:set>
      </xapl:when>
      <xapl:otherwise/>
    </xapl:choose>
    <xapl:set-variable name="currentFormsData">
      <xapl:value-of select="{$currentData}"/>
    </xapl:set-variable>
    <!--xapl:print>
   @@@@@@@@@@@@@@@@@@@@@@@@@@@ CURRENT FORM DATA IS
    <xapl:value-of select="{$currentData}"/>
  </xapl:print-->
    <xapl:return>
      <xapl:value-of select="$currentData/RESPONSE"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
   *********************************************************************** -->
  <x2:command name="i18n">
    <i18n:text>Current Scenario: </i18n:text>
  </x2:command>
  <!-- **********************************************************************
   *********************************************************************** -->
</x2:commands>
