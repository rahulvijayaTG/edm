<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:bcm="http://www.i2.com/bcm" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:identity="http://www.i2.com/identity" xmlns:i18n="http://www.i2.com/i18n" description="_">
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="init" public="yes" description="_">
    <x2:execute command="bcm.context.controller:defineContext"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="defineContext" public="yes" description="_">
    <xapl:variable name="context" resolver="session" global="true"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="cleanContext">
    <docutil:remove select="$context/*"/>
    <xapl:set-variable name="filterXml"/>
    <xapl:set-variable name="saved_filters"/>
    <xapl:set-variable name="currentPref"/>
    <!-- init the breadcrumbs-->
    <x2:execute command="bcm.framework.breadcrumb.controller:initHeader"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="setCalendarContext">
    <xapl:if test="count($context/*) = 0 ">
      <!-- set sessionals-->
      <xapl:set-variable name="context">
        <HEADER_CONTEXT/>
      </xapl:set-variable>
    </xapl:if>
    <docutil:set select="$context">
      <CALENDAR/>
    </docutil:set>
    <xapl:print>
      <xapl:value-of select="$context"/>
    </xapl:print>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="cleanCalendarContext">
    <docutil:remove select="$context/CALENDAR"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="setDistributionLaneContext">
    <x2:param name="this"/>
    <xapl:if test="count($context/*) = 0 ">
      <!-- set sessionals-->
      <xapl:set-variable name="context">
        <HEADER_CONTEXT/>
      </xapl:set-variable>
    </xapl:if>
    <docutil:set select="$context">
      <DL>
        <xapl:value-of select="$this/ACTION"/>
      </DL>
    </docutil:set>
    <xapl:print>
      <xapl:value-of select="$context"/>
    </xapl:print>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="cleanDistributionLaneContext">
    <docutil:remove select="$context/DL"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="setResourceContext">
    <xapl:if test="count($context/*) = 0 ">
      <!-- set sessionals-->
      <xapl:set-variable name="context">
        <HEADER_CONTEXT/>
      </xapl:set-variable>
    </xapl:if>
    <docutil:set select="$context">
      <RESOURCE/>
    </docutil:set>
    <xapl:print>
      <xapl:value-of select="$context"/>
    </xapl:print>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="cleanResourceContext">
    <docutil:remove select="$context/RESOURCE"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="setLocationContext">
    <xapl:if test="count($context/*) = 0 ">
      <!-- set sessionals-->
      <xapl:set-variable name="context">
        <HEADER_CONTEXT/>
      </xapl:set-variable>
    </xapl:if>
    <docutil:set select="$context">
      <LOCATION/>
    </docutil:set>
    <xapl:print>
      <xapl:value-of select="$context"/>
    </xapl:print>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="cleanLocationContext">
    <docutil:remove select="$context/LOCATION"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="setSCContext">
    <x2:param name="this" select="$this"/>
    <x2:param name="fromPage" select="$fromPage"/>
    <x2:param name="toPage" select="$toPage"/>
    <xapl:print>
      BEFORE  setSCContext   :::
      <xapl:value-of select="$context"/>
    </xapl:print>
    <xapl:if test="count($context/*) = 0 ">
      <!-- set sessionals-->
      <xapl:set-variable name="context">
        <HEADER_CONTEXT>
          <SUPPLY_CHAIN/>
        </HEADER_CONTEXT>
      </xapl:set-variable>
    </xapl:if>
    <docutil:set select="$context/SUPPLY_CHAIN">
      <FROM_PAGE Value="{$fromPage}"/>
      <TO_PAGE Value="{$toPage}"/>
      <!-- put all the sessional data of context-->
      <xapl:value-of select="$this/*"/>
    </docutil:set>
    <xapl:print>
      AFTER  setSCContext   :::
      <xapl:value-of select="$context"/>
    </xapl:print>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="cleanSCContext">
    <docutil:remove select="$context/SUPPLY_CHAIN"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="setOperationContext">
    <x2:param name="this" select="$this"/>
    <x2:param name="fromPage" select="$fromPage"/>
    <x2:param name="toPage" select="$toPage"/>
    <xapl:if test="count($context/*) = 0 ">
      <!-- set sessionals-->
      <xapl:set-variable name="context">
        <HEADER_CONTEXT/>
      </xapl:set-variable>
    </xapl:if>
    <docutil:set select="$context">
      <OPERATION>
        <FROM_PAGE Value="{$fromPage}"/>
        <TO_PAGE Value="{$toPage}"/>
        <!-- put all the sessional data of context-->
        <xapl:value-of select="$opDetails/*"/>
      </OPERATION>
    </docutil:set>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="cleanOperationContext">
    <docutil:remove select="$context/OPERATION"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="setRoutingContext">
    <x2:param name="this" select="$this"/>
    <x2:param name="fromPage" select="$fromPage"/>
    <x2:param name="toPage" select="$toPage"/>
    <x2:param name="MODE" select="$MODE"/>
    <xapl:if test="count($context/*) = 0 ">
      <!-- set sessionals-->
      <xapl:set-variable name="context">
        <HEADER_CONTEXT/>
      </xapl:set-variable>
    </xapl:if>
    <docutil:set select="$context">
      <ROUTING>
        <MODE Value="{$MODE}"/>
        <FROM_PAGE Value="{$fromPage}"/>
        <TO_PAGE Value="{$toPage}"/>
        <!-- put all the sessional data of context-->
        <xapl:value-of select="$routopData/HEADER_DATA/*"/>
      </ROUTING>
    </docutil:set>
    <xapl:print>ROUTINGCONTEXT<xapl:value-of select="$context"/>
    </xapl:print>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="cleanRoutingContext">
    <docutil:remove select="$context/ROUTING"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="setBORContext">
    <x2:param name="this" select="$this"/>
    <x2:param name="fromPage" select="$fromPage"/>
    <x2:param name="toPage" select="$toPage"/>
    <x2:param name="MODE" select="$MODE"/>
    <xapl:if test="count($context/*) = 0 ">
      <!-- set sessionals-->
      <xapl:set-variable name="context">
        <HEADER_CONTEXT/>
      </xapl:set-variable>
    </xapl:if>
    <xapl:print>controller.context.bor<xapl:value-of select="$borresdata"/>
    </xapl:print>
    <docutil:set select="$context">
      <BOR>
        <MODE Value="{$MODE}"/>
        <FROM_PAGE Value="{$fromPage}"/>
        <TO_PAGE Value="{$toPage}"/>
        <!-- put all the sessional data of context-->
        <BORID Value="{$borresdata/BORID/@Value}"/>
        <name Value="{$borresdata/name/@Value}"/>
        <description Value="{$borresdata/description/@Value}"/>
        <locationID Value="{$borresdata/locationID/@Value}"/>
      </BOR>
    </docutil:set>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="cleanBORContext">
    <docutil:remove select="$context/BOR"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="setRESALT">
    <x2:param name="this" select="$this"/>
    <x2:param name="fromPage" select="$fromPage"/>
    <x2:param name="toPage" select="$toPage"/>
    <x2:param name="MODE" select="$MODE"/>
    <xapl:if test="count($context/*) = 0 ">
      <!-- set sessionals-->
      <xapl:set-variable name="context">
        <HEADER_CONTEXT/>
      </xapl:set-variable>
    </xapl:if>
    <docutil:set select="$context">
      <RESALT>
        <MODE Value="{$MODE}"/>
        <FROM_PAGE Value="{$fromPage}"/>
        <TO_PAGE Value="{$toPage}"/>
        <!-- put all the sessional data of context-->
        <resourceAlternatesID Value="{$resdata1/RES_ALT_HEADER/resourceAlternatesID/@Value}"/>
        <name Value="{$resdata1/RES_ALT_HEADER/name/@Value}"/>
      </RESALT>
    </docutil:set>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="cleanRESALTContext">
    <docutil:remove select="$context/RESALT"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="setBodContext">
    <x2:param name="fromPage"/>
    <x2:param name="toPage"/>
    <x2:param name="pBodAction"/>
    <xapl:print select="{$this}"/>
    <xapl:print select="{$fromPage}"/>
    <xapl:print select="{$toPage}"/>
    <xapl:print select="{$pBodAction}"/>
    <xapl:if test="count($context/*) = 0 ">
      <xapl:set-variable name="context">
        <HEADER_CONTEXT/>
      </xapl:set-variable>
    </xapl:if>
    <docutil:set select="$context">
      <BOD>
        <FROM_PAGE Value="{$fromPage}"/>
        <TO_PAGE Value="{$toPage}"/>
        <BOD_ACTION Value="{$pBodAction}"/>
      </BOD>
    </docutil:set>
    <xapl:print select="{$context}"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="cleanBodContext">
    <docutil:remove select="$context/BOD"/>
    <xapl:print select="{$context}"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
</x2:commands>
