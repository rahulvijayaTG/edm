<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- **********************************************************************
       *********************************************************************** -->

  <x2:command public="yes" description="_" name="load">
    <!-- BREADCRUMBS AT TOP OR AFTER CLEAN-CONTEXT-->
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
      <x2:with-param name="display" select="'Calendar Entry'"/>
      <x2:with-param name="page" select="'calendarEntry'"/>
      <x2:with-param name="this" select="{$this}"/>
    </x2:execute>
    <xapl:print select="$this"/>

    <xapl:return>

      <!-- Page Header-->
      <x2:execute command="bcm.calendar.entry.view:getHeader">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>

     <!-- Top Level Container -->
      <x2:execute command="bcm.calendar.entry.view:getContainer">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>

      <!-- All Details -->
      <x2:execute command="bcm.calendar.entry.view:getDetails">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>



      <!-- Pattern Tabs -->
      <x2:execute command="bcm.calendar.entry.view:getPatternTabs">
        <x2:with-param name="this" select="$this"/>
        <x2:with-param name="pPage" select=" 'calendar_entry_basic_pattern' "/>
      </x2:execute>

      <!-- Attribute Tabs -->
      <x2:execute command="bcm.calendar.entry.view:getAttributeTabs">
        <x2:with-param name="this" select="$this"/>
        <x2:with-param name="pPage" select=" 'calendar_entry_basic_attribute' "/>
      </x2:execute>

        <xapl:variable name="dateFormat">
          <identity:get-date-format format="common"/>
        </xapl:variable>    
        <docutil:set select="$this">
          <FORMAT Date="{$dateFormat}"/>
        </docutil:set>


      <xapl:value-of select="$this/*"/>


    </xapl:return>
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">

    <xapl:return>
     <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
    </xapl:return>

  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">

    <xapl:return>
      <CONTAINER Scrollable="yes">
        <HELP Url="../help/calendar_entry_help.htm"/>
        <STEP
          Name="CalendarEntry"
          DisplayText="Calendar Entry"
          Selected="true"
        />
        <BUTTONS>
		<xapl:variable name="userPermissionUpdateForbcmManageCalendar">
			<x2:execute command="bcm.framework.common:checkAccessPermissions">
			 <x2:with-param name="activityName" select="'bcmManageCalendar'"/>
			 <x2:with-param name="accessLevel" select="'Update'"/>
			</x2:execute>
		</xapl:variable>              
		<xapl:variable name="userPermissionAddForbcmManageCalendar">
			<x2:execute command="bcm.framework.common:checkAccessPermissions">
			 <x2:with-param name="activityName" select="'bcmManageCalendar'"/>
			 <x2:with-param name="accessLevel" select="'Add'"/>
			</x2:execute>
		</xapl:variable>        
	      <BUTTON Id="cancel_button" Name="Cancel" DisplayText="Cancel" OnClick="javascript:onCancel()"/>
              <xapl:choose>
                <xapl:when test="$context/CALENDAR/ENTRY_STATE/@Value = 'EDIT' ">
                	<xapl:if test="$userPermissionUpdateForbcmManageCalendar='True'">  
                		<DIVIDER/>
                  		<BUTTON Id="add_button" Name="Add" DisplayText="Save And Return" OnClick="javascript:onEditSaveAndReturn()"/>
                  	</xapl:if>
                </xapl:when>
                <xapl:otherwise>
                	<xapl:if test="$userPermissionAddForbcmManageCalendar='True'">  
                	  <DIVIDER/>
                	  <BUTTON Id="add_button" Name="Add" DisplayText="Save And Return" OnClick="javascript:onSaveAndReturn()"/>
                	</xapl:if>  
                </xapl:otherwise>
              </xapl:choose>
         </BUTTONS>
      </CONTAINER>
    </xapl:return>
  </x2:command>
   <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getPatternTabs">
    <x2:param name="this"/>
    <x2:param name="pPage"/>

    <xapl:variable name="url"/>


    <!-- Tabs -->
    <xapl:return>
     <PATTERN>
      <CONTAINER  Scrollable="no">
        <!-- Basic Patterns -->
        <STEP DisplayText="Patterns"  Selected="true">
        </STEP>
        <!-- Advance Patterns -->
        <!--xapl:set-variable name="url">
          <web:get-page name="calendar_entry_advance_pattern">
          </web:get-page>
        </xapl:set-variable>
        <STEP DisplayText="Advance Patterns" OnClick="{$url}" Selected="{$pPage = 'calendar_entry_advance_pattern'}">
        </STEP-->
      </CONTAINER>
     </PATTERN>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
     *********************************************************************** -->  
  <x2:command public="yes" description="_" name="getAttributeTabs">
    <x2:param name="this"/>
    <x2:param name="pPage"/>

    <xapl:variable name="url"/>

    <!-- Tabs -->
    <xapl:return>
     <ATTRIBUTE Type="{$this/calendarTypeID/@Value}">
      <CONTAINER  Scrollable="no">
        <!-- Basic Attributes -->
        <STEP DisplayText="Attributes"  Selected="true">
        </STEP>
        <!-- Advance Attributes -->
        <!--xapl:set-variable name="url">
          <web:get-page name="calendar_entry_advance_attribute">
          </web:get-page>
        </xapl:set-variable>
        <STEP DisplayText="Advance Attributes" OnClick="{$url}" Selected="{$pPage = 'calendar_entry_advance_attribute'}">
        </STEP-->
      </CONTAINER>
      <!-- Return the Dynamic Columns -->
      <xapl:value-of select="$appCalendarDetailColumns/calendarTypeID[@Value = $this/calendarTypeID/@Value]/*"/>
     </ATTRIBUTE>
    </xapl:return>
  </x2:command>
 <!-- **********************************************************************
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="getDetails">
    <x2:param name="this"/>
    
    <xapl:variable name="entry">
      <CALENDAR_ENTRY>
         <ENTRY_HEADER>
            <xapl:choose>
              <xapl:when test="string-length($context/CALENDAR/ENTRY_STATE/@Value) > 0">
                 <MODE Value="{$context/CALENDAR/ENTRY_STATE/@Value}"/>
              </xapl:when>
              <xapl:otherwise>
              </xapl:otherwise>
            </xapl:choose>
        </ENTRY_HEADER>
     </CALENDAR_ENTRY>
   </xapl:variable>

    <xapl:print>*********** IN CALENDAR GET DETAILS %%%%%%%%%%%%%</xapl:print>
    <xapl:print select="$entry"/>

    <xapl:return>

       <xapl:value-of select="$entry"/>

    </xapl:return>
  </x2:command>
  
  


<!-- ********************************************************************** 
     *********************************************************************** -->
</x2:commands>
