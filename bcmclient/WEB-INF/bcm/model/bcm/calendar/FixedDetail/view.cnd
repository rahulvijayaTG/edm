<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- **********************************************************************
  *********************************************************************** -->
  
  <x2:command public="yes" description="_" name="load">
    <!-- BREADCRUMBS AT TOP OR AFTER CLEAN-CONTEXT-->
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
      <x2:with-param name="display" select="'Fixed Calendar Detail'"/>
      <x2:with-param name="page" select="'calendarFixedDetail'"/>
      <x2:with-param name="this" select="{$this}"/>
    </x2:execute>
    <xapl:print>
    PRINTING THIS
      <xapl:value-of select="$this"/>
      PRINTING CONTEXT
      <xapl:value-of select="$context"/>
    </xapl:print>
    <docutil:set select="$this">
      <FORM_NAME Value="CALENDAR_FIXED_DETAIL_FORM"/>
      <FORM_ID Value="CALENDAR_FIXED_DETAIL_FORM"/>
      <PAGE Value="calendarFixedDetail"/>
      <SERVICE Value="BCMMasterService"/>
    </docutil:set>
    <xapl:choose>
      <xapl:when test="$context/RESOURCE">
        <docutil:set select="$this">
          <F_CalendarMaster.calendarTypeID Value="RESOURCE"/>
        </docutil:set>
        <docutil:set select="$context/RESOURCE">
          <name Value="{$resDetails/name/@Value}"/>
          <description Value="{$resDetails/description/@Value}"/>
        </docutil:set>
      </xapl:when>
      <xapl:when test="$context/DL">
        <docutil:set select="$this">
          <F_CalendarMaster.calendarTypeID Value="DL"/>
        </docutil:set>
        <docutil:set select="$context/DL">
          <name Value="{$distributionLaneDetails/name/@Value}"/>
          <description Value="{$distributionLaneDetails/description/@Value}"/>
        </docutil:set>
      </xapl:when>
      <xapl:when test="$context/LOCATION">
        <docutil:set select="$this">
          <F_CalendarMaster.calendarTypeID Value="LOCATION"/>
        </docutil:set>
      </xapl:when>
      <xapl:otherwise/>
    </xapl:choose>
    
    <xapl:choose>
        <xapl:when test="string-length($this/cal_startDate/@Value) > 0">
        </xapl:when>
        <xapl:otherwise>
            <docutil:set select="$this">
              <cal_startDate Value="{current-date()}"/>
            </docutil:set>
        </xapl:otherwise>
    </xapl:choose>
    
    <x2:execute command="bcm.framework.queryform.Form:create">
      <x2:with-param name="pFormName" select="$this/FORM_NAME/@Value"/>
      <x2:with-param name="pServiceName" select="$this/SERVICE/@Value"/>
    </x2:execute>
    
    <xapl:print>Before executing getcalbasedatt</xapl:print>
		<x2:execute command="bcm.cm:getCalBasedAttributesForCalTypes"/>
		<xapl:print>'PRINTING CalendarDetailsColumns'</xapl:print>
    <xapl:print select="$appCalendarDetailColumns"/>

    <xapl:variable name="form">
      <x2:execute command="bcm.calendar.FixedDetail.controller:getFormContainer">
        <x2:with-param name="this" select="$this"/>
        <x2:with-param name="pFormName" select=" $this/FORM_NAME/@Value "/>
        <x2:with-param name="pServiceName" select="$this/SERVICE/@Value"/>
        <x2:with-param name="pSearchReportConfigSource" select="'bcm.calendar.FixedDetail.view:getReportConfig'"/>
        <x2:with-param name="pReportDataSource" select="'bcm.calendar.FixedDetail.view:getReportData'"/>
      </x2:execute>
    </xapl:variable>
    
    <!--xapl:for-each select="$form/SEARCH/REPORT/TABLE/TR" varName="child">
        <xapl:if test="$child/@Header"> 
        <xapl:variable name="newVal" select="substring-before($child/TD/@Value, ' ')"/>
            <docutil:set select="$child/TD/@Value" >
              <xapl:value-of select="$newVal"/>
            </docutil:set>
            </xapl:if>
    </xapl:for-each>
    <xapl:print> Value of form </xapl:print>
    <xapl:print select="$form"/-->
    
 
    <xapl:variable name="dateFormat">
      <identity:get-date-format format="common"/>
    </xapl:variable>
    <xapl:if test="count($appCalEntriesEffStartDate/RESPONSE/HorizonDetail) = 0">
        <xapl:variable name="i18nMsg">
            <i18n:text>The given start date is outside the horizon</i18n:text>
        </xapl:variable>
        <docutil:set select="$this">
              <ERROR_MESSAGE Value="{$i18nMsg}"/>
        </docutil:set>   
    </xapl:if>
    <!--Chandru: Clean up entries in xapl:return-->
    <xapl:return>
      <!-- Page Header-->
      <x2:execute command="bcm.calendar.FixedDetail.view:getHeader">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
      <!-- Container-->
      <x2:execute command="bcm.calendar.FixedDetail.view:getContainer">
        <x2:with-param name="this" select="$this"/>
        <x2:with-param name="pPage" select="'calendarFixedDetail'"/>
      </x2:execute>
      <!-- Cal Header -->
      <CALENDAR_HEADER>
        <!--return context-->
        <xapl:value-of select="$context/CALENDAR/*"/>
        <x2:execute command="bcm.cm:getQtyUOMs"/>
        <x2:execute command="bcm.cm:getCalendarTypesValidValues"/>
      </CALENDAR_HEADER>
      <!-- Search / Form and Report -->
      <xapl:value-of select="$form"/>
      <!-- return parameters-->
        <calBasedAttforCalTypes>
        <xapl:value-of select="$appCalendarDetailColumns/calendarTypeID[@Value = $context/CALENDAR/calendarTypeID/@Value]/*"/>
        </calBasedAttforCalTypes>
      <xapl:value-of select="$this/*"/>
      <xapl:value-of select="$context"/>
      <DateFormat Value="{$dateFormat}"/>
    </xapl:return>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    <!-- change the header home -->
    <xapl:return>
      <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <x2:param name="pPage"/>
    <x2:param name="this"/>
    <xapl:print>PRINTING THIS IN GET CONTAINER</xapl:print>
    <xapl:print select="$this"/>
    <xapl:return>
      <CONTAINER Scrollable="no">
        <STEP Name="ViewForm" DisplayText="Calendar Entry Details" OnClick="{$pages:calendarFixedDetail}" Selected="{$pPage = 'calendarFixedDetail'}"/>
      </CONTAINER>
    </xapl:return>
  </x2:command>

 <!-- **********************************************************************
  *********************************************************************** -->  
  
  <x2:command public="yes" description="_" name="getReportConfig">
    <x2:param name="this"/>
    <!-- get the dynamic columns from server -->
    <xapl:set-variable name="appCalEntriesEffStartDate">
        <xcore:execute-method name="//BCMMasterService/getEffStartDatesforHorizon" entireResponse="true">
          <calendarID Value="{$context/CALENDAR/calendarID/@Value}"/>
          <horizonID Value="{$context/CALENDAR/horizonID/@Value}"/>
          <bucketType Value="{$context/CALENDAR/bucketType/@Value}"/>
          <bucketStartDate Value="{$this/cal_startDate/@Value}"/>
        </xcore:execute-method>
    </xapl:set-variable>
    <xapl:print>'PRINTING appCalEntriesEffStartDate'</xapl:print>
    <xapl:print select="$appCalEntriesEffStartDate"/>
    <xapl:variable name="fieldReturn">
      <REPORT Title="Fixed Calendar Detail" Method="POST" Scrollable="yes" ScrollableContainer="no" Id="FixedcalendarEntryID" ShowFilter="no">
        <FIELDS>
          <OVERRIDDEN Value="yes"/>
          <!--get form's report fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportFieldsByProperty">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
          <FIELD Sequence="1" Name="calAttrName" DisplayText="Attribute Name" DisplayType="Hidden" DisplayNoWrap="yes" Editable="no"/>
          <!-- ADD DYNAMIC FIELDS-->
          <xapl:variable name="bucketSeq" select="0"/>
          <xapl:for-each varName="child" select="$appCalEntriesEffStartDate/RESPONSE/HorizonDetail">
            <xapl:set-variable name="bucketSeq" select="$bucketSeq + 1"/>
            <xapl:variable name="fieldName">
                <xapl:value-of select="concat('BCK_',$bucketSeq)"/>
            </xapl:variable>    
            <!--xapl:variable fieldName="$child/effectiveStartDate/@Value"/-->
            <xapl:variable name="formattedDate">
              <i18n:date unformat="true" format="common">
                <xapl:value-of select="$child/effectiveStartDate/@Value"/>
              </i18n:date>
            </xapl:variable>
            <FIELD Sequence="{$bucketSeq}" Name="{$fieldName}" DisplayText="{$formattedDate}" DisplayType="Text" DisplayNoWrap="yes" Editable="yes" MaxLength="64"/>
          </xapl:for-each>
    <!-- get Hidden Fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
          <!-- additional feidls -->
          <FIELD Name="CalendarMaster.calendarID" DisplayType="Hidden" Value="{$context/CALENDAR/calendarID/@Value}"/>
          <FIELD Name="name" DisplayType="Hidden" Value="{$context/CALENDAR/name/@Value}"/>
          <FIELD Name="cal_startDate" DisplayType="Hidden" Value="{$this/cal_startDate/@Value}"/>
          <FIELD Name="calendarTypeID" DisplayType="Hidden" Value="{$this/calendarTypeID/@Value}"/>
        </FIELDS>
        <BUTTONS>
                <!--BUTTON Id="Calendar Setup" Name="CalSetup" DisplayText="Calendar Setup" OnClick="javascript:onCalSetup()" DisableOnClick="true"/-->
          <xapl:choose>
            <xapl:when test="$context/RESOURCE or $context/LOCATION or $context/DL">
            <BUTTON Id="cancel" Name="cancel" DisplayText="Cancel" OnClick="javascript:onReturnToContext()" DisableOnClick="true"/>
            </xapl:when>
            <xapl:otherwise>
            <BUTTON Id="cancel" Name="cancel" DisplayText="Cancel" OnClick="javascript:onCancel()" DisableOnClick="true"/>
            </xapl:otherwise>
          </xapl:choose>
        
        <xapl:variable name="userPermissionAddForbcmManageCalendar">
            <x2:execute command="bcm.framework.common:checkAccessPermissions">
             <x2:with-param name="activityName" select="'bcmManageCalendar'"/>
             <x2:with-param name="accessLevel" select="'Add'"/>
            </x2:execute>
        </xapl:variable>          
        <xapl:variable name="userPermissionUpdateForbcmManageCalendar">
            <x2:execute command="bcm.framework.common:checkAccessPermissions">
             <x2:with-param name="activityName" select="'bcmManageCalendar'"/>
             <x2:with-param name="accessLevel" select="'Update'"/>
            </x2:execute>
        </xapl:variable>   

        <xapl:if test="$userPermissionAddForbcmManageCalendar='True' or $userPermissionUpdateForbcmManageCalendar='True'">                      

          <BUTTON Id="save" Name="save" DisplayText="Save" OnClick="javascript:onSave()" DisableOnClick="true" Emphasized="true"/>
        </xapl:if>
        </BUTTONS>
        <PAGINATION/>
      </REPORT>
      </xapl:variable>
      <xapl:print select="$fieldReturn"/>
    <xapl:return>
    	<xapl:value-of select="$fieldReturn"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportData">
    <x2:param name="this"/>
    <xapl:variable name="serverResponse">
      <xapl:if test="string-length($context/CALENDAR/calendarID/@Value) >0">
        <xcore:execute-method name="//BCMMasterService/getFixedCalDetails" entireResponse="true">
          <calendarID Value="{$context/CALENDAR/calendarID/@Value}"/>
          <calendarTypeID Value="{$context/CALENDAR/calendarTypeID/@Value}"/>
          <horizonID Value="{$context/CALENDAR/horizonID/@Value}"/>
          <bucketType Value="{$context/CALENDAR/bucketType/@Value}"/>
          <bucketStartDate Value="{$this/cal_startDate/@Value}"/>
        </xcore:execute-method>
      </xapl:if>
    </xapl:variable>
    
    <xapl:print>'PRINTING serverResponse inside FixedDetail view'</xapl:print>
    <xapl:print select="$serverResponse"/>
  
  <!--docutil:set select="$context/CALENDAR">
      <CALENDAR_DETAILS>
        <xapl:value-of select="$serverResponse/RESPONSE/*"/>
      </CALENDAR_DETAILS>
    </docutil:set-->
     
    <xapl:return>
      <xapl:value-of select="$serverResponse/RESPONSE"/>
    </xapl:return>
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
</x2:commands>

