<?xml version="1.0" encoding="UTF-8"?>
  <x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:identity="http://www.i2.com/identity" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" description="_">
        <!-- **********************************************************************
        *********************************************************************** -->
    <x2:command name="saveFixedCalDetails" public="yes" description="_">
        <xapl:print>Inside saveFixedCalDetails</xapl:print>
        <xapl:print select="$this"/>
        <!--EQ:570861 Removing the first calendarAttrib entry -->
        <docutil:remove select="$this/calAttrName[1]"/>        
				<!--docutil:remove select="$this/*[@Value = '']"/--> 
        <xapl:variable name="bucketDetails">
            <BUCKET_IDS/>
        </xapl:variable>
        <xapl:print select="$appCalEntriesEffStartDate"/>
        <xapl:for-each select="$appCalEntriesEffStartDate/RESPONSE/HorizonDetail" varName="horizon">
            <xapl:print select="$horizon"/>
            <xapl:variable name="bucketId">
                <xapl:value-of select="$horizon/bucketID/@Value"/>
             </xapl:variable>   
            <docutil:add select="$bucketDetails">
                <BucketId Value="{$bucketId}"/>
            </docutil:add>
        </xapl:for-each>
        <xapl:print select="$bucketDetails"/>
        <xapl:variable name="fixedCalDetailValues">
          <docutil:collate name="FixedCalAttributeValues" rootName="FixedCalAttributeDetails">
            <xapl:value-of select="$this/calAttrName"/>
            <xapl:value-of select="$this/BCK_1"/>
            <xapl:value-of select="$this/BCK_2"/>
            <xapl:value-of select="$this/BCK_3"/>
            <xapl:value-of select="$this/BCK_4"/>
            <xapl:value-of select="$this/BCK_5"/>
            <xapl:value-of select="$this/BCK_6"/>
          </docutil:collate>
          </xapl:variable>
         <xapl:variable name="fixedCalBucketDetails">
            <xapl:clone select="$fixedCalDetailValues"/>
         </xapl:variable>
         <docutil:remove select="$fixedCalBucketDetails/FixedCalAttributeValues/*[substring-before(name() ,  '_'  )  = 'BCK'  ]"/>
         <xapl:variable name="caldetailPos" select="1"/>
         <xapl:for-each select="$fixedCalDetailValues/FixedCalAttributeValues" varName="caldetail">
            <xapl:print select="$caldetailPos"/>
            <xapl:for-each select="$caldetail/*" varName="bckdetail">
                    <xapl:if test="$bckdetail[substring-before(name() ,  '_'  )  = 'BCK' ]">
                        <xapl:variable name="bckdetailstr">
                              <docutil:xml-to-string>
                                <xapl:value-of select="{$bckdetail}"/>
                              </docutil:xml-to-string>
                         </xapl:variable>         
                        <xapl:print select="{substring-before(substring-after($bckdetailstr ,  'BCK_'  ),' Value')}"/>
                        <xapl:variable name="pos" select="{substring-before(substring-after($bckdetailstr ,  'BCK_'  ),' Value')}"/>
                        <xapl:if test="string-length($pos)> 0">
                            <xapl:print select="$pos"/>
                            <xapl:print>
                                <xapl:value-of select="{$fixedCalDetailValues/FixedCalAttributeValues[position()=1]}"/>
                            </xapl:print>
                            <xapl:variable name="elname" select="{$bucketDetails/BucketId[position()=$pos]/@Value}"/>
                            <xapl:print select="$elname"/>
                            <docutil:add select="$fixedCalBucketDetails/FixedCalAttributeValues[position()=int($caldetailPos)]">
                                <docutil:element name="calAttrValue" AttrName="{$elname}" Value="{$bckdetail/@Value}"/>
                            </docutil:add>
                        </xapl:if>
                    </xapl:if>
            </xapl:for-each>
            <xapl:set-variable name="caldetailPos" select="$caldetailPos + 1"/>
         </xapl:for-each>
         
        <xapl:print select="$fixedCalDetailValues"/>
        <xapl:print select="$fixedCalBucketDetails"/>
        <xapl:print select="$appCalEntriesEffStartDate/RESPONSE/HorizonDetail/bucketID/@Value"/>
        <xapl:variable name="FixedCalSaveReqDetails">
            <FIXED_CAL_DETAILS>
                <CalendarHeader>
                    <id Value="{$this/CalendarMaster.calendarID/@Value}"/>
                    <name Value="{$this/name/@Value}"/>
                </CalendarHeader>
                <CalendarDetails>
                    <xapl:value-of select="$appCalEntriesEffStartDate/RESPONSE/*"/>
                </CalendarDetails>    
                <xapl:value-of select="$fixedCalBucketDetails"/>
            </FIXED_CAL_DETAILS>
        </xapl:variable>
        <xapl:print select="$FixedCalSaveReqDetails"/>
        <xapl:variable name="calSaveRes">
            <xcore:execute-method name="//BCMMasterService/saveFixedCalendarDetails" entireResponse="true">
                <xapl:value-of select="$FixedCalSaveReqDetails"/>
            </xcore:execute-method>
        </xapl:variable>
        <xapl:print select="$calSaveRes"/>
        
        <xapl:variable name="i18nSuccessMsg">
            <i18n:text>Calendar entry details are saved successfully.</i18n:text>
        </xapl:variable>
        
        <xapl:variable name="status">
              <x2:execute command="bcm.framework.util:getResponseStatus">
                    <x2:with-param name="response" select="$calSaveRes"/>
                    <x2:with-param name="successMessage" select="$i18nSuccessMsg"/>
              </x2:execute>
        </xapl:variable>      
        <!--EQ:570861 Removing the entries with null value to avoid page not displayed error !!-->
        <docutil:remove select="$this/*[@Value = '']"/> 
        <web:display-page>
            <web:get-page name="calendarFixedDetail">
                <xapl:value-of select="$status"/>
                <cal_startDate Value="{$this/cal_startDate/@Value}" />
								<pagenum Value="{$this/pagenum/@Value}"/>
								<CalendarMaster.calendarID Value="{this/CalendarMaster.calendarID/@Value}" />
								<name Value="{$this/name/@Value}" />
								<calendarTypeID Value="{$this/calendarTypeID/@Value}"/>
				     </web:get-page>
        </web:display-page>
    </x2:command>
<!-- **********************************************************************
*********************************************************************** -->   
    <x2:command name="showFixedCalDetails" public="yes" description="_">
        <web:display-page>
            <web:get-page name="calendarFixedDetail">
                <xapl:value-of select="$this/*"/>
             </web:get-page>
        </web:display-page>
    </x2:command>

    <x2:command name="massUpdateFixedCalAttribute" public="yes" description="_">
        <xapl:print>Inside massUpdateFixedCalAttribute</xapl:print>
        <xapl:print select="$this"/>

        <xapl:variable name="massUpdateReqDetails">
           <fixedCalMassUpdate> 
                <calendarHeader>
                  <calendarID Value="{$context/CALENDAR/calendarID/@Value}"/>
                  <name Value="{$context/CALENDAR/name/@Value}"/>
                  <calendarTypeID Value="{$context/CALENDAR/calendarTypeID/@Value}"/>
                  <class Value="{$context/CALENDAR/class/@Value}"/>
                  <horizonID Value="{$context/CALENDAR/horizonID/@Value}"/>
                  <bucketType Value="{$context/CALENDAR/bucketType/@Value}"/>                
                </calendarHeader>
                <updateDetails>
                    <startDate Value="{$this/startDate/@Value}"/>
                    <endDate Value="{$this/endDate/@Value}"/>
                    <attributeId Value="{$this/entryAtt/@Value}"/>
                    <attributeValue Value="{$this/entryValue/@Value}"/>
                </updateDetails>
           </fixedCalMassUpdate> 
        </xapl:variable>
        
        <xapl:variable name="massUpdateRes">
            <xcore:execute-method name="//BCMMasterService/massUpdateFixedCalendarDetails" entireResponse="true">
                <xapl:value-of select="$massUpdateReqDetails"/>
            </xcore:execute-method>
        </xapl:variable>
        <xapl:print>mass update res!
            <xapl:value-of select="$massUpdateRes"/>
        </xapl:print>

        <xapl:variable name="i18nErrorMsg">
            <i18n:text>No buckets found for mass update.</i18n:text>
        </xapl:variable>
        <xapl:variable name="i18nSuccessMsg">
            <i18n:text>Mass update is done successfully.</i18n:text>
        </xapl:variable>
        
        <xapl:variable name="status">
               <xapl:choose>
                    <xapl:when test="$massUpdateRes/RESPONSE/_RESULT/@Value='ERROR'">
                        <ERROR_MESSAGE Value="{$i18nErrorMsg}"/>
                    </xapl:when>
                    <xapl:otherwise>
                          <x2:execute command="bcm.framework.util:getResponseStatus">
                                <x2:with-param name="response" select="$massUpdateRes"/>
                                <x2:with-param name="successMessage" select="$i18nSuccessMsg"/>
                          </x2:execute>
                    </xapl:otherwise>
               </xapl:choose>
        </xapl:variable>        
        
        <web:display-page>
            <web:get-page name="calendarFixedDetail">
                <xapl:value-of select="$status"/>
                <xapl:value-of select="$this/*"/>
             </web:get-page>
        </web:display-page>
    </x2:command>
 <!-- **********************************************************************
 *********************************************************************** -->

    <x2:command name="showCalendarSetup" public="yes" description="_">
        <web:display-page>
            <web:get-page name="calendarDetail">
                <xapl:value-of select="$this/*"/>
             </web:get-page>
        </web:display-page>
    </x2:command>
<!-- **********************************************************************
 *********************************************************************** -->
<x2:command public="yes" description="_" name="getFormContainer">
    <x2:param name="this" select="$this"/>
    <x2:param name="pFormName" select="{$pFormName}"/>
    <x2:param name="pSearchParam" select="{$searchParam}"/>
    <x2:param name="pServiceName" select="{$pServiceName}"/>
    <x2:param name="pSearchFormConfigSource" select="{$pSearchFormConfigSource}"/>
    <x2:param name="pSearchReportConfigSource" select="{$pSearchReportConfigSource}"/>
    <x2:param name="pReportDataSource" select="{$pReportDataSource}"/>
    <!-- remove form and service names from this -->
    <docutil:remove select="$this/FORM_NAME"/>
    <docutil:remove select="$this/SERVICE"/>
    <xapl:print>
        $$$$$$$$$$$$$$$$$$$$$ FORM NAME =
        <xapl:value-of select="$pFormName"/>
        $$$$$$$$$$$$$$$$$$$$$ SERVICE NAME =
        <xapl:value-of select="$pServiceName"/>
    </xapl:print>
    <xapl:print>*******this********</xapl:print>
    <xapl:print select="$this"/>
    <!-- set in this the service name and form name -->
    <docutil:add select="$this">
      <FORM_NAME Value="{$pFormName}"/>
      <SERVICE Value="{$pServiceName}"/>
    </docutil:add>
    <xapl:choose>
      <xapl:when test="$this/USE_OLD_FILTER/@Value = 'TRUE'">
        <xapl:choose>
          <xapl:when test="string-length($this/FAV_ID/@Value) > 0">
            <x2:execute command="bcm.framework.user_preferences.controller:updateAndApplyUserPreferencesForForms">
              <x2:with-param name="this" select="{$this}"/>
            </x2:execute>
          </xapl:when>
          <xapl:otherwise>
            <!-- apply old user preferences -->
            <docutil:set select="$this">
              <xapl:value-of select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/FORM[@Name= $this/FORM_NAME[1]/@Value]/FILTERS/*"/>
            </docutil:set>
            <xapl:if test="string-length($currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/FORM[@Name= $this/FORM_NAME[1]/@Value]/FROZEN_SEQUENCES/FROZEN_SEQUENCE/@Value) != -999 ">
              <docutil:set select="$this">
                <FROZEN_SEQUENCE Value="{$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/FORM[@Name= $this/FORM_NAME[1]/@Value]/FROZEN_SEQUENCES/FROZEN_SEQUENCE/@Value}"/>
              </docutil:set>
            </xapl:if>
          </xapl:otherwise>
        </xapl:choose>
      </xapl:when>
      <xapl:otherwise>
        <!-- update user preferences -->
        <x2:execute command="bcm.framework.user_preferences.controller:updateAndApplyUserPreferencesForForms">
          <x2:with-param name="this" select="{$this}"/>
        </x2:execute>
      </xapl:otherwise>
    </xapl:choose>
    <!-- COLUMN FREEZE -->
    <xapl:if test="string-length($currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/FORM[@Name= $this/FORM_NAME[1]/@Value]/FROZEN_SEQUENCES/FROZEN_SEQUENCE/@Value) > -1">
      <docutil:set select="$this">
        <FROZEN_SEQUENCE Value="{$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/FORM[@Name= $this/FORM_NAME[1]/@Value]/FROZEN_SEQUENCES/FROZEN_SEQUENCE/@Value}"/>
      </docutil:set>
      <xapl:print> INSIDE IF $this= <xapl:value-of select="$this"/>
      </xapl:print>
    </xapl:if>
    <!--xapl:print> $this =<xapl:value-of select="$this"/> </xapl:print-->
    <!-- COLUMN FREEZE -->
    <!-- re-create the currentForm in session if its not there -->
    <xapl:choose>
      <xapl:when test="($currentForm/@Name = $this/FORM_NAME[1]/@Value and $currentForm/@ServiceName = $this/SERVICE[1]/@Value)"/>
      <xapl:otherwise>
        <!-- create form in session -->
        <x2:execute command="bcm.framework.queryform.Form:create">
          <x2:with-param name="pFormName" select="$this/FORM_NAME[1]/@Value"/>
          <x2:with-param name="pServiceName" select="$this/SERVICE[1]/@Value"/>
        </x2:execute>
      </xapl:otherwise>
    </xapl:choose>
    <!-- TODO for efficiecy-->
    <!-- set default sorting by pk  -->
    <xapl:if test="{((count($this/SORT_BY[1]) = 0) or (string-length($this/SORT_BY/@Value) = 0))}">
      <docutil:set select="{$this}">
        <SORT_BY Value="{concat($currentForm/RESULT_PROPERTIES/RESULT_PROPERTY[1]/@Document, '.' , $currentForm/RESULT_PROPERTIES/RESULT_PROPERTY[1]/@Property)}"/>
      </docutil:set>
    </xapl:if>
    <!--xapl:print>
     $$$$$$$$$$$$$$$$$ GET FORMS $$$$$$$$$$$$
    <xapl:print select="$currentForm"/>
    <xapl:print select="$pkForm"/>
    </xapl:print-->
    <!-- set default sorting order -->
    <xapl:choose>
      <xapl:when test="{count($this/SORT_ORDER[1]) = 0}">
        <docutil:add select="{$this}">
          <SORT_ORDER Value="Ascending"/>
        </docutil:add>
      </xapl:when>
      <xapl:when test="{string-length($this/SORT_ORDER/@Value) = 0}">
        <docutil:set select="{$this/SORT_ORDER/@Value}">Ascending</docutil:set>
      </xapl:when>
    </xapl:choose>
    <!--xapl:choose>
         <xapl:when test="count($currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/FORM[@Name= $this/FORM_NAME[1]/@Value]/ORDER_BY) = 1">
         <docutil:add select="$this">
         <MUTI_SORT_ENABLED  Value='yes'/>
         </docutil:add>
         </xapl:when>
         <xapl:otherwise>
          <docutil:add select="$this">
          <MUTI_SORT_ENABLED  Value='no'/>
          </docutil:add>
         </xapl:otherwise>
    </xapl:choose-->
    <xapl:return>
      <x2:execute command="bcm.calendar.FixedDetail.controller:getSearch">
        <x2:with-param name="this" select="$this"/>
        <x2:with-param name="pSearchParam" select="{$searchParam}"/>
        <x2:with-param name="pSearchFormConfigSource" select="{$pSearchFormConfigSource}"/>
        <x2:with-param name="pSearchReportConfigSource" select="{$pSearchReportConfigSource}"/>
        <x2:with-param name="pReportDataSource" select="{$pReportDataSource}"/>
      </x2:execute>
    </xapl:return>
  </x2:command>
<!-- **********************************************************************
 *********************************************************************** -->
 <x2:command public="yes" description="_" name="getSearch">
    <!--x2:param name="directory" select="$this/DIRECTORY/@Value"/>
    <x2:param name="file" select="$this/FILE/@Value"/-->

    <x2:param name="pSearchFormConfigSource"/>
    <x2:param name="pSearchReportConfigSource"/>
    <x2:param name="pReportDataSource"/>
    <x2:param name="pSearchParams"/>
    <x2:param name="this"/>

    <!--xapl:print>
      $this::
      <xapl:value-of select="$this"/>
    </xapl:print-->
    
      <!-- Sets the given params into $this (if not already present ONLY) -->
      <x2:execute command = "bcm.framework.common:setProperties">
        <x2:with-param name="pDocument" select="$this"/>
        <x2:with-param name="pProperties" select="$pSearchParams"/>
      </x2:execute>

    <!-- Sets the default params into $this (if not already present ONLY) -->
    <x2:execute command = "bcm.framework.queryform.searchformfilter.searchformfilter:setDefaults">
      <x2:with-param name="this" select="$this"/>
    </x2:execute>



    <!--xapl:print>
       $this::
      <xapl:value-of select="$this"/>
        $pSearchFormConfigSource :::::
        <xapl:value-of select="$pSearchFormConfigSource"/>
    </xapl:print-->

    <xapl:variable name="form"/>
    <xapl:variable name="filledForm"/>

    <xapl:if test="string-length($pSearchFormConfigSource) > 0 ">
        <!-- Get Form Config-->
        <xapl:set-variable name="form">
          <x2:execute command="{$pSearchFormConfigSource}">
            <x2:with-param name="this" select="{$this}"/>
          </x2:execute>
        </xapl:set-variable>

        <!-- Get Filled Form -->
        <xapl:set-variable name="filledForm">
          <x2:execute command="core.form.controller:fill">
            <x2:with-param name="pForm" select="{$form}"/>
            <x2:with-param name="this" select="{$this}"/>
          </x2:execute>
        </xapl:set-variable>

    </xapl:if>



    <!-- Get Report Config -->
    <xapl:variable name="reportFormat">
      <x2:execute command="{$pSearchReportConfigSource}">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
    </xapl:variable>
    
    <!-- export to excel-->
    <xapl:set-variable name="currentFormsFormat">
      <xapl:value-of select="{$reportFormat}"/>
    </xapl:set-variable>
    
    <xapl:set-variable name="currentFormsDataSource">
      <xapl:value-of select="{$pReportDataSource}"/>
    </xapl:set-variable>    
    
    <xapl:set-variable name="currentThis">
      <xapl:value-of select="{$this}"/>
    </xapl:set-variable>      
    

    <!-- Get Report Data -->
    <xapl:variable name="reportData">
      <x2:execute command="{$pReportDataSource}">
        <x2:with-param name="pReportFormat" select="$reportFormat"/>
        <x2:with-param name="pForm" select="{$filledForm}"/>
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
    </xapl:variable>



    <xapl:return>


      <SEARCH>
        <!-- Return Filled Form -->
        <xapl:value-of select="$filledForm"/>

        <!-- Return Generated Report -->
        <x2:execute command="bcm.calendar.FixedDetail.controller:generate">
          <!-- anish TODO -->
          <x2:with-param name="pForm" select="{$form}"/>
          <x2:with-param name="pReportFormat" select="$reportFormat"/>
          <x2:with-param name="pReportData" select="$reportData"/>
          <x2:with-param name="this" select="{$this}"/>
        </x2:execute>
        
        <xapl:value-of select="$systemProperties"/>

      </SEARCH>

    </xapl:return>
  </x2:command>

<!-- **********************************************************************
 *********************************************************************** -->
  <x2:command public="yes" description="-" name="generate">
    <xapl:param name="pReportFormat"/>
    <xapl:param name="pReportData"/>
    <xapl:param name="this"/>
    <!-- Are Mutation actions allowed for the user ? -->
    <!-- Handle Errors - Start::-->
    <!-- Assumes that _ERROR tag indicates error -->
    <xapl:print select="$appCalendarDetailColumns"/>

    <xapl:if test="count($pReportData/_ERROR) > 0">
      <xapl:return>
        <REPORT>
          <xapl:value-of select="$pReportData/_ERROR"/>
        </REPORT>
      </xapl:return>
    </xapl:if>
    <xapl:choose>
      <xapl:when test="count($currentPref/SERVICE/FORM/ORDER_BY) = 1">
        <docutil:set select="$this">
          <MULTI_SORT_ENABLED Value="yes"/>
        </docutil:set>
      </xapl:when>
      <xapl:otherwise>
        <docutil:set select="$this">
          <MULTI_SORT_ENABLED Value="no"/>
        </docutil:set>
      </xapl:otherwise>
    </xapl:choose>
    <xapl:variable name="varcustdisplay">
      <xapl:clone select="$pReportFormat"/>
    </xapl:variable>
     <xapl:print>
           track userpref
            <xapl:value-of select="$pReportFormat"/>
           pReportFormat
          <xapl:value-of select="$currentPref"/>
      </xapl:print>
    <xapl:choose>
      <xapl:when test="count($currentPref/SERVICE/FORM/DISPLAY_CUST/*)>0">
      <xapl:print>
      check flow
      </xapl:print>
        <docutil:remove select="$varcustdisplay/FIELDS/FIELD[@DisplayType!='Hidden']"/>
        <xapl:for-each varName="coltemp" select="$pReportFormat/FIELDS/FIELD">
          <xapl:print>
            <xapl:value-of select="$coltemp"/>
          </xapl:print>
          <xapl:choose>
            <xapl:when test="$coltemp/@Property = $currentPref/SERVICE/FORM/DISPLAY_CUST/*/@Name and $coltemp/@Document = $currentPref/SERVICE/FORM/DISPLAY_CUST/*/@Document">
              <xapl:print>
                         coming here
                         </xapl:print>
              <docutil:set select="$coltemp/@Sequence">
                <xapl:value-of select="$currentPref/SERVICE/FORM/DISPLAY_CUST/FIELD[@Name = $coltemp/@Property and @Document =  $coltemp/@Document]/@Sequence"/>
              </docutil:set>
              <docutil:add select="$varcustdisplay/FIELDS">
                <xapl:value-of select="$coltemp"/>
              </docutil:add>
            </xapl:when>
            <xapl:otherwise/>
          </xapl:choose>
        </xapl:for-each>
        <docutil:sort select="$varcustdisplay/FIELDS" sort-element="FIELD" sort-by="@Sequence" data-type="number" order="ascending"/>
        <xapl:print>
            original form
            <xapl:value-of select="$pReportFormat"/>
            new form
            <xapl:value-of select="$varcustdisplay"/>
        </xapl:print>
      </xapl:when>
      <xapl:otherwise/>
    </xapl:choose>
    <!-- Handle Errors - End.-->
    <xapl:return>
      <!-- Give default scroll -->
      <xapl:variable name="scrollable">
        <xapl:choose>
          <xapl:when test="string-length($pReportFormat/@Scrollable) > 0">
            <xapl:value-of select="$pReportFormat/@Scrollable"/>
          </xapl:when>
          <xapl:otherwise>no</xapl:otherwise>
        </xapl:choose>
      </xapl:variable>
      <!-- Give default scroll -->
      <xapl:variable name="scrollableContainer">
        <xapl:choose>
          <xapl:when test="string-length($pReportFormat/@ScrollableContainer) > 0">
            <xapl:value-of select="$pReportFormat/@ScrollableContainer"/>
          </xapl:when>
          <xapl:otherwise>no</xapl:otherwise>
        </xapl:choose>
      </xapl:variable>
      <!-- Give default collapse -->
      <xapl:variable name="collapsableContainer">
        <xapl:choose>
          <xapl:when test="string-length($pReportFormat/@CollapsableContainer) > 0">
            <xapl:value-of select="$pReportFormat/@CollapsableContainer"/>
          </xapl:when>
          <xapl:otherwise>no</xapl:otherwise>
        </xapl:choose>
      </xapl:variable>
      <xapl:variable name="totalRecordCount">
        <xapl:choose>
          <xapl:when test="string-length($pReportData/@TotalRowCount) > 0">
            <xapl:value-of select="$pReportData/@TotalRowCount"/>
          </xapl:when>
          <xapl:otherwise>
            <xapl:value-of select="$pReportData/TOTAL_RECORD_COUNT/@Value"/>
          </xapl:otherwise>
        </xapl:choose>
      </xapl:variable>
      <REPORT TotalRecordCount="{$totalRecordCount}" StartAtRow="{$this/START_COUNT/@Value}" MaxRows="{$this/MAX_ROWS/@Value}" NoOfRows="{count($pReportData/*)}" NoOfColumns="{count($varcustdisplay/FIELDS/FIELD)}">
        <xapl:variable name="overridden">
          <xapl:value-of select="'yes'"/>
        </xapl:variable>
        <xapl:choose>
          <xapl:when test="$pReportFormat/FIELDS/OVERRIDDEN and $pReportFormat/FIELDS/OVERRIDDEN[1]/@Value = 'no' ">
            <xapl:set-variable name="overridden" select="'no'"/>
          </xapl:when>
          <xapl:when test="$pReportFormat/FIELDS/OVERRIDDEN and $pReportFormat/FIELDS/OVERRIDDEN[1]/@Value = 'yes' ">
            <xapl:set-variable name="overridden" select="'yes'"/>
          </xapl:when>
          <xapl:otherwise>
            <xapl:set-variable name="overridden" select="'yes'"/>
          </xapl:otherwise>
        </xapl:choose>
        <xapl:print>Overridden flag set to <xapl:value-of select="$overridden"/>
        </xapl:print>
        <TABLE Title="{$pReportFormat/@Title}" Action="{$pReportFormat/@Action}" Method="{$pReportFormat/@Method}" ShowMoveUpDown="{$pReportFormat/@ShowMoveUpDown}" Validation="{$pReportFormat/@Validation}" DoSearch="{$this/DO_SEARCH/@Value}" NoRecordsTitle="{$pReportFormat/@NoRecordsTitle}" Scrollable="{$scrollable}" ScrollableContainer="{$scrollableContainer}" CollapsableContainer="{$collapsableContainer}" PagingTitle="{$pReportFormat/@PagingTitle}" FilterTitle="{$this/FILTER_TEXT[1]/@Value}" NoTitle="{$pReportFormat/@NoTitle}" Freezable="{$pReportFormat/@Freezable}" FrozenSequence="{$this/FROZEN_SEQUENCE/@Value}" Overridden="{$overridden}">
          <!-- Help -->
          <xapl:if test="string-length($pReportFormat/HELP/@Url) > 0">
            <HELP Url="{$pReportFormat/HELP/@Url}"/>
          </xapl:if>
          <!-- Header Row-->
          <TR Header="yes">
            <!-- Select All -->
            <xapl:if test="$pReportFormat/@Selectable = 'All'">
              <TD Name="SELECT_ALL" Header="yes" Select="multi" Type="CheckBox" Sequence="-100"/>
            </xapl:if>
            <xapl:if test="$pReportFormat/@Selectable = 'Single'">
                <TD Select="single" Header="yes" Sequence="-100"/>"/>
            </xapl:if>
            <!-- Header Columns -->
            <xapl:for-each varName="col" select="$varcustdisplay/FIELDS/FIELD">
              <xapl:variable name="type">
                <xapl:choose>
                  <xapl:when test="$col/@DisplayType = 'Hidden'">Hidden</xapl:when>
                  <xapl:when test="$col/@Hidden = 'yes'">None</xapl:when>
                  <xapl:otherwise>Text</xapl:otherwise>
                </xapl:choose>
              </xapl:variable>
              <!-- Value -->
              <xapl:variable name="value">
                <xapl:choose>
                  <xapl:when test="$col/@DisplayType = 'Hidden' or $col/@Hidden = 'yes'">
                    <xapl:value-of select="$col/@Value"/>
                  </xapl:when>
                  <xapl:otherwise>
                    <i18n:text>
                      <xapl:value-of select="$col/@DisplayText"/>
                    </i18n:text>
                  </xapl:otherwise>
                </xapl:choose>
                <!-- checking for document name and form name as stored in order_by tag in uer_preferences -->
              </xapl:variable>
              <xapl:variable name="colname">
                <xapl:value-of select="$col/@Name"/>
              </xapl:variable>
              <xapl:variable name="docname">
                <xapl:value-of select="substring-before($col/@Name ,'.')"/>
              </xapl:variable>
                           
              <!-- Multisortorder -->
              <xapl:variable name="Multisortorder"/>
              <xapl:choose>
                <xapl:when test="count($currentPref/SERVICE/FORM/ORDER_BY) = 1">
                  <xapl:set-variable name="Multisortorder">
                    <xapl:value-of select="$currentPref/SERVICE/FORM/ORDER_BY/*[name() = $colname and @Document = $docname][1]/@Sort"/>
                  </xapl:set-variable>
                </xapl:when>
                <xapl:otherwise/>
              </xapl:choose>
             <!-- <xapl:print>
            in reportdb
            <xapl:value-of select="{$col/@Name}"/>
                <xapl:value-of select="$Multisortorder"/>
              </xapl:print>-->
              <!-- Multisortnumber -->
              <xapl:variable name="Multisortnumber"/>
              <xapl:choose>
                <xapl:when test="$currentPref/SERVICE/FORM/ORDER_BY/*[position()=1 and name() = $colname and @Document = $docname]">
                  <xapl:set-variable name="Multisortnumber">
                    <xapl:value-of select="'1'"/>
                  </xapl:set-variable>
                </xapl:when>
                <xapl:otherwise>
                  <xapl:choose>
                    <xapl:when test="$currentPref/SERVICE/FORM/ORDER_BY/*[position()=2 and name() =  $colname and @Document = $docname]">
                      <xapl:set-variable name="Multisortnumber">
                        <xapl:value-of select="'2'"/>
                      </xapl:set-variable>
                    </xapl:when>
                    <xapl:otherwise>
                      <xapl:if test="$currentPref/SERVICE/FORM/ORDER_BY/*[position()=3 and name() =  $colname and @Document = $docname]">
                        <xapl:set-variable name="Multisortnumber">
                          <xapl:value-of select="'3'"/>
                        </xapl:set-variable>
                      </xapl:if>
                    </xapl:otherwise>
                  </xapl:choose>
                </xapl:otherwise>
              </xapl:choose>
              <xapl:choose>
                <xapl:when test="count($currentPref/SERVICE/FORM/ORDER_BY)=1">
                  <TD I18Nize="{$col/@I18Nize}" Sequence="{$col/@Sequence}" Header="yes" Name="{$col/@Name}" Required="{$col/@Required}" Value="{$value}" Sortable="{$col/@Sortable}" Primarykey="{$col/@Primarykey}" Type="{$type}" Multisortorder="{$Multisortorder}" Multisortnumber="{$Multisortnumber}"/>
                </xapl:when>
                <xapl:otherwise>
                  <TD I18Nize="{$col/@I18Nize}" Sequence="{$col/@Sequence}" Header="yes" Name="{$col/@Name}" Required="{$col/@Required}" Value="{$value}" Sortable="{$col/@Sortable}" Primarykey="{$col/@Primarykey}" Type="{$type}"/>
                </xapl:otherwise>
              </xapl:choose>
            </xapl:for-each>
          </TR>
          <!-- Filter Header Row-->
          <xapl:if test="$pReportFormat/@ShowFilter = 'yes' ">
            <TR Filter="yes">
              <!-- Select All -->
              <xapl:if test="$pReportFormat/@Selectable = 'All'">
                <TD Sequence="-100"/>
              </xapl:if>
              <xapl:if test="$pReportFormat/@Selectable = 'Single'">
                <TD Sequence="-100"/>
              </xapl:if>
              <!-- Filter Header Columns -->
              <xapl:for-each varName="col" select="$varcustdisplay/FIELDS/FIELD">
                <!-- type for filter (all text except hidden TODO anish (date/number) ) -->
                <!--xapl:print>
                    :::$col/@Name=<xapl:value-of select="$col/@Name"/>
                    :::$col/@DisplayType=<xapl:value-of select="$col/@DisplayType"/>
                    :::$col/@Hidden=<xapl:value-of select="$col/@Hidden"/>
                </xapl:print-->
                <xapl:variable name="type">
                  <xapl:choose>
                    <xapl:when test="$col/@DisplayType = 'Hidden'">Hidden</xapl:when>
                    <xapl:when test="$col/@Hidden = 'yes'">None</xapl:when>
                    <xapl:when test="$col/@DisplayType = 'DateTime'">DateFilter</xapl:when>
                    <xapl:when test="$col/@DisplayType = 'Image'">Image</xapl:when>
                    <xapl:when test="$col/@DisplayType = 'Date'">DateFilter</xapl:when>
                    <xapl:when test="$col/@DisplayType = 'Number'">NumberFilter</xapl:when>
                    <xapl:when test="$col/@Filter_type = 'dropdown'">Select</xapl:when>
                    <xapl:otherwise>Text</xapl:otherwise>
                  </xapl:choose>
                </xapl:variable>
                <xapl:variable name="editable">
                  <xapl:choose>
                    <xapl:when test="$col/@DisplayType = 'Hidden'">false</xapl:when>
                    <xapl:when test="$col/@DisplayType = 'Image'">false</xapl:when>
                    <xapl:when test="$col/@Filter = 'false'">false</xapl:when>
                    <xapl:otherwise>true</xapl:otherwise>
                  </xapl:choose>
                </xapl:variable>
                <xapl:variable name="filter">
                  <xapl:choose>
                    <xapl:when test="$col/@DisplayType = 'Hidden'">false</xapl:when>
                    <xapl:when test="$col/@DisplayType = 'Image'">false</xapl:when>
                    <xapl:otherwise>
                      <xapl:value-of select="$col/@Filter"/>
                    </xapl:otherwise>
                  </xapl:choose>
                </xapl:variable>
                <!-- Options if Select -->
                <xapl:variable name="options">
                  <xapl:choose>
                    <xapl:when test="$col/@Filter_dataSourceType = 'Command'">
                      <x2:execute command="{$col/@Filter_dataSourceName}">
                        <x2:with-param name="this" select="{$this}"/>
                      </x2:execute>
                    </xapl:when>
                  </xapl:choose>
                </xapl:variable>
                <!-- leave blank the image and checkbox filters -->
                <xapl:choose>
                  <xapl:when test="string-length($col/@Image) > 0 ">
                    <TD/>
                  </xapl:when>
                  <xapl:when test="$col/@DisplayType = 'Hidden' "/>
                  <xapl:otherwise>
                    <TD Sequence="{$col/@Sequence}" Name="{concat('F_' , $col/@Name)}" Type="{$type}" SelectAll="{$col/@Filter_selectAll}" OnChange="{$col/@Filter_onChange}" Disabled="{$col/@Filter_disabled}" Filter="{$filter}" Editable="{$editable}" Value="{$this/*[name() = concat('F_' , $col/@Name) ]/@Value}">
                      <!-- Generate Options -->
                      <xapl:for-each varName="option" select="{$options/PROPERTY[@Name =$col/@Property and @Document = $col/@Document]/*}">
                        <OPTION Id="{$option/@Value}" Value="{$option/@Value}"/>
                      </xapl:for-each>
                    </TD>
                  </xapl:otherwise>
                </xapl:choose>
              </xapl:for-each>
            </TR>
          </xapl:if>
          <!-- Result Rows -->
          <!-- Give default id - Used for check box (Value)-->
          <xapl:variable name="idName">
            <xapl:choose>
              <xapl:when test="string-length($pReportFormat/@Id) > 0">
                <xapl:value-of select="$pReportFormat/@Id"/>
              </xapl:when>
              <xapl:otherwise>ID</xapl:otherwise>
            </xapl:choose>
          </xapl:variable>
          <xapl:variable name="selectedIdName1">
            <xapl:choose>
              <xapl:when test="string-length($pReportFormat/@SelectedId) > 0">
                <xapl:value-of select="$pReportFormat/@SelectedId"/>
              </xapl:when>
              <xapl:otherwise>ID</xapl:otherwise>
            </xapl:choose>
          </xapl:variable>
          <xapl:variable name="count" select="0"/>
          <xapl:variable name="rowType"/>
          <xapl:variable name="type"/>
          <xapl:for-each varName="row" select="$pReportData/*[name() != 'TOTAL_RECORD_COUNT' and name() != 'START_AT_ROW']">
            <!--xapl:print select="$row"/-->
            <xapl:variable name="disabled">
              <xapl:choose>
                <xapl:when test="string-length($row/@IsGap) > 0">true</xapl:when>
                <xapl:otherwise/>
              </xapl:choose>
            </xapl:variable>
            <xapl:set-variable name="rowType">
            	<xapl:value-of select="$appCalendarDetailColumns/calendarTypeID[@Value = $context/CALENDAR/calendarTypeID/@Value]/calendarEntryAttributeID[@Value = $row/calAttrName/@Value]/@DataType"/>
            </xapl:set-variable>
            <!--xapl:print select="$rowType"/-->
            
            <TR Disabled="{$disabled}">
              <xapl:set-variable name="count" select="$count + 1"/>
              <!-- Select Box -->
              <!-- MultiSelect -->
              <xapl:variable name="rowId"/>
              <xapl:choose>
                <xapl:when test="$idName = '#'">
                  <!--xapl:print>
                      Hi Anish Calling functions......
              <xapl:value-of select="generate-hash-key( $row , $pkForm)"/>
                  </xapl:print-->
                  <xapl:set-variable name="rowId">
                    <xapl:value-of select="generate-hash-key( $row , $pkForm)"/>
                  </xapl:set-variable>
                  <!--xapl:for-each varName="idName1" select="$pkForm/NAME">
                    <xapl:set-variable name="rowId">
                      <xapl:value-of select="concat( $rowId , '#', $idName1/@Value , '=', get-child-by-name( $row, $idName1/@Value)/@Value ) "/>
                    </xapl:set-variable>
                  </xapl:for-each-->
                  <!-- append a # at end too for looping -->
                  <!--xapl:set-variable name="rowId">
                    <xapl:value-of select="concat( $rowId , '#') "/>
                  </xapl:set-variable-->
                </xapl:when>
                <xapl:when test="contains($idName, '|') ">
                  <xapl:print>
                    <xapl:value-of select="$idName"/>
                  </xapl:print>
                  <xapl:variable name="ids">
                    <x2:execute command="bcm.framework.util:createXMLFromString">
                      <x2:with-param name="string" select="$idName"/>
                      <x2:with-param name="delimeter" select="'|'"/>
                      <x2:with-param name="tagname" select="'ID'"/>
                    </x2:execute>
                  </xapl:variable>
                  <xapl:print>
                           $ids=<xapl:value-of select="$ids"/>
                  </xapl:print>
                  <xapl:for-each select="$ids/*" varName="id">
                    <xapl:print>
                               $idName=<xapl:value-of select="$id/@Value"/>
                    </xapl:print>
                    <xapl:set-variable name="rowId">
                      <xapl:value-of select="concat( $rowId , '#' , $id/@Value , '=' , get-child-by-name( $row, $id/@Value)/@Value ) "/>
                    </xapl:set-variable>
                    <xapl:print>
                             rowId=<xapl:value-of select="$rowId"/>
                    </xapl:print>
                  </xapl:for-each>
                  <xapl:set-variable name="rowId">
                    <xapl:value-of select="concat( $rowId , '#' ) "/>
                  </xapl:set-variable>
                  <xapl:print>
                           FINAL rowId:::=<xapl:value-of select="$rowId"/>
                  </xapl:print>
                </xapl:when>
                <xapl:otherwise>
                  <xapl:set-variable name="rowId">
                    <xapl:value-of select=" get-child-by-name( $row, $idName)/@Value "/>
                  </xapl:set-variable>
                </xapl:otherwise>
              </xapl:choose>
              <xapl:variable name="checked">
                <xapl:choose>
                  <xapl:when test="count($this/*[name()= $selectedIdName1 and ./@Value = $rowId] ) > 0">true</xapl:when>
                  <xapl:otherwise>false</xapl:otherwise>
                </xapl:choose>
              </xapl:variable>
              <!--xapl:print select="$checked"/-->
              <xapl:variable name="quote">'</xapl:variable>
              <xapl:variable name="onSelectRow">
                <xapl:value-of select="concat('javascript:onSelectRow(', $quote, $rowId ,$quote, ');')"/>
              </xapl:variable>
              <!--xapl:print select="$onSelectRow"/-->
              <xapl:if test="$pReportFormat/@Selectable = 'All'">
                <TD Name="{$selectedIdName1}" Type="CheckBox" Select="multi" Value="{$rowId}" Checked="{$checked}" OnClick="{$onSelectRow}" Sequence="-100"/>
              </xapl:if>
              <!-- Single Select in 1 Row - Checked-->
              <xapl:if test="$pReportFormat/@Selectable = 'Single' and $count='1'">
                <xapl:choose>
                  <xapl:when test="$checked = 'false' and not(./@Value)">
                    <TD Name="{$selectedIdName1}" Type="Radio" Select="single" Value="{$rowId}" Checked="true" Sequence="-100"/>
                  </xapl:when>
                  <xapl:when test="$checked = 'true' ">
                    <TD Name="{$selectedIdName1}" Type="Radio" Select="single" Value="{$rowId}" Checked="true" Sequence="-100"/>
                  </xapl:when>
                  <xapl:when test="$checked = 'false'">
                    <TD Name="{$selectedIdName1}" Type="Radio" Select="single" Value="{$rowId}" Sequence="-100"/>
                  </xapl:when>
                </xapl:choose>
                <!--TD Name="{$selectedIdName1}" Type="Radio" Value="{$rowId}" Checked=" "/-->
              </xapl:if>
              <!-- Single Select not in 1 Row - unChecked-->
              <xapl:if test="$pReportFormat/@Selectable = 'Single' and $count !='1'">
                <xapl:choose>
                  <xapl:when test="$checked = 'true' ">
                    <TD Name="{$selectedIdName1}" Type="Radio" Select="single" Value="{$rowId}" Checked="true" Sequence="-100"/>
                  </xapl:when>
                  <xapl:when test="$checked = 'false'">
                    <TD Name="{$selectedIdName1}" Type="Radio" Select="single" Value="{$rowId}" Sequence="-100"/>
                  </xapl:when>
                </xapl:choose>
                <!--TD Name="{$selectedIdName1}" Type="Radio" Value="{$rowId}"/-->
              </xapl:if>
              <!-- Result Columns -->
              <!--xapl:print>Result Columns<xapl:value-of select ="$varcustdisplay"/></xapl:print-->
              
							<xapl:for-each varName="col" select="$varcustdisplay/FIELDS/FIELD">
                <!-- Default - Start:: -->
                <!-- type -->
								<xapl:set-variable name="type">
									<xapl:choose>
										<xapl:when test="$col/@Name='calendarEntryAttributeID'">Text</xapl:when>
										<xapl:when test="$col/@DisplayType = 'Hidden'">Hidden</xapl:when>
										<xapl:when test="$col/@Hidden = 'yes'">Hidden</xapl:when>
										<xapl:when test="$rowType = 'Text'">Text</xapl:when>
										<xapl:when test="$rowType = 'boolean'">Select</xapl:when>
										<xapl:when test="$rowType = 'float'">Number</xapl:when>
										<xapl:when test="$rowType = 'date'">Date</xapl:when>
										<xapl:when test="$rowType = 'Number'">Number</xapl:when>
										<xapl:otherwise>
											<xapl:value-of select="'Text'"/>
										</xapl:otherwise>
									</xapl:choose>
								</xapl:set-variable>
								<!--xapl:print select="$type"/-->
                
                <!-- format -->
                <xapl:variable name="format">
                  <xapl:choose>
                    <xapl:when test="string-length($col/@Format) > 0">
                      <xapl:value-of select="$col/@Format"/>
                    </xapl:when>
                    <xapl:otherwise/>
                  </xapl:choose>
                </xapl:variable>
                <!-- image -->
                <xapl:variable name="image">
                  <xapl:choose>
                    <xapl:when test="string-length($col/@Image) > 0">
                      <xapl:value-of select="$col/@Image"/>
                    </xapl:when>
                    <xapl:otherwise/>
                  </xapl:choose>
                </xapl:variable>
                <!-- decimals -->
                <xapl:variable name="decimals">
                  <xapl:choose>
                    <xapl:when test="string-length($col/@Decimals) > 0">
                      <xapl:value-of select="$col/@Decimals"/>
                    </xapl:when>
                    <xapl:otherwise/>
                  </xapl:choose>
                </xapl:variable>
                <!--xapl:print select="$type"/>
              <xapl:print select="$image"/-->
                <!-- Value -->
                <xapl:variable name="value">
                  <xapl:choose>
                    <!-- If Datasource Is Document Link -->
                    <xapl:when test="$col/@DataSourceType = 'Link'">
                      <xapl:value-of select="{$row/*/*[name() = $col/@DataSourceName][1]/*[name() = $col/@Name][1]/@Value}"/>
                    </xapl:when>
                    <!-- If Datasource is Self  -->
                    <xapl:when test="{string-length(get-child-by-name( $row, $col/@Name )/@Value) > 0}">
                      <xapl:value-of select="{get-child-by-name($row, $col/@Name)/@Value}"/>
                    </xapl:when>
                    <xapl:otherwise>
                      <xapl:value-of select="$col/@Value"/>
                    </xapl:otherwise>
                  </xapl:choose>
                </xapl:variable>
                
                

               
                
                <!-- Options if Select -->
                <xapl:variable name="options">
                  <xapl:choose>
                    <xapl:when test="$col/@DataSourceType = 'Command'">
                      <x2:execute command="{$col/@DataSourceName}">
                        <x2:with-param name="this" select="{$this}"/>
                      </x2:execute>
                    </xapl:when>
                    <xapl:when test="$col/@DataSourceType = 'Method'">
                      <xcore:execute-method name="{$col/@DataSourceName}"/>
                    </xapl:when>
                  </xapl:choose>
                </xapl:variable>
                
                
                <xapl:variable name="encodedParam"/>
                <xapl:variable name="onclick"/>
                <xapl:variable name="onjavascriptclick"/>
                <xapl:choose>
                  <xapl:when test="string-length($col/@OnClick) > 0 ">
                    <!--<xapl:set-variable name="rowId"/>-->
                    <!--xapl:for-each varName="idName1" select="$pkForm/NAME">
                        <xapl:set-variable name="rowId">
                          <xapl:value-of select="concat( $rowId , '#', $idName1/@Value , '=', get-child-by-name( $row, $idName1/@Value)/@Value ) "/>
                        </xapl:set-variable>
                      </xapl:for-each-->
                    <!-- append a # at end too for looping -->
                    <!--<xapl:set-variable name="rowId">
                        <xapl:value-of select="generate-hash-key( $row , $pkForm)"/>
                      </xapl:set-variable>-->
                    <xapl:set-variable name="onjavascriptclick">
                      <xapl:value-of select="concat('javascript:' , $col/@OnClick, '(', $quote , $rowId , $quote , ');' )"/>
                    </xapl:set-variable>
                  </xapl:when>
                  <xapl:when test="string-length($col/@Url) > 0">
                    <xapl:choose>
                      <!-- If all row data need to be passed -->
                      <xapl:when test="$col/@UrlParam = 'All'">
                        <xapl:variable name="pParam"/>
                        <xapl:set-variable name="encodedParam">
                          <xapl:if test="string-length($rowId) > 0">
                            <web:url-encode select="$rowId"/>
                          </xapl:if>
                        </xapl:set-variable>
                        <xapl:set-variable name="pParam">
                          <xapl:value-of select="concat($selectedIdName1,'=',$encodedParam , '&amp;')"/>
                        </xapl:set-variable>
                        <xapl:for-each varName="othercol" select="$varcustdisplay/FIELDS/FIELD">
                          <!-- Value -->
                          <xapl:variable name="othercolvalue">
                            <xapl:choose>
                              <!-- If Datasource Is Document Link -->
                              <xapl:when test="$othercol/@DataSourceType = 'Link'">
                                <xapl:value-of select="{$row/*/*[name() = $othercol/@DataSourceName][1]/*[name() = $othercol/@Name][1]/@Value}"/>
                              </xapl:when>
                              <!-- If Datasource is Self  -->
                              <xapl:when test="{string-length(get-child-by-name($row, $othercol/@Name)/@Value) > 0}">
                                <xapl:value-of select="{get-child-by-name($row, $othercol/@Name)/@Value}"/>
                              </xapl:when>
                              <xapl:otherwise>
                                <xapl:value-of select="$othercol/@Value"/>
                              </xapl:otherwise>
                            </xapl:choose>
                          </xapl:variable>
                          <xapl:if test="$othercolvalue != 'null' and string-length($othercolvalue) > 0">
                            <xapl:set-variable name="encodedParam">
                              <web:url-encode select="$othercolvalue"/>
                            </xapl:set-variable>
                            <xapl:set-variable name="pParam">
                              <xapl:value-of select="concat($pParam,$othercol/@Name,'=',$encodedParam, '&amp;')"/>
                            </xapl:set-variable>
                          </xapl:if>
                        </xapl:for-each>
                        <xapl:set-variable name="onclick">
                          <xapl:value-of select="concat($col/@Url, '?', $pParam)"/>
                        </xapl:set-variable>
                      </xapl:when>
                      <!-- ParamName and Value-->
                      <xapl:when test="string-length($col/@UrlParamName) > 0">
                        <xapl:set-variable name="encodedParam">
                          <xapl:if test="string-length($value) > 0">
                            <web:url-encode select="$value"/>
                          </xapl:if>
                        </xapl:set-variable>
                        <xapl:set-variable name="onclick">
                          <xapl:value-of select="concat($col/@Url, '?', $col/@UrlParamName, '=' , $encodedParam)"/>
                        </xapl:set-variable>
                      </xapl:when>
                      <!-- Default - Name and Value-->
                      <xapl:otherwise>
                        <xapl:set-variable name="encodedParam">
                          <xapl:if test="string-length($value) > 0">
                            <web:url-encode select="$value"/>
                          </xapl:if>
                        </xapl:set-variable>
                        <xapl:set-variable name="onclick">
                          <xapl:value-of select="concat($col/@Url, '?', $col/@Name, '=', $encodedParam)"/>
                        </xapl:set-variable>
                      </xapl:otherwise>
                    </xapl:choose>
                  </xapl:when>
                  <xapl:otherwise/>
                </xapl:choose>
               
                <!-- checkbox -->
                <!--xapl:variable name="checkBoxValue">
                  <xapl:choose>
                    <xapl:when test="$value = 'TRUE'">true</xapl:when>
                    <xapl:otherwise>false</xapl:otherwise>
                  </xapl:choose>
                </xapl:variable-->
                <!-- Default - End. -->
                <!--xapl:print>
                ################### <xapl:value-of select="$value"/>
                </xapl:print-->
                <!-- Put the TD -->
                <TD I18Nize="{$col/@I18Nize}" Sequence="{$col/@Sequence}" OnClick="{$onjavascriptclick}" Url="{$onclick}" Type="{$type}" DisplayText="{$col/@DisplayText}" Decimals="{$col/@Decimals}" Format="{$format}" Name="{$col/@Name}" Value="{$value}" NoWrap="{$col/@DisplayNoWrap}" Editable="{$col/@Editable}" SelectAll="{$col/@SelectAll}" Target="{$col/@Target}" MaxLength="{$col/@MaxLength}" Disabled="{$col/@Disabled}" Required="{$col/@Required}">
                  <!-- Generate Options -->
                  <xapl:for-each varName="option" select="{$options/PROPERTY[@Name =$col/@Property and @Document=$col/@Document]/*}">
                    <OPTION Id="{$option/@Value}" Value="{$option/@Value}"/>
                  </xapl:for-each>
                </TD>
              </xapl:for-each>
            </TR>
          </xapl:for-each>
          <!--xapl:if test="get-child-by-name( $this, $selectedIdName1)">
            <TR Type="Hidden">
            <xapl:for-each select="get-child-by-name( $this, $selectedIdName1 )/@Value" varName="id">
              <xapl:if test="count($pReportData/*/*[name() = $idName and @Value = $id]) = 0">
               <TD Name="{$selectedIdName1}" Type="Hidden" Value ="{$id}" />
              </xapl:if>
            </xapl:for-each>
            </TR>
          </xapl:if-->
          <xapl:value-of select="$pReportFormat/BUTTONS"/>
          <xapl:value-of select="$pReportFormat/PAGINATION"/>
        </TABLE>
      </REPORT>
      <xapl:value-of select="$this/*"/>
    </xapl:return>
  </x2:command>

<!-- **********************************************************************
 *********************************************************************** -->
  </x2:commands>
