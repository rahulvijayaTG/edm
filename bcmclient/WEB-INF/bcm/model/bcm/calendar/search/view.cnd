<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="init" public="yes" description="_">
    <xapl:variable name="calendarSearchResult" resolver="session" global="true"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
  
	<xapl:variable name="userPermissionViewForbcmManageCalendar">
		 <x2:execute command="bcm.framework.common:checkAccessPermissions">
		   <x2:with-param name="activityName" select="'bcmManageCalendar'"/>
		   <x2:with-param name="accessLevel" select="'View'"/>
		 </x2:execute>
	</xapl:variable>              
  
	
	<xapl:if test="$userPermissionViewForbcmManageCalendar!='True'">
	   <docutil:set select="$this">
	       <DO_SEARCH Value="No"/>   
	   </docutil:set>   
	</xapl:if> 	
  
    <xapl:if test="$this/MODE/@Value = 'START'">
      <x2:execute command="bcm.context.controller:cleanContext"/>
      <xapl:set-variable name="appCalendarDetailColumns"/>
      <x2:execute command="bcm.cm:getCalBasedAttributesForCalTypes"/>
    </xapl:if>
    <xapl:print>
      <xapl:value-of select="$this"/>
    </xapl:print>
    <xapl:choose>
      <xapl:when test="$context/RESOURCE">
        <docutil:set select="$this">
          <F_CalendarMaster.calendarTypeID Value="RESOURCE"/>
        </docutil:set>
        <docutil:set select="$context/RESOURCE">
          <name Value="{$resDetails/name/@Value}"/>
          <description Value="{$resDetails/description/@Value}"/>
        </docutil:set>
      </xapl:when>
      <xapl:when test="$context/DL">
        <docutil:set select="$this">
          <F_CalendarMaster.calendarTypeID Value="DL"/>
        </docutil:set>
        <docutil:set select="$context/DL">
          <name Value="{$distributionLaneDetails/name/@Value}"/>
          <description Value="{$distributionLaneDetails/description/@Value}"/>
        </docutil:set>
      </xapl:when>
      <xapl:when test="$context/LOCATION">
        <docutil:set select="$this">
          <F_CalendarMaster.calendarTypeID Value="LOCATION"/>
        </docutil:set>
      </xapl:when>
      <xapl:otherwise/>
    </xapl:choose>
    <!-- BREADCRUMBS AT TOP OR AFTER CLEAN-CONTEXT-->
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
      <x2:with-param name="display" select="'Calendar Search'"/>
      <x2:with-param name="page" select="'calendarSearchBreadcrumb'"/>
      <x2:with-param name="this" select="{$this}"/>
    </x2:execute>
    <xapl:variable name="form">
      <x2:execute command="bcm.framework.queryform.Form:getFormContainer">
        <x2:with-param name="this" select="$this"/>
        <x2:with-param name="pSearchParam" select="$searchParam"/>
        <x2:with-param name="pFormName" select=" $this/FORM_NAME[1]/@Value "/>
        <x2:with-param name="pServiceName" select="$this/SERVICE[1]/@Value"/>
        <x2:with-param name="pSearchReportConfigSource" select="'bcm.calendar.search.view:getReportConfig'"/>
        <x2:with-param name="pReportDataSource" select="'bcm.calendar.search.view:getReportData'"/>
      </x2:execute>
    </xapl:variable>
    <xapl:return>
      <!-- Page Header-->
      <x2:execute command="bcm.calendar.search.view:getHeader">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
      <!-- Container-->
      <x2:execute command="bcm.calendar.search.view:getContainer">
        <x2:with-param name="this" select="$this"/>
        <x2:with-param name="pPage" select="'calendar_search'"/>
      </x2:execute>
      <!-- Search / Form and Report -->
      <xapl:value-of select="$form"/>
      <!-- return parameters-->
      <xapl:value-of select="$this/*"/>
      <!--return context-->
      <xapl:value-of select="$context"/>
      <xapl:if test="$userPermissionViewForbcmManageCalendar!='True'">
        <ERROR_MESSAGE Value="You do not have view permissions"/>
      </xapl:if>
    </xapl:return>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    <xapl:return>
      <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <x2:param name="pPage"/>
    <xapl:return>
      <CONTAINER Scrollable="no">
        <HELP Url="../help/calendar_search_help.htm"/>
        <EXPRESSION_FILTER Value="yes"/>                
        <STEP Name="ViewForm" DisplayText="Calendar Search" Selected="true"/>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportConfig">
    <xapl:variable name="setectable">
      <xapl:choose>
        <xapl:when test="$context/DL">Single</xapl:when>
        <xapl:otherwise>All</xapl:otherwise>
      </xapl:choose>
    </xapl:variable>
    <xapl:return>
      <REPORT Title="Calendar Search" Action="{$pages:calendarSearchAction}" Method="POST" Selectable="{$setectable}" Scrollable="no" ScrollableContainer="yes" Id="CalendarMaster.calendarID" ShowFilter="yes" SelectedId="SELECTED_ID" PagingTitle="yes" Freezable="yes">
        <FIELDS>
        	<!-- Process Input Staging/Master tables-->
          <xapl:if test="$context/RESOURCE or $context/LOCATION or $context/DL">
            <docutil:set select="$this">
              <DISABLE_FILTERS>
                <NAME Value="F_CalendarMaster.calendarTypeID"/>
                <NAME Value="F_CalendarMaster.class"/>
              </DISABLE_FILTERS>
            </docutil:set>
          </xapl:if>
          <!--get form's report fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
          <!-- get Hidden Fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
        </FIELDS>
        <BUTTONS>
		<xapl:variable name="userPermissionViewForbcmManageCalendar">
			 <x2:execute command="bcm.framework.common:checkAccessPermissions">
			   <x2:with-param name="activityName" select="'bcmManageCalendar'"/>
			   <x2:with-param name="accessLevel" select="'View'"/>
			 </x2:execute>
		</xapl:variable>              
		<xapl:variable name="userPermissionRemoveForbcmManageCalendar">
			<x2:execute command="bcm.framework.common:checkAccessPermissions">
			 <x2:with-param name="activityName" select="'bcmManageCalendar'"/>
			 <x2:with-param name="accessLevel" select="'Remove'"/>
			</x2:execute>
		</xapl:variable>              
		<xapl:variable name="userPermissionAddForbcmManageCalendar">
			<x2:execute command="bcm.framework.common:checkAccessPermissions">
			 <x2:with-param name="activityName" select="'bcmManageCalendar'"/>
			 <x2:with-param name="accessLevel" select="'Add'"/>
			</x2:execute>
		</xapl:variable>         
          <xapl:if test="$userPermissionViewForbcmManageCalendar='True'">        
          	<BUTTON Id="Export" Name="Export" DisplayText="Export to Excel" OnClick="javascript:onExportToExcelGlobal('calender','xls')" DisableOnClick="true" Disabled="report"/>
          </xapl:if>
          <xapl:if test="$userPermissionAddForbcmManageCalendar='True'">        
            <DIVIDER/>          	
	          <BUTTON Id="create" Name="Create" DisplayText="Create" OnClick="javascript:onCreate()" DisableOnClick="true"/>
		  		<!--BUTTON Id="copy" Name="Copy" DisplayText="Copy" OnClick="javascript:onCopy()"  Disabled="report" DisableOnClick="true"/-->
	  			</xapl:if>
          <xapl:if test="$userPermissionRemoveForbcmManageCalendar='True'">                  
						<BUTTON Id="delete" Name="delete" DisplayText="Delete" OnClick="javascript:onDelete()" Disabled="report" DisableOnClick="true"/>
          </xapl:if>
          <xapl:if test="$context/RESOURCE or $context/LOCATION or $context/DL">
	       	  <BUTTON Id="cancel" Name="cancel" DisplayText="Cancel" OnClick="javascript:onReturnToContext()" DisableOnClick="true"/>
          </xapl:if>
          <xapl:choose>
            <xapl:when test="$context/RESOURCE">
          		<xapl:if test="$userPermissionViewForbcmManageCalendar='True'">                                        
          			<DIVIDER/>
                <BUTTON Id="select" Name="select" DisplayText="Select" OnClick="javascript:onSelectResourceCalendar()" DisableOnClick="true" Emphasized="true"/>
          			<DIVIDER/>          
          			<BUTTON Id="clear" Name="Clear" DisplayText="Clear" OnClick="javascript:onClear()" DisableOnClick="true"/>
          	    <BUTTON Id="search" Name="Search" DisplayText="Search" OnClick="javascript:dispatchSearch()" DisableOnClick="true"/>
	            </xapl:if>   
            </xapl:when>
            <xapl:when test="$context/DL">
            	<xapl:if test="$userPermissionViewForbcmManageCalendar='True'"> 
            			<DIVIDER/>
									<BUTTON Id="select" Name="select" DisplayText="Select" OnClick="javascript:onSelectDLCalendar()" DisableOnClick="true" Emphasized="true"/>
            			<DIVIDER/>          
          				<BUTTON Id="clear" Name="Clear" DisplayText="Clear" OnClick="javascript:onClear()" DisableOnClick="true"/>
									<BUTTON Id="search" Name="Search" DisplayText="Search" OnClick="javascript:dispatchSearch()" DisableOnClick="true"/>
							</xapl:if>
            </xapl:when>
            <xapl:when test="$context/LOCATION">
            	<xapl:if test="$userPermissionViewForbcmManageCalendar='True'">                                        
									<DIVIDER/>
									<BUTTON Id="select" Name="select" DisplayText="Select" OnClick="javascript:onSelectLocationCalendar()" DisableOnClick="true" Emphasized="true"/>            
	            		<DIVIDER/>          
          				<BUTTON Id="clear" Name="Clear" DisplayText="Clear" OnClick="javascript:onClear()" DisableOnClick="true"/>
									<BUTTON Id="search" Name="Search" DisplayText="Search" OnClick="javascript:dispatchSearch()" DisableOnClick="true"/>
							</xapl:if>
            </xapl:when>
            <xapl:otherwise>
            	<xapl:if test="$userPermissionViewForbcmManageCalendar='True'">            
            			<BUTTON Id="clear" Name="Clear" DisplayText="Clear" OnClick="javascript:onClear()" DisableOnClick="true"/>
              		<BUTTON Id="search" Name="Search" DisplayText="Search" OnClick="javascript:dispatchSearch()" DisableOnClick="true" Emphasized="true"/>
              	</xapl:if>
            </xapl:otherwise>
          </xapl:choose>
        </BUTTONS>
        <PAGINATION/>
      </REPORT>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportData">
    <x2:param name="this"/>
    <!--removed hardcoded filter issue 503017-->
    <!--docutil:set select="$this">
      <F_CalendarMaster.class Value="Generic"/>
    </docutil:set-->
    <xapl:variable name="response">
      <x2:execute command="bcm.framework.queryform.Form:getFormReportData">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
    </xapl:variable>
    <xapl:set-variable name="calendarSearchResult">
      <xapl:value-of select="$response"/>
    </xapl:set-variable>
    <!--xapl:print select="$calendarSearchResult"/-->
    <xapl:return>
      <xapl:value-of select="$response"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
</x2:commands>
