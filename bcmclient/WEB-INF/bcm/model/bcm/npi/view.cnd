<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="init">
    <!--xapl:variable name="itemType" resolver="session" global="true"/>
    <xapl:variable name="dbItemType" resolver="session" global="true"/-->
    <xapl:variable name="pageFrom" resolver="session" global="true"/>
    <xapl:variable name="fromAction" resolver="session" global="true"/>
    <xapl:variable name="npiattributeDetails" resolver="session" global="true"/>
    <xapl:variable name="newProductDetails" resolver="session" global="true"/>
    <xapl:variable name="primaryDocName" resolver="session" global="true"/>
    <xapl:variable name="pkPropName" resolver="session" global="true"/>
    <xapl:variable name="allComnProps" resolver="session" global="true"/>
  </x2:command>


  <x2:command public="yes" description="_" name="load">
    <x2:execute command="bcm.npi.createEditItemView:initSessionVars"/>
    <xapl:if test="$this/MODE/@Value = 'START' ">
      <docutil:remove select="$this/MODE"/>
      <x2:execute command="bcm.context.controller:cleanContext"/>
      <!--xapl:set-variable name="itemType" select="{$this/ITEM_TYPE/@Value}"/-->
      <xapl:set-variable name="pageFrom" select="{$this/PAGE/@Value}"/>
      <xapl:set-variable name="fromAction" select="{$this/ACTION_ID/@Value}"/>
      <xapl:set-variable name="npiattributeDetails"/>
    </xapl:if>
    <!--Need to remove extra form fields from this, to prevent urls from growing huge-->
     <xapl:variable name="returnThis">
       <ROOT>
         <PAGE Value="{$pageFrom}"/>
         <ACTION_ID Value="{$fromAction}"/>
         <ITEM_TYPE Value="{$itemType}"/>
         <FORM_NAME Value="{$this/FORM_NAME[1]/@Value}"/>
         <SERVICE Value="{$this/SERVICE[1]/@Value}"/>
         <DO_SEARCH Value="Yes"/>
         <DIRECTORY Value="bcm.npi"/>
         <FILE Value="view"/>
         <xapl:choose>
		<xapl:when test="string-length($this/START_COUNT/@Value) > 0 ">
		  <START_COUNT Value="{$this/START_COUNT/@Value}" />
		</xapl:when>
		<xapl:otherwise>
		 <START_COUNT Value="0" />
		</xapl:otherwise>
         </xapl:choose>
         <MAX_ROWS Value="15" />
         <xapl:if test="string-length($this/DISPLAY_COUNT/@Value) > 0 ">
            <DISPLAY_COUNT Value="{$this/DISPLAY_COUNT/@Value}" />
         </xapl:if>
          <xapl:if test="string-length($this/SORT_BY/@Value) > 0 ">
               <SORT_BY Value="{$this/SORT_BY/@Value}" />
          </xapl:if>
         <xapl:if test="string-length($this/SORT_ORDER/@Value) > 0 ">
            <SORT_ORDER Value="{$this/SORT_ORDER/@Value}" />
         </xapl:if>
         <xapl:choose>
		<xapl:when test="string-length($this/pagenum/@Value) > 0 ">
		 <pagenum Value="{$this/pagenum/@Value}" />
		</xapl:when>
		<xapl:otherwise>
		 <pagenum Value="0" />
		</xapl:otherwise>
         </xapl:choose>
       </ROOT>
     </xapl:variable>
     <xapl:variable name="msgs">
       <ROOT>
         <xapl:if test="string-length($this/SUCCESS_MESSAGE/@Value) > 0 ">
       		<SUCCESS_MESSAGE Value="{$this/SUCCESS_MESSAGE/@Value}"/>
         </xapl:if>
         <xapl:if test="string-length($this/ERROR_MESSAGE/@Value) > 0 ">
       		<ERROR_MESSAGE Value="{$this/ERROR_MESSAGE/@Value}"/>
         </xapl:if>
       </ROOT>
     </xapl:variable>
     <xapl:variable name="clonedThis">
         <xapl:clone select="$this"/>
     </xapl:variable>
     <docutil:remove select="$this/*"/>
     <!-- retain filters, if any-->
     <xapl:for-each varName="filter" select="$clonedThis/*[substring-before(name() ,  '_'  )  = 'F' and string-length(./@Value) > 0 ]">
       <docutil:remove select="$returnThis/*[name()=name($filter)]"/>
       <docutil:add select="$returnThis">
	 <xapl:value-of select="$filter"/>
       </docutil:add>
     </xapl:for-each>
     <docutil:add select="$this">
       <xapl:value-of select="$returnThis/*"/>
     </docutil:add>
     <xapl:print>
               ::::this in NPI SERACH PAGE:::
               <xapl:value-of select="$this"/>
     </xapl:print>

    <!-- BREADCRUMBS AT TOP OR AFTER CLEAN-CONTEXT-->
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
      <x2:with-param name="display" select="'New Product Introduction'"/>
      <x2:with-param name="page" select="'npiItemDetailsHome'"/>
      <x2:with-param name="this" select="{$this}"/>
    </x2:execute>

    <xapl:variable name="itemForm">
       <x2:execute command="bcm.framework.queryform.Form:getFormContainer">
          <x2:with-param name="this" select="$this"/>
          <x2:with-param name="pSearchParam" select="{$searchParam}"/>
          <x2:with-param name="pFormName" select="$this/FORM_NAME/@Value"/>
          <x2:with-param name="pServiceName" select="$this/SERVICE/@Value"/>
          <x2:with-param name="pSearchReportConfigSource" select="'bcm.npi.view:getReportConfig'"/>
          <x2:with-param name="pReportDataSource" select="'bcm.npi.view:getReportData'"/>
        </x2:execute>
    </xapl:variable>

    <xapl:return>
      <!-- Page Header-->
      <x2:execute command="bcm.npi.view:getHeader">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
      <!-- Container-->
      <x2:execute command="bcm.npi.view:getContainer">
        <x2:with-param name="this" select="{$this}"/>
        <x2:with-param name="pPage" select="$pageFrom"/>
      </x2:execute>
      <xapl:value-of select="$itemForm"/>
      <!-- Links -->
      <!--x2:execute command="bcm.npi.view:getLinks">
        <x2:with-param name="this" select="$this"/>
      </x2:execute-->
      <!-- return parameters-->
      <!--xapl:value-of select="$this/*[string-length(@Value) &gt; 0]"/-->
      <!--
      <xapl:value-of select="$context"/>
-->
    </xapl:return>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    <xapl:return>
     <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <x2:param name="pPage"/>
      <xapl:variable name="userPermissionViewForEntity">
     <x2:execute command="bcm.framework.common:checkAccessPermissions">
       <x2:with-param name="activityName" select="$fromAction"/>
       <x2:with-param name="accessLevel" select="'View'"/>
     </x2:execute>
     </xapl:variable>
     <xapl:return>
      <CONTAINER Scrollable="no">
        <HELP Url="../help/npi_help.htm"/>
        <!--xapl:if test="$userPermissionViewForEntity='True'"-->
          <EXPRESSION_FILTER Value="yes"/>
        <!--/xapl:if-->
        <STEP Name="ViewForm" DisplayText="New Product Introduction" OnClick="{$pageFrom}" Selected="{$pPage = $pageFrom}"/>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportConfig">
    <!--xapl:variable name="pageAction">
        <web:url-decode>
            <web:get-page name="$this/PAGE/@Value"/>
        </web:url-decode>
    </xapl:variable -->

    <xapl:return>

      <REPORT Action="npiItemDetails.jsp" Selectable="All" Scrollable="yes" ScrollableContainer="no" ShowFilter="yes" Id="#" SelectedId="SELECTED_ID" PagingTitle="yes" Freezable="yes">
        <FIELDS>
         <!--FIELD Name="FROM_ACT" Type="Hidden" DisplayType="Hidden" Value="{$this/FROM_ACT[position() = 1]/@Value}"/-->
          <!--get form's report fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>

          <!-- get Hidden Fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
          <FIELD Name="SAVE_ACTION" DisplayType="Hidden" Value="{$this/SAVE_ACTION/@Value}"/>
          <FIELD Name="ACTION_ID" DisplayType="Hidden" Value="{$fromAction}"/>
        </FIELDS>

       <xapl:variable name="userPermissionViewForEntity">
     <x2:execute command="bcm.framework.common:checkAccessPermissions">
       <x2:with-param name="activityName" select="$fromAction"/>
       <x2:with-param name="accessLevel" select="'View'"/>
     </x2:execute>
      </xapl:variable>
      <xapl:variable name="userPermissionAddForEntity">
     <x2:execute command="bcm.framework.common:checkAccessPermissions">
       <x2:with-param name="activityName" select="$fromAction"/>
       <x2:with-param name="accessLevel" select="'Add'"/>
     </x2:execute>
      </xapl:variable>
      <xapl:variable name="userPermissionUpdateForEntity">
     <x2:execute command="bcm.framework.common:checkAccessPermissions">
       <x2:with-param name="activityName" select="$fromAction"/>
       <x2:with-param name="accessLevel" select="'Update'"/>
     </x2:execute>
      </xapl:variable>
      <xapl:variable name="userPermissionRemoveForEntity">
     <x2:execute command="bcm.framework.common:checkAccessPermissions">
       <x2:with-param name="activityName" select="$fromAction"/>
       <x2:with-param name="accessLevel" select="'Remove'"/>
     </x2:execute>
      </xapl:variable>

        <BUTTONS>
	  <xapl:if test="$userPermissionViewForEntity='True'">
	    <BUTTON Id="Export" Name="Export" DisplayText="Export to Excel" OnClick="javascript:onExportToExcelGlobal('item','xls')" DisableOnClick="true" Disabled="report"/>
	    <DIVIDER/>
	  </xapl:if>
	  <xapl:if test="$userPermissionUpdateForEntity='True'">
	    <BUTTON Id="MassEdit" Name="MassEdit" DisplayText="Mass Update" OnClick="javascript:massEdit()" DisableOnClick="true" Disabled="report"/>
	  </xapl:if>
	  <xapl:if test="$userPermissionAddForEntity='True'">
	    <BUTTON Id="Create" Name="Create" DisplayText="Create" OnClick="javascript:onCreate()" DisableOnClick="true"/>
	    <BUTTON Id="Copy" Name="Copy" DisplayText="Copy" OnClick="javascript:onCopy()" DisableOnClick="true" Disabled="report"/>
	  </xapl:if>
	    <xapl:if test="$userPermissionAddForEntity='True' or $userPermissionUpdateForEntity='True'">
	    <BUTTON Id="Edit" Name="Edit" DisplayText="Edit" OnClick="javascript:onEdit()" DisableOnClick="true" Disabled="report"/>
	  </xapl:if>
	  <xapl:if test="$userPermissionRemoveForEntity='True'">
	    <BUTTON Id="Delete" Name="Delete" DisplayText="Delete" OnClick="javascript:onDelete()" DisableOnClick="true" Disabled="report"/>
	    <DIVIDER/>
	  </xapl:if>
	  <xapl:if test="$userPermissionViewForEntity='True'">
	    <BUTTON Id="Clear" Name="Clear" DisplayText="Clear" OnClick="javascript:onClear()" DisableOnClick="true"/>
	    <BUTTON Id="Search" Name="Search" DisplayText="Search" OnClick="javascript:dispatchSearch()" DisableOnClick="true" Emphasized="yes"/>
	  </xapl:if>
        </BUTTONS>
        <PAGINATION/>
      </REPORT>
    </xapl:return>
  </x2:command>

  <x2:command public="yes" description="_" name="getReportData">
    <x2:param name="this"/>
    <xapl:variable name="returnVar">
      <x2:execute command="bcm.framework.queryform.Form:getFormReportData">
        <x2:with-param name="this" select="$this"/>
        <x2:with-param name="fromProperty" select="'RESULT_PROPERTY'"/>
        <x2:with-param name="delimeter" select="'.'"/>
      </x2:execute>
    </xapl:variable>
    <xapl:return>
      <xapl:value-of select="$returnVar"/>
    </xapl:return>
  </x2:command>

  <!--x2:command public="yes" description="_" name="getLinks">
    <xapl:return>
      <LINKS>
        <x2:execute command="bcm.framework.common:getLinks">
          <x2:with-param name="pPage" select="$pageFrom"/>
          <x2:with-param name="this" select="$this"/>
          <x2:with-param name="pReturnLink" select="$this/RET_PAGE/@Value"/>
        </x2:execute>
      </LINKS>
    </xapl:return>
  </x2:command-->
</x2:commands>
