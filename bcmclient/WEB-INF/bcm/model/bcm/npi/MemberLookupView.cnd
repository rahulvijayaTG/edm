<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">

  <x2:command name="init" public="yes">
    <xapl:variable name="lookupData" resolver="session" global="true"/>
  </x2:command>

<x2:command public="yes" description="_" name="getContainer">
    <x2:param name="pPage"/>
    <xapl:variable name="isAuditTrail">
        <xapl:value-of select="{$currentDbTable/TABLE_NAME/@AuditTrail}"/>
    </xapl:variable>
    <!-- ONLINE HELP -->
    <xapl:variable name="helpDirectory">
      <xapl:value-of select="{$helpFileDirectory}"/>
    </xapl:variable>
    <xapl:print select="$helpDirectory"/>
    <xapl:variable name="helpFile">
      <xapl:choose>
        <xapl:when test="$helpFileName/TABLE_HELPFILE_MAP/*[@Name=$this/TABLE_NAME[1]/@Value] and string-length($helpFileName/TABLE_HELPFILE_MAP/*[@Name=$this/TABLE_NAME[1]/@Value]/@searchHelpFile)>0">
          <xapl:value-of select="concat($helpDirectory,'/',$helpFileName/TABLE_HELPFILE_MAP/*[@Name=$this/TABLE_NAME[1]/@Value]/@searchHelpFile)"/>
        </xapl:when>
        <xapl:otherwise>
          <xapl:value-of select="concat($helpDirectory,'/',$helpFileName/DEFAULT_HELP_FILENAME/@searchHelpFile)"/>
        </xapl:otherwise>
      </xapl:choose>
    </xapl:variable>
    <xapl:print select="$helpFile"/>
    <!-- ONLINE HELP -->
    <xapl:variable name="tableDisplayName">
      <xapl:choose>
        <xapl:when test="$isAuditTrail = 'true'">
          <xapl:variable name="tablename">
            <i18n:text>
              <xapl:value-of select="substring-before($this/TABLE_NAME[1]/@Value, '_AT')"/>
            </i18n:text>
          </xapl:variable>
          <xapl:variable name="audit">
            <i18n:text>
              <xapl:value-of select="'Audit'"/>
            </i18n:text>
          </xapl:variable>
          <xapl:value-of select="concat($tablename,' ',$audit)"/>
        </xapl:when>
        <xapl:otherwise>
          <i18n:text>
            <xapl:value-of select="$currentDbTable/TABLE_NAME/@DisplayName"/>
          </i18n:text>
        </xapl:otherwise>
      </xapl:choose>
    </xapl:variable>
    <xapl:variable name="showWhereUsed">
      <xapl:choose>
        <xapl:when test="$currentDbTable/TABLE_NAME/@AuditTrail or not($currentDbTable/@hasPks)">no</xapl:when>
        <xapl:when test="$this/SERVICE/@Value = 'BCMNCService'">no</xapl:when>
        <xapl:otherwise>yes</xapl:otherwise>
      </xapl:choose>
    </xapl:variable>
    <xapl:return>
      <CONTAINER Scrollable="no">
        <HELP Url="{$helpFile}"/>
        <TABLE_EDITOR/>
        <STEP Name="ViewTable" DisplayText="{$tableDisplayName}" OnClick="{$pages:npiMemberLookup}" Selected="{$pPage = 'npiMemberLookup'}">
          <WHERE_USED Value="{$showWhereUsed}"/>
          <EXPRESSION_FILTER Value="yes"/>
        </STEP>
      </CONTAINER>
    </xapl:return>
  </x2:command>

  <x2:command public="yes" name="gotoSelectForeignKey">

    <!--For look-up from massupdate page of complex query forms the context must be set to group edit page(PAGE1) instead of the search page from where massupdate operation was selected.
           The user can do several FK look-ups before saving the changes.
           Since the data might be coming from more than one table, to retain field values between different fk selections, all the data must be stored under a single root in sessionDaa variable.
           For qfs FROM_TABLE is set to SESSION_DATA-->
           <xapl:variable name="pg_val"/>
           <xapl:choose>
              <xapl:when test="string-length($this/PAGE1/@Value) > 0">
                 <xapl:set-variable name="pg_val">
                  <xapl:value-of select="$this/PAGE1/@Value"/>
                 </xapl:set-variable>
              </xapl:when>
              <xapl:otherwise>
                <xapl:set-variable name="pg_val">
                <xapl:value-of select="$this/PAGE/@Value"/>
                </xapl:set-variable>
              </xapl:otherwise>
           </xapl:choose>
       <xapl:print select="$pg_val"/>
    <!--
    Some other pages(non-table editors) can reuse this function for fk look up. initializing sessionData variable  here for them.
    -->
    <xapl:if test="not($sessionData)">
      <xapl:set-variable name="sessionData">
        <TABLES/>
      </xapl:set-variable>
    </xapl:if>
    <!--
    Since the user is going to another table to select a foreign key,
    save the values that he has entered in the current form, so that
    when he comes back to the add page again, the entered values would
    be retained.
    -->
    <xapl:print>
           getParentLevelMembers NPI
           <xapl:value-of select="$this"/>
    </xapl:print>
    <docutil:set select="$sessionData">
      <docutil:element name="{$this/FROM_TABLE/@Value}">
        <xapl:value-of select="$this/*[string-length(@Value) > 0] "/>
      </docutil:element>
    </docutil:set>
    <xapl:print select="$sessionData"/>
    <xapl:variable name="optionalParams">
      <ROOT>
        <xapl:value-of select="$this/REFERRED_COLUMN"/>
        <xapl:value-of select="$this/FROM_COLUMN"/>
      </ROOT>
    </xapl:variable>
    <x2:execute command="bcm.framework.ContextController:setContext">
      <x2:with-param name="fromPage" select="$pg_val"/>
      <x2:with-param name="fromTable" select="$this/TABLE_NAME/@Value"/>
      <x2:with-param name="toPage" select="'npiMemberLookup'"/>
      <x2:with-param name="toTable" select="$this/REFERRED_TABLE/@Value"/>
      <x2:with-param name="optionalParams" select="$optionalParams"/>
    </x2:execute>

    <xapl:variable name="levelFilter"/>
    <xapl:choose>
        <xapl:when test="$this/REFERRED_TABLE/@Value='Member'">
            <xapl:variable name="fromColumn">
                 <xapl:value-of select="{$this/FROM_COLUMN/@Value}"/>
            </xapl:variable>
            <xapl:variable name="levelDetailsRes">
               <xcore:execute-method name="//BCMMasterService/getLevelsForDocFromMemRelMetaData" entireResponse="true">
                    <DocumentName Value="{$this/FROM_TABLE/@Value}"/>
               </xcore:execute-method>
            </xapl:variable>
            <xapl:print select="$levelDetailsRes"/>
            <xapl:for-each select="$levelDetailsRes/RESPONSE/MemberRelationMetaData" varName="memRelMetaData">
                <xapl:if test="$memRelMetaData/sourceField/@Value=$fromColumn">
                    <xapl:set-variable name="levelFilter">
                            <F_LevelId Value="{$memRelMetaData/levelID/@Value}"/>
                    </xapl:set-variable>
                    <xapl:print>
                        Matching level found in mem rel meta data
                        <xapl:value-of select="$levelFilter"/>
                     </xapl:print>
                </xapl:if>
            </xapl:for-each>
        </xapl:when>
        <xapl:otherwise>
        </xapl:otherwise>
    </xapl:choose>

    <web:display-page>
      <web:get-page name="npiMemberLookup">
        <xapl:value-of select="$this/FROM_TABLE"/>
        <xapl:value-of select="$this/FROM_COLUMN"/>
        <xapl:value-of select="$this/REFERRED_TABLE"/>
        <xapl:value-of select="$this/REFERRED_COLUMN"/>
        <TABLE_NAME Value="{$this/REFERRED_TABLE/@Value}"/>
        <DO_SEARCH Value="Yes"/>
        <xapl:value-of select="$this/SERVICE"/>
        <xapl:value-of select="$this/DIRECTORY"/>
        <xapl:value-of select="$this/FILE"/>
        <xapl:value-of select="$levelFilter"/>
      </web:get-page>
    </web:display-page>
  </x2:command>

  <!--
  ******************************************************
  ***************** -->

  <x2:command public="yes" name="showSelectedValue">
    <xapl:variable name="pageContext">
      <x2:execute command="bcm.framework.ContextController:getPageContext">
        <x2:with-param name="currentPage" select="'npiMemberLookup'"/>
        <x2:with-param name="currentTable" select="$this/TABLE_NAME/@Value"/>
      </x2:execute>
    </xapl:variable>
    <xapl:variable name="selectedColumnValue">
      <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
        <x2:with-param name="selectedId" select="$this/SELECTED_ID/@Value"/>
        <x2:with-param name="key" select="$pageContext/REFERRED_COLUMN/@Value"/>
      </x2:execute>
    </xapl:variable>
    <xapl:print>inside member lookup this
    <xapl:value-of select="$this"/> selectedColumnValue
    <xapl:value-of select="$selectedColumnValue"/>
    pageContext
    <xapl:value-of select="$pageContext"/>
    </xapl:print>
    <xapl:variable name="sourceValue"/>
    <xapl:variable name="lookupName"/>
    <!--xapl:if test="$pageContext/TO_TABLE/@Value='Member'">
        <xapl:set-variable name="selectedColumnValue">
          <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
            <x2:with-param name="selectedId" select="$this/SELECTED_ID/@Value"/>
            <x2:with-param name="key" select="'Id'"/>
          </x2:execute>
        </xapl:set-variable>

        <xapl:print>inside member lookup</xapl:print>
        <xapl:for-each select="$lookupData/*" varName="currentRow">
            <xapl:variable name="currentVal">
                <xapl:value-of select="$currentRow/Id/@Value"/>
            </xapl:variable>
            <xapl:variable name="currentName">
                <xapl:value-of select="$currentRow/*[name()=$pageContext/REFERRED_COLUMN/@Value]/@Value"/>
            </xapl:variable>
            <xapl:if test="$currentVal=$selectedColumnValue">
                <xapl:set-variable name="sourceValue">
                    <xapl:value-of select="$currentRow/SOURCE/@Value"/>
                </xapl:set-variable>
                <xapl:set-variable name="lookupName">
                    <xapl:value-of select="$currentName"/>
                </xapl:set-variable>
            </xapl:if>
        </xapl:for-each>

        <xapl:set-variable name="selectedColumnValue">
            <xapl:value-of select="$lookupName"/>
         </xapl:set-variable>
    </xapl:if-->
    <xapl:print select="$sessionData"/>
    <xapl:print select="$sessionData/*[name() = $pageContext/FROM_TABLE/@Value]"/>

    <docutil:remove select="$sessionData/*[name() = $pageContext/FROM_TABLE/@Value]/
    *[name() = $pageContext/FROM_COLUMN/@Value]"/>
    <web:display-page>
      <web:get-page name="{$pageContext/FROM_PAGE/@Value}">
        <!--<xapl:value-of select="$sessionData/*[name() = $pageContext/FROM_TABLE/@Value]/*"/>-->
        <docutil:element name="{$pageContext/FROM_COLUMN/@Value}" Value="{$selectedColumnValue}"/>
        <FROM_SELECT_FOREIGN_KEY Value="true"/>
        <FROM_TABLE Value="{$pageContext/FROM_TABLE/@Value}"/>
        <USE_SESSIONDATA Value="TRUE"/>
      </web:get-page>
    </web:display-page>
  </x2:command>


  <x2:command public="yes" name="selectForeignKey">
    <xapl:variable name="pageContext">
      <x2:execute command="bcm.framework.ContextController:getPageContext">
        <x2:with-param name="currentPage" select="'npiMemberLookup'"/>
        <x2:with-param name="currentTable" select="$this/TABLE_NAME/@Value"/>
      </x2:execute>
    </xapl:variable>
    <xapl:variable name="selectedColumnValue">
      <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
        <x2:with-param name="selectedId" select="$this/SELECTED_ID/@Value"/>
        <x2:with-param name="key" select="$pageContext/REFERRED_COLUMN/@Value"/>
      </x2:execute>
    </xapl:variable>
    <xapl:print select="$sessionData"/>
    <xapl:print select="$sessionData/*[name() = $pageContext/FROM_TABLE/@Value]"/>
    <xapl:print select="$this/TABLE_NAME/@Value"/>
    <xapl:print select="$selectedColumnValue"/>
    <xapl:print select="$pageContext"/>
    <xapl:print select="$pageContext/FROM_COLUMN/@Value"/>
    <docutil:remove select="$sessionData/*[name() = $pageContext/FROM_TABLE/@Value]/
    *[name() = $pageContext/FROM_COLUMN/@Value]"/>
    <web:display-page>
      <web:get-page name="{$pageContext/FROM_PAGE/@Value}">
        <!--<xapl:value-of select="$sessionData/*[name() = $pageContext/FROM_TABLE/@Value]/*"/>-->
        <docutil:element name="{$pageContext/FROM_COLUMN/@Value}" Value="{$selectedColumnValue}"/>
        <FROM_SELECT_FOREIGN_KEY Value="true"/>
        <FROM_TABLE Value="{$pageContext/FROM_TABLE/@Value}"/>
        <USE_SESSIONDATA Value="TRUE"/>
      </web:get-page>
    </web:display-page>
  </x2:command>

  <x2:command public="yes" name="cancel">
    <xapl:variable name="pageContext">
      <x2:execute command="bcm.framework.ContextController:getPageContext">
        <x2:with-param name="currentPage" select="'npiMemberLookup'"/>
        <x2:with-param name="currentTable" select="$this/TABLE_NAME/@Value"/>
      </x2:execute>
    </xapl:variable>
    <xapl:print select="$sessionData"/>
    <xapl:print select="$sessionData/*[name() = $pageContext/FROM_TABLE/@Value]"/>
    <xapl:print select="$this/TABLE_NAME/@Value"/>
    <xapl:print select="$pageContext"/>
    <xapl:print select="$pageContext/FROM_COLUMN/@Value"/>
    <docutil:remove select="$sessionData/*[name() = $pageContext/FROM_TABLE/@Value]/
        *[name() = $pageContext/FROM_COLUMN/@Value]"/>
    <web:display-page>
      <web:get-page name="{$pageContext/FROM_PAGE/@Value}">
        <FROM_SELECT_FOREIGN_KEY Value="true"/>
        <FROM_TABLE Value="{$pageContext/FROM_TABLE/@Value}"/>
        <USE_SESSIONDATA Value="TRUE"/>
      </web:get-page>
    </web:display-page>
  </x2:command>

  <x2:command public="yes" description="_" name="getReportConfig">
      <!-- if no pk then ??? -->
      <xapl:print select="$pk"/>
      <xapl:variable name="fromPageExists">
        <x2:execute command="bcm.framework.ContextController:doesFromPageExist">
          <x2:with-param name="currentPage" select="'npiMemberLookup'"/>
          <x2:with-param name="currentTable" select="$this/TABLE_NAME[position() = 1]/@Value"/>
        </x2:execute>
      </xapl:variable>
      <xapl:print>
          <xapl:value-of select="$fromPageExists"/>
          <xapl:value-of select="$this/FROM_COLUMN_LINK"/>
      </xapl:print>
      <xapl:variable name="reportSelectable">
        <xapl:choose>
          <xapl:when test=" $fromPageExists = 'true' and
          ( not($this/FROM_COLUMN_LINK) or $this/FROM_COLUMN_LINK/@Value != 'yes' )">Single</xapl:when>
          <xapl:otherwise>All</xapl:otherwise>
        </xapl:choose>
      </xapl:variable>
      <xapl:return>
        <REPORT Selectable="{$reportSelectable}" Scrollable="yes" Id="#" SelectedId="SELECTED_ID" PagingTitle="yes">
          <FIELDS>
            <!-- Table Column Fields -->
            <xapl:variable name="seq" select="0"/>
            <xapl:for-each varName="column" select="$currentDbTable/TABLE_NAME/COLUMNS/PROPERTY ">
              <!-- hide Server side and UI side columns -->
              <xapl:if test="$column/PRESENTATION/HIDDEN/@Value = 'no' and not($currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/HIDDEN_COLUMNS/*/@Value = $column/@Name) ">
                <xapl:variable name="decimals"/>
                <xapl:variable name="type">
                  <xapl:choose>
                    <xapl:when test="starts-with($column/@Type , 'string')">
                      <xapl:value-of select="'Text'"/>
                    </xapl:when>
                    <xapl:when test="starts-with($column/@Type , 'LongString')">
                      <xapl:value-of select="'textarea'"/>
                    </xapl:when>
                    <xapl:when test="starts-with($column/@Type , 'datetime')">
                      <xapl:value-of select="'DateTime'"/>
                    </xapl:when>
                    <xapl:when test="starts-with($column/@Type , 'date')">
                      <xapl:value-of select="'Date'"/>
                    </xapl:when>
                    <xapl:when test="starts-with($column/@Type , 'int')">
                      <xapl:value-of select="'Number'"/>
                    </xapl:when>
                    <xapl:when test="$column/@Type = 'float' or $column/@Type = 'double'">
                      <xapl:value-of select="'Number'"/>
                      <xapl:set-variable name="decimals">
                        <xapl:choose>
                          <xapl:when test="string-length($column/PRESENTATION/DECIMALS/@Value) > 0">
                            <xapl:value-of select="$column/PRESENTATION/DECIMALS/@Value"/>
                          </xapl:when>
                          <xapl:otherwise>
                            <xapl:value-of select="'2'"/>
                          </xapl:otherwise>
                        </xapl:choose>
                      </xapl:set-variable>
                    </xapl:when>
                    <xapl:otherwise>Text</xapl:otherwise>
                  </xapl:choose>
                </xapl:variable>
                <xapl:variable name="name">
                  <xapl:choose>
                    <xapl:when test="string-length($column/@DisplayName) > 0 ">
                      <xapl:value-of select="$column/@DisplayName"/>
                    </xapl:when>
                    <xapl:otherwise>
                      <xapl:value-of select="$column/PRESENTATION/DISPLAY_NAME/@Value"/>
                    </xapl:otherwise>
                  </xapl:choose>
                </xapl:variable>
                <!--
                Declare a variable to hold the URL value in case the current field
                is a foriegn key to another table.
                -->
                <xapl:variable name="url"/>
                <!--
                Initialize the variable only if the current field refers to another table
                -->
                <xapl:if test="$column/@Refers or $column/@Refers != 'null'">
                  <xapl:set-variable name="url">
                    <web:get-page name="linkToTable">
                      <TABLE_NAME Value="{$column/@Refers}"/>
                      <COLUMN_NAME Value="{$column/@Name}"/>
                      <LINKED_COLUMN_SEARCH_NAME Value="{concat('F_', $column/@ToProperty)}"/>
                      <FROM_TABLE Value="{$this/TABLE_NAME[position() = 1]/@Value}"/>
                      <xapl:value-of select="$this/SERVICE"/>
                      <xapl:value-of select="$this/DIRECTORY"/>
                      <xapl:value-of select="$this/FILE"/>
                    </web:get-page>
                  </xapl:set-variable>
                </xapl:if>
                <!--<xapl:print select="$type"/>-->
                <xapl:variable name="filter_type"/>
                <xapl:variable name="filter_dataSourceType"/>
                <xapl:variable name="filter_dataSourceName"/>
                <xapl:variable name="filter_selectAll"/>
                <xapl:if test="$column/@ValidValues != 'null'  or count($column/DATASOURCE) > 0 or $column/PRESENTATION/SEARCH_BY/@Value = 'dropdown'">
                  <xapl:set-variable name="filter_type" select="'dropdown'"/>
                  <xapl:set-variable name="filter_dataSourceType" select="'Command'"/>
                  <xapl:set-variable name="filter_dataSourceName" select="'bcm.framework.tableeditor.Table:getOptionTypes'"/>
                  <xapl:set-variable name="filter_selectAll" select="Yes"/>
                </xapl:if>
                <FIELD Sequence="{$seq}" I18Nize="{$column/PRESENTATION/I18NIZE/@Value}" Name="{$column/@Name}" Filter="{$column/PRESENTATION/SEARCHABLE/@Value}" Primarykey="{$column/@PrimaryKey}" DisplayText="{$name}" DisplayType="{$type}" Decimals="{$decimals}" DisplayNoWrap="{$column/PRESENTATION/NO_WRAP/@Value}" Sortable="{$column/PRESENTATION/SORTABLE/@Value}" Hidden="{$column/PRESENTATION/HIDDEN/@Value}" Required="{$column/@Required}" Url="{$url}" Filter_type="{$filter_type}" Filter_dataSourceType="{$filter_dataSourceType}" Filter_dataSourceName="{$filter_dataSourceName}" Filter_selectAll="{$filter_selectAll}"/>
              </xapl:if>
              <xapl:set-variable name="seq" select="$seq + 1"/>
            </xapl:for-each>
            <!-- Hidden Fields -->
            <FIELD Name="DO_SEARCH" DisplayType="Hidden" Value="{$this/DO_SEARCH[position() = 1]/@Value}"/>
            <FIELD Name="DIRECTORY" DisplayType="Hidden" Value="{$this/DIRECTORY[position() = 1]/@Value}"/>
            <FIELD Name="FILE" DisplayType="Hidden" Value="{$this/FILE[position() = 1]/@Value}"/>
            <FIELD Name="SORT_BY" DisplayType="Hidden" Value="{$this/SORT_BY[position() = 1]/@Value}"/>
            <FIELD Name="SORT_ORDER" DisplayType="Hidden" Value="{$this/SORT_ORDER[position() = 1]/@Value}"/>
            <FIELD Name="TABLE_NAME" DisplayType="Hidden" Value="{$this/TABLE_NAME[position() = 1]/@Value}"/>
            <FIELD Name="SERVICE" DisplayType="Hidden" Value="{$this/SERVICE[position() = 1]/@Value}"/>
            <FIELD Name="FILTER_NAME" DisplayType="Hidden" Value="{$this/FILTER_NAME/@Value}"/>
            <FIELD Name="FILTER_SCOPE" DisplayType="Hidden" Value="{$this/FILTER_SCOPE/@Value}"/>
            <FIELD Name="FILTER_TEXT" DisplayType="Hidden" Value="{$this/FILTER_TEXT/@Value}"/>
            <FIELD Name="FILTER_MODE" DisplayType="Hidden" Value="{$this/FILTER_MODE/@Value}"/>
            <FIELD Name="FILTER_ID" DisplayType="Hidden" Value="{$this/FILTER_ID/@Value}"/>
            <FIELD Name="HIDDEN_COLUMN" DisplayType="Hidden" Value=""/>
            <FIELD Name="UPDATE_ALL" DisplayType="Hidden" Value="{$this/UPDATE_ALL/@Value}"/>
            <FIELD Name="EXPORT_ALL" DisplayType="Hidden"/>
            <FIELD Name="PAGE" DisplayType="Hidden" Value="npiMemberLookup"/>
            <FIELD Name="FROM_TABLE" DisplayType="Hidden" Value="{$this/FROM_TABLE/@Value}"/>
            <FIELD Name="FROM_COLUMN" DisplayType="Hidden" Value="{$this/FROM_COLUMN/@Value}"/>
            <FIELD Name="REFERRED_TABLE" DisplayType="Hidden" Value="{$this/REFERRED_TABLE/@Value}"/>
            <FIELD Name="TABLE_ROW_OPERATION" DisplayType="Hidden"/>
            <FIELD Name="SELECTED_AUTH_SCOPE" DisplayType="Hidden"/>
            <FIELD Name="FROZEN_COLUMN" DisplayType="Hidden" Value="{$this/FROZEN_COLUMN/@Value}"/>
            <FIELD Name="FROZEN_SEQUENCE" DisplayType="Hidden" Value="{$this/FROZEN_SEQUENCE/@Value}"/>
            <FIELD Name="COLUMN_SEQUENCE" DisplayType="Hidden" Value="{$this/COLUMN_SEQUENCE/@Value}"/>
            <FIELD Name="SELECTED_COLUMN" DisplayType="Hidden" Value="{$this/SELECTED_COLUMN/@Value}"/>
            <FIELD Name="COLUMN_COUNT" DisplayType="Hidden" Value="{$this/COLUMN_COUNT/@Value}"/>
            <FIELD Name="ACTIVITY_ID" DisplayType="Hidden" Value="{$this/ACTIVITY_ID/@Value}"/>
            <!--FIELD Name="FAV_ID" DisplayType="Hidden" Value="{$this/FAV_ID/@Value}"/-->
          </FIELDS>
          <BUTTONS>
              <!-- for Audit trail tables -->
              <xapl:if test="$currentDbTable/TABLE_NAME/@AuditTrail = 'true' ">
              <!--xapl:if test="$this/SERVICE/@Value != 'BCMOutboundService'"-->
              <BUTTON Id="export" Name="export" DisplayText="Export to Excel" OnClick="javascript:saveReport()" Disabled="report" DisableOnClick="true" ActionType="_VIEW_ONLY_"/>
              <DIVIDER/>
              <BUTTON Id="clear" Name="Clear" DisplayText="Clear" OnClick="javascript:onClearFilter()" DisableOnClick="true" ActionType="_VIEW_ONLY_"/>
              <DIVIDER/>
              <BUTTON Id="search" Name="Search" DisplayText="Search" OnClick="javascript:dispatchSearch()" DisableOnClick="true" ActionType="_VIEW_ONLY_"/>
              <!--/xapl:if-->
            </xapl:if>
            <!-- general tables (without Audit trail) -->
            <xapl:if test="$currentDbTable/TABLE_NAME[not(@AuditTrail)]">
              <!--xapl:if test="$this/FROM_COLUMN_LINK/@Value = 'yes'"-->
              <!--BUTTON Id="export" Name="export" DisplayText="Export to Excel" OnClick="javascript:saveReport()" Disabled="report" DisableOnClick="true" ActionType="_VIEW_ONLY_"/-->
              <xapl:if test="$this/SERVICE/@Value != 'BCMOutboundService' ">
                <xapl:choose>
                  <xapl:when test=" $fromPageExists = 'true' and
                          ( not($this/FROM_COLUMN_LINK) or $this/FROM_COLUMN_LINK/@Value != 'yes' ) ">
                    <BUTTON Id="select" Name="Select" DisplayText="Select And Return" OnClick="javascript:onMemberLookup()" Disabled="report" DisableOnClick="true" ActionType="_VIEW_ONLY_"/>
                    <BUTTON Id="cancel" Name="Cancel" DisplayText="Cancel" OnClick="javascript:onMemberLookupCancel()" DisableOnClick="true"/>
                  </xapl:when>
                  <xapl:otherwise>
                    <xapl:if test="count($header/BREADCRUMBS/BREADCRUMB) > 1">
                      <BUTTON Id="back" Name="Back" DisplayText="Back" OnClick="javascript:back()" DisableOnClick="true" ActionType="_VIEW_ONLY_"/>
                    </xapl:if>
                    <xapl:if test="$currentDbTable/@hasPks = 'yes' and $currentDbTable/@CanUpdate = 'yes' ">
                      <BUTTON Id="group_edit" Name="GroupEdit" DisplayText="Mass Update" OnClick="javascript:onGroupEdit()" Disabled="report" DisableOnClick="true" ActionType="_EDIT_"/>
                      <DIVIDER/>
                    </xapl:if>
                  </xapl:otherwise>
                </xapl:choose>
                <!--xapl:if test="$currentDbTable/@CanAdd = 'yes' ">
                  <BUTTON Id="add" Name="Add" DisplayText="Create" OnClick="javascript:onAdd()" DisableOnClick="true" ActionType="_ADD_"/>
                </xapl:if>
                <xapl:if test="$currentDbTable/@CanAdd = 'yes' ">
                  <BUTTON Id="copy" Name="Copy" DisplayText="Copy" OnClick="javascript:onCopy()" Disabled="report" DisableOnClick="true" ActionType="_COPY_"/>
                </xapl:if>
                <xapl:if test="$currentDbTable/@hasPks = 'yes' and $currentDbTable/@CanUpdate = 'yes' ">
                  <BUTTON Id="edit" Name="Edit" DisplayText="Edit" OnClick="javascript:onEdit()" Disabled="report" DisableOnClick="true" ActionType="_EDIT_"/>
                </xapl:if>
                <xapl:if test="$currentDbTable/@hasPks = 'yes' and $currentDbTable/@CanRemove = 'yes' ">
                  <BUTTON Id="delete" Name="Delete" DisplayText="Delete" OnClick="javascript:onDelete()" Disabled="report" DisableOnClick="true" ActionType="_DELETE_"/>
                </xapl:if-->
              </xapl:if>
              <DIVIDER/>
              <BUTTON Id="clear" Name="Clear" DisplayText="Clear" OnClick="javascript:onClearFilter()" DisableOnClick="true" ActionType="_VIEW_ONLY_"/>
              <DIVIDER/>
              <BUTTON Id="search" Name="Search" DisplayText="Search" OnClick="javascript:dispatchSearch()" DisableOnClick="true" ActionType="_VIEW_ONLY_" Emphasized="yes"/>
            </xapl:if>
          </BUTTONS>
          <PAGINATION/>
        </REPORT>
      </xapl:return>
  </x2:command>

  <x2:command public="yes" description="_" name="getReportData">
      <x2:param name="pIds"/>
      <xapl:variable name="request"/>
      <xapl:set-variable name="request" select="concat('//', $this/SERVICE[1]/@Value, '/getDocSmart')"/>
      <xapl:choose>
        <xapl:when test="($this/SERVICE[1]/@Value = 'BCMMasterService' or $this/SERVICE[1]/@Value = 'BCMOutboundService') and ($currentDbTable/TABLE_NAME[not(@AuditTrail)])">
          <xapl:set-variable name="request" select="concat('//', $this/SERVICE/@Value, '/getDocSmart')"/>
        </xapl:when>
        <xapl:otherwise>
          <xapl:set-variable name="request" select="concat('//', $this/SERVICE/@Value, '/getDocument')"/>
        </xapl:otherwise>
      </xapl:choose>
      <xapl:variable name="data"/>
      <!-- if no expression filter present and number of filters applied (F_xyz) = 0 then default do_search is No -->
      <xapl:print>
        BEFORE CALLING GET REPORT DATA::::::pIds==
        <xapl:value-of select="$pIds"/>
        BEFORE CALLING GET REPORT DATA::::::$currentPref==
        <xapl:value-of select="$currentPref"/>
        BEFORE CALLING GET REPORT DATA::::::count(F_)==
        <xapl:value-of select="count($currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/FILTERS/*[substring-before(name() ,  '_'  )  = 'F'  ])"/>
        BEFORE CALLING GET REPORT DATA::::::EXP_FILTER==
        <xapl:value-of select="count($currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/FILTERS/FILTER_DETAILS)"/>
      </xapl:print>
      <xapl:choose>
        <!-- Check for $currentDbTable/@NoAccess as this variable is available ONLY if the document is not accessible to the user -->
        <xapl:when test="( not($currentDbTable/@NoAccess) ) and ( $this/DO_SEARCH[1]/@Value = 'Yes' or $this/DO_SEARCH[1]/@Value = 'yes' ) ">
          <xapl:print>chandy 1</xapl:print>
          <xapl:set-variable name="data">
            <xcore:execute-method name="{$request}" DocumentName="{$this/TABLE_NAME/@Value}" StartAtRow="{$this/*[name() = 'START_COUNT']/@Value}" MaxRows="{$this/*[name() = 'MAX_ROWS']/@Value}" ReturnRowCount="yes" entireResponse="true">
              <xapl:choose>
                <xapl:when test="count($pIds/*) > 0">
                      <xapl:print>chandy 2</xapl:print>
                  <xapl:value-of select="$pIds/*"/>
                </xapl:when>
                <xapl:otherwise>
                  <!-- Expression Filters-->
                  <xapl:print>
                        EXPRESSION FILTERS::
                        <xapl:value-of select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/FILTERS/FILTER_DETAILS"/>
                  </xapl:print>
                  <xapl:if test="count($currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/FILTERS/FILTER_DETAILS) > 0">
                    <FILTER_DETAILS>
                      <xapl:value-of select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/FILTERS/FILTER_DETAILS/LOGICAL"/>
                    </FILTER_DETAILS>
                  </xapl:if>
                  <!-- Manual Filters-->
                  <xapl:print>chandy 3</xapl:print>

                  <xapl:for-each varName="column" select="$currentDbTable/TABLE_NAME/COLUMNS/*">
                    <xapl:if test="{ string-length($this/*[name()  = concat('F_',$column/@Name)]/@Value) != 0  and ($column/@Type = 'string' or $column/@Type = 'LongString' or $column/@Type = 'boolean')}">
                      <xcore:search-by property="{$column/@Name}" value="{$this/*[name() = concat('F_' ,$column/@Name)]/@Value}"/>
                    </xapl:if>
                    <xapl:if test="{string-length($this/*[name() = concat('F_' ,$column/@Name)]/@Value) != 0  and ($column/@Type = 'int' or $column/@Type = 'float' or $column/@Type = 'double')}">
                      <xcore:search-by property="{$column/@Name}" value="{$this/*[name() = concat('F_' ,$column/@Name)]/@Value}" matchby="{$this/*[name() = concat('F_', $column/@Name, '_OPERATOR')]/@Value}"/>
                    </xapl:if>
                    <xapl:if test="{$column/@Type = 'date' or $column/@Type = 'datetime' }">
                      <xapl:if test="{string-length($this/*[name() = concat('F_' ,$column/@Name, '_DS')]/@Value) > 0}">
                        <xapl:print select="$this/*[name() = concat('F_' ,$column/@Name, '_DS')]/@Value"/>
                        <xcore:search-by property="{$column/@Name}" value="{$this/*[name() = concat('F_' ,$column/@Name, '_DS')]/@Value}" matchby="GREATER_EQUAL"/>
                      </xapl:if>
                      <xapl:if test="{string-length($this/*[name() = concat('F_' ,$column/@Name, '_DE')]/@Value) > 0}">
                        <xapl:variable name="toDate">
                          <xapl:value-of select="concat($this/*[name() = concat('F_' ,$column/@Name, '_DE')]/@Value,' 23:59:59')"/>
                        </xapl:variable>
                        <xapl:print select="$toDate"/>
                        <xcore:search-by property="{$column/@Name}" value="{$toDate}" matchby="LESS_EQUAL"/>
                      </xapl:if>
                    </xapl:if>
                  </xapl:for-each>
                  <!-- Sorting-->
                  <!--xapl:if test=" count($this/SORT_BY) = 1
                                                    and  string-length($this/*[name() = 'SORT_BY']/@Value) > 0
                                          and $currentDbTable/TABLE_NAME/COLUMNS/*/@Name = $this/*[name() = 'SORT_BY']/@Value "-->
                           <xapl:print>chandy 4</xapl:print>

                  <xapl:choose>
                    <xapl:when test=" count($currentPref/SERVICE[@Name=$this/SERVICE/@Value]/TABLE[@Name = $this/TABLE_NAME/@Value]/ORDER_BY) = 1">
                            <xapl:print>chandy 5</xapl:print>

                      <xapl:value-of select="{$currentPref/SERVICE[@Name=$this/SERVICE/@Value]/TABLE[@Name = $this/TABLE_NAME/@Value]/ORDER_BY}"/>
                    </xapl:when>
                    <xapl:otherwise>
                            <xapl:print>chandy 6</xapl:print>
                      <xapl:if test=" count($this/SORT_BY) = 1
                                                    and  string-length($this/*[name() = 'SORT_BY']/@Value) > 0
                                          and $currentDbTable/TABLE_NAME/COLUMNS/*/@Name = $this/*[name() = 'SORT_BY']/@Value ">
                        <ORDER_BY>
                          <docutil:element name="{$this/*[name() = 'SORT_BY']/@Value}" Sort="{$this/*[name() = 'SORT_ORDER']/@Value}"/>
                        </ORDER_BY>
                      </xapl:if>
                    </xapl:otherwise>
                  </xapl:choose>
                </xapl:otherwise>
              </xapl:choose>
            </xcore:execute-method>
          </xapl:set-variable>
          <!-- TODO Do this dynamically only if timingStats are on. -->
          <docutil:remove select="$data/TIMING_STATS"/>
          <docutil:remove select="$data/RESPONSE/TIMING_STATS"/>
          <xapl:print>
              DATA :::
              <xapl:value-of select="$data"/>
          </xapl:print>
          <xapl:variable name="status">
            <x2:execute command="bcm.framework.util:getResponseStatus">
              <x2:with-param name="response" select="$data"/>
              <x2:with-param name="successMessage" select=" 'Search executed successfully.' "/>
            </x2:execute>
          </xapl:variable>
          <xapl:print select="$status"/>
          <!-- Add the total record count  -->
          <xapl:choose>
            <xapl:when test="name($status) = 'SUCCESS_MESSAGE' ">
              <docutil:add select="$data/RESPONSE">
                <TOTAL_RECORD_COUNT Value="{$data/RESPONSE/@TotalRowCount}"/>
                <START_AT_ROW Value="{$this/START_COUNT[1]/@Value}"/>
              </docutil:add>
            </xapl:when>
            <xapl:otherwise>
              <docutil:set select="$this">
                <xapl:value-of select="$status"/>
              </docutil:set>
              <docutil:add select="$data/RESPONSE">
                <TOTAL_RECORD_COUNT Value="0"/>
                <START_AT_ROW Value="{$this/START_COUNT[1]/@Value}"/>
              </docutil:add>
            </xapl:otherwise>
          </xapl:choose>
        </xapl:when>
        <xapl:otherwise>
          <!-- take the data from current session-->
          <xapl:set-variable name="data">
            <RESPONSES>
              <RESPONSE>
                <!--xapl:value-of select="$currentDbTable/TABLE_NAME/ROWS/*"/-->
              </RESPONSE>
            </RESPONSES>
          </xapl:set-variable>
          <xapl:if test="$currentDbTable/@NoAccess = 'yes'">
            <docutil:set select="$this">
              <ERROR_MESSAGE Value="NO_ACCESS_ON_DOCUMENT"/>
            </docutil:set>
            <xapl:print>
              ***** adding NO_ACCESS_ON_DOCUMENT ****
              <xapl:value-of select="{$this}"/>
            </xapl:print>
          </xapl:if>
          <!-- Add the total record count  -->
          <docutil:add select="$data/RESPONSE">
            <TOTAL_RECORD_COUNT Value="0"/>
            <START_AT_ROW Value="{$this/START_COUNT[1]/@Value}"/>
          </docutil:add>
        </xapl:otherwise>
      </xapl:choose>
      <!--xapl:print>
       @@@@@@@@@@@@@@@@@@@@@@@@@@@ DB data is
        <xapl:value-of select="{$data}"/>
      </xapl:print-->
      <!--xapl:print select="$currentDbTable"/-->
      <xapl:set-variable name="lookupData">
          <xapl:value-of select="{$data/RESPONSE}"/>
      </xapl:set-variable>
      <xapl:return>
        <xapl:value-of select="{$data/RESPONSE}"/>
      </xapl:return>
    </x2:command>
    <!-- **********************************************************************
         *********************************************************************** -->
      <x2:command public="yes" description="_" name="getLinks">
        <xapl:return>
          <LINKS>
            <x2:execute command="bcm.framework.common:getLinks">
              <x2:with-param name="pPage" select="'npiMemberLookup'"/>
              <x2:with-param name="this" select="$this"/>
              <x2:with-param name="pReturnLink" select="$this/RET_PAGE/@Value"/>
            </x2:execute>
          </LINKS>
        </xapl:return>
    </x2:command>

</x2:commands>
