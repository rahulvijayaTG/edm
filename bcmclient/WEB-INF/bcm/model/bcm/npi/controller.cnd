<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
    <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="init">
        <xapl:variable name="errorResDetails" resolver="session" global="true"/>
  </x2:command>

  <x2:command public="yes" description="_" name="display">
    <xapl:if test="not($npiattributeDetails)">
        <x2:execute command="bcm.npi.createEditItemView:initSessionVars"/>
    </xapl:if>
     <xapl:choose>
        <xapl:when test="$this/SELECTED_ID and string-length($this/SELECTED_ID/@Value) > 0">
        <xapl:choose>
              <xapl:when test="$this/SAVE_ACTION/@Value = 'Copy' or $this/SAVE_ACTION/@Value = 'Edit'">
                      <x2:execute command="bcm.npi.createEditItemView:initSessionVars"/>
                      <xapl:variable name="entityId">
                        <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
                          <x2:with-param name="selectedId" select="{$this/SELECTED_ID/@Value}"/>
                          <x2:with-param name="key" select="{concat($primaryDocName ,'.', $pkPropName)}"/>
                        </x2:execute>
                      </xapl:variable>
                    <x2:execute command="bcm.npi.controller:getEntityDetailsById">
                        <x2:with-param name="pKey" select="{$entityId}"/>
                    </x2:execute>
                      <!-- Remove all unique element's values while creating a copy -->
                      <xapl:if test="$this/SAVE_ACTION/@Value = 'Copy'">
                          <xapl:set-variable name="newProductDetails">
			          <COMMON_PROPS>
			            <ENTITY_DETAILS/>
			          </COMMON_PROPS>
    			  </xapl:set-variable>
                          <xapl:for-each select="$allComnProps/PROPERTY" varName="elem">
			    <docutil:add select="$newProductDetails/ENTITY_DETAILS">
			  	     <docutil:element name="{$elem/@Name}" Value=""/>
			    </docutil:add>
			  </xapl:for-each>
                       </xapl:if>
                       <!--xapl:print>newProductDetails after setting for edit copy
		       				  <xapl:value-of select="$newProductDetails"/>
                          </xapl:print-->
              </xapl:when>
              <xapl:otherwise>
                <x2:execute command="bcm.npi.createEditItemView:initSessionVars"/>
              </xapl:otherwise>
            </xapl:choose>
        </xapl:when>
        <xapl:otherwise>
          <xapl:set-variable name="newProductDetails">
	    <COMMON_PROPS>
	      <ENTITY_DETAILS/>
	    </COMMON_PROPS>
	  </xapl:set-variable>
	  <docutil:set select="$npiattributeDetails/*[name() != $this/SELECTED_TAB/@Value]">
	     <xapl:value-of select="$this/*[string-length(@Value) > 0]"/>
	  </docutil:set>
	  <xapl:for-each select="$allComnProps/PROPERTY" varName="elem">
	    <xapl:variable name="propName">
	      <xapl:value-of select="$elem/@Name"/>
	    </xapl:variable>
	    <xapl:variable name="propVal">
	       <xapl:choose>
		  <xapl:when test="$this/*[name()=$propName]">
		     <xapl:value-of select="$this/*[name()=$propName]/@Value"/>
		  </xapl:when>
		  <xapl:otherwise>
		     <xapl:value-of select=""/>
		  </xapl:otherwise>
		</xapl:choose>
	    </xapl:variable>
	    <xapl:if test="not($newProductDetails/ENTITY_DETAILS/*[name()=$propName])">
	      <docutil:add select="$newProductDetails/ENTITY_DETAILS">
		  <docutil:element name="{$propName}" Value="{$propVal}"/>
	      </docutil:add>
	    </xapl:if>
    	  </xapl:for-each>
        </xapl:otherwise>
        </xapl:choose>
         <xapl:print>
           just before display-page
          <xapl:value-of select="$this"/>
          <xapl:value-of select="$newProductDetails"/>
         </xapl:print>
        <web:display-page>
          <web:get-page name="createEditItem">
              <SELECTED_TAB Value="{$this/SELECTED_TAB/@Value}"/>
              <PAGE Value="{$this/PAGE/@Value}"/>
              <FORM_NAME Value="{$this/FORM_NAME/@Value}"/>
              <SERVICE Value="{$this/SERVICE/@Value}"/>
              <SAVE_ACTION Value="{$this/SAVE_ACTION/@Value}"/>
              <xapl:if test="string-length($this/SUCCESS_MESSAGE/@Value) &gt; 0">
                <SUCCESS_MESSAGE Value="{$this/SUCCESS_MESSAGE/@Value}"/>
              </xapl:if>
              <xapl:if test="string-length($this/ERROR_MESSAGE/@Value) &gt; 0">
                <ERROR_MESSAGE Value="{$this/ERROR_MESSAGE/@Value}"/>
              </xapl:if>
          </web:get-page>
        </web:display-page>
  </x2:command>

  <x2:command public="yes" description="_" name="getManageAttributesPage">
        <xapl:variable name="attributeDetails">
          <ATTRIBUTE_DETAILS>
              <HIERARCHY_ATTRIBUTES>
                  <x2:execute command="bcm.npi.controller:getHierarchyAttributeList">
                    <x2:with-param name="this" select="$this"/>
                  </x2:execute>
              </HIERARCHY_ATTRIBUTES>
              <NON_HIERARCHY_ATTRIBUTES>
                  <x2:execute command="bcm.npi.controller:getAttributeList">
                    <x2:with-param name="this" select="$this"/>
                  </x2:execute>
              </NON_HIERARCHY_ATTRIBUTES>
          </ATTRIBUTE_DETAILS>
        </xapl:variable>
        <xapl:return>
            <xapl:value-of select="$attributeDetails"/>
        </xapl:return>
   </x2:command>

  <x2:command name="getAttributeList">
    <!--xapl:variable name="optionTypes">
      <x2:execute command="bcm.framework.queryform.Form:getOptionTypes">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
    </xapl:variable>
    <xapl:print select="$optionTypes"/-->
    <!--xapl:print>
         npiattributeDetails$$ in ATTRIBUTES
              <xapl:value-of select="$npiattributeDetails"/>
              THIS$$$
              <xapl:value-of select="$this"/>
    </xapl:print-->
    <xapl:variable name="attributeList">
      <!-- The @Name attribute at the HTML_TABLE level below is not being used currently; So setting it to the first updatable document in the queryform -->
      <MANAGE_ATTRIBUTES Name="{$currentForm/UPDATE_DOCUMENTS/DOCUMENT[1]/@Name}">
        <xapl:for-each select="$currentForm/RESULT_PROPERTIES/RESULT_PROPERTY[PRESENTATION/MANAGE_ATTRIB/@Value = 'Attribute' ]" varName="column">
          <!-- For properties which have enumerated values that need to appear as a dropdown, will these values as children of the PROPERTY -->
          <xapl:variable name="displayType">
            <xapl:choose>
              <xapl:when test="count($column/DATASOURCE) > 0">
                <xapl:value-of select="'dropdown'"/>
              </xapl:when>
              <xapl:otherwise>
                <xapl:value-of select="$column/PRESENTATION/SEARCH_BY/@Value"/>
              </xapl:otherwise>
            </xapl:choose>
          </xapl:variable>
          <xapl:variable name="val">
        <xapl:value-of select="$npiattributeDetails/ATTRIBUTES/*[name() = $column/@Property]/@Value"/>

          </xapl:variable>
          <xapl:variable name="req">
            <xapl:if test="$column/@Required = 'yes'">
              <xapl:value-of select="$column/@Required"/>
            </xapl:if>
          </xapl:variable>
          <xapl:variable name="hasError">
          <xapl:if test="
          count($errorResDetails/*[name()=$column/@Document]/*[name()=$column/@Property]/_ERRORS) > 0">
          <xapl:value-of select="'yes'"/>
          </xapl:if>
      </xapl:variable>
      <xapl:variable name="err">
          <xapl:if test="$hasError = 'yes'">
          <xapl:value-of select="$errorResDetails/*[name()=$column/@Document]/*[name()=$column/@Property]/_ERRORS/_ERROR/@Value"/>
          </xapl:if>
      </xapl:variable>
      <!--xapl:print>
          <xapl:value-of select="$column/@Property"/>::<xapl:value-of select="$hasError"/>::::<xapl:value-of select="$err"/>
          </xapl:print-->
          <PROPERTY
            Name="{$column/@Property}"
            Document="{$column/@Document}"
            DisplayName="{$column/@DisplayName}"
            DefaultValue="{$column/@DefaultValue}"
            Type="{$column/@Type}"
            MinValue="{$column/@MinValue}"
            MaxValue="{$column/@MaxValue}"
            DisplayType="{$displayType}"
            Required="{$req}"
            Sequence="{$column/PRESENTATION/SEQUENCE/@Value}"
            Editable="{$column/PRESENTATION/ATTRIB_EDITABLE/@Value}"
            Hidden="{$column/PRESENTATION/HIDDEN/@Value}"
            Hyperlink="{$column/PRESENTATION/GROUP_EDITABLE_HYPERLINK/@Value}"
            Value="{$val}"
            PrimaryKey="{$column/@PrimaryKey}"
            Refers="{$column/@Refers}"
            ReferredColumn="{$column/@ReferredColumn}"
            HasError="{$hasError}"
            ErrDescr="{$err}"
            >
            <xapl:if test="count($column/DATASOURCE) > 0">
              <xapl:value-of select="$optionTypes/PROPERTY[@Name = $column/@Property]/VALID_VALUE"/>
            </xapl:if>
          </PROPERTY>
        </xapl:for-each>
      </MANAGE_ATTRIBUTES>
    </xapl:variable>
     <docutil:sort select="$attributeList" sort-element="PROPERTY" sort-by="@Sequence" data-type="number" order="ascending"/>
    <!--xapl:print select="$attributeList"/-->
    <xapl:return>
      <xapl:value-of select="$attributeList/*"/>
    </xapl:return>
  </x2:command>

  <x2:command name="getHierarchyAttributeList">
    <!--xapl:variable name="optionTypes">
      <x2:execute command="bcm.framework.queryform.Form:getOptionTypes">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
    </xapl:variable>
    <xapl:print select="$optionTypes"/-->
    <!--xapl:print>
         npiattributeDetails$$ in HIERARCHY
              <xapl:value-of select="$npiattributeDetails"/>
              THIS$$$
              <xapl:value-of select="$this"/>
              <xapl:value-of select="$errorResDetails"/>
              $currentForm/UPDATE_DOCUMENTS/DOCUMENT
              <xapl:value-of select="$currentForm/UPDATE_DOCUMENTS/DOCUMENT"/>


    </xapl:print-->

    <xapl:variable name="attributeList">
      <!-- The @Name attribute at the HTML_TABLE level below is not being used currently; So setting it to the first updatable document in the queryform -->
      <MANAGE_ATTRIBUTES Name="{$currentForm/UPDATE_DOCUMENTS/DOCUMENT[1]/@Name}">
        <xapl:for-each select="$currentForm/RESULT_PROPERTIES/RESULT_PROPERTY[PRESENTATION/MANAGE_ATTRIB/@Value = 'Hierarchy' ]" varName="column">
          <!-- For properties which have enumerated values that need to appear as a dropdown, will these values as children of the PROPERTY -->
          <xapl:variable name="displayType">
            <xapl:choose>
              <xapl:when test="count($column/DATASOURCE) > 0">
                <xapl:value-of select="'dropdown'"/>
              </xapl:when>
              <xapl:otherwise>
                <xapl:value-of select="$column/PRESENTATION/SEARCH_BY/@Value"/>
              </xapl:otherwise>
            </xapl:choose>
          </xapl:variable>
          <xapl:variable name="val">
                <xapl:value-of select="$npiattributeDetails/HIERARCHY/*[name() = $column/@Property]/@Value"/>
          </xapl:variable>
          <xapl:variable name="req">
            <xapl:if test="$column/@Required = 'yes'">
              <xapl:value-of select="$column/@Required"/>
            </xapl:if>
          </xapl:variable>
          <xapl:variable name="hasError">
            <xapl:if test="
            count($errorResDetails/*[name()=$column/@Document]/*[name()=$column/@Property]/_ERRORS) > 0">
                <xapl:value-of select="'yes'"/>
            </xapl:if>
          </xapl:variable>
          <xapl:variable name="err">
          <xapl:if test="$hasError = 'yes'">
          <xapl:value-of select="$errorResDetails/*[name()=$column/@Document]/*[name()=$column/@Property]/_ERRORS/_ERROR[1]/@Value"/>
          </xapl:if>
          </xapl:variable>
          <!--xapl:print>
            <xapl:value-of select="$column/@Property"/>::<xapl:value-of select="$hasError"/>::::<xapl:value-of select="$err"/>
          </xapl:print-->
          <PROPERTY
            Name="{$column/@Property}"
            Document="{$column/@Document}"
            DisplayName="{$column/@DisplayName}"
            DefaultValue="{$column/@DefaultValue}"
            Type="{$column/@Type}"
            MinValue="{$column/@MinValue}"
            MaxValue="{$column/@MaxValue}"
            DisplayType="{$displayType}"
            Required="{$req}"
            Sequence="{$column/PRESENTATION/SEQUENCE/@Value}"
            Editable="{$column/PRESENTATION/ATTRIB_EDITABLE/@Value}"
            Hidden="{$column/PRESENTATION/HIDDEN/@Value}"
            Hyperlink="{$column/PRESENTATION/GROUP_EDITABLE_HYPERLINK/@Value}"
            Value="{$val}"
            PrimaryKey="{$column/@PrimaryKey}"
            Refers="{$column/@Refers}"
            ReferredColumn="{$column/@ReferredColumn}"
            HasError="{$hasError}"
            ErrDescr="{$err}"
            >
            <xapl:if test="count($column/DATASOURCE) > 0">
              <xapl:value-of select="$optionTypes/PROPERTY[@Name = $column/@Property]/VALID_VALUE"/>
            </xapl:if>
          </PROPERTY>
        </xapl:for-each>
      </MANAGE_ATTRIBUTES>
    </xapl:variable>
     <docutil:sort select="$attributeList" sort-element="PROPERTY" sort-by="@Sequence" data-type="number" order="ascending"/>
    <!--xapl:print select="$attributeList"/-->
    <xapl:return>
      <xapl:value-of select="$attributeList/*"/>
    </xapl:return>
  </x2:command>

    <x2:command name="getCommonAttributesList">
      <!--xapl:print>
           $$newProductDetails in Common Attribs
	<xapl:value-of select="$newProductDetails"/>
	THIS$$$
	<xapl:value-of select="$this"/>
      </xapl:print-->

      <xapl:variable name="attributeList">
        <!-- The @Name attribute at the HTML_TABLE level below is not being used currently; So setting it to the first updatable document in the queryform -->
        <MANAGE_ATTRIBUTES Name="{$currentForm/UPDATE_DOCUMENTS/DOCUMENT[1]/@Name}">
          <xapl:for-each select="$currentForm/RESULT_PROPERTIES/RESULT_PROPERTY[PRESENTATION/MANAGE_ATTRIB/@Value = 'Both']" varName="column">
            <!-- For properties which have enumerated values that need to appear as a dropdown, will these values as children of the PROPERTY -->
            <xapl:variable name="displayType">
              <xapl:choose>
                <xapl:when test="count($column/DATASOURCE) > 0">
                  <xapl:value-of select="'dropdown'"/>
                </xapl:when>
                <xapl:otherwise>
                  <xapl:value-of select="$column/PRESENTATION/SEARCH_BY/@Value"/>
                </xapl:otherwise>
              </xapl:choose>
            </xapl:variable>
            <xapl:variable name="val">
                  <xapl:value-of select="$newProductDetails/ENTITY_DETAILS/*[name() = $column/@Property][1]/@Value"/>
            </xapl:variable>
            <xapl:variable name="req">
              <xapl:if test="$column/@Required = 'yes'">
                <xapl:value-of select="$column/@Required"/>
              </xapl:if>
            </xapl:variable>
            <xapl:variable name="hasError">
              <xapl:if test="
              count($errorResDetails/*[name()=$column/@Document]/*[name()=$column/@Property]/_ERRORS) > 0">
                  <xapl:value-of select="'yes'"/>
              </xapl:if>
            </xapl:variable>
            <xapl:variable name="err">
            <xapl:if test="$hasError = 'yes'">
            <xapl:value-of select="$errorResDetails/*[name()=$column/@Document]/*[name()=$column/@Property]/_ERRORS/_ERROR[1]/@Value"/>
            </xapl:if>
            </xapl:variable>
            <!--xapl:print>
              <xapl:value-of select="$column/@Property"/>::<xapl:value-of select="$hasError"/>::::<xapl:value-of select="$err"/>
            </xapl:print-->
            <PROPERTY
              Name="{$column/@Property}"
              Document="{$column/@Document}"
              DisplayName="{$column/@DisplayName}"
              DefaultValue="{$column/@DefaultValue}"
              Type="{$column/@Type}"
              MinValue="{$column/@MinValue}"
              MaxValue="{$column/@MaxValue}"
              DisplayType="{$displayType}"
              Required="{$req}"
              Sequence="{$column/PRESENTATION/SEQUENCE/@Value}"
              Editable="{$column/PRESENTATION/ATTRIB_EDITABLE/@Value}"
              Hidden="{$column/PRESENTATION/HIDDEN/@Value}"
              Hyperlink="{$column/PRESENTATION/GROUP_EDITABLE_HYPERLINK/@Value}"
              Value="{$val}"
              PrimaryKey="{$column/@PrimaryKey}"
              Refers="{$column/@Refers}"
              ReferredColumn="{$column/@ReferredColumn}"
              HasError="{$hasError}"
              ErrDescr="{$err}"
              >
              <xapl:if test="count($column/DATASOURCE) > 0">
                <xapl:value-of select="$optionTypes/PROPERTY[@Name = $column/@Property]/VALID_VALUE"/>
              </xapl:if>
            </PROPERTY>
          </xapl:for-each>
        </MANAGE_ATTRIBUTES>
      </xapl:variable>
      <xapl:variable name="commonAttributeList">
	<COMMON_PROPS>
	  <ENTITY_DETAILS>
	     <xapl:value-of select="$attributeList/*"/>
	  </ENTITY_DETAILS>
	</COMMON_PROPS>
       </xapl:variable>
       <!--xapl:print>
                FOR TOP FORM
               <xapl:value-of select="$commonAttributeList"/>
      </xapl:print-->
      <xapl:return>
        <xapl:value-of select="$commonAttributeList/*"/>
      </xapl:return>
  </x2:command>


  <x2:command public="yes" description="_" name="getHierarchyAttributeListFromMeta">

        <!--xapl:print>
               Get HierarchyAttributes
              <xapl:value-of select="$this"/>
              npiattributeDetails$$ in HIERARCHY
              <xapl:value-of select="$npiattributeDetails"/>
        </xapl:print-->


        <!--getNPIMetaData and get Dimension and level ids-->
            <xapl:variable name="dimensionID">
                <xapl:value-of select="'AllProd'"/>
            </xapl:variable>

        <!--getData from memberrelationmetadata-->

        <xapl:variable name="levelDetailsRes">
           <xcore:execute-method name="//BCMMasterService/getLevelsFromMemRelMetaData" entireResponse="true">
                <dimensionID Value="{$dimensionID}"/>
           </xcore:execute-method>
        </xapl:variable>
        <!--xapl:print select="$levelDetailsRes"/-->
        <!--get the display names and other props from xdocs/queryforms-->

        <!--xapl:variable name="optionTypes">
          <x2:execute command="bcm.framework.queryform.Form:getOptionTypes">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
        </xapl:variable-->
        <!--xapl:print select="$optionTypes"/-->

        <xapl:variable name="attributeList">
            <MANAGE_ATTRIBUTES Name="{$currentForm/UPDATE_DOCUMENTS/DOCUMENT[1]/@Name}">
            <xapl:for-each select="$levelDetailsRes/RESPONSE/MemberRelationMetaData" varName="memRel">
                <!--xapl:print select="$memRel"/-->
                <xapl:variable name="docName">
                    <xapl:value-of select="$memRel/sourceTable/@Value"/>
                </xapl:variable>
                <!--xapl:print select="$docName"/-->

                <xapl:variable name="column">
                    <xapl:value-of select="$currentForm/RESULT_PROPERTIES/RESULT_PROPERTY[./@Document=$docName and ./@Property=$memRel/sourceField/@Value]"/>
                </xapl:variable>
                <!--xapl:print>
                FOR HIER...
                <xapl:value-of select="$column"/>
                </xapl:print-->
                <xapl:variable name="val">
                   <xapl:value-of select="$npiattributeDetails/HIERARCHY/*[name() = $column/@Property]/@Value"/>
                </xapl:variable>
                <xapl:if test="string-length($column/@Property)>0">
                  <xapl:variable name="displayType">
                    <xapl:choose>
                      <xapl:when test="count($column/DATASOURCE) > 0">
                        <xapl:value-of select="'dropdown'"/>
                      </xapl:when>
                      <xapl:otherwise>
                        <xapl:value-of select="$column/PRESENTATION/SEARCH_BY/@Value"/>
                      </xapl:otherwise>
                    </xapl:choose>
                  </xapl:variable>
                  <xapl:variable name="req">
                    <xapl:if test="$column/@Required = 'yes'">
                      <xapl:value-of select="$column/@Required"/>
                    </xapl:if>
                  </xapl:variable>
                  <PROPERTY
                    Name="{$column/@Property}"
                    Document="{$column/@Document}"
                    DisplayName="{$column/@DisplayName}"
                    DefaultValue="{$column/@DefaultValue}"
                    Type="{$column/@Type}"
                    MinValue="{$column/@MinValue}"
                    MaxValue="{$column/@MaxValue}"
                    DisplayType="{$displayType}"
                    Required="{$req}"
                    Sequence="{$column/PRESENTATION/SEQUENCE/@Value}"
                    Editable="{$column/PRESENTATION/EDITABLE/@Value}"
                    Hidden="{$column/PRESENTATION/HIDDEN/@Value}"
                    Hyperlink="{$column/PRESENTATION/GROUP_EDITABLE_HYPERLINK/@Value}"
                    PrimaryKey="{$column/@PrimaryKey}"
                    Refers="{$column/@Refers}"
                    ReferredColumn="{$column/@ReferredColumn}"
                    HierarchyAttribute="yes" Value="{$val}">
                    <!--xapl:if test="count($column/DATASOURCE) > 0">
                      <xapl:value-of select="$optionTypes/PROPERTY[@Name = $column/@Property]/VALID_VALUE"/>
                    </xapl:if-->
                  </PROPERTY>
                </xapl:if>
            </xapl:for-each>
            </MANAGE_ATTRIBUTES>
        </xapl:variable>

        <docutil:sort select="$attributeList" sort-element="PROPERTY" sort-by="@Sequence" data-type="number" order="ascending"/>

        <!--xapl:print>
          attributeList AFTER SORTING IS###
          <xapl:value-of select="$attributeList"/>
        </xapl:print-->
        <!--construct the property list-->
        <xapl:return>
            <xapl:value-of select="$attributeList/*"/>
        </xapl:return>
  </x2:command>

  <x2:command public="yes" description="_" name="createEntity">
    <xapl:print>
      In create NPI Item
      <xapl:value-of select="$this"/>
    </xapl:print>
    <!--xapl:print>
         newProductDetails before  setting
        <xapl:value-of select="$newProductDetails"/>
        $allComnProps is
        <xapl:value-of select="$allComnProps"/>
    </xapl:print-->

    <docutil:set select="$npiattributeDetails/*[name() = $this/SELECTED_TAB/@Value]">
          <xapl:value-of select="$this/*"/>
    </docutil:set>
    <xapl:for-each select="$allComnProps/PROPERTY" varName="elem">
	<docutil:set select="$newProductDetails/ENTITY_DETAILS/*[name()=$elem/@Name]/@Value">
    	 <xapl:value-of select="{$this/*[name()=$elem/@Name][1]/@Value}"/>
        </docutil:set>
     </xapl:for-each>
    <!--xapl:print>
         newProductDetails in create is set to
        <xapl:value-of select="$newProductDetails"/>
    </xapl:print-->

    <xapl:variable name="docListForInsert">
      <INSERT_DOCUMENT_DETAILS>
      <xapl:for-each select="$currentForm/UPDATE_DOCUMENTS/DOCUMENT" varName="child">
         <INSERT_DOCUMENT Document="{$child/@Name}"/>
      </xapl:for-each>
      </INSERT_DOCUMENT_DETAILS>
    </xapl:variable>
    <xapl:print>
         docListForInsert created
        <xapl:value-of select="$docListForInsert"/>
    </xapl:print>
    <xapl:for-each select="$currentForm/RESULT_PROPERTIES/RESULT_PROPERTY" varName="currentProperty">
       <!--xapl:if test="string-length($this/*[name() = $currentProperty/@Name]/@Value)>0"-->
      <!--xapl:print>
           BEFORE ADDING property:: <xapl:value-of select="$currentProperty/@Property"/>
      </xapl:print-->
       <xapl:variable name="val">
            <xapl:choose>
                <xapl:when test="$currentProperty/PRESENTATION/MANAGE_ATTRIB/@Value='Hierarchy'">
                        <xapl:value-of select="$npiattributeDetails/HIERARCHY/*[name() = $currentProperty/@Property]/@Value"/>
                </xapl:when>
                <xapl:when test="$currentProperty/PRESENTATION/MANAGE_ATTRIB/@Value='Attribute'">
                        <xapl:value-of select="$npiattributeDetails/ATTRIBUTES/*[name() = $currentProperty/@Property]/@Value"/>
                </xapl:when>
                <xapl:otherwise>
                        <xapl:value-of select="$npiattributeDetails/*[name() = $this/SELECTED_TAB/@Value]/*[name() = $currentProperty/@Property]/@Value"/>
                </xapl:otherwise>
             </xapl:choose>
       </xapl:variable>
      <!--xapl:print>
           before ADDING value:: <xapl:value-of select="$val"/>
      </xapl:print-->
      <xapl:variable name="isPK">
            <xapl:value-of select="$currentProperty/@PrimaryKey"/>
      </xapl:variable>
      <xapl:choose>
        <xapl:when test="string-length($isPK)>0">
           <xapl:set-variable name="isPK">
	       <xapl:value-of select="'yes'"/>
      	   </xapl:set-variable>
       </xapl:when>
       <xapl:otherwise>
            <xapl:set-variable name="isPK">
		   <xapl:value-of select="'no'"/>
      	   </xapl:set-variable>
       </xapl:otherwise>
      </xapl:choose>
      <xapl:choose>
           <xapl:when test="string-length($val)>0">
              <docutil:add select="$docListForInsert/INSERT_DOCUMENT[@Document = $currentProperty/@Document]">
                  <docutil:element name="{$currentProperty/@Property}" Value="{$val}" pk="{$isPK}"/>
              </docutil:add>
           </xapl:when>
           <xapl:otherwise>
              <docutil:add select="$docListForInsert/INSERT_DOCUMENT[@Document = $currentProperty/@Document]">
                  <docutil:element name="{$currentProperty/@Property}" pk="{$isPK}"/>
              </docutil:add>
           </xapl:otherwise>
       </xapl:choose>
       <!--xapl:print>
            value:: <xapl:value-of select="$val"/>
            property:: <xapl:value-of select="$currentProperty/@Property"/>
            isPK:: <xapl:value-of select="$isPK"/>
       </xapl:print-->
       <!--/xapl:if-->
    </xapl:for-each>
    <!--xapl:print>
             after adding to docListForInsert
            <xapl:value-of select="$docListForInsert"/>
    </xapl:print-->
    <xapl:variable name="docLinks">
      <DOC_LINKS>
        <xcore:execute-method name="{concat('//', $this/SERVICE/@Value, '/getLinks')}" entireResponse="false">
           <TABLE_NAME Value="{$currentForm/DOCUMENT_TRAVERSAL/@PrimaryDocument}"/>
        </xcore:execute-method>
      </DOC_LINKS>
    </xapl:variable>

  <xapl:print>
        now docListForInsert
    <xapl:value-of select="$docListForInsert"/>
    primaryDocName$$$$$$$
    <xapl:value-of select="$currentForm/DOCUMENT_TRAVERSAL/@PrimaryDocument"/>
  </xapl:print>

  <xapl:for-each select="$currentForm/UPDATE_DOCUMENTS/DOCUMENT[@Name != $primaryDocName]" varName="childDoc">
      <!--xapl:print select="$childDoc"/-->
      <xapl:for-each select="$docLinks/DOCUMENTLINK[@Name=$childDoc/@Name]/MAP_PROPERTY" varName="mapProp">
        <xapl:if test="count($docListForInsert/INSERT_DOCUMENT[@Document = $childDoc/@Name]/*[name() = $mapProp/@From]) > 0">
          <!--xapl:print select="'hereeeeeee inside if'"/-->
          <xapl:variable name="toDoc">
            <xapl:value-of select="$docListForInsert/INSERT_DOCUMENT[@Document = $childDoc/@Name]"/>
          </xapl:variable>
          <xapl:variable name="fromDocVal">
            <xapl:value-of select="$docListForInsert/INSERT_DOCUMENT[@Document = $primaryDocName]/*[name() = $mapProp/@From]/@Value"/>
          </xapl:variable>
          <!--xapl:print select="$toDoc"/-->
          <!--xapl:print select="$fromDocVal"/-->
          <!--xapl:print select="$mapProp/@From"/-->
          <!--xapl:print select="$mapProp/@To"/-->
          <docutil:set select="$toDoc">
             <docutil:element name="{$mapProp/@To}" Value="{$fromDocVal}" pk="yes"/>
          </docutil:set>
        </xapl:if>
      </xapl:for-each>
    </xapl:for-each>
    <xapl:variable name="saveAction">
        <xapl:choose>
            <xapl:when test="$this/SAVE_ACTION/@Value='Create' or $this/SAVE_ACTION/@Value='Copy'">
                <xapl:value-of select="'INSERT'"/>
            </xapl:when>
            <xapl:otherwise>
                <xapl:value-of select="'UPDATE'"/>
            </xapl:otherwise>
        </xapl:choose>
    </xapl:variable>

    <xapl:variable name="insertReq">
        <ROOT>
                <xapl:value-of select="$docListForInsert"/>
                <ACTION Value="{$saveAction}"/>
        </ROOT>
    </xapl:variable>
    <xapl:print select="$insertReq"/>
   <xapl:variable name="insertRes">
        <xcore:execute-method name="{concat('//', $this/SERVICE/@Value, '/SaveItemDetails')}" entireResponse="true">
            <xapl:value-of select="$insertReq/*"/>
        </xcore:execute-method>
    </xapl:variable>

    <xapl:variable name="i18nErrorMessage">
          <ROOT>
          </ROOT>
    </xapl:variable>

    <xapl:for-each varName="err" select="$insertRes/RESPONSE/_RESULT/_ERROR">
      <docutil:add select="$i18nErrorMessage">
            <ERROR_MESSAGE Value="{$err/@Value}"/>
      </docutil:add>
    </xapl:for-each>
    <xapl:print select="$i18nErrorMessage"/>
    <xapl:variable name="status"/>

    <xapl:choose>
            <xapl:when test="count($i18nErrorMessage/*) > 1">
            <xapl:variable name="i18nErrMsg">
                <i18n:text>Some fields have invalid values</i18n:text>
            </xapl:variable>
              <xapl:set-variable name="status">
            <ROOT>
              <ERROR_MESSAGE Value="{$i18nErrMsg}"/>
            </ROOT>
              </xapl:set-variable>
            </xapl:when>
            <xapl:when test="count($i18nErrorMessage/*)=1">
         <xapl:set-variable name="status">
              <ROOT>
            <ERROR_MESSAGE Value="{$i18nErrorMessage/ERROR_MESSAGE/@Value}"/>
              </ROOT>
         </xapl:set-variable>
            </xapl:when>
            <xapl:otherwise>
              <xapl:set-variable name="status">
                <ROOT>
                <x2:execute command="bcm.framework.util:getResponseStatus">
                      <x2:with-param name="response" select="$insertRes"/>
                      <x2:with-param name="successMessage" select=" 'Item details are saved successfully.' "/>
                </x2:execute>
            </ROOT>
              </xapl:set-variable>
            </xapl:otherwise>
      </xapl:choose>
    <!--xapl:print>
        just after save!!
        <xapl:value-of select="$insertRes/RESPONSE/ROOT"/>
    </xapl:print-->
    <xapl:print select="$insertRes/RESPONSE/ROOT"/>
<xapl:print select="$status"/>
<!--xapl:print select="$this"/-->
  <xapl:choose>
    <xapl:when test="name($status/*)='SUCCESS_MESSAGE'">
          <xapl:set-variable name="errorResDetails"/>
          <xapl:variable name="itemName">
                   <xapl:value-of select="{$this/name[1]/@Value}"/>
          </xapl:variable>
           <xapl:variable name="savedItem">
                <x2:execute command="bcm.npi.controller:getEntityDetailsById">
                    <x2:with-param name="altKey" select="{$itemName}"/>
                </x2:execute>
          </xapl:variable>
            <xapl:print>savedItemRes  </xapl:print>
            <xapl:print select="$savedItem"/>
            <xapl:choose>
                <xapl:when test="count($savedItem/ERROR_MESSAGE)=1">
                      <!--xapl:print>Member error!!!  </xapl:print-->
                      <web:display-page>
                          <web:get-page name="createEditItem">
                              <xapl:value-of select="$savedItem/*"/>
                              <xapl:value-of select="$this/*"/>
                          </web:get-page>
                     </web:display-page>
                </xapl:when>
                <xapl:otherwise>
                    <docutil:set select="$this/SAVE_ACTION/@Value">
                          <xapl:value-of select="'Edit'"/>
                    </docutil:set>
                      <web:display-page>
                          <web:get-page name="createEditItem">
                              <xapl:value-of select="$status/*"/>
                              <xapl:value-of select="$this/*"/>
                          </web:get-page>
                     </web:display-page>
                </xapl:otherwise>
            </xapl:choose>
    </xapl:when>
    <xapl:otherwise>
           <xapl:set-variable name="errorResDetails">
                  <xapl:value-of select="$insertRes/RESPONSE/ROOT"/>
           </xapl:set-variable>
           <!--xapl:print>
           storing in session var errorResDetails@@@
                  <xapl:value-of select="$insertRes/RESPONSE/ROOT"/>
           </xapl:print-->
          <web:display-page>
              <web:get-page name="createEditItem">
                  <xapl:value-of select="$this/*"/>
                  <xapl:value-of select="$status/*"/>
              </web:get-page>
         </web:display-page>
    </xapl:otherwise>
  </xapl:choose>
 </x2:command>

<x2:command public="yes" description="_" name="getEntityDetailsById">
    <x2:param name="pKey"/>
    <x2:param name="altKey`"/>
    <xapl:variable name="pkName">
      <xapl:value-of select="{$currentForm/RESULT_PROPERTIES/RESULT_PROPERTY[@PrimaryKey='yes']/@Property}"/>
    </xapl:variable>
    <!--xapl:print>Primary id::<xapl:value-of select="$pKey"/></xapl:print>
    <xapl:print>alternative id::<xapl:value-of select="$altKey"/></xapl:print-->
    <xapl:variable name="request" select="{concat('//' , 'BCMMasterService', '/getFormData')}"/>
    <xapl:variable name="reportData">
      <xcore:execute-method name="{$request}" ReturnRowCount="yes" entireResponse="true">
        <ID Value="{$currentForm/ID/@Value}"/>
        <xapl:choose>
            <xapl:when test="string-length($pKey)>0">
                <FILTER Name="{$pkName}" Document="{$primaryDocName}">
                    <xcore:search-by property="{$pkName}" value="{$pKey}" matchby="EQUAL"/>
                 </FILTER>
            </xapl:when>
            <xapl:otherwise>
                <FILTER Name="name" Document="{$primaryDocName}">
                    <xcore:search-by property="name" value="{$altKey}" matchby="EQUAL"/>
                 </FILTER>
            </xapl:otherwise>
        </xapl:choose>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:choose>
        <xapl:when test="$reportData/RESPONSE/@TotalRowCount=1">
           <docutil:set select="$reportData/RESPONSE">
                     <TOTAL_RECORD_COUNT Value="{$reportData/RESPONSE/@TotalRowCount}"/>
           </docutil:set>
           <docutil:remove select="$reportData/TIMING_STATS"/>
              <docutil:remove select="$reportData/RESPONSE/TIMING_STATS"/>
              <xapl:set-variable name="currentFormsData">
                  <xapl:value-of select="{$reportData}"/>
           </xapl:set-variable>
           <!--xapl:print>
            NPI::: getEntityDetailsById
                  <xapl:value-of select="$reportData/RESPONSE/JOIN_RESULT[1]"/>
           </xapl:print-->
            <xapl:variable name="itemDetailsRes">
                    <xapl:value-of select="$reportData/RESPONSE/JOIN_RESULT[1]"/>
            </xapl:variable>
	    <xapl:set-variable name="newProductDetails">
	      <COMMON_PROPS>
	        <ENTITY_DETAILS/>
	      </COMMON_PROPS>
	    </xapl:set-variable>
            <xapl:for-each select="$currentForm/RESULT_PROPERTIES/RESULT_PROPERTY" varName="currentProperty">
              <!--xapl:print>
                   BEFORE setting property:: <xapl:value-of select="$currentProperty/@Property"/>
              </xapl:print-->

               <xapl:variable name="val">
                    <xapl:value-of select="$itemDetailsRes/*[name()=concat($currentProperty/@Document,'.',$currentProperty/@Property)]/@Value"/>
               </xapl:variable>

              <!--xapl:print>
                   BEFORE setting value:: <xapl:value-of select="$val"/>
              </xapl:print-->
                <xapl:choose>
                  <xapl:when test="$currentProperty/PRESENTATION/MANAGE_ATTRIB/@Value='Hierarchy'">
		      <xapl:choose>
		       <xapl:when test="string-length($val)>0">
			  <docutil:set select="$npiattributeDetails/HIERARCHY">
			      <docutil:element name="{$currentProperty/@Property}" Value="{$val}"/>
			  </docutil:set>
		       </xapl:when>
		       <xapl:otherwise>
			  <docutil:set select="$npiattributeDetails/HIERARCHY">
			      <docutil:element name="{$currentProperty/@Property}"  Value=""/>
			  </docutil:set>
		      </xapl:otherwise>
		   </xapl:choose>
		</xapl:when>
		<xapl:when test="$currentProperty/PRESENTATION/MANAGE_ATTRIB/@Value='Attribute'">
		   <xapl:choose>
		       <xapl:when test="string-length($val)>0">
			  <docutil:set select="$npiattributeDetails/ATTRIBUTES">
			      <docutil:element name="{$currentProperty/@Property}" Value="{$val}"/>
			  </docutil:set>
		       </xapl:when>
		       <xapl:otherwise>
			  <docutil:set select="$npiattributeDetails/ATTRIBUTES">
			      <docutil:element name="{$currentProperty/@Property}" Value=""/>
			  </docutil:set>
		       </xapl:otherwise>
		      </xapl:choose>
                  </xapl:when>
                  <xapl:when test="$currentProperty/PRESENTATION/MANAGE_ATTRIB/@Value='Both'">
		      <xapl:choose>
		       <xapl:when test="string-length($val)>0">
			  <docutil:add select="$newProductDetails/ENTITY_DETAILS">
			      <docutil:element name="{$currentProperty/@Property}" Value="{$val}"/>
			  </docutil:add>
		       </xapl:when>
		       <xapl:otherwise>
			  <docutil:add select="$newProductDetails/ENTITY_DETAILS">
			      <docutil:element name="{$currentProperty/@Property}" Value=""/>
			  </docutil:add>
		       </xapl:otherwise>
		      </xapl:choose>
                    </xapl:when>
                    <xapl:otherwise>
                    </xapl:otherwise>
               </xapl:choose>
            </xapl:for-each>
                <!--xapl:print>
                newProductDetails$$$
                  <xapl:value-of select="$newProductDetails"/>
                  npiattributeDetails$$$
                  <xapl:value-of select="$npiattributeDetails"/>
                </xapl:print-->
           <xapl:return>
                  <xapl:value-of select="$reportData/RESPONSE"/>
           </xapl:return>
        </xapl:when>
        <xapl:otherwise>
            <!--xapl:print> error in getEntityDetailsById </xapl:print-->
            <xapl:variable name="i18nErrMsg">
                <i18n:text>Cannot save Item with this name, Please check if Item/Member already exist.</i18n:text>
            </xapl:variable>
           <xapl:return>
              <ROOT>
                    <ERROR_MESSAGE Value="{$i18nErrMsg}"/>
              </ROOT>
           </xapl:return>
        </xapl:otherwise>
    </xapl:choose>
  </x2:command>


<!--
<RESPONSE TotalRowCount="1" Status="Success">
  <JOIN_RESULT>
    <Item.itemID Value="LEG_WHEEL" Document="Item" />
    <Item.name Value="LEG_WHEEL" Document="Item" />
    <Item.itemType Value="Chip" Document="Item" />
    <DeviceDetail.chipName Value="c-1" Document="DeviceDetail" />
    <DeviceDetail.chipQuantity Value="0" Document="DeviceDetail" />
    <DeviceDetail.extFunction Value="tt" Document="DeviceDetail" />
    <DeviceDetail.pin Value="1" Document="DeviceDetail" />
    <Item.presp Value="presp" Document="Item" />
    <Item.SBE Value="SBE" Document="Item" />
    <Item.SBE1 Value="SBE1" Document="Item" />
    <Item.SBE2 Value="SBE2" Document="Item" />
  </JOIN_RESULT>
  <TOTAL_RECORD_COUNT Value="1" />
  <START_AT_ROW />
</RESPONSE>
-->


<x2:command public="yes" description="_" name="deleteEntity">

         <xapl:variable name="itemDetailDocName">
           <xapl:for-each select="$currentForm/UPDATE_DOCUMENTS/DOCUMENT[@Name != $primaryDocName]" varName="doc">
              <xapl:value-of select="$currentForm/UPDATE_DOCUMENTS/DOCUMENT[@Name != $primaryDocName]/@Name"/>
           </xapl:for-each>
         </xapl:variable>

          <!--xapl:print>
	          DELETE NPI Item
	         <xapl:value-of select="$this"/>
	         primaryDocName$$
	         <xapl:value-of select="$primaryDocName"/>
	         itemDetailDocName$$
	         <xapl:value-of select="$currentForm/UPDATE_DOCUMENTS/DOCUMENT[@Name != $primaryDocName]/@Name"/>
        </xapl:print-->
        <xapl:for-each select="$this/SELECTED_ID" varName="curEntity">
          <xapl:variable name="entityId">
            <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
              <x2:with-param name="selectedId" select="{$curEntity/@Value}"/>
              <x2:with-param name="key" select="{concat($primaryDocName ,'.', $pkPropName)}"/>
            </x2:execute>
          </xapl:variable>

          <!--for multiple child docs, itemDetailDocName will hav more than 1 child table names and the block of code below needs to be restructured to handle deletion from all child tables-->
          <xapl:variable name="request" select="{concat('//' , 'BCMMasterService', '/deleteItemDetailsFromUI')}"/>
          <xapl:variable name="requestParam">
          <params></params>
          </xapl:variable>
          <docutil:add select="$requestParam">

	        <docutil:element name="{$pkPropName}" Value="{$entityId}" primaryDocument="{$primaryDocName}" detailDocument="{$itemDetailDocName}" pk="yes"/>

          </docutil:add>
          <xapl:variable name="reportData">
              <xcore:execute-method name="{$request}" ReturnRowCount="yes" entireResponse="true">
                <xapl:value-of select="{$requestParam/*}" />
              </xcore:execute-method>
          </xapl:variable>
    </xapl:for-each>

    <web:display-page>
      <web:get-page name="npiItemDetailsHome">
          <PAGE Value="{$this/PAGE/@Value}"/>
          <FORM_NAME Value="{$this/FORM_NAME/@Value}"/>
          <SERVICE Value="{$this/SERVICE/@Value}"/>
          <xapl:value-of select="$status"/>
      </web:get-page>
    </web:display-page>
 </x2:command>

 <x2:command public="yes" description="_" name="getParentLevelMembers">
    <xapl:print>
       getParentLevelMembers NPI
       <xapl:value-of select="$this"/>
    </xapl:print>

    <x2:execute command="bcm.npi.MemberLookupView:gotoSelectForeignKey">
        <x2:with-param name="this" select="$this"/>
    </x2:execute>
 </x2:command>

  <x2:command public="yes" description="_" name="revertChanges">
      <!--xapl:print>
             revertChanges ON EDIT
             <xapl:value-of select="$this"/>
      </xapl:print-->

      <x2:execute command="bcm.npi.controller:getEntityDetailsById">
         <x2:with-param name="pKey" select="{$this/*[name()=$pkPropName]/@Value}"/>
      </x2:execute>
      <web:display-page>
        <web:get-page name="createEditItem">
          <SELECTED_TAB Value="{$this/SELECTED_TAB/@Value}"/>
      <PAGE Value="{$this/PAGE/@Value}"/>
      <FORM_NAME Value="{$this/FORM_NAME/@Value}"/>
      <SERVICE Value="{$this/SERVICE/@Value}"/>
      <SAVE_ACTION Value="{$this/SAVE_ACTION/@Value}"/>
        </web:get-page>
      </web:display-page>
  </x2:command>

</x2:commands>
