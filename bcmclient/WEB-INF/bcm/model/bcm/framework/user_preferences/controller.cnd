<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:bcm="http://www.i2.com/bcm" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:identity="http://www.i2.com/identity" xmlns:i18n="http://www.i2.com/i18n" description="_">
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="init" public="yes" description="_">
    <xapl:variable name="currentPref" resolver="session" global="true"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="initUserPreferences">
    <x2:param name="this"/>
    <xapl:if test="not($currentPref)">
      <xapl:set-variable name="currentPref">
        <USER_PREFERENCES>
          <SERVICE Name="{$this/SERVICE[1]/@Value}"/>
        </USER_PREFERENCES>
      </xapl:set-variable>
    </xapl:if>
    <xapl:print>
        initUserPreferences:::
        <xapl:value-of select="$currentPref"/>
    </xapl:print>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getUserPreferences">
    <xapl:print>
        getUserPreferences:::
        <xapl:value-of select="$currentPref"/>
    </xapl:print>
    <xapl:return>
      <xapl:value-of select="$currentPref"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="updateAndApplyUserPreferencesForTableEditor">
    <x2:param name="this"/>
    <xapl:print>
        BEFORE ADDING TO $currentPref:::
        $currentPref=<xapl:value-of select="$currentPref"/>
        Value of $this=<xapl:value-of select="$this"/>
    </xapl:print>
    <xapl:if test="not($currentPref) or not($currentPref/SERVICE/@Name)">
      <x2:execute command="bcm.framework.user_preferences.controller:initUserPreferences">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
    </xapl:if>
    <xapl:if test="count($currentPref/SERVICE[@Name = $this/SERVICE[1]/@Value]) = 0">
    	<docutil:add select="$currentPref">
    	  <SERVICE Name = "{$this/SERVICE[1]/@Value}"/>
    	</docutil:add>
    </xapl:if>
    <xapl:print>
            CURRENT $currentPref::
            <xapl:value-of select="$currentPref"/>
    </xapl:print>
    <!-- update/add user preferences -->
    <!-- COLUMN FREEZE     -->
    <xapl:variable name="frozenColConfig"/>
    <xapl:choose>
      <xapl:when test="$colHeadConfig/TABLE_COL_HEAD_CONFIG/*[@Name= $this/TABLE_NAME[1]/@Value]">
        <xapl:set-variable name="frozenColConfig">
          <xapl:value-of select="$colHeadConfig/TABLE_COL_HEAD_CONFIG/*[@Name= $this/TABLE_NAME[1]/@Value]/@freezeCol"/>
        </xapl:set-variable>
      </xapl:when>
      <xapl:otherwise>
        <xapl:set-variable name="frozenColConfig">
          <xapl:value-of select="{$colHeadConfig/DEFAULT_COL_HEAD_CONFIG/@freezeCol}"/>
        </xapl:set-variable>
      </xapl:otherwise>
    </xapl:choose>
    <xapl:choose>
      <xapl:when test="$currentPref/SERVICE[@Name = $this/SERVICE[1]/@Value]/TABLE[@Name = $this/TABLE_NAME[1]/@Value]">
        <!-- remove old filters applied-->
        <docutil:remove select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/FILTERS/*[substring-before(name() ,  '_'  )  = 'F'  ]"/>
        <xapl:print>
            AFTER REMOVING $currentPref::
            <xapl:value-of select="$currentPref"/>
        </xapl:print>
        <!-- add new filters applied-->
        <docutil:set select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/FILTERS">
          <xapl:value-of select="$this/*[substring-before(name() ,  '_'  )  = 'F'  ]"/>
          <xapl:value-of select="$filterXml"/>
          <xapl:if test="count($this/FILTER_TEXT) > 0 ">
            <FILTER_TEXT Value="{$this/FILTER_TEXT/@Value}"/>
          </xapl:if>
          <xapl:if test="count($this/FILTER_NAME) > 0 ">
            <FILTER_NAME Value="{$this/FILTER_NAME/@Value}"/>
          </xapl:if>
          <xapl:if test="count($this/FILTER_ID) > 0 ">
            <FILTER_ID Value="{$this/FILTER_ID/@Value}"/>
          </xapl:if>
          <xapl:if test="count($this/FILTER_MODE) > 0 ">
            <FILTER_MODE Value="{$this/FILTER_MODE/@Value}"/>
          </xapl:if>

           <!-- store  the sorting_order , sort_by, start_count , max_rows -->
        <xapl:if test="count($this/SORT_ORDER) > 0 ">
          <SORT_ORDER Value="{$this/SORT_ORDER/@Value}"/>
        </xapl:if>
        <xapl:if test="count($this/SORT_BY) > 0 ">
          <SORT_BY Value="{$this/SORT_BY/@Value}"/>
        </xapl:if>
        <xapl:if test="count($this/START_COUNT) > 0 ">
          <START_COUNT Value="{$this/START_COUNT/@Value}"/>
        </xapl:if>
        <xapl:if test="count($this/MAX_ROWS) > 0 ">
          <MAX_ROWS Value="{$this/MAX_ROWS/@Value}"/>
        </xapl:if>

        </docutil:set>

        <xapl:if test=" string-length($this/HIDDEN_COLUMN/@Value) > 0 ">
          <docutil:add select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/HIDDEN_COLUMNS">
            <FIELD Value="{$this/HIDDEN_COLUMN/@Value}"/>
          </docutil:add>
        </xapl:if>
        <xapl:if test="$this/HIDDEN_COLUMN/@Value = 'None' ">
          <docutil:remove select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/HIDDEN_COLUMNS/*"/>
        </xapl:if>
        <!--chandru start-->
        <!-- COLUMN FREEZE   -->
        <xapl:choose>
          <xapl:when test="string-length($this/FROZEN_SEQUENCE/@Value) > 0 and  $this/FROZEN_SEQUENCE/@Value!= '-999' ">
            <docutil:set select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/FROZEN_SEQUENCES">
              <FROZEN_SEQUENCE Value="{$this/FROZEN_SEQUENCE/@Value}"/>
            </docutil:set>
          </xapl:when>
          <xapl:otherwise>
            <xapl:if test="$frozenColConfig > '0'">
              <docutil:set select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/FROZEN_SEQUENCES">
                <FROZEN_SEQUENCE Value="{$frozenColConfig}"/>
              </docutil:set>
              <xapl:print select="'INSIDE Table'"/>
            </xapl:if>
          </xapl:otherwise>
        </xapl:choose>
        <!-- COLUMN FREEZE   -->
        <xapl:if test=" $this/FROZEN_SEQUENCE/@Value = '-999'">
          <docutil:remove select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/FROZEN_SEQUENCES/*"/>
        </xapl:if>
        <!--chandru end-->
      </xapl:when>
      <xapl:otherwise>
        <xapl:choose>
          <xapl:when test="string-length($this/FAV_ID/@Value) > 0">
            <xapl:variable name="userFavoriteDetails">
              <xcore:execute-method name="//UserSecurity/getUserFavorites" UserId="{$loginUserId}" FavoriteId="{$this/FAV_ID/@Value}" entireResponse="true"/>
            </xapl:variable>
            <xapl:print select="$userFavoriteDetails"/>
            <xapl:variable name="storedUserPref">
              <xapl:value-of select="$userFavoriteDetails/RESPONSE/FAV_XML/@Value"/>
            </xapl:variable>
            <xapl:variable name="storedUserPref_xml">
              <docutil:to-xml select="$storedUserPref"/>
            </xapl:variable>
            <xapl:print select="$storedUserPref_xml/TABLE"/>
            <xapl:print>chandru favorite</xapl:print>
            <docutil:add select="$currentPref/SERVICE[@Name = $this/SERVICE[1]/@Value]">
              <xapl:value-of select="$storedUserPref_xml/TABLE[@Name= $this/TABLE_NAME[1]/@Value]"/>
            </docutil:add>
          </xapl:when>
          <xapl:otherwise>
            <docutil:remove select="$this/FILTER_TEXT"/>
            <docutil:remove select="$this/FILTER_NAME"/>
            <docutil:remove select="$this/FILTER_MODE"/>
            <docutil:remove select="$this/FILTER_ID"/>
            <docutil:remove select="$this/HIDDEN_COLUMN"/>
            <xapl:set-variable name="filterXml"/>
            <xapl:set-variable name="saved_filters"/>
            <docutil:add select="$currentPref/SERVICE[@Name = $this/SERVICE[1]/@Value]">
              <TABLE Name="{$this/TABLE_NAME[1]/@Value}">
                <FILTERS/>
                <HIDDEN_COLUMNS/>
                <FROZEN_COLUMNS/>
                <!--  COLUMN FREEZE    -->
                <FROZEN_SEQUENCES>
                  <FROZEN_SEQUENCE Value="{$frozenColConfig}"/>
                </FROZEN_SEQUENCES>
                <!--  COLUMN FREEZE    -->
              </TABLE>
            </docutil:add>
          </xapl:otherwise>
        </xapl:choose>
      </xapl:otherwise>
    </xapl:choose>
    <!-- print user preferences -->
    <xapl:print>
        AFTER ADDING TO $currentPref:::
        $currentPref=<xapl:value-of select="$currentPref"/>
    </xapl:print>
    <!-- apply user preferences -->
    <xapl:if test="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/FILTERS">
      <docutil:set select="$this">
        <xapl:value-of select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/FILTERS/*"/>
      </docutil:set>
    </xapl:if>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="updateAndApplyUserPreferencesForForms">
    <x2:param name="this"/>
    <xapl:print>
      <xapl:value-of select="$this"/>
        BEFORE ADDING TO $currentPref:::
        $currentPref=<xapl:value-of select="$currentPref"/>
    </xapl:print>
    <xapl:if test="not($currentPref) or not($currentPref/SERVICE/@Name)">
      <x2:execute command="bcm.framework.user_preferences.controller:initUserPreferences">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
    </xapl:if>
    <!-- update/add user preferences -->
    <!--  COLUMN FREEZE    -->
    <xapl:variable name="frozenColConfig"/>
    <xapl:choose>
      <xapl:when test="$colHeadConfig/FORM_COL_HEAD_CONFIG/*[@Name= $this/FORM_NAME[1]/@Value]">
        <xapl:set-variable name="frozenColConfig">
          <xapl:value-of select="$colHeadConfig/FORM_COL_HEAD_CONFIG/*[@Name= $this/FORM_NAME[1]/@Value]/@freezeCol"/>
        </xapl:set-variable>
      </xapl:when>
      <xapl:otherwise>
        <xapl:set-variable name="frozenColConfig">
          <xapl:value-of select="{$colHeadConfig/DEFAULT_COL_HEAD_CONFIG/@freezeCol}"/>
        </xapl:set-variable>
      </xapl:otherwise>
    </xapl:choose>
    <xapl:if test = "$frozenColConfig/@Value = 0">
    <xapl:print>
        whatsthevalue
        <xapl:value-of select="$frozenColConfig"/>
    </xapl:print>

        <xapl:set-variable name="frozenColConfig">
              <xapl:value-of select="-999"/>
        </xapl:set-variable>
    </xapl:if>
    <!--  COLUMN FREEZE    -->
    <xapl:choose>
      <!-- when there is already applied filters  -->
      <xapl:when test="$currentPref/SERVICE[@Name = $this/SERVICE[1]/@Value]/FORM[@Name = $this/FORM_NAME[1]/@Value]">
        <!-- remove old filters applied-->
        <docutil:remove select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/FORM[@Name= $this/FORM_NAME[1]/@Value]/FILTERS/*[substring-before(name() ,  '_'  )  = 'F'  ]"/>
        <xapl:print>
            AFTER REMOVING $currentPref::
            <xapl:value-of select="$currentPref"/>
        </xapl:print>
        <docutil:set select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/FORM[@Name= $this/FORM_NAME[1]/@Value]/FILTERS">
          <xapl:value-of select="$this/*[substring-before(name() ,  '_'  )  = 'F'  ]"/>
          <xapl:value-of select="$filterXml"/>
          <xapl:if test="count($this/FILTER_TEXT) > 0 ">
            <FILTER_TEXT Value="{$this/FILTER_TEXT/@Value}"/>
          </xapl:if>
          <xapl:if test="count($this/FILTER_NAME) > 0 ">
            <FILTER_NAME Value="{$this/FILTER_NAME/@Value}"/>
          </xapl:if>
          <xapl:if test="count($this/FILTER_ID) > 0 ">
            <FILTER_ID Value="{$this/FILTER_ID/@Value}"/>
          </xapl:if>
          <xapl:if test="count($this/FILTER_MODE) > 0 ">
            <FILTER_MODE Value="{$this/FILTER_MODE/@Value}"/>
          </xapl:if>
          <!-- store  the sorting_order , sort_by, start_count , max_rows -->
          <xapl:if test="count($this/SORT_ORDER) > 0 ">
            <SORT_ORDER Value="{$this/SORT_ORDER/@Value}"/>
          </xapl:if>
          <xapl:if test="count($this/SORT_BY) > 0 ">
            <SORT_BY Value="{$this/SORT_BY/@Value}"/>
          </xapl:if>
          <xapl:if test="count($this/START_COUNT) > 0 ">
            <START_COUNT Value="{$this/START_COUNT/@Value}"/>
          </xapl:if>
          <xapl:if test="count($this/MAX_ROWS) > 0 ">
            <MAX_ROWS Value="{$this/MAX_ROWS/@Value}"/>
          </xapl:if>
        </docutil:set>
        <xapl:if test=" string-length($this/HIDDEN_COLUMN/@Value) > 0 ">
          <docutil:add select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/FORM[@Name= $this/FORM_NAME[1]/@Value]/HIDDEN_COLUMNS">
            <FIELD Value="{$this/HIDDEN_COLUMN/@Value}"/>
          </docutil:add>
        </xapl:if>
        <xapl:if test="$this/HIDDEN_COLUMN/@Value = 'None'">
          <docutil:remove select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/FORM[@Name= $this/FORM_NAME[1]/@Value]/HIDDEN_COLUMNS/*"/>
        </xapl:if>
        <!--chandru start-->
        <!-- COLUMN FREEZE  -->
        <xapl:choose>
          <xapl:when test="string-length($this/FROZEN_SEQUENCE/@Value) > 0">
            <docutil:set select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/FORM[@Name= $this/FORM_NAME[1]/@Value]/FROZEN_SEQUENCES">
              <FROZEN_SEQUENCE Value="{$this/FROZEN_SEQUENCE/@Value}"/>
            </docutil:set>
          </xapl:when>
          <xapl:otherwise>
            <xapl:if test="$frozenColConfig > '-1'">
              <docutil:set select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/FORM[@Name= $this/FORM_NAME[1]/@Value]/FROZEN_SEQUENCES">
                <FROZEN_SEQUENCE Value="{$frozenColConfig}"/>
              </docutil:set>
              <xapl:print select="'INSIDE form'"/>
            </xapl:if>
          </xapl:otherwise>
        </xapl:choose>
        <!--  COLUMN FREEZE   -->
        <!--chandru end-->
      </xapl:when>
      <xapl:otherwise>
        <xapl:choose>
          <xapl:when test="string-length($this/FAV_ID/@Value) > 0">
            <xapl:variable name="userFavoriteDetails">
              <xcore:execute-method name="//UserSecurity/getUserFavorites" UserId="{$loginUserId}" FavoriteId="{$this/FAV_ID/@Value}" entireResponse="true"/>
            </xapl:variable>
            <xapl:print select="$userFavoriteDetails"/>
            <xapl:variable name="storedUserPref">
              <xapl:value-of select="$userFavoriteDetails/RESPONSE/FAV_XML/@Value"/>
            </xapl:variable>
            <xapl:variable name="storedUserPref_xml">
              <docutil:to-xml select="$storedUserPref"/>
            </xapl:variable>
            <xapl:print select="$storedUserPref_xml/FORM"/>
            <xapl:print>chandru favorite</xapl:print>
            <docutil:add select="$currentPref/SERVICE[@Name = $this/SERVICE[1]/@Value]">
              <xapl:value-of select="$storedUserPref_xml/FORM[@Name= $this/FORM_NAME[1]/@Value]"/>
            </docutil:add>
          </xapl:when>
          <xapl:otherwise>
            <xapl:if test="$this/FORM_NAME[1]/@Value != 'FILTERS_FORM'">
              <!-- reset for the sessionals-->
              <docutil:remove select="$this/FILTER_TEXT"/>
              <docutil:remove select="$this/FILTER_NAME"/>
              <docutil:remove select="$this/FILTER_MODE"/>
              <docutil:remove select="$this/FILTER_ID"/>
              <docutil:remove select="$this/HIDDEN_COLUMN"/>
              <xapl:set-variable name="filterXml"/>
              <xapl:set-variable name="saved_filters"/>
              <docutil:set select="$currentPref/SERVICE[@Name = $this/SERVICE[1]/@Value]">
                <FORM Name="{$this/FORM_NAME[1]/@Value}">
                  <FILTERS/>
                  <HIDDEN_COLUMNS/>
                  <FROZEN_COLUMNS/>
                  <!-- COLUMN FREEZE  -->
                  <FROZEN_SEQUENCES>
                    <FROZEN_SEQUENCE Value="{$frozenColConfig}"/>
                  </FROZEN_SEQUENCES>
                </FORM>
              </docutil:set>
            </xapl:if>
          </xapl:otherwise>
        </xapl:choose>
      </xapl:otherwise>
    </xapl:choose>
    <!-- print user preferences -->
    <xapl:print>
        AFTER ADDING TO $currentPref:::
        $currentPref=<xapl:value-of select="$currentPref"/>
    </xapl:print>
    <!-- apply user preferences -->
    <!--    <xapl:if test="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/FORM[@Name= $this/FORM_NAME[1]/@Value]/FILTERS">
      <docutil:set select="$this">
        <xapl:value-of select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/FORM[@Name= $this/FORM_NAME[1]/@Value]/FILTERS/*"/>
      </docutil:set>
    </xapl:if>-->
  </x2:command>
  <!--x2:command public="yes" description="_" name="clearFormUserPref">
    <x2:param name="this"/>
    <xapl:print>
    this = <xapl:value-of select="$this"/>
    current pref 1 = <xapl:value-of select="$currentPref"/></xapl:print>
    <docutil:remove select="$this/FILTER_TEXT/@Value"/>
    <xapl:set-variable name="filterXml"/>
    <docutil:remove select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/FORM[@Name= $this/FORM_NAME[1]/@Value]/FILTERS/*"/>
    <xapl:print>current pref 2 = <xapl:value-of select="$currentPref"/></xapl:print>
  </x2:command>
  <x2:command public="yes" description="_" name="clearTableEditorUserPref">
    <x2:param name="this"/>
    <docutil:remove select="$this/FILTER_TEXT/@Value"/>
    <xapl:set-variable name="filterXml"/>
    <xapl:value-of select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/FILTERS/*"/>
  </x2:command-->
  <!-- **********************************************************************
      *********************************************************************** -->
</x2:commands>
