<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2"
    xmlns:core="http://www.i2.com/core"
    xmlns:xcore="http://www.i2.com/xcore"
    xmlns:xcore-db="http://www.i2.com/xcore-db"
    xmlns:xapl="http://www.i2.com/xapl"
    xmlns:web="http://www.i2.com/web"
    xmlns:docutil="http://www.i2.com/docutil"
    xmlns:util="http://www.i2.com/util"
    xmlns:xudl="http://www.i2.com/xudl"
    xmlns:cfg="http://www.i2.com/configurability"
    xmlns:perm="http://www.i2.com/permissibility"
    xmlns:omx="http://www.i2.com/omx"
    xmlns:i18n="http://www.i2.com/i18n"
    xmlns:identity="http://www.i2.com/identity"
    description="_">
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="init">
    <xapl:variable name="hierarchyData" resolver="session" global="true"/>
    <xapl:variable name="dimensionData" resolver="session" global="true"/>
    <xapl:variable name="parent_hierarchy" resolver="session" global="true"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load_header_new">
  <!--
        Clean the pageContext whenever the user comes to this page  from the
        Navigation bar.
        -->
      <xapl:print select="$this"/>
  
      <xapl:if test="$this/START_MEMBER_HIERARCHY/@Value  = 'YES'">
        <xapl:set-variable name="hierarchyData"/>
        <xapl:set-variable name="parent_hierarchy"/>
      </xapl:if>
      <!-- BREADCRUMBS AT TOP OR AFTER CLEAN-CONTEXT-->
      <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
        <x2:with-param name="display" select="'Manage Member Hierarchy'"/>
        <x2:with-param name="page" select="'memberHierarchy'"/>
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
  
      <xapl:return>
        <!-- Breadcrumbs-->
      <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
  
      </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load_header">
      <!--
      Clean the pageContext whenever the user comes to this page  from the
      Navigation bar.
      -->
    <!--
    <xapl:print select="$this"/>

    <xapl:if test="$this/START_MEMBER_HIERARCHY/@Value  = 'YES'">
      <xapl:set-variable name="hierarchyData"/>
      <xapl:set-variable name="parent_hierarchy"/>
    </xapl:if>
    -->
    
    <!-- BREADCRUMBS AT TOP OR AFTER CLEAN-CONTEXT-->
    <!--
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
      <x2:with-param name="display" select="'Manage Member Hierarchy'"/>
      <x2:with-param name="page" select="'memberHierarchy'"/>
      <x2:with-param name="this" select="{$this}"/>
    </x2:execute>
     -->
    <xapl:return>
      <!-- Breadcrumbs-->
      <!--x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/-->
      <!-- Container-->
      <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyView:getContainer">
        <x2:with-param name="this" select="{$this}"/>
        <x2:with-param name="pPage" select="'memberHierarchy'"/>
      </x2:execute>
      <!-- Level Breadcrumbs-->
      <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyController:getLevelHierarchy">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>

      <!-- return parameters-->
      <xapl:value-of select="$this/*"/>

      <xapl:value-of select="$parent_hierarchy"/>

    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load_footer">


    <xapl:return>
      <!-- return parameters-->
      <xapl:value-of select="$this/*"/>
     <MEMBER_HIEARCHY_FOOTER/>

    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load_parent">
  <xapl:print select="$this"/>

  <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyView:setPaginationDefaults">
  	<x2:with-param name="this" select="{$this}"/>	
  </x2:execute>
     
  <xapl:return>
    	
	   <xapl:choose>
		   <xapl:when test="$this/START_MEMBER_HIERARCHY/@Value  = 'YES'">
		   </xapl:when>   	
		   <xapl:when test="$this/refresh_child/@Value = 'TRUE'">
			  <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyController:setOneLevelUp">
				<x2:with-param name="this" select="{$this}"/>
			  </x2:execute>
		   </xapl:when>   	
	   </xapl:choose>
   
      <!-- get the parents-->
      <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyController:getAssignedMembers">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
      <!-- set leaf -->
      <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyController:setLeaf">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
      
      <!-- return parameters-->
      <xapl:value-of select="$this/*"/>

      <xapl:value-of select="$parent_hierarchy"/>

    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load_child">
       <xapl:print select="$this"/>

    <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyView:setPaginationDefaults">
    	<x2:with-param name="this" select="{$this}"/>
    </x2:execute>

    <xapl:return>

    <!-- reset the level id -->
   <xapl:if test="$this/show_child/@Value = 'TRUE' or $this/refresh_child/@Value = 'TRUE'">
     <xapl:choose>
         <xapl:when test="$this/refresh_child/@Value = 'TRUE'"/>
         <xapl:otherwise>
              <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyController:setOneLevelDown">
                <x2:with-param name="this" select="{$this}"/>
              </x2:execute>
         </xapl:otherwise>
     </xapl:choose>
      <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyController:getAssignedChildren">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
   </xapl:if>


      <!-- return parameters-->
      <xapl:value-of select="$this/*"/>

    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load_unassigedChild">
    <xapl:print select="$this"/>

     <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyView:setPaginationDefaults">
     	<x2:with-param name="this" select="{$this}"/>
     </x2:execute>

    <xapl:return>

<!--   <xapl:if test="$this/show_child/@Value = 'TRUE' or $this/refresh_child/@Value = 'TRUE'">-->


         <xapl:if test="$this/show_child/@Value = 'TRUE'">
              <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyController:setOneLevelDown">
                <x2:with-param name="this" select="{$this}"/>
              </x2:execute>
         </xapl:if>

     <xapl:if test="$this/show_child/@Value = 'TRUE' or $this/refresh_child/@Value = 'TRUE' or $this/START_MEMBER_HIERARCHY/@Value = 'YES'">
      <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyController:getUnAssignedMembers">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
     </xapl:if>

<!--   </xapl:if>-->


      <!-- return parameters-->
      <xapl:value-of select="$this/*"/>

    </xapl:return>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    <xapl:print select="$this"/>
    <xapl:return>
     <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <x2:param name="pPage"/>
    <xapl:print select="$this"/>
    <xapl:return>
      <CONTAINER Scrollable="yes" >
        <HELP Url="../../../help/memberHierarchy_help.htm"/>
        <STEP Name="ViewMemberHierarchy" DisplayText="Manage Member Hierarchy" OnClick="{$pages:memberHierarchy}" Selected="{$pPage = 'memberHierarchy'}"/>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
 <x2:command public="yes" description="_" name="getSearchContainer">
    <x2:param name="pPage"/>
    <xapl:print select="$this"/>
    <xapl:return>
      <CONTAINER Scrollable="yes">
        <HELP Url="../../../help/searchMemberHierarchy_help.htm"/>
        <STEP Name="ViewMemberHierarchy" DisplayText="Select Hierarchy" OnClick="{$pages:searchMemberHierarchy}" Selected="{$pPage = 'searchMemberHierarchy'}"/>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="setPaginationDefaults">
  <x2:param name="this"/>
     <xapl:if test="count($this/START_COUNT)=0 or string-length($this/START_COUNT/@Value) = 0">
       <docutil:set select="$this">
        <START_COUNT Value="0"/>
       </docutil:set>
     </xapl:if>
     <xapl:if test="count($this/MAX_ROWS)=0 or string-length($this/MAX_ROWS/@Value) = 0">
       <docutil:set select="$this">
        <MAX_ROWS Value="10"/>
       </docutil:set>
     </xapl:if>
     <xapl:print>
     setPaginationDefaults == <xapl:value-of select="$this"/>
     </xapl:print>
  </x2:command> 
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load_search">
      <!--
      Clean the pageContext whenever the user comes to this page  from the
      Navigation bar.
      -->
    <xapl:print select="$this"/>
    <xapl:if test="$this/MODE/@Value  = 'START'">
      <x2:execute command="bcm.framework.ContextController:cleanContext"/>
      <xapl:set-variable name="hierarchyData"/>
      <xapl:set-variable name="dimensionData"/>
      <xapl:set-variable name="parent_hierarchy"/>
    </xapl:if>

    <!-- BREADCRUMBS AT TOP OR AFTER CLEAN-CONTEXT-->
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
      <x2:with-param name="display" select="'Select Member Hierarchy'"/>
      <x2:with-param name="page" select="'searchMemberHierarchy'"/>
      <x2:with-param name="this" select="{$this}"/>
    </x2:execute>

    <xapl:return>
      <!-- Breadcrumbs-->
      <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
      <!-- Container-->
      <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyView:getSearchContainer">
        <x2:with-param name="this" select="{$this}"/>
        <x2:with-param name="pPage" select="'searchMemberHierarchy'"/>
      </x2:execute>
      <!-- getDimension -->
      <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyController:getDimension">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
      <!--getHierarchy -->

      <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyController:getHierarchy">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>

      <!-- return parameters-->
      <xapl:value-of select="$this/*"/>


    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
</x2:commands>
