<?xml version="1.0" encoding="UTF-8"?>
<x2:commands description="_" xmlns:cfg="http://www.i2.com/configurability" xmlns:core="http://www.i2.com/core" xmlns:omx="http://www.i2.com/omx" xmlns:perm="http://www.i2.com/permissibility" xmlns:util="http://www.i2.com/util" xmlns:web="http://www.i2.com/web" xmlns:x2="http://www.i2.com/x2" xmlns:xapl="http://www.i2.com/xapl" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:docutil="http://www.i2.com/docutil" xmlns:oa="http://www.i2.com/oa" xmlns:xudl="http://www.i2.com/xudl" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity">
    <!-- **********************************************************************
    *********************************************************************** -->
  <x2:command name="loadMemberHierarchy" public="yes">
    <xapl:print>
      <xapl:value-of select="$this"/>
    </xapl:print>

      <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyController:getLevelHierarchy">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>

      <xapl:variable name="topLevel">
        <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyController:getTopLevel"/>
      </xapl:variable> --

     <xapl:set-variable name="dimensionData">
         <DIMENSION>
             <xapl:value-of select="$this/DimensionId"/>
             <xapl:value-of select="$this/DimensionName"/>
             <xapl:value-of select="$this/HierarchyName"/>
             <xapl:value-of select="$this/HierarchyId"/>
         </DIMENSION>
     </xapl:set-variable>
    <docutil:set select="$this">
        <LevelId Value="{$topLevel/LevelId/@Value}"/>
        <LevelName Value="{$topLevel/Name/@Value}"/>
    </docutil:set>

    <web:display-page>
        <web:get-page name="memberHierarchy">
            <xapl:value-of select="$this/HierarchyId"/>
            <xapl:value-of select="$this/LevelId"/>
            <xapl:value-of select="$this/LevelName"/>
            <xapl:value-of select="$dimensionData/HierarchyName"/>
            <xapl:value-of select="$dimensionData/DimensionName"/>
            <xapl:value-of select="$this/START_MEMBER_HIERARCHY"/>
        </web:get-page>
    </web:display-page>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
    <x2:command public="yes" description="_" name="getTopLevel">
    <xapl:print>
            Top Level - Rekha
           <xapl:value-of select="$hierarchyData"/>
   </xapl:print>
        <xapl:variable name="top_level">
            <xapl:value-of select="$hierarchyData/LevelHierarchy[string-length(parentLevelId/@Value) = 0]"/>
        </xapl:variable>
        <xapl:return>
            <xapl:value-of select="$top_level"/>
        </xapl:return>
    </x2:command>
    <!-- **********************************************************************
    *********************************************************************** -->
  <x2:command name="display" public="yes">
    <web:display-page>
        <web:get-page name="memberHierarchy">
            <HierarchyId Value="{$this/HierarchyId/@Value}"/>
            <LevelId Value="{$this/LevelId/@Value}"/>
            <xapl:value-of select="$this/LevelName"/>
            <xapl:value-of select="$dimensionData/DimensionName"/>
            <xapl:value-of select="$dimensionData/HierarchyName"/>
        </web:get-page>
    </web:display-page>
  </x2:command>
    <!-- **********************************************************************
    *********************************************************************** -->
  <x2:command name="displayChild" public="yes">
     <docutil:set select="$this">
       <START_COUNT Value="0"/>
     </docutil:set>
    <web:display-page>
      <web:get-page name="memberHierarchy_child">
  		   <xapl:value-of select="$this/*"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
    <!-- **********************************************************************
    *********************************************************************** -->
  <x2:command name="displayUnAssignedChild" public="yes">
     <docutil:set select="$this">
       <START_COUNT Value="0"/>
     </docutil:set>
    <web:display-page>
      <web:get-page name="memberHierarchy_unassignedChild">
  		   <xapl:value-of select="$this/*"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
    <!-- **********************************************************************
    *********************************************************************** -->
    <x2:command public="yes" description="_" name="addToParentHierarchy">
      <x2:param name="parent_id"/>
      <x2:param name="parent_name"/>
      <x2:param name="level_id"/>
      
      <xapl:print>
       $parent_hierarchy::
         <xapl:value-of select="$parent_hierarchy"/>
      </xapl:print>
      
      <xapl:if test="not($parent_hierarchy)">       
        <xapl:set-variable name="parent_hierarchy">
          <PARENT_HIERARCHY/>
        </xapl:set-variable>
      </xapl:if>


     <docutil:add select="$parent_hierarchy">
       <PARENT>
          <PARENT_ID Value="{$parent_id}"/>
          <PARENT_NAME Value="{$parent_name}"/>
          <LEVEL_ID Value="{$level_id}"/>
       </PARENT>
     </docutil:add>

     <xapl:print>
         $parent_hierarchy::
         <xapl:value-of select="$parent_hierarchy"/>
     </xapl:print>

   </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getLastParentId">

      <xapl:variable name="parent_id">
         <xapl:value-of select="$parent_hierarchy/PARENT[ position() = last()]/PARENT_ID/@Value"/>
      </xapl:variable>


        <xapl:print>
            $getParentMemberId
            <xapl:value-of select="$parent_id"/>
            <xapl:value-of select="$parent_hierarchy"/>
       </xapl:print>

      <xapl:return>
          <xapl:value-of select="$parent_id"/>
      </xapl:return>


  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="removeLastParent">

      <xapl:variable name="parent_id">
         <xapl:value-of select="$parent_hierarchy/PARENT[ position() = last()]/PARENT_ID/@Value"/>
      </xapl:variable>

      <!-- remove the last $parent_parent_id-->
      <docutil:remove select="$parent_hierarchy/PARENT[ position() = last()]"/>
      <!-- print  the last $parent_parent_id  after removing-->
        <xapl:print>
            $removeLastParent
            <xapl:value-of select="$parent_id"/>
            AFTER REMOVING parent_hierarchy:::
            <xapl:value-of select="$parent_hierarchy"/>
       </xapl:print>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="assignedMembers" public="yes">
   <xapl:print>
       assignedMembers==<xapl:value-of select="$this"/>
   </xapl:print>
   <xapl:variable name="ids">
      <x2:execute command="bcm.framework.util:createXMLFromString">
          <x2:with-param name="string" select="{$this/assigned_mem_ids/@Value}"/>
          <x2:with-param name="delimeter" select="'#'"/>
          <x2:with-param name="tagname" select="'ID'"/>
      </x2:execute>
   </xapl:variable>

   <xapl:print>
       $ids=<xapl:value-of select="$ids"/>
   </xapl:print>


   <!-- xapl:variable name="currentRank">
       <xapl:value-of select="$hierarchyData/LevelHierarchy[LevelId/@Value = $this/LevelId/@Value]/Rank/@Value "/>
   </xapl:variable>
   <xapl:print>
       currentRank == <xapl:value-of select="$currentRank"/>
       Found Parent Level == <xapl:value-of select="$hierarchyData/LevelHierarchy[Rank/@Value = ($currentRank - 1)]/LevelId/@Value"/>
   </xapl:print -->

<xapl:print>
HIERARCHY DATA
<xapl:value-of select="$hierarchyData"/>
</xapl:print>


    <xapl:variable name="response">
      <xapl:if test="count($ids/*) > 0">
       <xcore:execute-method name="{concat('//' , $currentService, '/assignMembers')}" entireResponse="true">
  		   <DimensionId Value="{$dimensionData/DimensionId/@Value}"/>
  		   <HierarchyId Value="{$this/HierarchyId/@Value}"/>
		   <LevelId Value="{$this/LevelId/@Value}"/>
		   <!-- xapl:if test="$currentRank > 1">
			<parentLevelId Value="{$hierarchyData/LevelHierarchy[Rank/@Value = ($currentRank - 1)]/LevelId/@Value}"/>
		   </xapl:if-->
		   <xapl:if test="string-length($hierarchyData/LevelHierarchy[LevelId/@Value = $this/LevelId/@Value]/parentLevelId/@Value) > 0">
		   		<parentLevelID Value="{$hierarchyData/LevelHierarchy[LevelId/@Value = $this/LevelId/@Value]/parentLevelId/@Value}"/>
		   	<xapl:print>
		   	Parent Level ID - Rekha1
		    	<xapl:value-of select="{$hierarchyData/LevelHierarchy[LevelId/@Value = $this/LevelId/@Value]/parentLevelId/@Value}"/>
		   	</xapl:print>
                   </xapl:if>

		   <xapl:if test="string-length($this/parent_mem_id/@Value) > 0">
			<ParentId Value="{$this/parent_mem_id/@Value}"/>
		     <xapl:print>
		        Parent Member ID - Rekha1
		         <xapl:value-of select="{$this/parent_mem_id/@Value}"/>
		    </xapl:print>
                   </xapl:if>

		   <Members>
            <xapl:for-each varName="id" select="$ids/*">
              <Id Value="{$id/@Value}"/>
            </xapl:for-each>
		   </Members>
      </xcore:execute-method>
      </xapl:if>
    </xapl:variable>

    <xapl:print>
        assignedMembers response
         <xapl:value-of select="$response"/>
    </xapl:print>


       <!--<xapl:value-of select="$response/RESPONSE"/>-->
        <web:display-page>
          <web:get-page name="memberHierarchy_child">
           <xapl:value-of select="$this/*"/>
          </web:get-page>
        </web:display-page>

  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="unAssignedMembers" public="yes">
   <xapl:print>
       unAssignedMembers==<xapl:value-of select="$this"/>
   </xapl:print>
   <xapl:variable name="ids">
      <x2:execute command="bcm.framework.util:createXMLFromString">
          <x2:with-param name="string" select="{$this/unassigned_mem_ids/@Value}"/>
          <x2:with-param name="delimeter" select="'#'"/>
          <x2:with-param name="tagname" select="'ID'"/>
      </x2:execute>
   </xapl:variable>

   <xapl:print>
       $ids=<xapl:value-of select="$ids"/>
   </xapl:print>
    <xapl:variable name="response">
      <xapl:if test="count($ids/*) > 0">
       <xcore:execute-method name="{concat('//' , $currentService, '/unAssignMembers')}" entireResponse="true">
            <xapl:for-each varName="id" select="$ids/*">
              <NodeId Value="{$id/@Value}"/>
             </xapl:for-each>
              <HierarchyId Value="{$this/HierarchyId/@Value}"/>
	      <LevelId Value="{$this/LevelId/@Value}"/>
       </xcore:execute-method>
     </xapl:if>
    </xapl:variable>

    <xapl:print>
        unAssignedMembers response
         <xapl:value-of select="$response"/>
    </xapl:print>

    <xapl:return>
       <!--<xapl:value-of select="$response/RESPONSE"/>-->
        <web:display-page>
          <web:get-page name="memberHierarchy_unassignedChild">
           <xapl:value-of select="$this/*"/>
          </web:get-page>
        </web:display-page>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="setOneLevelDown" public="yes">
   <x2:param name="this"/>
   <xapl:print>
      start  setOneLevelDown==<xapl:value-of select="$this"/>
   </xapl:print>

   <!--xapl:variable name="currentRank">
       <xapl:value-of select="$hierarchyData/LevelHierarchy[LevelId/@Value = $this/LevelId/@Value]/Rank/@Value "/>
   </xapl:variable>
   <xapl:print>
       currentRank == <xapl:value-of select="$currentRank"/>
       Found Child Level == <xapl:value-of select="$hierarchyData/LevelHierarchy[Rank/@Value = ($currentRank + 1)]/LevelId/@Value"/>
   </xapl:print-->

   <docutil:set select="$this">
     <LevelId Value="{$hierarchyData/LevelHierarchy[parentLevelId/@Value = $this/LevelId/@Value]/LevelId/@Value}"/>
     <LevelName Value="{$hierarchyData/LevelHierarchy[parentLevelId/@Value = $this/LevelId/@Value]/Name/@Value}"/>
   </docutil:set>

   <xapl:print>
      end  setOneLevelDown==<xapl:value-of select="$this"/>
   </xapl:print>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="setLeaf" public="yes">
   <x2:param name="this"/>

   <xapl:variable name="isLeaf">
   	<xapl:choose>
   		<xapl:when test="$hierarchyData/LevelHierarchy[(position() = ( last()-1) )and (LevelId/@Value = $this/LevelId/@Value)]">
		   <docutil:set select="$this">
			 <IS_LEAF Value="TRUE"/>
		   </docutil:set>
		   <IS_LEAF Value="TRUE"/>
   		</xapl:when>
   		<xapl:otherwise>
		   <docutil:set select="$this">
			 <IS_LEAF Value="FALSE"/>
		   </docutil:set>
		   <IS_LEAF Value="FALSE"/>
   		</xapl:otherwise>
   	</xapl:choose>
   </xapl:variable>

   <xapl:print>
   	   is LEAF == <xapl:value-of select="$hierarchyData/LevelHierarchy[position() = last() and LevelId/@Value = $this/LevelId/@Value]"/>
       setLeaf == <xapl:value-of select="$this"/>
   </xapl:print>

   <xapl:return>
      <xapl:value-of select="$isLeaf"/>
   </xapl:return>

  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="getMembersOneLevelDown" public="yes">

   <x2:param name="this"/>
   <xapl:print>
      getMembersOneLevelDown==<xapl:value-of select="$this"/>
   </xapl:print>

   <xapl:if test="$this/go_down/@Value = 'TRUE'">
        <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyController:addToParentHierarchy">
          <x2:with-param name="parent_id" select="$this/parent_mem_id/@Value"/>
          <x2:with-param name="parent_name" select="$this/parent_mem_name/@Value"/>
          <x2:with-param name="level_id" select="$this/LevelId/@Value"/>
        </x2:execute>
      <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyController:setOneLevelDown">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
   </xapl:if>

    <web:display-page>
        <web:get-page name="memberHierarchy">
            <HierarchyId Value="{$this/HierarchyId/@Value}"/>
            <LevelId Value="{$this/LevelId/@Value}"/>
            <xapl:value-of select="$this/LevelName"/>
            <selected_parent_id Value="{$this/parent_mem_id/@Value}"/>
            <xapl:value-of select="$dimensionData/DimensionName"/>
            <xapl:value-of select="$dimensionData/HierarchyName"/>
            <xapl:value-of select="$this/go_down"/>
        </web:get-page>
    </web:display-page>


  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="getMembersOneLevelUp" public="yes">

   <x2:param name="this"/>
   <xapl:print>
      getMembersOneLevelUp==<xapl:value-of select="$this"/>
   </xapl:print>
      <xapl:variable name="one_level_up_parent_id"/>

   <xapl:if test="$this/go_up/@Value = 'TRUE'">
       <!-- get the id of current parent-->
       <xapl:set-variable name="one_level_up_parent_id">
          <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyController:getLastParentId"/>
       </xapl:set-variable>
   	   <!-- remove the last parent -->
       <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyController:removeLastParent"/>
       <xapl:print>
           $one_level_up_parent_id:::
           <xapl:value-of select="$one_level_up_parent_id"/>
       </xapl:print>
      <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyController:setOneLevelUp">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
   </xapl:if>

    <web:display-page>
        <web:get-page name="memberHierarchy">
            <HierarchyId Value="{$this/HierarchyId/@Value}"/>
            <LevelId Value="{$this/LevelId/@Value}"/>
            <xapl:value-of select="$this/LevelName"/>
            <xapl:value-of select="$dimensionData/DimensionName"/>
            <xapl:value-of select="$dimensionData/HierarchyName"/>
            <one_level_up_parent_id Value="{$one_level_up_parent_id}"/>
        </web:get-page>
    </web:display-page>


  </x2:command>
 <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="setOneLevelUp" public="yes">
    <x2:param name="this"/>
   <xapl:print>
      start  setOneLevelUp==<xapl:value-of select="$this"/>
   </xapl:print>

   <xapl:variable name="pLevelId">
       <xapl:value-of select="$hierarchyData/LevelHierarchy[LevelId/@Value = $this/LevelId/@Value]/parentLevelId/@Value "/>
   </xapl:variable>
   <!--xapl:print>
       currentRank == <xapl:value-of select="$currentRank"/>
       Found Parent Level == <xapl:value-of select="$hierarchyData/LevelHierarchy[Rank/@Value = ($currentRank - 1)]/LevelId/@Value"/>
   </xapl:print-->

   <xapl:if test="string-length($pLevelId) > 0">
	   <docutil:set select="$this">
		 <LevelId Value="{$hierarchyData/LevelHierarchy[LevelId/@Value = ($pLevelId)]/LevelId/@Value}"/>
		 <LevelName Value="{$hierarchyData/LevelHierarchy[LevelId/@Value = ($pLevelId)]/Name/@Value}"/>
	   </docutil:set>
   	</xapl:if>


   <xapl:print>
      end  setOneLevelUp==<xapl:value-of select="$this"/>
   </xapl:print>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="getLevelHierarchy" public="yes">
   <xapl:print>
       getLevelHierarchy==<xapl:value-of select="$this"/>
   </xapl:print>

   <xapl:if test="count($hierarchyData/*) = 0 ">
        <xapl:variable name="response">
           <xcore:execute-method name="{concat('//' , $currentService, '/getLevelHierarchyForUI')}" entireResponse="true">
               <HierarchyId Value="{$this/HierarchyId/@Value}"/>
          </xcore:execute-method>
        </xapl:variable>

          <xapl:set-variable name="hierarchyData">
                <xapl:value-of select="$response/RESPONSE"/>
          </xapl:set-variable>

         <xapl:print>
            getLevelHierarchy response
             <xapl:value-of select="$response"/>
           hierarchyData == <xapl:value-of select="$hierarchyData"/>
        </xapl:print>
   </xapl:if>

    <xapl:return>
       <xapl:value-of select="$hierarchyData"/>
       <xapl:value-of select="$this/LevelId"/>
       <xapl:value-of select="$this/LevelId"/>
       <xapl:value-of select="$this/parent_mem_id"/>
       <xapl:value-of select="$this/parent_mem_name"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
 <!-- parent is calling this -->
  <x2:command name="getAssignedMembers" public="yes">

  <xapl:print>
         Calling getAssignedMembers - TODAY
  </xapl:print>

	  <xapl:variable name="parent_parent_id">
		 <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyController:getLastParentId"/>
	  </xapl:variable>

   <xapl:print>
       getAssignedMembers==<xapl:value-of select="$this"/>
       parent_hierarchy==<xapl:value-of select="$parent_hierarchy"/>
       parent_parent_id==<xapl:value-of select="$parent_parent_id"/>
   </xapl:print>



    <xapl:variable name="response">
    <xapl:choose>
         <xapl:when test="$parent_parent_id and string-length($parent_parent_id) > 0">
              <xapl:print>
                  PARENTS:::calling  getAssignedChildrenForUI  for getting all the child of selected parent ::
                  $parent_parent_id :: <xapl:value-of select="$parent_parent_id"/>
              </xapl:print>

              <xapl:print>
	            PARENTS:::getAssignedChildrenForUI HierarchyId ::
	            :: <xapl:value-of select="$this/HierarchyId/@Value"/>
	      </xapl:print>

              <xapl:print>
	            PARENTS:::getAssignedChildrenForUI LevelId ::
	            :: <xapl:value-of select="$this/LevelId/@Value"/>
	      </xapl:print>

               <xcore:execute-method name="{concat('//' , $currentService, '/getAssignedChildrenForUI')}" StartAtRow="{$this/*[name() = 'START_COUNT']/@Value}" MaxRows="{$this/*[name() = 'MAX_ROWS']/@Value}" ReturnRowCount="yes" entireResponse="true">
               	       <NodeId Value="{$parent_parent_id}"/>
               	       <HierarchyId Value="{$this/HierarchyId/@Value}"/>
                       <LevelId Value="{$this/LevelId/@Value}"/>
                       <xapl:if test="string-length($this/P_SRCH/@Value) > 0">
                         <xcore:search-by property="Name" value="{$this/P_SRCH/@Value}"/>
                       </xapl:if>
              </xcore:execute-method>
         </xapl:when>
         <xapl:otherwise>
             <xapl:print>
                  PARENTS :::calling  getAssignedMembersForUI  for getting all the child of selected parent ::
                  <xapl:value-of select="$this/selected_parent_id"/>
              </xapl:print>
           <xcore:execute-method name="{concat('//' , $currentService, '/getAssignedMembersForUI')}" StartAtRow="{$this/*[name() = 'START_COUNT']/@Value}" MaxRows="{$this/*[name() = 'MAX_ROWS']/@Value}" ReturnRowCount="yes" entireResponse="true">
               <HierarchyId Value="{$this/HierarchyId/@Value}"/>
               <LevelId Value="{$this/LevelId/@Value}"/>
               <xapl:if test="string-length($this/P_SRCH/@Value) > 0">
                 <xcore:search-by property="Name" value="{$this/P_SRCH/@Value}"/>
               </xapl:if>
          </xcore:execute-method>
         </xapl:otherwise>
      </xapl:choose>

    </xapl:variable>

   <docutil:set select="$this">
    <TOTAL_RECORD_COUNT Value="{$response/RESPONSE/@TotalRowCount}"/>
   </docutil:set>

    <xapl:print>
        getAssignedMembers response
         <xapl:value-of select="$response"/>
    </xapl:print>

    <xapl:return>
       <xapl:value-of select="$response/RESPONSE"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="getAssignedChildren" public="yes">
   <xapl:print>
      getAssignedChildren== <xapl:value-of select="$this"/>
   </xapl:print>

    <xapl:variable name="response">
     <xapl:if test="string-length($this/parent_mem_id/@Value) > 0 ">
       <xcore:execute-method name="{concat('//' , $currentService, '/getAssignedChildrenForUI')}" StartAtRow="{$this/*[name() = 'START_COUNT']/@Value}" MaxRows="{$this/*[name() = 'MAX_ROWS']/@Value}" ReturnRowCount="yes" entireResponse="true">
               <NodeId Value="{$this/parent_mem_id/@Value}"/>
               <LevelId Value="{$this/LevelId/@Value}"/>
               <HierarchyId Value="{$this/HierarchyId/@Value}"/>
               <xapl:if test="string-length($this/AC_SRCH/@Value) > 0">
                 <xcore:search-by property="Name" value="{$this/AC_SRCH/@Value}"/>
               </xapl:if>
      </xcore:execute-method>
     </xapl:if>
    </xapl:variable>
   <docutil:set select="$this">
    <TOTAL_RECORD_COUNT Value="{$response/RESPONSE/@TotalRowCount}"/>
   </docutil:set>
    <xapl:print>
        getAssignedMembers response
         <xapl:value-of select="$response"/>
    </xapl:print>

    <xapl:return>
       <xapl:value-of select="$response/RESPONSE"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="getUnAssignedMembers" public="yes">
   <xapl:print>
       getUnAssignedMembers==<xapl:value-of select="$this"/>
   </xapl:print>

    <xapl:variable name="response">
       <xcore:execute-method name="{concat('//' , $currentService, '/getUnAssignedMembers')}" StartAtRow="{$this/*[name() = 'START_COUNT']/@Value}" MaxRows="{$this/*[name() = 'MAX_ROWS']/@Value}" ReturnRowCount="yes" entireResponse="true">
  		   <HierarchyId Value="{$this/HierarchyId/@Value}"/>
		   <LevelId Value="{$this/LevelId/@Value}"/>
		   <xapl:if test="string-length($this/parent_mem_id/@Value) > 0">
		        <ParentId Value="{$this/parent_mem_id/@Value}"/>
           	    </xapl:if>
           <xapl:if test="string-length($this/UC_SRCH/@Value) > 0">
             <xcore:search-by property="Name" value="{$this/UC_SRCH/@Value}"/>
           </xapl:if>
      </xcore:execute-method>
    </xapl:variable>
   <docutil:set select="$this">
    <TOTAL_RECORD_COUNT Value="{$response/RESPONSE/@TotalRowCount}"/>
   </docutil:set>
    <xapl:print>
        getUnAssignedMembers response
         <xapl:value-of select="$response"/>
    </xapl:print>

    <xapl:return>
       <xapl:value-of select="$response/RESPONSE"/>
    </xapl:return>

  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="getDimension" public="yes">
   <xapl:print>
       getDimension==<xapl:value-of select="$this"/>
   </xapl:print>


        <xapl:variable name="response">
           <xcore:execute-method name="{concat('//' , $currentService, '/getDimension')}" entireResponse="true">
          </xcore:execute-method>
        </xapl:variable>

         <xapl:print>
            getDimension response
             <xapl:value-of select="$response"/>
        </xapl:print>


    <xapl:return>
       <xapl:value-of select="$response/RESPONSE"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="getHierarchy" public="yes">
   <xapl:print>
       getHierarchy==<xapl:value-of select="$this"/>
   </xapl:print>

   <xapl:variable name="response"/>

   <xapl:if test="string-length($this/selectedDim/@Value) > 0 ">
        <xapl:set-variable name="response">
           <xcore:execute-method name="{concat('//' , $currentService, '/getHierarchy')}" entireResponse="true">
               <DimensionId Value="{$this/selectedDim/@Value}"/>
          </xcore:execute-method>
        </xapl:set-variable>

         <xapl:print>
            getHierarchy response
             <xapl:value-of select="$response"/>
        </xapl:print>
   </xapl:if>

    <xapl:return>
       <xapl:value-of select="$response/RESPONSE"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="saveAndReturn" public="yes">
   <xapl:print>
       saveAndReturn==<xapl:value-of select="$this"/>
   </xapl:print>

  <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyController:assignedMembers">
    <x2:with-param name="this" select="{$this}"/>
  </x2:execute>
  <xapl:print>
       Calling unAssignedMembers - New in Save and Return only
  </xapl:print>
  <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyController:unAssignedMembers">
    <x2:with-param name="this" select="{$this}"/>
  </x2:execute>

  <xapl:print>
         After Executing unAssignedMembers - New in Save and Return only
  </xapl:print>

    <web:display-page>
      <web:get-page name="searchMemberHierarchy">
           <MODE Value="START"/>
      </web:get-page>
    </web:display-page>

  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="save" public="yes">
   <xapl:print>
      calling save==<xapl:value-of select="$this"/>
   </xapl:print>

  <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyController:assignedMembers">
    <x2:with-param name="this" select="{$this}"/>
  </x2:execute>

   <xapl:print>
         Calling unAssignedMembers - New in Save only
  </xapl:print>
  <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyController:unAssignedMembers">
    <x2:with-param name="this" select="{$this}"/>
  </x2:execute>

  <xapl:print>
           After Executing unAssignedMembers - New in Save only
    </xapl:print>


    <web:display-page>
      <web:get-page name="memberHierarchy_childs">
           <xapl:value-of select="$this/*"/>
      </web:get-page>
    </web:display-page>

  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="reloadParentAndChilds" public="yes">
   <xapl:print>
      calling save==<xapl:value-of select="$this"/>
   </xapl:print>

  <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyController:assignedMembers">
    <x2:with-param name="this" select="{$this}"/>
  </x2:execute>
  <x2:execute command="bcm.framework.hierarchy.memberHierarchy.memberHierarchyController:unAssignedMembers">
    <x2:with-param name="this" select="{$this}"/>
  </x2:execute>

    <web:display-page>
      <web:get-page name="memberHierarchy_content">
           <xapl:value-of select="$this/*"/>
      </web:get-page>
    </web:display-page>

  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->

</x2:commands>
