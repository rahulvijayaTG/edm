<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- **********************************************************************
  *********************************************************************** -->
  
  <x2:command public="yes" description="_" name="load">
    <xapl:print>
          <xapl:value-of select="$this"/>
    </xapl:print>
   
    <xapl:if test="$this/MODE/@Value = 'START'">
      <docutil:remove select="$this/MODE"/>
      <x2:execute command="bcm.context.controller:cleanContext"/>
    </xapl:if>
   <!--  
    <xapl:variable name ="horizonRefID">
					<x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
						<x2:with-param name="selectedId" select="$this/SELECTED_ID/@Value"/>
						<x2:with-param name="key" select="'horizonReferenceID'"/>
					</x2:execute>
    </xapl:variable>
    
    <docutil:set select="$this">
      <horizonRefID Value="{$horizonRefID}"/> 		
    </docutil:set>
     --> 
    <!-- BREADCRUMBS AT TOP OR AFTER CLEAN-CONTEXT-->
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
      <x2:with-param name="display" select="'HorizonReferenceDetail'"/>
      <x2:with-param name="page" select="'HorizonRefDetail'"/>
      <x2:with-param name="this" select="{$this}"/>
    </x2:execute>
    
    <xapl:variable name="form">
      <x2:execute command="bcm.framework.queryform.Form:getFormContainer">
        <x2:with-param name="this" select="$this"/>
        <x2:with-param name="pSearchParam" select="$searchParam"/>
        <x2:with-param name="pFormName" select="'HORIZON_REF_DETAIL'"/>
        <x2:with-param name="pServiceName" select="'BCMMasterService'"/>
        <x2:with-param name="pSearchReportConfigSource" select="'bcm.framework.hierarchy.timeHierarchy.view:getReportConfig'"/>
        <x2:with-param name="pReportDataSource" select="'bcm.framework.hierarchy.timeHierarchy.view:getReportData'"/>
      </x2:execute>
    </xapl:variable>
    
    <xapl:return>
      <!-- Page Header-->
      <x2:execute command="bcm.framework.hierarchy.timeHierarchy.view:getHeader">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
      
      <!-- Container-->
      <x2:execute command="bcm.framework.hierarchy.timeHierarchy.view:getContainer">
        <x2:with-param name="this" select="{$this}"/>
        <x2:with-param name="pPage" select="'HorizonRefDetail'"/>
      </x2:execute>
      
      <!-- Search / Form and Report -->
      <xapl:value-of select="$form"/>
      
      <!-- return filter parameters-->
      <xapl:value-of select="$this/*"/>
      <xapl:print>
      	 <xapl:value-of select="$this"/>
      </xapl:print>
      
      <!-- return context-->
      <xapl:value-of select="$context"/>
      
    </xapl:return>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    <xapl:return>
      <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <x2:param name="pPage"/>
    <!-- getting called for deatils page -->           
    <xapl:return>
      <CONTAINER Scrollable="no">
        <HELP Url="../../../help/Manage_TimeHierarchy_help.htm"/>
        <EXPRESSION_FILTER Value="yes"/>
        <STEP DisplayText="{concat('Horizon Reference Detail for Horizon Reference ',$this/horizonRefID/@Value)}" OnClick="{$pages:HorizonRefDetail}" Selected="{$pPage = 'HorizonRefDetail'}"/>
				

        </CONTAINER>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportConfig">
    <xapl:return>
      <REPORT Title="" Selectable="All" Action="timeHierarchy.jsp" Method="POST" Scrollable="yes" ScrollableContainer="no" Id="#" ShowFilter="yes" SelectedId="SELECTED_HORIZON_ID" PagingTitle="yes" NoRecordsTitle="No Records found">
        <FIELDS>
          <!--get form's report fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
          <!-- get Hidden Fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
           <FIELD Name="horizonRefID" DisplayType="Hidden" Value="{$this/horizonRefID/@Value}"/>
        </FIELDS>   
       <!--Putting the buttons here due to resizing issues -->
				<BUTTONS>
            <BUTTON Id="back" Name="Back" DisplayText="Back" OnClick="javascript:back()"/>
       		  <BUTTON Id="export" Name="export" DisplayText="Export to Excel" OnClick="javascript:onExportToExcelGlobal('horizonReferenceDetails','xls')" DisableOnClick="true" Disabled="report"/>
            <BUTTON Name="clear" DisplayText="Clear" OnClick="javascript:onClear()"/>
            <BUTTON Name="search" DisplayText="Search" OnClick="javascript:dispatchSearch()" Emphasized="yes"/>
	      </BUTTONS>
        
        <PAGINATION/>
     
        </REPORT>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
<!-- x2:command public="yes" description="_" name="getReportData">
  <x2:param name="this"/>
  <x2:param name="pForm"/>
 	<xapl:variable name="request"/>
