  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportData">
    <x2:param name="this"/>
    <x2:param name="pForm"/>
    
    <docutil:remove select="$this/F_HorizonReferenceDetail.horizonReferenceID"/>   
    <docutil:add select="$this">
      <F_HorizonReferenceDetail.horizonReferenceID Value="{$this/horizonRefID/@Value}"/>      
    </docutil:add>
    
     <xapl:variable name="reportData">
      <x2:execute command="bcm.framework.queryform.Form:getFormReportData">
        <x2:with-param name="this" select="$this"/>
        <x2:with-param name="fromProperty" select="'RESULT_PROPERTY'"/>
        <x2:with-param name="delimeter" select="'.'"/>
      </x2:execute>
    </xapl:variable>
    
    <xapl:return>
             <xapl:value-of select="$reportData"/>
        </xapl:return>
  </x2:command>
  
 
  
  <!-- **********************************************************************
  *********************************************************************** -->
 </x2:commands>
