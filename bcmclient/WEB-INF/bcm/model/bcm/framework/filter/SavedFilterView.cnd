<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:identity="http://www.i2.com/identity" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" description="_">
  <!-- **********************************************************************
       *********************************************************************** -->

  <x2:command public="yes" description="_" name="load">

    <xapl:print select="$this"/>
    <!-- BREADCRUMBS AT TOP OR AFTER CLEAN-CONTEXT-->
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
      <x2:with-param name="display" select="'Saved Filters Page'"/>
      <x2:with-param name="page" select="'saved_filters'"/>
      <x2:with-param name="this" select="{$this}"/>
    </x2:execute>

   <!-- override the form name if coming from another form -->
    <docutil:set select="$this">
        <DO_SEARCH Value="Yes"/>
        <FORM_NAME Value="FILTERS_FORM"/>
    </docutil:set>

    <xapl:print>
        <xapl:value-of select="count($saved_filters/*)"/>
    </xapl:print>

    <xapl:variable name="count" select="count($saved_filters/*)"/>

    <xapl:variable name="form">
        <x2:execute command="bcm.framework.queryform.Form:getFormContainer">
          <x2:with-param name="this" select="$this"/>
          <x2:with-param name="pSearchParam" select="$searchParam"/>
          <x2:with-param name="pFormName" select="$this/FORM_NAME/@Value"/>
          <x2:with-param name="pServiceName" select="$this/SERVICE[1]/@Value"/>
          <x2:with-param name="pSearchReportConfigSource" select="'bcm.framework.filter.SavedFilterView:getReportConfig'"/>
          <x2:with-param name="pReportDataSource" select="'bcm.framework.filter.SavedFilterView:getReportData'"/>
        </x2:execute>
    </xapl:variable>

    <xapl:return>

      <!-- Page Header-->
      <x2:execute command="bcm.framework.filter.SavedFilterView:getHeader">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>

     <!-- Top Level Container -->
        <x2:execute command="bcm.framework.filter.SavedFilterView:getContainer">
          <x2:with-param name="this" select="$this"/>
          <x2:with-param name="pPage" select="'filter'"/>
          <x2:with-param name="count" select="$count"/>
        </x2:execute>

     <xapl:value-of select="$this/*"/>

     <xapl:value-of select="$saved_filters/*"/>

     <xapl:value-of select="$form"/>

    </xapl:return>
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    <xapl:return>
     <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <x2:param name="count"/>
    <xapl:return>
      <CONTAINER Scrollable="no">
        <HELP Url="../../help/filter_saved_help.htm"/>
        <xapl:variable name="title1">
          <i18n:text>
            <xapl:value-of select="$this/TABLE_NAME/@Value"/>
          </i18n:text>
        </xapl:variable>
        <xapl:variable name="title2">
      <i18n:text>Filters</i18n:text>
        </xapl:variable>
        <STEP
          Name="FilterTable"
          DisplayText="{concat( $title1, ' ', $title2) }"
          Selected="true"
        >
       </STEP>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportConfig">
    <x2:param name="this"/>

    <xapl:return>
      <REPORT Title="Saved Filters" Action="saved_filters.jsp" Method="POST" Selectable="Single" Scrollable="yes" ScrollableContainer="no" Id="ID" ShowFilter="yes" SelectedId="FILTER_ID" PagingTitle="yes" NoRecordsTitle="No filters found">
        <FIELDS>
          <!--get form's report fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportFieldsByProperty">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
          <!-- add custom fields -->
          <FIELD
              Sequence="3"
              Name="DISPLAY"
              Filter="no"
              DisplayText="Filter Expression"
              DisplayType="Text"
              DisplayNoWrap="yes"
              Sortable="no"
              Hidden="no"
              />
          <!-- get Hidden Fields -->
        <!-- from page form name -->
        <FIELD Name="FROM_PAGE_FORM_NAME" DisplayType="Hidden" Value="{$this/FROM_PAGE_FORM_NAME[position() = 1]/@Value}"/>

        <FIELD Name="DO_SEARCH" DisplayType="Hidden" Value="{$this/DO_SEARCH[position() = 1]/@Value}"/>
        <FIELD Name="SORT_BY" DisplayType="Hidden" Value="{$this/SORT_BY[position() = 1]/@Value}"/>
        <FIELD Name="SORT_ORDER" DisplayType="Hidden" Value="{$this/SORT_ORDER[position() = 1]/@Value}"/>
        <FIELD Name="FORM_NAME" DisplayType="Hidden" Value="{$this/FORM_NAME[position() = 1]/@Value}"/>
        <FIELD Name="SERVICE" DisplayType="Hidden" Value="{$this/SERVICE[position() = 1]/@Value}"/>
        <FIELD Name="SELECTED_AUTH_SCOPE" DisplayType="Hidden" Value="{$this/SELECTED_AUTH_SCOPE[position() = 1]/@Value}"/>
        <!-- used by filters -->
        <FIELD Name="PAGE" DisplayType="Hidden" Value="{$this/PAGE[position() = 1]/@Value}"/>
        <FIELD Name="PAGE_HEADING" DisplayType="Hidden"/>
          <!-- additional hidden fields -->
          <xapl:if test="count($this/TABLE_NAME) > 0">
              <FIELD Name="TABLE_NAME" DisplayType="Hidden" Value="{$this/TABLE_NAME/@Value}"/>
              <FIELD Name="DIRECTORY" DisplayType="Hidden" Value="{$this/DIRECTORY/@Value}"/>
              <FIELD Name="FILE" DisplayType="Hidden" Value="{$this/FILE/@Value}"/>
          </xapl:if>
          <FIELD Name="ACTIVITY_ID" DisplayType="Hidden" Value="{$this/ACTIVITY_ID/@Value}"/>
          <!--FIELD Name="FAV_ID" DisplayType="Hidden" Value="{$this/FAV_ID/@Value}"/-->

        </FIELDS>
          <BUTTONS>
              <BUTTON Id="cancel_button" Name="Cancel" DisplayText="Cancel" OnClick="javascript:onCancel()"/>
              <DIVIDER/>
              <BUTTON Id="create_button" Name="Create" DisplayText="Create" OnClick="javascript:onCreate()"/>
              <DIVIDER/>
              <BUTTON Id="remove_button" Name="Remove" DisplayText="Remove" Disabled="report" OnClick="javascript:onRemove()"/>
              <DIVIDER/>
              <BUTTON Id="edit_button" Name="Edit" DisplayText="Edit" Disabled="report" OnClick="javascript:onEdit()"/>
              <DIVIDER/>
              <BUTTON Id="apply_button" Name="ApplyAndReurn" DisplayText="Apply And Return" Disabled="report" OnClick="javascript:onApplyAndReturn()"/>
              <DIVIDER/>
							<BUTTON Id="clear" Name="Clear" DisplayText="Clear" OnClick="javascript:onClearFilter()" DisableOnClick="true" ActionType="_VIEW_ONLY_"/>
							<BUTTON Name="search" DisplayText="Search" OnClick="javascript:dispatchSearch()" Emphasized="yes"/>
          </BUTTONS>
        <PAGINATION/>
      </REPORT>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportData">
    <x2:param name="this"/>
    <xapl:print>
        <xapl:value-of select="$this"/>
    </xapl:print>
    <xapl:if test="not($this/INIT)">
      <xapl:set-variable name="saved_filters">
           <x2:execute command="bcm.framework.filter.controller:getFilters">
              <x2:with-param name="this" select="{$this}"/>
          </x2:execute>
        </xapl:set-variable>
    </xapl:if>
    <xapl:for-each select="$saved_filters/SEARCH_FILTER" varName="child">
         <xapl:variable name="display_text" select="''"></xapl:variable>
         <xapl:for-each select="$child/FILTER_DETAILS/DISPLAY/STEP" varName="step">
           <xapl:print>
               STEP::<xapl:value-of select="$step/@Value"/>
           </xapl:print>
           
           <xapl:variable name="modifiedStep">
            <xapl:value-of select="$step/@Value"/>
           </xapl:variable>
            
           <xapl:if test="contains($modifiedStep, '^lt;')">
            <xapl:set-variable name="modifiedStep">
              <xapl:value-of select="concat( substring-before($modifiedStep , '^lt;' ) , '&lt;' , substring-after($modifiedStep , '^lt;' ) )"/>
            </xapl:set-variable>
           </xapl:if>
           
           <xapl:set-variable name="display_text">
              <xapl:value-of select="concat ($display_text , $modifiedStep , ' ' ) "/>
           </xapl:set-variable>
           
         </xapl:for-each>
           <xapl:print>
               $display_text::<xapl:value-of select="$display_text"/>
           </xapl:print>
          <docutil:set select="$child">
            <DISPLAY Value="{$display_text}"/>
          </docutil:set>
    </xapl:for-each>
    <xapl:print>
        <xapl:value-of select="$saved_filters"/>
    </xapl:print>
    <xapl:return>
      <xapl:value-of select="$saved_filters"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
</x2:commands>
