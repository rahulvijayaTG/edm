<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:identity="http://www.i2.com/identity" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" description="_">
  <!-- **********************************************************************
       *********************************************************************** -->

  <x2:command public="yes" description="_" name="load">

    <xapl:print select="$this"/>
    <!-- BREADCRUMBS AT TOP OR AFTER CLEAN-CONTEXT-->
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
      <x2:with-param name="display" select="'Filter Expression Page'"/>
      <x2:with-param name="page" select="'filter'"/>
      <x2:with-param name="this" select="{$this}"/>
    </x2:execute>

      <xapl:variable name="filter_details"/>  
   
     <!-- put this code before calling getHeader -->
     
     <xapl:choose>
       <xapl:when test="count($this/PAGE) = 1  and string-length($this/PAGE/@Value) > 0">
         <x2:execute command="bcm.framework.queryform.Form:create">
              <x2:with-param name="pFormName" select="{$this/FROM_PAGE_FORM_NAME/@Value}"/>
              <x2:with-param name="pServiceName" select="$this/SERVICE/@Value"/>
         </x2:execute>
         <docutil:set select="$this">
            <FORM_NAME Value="{$this/FROM_PAGE_FORM_NAME/@Value}"/>
         </docutil:set>
         
        <!--xapl:print>x2 defaults values<xapl:value-of select="$x2config"/></xapl:print> 

        <xapl:variable name="currentDoc">
            <xapl:value-of select="$x2config/query_form_config/override_forms/form[@name=$this/FORM_NAME/@Value]"/>
        </xapl:variable>
        <xapl:variable name="ShowAllPropsInAdvancedFilter">
            <xapl:choose>
                <xapl:when test="string-length($currentDoc/param[@name='ShowAllPropsInAdvancedFilter']/@value)>0">
                    <xapl:value-of select="$currentDoc/param[@name='ShowAllPropsInAdvancedFilter']/@value"/>
                </xapl:when>
                <xapl:otherwise>
                    <xapl:value-of select="'no'"/>
                </xapl:otherwise>
            </xapl:choose>    
        </xapl:variable-->

        <xapl:variable name="ShowAllPropsInAdvancedFilter">
            <xapl:choose>
                <xapl:when test="$this/SHOW_ALL_FIELDS/@Value = 'yes'">
                    <xapl:value-of select="'Yes'"/>
                </xapl:when>
                <xapl:otherwise>
                    <xapl:value-of select="'No'"/>
                </xapl:otherwise>
            </xapl:choose>    
        </xapl:variable>
        <xapl:variable name="docList">
            <DOC_LIST>
                <DOC name="{$currentForm/DOCUMENT_TRAVERSAL/@PrimaryDocument}"/>
            </DOC_LIST>    
        </xapl:variable>
        <xapl:print>######docList....<xapl:value-of select="$docList"/></xapl:print> 
        <xapl:for-each varName="queryPath" select="$currentForm/DOCUMENT_TRAVERSAL/QUERY_PATH">
              <xapl:if test="string-length($docList/*[@name = $queryPath/@FromDoc]/@name) = 0"> 
                    <docutil:add select="$docList">
                        <DOC name="{$queryPath/@FromDoc}"/>
                    </docutil:add>
              </xapl:if> 
              <xapl:if test="string-length($docList/*[@name = $queryPath/@ToDoc]/@name) = 0"> 
                    <docutil:add select="$docList">
                        <DOC name="{$queryPath/@ToDoc}"/>
                    </docutil:add>
              </xapl:if> 
        </xapl:for-each>
        <xapl:print>ShowAllPropsInAdvancedFilter....<xapl:value-of select="$ShowAllPropsInAdvancedFilter"/></xapl:print>
        <xapl:print>docList....<xapl:value-of select="$docList"/></xapl:print> 
        <xapl:print select="$this"/>
         <xapl:choose>
            <xapl:when test = "$ShowAllPropsInAdvancedFilter='Yes' or $ShowAllPropsInAdvancedFilter='YES' ">
                <xapl:variable name="allDocProps">
                    <ALL_DOC_PROPS/>    
                </xapl:variable>
                <xapl:for-each varName="docInList" select="$docList/*">
                    <xapl:print><xapl:value-of select="$docInList/@name"/></xapl:print>
                    <xapl:variable name="currentDocument">
                          <xapl:value-of select="{$metaData/SERVICE[@Name=$this/SERVICE[1]/@Value]/DOCUMENTS/DOCUMENT[ @Name = $docInList/@name ]}"/>
                    </xapl:variable>
                    <xapl:for-each varName="docProp" select="$currentDocument/*">
                        <xapl:variable name="searchProp">
                            <SEARCH_PROPERTY Document="{$docInList/@name}" Name="{$docProp/@Name}" DataType="{$docProp/@Type}" DisplayName="{$docProp/@DisplayName}" Property="{$docProp/@Name}"/>
                        </xapl:variable>
                        <docutil:add select="$allDocProps">
                            <xapl:value-of select="$searchProp"/>
                        </docutil:add>
                    </xapl:for-each>
                </xapl:for-each> 
                <xapl:print select="$allDocProps/*"/>
                <xapl:set-variable name="filter_details">
                 <FILTER_COLUMNS  TableDisplayName="{$currentForm/@DisplayName}" TableName="{$this/FROM_PAGE_FORM_NAME/@Value}">
                    <xapl:value-of select="{$allDocProps/*[./@Name!='ENTITY_STATE' and ./@Name!='SCENARIO_ID']}"/>
                 </FILTER_COLUMNS>
                </xapl:set-variable>  
                
              <!--added by Mithun for 3M -->
                <xapl:variable name="newOptionPropForm">
                <FORMS_DATA>
                        <xapl:value-of select="$currentFormsOptionData/SERVICE[@Name = $this/SERVICE[1]/@Value]/FORM[@Name = $currentForm/@Id]/OPTION_TYPES/*"/>
                </FORMS_DATA>        
		</xapl:variable>	
                <xapl:print>***newOptionPropForm***<xapl:value-of select="$newOptionPropForm"/></xapl:print> 
                <xapl:for-each varName="docInList" select="$docList/*">
                      <!--xapl:set-variable name="optionType" select="'bcm.framework.filter.FilterView:getOptionTypes'"/-->
                      <xapl:variable name="tableName">
                      	<xapl:value-of select="$docInList/@name"/>
                      </xapl:variable>
                      <xapl:variable name="optionTypes">
                      <x2:execute command="bcm.framework.filter.FilterView:getOptionTypes">
		      	<x2:with-param name="tablename" select="{$tableName}"/>
		      	<x2:with-param name="this" select="{$this}"/>
		      </x2:execute>
		      </xapl:variable>
		      <docutil:add select="$newOptionPropForm">
		              <xapl:value-of select="$optionTypes"/>
		      </docutil:add>
		</xapl:for-each>
		<xapl:print>*****newOptionPropForm*****<xapl:value-of select="$newOptionPropForm"/></xapl:print> 
		<xapl:for-each varName="optionPropForm" select="{$newOptionPropForm/PROPERTY}">
		   <xapl:if test="$filter_details/SEARCH_PROPERTY[@Property=$optionPropForm/@Name and @Document=$optionPropForm/@Document]">	
			   <docutil:set select="$filter_details/SEARCH_PROPERTY[@Property=$optionPropForm/@Name and @Document=$optionPropForm/@Document]">
			      <OPTIONS>
				  <xapl:value-of select="$optionPropForm/*"/>
			      </OPTIONS>
			   </docutil:set>
		  </xapl:if> 
		</xapl:for-each>	
		<xapl:print>*****Returned to XSL*****<xapl:value-of select="$filter_details"/></xapl:print> 
		<!--added by Mithun for 3M -->
	    </xapl:when>                 
            <xapl:otherwise>
                <xapl:set-variable name="filter_details">
                 <FILTER_COLUMNS  TableDisplayName="{$currentForm/@DisplayName}" TableName="{$this/FROM_PAGE_FORM_NAME/@Value}">
                    <xapl:value-of select="$currentForm/SEARCH_PROPERTIES/*"/>
                 </FILTER_COLUMNS>
                 </xapl:set-variable>
                 <!--added by Mithun for 3M -->
                 <xapl:print><xapl:value-of select="$filter_details"/></xapl:print>
		 <xapl:for-each varName="optionPropForm" select="{$currentFormsOptionData/SERVICE[@Name = $this/SERVICE[1]/@Value]/FORM[@Name = $currentForm/@Id]/OPTION_TYPES/*}">
		 <xapl:print>option prop-QueryForm
			!!!!!<xapl:value-of select="$currentFormsOptionData"/>
			#######<xapl:value-of select="$filter_details/SEARCH_PROPERTY[./@Property=$optionPropForm/@Name and ./@Document=$optionPropForm/@Document]"/>
		 </xapl:print>
		 <docutil:add select="$filter_details/SEARCH_PROPERTY[./@Property=$optionPropForm/@Name and ./@Document=$optionPropForm/@Document]">
			<OPTIONS>
				<xapl:value-of select="$optionPropForm/*"/>
			</OPTIONS>
		 </docutil:add>
		</xapl:for-each>
     		<!--added by Mithun for 3M -->
            </xapl:otherwise>
         </xapl:choose>
        </xapl:when>
       <xapl:otherwise>
            <xapl:print>x2 defaults values<xapl:value-of select="$x2config"/></xapl:print> 
            <xapl:variable name="currentDoc">
                <xapl:value-of select="$x2config/table_editor_config/override_tables/table[@name=$this/TABLE_NAME/@Value]"/>
            </xapl:variable>
            <!--xapl:variable name="ShowAllPropsInAdvancedFilter">
                <xapl:choose>
                    <xapl:when test="string-length($currentDoc/param[@name='ShowAllPropsInAdvancedFilter']/@value)>0">
                        <xapl:value-of select="$currentDoc/param[@name='ShowAllPropsInAdvancedFilter']/@value"/>
                    </xapl:when>
                    <xapl:otherwise>
                        <xapl:value-of select="'no'"/>
                    </xapl:otherwise>
                </xapl:choose>    
            </xapl:variable-->

            <xapl:variable name="ShowAllPropsInAdvancedFilter">
                <xapl:choose>
                    <xapl:when test="$this/SHOW_ALL_FIELDS/@Value = 'yes'">
                        <xapl:value-of select="'Yes'"/>
                    </xapl:when>
                    <xapl:otherwise>
                        <xapl:value-of select="'No'"/>
                    </xapl:otherwise>
                </xapl:choose>    
            </xapl:variable>
            
            <xapl:print>ShowAllPropsInAdvancedFilter....<xapl:value-of select="$ShowAllPropsInAdvancedFilter"/></xapl:print> 
             <xapl:print>%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%$currentTablesOptionData/SERVICE[@Name = $this/SERVICE[1]/@Value]/TABLE[@Name = $this/TABLE_NAME[1]/@Value]/OPTION_TYPES
             <xapl:value-of select="$currentTablesOptionData/SERVICE[@Name = $this/SERVICE[1]/@Value]/TABLE[@Name = $this/TABLE_NAME[1]/@Value]/OPTION_TYPES"/>
	     </xapl:print>
             <xapl:choose>
                <xapl:when test = "$ShowAllPropsInAdvancedFilter='Yes' or $ShowAllPropsInAdvancedFilter='YES' ">
                <xapl:set-variable name="filter_details">
                     <FILTER_COLUMNS TableEditor="yes" TableDisplayName="{$currentDbTable/TABLE_NAME/@DisplayName}" TableName="{$this/TABLE_NAME/@Value}">
                        <xapl:value-of select="$currentDbTable/TABLE_NAME/COLUMNS/*[. /PRESENTATION/HIDDEN/@Value != 'yes' and ./@Name!='ENTITY_STATE' and ./@Name!='SCENARIO_ID']"/>
                     </FILTER_COLUMNS>
                 </xapl:set-variable>
                </xapl:when>                 
                <xapl:otherwise>
                <xapl:set-variable name="filter_details">
                     <FILTER_COLUMNS TableEditor="yes" TableDisplayName="{$currentDbTable/TABLE_NAME/@DisplayName}" TableName="{$this/TABLE_NAME/@Value}">
                        <xapl:value-of select="$currentDbTable/TABLE_NAME/COLUMNS/*[. /PRESENTATION/SEARCHABLE/@Value = 'yes'  and ./@Name!='ENTITY_STATE' and ./@Name!='SCENARIO_ID' ]"/>
                      </FILTER_COLUMNS>
                 </xapl:set-variable>
                </xapl:otherwise>
             </xapl:choose>
             <xapl:for-each varName="optionProp" select="{$currentTablesOptionData/SERVICE[@Name = $this/SERVICE[1]/@Value]/TABLE[@Name = $this/TABLE_NAME[1]/@Value]/OPTION_TYPES/*}">
             	<xapl:print>option prop-TableEditor
             		<xapl:value-of select="$optionProp"/>
             	</xapl:print>
             <docutil:add select="$filter_details/PROPERTY[@Name =$optionProp/@Name]">
		<OPTIONS>
			<xapl:value-of select="$optionProp/*"/>
		</OPTIONS>
             </docutil:add>
             </xapl:for-each>
       </xapl:otherwise>
     </xapl:choose>
    <xapl:return>
       <xapl:value-of select="$filter_details"/> 
      <!-- Page Header-->
      <x2:execute command="bcm.framework.filter.FilterView:getHeader">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>

     <!-- Top Level Container -->
        <x2:execute command="bcm.framework.filter.FilterView:getContainer">
          <x2:with-param name="this" select="$this"/>
          <x2:with-param name="pPage" select="'filter'"/>
        </x2:execute>


     <xapl:value-of select="$this/*"/>
      <!-- return the filter xml for creating javascript  arrays -->
      <xapl:value-of select="$filterXml"/>
    </xapl:return>
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    <xapl:return>
     <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <xapl:return>
      <CONTAINER Scrollable="yes">
        <HELP Url="../../help/filter_expression_help.htm"/>
         <STEP Name="FilterTable" DisplayText="{$this/TABLE_NAME/@Value}" Selected="true">
          <BUTTONS>
              <BUTTON Id="cancel_button" Name="Cancel" DisplayText="Cancel" OnClick="javascript:back()"/>
              <DIVIDER/>
                <BUTTON Id="apply_button" Name="Apply" DisplayText="Apply And Return" OnClick="javascript:onApplyAndReturn()"/>
          </BUTTONS>
       </STEP>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  <!-- ******************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getOptionTypes">
      <x2:param name="tablename"/>
      <x2:param name="this" select="$this"/>
      <xapl:print select="$tablename"/>
      <xapl:variable name="request"/>
      <xapl:set-variable name="request" select="{concat('//' , $this/SERVICE[1]/@Value, '/getValidValues')}"/>
      <xapl:print select="$request"/>
      <xapl:print select="$this"/>
      <xapl:print select="$this/SERVICE[1]/@Value"/>
      <!-- init forms data -->
      <xapl:if test="count($currentTablesOptionData/*) = 0">
        <xapl:set-variable name="currentTablesOptionData">
          <TABLES_DATA>
            <SERVICE Name="{$this/SERVICE[1]/@Value}"/>
          </TABLES_DATA>
        </xapl:set-variable>
      </xapl:if>
      <xapl:if test="count($currentTablesOptionData/SERVICE[@Name = $this/SERVICE[1]/@Value]/TABLE[@Name = $tablename]/OPTION_TYPES/*) = 0 ">
        <docutil:add select="$currentTablesOptionData/SERVICE[@Name = $this/SERVICE[1]/@Value]">
          <TABLE Name="{$tablename}">
            <OPTION_TYPES>
              <xcore:execute-method name="{$request}" entireResponse="false">
                <DOCUMENT Name="{$tablename}" ServiceName="{$this/SERVICE[1]/@Value}"/>
              </xcore:execute-method>
            </OPTION_TYPES>
          </TABLE>
        </docutil:add>
       </xapl:if>
       <xapl:print>
       	   **Return value from getOptiontypes******<xapl:value-of select="$currentTablesOptionData/SERVICE[@Name = $this/SERVICE[1]/@Value]/TABLE[@Name = $tablename]/OPTION_TYPES/*"/>
        </xapl:print>
      <xapl:return>
        <xapl:value-of select="$currentTablesOptionData/SERVICE[@Name = $this/SERVICE[1]/@Value]/TABLE[@Name = $tablename]/OPTION_TYPES/*"/>
      </xapl:return>
  </x2:command>
  <!-- ******************************************************************
  *********************************************************************** -->
</x2:commands>
