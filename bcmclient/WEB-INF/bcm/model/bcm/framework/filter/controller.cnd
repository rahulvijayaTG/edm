<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:identity="http://www.i2.com/identity" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" description="_">
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="init">
    <xapl:variable name="filterXml" resolver="session" global="true"/>
    <xapl:variable name="saved_filters" resolver="session" global="true"/>
  </x2:command>
  <!-- **********************************************************************
       *********************************************************************** -->
   <x2:command name="display" public="yes">

     <xapl:print select="$this"/>
       <xapl:choose>
           <xapl:when test="count($this/PAGE) = 1  and string-length($this/PAGE/@Value) > 0">
             <docutil:set select="$this">
                <FROM_PAGE_FORM_NAME Value="{$this/FORM_NAME/@Value}"/>
                <!--FORM_NAME Value="FILTERS_FORM"/-->
             </docutil:set>
           </xapl:when>
           <xapl:otherwise>
           </xapl:otherwise>
     </xapl:choose>

     <docutil:remove select="$this/SORT_BY"/>
     <docutil:remove select="$this/SORT_ORDER"/>

     <xapl:choose>
       <xapl:when test="string-length($this/FILTER_TEXT/@Value) > 0 ">
          <web:display-page>
            <web:get-page name="filter">
            <xapl:value-of select="$this/FILE"/>
            <xapl:value-of select="$this/DIRECTORY"/>            
                    <xapl:value-of select="$this/FROM_PAGE_FORM_NAME"/>
                    <xapl:value-of select="$this/FORM_NAME"/>
                    <xapl:value-of select="$this/SERVICE"/>
                    <xapl:if test="$this/PAGE">
                        <xapl:value-of select="$this/PAGE"/>
                    </xapl:if> 
                    <xapl:if test="$this/TABLE_NAME">
                        <xapl:value-of select="$this/TABLE_NAME"/>
                    </xapl:if>                   
                    <xapl:value-of select="$this/FILTER_TEXT"/>
                    <xapl:value-of select="$this/FORM_NAME"/>
                    <xapl:value-of select="$this/FILTER_SCOPE"/>
                    <xapl:value-of select="$this/FILTER_ID"/>
                    <xapl:value-of select="$this/FILTER_MODE"/>
                    <xapl:value-of select="$this/FILTER_NAME"/>
                    <xapl:value-of select="$this/SELECTED_AUTH_SCOPE"/>                  
                    <xapl:value-of select="$this/SHOW_ALL_FIELDS"/>                  
            </web:get-page>
          </web:display-page>
       </xapl:when>
       <xapl:otherwise>
         <docutil:set select="$this">
            <START_COUNT Value="0"/>
            <MAX_ROWS Value="10"/>
            <INIT Value="YES"/>
         </docutil:set>
          <xapl:set-variable name="saved_filters">
               <x2:execute command="bcm.framework.filter.controller:getFilters">
                  <x2:with-param name="this" select="{$this}"/>
              </x2:execute>
            </xapl:set-variable>
            <xapl:print select="$saved_filters"/>
           <xapl:print select="count($saved_filters/*) "/>
             <xapl:choose>
                 <xapl:when test=" count($saved_filters/SEARCH_FILTER) > 0 ">
                <web:display-page>
                  <web:get-page name="saved_filters">
                        <xapl:value-of select="$this/FILE"/>
                        <xapl:value-of select="$this/DIRECTORY"/>                  
                    <xapl:value-of select="$this/FROM_PAGE_FORM_NAME"/>
                    <xapl:value-of select="$this/FORM_NAME"/>
                    <xapl:value-of select="$this/SERVICE"/>
                    <xapl:if test="$this/PAGE">
                        <xapl:value-of select="$this/PAGE"/>
                    </xapl:if>
                    <xapl:if test="$this/TABLE_NAME">
                        <xapl:value-of select="$this/TABLE_NAME"/>
                    </xapl:if>                    
                    <xapl:value-of select="$this/FILTER_TEXT"/>
                    <xapl:value-of select="$this/FILTER_SCOPE"/>
                    <xapl:value-of select="$this/FILTER_ID"/>
                    <xapl:value-of select="$this/FILTER_MODE"/>
                    <xapl:value-of select="$this/FILTER_NAME"/>
                    <xapl:value-of select="$this/SELECTED_AUTH_SCOPE"/>
                    <xapl:value-of select="$this/SHOW_ALL_FIELDS"/>                  
                  </web:get-page>
                </web:display-page>
             </xapl:when>
             <xapl:otherwise>
                <web:display-page>
                  <web:get-page name="filter">
                        <xapl:value-of select="$this/FILE"/>
                        <xapl:value-of select="$this/DIRECTORY"/>                  
                    <xapl:value-of select="$this/FROM_PAGE_FORM_NAME"/>
                    <xapl:value-of select="$this/FORM_NAME"/>
                    <xapl:value-of select="$this/SERVICE"/>
                    <xapl:if test="$this/PAGE">
                        <xapl:value-of select="$this/PAGE"/>
                    </xapl:if>
                    <xapl:if test="$this/TABLE_NAME">
                        <xapl:value-of select="$this/TABLE_NAME"/>
                    </xapl:if>                    
                    <xapl:value-of select="$this/FILTER_TEXT"/>
                    <xapl:value-of select="$this/FILTER_SCOPE"/>
                    <xapl:value-of select="$this/FILTER_ID"/>
                    <xapl:value-of select="$this/FILTER_MODE"/>
                    <xapl:value-of select="$this/FILTER_NAME"/>
                    <xapl:value-of select="$this/SELECTED_AUTH_SCOPE"/>
                    <xapl:value-of select="$this/SHOW_ALL_FIELDS"/>  
                  </web:get-page>
                </web:display-page>
             </xapl:otherwise>
           </xapl:choose>
       </xapl:otherwise>
     </xapl:choose>

  </x2:command>
   <!--  **********************************************************************
  *********************************************************************** -->
<x2:command name="displaySavedFilters" public="yes">

     <xapl:print select="$this"/>

      <xapl:set-variable name="saved_filters">
           <x2:execute command="bcm.framework.filter.controller:getFilters">
              <x2:with-param name="this" select="{$this}"/>
          </x2:execute>
      </xapl:set-variable>

       <xapl:print select="$saved_filters"/>
       <xapl:print select="count($saved_filters/*) "/>

        <web:display-page>
          <web:get-page name="saved_filters">
                         <xapl:value-of select="$this/FILE"/>
                        <xapl:value-of select="$this/DIRECTORY"/>         
                    <xapl:value-of select="$this/FROM_PAGE_FORM_NAME"/>
                    <xapl:value-of select="$this/FORM_NAME"/>
                    <xapl:value-of select="$this/SERVICE"/>
                    <xapl:if test="$this/PAGE">
                        <xapl:value-of select="$this/PAGE"/>
                    </xapl:if>
                    <xapl:if test="$this/TABLE_NAME">
                        <xapl:value-of select="$this/TABLE_NAME"/>
                    </xapl:if>                    
                    <xapl:value-of select="$this/FILTER_TEXT"/>
                    <xapl:value-of select="$this/FORM_NAME"/>
                    <xapl:value-of select="$this/FILTER_SCOPE"/>
                    <xapl:value-of select="$this/FILTER_ID"/>
                    <xapl:value-of select="$this/FILTER_MODE"/>
                    <xapl:value-of select="$this/FILTER_NAME"/>
                    <xapl:value-of select="$this/SELECTED_AUTH_SCOPE"/> 
          </web:get-page>
        </web:display-page>

  </x2:command>
   <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command name="getFilters" public="yes">


    <xapl:print>
       GET  FILTERS
       <xapl:value-of select="$this"/>
    </xapl:print>

   <xapl:variable name="request" select="concat('//', $this/SERVICE/@Value, '/getFilters')"/>

    <xapl:variable name="docName">
      <xapl:choose>
        <xapl:when test="count($this/PAGE) = 1  and string-length($this/PAGE/@Value) > 0"><xapl:value-of select="$this/FROM_PAGE_FORM_NAME/@Value"/></xapl:when>
        <xapl:otherwise><xapl:value-of select="$this/TABLE_NAME/@Value"/></xapl:otherwise>
      </xapl:choose>
    </xapl:variable>

    <xapl:variable name="serverResponse">
       <xcore:execute-method name="{$request}" DocumentName="{$docName}"  StartAtRow="{$this/*[name() = 'START_COUNT']/@Value}" MaxRows="{$this/*[name() = 'MAX_ROWS']/@Value}" ReturnRowCount="yes"  entireResponse="true">
          <xapl:if test="{ string-length($this/*[name()  = 'F_CREATED_BY']/@Value) != 0 }">
            <xcore:search-by property="CREATED_BY" value="{$this/*[name() = 'F_CREATED_BY' ]/@Value }" matchby="STARTS_WITH"/>
          </xapl:if>
          <xapl:if test="{ string-length($this/*[name()  = 'F_NAME']/@Value) != 0 }">
            <xcore:search-by property="NAME" value="{$this/*[name() = 'F_NAME' ]/@Value }" matchby="STARTS_WITH"/>
          </xapl:if>
          <xapl:variable name="loginName">
            <identity:get-user-name/>
          </xapl:variable>
           <OWNER Value="{$loginName}"/>
           <xapl:choose>

               <xapl:when test="count($this/PAGE) = 1  and string-length($this/PAGE/@Value) > 0">
                 <x2:execute command="bcm.framework.queryform.Form:create">
                  <x2:with-param name="pFormName" select="{$this/FROM_PAGE_FORM_NAME/@Value}"/>
                  <x2:with-param name="pServiceName" select="$this/SERVICE/@Value"/>
                </x2:execute>
                <DOC_TYPE Value="FORM"/>
                <DOC_ID Value="{$currentForm/@Id}"/>
               </xapl:when>

               <xapl:otherwise>
                 <!-- create table in session with column names -->
                 <x2:execute command="bcm.framework.tableeditor.Table:create">
                   <x2:with-param name="this" select="{$this}"/>
                   <x2:with-param name="pTableName" select="{$this/TABLE_NAME/@Value}"/>
                 </x2:execute>
                <DOC_TYPE Value="DOCUMENT"/>
                <DOC_ID Value="{$this/TABLE_NAME/@Value}"/>
               </xapl:otherwise>

         </xapl:choose>
            <xapl:if test="count ($this/SORT_BY) > 0 and $this/*[name() = 'SORT_BY']/@Value = 'NAME'">
              <xapl:print>
                      INSIDE SORT :::
                      sort_by=<xapl:value-of select="$this/*[name() = 'SORT_BY']/@Value"/>
              </xapl:print>
              <ORDER_BY>
                <docutil:element name="NAME" Document="SEARCH_FILTER" Sort="{$this/*[name() = 'SORT_ORDER']/@Value}"/>
              </ORDER_BY>
            </xapl:if>
       </xcore:execute-method>
    </xapl:variable>

    <docutil:set select="$serverResponse/RESPONSE">
      <TOTAL_RECORD_COUNT Value="{$serverResponse/RESPONSE/@TotalRowCount}"/>
      <START_AT_ROW Value="{$this/START_COUNT[1]/@Value}"/>
    </docutil:set>
    <!-- TODO Do this dynamically only if timingStats are on. -->
    <docutil:remove select="$serverResponse/TIMING_STATS"/>
    <docutil:remove select="$serverResponse/RESPONSE/TIMING_STATS"/>
     <xapl:print>
       SERVER RESPONSE
       <xapl:value-of select="$serverResponse/RESPONSE"/>
    </xapl:print>

    <xapl:return>
      <xapl:value-of select="$serverResponse/RESPONSE"/>
    </xapl:return>

  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command name="applyFilter" public="yes">


    <xapl:print>
       FILTERS
       <xapl:value-of select="$this"/>
    </xapl:print>

    <xapl:set-variable name="filterXml">
       <docutil:to-xml select="$this/XML_STRING_FILTER/@Value"/>
    </xapl:set-variable>

    <docutil:remove select="$this/XML_STRING_FILTER"/>

     <xapl:print>
       XML Generated FILTERS
       <xapl:value-of select="$filterXml"/>
       <xapl:value-of select="$this/FILTER_TEXT/@Value"/>
    </xapl:print>



    <xapl:choose>
       <xapl:when test="count($this/PAGE) = 1  and string-length($this/PAGE/@Value) > 0 ">
        <docutil:set select="$currentPref/SERVICE/FORM/FILTERS">
          <xapl:value-of select="$filterXml"/>
          <xapl:if test="count($this/FILTER_TEXT) > 0 ">
            <FILTER_TEXT Value="{$this/FILTER_TEXT/@Value}"/>
          </xapl:if>
          <xapl:if test="count($this/FILTER_NAME) > 0 ">
            <FILTER_NAME Value="{$this/FILTER_NAME/@Value}"/>
          </xapl:if>
          <xapl:if test="count($this/FILTER_ID) > 0 ">
            <FILTER_ID Value="{$this/FILTER_ID/@Value}"/>
          </xapl:if>
          <xapl:if test="count($this/FILTER_MODE) > 0 ">
            <FILTER_MODE Value="{$this/FILTER_MODE/@Value}"/>
          </xapl:if>
          <START_COUNT Value="0"/>
        </docutil:set>
        
          <web:display-page>
            <web:get-page name="{$this/PAGE/@Value}">
              <FILTER_TEXT  Value="{$this/FILTER_TEXT/@Value}"/>
              <FILTER_ID  Value="{$this/FILTER_ID/@Value}"/>
              <FILTER_MODE  Value="{$this/FILTER_MODE/@Value}"/>
              <FILTER_NAME  Value="{$this/FILTER_NAME/@Value}"/>
              <USE_OLD_FILTER Value="TRUE"/>
            </web:get-page>
          </web:display-page>
       </xapl:when>
       <xapl:otherwise>
         <!-- add new expression filters applied-->
        <docutil:set select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/FILTERS">
          <xapl:value-of select="$filterXml"/>
          <xapl:if test="count($this/FILTER_TEXT) > 0 ">
            <FILTER_TEXT Value="{$this/FILTER_TEXT/@Value}"/>
          </xapl:if>
          <xapl:if test="count($this/FILTER_NAME) > 0 ">
            <FILTER_NAME Value="{$this/FILTER_NAME/@Value}"/>
          </xapl:if>
          <xapl:if test="count($this/FILTER_ID) > 0 ">
            <FILTER_ID Value="{$this/FILTER_ID/@Value}"/>
          </xapl:if>
          <xapl:if test="count($this/FILTER_MODE) > 0 ">
            <FILTER_MODE Value="{$this/FILTER_MODE/@Value}"/>
          </xapl:if>
          <START_COUNT Value="0"/>
        </docutil:set>
         <web:display-page>
          <web:get-page name="tableeditor">
            <xapl:value-of select="$this/*"/>
            <USE_OLD_FILTER Value="TRUE"/>
          </web:get-page>
        </web:display-page>
       </xapl:otherwise>
    </xapl:choose>

  </x2:command>
    <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command name="saveFilter" public="yes">


    <xapl:print>
       SAVE  FILTERS
       <xapl:value-of select="$this"/>
    </xapl:print>

   <xapl:variable name="request" select="concat('//', $this/SERVICE/@Value, '/saveFilter')"/>

    <xapl:variable name="docName">
      <xapl:choose>
        <xapl:when test="count($this/PAGE) = 1  and string-length($this/PAGE/@Value) > 0"><xapl:value-of select="$this/FORM_NAME/@Value"/></xapl:when>
        <xapl:otherwise><xapl:value-of select="$this/TABLE_NAME/@Value"/></xapl:otherwise>
      </xapl:choose>
    </xapl:variable>

    <xapl:variable name="serverResponse">
       <xcore:execute-method name="{$request}" DocumentName="{$docName}" entireResponse="true">


          <xapl:choose>
            <xapl:when test="$this/FILTER_MODE/@Value = 'EDIT' ">
                 <ID Value="{$this/FILTER_ID/@Value}"/>
              </xapl:when>
              <xapl:otherwise>
                     <xapl:variable name="loginName">
                       <identity:get-user-name/>
                     </xapl:variable>
                     <CREATED_BY Value="{$loginName}"/>
                    <xapl:choose>
                        <xapl:when test="$this/FILTER_SCOPE/@Value = 'GLOBAL'">
                           <FILTER_SCOPE Value="GLOBAL"/>
                        </xapl:when>
                        <xapl:otherwise>
                          <FILTER_SCOPE Value="LOCAL"/>
                        </xapl:otherwise>
                    </xapl:choose>
              </xapl:otherwise>
          </xapl:choose>


         <xapl:choose>
           <xapl:when test="count($this/PAGE) = 1  and string-length($this/PAGE/@Value) > 0">
             <NAME Value="{$this/FILTER_NAME/@Value}"/>
            <DOC_TYPE Value="FORM"/>
            <!-- create table in session with column names -->
            <x2:execute command="bcm.framework.queryform.Form:create">
              <x2:with-param name="pFormName" select="{$this/FORM_NAME/@Value}"/>
              <x2:with-param name="pServiceName" select="$this/SERVICE/@Value"/>
            </x2:execute>
            <DOC_ID Value="{$currentForm/@Id}"/>
            <FILTER_DETAILS>
            <xapl:if test="count($currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/FORM[@Name= $this/FORM_NAME[1]/@Value]/FILTERS/FILTER_DETAILS) > 0">
                <xapl:value-of select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/FORM[@Name= $this/FORM_NAME[1]/@Value]/FILTERS/FILTER_DETAILS/*"/>
            </xapl:if>
               <xapl:print select="count($currentForm)"/>
               <FILTERS>
                <xapl:for-each varName="column" select="$currentForm/RESULT_PROPERTIES/RESULT_PROPERTY[PRESENTATION/SEARCHABLE/@Value = 'yes']">
                    <!--xapl:variable name="filterVal1" select="$currentPref/SERVICE[@Name = $this/SERVICE/@Value]/FORM[@Name = $this/FORM_NAME/@Value]/FILTERS/*[name() =concat( 'F_' , $column/@Property)]/@Value"/-->
                    <xapl:variable name="filterVal2" select="$currentPref/SERVICE[@Name = $this/SERVICE/@Value]/FORM[@Name = $this/FORM_NAME/@Value]/FILTERS/*[name() =concat( 'F_' , $column/@Document, '.' , $column/@Property)]/@Value"/>
                  <!--xapl:if test="string-length($filterVal1) > 0 and $currentPref/SERVICE[@Name = $this/SERVICE/@Value]/FORM[@Name = $this/FORM_NAME/@Value]/FILTERS/*[name() =concat( 'F_' , $column/@Property)] ">
                    <xapl:print>
                      <xapl:value-of select="$column/@Property"/>
                      <xapl:value-of select="$filterVal1"/>
                    </xapl:print>
                    <FILTER Name="{$column/@Property}" Document="{$column/@Document}">
                      <docutil:element name="{$column/@Property}" Value="{$filterVal1}"/>
                    </FILTER>
                  </xapl:if-->
                  <xapl:if test="string-length($filterVal2) > 0 and $currentPref/SERVICE[@Name = $this/SERVICE/@Value]/FORM[@Name = $this/FORM_NAME/@Value]/FILTERS/*[name() =concat( 'F_' , $column/@Document, '.' , $column/@Property)] ">
                    <xapl:print>
                      <xapl:value-of select="$column/@Property"/>
                      <xapl:value-of select="$filterVal2"/>
                    </xapl:print>
                    <FILTER Name="{$column/@Property}" Document="{$column/@Document}">
                      <docutil:element name="{$column/@Property}" Value="{$filterVal2}"/>
                    </FILTER>
                  </xapl:if>
                </xapl:for-each>
              </FILTERS>
             </FILTER_DETAILS>
           </xapl:when>

           <xapl:otherwise>
             <NAME Value="{$this/FILTER_NAME/@Value}"/>
            <DOC_TYPE Value="DOCUMENT"/>
            <DOC_ID Value="{$this/TABLE_NAME/@Value}"/>
              <FILTER_DETAILS>
                <xapl:if test="count($currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/FILTERS/FILTER_DETAILS) > 0">
                    <xapl:value-of select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/FILTERS/FILTER_DETAILS/*"/>
                </xapl:if>
               <docutil:remove select="$currentPref/SERVICE[@Name = $this/SERVICE/@Value]/TABLE[@Name = $this/TABLE_NAME/@Value]/FILTERS/*[string-length(@Value) = 0 ]"/>
               <xapl:print select="$currentPref/SERVICE[@Name = $this/SERVICE/@Value]/TABLE[@Name = $this/TABLE_NAME/@Value]/FILTERS"/>
               <xapl:print select="count($currentDbTable/TABLE_NAME/COLUMNS/PROPERTY)"/>
               <FILTERS>
                <xapl:for-each varName="column" select="$currentDbTable/TABLE_NAME/COLUMNS/PROPERTY[PRESENTATION/SEARCHABLE/@Value = 'yes']">
                  <xapl:variable name="filterVal" select="$currentPref/SERVICE[@Name = $this/SERVICE/@Value]/TABLE[@Name = $this/TABLE_NAME/@Value]/FILTERS/*[name() =concat( 'F_' , $column/@Name)]/@Value"/>
                  <xapl:if test="$currentPref/SERVICE[@Name = $this/SERVICE/@Value]/TABLE[@Name = $this/TABLE_NAME/@Value]/FILTERS/*[name() =concat( 'F_' , $column/@Name)] ">
                    <xapl:print>
                      <xapl:value-of select="$column/@Name"/>
                      <xapl:value-of select="$filterVal"/>
                    </xapl:print>
                    <FILTER Name="{$column/@Name}">
                      <docutil:element name="{$column/@Name}" Value="{$filterVal}"/>
                    </FILTER>
                  </xapl:if>
                </xapl:for-each>
              </FILTERS>
             </FILTER_DETAILS>
           </xapl:otherwise>

         </xapl:choose>
       </xcore:execute-method>
    </xapl:variable>

     <xapl:print>
       SERVER RESPONSE
       <xapl:value-of select="$serverResponse/RESPONSE"/>
    </xapl:print>
    <!-- take the user to saved filters pages -->
    <docutil:remove select="$this/FILTER_TEXT"/>

       <xapl:choose>
           <xapl:when test="count($this/PAGE) = 1  and string-length($this/PAGE/@Value) > 0">
             <docutil:set select="$this">
                <FROM_PAGE_FORM_NAME Value="{$this/FORM_NAME/@Value}"/>
                <FORM_NAME Value="FILTERS_FORM"/>
             </docutil:set>
           </xapl:when>
           <xapl:otherwise>
           </xapl:otherwise>
     </xapl:choose>

     <docutil:remove select="$this/SORT_BY"/>
     <docutil:remove select="$this/SORT_ORDER"/>

    <x2:execute command="bcm.framework.filter.controller:displaySavedFilters">
      <x2:with-param name="this" select="{$this}"/>
    </x2:execute>

  </x2:command>
  <!-- **********************************************************************
       *********************************************************************** -->
   <x2:command name="editFilter" public="yes">

     <xapl:print select="$this"/>

     <docutil:set select="$this">
          <FILTER_NAME Value="{$saved_filters/SEARCH_FILTER[ID/@Value = $this/FILTER_ID/@Value] /NAME/@Value}"/>
          <FILTER_MODE Value="EDIT"/>
        </docutil:set>

     <xapl:print select="$saved_filters/SEARCH_FILTER[ID/@Value = $this/FILTER_ID/@Value] /FILTER_DETAILS"/>

       <xapl:if test="string-length($this/FILTER_ID/@Value) > 0 ">
         <xapl:set-variable name="filterXml" select="$saved_filters/SEARCH_FILTER[ID/@Value = $this/FILTER_ID/@Value] /FILTER_DETAILS"/>
         <xapl:print select="'GOT ID'"/>
       </xapl:if>

      <xapl:print select="$filterXml"/>


      <web:display-page>
        <web:get-page name="filter">
          <xapl:value-of select="{$this/*}"/>
        </web:get-page>
      </web:display-page>



  </x2:command>
   <!-- **********************************************************************
       *********************************************************************** -->
   <x2:command name="createFilter" public="yes">

     <xapl:print select="$this"/>

       <docutil:set select="$this">
          <FILTER_MODE Value="CREATE"/>
        </docutil:set>

     <xapl:set-variable name="filterXml"/>

      <xapl:print select="$filterXml"/>




      <web:display-page>
        <web:get-page name="filter">
          <xapl:value-of select="{$this/*}"/>
        </web:get-page>
      </web:display-page>



  </x2:command>
   <!-- **********************************************************************
       *********************************************************************** -->
   <x2:command name="applyAndReturnFilter" public="yes">

     <xapl:print select="$this"/>

       <xapl:if test="string-length($this/FILTER_ID/@Value) > 0 ">
         <xapl:set-variable name="filterXml" select="$saved_filters/SEARCH_FILTER[ID/@Value = $this/FILTER_ID/@Value] /FILTER_DETAILS"/>
       </xapl:if>

       <xapl:print select="$filterXml"/>

     <xapl:variable name="displayText"></xapl:variable>

        <xapl:for-each varName="step" select="$filterXml/DISPLAY/STEP">
          <xapl:choose>
           <xapl:when test="contains($step/@Value , '^lt;' )">
              <xapl:set-variable name="displayText"  select="concat($displayText , substring-before($step/@Value, '^lt;')  , '&lt;' , substring-after($step/@Value, '^lt;'  ) , ' ') "/>
           </xapl:when>
           <xapl:otherwise>
             <xapl:set-variable name="displayText"  select="concat($displayText , $step/@Value , ' ' )"/>
           </xapl:otherwise>
         </xapl:choose>
        </xapl:for-each>

       <docutil:set select="$this">
          <FILTER_TEXT Value="{$displayText}"/>
          <FILTER_NAME Value="{$saved_filters/SEARCH_FILTER[ID/@Value = $this/FILTER_ID/@Value] /NAME/@Value}"/>
          <FILTER_MODE Value="EDIT"/>
        </docutil:set>

      <xapl:print select="$this"/>

   <docutil:remove select="$this/SORT_BY"/>
   <docutil:remove select="$this/SORT_ORDER"/>

    <xapl:choose>
       <xapl:when test="count($this/PAGE) = 1  and string-length($this/PAGE/@Value) > 0 ">
          <xapl:variable name="entered_filters">
           <ENTERED_FILTERS>
            <xapl:for-each varName="filter" select="$filterXml/FILTERS/FILTER">
               <xapl:print select="$filter"/>
               <xapl:print select="$filter/@Name"/>
               <xapl:print select="$filter/@Document"/>
               <xapl:print select="$filter/*"/>
              <docutil:element name="{concat('F_' , $filter/@Document, '.' , $filter/@Name)}"   Value="{$filter/*[name() =$filter/@Name]/@Value }"/>
              <!--docutil:element name="{concat('F_' , $filter/@Name)}"   Value="{$filter/*[name() =$filter/@Name]/@Value }"/-->
            </xapl:for-each>
            </ENTERED_FILTERS>
          </xapl:variable>
          
        <docutil:set select="$currentPref/SERVICE/FORM/FILTERS">
          <xapl:value-of select="$filterXml"/>
          <xapl:if test="count($this/FILTER_TEXT) > 0 ">
            <FILTER_TEXT Value="{$this/FILTER_TEXT/@Value}"/>
          </xapl:if>
          <xapl:if test="count($this/FILTER_NAME) > 0 ">
            <FILTER_NAME Value="{$this/FILTER_NAME/@Value}"/>
          </xapl:if>
          <xapl:if test="count($this/FILTER_ID) > 0 ">
            <FILTER_ID Value="{$this/FILTER_ID/@Value}"/>
          </xapl:if>
          <xapl:if test="count($this/FILTER_MODE) > 0 ">
            <FILTER_MODE Value="{$this/FILTER_MODE/@Value}"/>
          </xapl:if>
          <START_COUNT Value="0"/>
        </docutil:set> 
        
          <docutil:remove select="$filterXml/FILTERS"/>
          <web:display-page>
            <web:get-page name="{$this/PAGE/@Value}">
              <FILTER_TEXT  Value="{$this/FILTER_TEXT/@Value}"/>
              <FILTER_ID  Value="{$this/FILTER_ID/@Value}"/>
              <FILTER_MODE  Value="{$this/FILTER_MODE/@Value}"/>
              <FILTER_NAME  Value="{$this/FILTER_NAME/@Value}"/>
              <xapl:value-of select="$entered_filters/*"/>
            </web:get-page>
          </web:display-page>
       </xapl:when>
       <xapl:otherwise>
          <docutil:set select="$this">
            <xapl:for-each varName="filter" select="$filterXml/FILTERS/FILTER">
               <xapl:print select="$filter"/>
               <xapl:print select="$filter/@Name"/>
               <xapl:print select="$filter/*"/>
              <docutil:element name="{concat('F_' , $filter/@Name)}"   Value="{$filter/*[name() =$filter/@Name]/@Value }"/>
            </xapl:for-each>
          </docutil:set>
         <!-- add new expression filters applied-->
        <docutil:set select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/FILTERS">
          <xapl:value-of select="$filterXml"/>
          <xapl:if test="count($this/FILTER_TEXT) > 0 ">
            <FILTER_TEXT Value="{$this/FILTER_TEXT/@Value}"/>
          </xapl:if>
          <xapl:if test="count($this/FILTER_NAME) > 0 ">
            <FILTER_NAME Value="{$this/FILTER_NAME/@Value}"/>
          </xapl:if>
          <xapl:if test="count($this/FILTER_ID) > 0 ">
            <FILTER_ID Value="{$this/FILTER_ID/@Value}"/>
          </xapl:if>
          <xapl:if test="count($this/FILTER_MODE) > 0 ">
            <FILTER_MODE Value="{$this/FILTER_MODE/@Value}"/>
          </xapl:if>
          <START_COUNT Value="0"/>
        </docutil:set>
          <docutil:remove select="$filterXml/FILTERS"/>
        <web:display-page>
          <web:get-page name="tableeditor">
            <xapl:value-of select="$this/*"/>
            <USE_OLD_FILTER Value="TRUE"/>
          </web:get-page>
        </web:display-page>
       </xapl:otherwise>
    </xapl:choose>


  </x2:command>
   <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command name="removeFilter" public="yes">


    <xapl:print>
       REMOVE  FILTERS
       <xapl:value-of select="$this"/>
    </xapl:print>

   <xapl:variable name="request" select="concat('//', $this/SERVICE/@Value, '/removeFilters')"/>

    <xapl:variable name="docName">
      <xapl:choose>
        <xapl:when test="count($this/PAGE) = 1  and string-length($this/PAGE/@Value) > 0"><xapl:value-of select="$this/FORM_NAME/@Value"/></xapl:when>
        <xapl:otherwise><xapl:value-of select="$this/TABLE_NAME/@Value"/></xapl:otherwise>
      </xapl:choose>
    </xapl:variable>

    <xapl:variable name="serverResponse">
       <xcore:execute-method name="{$request}" DocumentName="{$docName}" entireResponse="true">
         <OR>
                 <ID Value="{$this/FILTER_ID/@Value}"/>
         </OR>
       </xcore:execute-method>
    </xapl:variable>

     <xapl:print>
       SERVER RESPONSE
       <xapl:value-of select="$serverResponse/RESPONSE"/>
    </xapl:print>

    <x2:execute command="bcm.framework.filter.controller:displaySavedFilters">
      <x2:with-param name="this" select="{$this}"/>
    </x2:execute>

  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command name="clearFilter" public="yes">


    <xapl:print>
           THIS
       <xapl:value-of select="$this"/>
    </xapl:print>

    <xapl:set-variable name="filterXml"/>

     <xapl:print>
      FILTERS
       <xapl:value-of select="$filterXml"/>
    </xapl:print>

    <xapl:choose>
       <xapl:when test="count($this/PAGE) = 1  and string-length($this/PAGE/@Value) > 0 ">
           <!-- clean the sessional $currentPref filter -->
           <docutil:remove select="$currentPref/SERVICE[@Name = $this/SERVICE[1]/@Value]/FORM[@Name = $this/FORM_NAME[1]/@Value]/FILTERS/*"/>
          <docutil:remove select="$currentPref/SERVICE[@Name = $this/SERVICE[1]/@Value]/FORM[@Name = $this/FORM_NAME[1]/@Value]/ORDER_BY"/> 
          <web:display-page>
            <web:get-page name="{$this/PAGE/@Value}">
            </web:get-page>
          </web:display-page>
       </xapl:when>
       <xapl:otherwise>
        <!-- clean the sessional $currentPref filter -->
        <docutil:remove select="$currentPref/SERVICE[@Name = $this/SERVICE[1]/@Value]/TABLE[@Name = $this/TABLE_NAME[1]/@Value]/FILTERS/*"/>
         <docutil:set select="$this">
           <DO_SEARCH Value="No"/>
         </docutil:set>
         <web:display-page>
          <web:get-page name="tableeditor">
            <xapl:value-of select="$this/*"/>
          </web:get-page>
        </web:display-page>
       </xapl:otherwise>
    </xapl:choose>

  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->

  <x2:command name="cancel" public="yes">


    <xapl:print>
           THIS
       <xapl:value-of select="$this"/>
    </xapl:print>

    <xapl:set-variable name="filterXml"/>

     <xapl:print>
      FILTERS
       <xapl:value-of select="$filterXml"/>
    </xapl:print>
    <docutil:remove select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/FILTERS"/>

    <xapl:choose>
       <xapl:when test="count($this/PAGE) = 1  and string-length($this/PAGE/@Value) > 0 ">
          <web:display-page>
            <web:get-page name="{$this/PAGE/@Value}">
              <USE_OLD_FILTER Value="TRUE"/>
            </web:get-page>
          </web:display-page>
       </xapl:when>
       <xapl:otherwise>
        <web:display-page>
          <web:get-page name="tableeditor">
            <xapl:value-of select="$this/*"/>
            <USE_OLD_FILTER Value="TRUE"/>
          </web:get-page>
        </web:display-page>
       </xapl:otherwise>
    </xapl:choose>

  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
</x2:commands>
