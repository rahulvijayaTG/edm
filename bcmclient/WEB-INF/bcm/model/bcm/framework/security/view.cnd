<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">


    <!-- **********************************************************************
    *********************************************************************** -->
    <x2:command public="yes" description="_" name="load">
      <xapl:return>

		  <!-- Header call before getting security data -->
		        <x2:execute command="bcm.framework.security.view:getHeader">
		        	<x2:with-param name="this" select="{$this}"/>
		        </x2:execute>


		<!-- sets the session variable thr' getAuthorizingDocumets -->
		<x2:execute command="bcm.framework.security.controller:setInputAuthDetails">
			<x2:with-param name="this" select="$this"/>
		</x2:execute>

		<xapl:if test="string-length($this/MODE/@Value) &gt; 0 and $fromLogin='yes'">
			<xapl:print>
			***********************   **********
			</xapl:print>

			<docutil:remove select="$this/MODE"/>
			<x2:execute command="bcm.framework.security.controller:initializeSelectedAuthDetails">
				<x2:with-param name="this" select="$this"/>
			</x2:execute>

		</xapl:if>

		<xapl:print>
		*********************** B4 calling updateSelectedAuthDetailsInSession in LOAD**********
		</xapl:print>

		<x2:execute command="bcm.framework.security.controller:updateSelectedAuthDetailsInSession">
		<x2:with-param name="this" select="$this"/>
		</x2:execute>

      
        <!-- Tabs -->
        <x2:execute command="bcm.framework.security.view:getTabs">
          <x2:with-param name="pPage" select="'manage_security'"/>
          <x2:with-param name="this" select="{$this}"/>
        </x2:execute>

        <!-- Links -->
        <x2:execute command="bcm.framework.security.view:getLinks">
          <x2:with-param name="this" select="$this"/>
          <x2:with-param name="pPage" select="'manage_security'"/>
        </x2:execute>

        
        <xapl:variable name="permNonAuthMasterSecurity"/>
        <perm:is-allowed document="TASKS" action="bcmManageNonAuthMasterSecurity">
          <xapl:set-variable name="permNonAuthMasterSecurity">
              <xapl:value-of select="'yes'"/>
          </xapl:set-variable>
        </perm:is-allowed>
      
        <xapl:choose>
          <xapl:when test="$permNonAuthMasterSecurity = 'yes'">
            <xapl:value-of select="$this/*"/>
          </xapl:when>
          <xapl:otherwise>
            <xapl:variable name="AuthDocsRes">             
             <xapl:value-of select="$this/RESPONSE"/> 
            </xapl:variable>
            <xapl:variable name="AuthorizationDoc">             
             <xapl:value-of select="$this/AUTHORIZATION"/> 
            </xapl:variable>
            
            <docutil:remove select="$this/RESPONSE"/>
            <docutil:remove select="$this/AUTHORIZATION"/>
            <xapl:value-of select="$this/*"/>
            <RESPONSE>
              <xapl:value-of select="$AuthDocsRes/*[@Name='AuthorizationMaster']"/>
            </RESPONSE>
            <AUTHORIZATION>
              <xapl:value-of select="$AuthorizationDoc/*[@Name='AuthorizationMaster']"/>
            </AUTHORIZATION>
          </xapl:otherwise>
        </xapl:choose>
        
		<xapl:print>
		***********************$THIS in load      2222222222222 **********
		</xapl:print>
		<!--xapl:print select="$this"/-->
      </xapl:return>
    </x2:command>


    <!-- **********************************************************************
    *********************************************************************** -->

    <x2:command public="yes" description="_" name="getLinks">
      <x2:param name="this"/>
      <xapl:return>
        <LINKS>
          <x2:execute command="core.links.controller:register">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
        </LINKS>
      </xapl:return>

    </x2:command>
  <!-- **********************************************************************
       *********************************************************************** -->
    <x2:command public="yes" description="_" name="getHeader">
    
	    <docutil:add select="$this">
		<Auth_Enabled Value="false"/>
	    </docutil:add>

	    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
		  <x2:with-param name="display" select="'Security Authorization'"/>
		  <x2:with-param name="page" select="'manage_security'"/>
		  <x2:with-param name="this" select="{$this}"/>
	    </x2:execute>
	    <xapl:return>
	      <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
	    </xapl:return>    
	    
    </x2:command>
    <!-- **********************************************************************
         *********************************************************************** -->
    <x2:command public="yes" description="_" name="getTabs">

     	<!--xapl:variable name="authdoc" select="$this/RESPONSE/AUTH_DOC[1]/@Name"/-->
     	<!-- to highlight the selected Tab -->
     	<xapl:variable name="authdoc"/>

     	<xapl:choose>
     		<xapl:when test= "string-length($this/selectedDoc/@Value) &gt; 0">
     			<xapl:set-variable name="authdoc" select="{$this/selectedDoc/@Value}"/>
     		</xapl:when>
     		<xapl:otherwise>
				<xapl:if test="string-length($this/AUTHDOC/@Value) &gt; 0">
				  <xapl:set-variable name="authdoc" select="{$this/AUTHDOC/@Value}"/>
				</xapl:if>
     		</xapl:otherwise>
     	</xapl:choose>
      <xapl:variable name="permNonAuthMasterSecurity"/>
      <perm:is-allowed document="TASKS" action="bcmManageNonAuthMasterSecurity">
          <xapl:set-variable name="permNonAuthMasterSecurity">
              <xapl:value-of select="'yes'"/>
          </xapl:set-variable>
      </perm:is-allowed>

      <xapl:return>
        <CONTAINER Scrollable="no">
          <HELP Url="../../help/security_authorization_help.htm"/>
			<xapl:variable name = "dbName"/>
			<xapl:variable name = "dispName"/>
			<xapl:for-each select = "$this/RESPONSE/*" varName="child">				
        <xapl:set-variable name = "dbName">
					<xapl:value-of select="$child/@Name"/>
				</xapl:set-variable>
				<xapl:set-variable name = "dispName">
					<xapl:value-of select="$child/@DisplayName"/>
				</xapl:set-variable>
        <xapl:if test="$dbName = 'AuthorizationMaster' or $permNonAuthMasterSecurity = 'yes'">
				<xapl:if test="count($child/AUTH_ID) > 1">					
          <xapl:if test="string-length($authdoc) = 0">
						<xapl:set-variable name="firstAuthDoc">
							<xapl:value-of select="$dbName"/>
						</xapl:set-variable>
						<xapl:set-variable name = "authdoc">
							<xapl:value-of select="$dbName"/>
						</xapl:set-variable>
					</xapl:if>
          <STEP DisplayText="{$dispName}" OnClick="{concat($pages:auth_id_display, '?' , 'AUTHDOC=',$dbName)}" Selected="{$authdoc = $dbName}"/>				
         </xapl:if>
       </xapl:if>                     
			</xapl:for-each>

        <BUTTONS>
          <!-- <xapl:if test="$fromLogin!='yes'">
          	<BUTTON Id="cancel" Name="cancel" DisplayText="Cancel" OnClick="javascript:dispatchCancel()" DisableOnClick="true"/>
		  </xapl:if> -->
          <BUTTON Id="save" Name="save" DisplayText="Save" OnClick="javascript:dispatchSave()" DisableOnClick="true"/>
        </BUTTONS>
        </CONTAINER>
		<docutil:set select="$this">
			<FIRST_AUTHDOC Value="{$firstAuthDoc}"/>
		</docutil:set>
     		<xapl:print select="$this"/>
      </xapl:return>
    </x2:command>
    <!-- **********************************************************************
      *********************************************************************** -->
</x2:commands>