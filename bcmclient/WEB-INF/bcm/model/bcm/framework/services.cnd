<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" description="_">
  <x2:command name="defineServices" public="yes" description="_">
    <!-- bcm services -->
    <xcore:define-service name="BCMINService" service="BCM_INPUT_STAGING"/>
    <xcore:define-service name="DataProfiling" service="DATA_PROFILING"/>
    <xcore:define-service name="BCMNCService" service="BCM_NET_CHANGE"/>
    <xcore:define-service name="BCMMasterService" service="BCM_MASTER"/>
    <xcore:define-service name="BCMOutboundService" service="BCM_OUTPUT_STAGING"/>
    <xcore:define-service name="UserSecurity" service="USER_SECURITY"/>
    <xcore:define-service name="MessagingService" service="MESSAGING"/>
    <!--xcore:define-service name="dataValidationService" service="DATA_VALIDATION"/-->
    <xcore:define-service name="E2EService" service="E2E"/>
    <xcore:define-service name="ADWService" service="ADW"/>
    <xcore:define-service name="UIWorkflowService" service="UI_WORKFLOW"/>
  </x2:command>
</x2:commands>
