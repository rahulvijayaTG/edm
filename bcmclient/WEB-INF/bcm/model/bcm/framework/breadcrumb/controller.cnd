<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:bcm="http://www.i2.com/bcm" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:authorization="http://www.i2.com/authorization" xmlns:perm="http://www.i2.com/permissibility" xmlns:identity="http://www.i2.com/identity" xmlns:i18n="http://www.i2.com/i18n" description="_">
    <!-- **********************************************************************
  *********************************************************************** -->
    <x2:command name="init" public="yes" description="_">
        <xapl:variable name="header" resolver="session" global="true"/>
        <xapl:variable name="seq" resolver="session" global="true"/>
        <xapl:variable name="scmContext" resolver="session" global="true"/>
    </x2:command>
    <!-- **********************************************************************
  *********************************************************************** -->
    <x2:command public="yes" description="_" name="initHeader">
        <xapl:set-variable name="header">
            <HEADER>
                <APP_NAME Value="MDM"/>
                <TOGGLE_NAV Value="../"/>
                <HOME Value="bcm/framework/home.jsp"/>
                <BREADCRUMBS/>
            </HEADER>
        </xapl:set-variable>
        <xapl:set-variable name="seq" select="{number(0)}"/>
        <!--    <xapl:print>
        initHeader:::
        <xapl:value-of select="$header"/>
        <xapl:value-of select="$seq"/>
    </xapl:print>-->
    </x2:command>
    <!-- **********************************************************************
  *********************************************************************** -->
    <x2:command public="yes" description="_" name="getBreadCrumbs">
        <!--    <xapl:print>
        RETURN  BREADCRUMBS:::
        <xapl:value-of select="$header"/>
    </xapl:print>-->
        <docutil:set select="$header">
            <xapl:value-of select="$scmContext"/>
        </docutil:set>
        <xapl:return>
            <xapl:value-of select="$header"/>
        </xapl:return>
    </x2:command>
    <!-- **********************************************************************
  *********************************************************************** -->
    <x2:command public="yes" description="_" name="addBreadCrumbs">
        <x2:param name="display"/>
        <x2:param name="page"/>
        <x2:param name="this"/>
        <!--    <xapl:print>
        ADDING TO BREADCRUMBS:::
        $display=<xapl:value-of select="$display"/>
        $page=<xapl:value-of select="$page"/>
        $seq=<xapl:value-of select="$seq"/>
    </xapl:print>-->

    
        <xapl:if test="not($header)">
            <x2:execute command="bcm.framework.breadcrumb.controller:initHeader"/>
        </xapl:if>
        <xapl:if test="string-length($display) > 0 and string-length($page) > 0">
            <xapl:variable name="url">
                <web:get-page name="{$page}">
                    <xapl:value-of select="$this/*"/>
                </web:get-page>
            </xapl:variable>
            <!--   <xapl:print>
       URL:::: <xapl:value-of select="$url"/>
   </xapl:print>-->
            <xapl:choose>
                <xapl:when test="$header/BREADCRUMBS/*/DISPLAY_TEXT/@Value = $display">
                    <xapl:variable name="selectedIndex" select="$header/BREADCRUMBS/*[DISPLAY_TEXT/@Value = $display]/@Index"/>
                    <!--             <xapl:print>
                CLICK ON BREADCRUMB = TRUE
                BEFORE  ERASING BREADCRUMBS ::
                selectedIndex=<xapl:value-of select="$selectedIndex"/>
                $header=<xapl:value-of select="$header"/>
                seq= <xapl:value-of select="$seq"/>
             </xapl:print>-->
                    <!-- remove the  breadcrumb after this index-->
                    <docutil:remove select="$header/BREADCRUMBS/BREADCRUMB[@Index > $selectedIndex] "/>
                    <!-- reset the  seqence -->
                    <xapl:set-variable name="seq" select="$selectedIndex"/>
                    <!-- override this current breadcrumb-->
                    <docutil:set select="$header/BREADCRUMBS/BREADCRUMB[@Index = $selectedIndex]">
                        <URL Value="{$url}"/>
                    </docutil:set>
                    <!--            <xapl:print>
                AFTER ERASING BREADCRUMBS ::
                <xapl:value-of select="$header"/>
                <xapl:value-of select="$seq"/>
            </xapl:print>-->
                </xapl:when>
                <xapl:otherwise>
                    <xapl:set-variable name="seq" select="{number($seq + 1)}"/>
                    <docutil:add select="$header/BREADCRUMBS">
                        <BREADCRUMB Index="{$seq}">
                            <DISPLAY_TEXT Value="{$display}"/>
                            <URL Value="{$url}"/>
                            <POSITION Value="{$seq}"/>
                            <PAGE Value="{$page}"/>
                        </BREADCRUMB>
                    </docutil:add>
                    <!--            <xapl:print>
                AFTER ADDING BREADCRUMBS ::
                <xapl:value-of select="$header"/>
                <xapl:value-of select="$seq"/>
            </xapl:print>-->
                </xapl:otherwise>
            </xapl:choose>
        </xapl:if>
        <xapl:choose>               
            <xapl:when test="$this/Auth_Enabled/@Value='false'">
                <authorization:disable-authorization-context/>
            </xapl:when>        
            <xapl:when test="$this/Auth_Enabled/@Value='true'">
                <authorization:enable-authorization-context/>
            </xapl:when>
            <xapl:when test="count($header/BREADCRUMBS/*) >= 1 ">
                <authorization:enable-authorization-context/>
            </xapl:when>       
            <xapl:otherwise>
                <authorization:disable-authorization-context/>
            </xapl:otherwise>       
        </xapl:choose>
        
    </x2:command>
    <!-- **********************************************************************
  *********************************************************************** -->
    <x2:command public="yes" description="_" name="back">
        <xapl:print>
        ALL BREADCRUMBS:::
        <xapl:value-of select="$header"/>
        </xapl:print>
        <!-- remove the last breadcrumb-->
        <docutil:remove select="$header/BREADCRUMBS/BREADCRUMB[ @Index = last()]"/>
        <!-- print  the last breadcrumb URL after removing-->
        <xapl:print>
            AFTER REMOVING:::
            <xapl:value-of select="$header"/>
        </xapl:print>
        <xapl:print>
          GOTO URL::::
          <xapl:value-of select="$header/BREADCRUMBS/BREADCRUMB[ @Index = last()]/URL/@Value"/>
        </xapl:print>
        <xapl:variable name="gotourl">
            <xapl:value-of select="$header/BREADCRUMBS/BREADCRUMB[ @Index = last()]/URL/@Value"/>
        </xapl:variable>
        <xapl:choose>
            <xapl:when test="count($header/BREADCRUMBS/BREADCRUMB) > 0">
                <web:display-page>
                    <xapl:value-of select="$header/BREADCRUMBS/BREADCRUMB[ @Index = last()]/URL/@Value"/>
                </web:display-page>
            </xapl:when>
            <xapl:otherwise>
                <xapl:variable name="absoluteurl">
                    <web:get-absolute-url path="/"/>
                </xapl:variable>
                <web:display-page>
                    <xapl:value-of select="concat($absoluteurl,$header/HOME/@Value)"/>
                </web:display-page>
            </xapl:otherwise>
        </xapl:choose>
    </x2:command>
    <!-- **********************************************************************
      *********************************************************************** -->
</x2:commands>
