<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" description="_">
  <x2:command name="addScope" description="_" public="yes">
    <x2:param name="this"/>
    <xapl:print>
    this in   Add  = <xapl:value-of select="$this"/>
    </xapl:print>
    <web:display-page>
      <web:get-page name="domainSearch">
        <xapl:value-of select="$this/*"/>
        <!--
        <docName Value="{$this/docName/@Value}"/>
        <ID Value="{$this/ID/@Value}"/>
        -->
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!-- **************************************************************************
************************************************************************** -->
  <x2:command name="saveScope" description="_" public="yes">
    <x2:param name="this"/>
    <xapl:print>
      this in save = <xapl:value-of select="$this"/>
    </xapl:print>
    <xapl:print select="$authDocSessVariable"/>
    <xapl:for-each select="$authDocSessVariable/AUTH_DOC[@Name = $this/docName/@Value]/AUTH_ID" varName="currentAuth">
      <xapl:variable name="dataFieldName" select="$currentAuth/*[1]/@Value"/>
      <xapl:variable name="dataValue" select="$this/*[name() = $currentAuth/*[1]/@Value]/@Value"/>
      <xapl:print select="concat('field = ', $dataFieldName, '  value = ', $dataValue)"/>
      <xapl:print select="$currentAuth/*[1]/@Action"/>
      <docutil:set select="$currentAuth/*[1]/@Action">
        <xapl:value-of select="$dataValue"/>
      </docutil:set>
      <xapl:print select="$currentAuth/*[1]/@Action"/>
    </xapl:for-each>
    <xapl:print select="$authDocSessVariable"/>
    <xapl:variable name="saveDomain">
      <xapl:value-of select="$authDocSessVariable/*"/>
    </xapl:variable>
    <xapl:print>
    saveDomain = <xapl:value-of select="$saveDomain"/>
    </xapl:print>
    <xcore:execute-method name="//UserSecurity/manageUserGroupAuthorization">
      <USER_GRP_ID Value="{$this/ID/@Value}"/>
      <xapl:value-of select="$authDocSessVariable/*"/>
    </xcore:execute-method>
    <xapl:set-variable name="authDocSessVariable"/>
    <web:display-page>
      <web:get-page name="user_admin_groups_new">
        <xapl:value-of select="$this/*"/>
        <!--<docName Value="{$this/docName/@Value}"/>
        <ID Value="{$this/ID/@Value}"/>-->
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!-- **************************************************************************
************************************************************************** -->
  <x2:command name="removeScope" description="_" public="yes">
    <x2:param name="this"/>
    <xapl:print> this in remove = <xapl:value-of select="$this"/>
    $authDocSessVariable step 1 = <xapl:value-of select="$authDocSessVariable"/>
    </xapl:print>
    <xapl:for-each select="$this/row" varName="removeSelected">
      <docutil:remove select="$authDocSessVariable/AUTH_DOC[@Name = $this/docName/@Value]/AUTH_ID[*/@Value = $removeSelected/@Value]"/>
    </xapl:for-each>
    <xapl:print>
    $authDocSessVariable step 2 = <xapl:value-of select="$authDocSessVariable"/>
    </xapl:print>
    <web:display-page>
      <web:get-page name="assignDomainHome">
        <xapl:value-of select="$this/*"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!-- **************************************************************************
************************************************************************** -->
  <x2:command name="selectDomain" description="_" public="yes">
    <x2:param name="this"/>
    <xapl:print>
  this = <xapl:value-of select="$this"/>
  authDocSessVariable step 1= <xapl:value-of select="$authDocSessVariable"/>
    </xapl:print>
    <xapl:if test="not(string-length($this/SELECTED_DOMAIN_ID/@Value) = 0)">
      <xapl:for-each select="$this/SELECTED_DOMAIN_ID" varName="selectedDomain">
        <xapl:print>Step 1</xapl:print>
        <xapl:variable name="doc" select="$this/docName/@Value"/>
        <xapl:if test="not($authDocSessVariable/AUTH_DOC[@Name = $doc]/AUTH_ID/*[@Value = $selectedDomain/@Value])">
          <xapl:print>Step 2
        Count = <xapl:value-of select="count($authDocSessVariable/AUTH_DOC[@Name = $doc])"/>
          </xapl:print>
          <xapl:choose>
            <xapl:when test="not(count($authDocSessVariable/AUTH_DOC[@Name = $doc]) = 0)">
              <xapl:print>Step 3</xapl:print>
              <docutil:add select="$authDocSessVariable/AUTH_DOC[@Name = $doc]">
                <AUTH_ID>
                  <docutil:element name="{$this/FIELDNAME/@Value}" Value="{$selectedDomain/@Value}" Action="_VIEW_ONLY_"/>
                </AUTH_ID>
              </docutil:add>
            </xapl:when>
            <xapl:otherwise>
              <xapl:print>Step 4</xapl:print>
              <docutil:add select="$authDocSessVariable">
                <AUTH_DOC Name="{$doc}">
                  <AUTH_ID>
                    <docutil:element name="{$this/FIELDNAME/@Value}" Value="{$selectedDomain/@Value}" Action="_VIEW_ONLY_"/>
                  </AUTH_ID>
                </AUTH_DOC>
              </docutil:add>
            </xapl:otherwise>
          </xapl:choose>
        </xapl:if>
      </xapl:for-each>
      <xapl:print> 
      authDocSessVariable step 2 = <xapl:value-of select="$authDocSessVariable"/>
      </xapl:print>
    </xapl:if>
    <web:display-page>
      <web:get-page name="assignDomainHome">
        <xapl:value-of select="$this/*"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <x2:command public="yes" description="_" name="cancel">
    <x2:param name="this"/>
    <xapl:print>
    this in   cancel  = <xapl:value-of select="$this"/>
    </xapl:print>
    <web:display-page>
      <web:get-page name="assignDomainHome">
        <xapl:value-of select="$this/*"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
</x2:commands>
