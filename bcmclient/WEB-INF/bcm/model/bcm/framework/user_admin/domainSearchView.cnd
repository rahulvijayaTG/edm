<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <x2:command public="yes" description="_" name="init">
    <xapl:variable name="reportFields" resolver="session" global="true"/>
    <xapl:variable name="fieldName" resolver="session" global="true"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
    <x2:param select="this"/>
    <xapl:return>
      <x2:execute command="core.search.search:getSearch">
        <x2:with-param name="this" select="$this"/>
        <x2:with-param name="pSearchParams" select="{$searchParams}"/>
        <x2:with-param name="pSearchFormConfigSource" select="bcm.framework.user_admin.domainSearchView:getSearchFormConfig'"/>
        <x2:with-param name="pSearchReportConfigSource" select="bcm.framework.user_admin.domainSearchView:getSearchReportConfig'"/>
        <x2:with-param name="pReportDataSource" select="'bcm.framework.user_admin.domainSearchView:getReportData'"/>
      </x2:execute>
    </xapl:return>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getSearchFormConfig">
    <xapl:set-variable name="fieldName">
      <xapl:value-of select="{$tabs/AUTH_DOC[@Name = $this/docName/@Value]/AUTH_ID[1]/*}"/>
    </xapl:set-variable>
    <xapl:print>
        **************** search query para is 
        <xcore:search-by property="{name($fieldName)}" value="{$this/SEARCH_PARAM/@Value}"/>
        fieldName = <xapl:value-of select="$fieldName"/>
    </xapl:print>
    <xapl:set-variable name="reportFields">
      <xcore:execute-method name="//BCMMasterService/searchByAuthorizingDocument" StartAtRow="{$this/START_COUNT/@Value}" MaxRows="{$this/MAX_ROWS/@Value}" ReturnRowCount="{$this/RETURN_ROW_COUNT/@Value}" entireResponse="true">
        <DOCUMENT_NAME Value="{$this/docName/@Value}"/>        
        <xcore:search-by property="{name($fieldName)}" value="{$this/SEARCH_PARAM/@Value}"/>
      </xcore:execute-method>
    </xapl:set-variable>
    <xapl:return>
      <!-- Search Fields -->
      <FORM Title="Search Domain" Name="search_form" Action="search.jsp" Method="GET" Target="appFrame" PagingTitle="yes">
        <!--<FIELD Type="Text" DisplayText="Name" Name="Name" Value="{$this/NAME/@Value}" Visibility="Simple"/>-->
        <FIELD Type="Hidden" Name="DATE_FORMAT" Value="{$dateFormat}" Visibility="Simple"/>
        <FIELD Type="Hidden" Name="START_COUNT" Value="{$startCount}" Visibility="Simple"/>
        <FIELD Type="Text" Name="SEARCH_PARAM" DisplayText="{$fieldName/@DisplayName}" Visibility="Simple"/>
        <FIELD Type="Hidden" Name="FIELDNAME" Value="{name($fieldName)}"/>
        <FIELD Type="Hidden" Name="ID" Value="{$this/ID/@Value}"/>
        <FIELD Type="Hidden" Name="docName" Value="{$this/docName/@Value}"/>
        <!-- Always Put hidden at the end -->
        <x2:execute command="core.report.controller:getHiddenFields">
          <x2:with-param name="this" select="$this"/>
        </x2:execute>
        <!-- Form Buttons -->
        <BUTTONS>
          <BUTTON Name="search" DisplayText="Search" OnClick="javascript:onSearch()" Emphasized="yes"/>
        </BUTTONS>
      </FORM>
    </xapl:return>
  </x2:command>
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="getSearchReportConfig">
    <xapl:return>
      <REPORT Title="Add Domain" Selectable="All" PagingTitle="yes" SelectedId="SELECTED_DOMAIN_ID" Id="{name($fieldName)}">
        <FIELDS>
          <FIELD Type="Text" Name="{name($fieldName)}" DisplayText="{$fieldName/@DisplayName}" Visibility="Simple"/>
          <x2:execute command="core.report.controller:getHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
          <FIELD Type="Hidden" Name="FIELDNAME" Value="{name($fieldName)}"/>
          <FIELD Type="Hidden" Name="ID" Value="{$this/ID/@Value}"/>
          <FIELD Type="Hidden" Name="docName" Value="{$this/docName/@Value}"/>
          <FIELD Type="Hidden" Name="tabIndex" Value="{$this/tabIndex/@Value}"/>
        </FIELDS>
        <BUTTONS>
          <BUTTON Name="SelectAndReturn" DisplayText="Select And Return" OnClick="javascript:onSelectAndReturn()" Emphasized="yes" Disabled="report"/>
          <BUTTON Name="Cancel" DisplayText="Cancel" OnClick="javascript:onCancel()"/>
        </BUTTONS>
        <PAGINATION/>
      </REPORT>
    </xapl:return>
  </x2:command>
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="getReportData">
    <x2:param name="pForm"/>
    <x2:param name="pIds"/>
    <xapl:print>
    reportFields = <xapl:value-of select="$reportFields"/>
    </xapl:print>
    <!-- Add the total record count  -->
    <docutil:add select="$reportFields/RESPONSE">
      <TOTAL_RECORD_COUNT Value="{$reportFields/RESPONSE/@TotalRowCount}"/>
      <START_AT_ROW Value="{$this/START_COUNT/@Value}"/>
    </docutil:add>
    <!-- Add the total record count  -->
    <xapl:return>
      <xapl:value-of select="$reportFields/RESPONSE"/>
    </xapl:return>
  </x2:command>
  <!--************************************************************************-->
</x2:commands>
