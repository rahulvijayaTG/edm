<?xml version="1.0" encoding="UTF-8"?>
<x2:commands description="_" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:cfg="http://www.i2.com/configurability" xmlns:core="http://www.i2.com/core" xmlns:omx="http://www.i2.com/omx" xmlns:perm="http://www.i2.com/permissibility" xmlns:util="http://www.i2.com/util" xmlns:web="http://www.i2.com/web" xmlns:x2="http://www.i2.com/x2" xmlns:xapl="http://www.i2.com/xapl" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:docutil="http://www.i2.com/docutil" xmlns:xudl="http://www.i2.com/xudl" xmlns:identity="http://www.i2.com/identity">
  <x2:command public="yes" description="_" name="getHeader">
    <x2:param name="this"/>
    <xapl:print>PRINTING THIS INSIDE OMX_USER_ADMIN_PAGES getHeader <xapl:value-of select="$this"/>
    </xapl:print>
    <xapl:return>
      <HEADER>
        <APP_NAME Value="MDM"/>
        <xapl:choose>
          <xapl:when test="$this/WHERE/@Value = 'VIEW_USERS' ">
            <TOGGLE_NAV Value="../../"/>
            <HEADING Value="User Groups"/>
            <HEADING_LINK Value="{$pages:user_admin_group_search}"/>
            <HEADING2 Value="User Group Profile"/>
            <HEADING2_LINK Value="{$pages:user_group_profile_return}"/>
            <HEADING3 Value="View User Group Users"/>
          </xapl:when>
          <xapl:when test="$this/WHERE/@Value = 'ASSIGN_USERS' ">
            <TOGGLE_NAV Value="../../"/>
            <HEADING Value="User Group"/>
            <HEADING_LINK Value="{$pages:user_admin_group_search}"/>
            <HEADING2 Value="User Group Profile"/>
            <HEADING2_LINK Value="{$pages:user_group_profile_return}"/>
            <HEADING3 Value="Assign User Group Users"/>
          </xapl:when>
          <xapl:when test="$this/WHERE/@Value = 'NEW_USERS' ">
            <TOGGLE_NAV Value="../../"/>
            <HEADING Value="User Group"/>
            <HEADING_LINK Value="{$pages:user_admin_group_search}"/>
            <HEADING2 Value="User Group Profile"/>
            <HEADING2_LINK Value="{$pages:user_group_profile_return}"/>
            <HEADING3 Value="Create New User"/>
          </xapl:when>
          <xapl:when test="$this/WHERE/@Value = 'USERS_SEARCH' ">
            <TOGGLE_NAV Value="../"/>
            <HEADING Value="Users"/>
          </xapl:when>
          <xapl:when test="$this/WHERE/@Value = 'DOMAIN_SEARCH' ">
              <TOGGLE_NAV Value="../"/>
              <HEADING Value="User Groups"/>
              <HEADING_LINK Value="{$pages:user_admin_group_search}"/>
              <HEADING2 Value="User Group Profile"/>
              <HEADING2_LINK Value="{$pages:user_group_profile_return}"/>
              <HEADING3 Value="{concat('Assign Domain : ' ,$userGroupXMLData/USER_GRP_PROFILE/GRP_NAME/@Value)}"/>
              <HOME Value="bcm/framework/home.jsp"/>
          </xapl:when>
          <xapl:otherwise>
            <TOGGLE_NAV Value="../"/>
            <HEADING Value="User Group"/>
          </xapl:otherwise>
        </xapl:choose>
        <HOME Value="bcm/framework/home.jsp"/>
      </HEADER>
    </xapl:return>
  </x2:command>
  <x2:command public="yes" description="_" name="getTabs">
    <x2:param name="pPage" select="$this/PAGE/@Value"/>
    <x2:param name="pSubPage" select="$this/SUBPAGE/@Value"/>
    <x2:param name="pRetPage" select="$this/RET_PAGE[1]/@Value"/>
    <x2:param name="pId" select="$this/USER_ID/@Value"/>
    <x2:param name="pRoleId" select="$this/ROLE_ID/@Value"/>
    <x2:param name="pViewMode" select="$this/VIEW_MODE/@Value"/>
    <x2:param name="pFromPage" select="$this/fromPage/@Value"/>
    <x2:param name="pWhere" select="$this/WHERE/@Value"/>
    <!--
    Removing 'domain' related info for bcm
    <x2:param name="pDomains" select="$this/PAGE/@Value"/>
-->
    <x2:param name="pStatus"/>
    <x2:param name="pEditable"/>
    <xapl:print select="$pPage"/>
    <xapl:print select="$pWhere"/>
    <xapl:variable name="identityOrg">
      <identity:get-org/>
    </xapl:variable>
    <xapl:variable name="userDetailLink">
      <web:get-page name="user_admin_users">
        <ID Value="{$pId}"/>
      </web:get-page>
    </xapl:variable>
    <xapl:variable name="pages">
      <TABS>
        <xapl:variable name="helpUrl">
          <xapl:choose>
            <xapl:when test="{$pPage = 'user_admin_search'}">
              <web:get-page name="user_admin_users_search_help"/>
            </xapl:when>
            <xapl:when test="{$pPage = 'user_admin_group_search'}">
              <web:get-page name="user_admin_groups_search_help"/>
            </xapl:when>
            <xapl:when test="{$pPage = 'user_group_user_search_view'}">
              <web:get-page name="user_group_user_search_view_help"/>
            </xapl:when>
            <xapl:when test="{$pPage = 'user_group_user_search_assign'}">
              <web:get-page name="user_group_user_search_assign_help"/>
            </xapl:when>
            <!--
            <xapl:when test="{$pPage = 'user_admin_notes'}">
              <web:get-page name="user_admin_notes_help"/>
            </xapl:when>
-->
            <xapl:when test="{$pPage = 'user_admin_users'}">
              <web:get-page name="user_detail_help"/>
            </xapl:when>
            <!--
            <xapl:when test="{$pPage = 'user_admin_domains'}">
              <web:get-page name="user_admin_help"/>
            </xapl:when>
-->
          </xapl:choose>
        </xapl:variable>
        <HELP Url="{$helpUrl}"/>
        <xapl:choose>
          <xapl:when test=" $pPage = 'org_search' ">
            <TAB DisplayText="Search Organizations" Selected="{$pPage = 'org_search'}" OnClick="{$pages:org_search}">
              <BUTTONS>
                <BUTTON DisplayText="Select Organization" OnClick="javascript:selectOrganization();" Emphasized="true" Disabled="report"/>
              </BUTTONS>
            </TAB>
            <PAGINATION/>
          </xapl:when>
          <!-- <xapl:when test=" $pPage = 'user_grp_domain_add_search_view' ">
            <TAB/>
          </xapl:when> -->
          <xapl:when test=" $pPage = 'user_admin_search' ">
            <TAB DisplayText="Search Users" Selected="{$pPage = 'user_admin_search'}" OnClick="{$pages:user_admin_search}">
              <BUTTONS>
                <!--perm:is-allowed document="USER_ADMIN" action="add_user">
                  <BUTTON DisplayText="Add New User" OnClick="javascript:add();" Disabled="no"/>
                </perm:is-allowed-->
                <!--
                Shifting button 'User Details' from 'omx.user_admin.pages:gettabs' to 'omx.user_admin.search:getreportconfig'.
                <BUTTON DisplayText="User Details" OnClick="javascript:edit();" Emphasized="false" Disabled="report"/>
-->
              </BUTTONS>
            </TAB>
          </xapl:when>
          <xapl:when test=" $pPage = 'user_admin_group_search' ">
            <TAB DisplayText="Search User Groups" Selected="{$pPage = 'user_admin_group_search'}" OnClick="{$pages:user_admin_group_search}"/>
          </xapl:when>
          <xapl:when test=" $pPage = 'user_group_user_search_view' ">
            <TAB DisplayText="View User Group Users" Selected="{$pPage = 'user_group_user_search_view'}" OnClick="{$pages:user_group_user_search_view}"/>
          </xapl:when>
          <xapl:when test=" $pPage = 'user_group_user_search_assign' ">
            <TAB DisplayText="User Group Users Assignment" Selected="{$pPage = 'user_group_user_search_assign'}" OnClick="{$pages:user_group_user_search_assign}"/>
          </xapl:when>
          <xapl:when test=" $pPage = 'user_admin_notes'">
            <perm:is-allowed document="USER_ADMIN" action="system_notes">
              <TAB DisplayText="Notes" Selected="{$pPage = 'user_admin_notes'}" OnClick="{$pages:user_admin_notes}">
                <BUTTONS>
                  <perm:is-allowed document="USER_ADMIN" action="system_notes">
                    <xapl:choose>
                      <xapl:when test=" ($pPage = 'user_admin_notes') and ($pSubPage = 'notes')">
                        <xapl:choose>
                          <xapl:when test=" $pEditable = 'false' ">
                            <BUTTON DisplayText="Reset" OnClick="javascript:reset(notesForm);" Emphasized="false" Disabled="yes"/>
                          </xapl:when>
                          <xapl:otherwise>
                            <BUTTON DisplayText="Reset" OnClick="javascript:reset(notesForm);" Emphasized="false" Disabled="no"/>
                          </xapl:otherwise>
                        </xapl:choose>
                        <DIVIDER/>
                        <xapl:if test=" (string-length($pId) > 0) ">
                          <xapl:choose>
                            <xapl:when test=" $pEditable = 'true' ">
                              <BUTTON DisplayText="Update" OnClick="javascript:save();" Emphasized="true" Disabled="no"/>
                            </xapl:when>
                            <xapl:otherwise>
                              <BUTTON DisplayText="Update" OnClick="javascript:save();" Emphasized="true" Disabled="yes"/>
                            </xapl:otherwise>
                          </xapl:choose>
                        </xapl:if>
                        <xapl:if test=" (string-length($pId) = 0) ">
                          <BUTTON DisplayText="Save" OnClick="javascript:saveAs();" Emphasized="true" Disabled="no"/>
                        </xapl:if>
                      </xapl:when>
                      <xapl:when test="{$pPage = 'user_admin_notes' and $pSubPage = 'notes_search'}">
                        <BUTTON DisplayText="Delete" OnClick="javascript:deleteNote();" Emphasized="false" Disabled="no"/>
                        <DIVIDER/>
                        <BUTTON DisplayText="Add New Note" OnClick="javascript:clear();" Emphasized="true" Disabled="no"/>
                      </xapl:when>
                    </xapl:choose>
                  </perm:is-allowed>
                </BUTTONS>
              </TAB>
            </perm:is-allowed>
            <PAGINATION/>
          </xapl:when>
          <!-- TAB for viewing the domain -->
          <xapl:when test=" $pPage = 'user_admin_domains' ">
            <xapl:variable name="domainTypes">
              <DOMAIN_TYPES>
                <xapl:if test="{string-length($pRoleId) &gt; 0}">
                  <xcore:execute-method name="//UserSecurity/getDomainTypesForRole">
                    <ROLE_ID Value="{$pRoleId}"/>
                  </xcore:execute-method>
                </xapl:if>
              </DOMAIN_TYPES>
            </xapl:variable>
            <xapl:variable name="subPage">
              <xapl:value-of select="{$pSubPage}"/>
            </xapl:variable>
            <xapl:for-each varName="domainType" select="{$domainTypes/ROLE_DOMAIN_TYPE_MAP[ DOMAIN_SCOPE/@Value = 'List' ]}">
              <xapl:if test=" (string-length($subPage) = 0) ">
                <xapl:set-variable name="subPage">
                  <xapl:value-of select="{$domainType/DOMAIN_TYPE_ID/@Value}"/>
                </xapl:set-variable>
              </xapl:if>
              <xapl:variable name="tabName">
                <xapl:choose>
                  <xapl:when test="{$domainType/DOMAIN_TYPE_ID/@Value = 'CUST'}">
                    <xapl:value-of select="'Corporate Points'"/>
                  </xapl:when>
                  <xapl:when test="{$domainType/DOMAIN_TYPE_ID/@Value = 'SELL'}">
                    <xapl:value-of select="'Selling Points'"/>
                  </xapl:when>
                  <xapl:when test="{$domainType/DOMAIN_TYPE_ID/@Value = 'FC'}">
                    <xapl:value-of select="'Fulfillment Centers'"/>
                  </xapl:when>
                  <xapl:when test="{$domainType/DOMAIN_TYPE_ID/@Value = 'DC'}">
                    <xapl:value-of select="'Distribution Centers'"/>
                  </xapl:when>
                  <xapl:when test="{$domainType/DOMAIN_TYPE_ID/@Value = 'ST'}">
                    <xapl:value-of select="'Shipping Points'"/>
                  </xapl:when>
                  <xapl:when test="{$domainType/DOMAIN_TYPE_ID/@Value = 'LOC'}">
                    <xapl:value-of select="'Locations'"/>
                  </xapl:when>
                </xapl:choose>
              </xapl:variable>
              <xapl:variable name="url">
                <web:get-page name="user_domain_search_view">
                  <SUBPAGE Value="{$domainType/DOMAIN_TYPE_ID/@Value}"/>
                  <USER_ID Value="{$pId}"/>
                  <ROLE_ID Value="{$pRoleId}"/>
                  <RET_PAGE Value="{$pRetPage}"/>
                  <PAGE Value="user_admin_domains"/>
                </web:get-page>
              </xapl:variable>
              <TAB DisplayText="{$tabName}" Selected="{$pPage = 'user_admin_domains' and $subPage = $domainType/DOMAIN_TYPE_ID/@Value}" OnClick="{$url}">
                <BUTTONS>
                  <BUTTON DisplayText="Add" OnClick="javascript:addDomain();" Emphasized="false" Disabled="no"/>
                  <BUTTON DisplayText="Delete" OnClick="javascript:deleteDomain();" Emphasized="false" Disabled="report"/>
                  <BUTTON DisplayText="Back" OnClick="javascript:backToUserDetails();" Emphasized="false" Disabled="no"/>
                </BUTTONS>
              </TAB>
            </xapl:for-each>
            <PAGINATION/>
          </xapl:when>
          <!-- TAB for adding the domain -->
          <xapl:when test=" $pPage = 'user_admin_domains_add' ">
            <xapl:variable name="tabName">
              <xapl:choose>
                <xapl:when test="{$pSubPage = 'CUST'}">
                  <xapl:value-of select="'Add new Corporate Points'"/>
                </xapl:when>
                <xapl:when test="{$pSubPage = 'SELL'}">
                  <xapl:value-of select="'Add new Selling Points'"/>
                </xapl:when>
                <xapl:when test="{$pSubPage = 'FC'}">
                  <xapl:value-of select="'Add new Fulfillment Centers'"/>
                </xapl:when>
                <xapl:when test="{$pSubPage = 'ST'}">
                  <xapl:value-of select="'Add new Shipping Points'"/>
                </xapl:when>
                <xapl:when test="{$pSubPage = 'DC'}">
                  <xapl:value-of select="'Add new Distribution Centers'"/>
                </xapl:when>
                <xapl:when test="{$domainType/DOMAIN_TYPE_ID/@Value = 'LOC'}">
                  <xapl:value-of select="'Locations'"/>
                </xapl:when>
              </xapl:choose>
            </xapl:variable>
            <xapl:variable name="url">
              <web:get-page name="user_domain_add_search_view">
                <SUBPAGE Value="{$domainType/DOMAIN_TYPE_ID/@Value}"/>
                <USER_ID Value="{$pId}"/>
                <ROLE_ID Value="{$pRoleId}"/>
                <RET_PAGE Value="{$pRetPage}"/>
                <PAGE Value="user_admin_domains_add"/>
              </web:get-page>
            </xapl:variable>
            <TAB DisplayText="{$tabName}" Selected="{$pPage = 'user_admin_domains_add'}" OnClick="{$url}">
              <!--  <BUTTONS>

                <BUTTON
                        DisplayText="Select"
                        OnClick="javascript:selectDomain();"
                        Emphasized="false"
                        Disabled="report"/>

                <BUTTON
                        DisplayText="Back"
                        OnClick="javascript:goBack();"
                        Emphasized="false"
                        Disabled="no"/>
              </BUTTONS> -->
            </TAB>
            <!-- <PAGINATION/>-->
          </xapl:when>
          <xapl:when test=" $pPage = 'user_admin_users' ">
            <TAB DisplayText="User Details" Selected="{$pPage = 'user_admin_users'}" OnClick="{$pages:user_admin_users}">
              <BUTTONS>
                <xapl:choose>
                  <xapl:when test="$pFromPage = 'users_search' ">
                    <BUTTON DisplayText="Cancel" OnClick="javascript:onCancel('users_search');" Disabled="no"/>
                  </xapl:when>
                  <xapl:when test="$pWhere = 'NEW_USERS' ">
                    <BUTTON DisplayText="Cancel" OnClick="javascript:onCancel('user_group_profile_new_users');" Disabled="no"/>
                  </xapl:when>
                  <xapl:when test="$pFromPage = 'user_group_profile' ">
                    <BUTTON DisplayText="Cancel" OnClick="javascript:onCancel('user_group_profile_view_users');" Disabled="no"/>
                  </xapl:when>
                  <xapl:when test="$pWhere = 'ASSIGN_USERS' ">
                    <BUTTON DisplayText="Cancel" OnClick="javascript:onCancel('user_group_profile_assign_users');" Disabled="no"/>
                  </xapl:when>
                </xapl:choose>
                <xapl:if test="$pViewMode = 'PREFERENCE' ">
                  <BUTTON DisplayText="Change Password" OnClick="javascript:changePassword(user_form);" Disabled="no"/>
                </xapl:if>
                <BUTTON DisplayText="Reset" OnClick="javascript:reset(user_form);" Disabled="no"/>
                <xapl:if test=" (string-length($pId) > 0) ">
                  <!--xapl:if test=" $pDomains  &gt; 0 ">
                      <DIVIDER/>
                      <BUTTON DisplayText="Edit Domain" OnClick="javascript:editDomain();" Emphasized="false" Disabled="no"/>
                    </xapl:if-->
                  <xapl:if test=" $pId != identity-user-id() ">
                    <DIVIDER/>
                    <xapl:choose>
                      <xapl:when test=" $pStatus = 'INACTIVE' ">
                        <BUTTON DisplayText="Activate" OnClick="javascript:activate();" Emphasized="false" Disabled="no"/>
                      </xapl:when>
                      <xapl:when test=" $pStatus = 'ACTIVE' ">
                        <BUTTON DisplayText="Deactivate" OnClick="javascript:deactivate();" Emphasized="false" Disabled="no"/>
                      </xapl:when>
                    </xapl:choose>
                  </xapl:if>
                  <xapl:if test=" ($pStatus = 'ACTIVE') and ( ($pViewMode != 'PREFERENCE') or (string-length($pViewMode) = 0) ) ">
                    <DIVIDER/>
                  </xapl:if>
                  <xapl:if test=" $pStatus = 'ACTIVE' ">
                    <BUTTON DisplayText="Update" OnClick="javascript:save();" Emphasized="true" Disabled="no"/>
                  </xapl:if>
                </xapl:if>
                <xapl:if test=" (string-length($pId) = 0) ">
                  <BUTTON DisplayText="Save" OnClick="javascript:saveAs();" Emphasized="true" Disabled="no"/>
                </xapl:if>
              </BUTTONS>
            </TAB>
          </xapl:when>
          <!-- Addition by ASHISH KAPOOR for EM UI change - START -->
          <!--xapl:when test=" $pPage = 'user_admin_users_pref' ">
            <TAB DisplayText="User Preferences" Selected="{$pPage = 'user_admin_users_pref'}" OnClick="{$pages:user_admin_users_pref}">
              <BUTTONS>
                <BUTTON DisplayText="Update" OnClick="javascript:updateGeneralPref(user_general_pref_form);" Emphasized="true" Disabled="no"/>
                <BUTTON DisplayText="Unsubscribe" OnClick="javascript:unsubscribeNotifications(user_notification_subscription_form);" Emphasized="false" Disabled="no"/>
                <DIVIDER/>
                <BUTTON DisplayText="Subscribe" OnClick="javascript:subscribeNotifications(user_notification_subscription_form);" Emphasized="true" Disabled="no"/>
              </BUTTONS>
            </TAB>
          </xapl:when-->
          <!-- Addition by ASHISH KAPOOR for EM UI change - END -->
        </xapl:choose>
      </TABS>
    </xapl:variable>
    <xapl:print>pages!!!!<xapl:value-of select="$pages"/>
    </xapl:print>
    <xapl:return>
      <RET_PAGE Value="{$userDetailLink}"/>
      <xapl:value-of select="{$pages}"/>
    </xapl:return>
  </x2:command>
</x2:commands>
