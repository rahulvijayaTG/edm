<?xml version="1.0" encoding="UTF-8"?>
<x2:commands description="_" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:cfg="http://www.i2.com/configurability" xmlns:core="http://www.i2.com/core" xmlns:omx="http://www.i2.com/omx" xmlns:perm="http://www.i2.com/permissibility" xmlns:util="http://www.i2.com/util" xmlns:web="http://www.i2.com/web" xmlns:x2="http://www.i2.com/x2" xmlns:xapl="http://www.i2.com/xapl" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:docutil="http://www.i2.com/docutil" xmlns:xudl="http://www.i2.com/xudl" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity">
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="init">
    <xapl:variable name="userGroupXMLData" resolver="session" global="true"/>
    <xapl:variable name="selectedDomainTypeID" resolver="session" global="true"/>
    <xapl:variable name="selectedDomainTypeName" resolver="session" global="true"/>
    <xapl:variable name="userOperationType" resolver="session" global="true"/>
  </x2:command>
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="getRoleTemplateDomainTabData">
    <!-- role domain tab info -->
    <xapl:if test="string-length($this/TAB/@Value) &gt; 0">
      <xapl:set-variable name="selectedDomainTypeName" select="{$this/TAB/@Value}"/>
    </xapl:if>
    <xapl:variable name="roleDomainTabInfo">
      <x2:execute command="bcm.framework.user_admin.user_admin_groups_new:getRoleDomainTab">
        <x2:with-param name="selectedTab" select="{$selectedDomainTypeName}"/>
        <x2:with-param name="assignedRoleTemplate" select="{$userGroupXMLData/USER_GRP_PROFILE/ASSIGNED_ROLE_TEMPLATE}"/>
      </x2:execute>
    </xapl:variable>
    <!-- 		<xapl:print select="{$roleDomainTabInfo}" /> -->
    <!-- create the input variable -->
    <xapl:variable name="inputRoleDomain">
      <xapl:value-of select="$this"/>
    </xapl:variable>
    <docutil:add select="$inputRoleDomain">
      <xapl:value-of select="$userGroupXMLData/*"/>
    </docutil:add>
    <docutil:add select="$inputRoleDomain">
      <xapl:value-of select="$roleDomainTabInfo"/>
    </docutil:add>
    <!-- input to the web page -->
    <!-- 		<xapl:print select="{$inputRoleDomain}" /> -->
    <xapl:return>
      <xapl:value-of select="$inputRoleDomain/*"/>
    </xapl:return>
  </x2:command>
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="gotoOrganizationSearch">
    <xapl:set-variable name="selectedDomainTypeID" select="{$this/SELECTED_DOMAIN_TYPE/@Value}"/>
    <!-- 		<xapl:print select="{$selectedDomainTypeID}" /> -->
    <web:display-page>
      <web:get-page name="user_group_org_search_view">
        <xapl:value-of select="$this/*"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="gotoEditRoleDomain">
    <!-- 		<xapl:print select="{$this}" />	 -->
    <!-- LOAD THE UPDATED DATA IN SESSION -->
    <x2:execute command="bcm.framework.user_admin.user_admin_groups_new:fetchUserGroupProfile">
      <x2:with-param name="userGroupID" select="{$userGroupXMLData/USER_GRP_PROFILE/ID/@Value}"/>
    </x2:execute>
    <web:display-page>
      <web:get-page name="user_admin_groups_role_domain">
        <xapl:value-of select="$this/*"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="addOrgnizationsToDomain">
    <!-- 		<xapl:print select="{$this}"/> -->
    <xapl:variable name="apiArgument">
      <ENTITY_LIST>
        <xapl:for-each select="{$this/ID}" varName="entityID">
          <ENTITY Value="{$entityID/@Value}"/>
        </xapl:for-each>
      </ENTITY_LIST>
      <USER_GROUP_ID Value="{$userGroupXMLData/USER_GRP_PROFILE/ID/@Value}"/>
      <DOMAIN_TYPE_ID Value="{$selectedDomainTypeID}"/>
    </xapl:variable>
    <!-- 		<xapl:print select="{$apiArgument}"/>		 -->
    <xcore:execute-method name="//UserSecurity/addUserGroupDomainEntities" entireResponse="true">
      <xapl:value-of select="{$apiArgument}"/>
    </xcore:execute-method>
    <!-- LOAD THE UPDATED DATA IN SESSION -->
    <x2:execute command="bcm.framework.user_admin.user_admin_groups_new:fetchUserGroupProfile">
      <x2:with-param name="userGroupID" select="{$userGroupXMLData/USER_GRP_PROFILE/ID/@Value}"/>
    </x2:execute>
    <web:display-page>
      <web:get-page name="user_admin_groups_role_domain">
        <xapl:value-of select="$this/*"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="removeDomainListValues">
    <!-- 		<xapl:print select="$this"/> -->
    <xapl:variable name="apiArgument">
      <ENTITY_LIST>
        <xapl:for-each select="{$this/ORG_ID}" varName="entityID">
          <ENTITY Value="{$entityID/@Value}"/>
        </xapl:for-each>
      </ENTITY_LIST>
      <USER_GROUP_ID Value="{$userGroupXMLData/USER_GRP_PROFILE/ID/@Value}"/>
      <DOMAIN_TYPE_ID Value="{$this/SELECTED_DOMAIN_TYPE/@Value}"/>
    </xapl:variable>
    <!-- 		<xapl:print select="{$apiArgument}"/>		 -->
    <xcore:execute-method name="//UserSecurity/removeUserGroupDomainEntities" entireResponse="true">
      <xapl:value-of select="{$apiArgument}"/>
    </xcore:execute-method>
    <!-- LOAD THE UPDATED DATA IN SESSION -->
    <x2:execute command="bcm.framework.user_admin.user_admin_groups_new:fetchUserGroupProfile">
      <x2:with-param name="userGroupID" select="{$userGroupXMLData/USER_GRP_PROFILE/ID/@Value}"/>
    </x2:execute>
    <web:display-page>
      <web:get-page name="user_admin_groups_role_domain">
        <xapl:value-of select="$this/*"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="goToPage">
    <xapl:print>value of this in gotopage<xapl:value-of select="$this"/>
    </xapl:print>
    <xapl:variable name="whereToGo" select="{$this/WHERE[1]/@Value}"/>
    <xapl:choose>
      <xapl:when test=" 'VIEW_USERS' = $whereToGo ">
        <xapl:print select="{$this}"/>
        <xapl:set-variable name="userOperationType" select="'VIEW_USERS'"/>
        <web:display-page>
          <web:get-page name="user_group_user_search_view">
            <DO_SEARCH Value="Yes"/>
            <ID Value="{$this/ID/@Value}"/>
            <WHERE Value="{$this/WHERE/@Value}"/>
            <xapl:if test="string-length($this/fromPage/@Value) &gt; 0">
              <fromPage Value="{$this/fromPage/@Value}"/>
            </xapl:if>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:when test=" 'ASSIGN_USERS' = $whereToGo ">
        <xapl:set-variable name="userOperationType" select="'ASSIGN_USERS'"/>
        <web:display-page>
          <web:get-page name="user_group_user_search_assign">
            <DO_SEARCH Value="Yes"/>
            <ID Value="{$this/ID/@Value}"/>
            <WHERE Value="{$this/WHERE/@Value}"/>
            <xapl:if test="string-length($this/fromPage/@Value) &gt; 0">
              <fromPage Value="{$this/fromPage/@Value}"/>
            </xapl:if>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:when test=" 'NEW_USERS' = $whereToGo ">
        <xapl:variable name="apiArguments">
          <xapl:value-of select="$this"/>
        </xapl:variable>
        <docutil:set select="$apiArguments">
          <USER_GRP_ID Value="{$this/ID/@Value}"/>
          <USER_GRP_NAME Value="{$this/GRP_NAME/@Value}"/>
          <ORG_FULL_NAME Value="{$this/ORG_FULL_NAME/@Value}"/>
        </docutil:set>
        <!-- remove the ID -->
        <docutil:remove select="$apiArguments/ID"/>
        <web:display-page>
          <web:get-page name="user_admin_users">
            <xapl:value-of select="$apiArguments/*"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:when test=" 'USER_GROUP_CONTENTS' = $whereToGo ">
        <xapl:set-variable name="selectedDomainTypeName" select=""/>
        <web:display-page>
          <web:get-page name="user_admin_groups_new_content">
            <ID Value="{$userGroupXMLData/USER_GRP_PROFILE/ID/@Value}"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:when test=" 'USER_GROUP_MAIN' = $whereToGo ">
        <xapl:variable name="usrGrpID" select=""/>
        <xapl:choose>
          <xapl:when test="string-length($this/USER_GRP_ID/@Value) &gt; 0">
            <xapl:set-variable name="usrGrpID" select="{$this/USER_GRP_ID/@Value}"/>
          </xapl:when>
          <xapl:otherwise>
            <xapl:set-variable name="usrGrpID" select="{$userGroupXMLData/USER_GRP_PROFILE/ID/@Value}"/>
          </xapl:otherwise>
        </xapl:choose>
        <xapl:print select="{$usrGrpID}"/>
        <xapl:variable name="destForCancel">
          <xapl:choose>
            <xapl:when test="$this/fromPage/@Value = 'users_search'">
              <CANCELDEST Value="user_details"/>
              <USERID Value="{$this/ID/@Value}"/>
            </xapl:when>
            <xapl:otherwise>
              <CANCELDEST Value="user_group"/>
            </xapl:otherwise>
          </xapl:choose>
        </xapl:variable>
        <web:display-page>
          <web:get-page name="user_admin_groups_new">
            <ID Value="{$usrGrpID}"/>
            <xapl:value-of select="$destForCancel"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:otherwise>
        <web:display-page>
          <web:get-page name="user_admin_groups_new"/>
        </web:display-page>
      </xapl:otherwise>
    </xapl:choose>
  </x2:command>
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="fetchUserGroupProfile">
    <x2:param name="userGroupID"/>
    <!--         <xapl:print select="{$userGroupID}"/> -->
    <xapl:variable name="userGroupProfile"/>
    <xapl:choose>
      <xapl:when test="string-length($userGroupID) &gt; 0">
        <!-- 				<xapl:print select="userGroupID is given "/> -->
        <xapl:variable name="responses">
          <xcore:execute-method name="//UserSecurity/getUserGroup" entireResponse="true">
            <ID Value="{$userGroupID}"/>
          </xcore:execute-method>
        </xapl:variable>
        <xapl:set-variable name="userGroupProfile">
          <ROOT>
            <xapl:value-of select="$responses/RESPONSE/*"/>
          </ROOT>
        </xapl:set-variable>
      </xapl:when>
      <xapl:otherwise>
        <!-- 				<xapl:print select="userGroupID is NOT given "/>			 -->
        <!-- send a empty USER_GRP_PROFILE tag -->
        <xapl:set-variable name="userGroupProfile">
          <ROOT>
            <USER_GRP_PROFILE/>
          </ROOT>
        </xapl:set-variable>
      </xapl:otherwise>
    </xapl:choose>
    <!--         <xapl:print select="Return Parameter from fetchUserGroupProfile"/> -->
    <!--         <xapl:print select="$userGroupProfile" /> -->
    <!-- store in session before we leave -->
    <!-- 		<xapl:print select="{$userGroupXMLData}" /> -->
    <xapl:set-variable name="userGroupXMLData" select="$userGroupProfile"/>
    <!-- 		<xapl:print select="{$userGroupXMLData}" /> -->
    <xapl:return>
      <xapl:value-of select="$userGroupProfile"/>
    </xapl:return>
  </x2:command>
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="getRoleDomainTab">
    <xapl:param name="selectedTab"/>
    <xapl:param name="assignedRoleTemplate"/>
    <!--
    <xapl:variable name="domainTypeMasterDoc">
      <x2:execute command="bcm.framework.user_admin.user_admin_groups_new:getDomainTypeMasterData"/>
    </xapl:variable>
-->
    <!-- 	<xapl:print select="{$domainTypeMasterDoc}" /> -->
    <!-- 	<xapl:print select="{$selectedTab}" /> -->
    <!-- 	<xapl:print select="{$assignedRoleTemplate}" /> -->
    <xapl:variable name="isDefaultTabSelected" select="false()"/>
    <!-- 	<xapl:print select="{$isDefaultTabSelected}" /> -->
    <xapl:variable name="tabSelection" select="false()"/>
    <xapl:variable name="roleDomainTab">
      <xapl:if test="$assignedRoleTemplate/*">
        <CONTAINER Scrollable="no">
          <xapl:for-each select="{$assignedRoleTemplate/DOMAIN_TYPE}" varName="domainType">
            <xapl:set-variable name="tabSelection" select="false()"/>
            <xapl:value-of select="{$tabSelection}"/>
            <xapl:choose>
              <xapl:when test="not(string-length($selectedTab) &gt; 0 ) and $isDefaultTabSelected = false()">
                <xapl:set-variable name="isDefaultTabSelected" select="true()"/>
                <xapl:set-variable name="tabSelection" select="true()"/>
              </xapl:when>
              <xapl:otherwise>
                <xapl:if test="{$domainTypeMasterDoc/DOMAIN_TYPE[./ID/@Value = $domainType/DOMAIN_TYPE_ID/@Value ]/NAME/@Value = $selectedTab}">
                  <xapl:set-variable name="tabSelection" select="true()"/>
                </xapl:if>
              </xapl:otherwise>
            </xapl:choose>
            <xapl:variable name="displayText" select="{$domainTypeMasterDoc/DOMAIN_TYPE[./ID/@Value = $domainType/DOMAIN_TYPE_ID/@Value ]/NAME/@Value}"/>
            <xapl:variable name="onClick" select="concat($pages:user_admin_groups_role_domain, '?TAB=' , $displayText, '&amp;DOMAIN_TYPE_ID=', $domainType/DOMAIN_TYPE_ID/@Value )"/>
            <STEP DisplayText="{$displayText}" Selected="{$tabSelection}" OnClick="{$onClick}"/>
          </xapl:for-each>
        </CONTAINER>
      </xapl:if>
    </xapl:variable>
    <!-- 	<xapl:print select="{$roleDomainTab}" /> -->
    <xapl:return>
      <xapl:value-of select="$roleDomainTab"/>
      <!--
      <xapl:value-of select="$domainTypeMasterDoc"/>
-->
    </xapl:return>
  </x2:command>
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="load">
    <xapl:print>this in user_admin_groups_new:load:<xapl:value-of select="$this"/>
    </xapl:print>
    <xapl:variable name="selectedTab" select="{$this/TAB/@Value}"/>
    <!-- for role template box  -->
    <xapl:variable name="availableRoleTemplates">
      <ROOT>
        <x2:execute command="bcm.framework.user_admin.user_admin_groups_new:getAssignableRoles"/>
      </ROOT>
    </xapl:variable>
    <!-- _ERROR info -->
    <xapl:variable name="errorCode">
      <ROOT>
        <xapl:choose>
          <xapl:when test="string-length($this/ERROR_MESSAGE/@Value) &gt; 0">
            <ERROR_MESSAGE Value="{$this/ERROR_MESSAGE/@Value}"/>
          </xapl:when>
          <xapl:when test="string-length($this/SUCCESS_MESSAGE/@Value) &gt; 0">
            <SUCCESS_MESSAGE Value="{$this/SUCCESS_MESSAGE/@Value}"/>
          </xapl:when>
        </xapl:choose>
      </ROOT>
    </xapl:variable>
    <!-- user grp profile 	-->
    <xapl:variable name="userGroupProfile">
      <xapl:choose>
        <xapl:when test="string-length($this/ID/@Value) &gt; 0">
          <xapl:print>USER GROUP ID IS NOT NULL </xapl:print>
          <x2:execute command="bcm.framework.user_admin.user_admin_groups_new:fetchUserGroupProfile">
            <x2:with-param name="userGroupID" select="{$this/ID/@Value}"/>
          </x2:execute>
        </xapl:when>
        <xapl:otherwise>
          <ROOT>
            <USER_GRP_PROFILE>
              <GRP_NAME Value="{$this/GRP_NAME/@Value}"/>
              <ORG_ID Value="{$this/ORG_ID/@Value}"/>
              <ROLE_TEMP_ID Value="{$this/ROLE_TEMP_ID/@Value}"/>
              <TYPE Value="{$this/GRP_TYPE/@Value}"/>
              <DESCRIPTION Value="{$this/DESC/@Value}"/>
            </USER_GRP_PROFILE>
          </ROOT>
        </xapl:otherwise>
      </xapl:choose>
    </xapl:variable>
    <xapl:variable name="organizationInfo">
      <ROOT>
        <xapl:if test="not(string-length($this/ID/@Value) &gt; 0 )">
          <x2:execute command="bcm.framework.user_admin.user_admin_groups_new:getOrganization">
            <x2:with-param name="pId" select="{$this/ORG_ID/@Value}"/>
          </x2:execute>
        </xapl:if>
      </ROOT>
    </xapl:variable>
    <xapl:print select="$organizationInfo"/>
    <!-- user grp type STATIC INFO 	-->
    <xapl:variable name="userGroupTypes">
      <ROOT>
        <x2:execute command="bcm.framework.user_admin.user_admin_groups_new:getUserGroupTypes"/>
      </ROOT>
    </xapl:variable>
    <xapl:variable name="viewMode" select="'READ'"/>
    <!-- set the VIEW MODE by permissions -->
    <!--
    <xapl:if test=" $s_inPrimaryDomain = 'true' ">
      <perm:is-allowed document="USER_GROUP" action="add_edit_user_group">
        <xapl:set-variable name="viewMode" select="'EDIT'"/>
      </perm:is-allowed>
    </xapl:if>
-->
    <!-- READ/EDIT is not permission-driven in bcm; so set it to EDIT -->
    <xapl:set-variable name="viewMode" select="'EDIT'"/>
    <!--xapl:print select="$viewMode"/-->
    <xapl:variable name="userGroupPageTabs">
      <ROOT>
        <x2:execute command="bcm.framework.user_admin.user_admin_groups_new:getUserGroupPageTabs">
          <x2:with-param name="userGroupProfileData" select="{$userGroupProfile}"/>
          <x2:with-param name="viewMode" select="{$viewMode}"/>
        </x2:execute>
      </ROOT>
    </xapl:variable>
    <!--     <xapl:print select="$userGroupPageTabs"/>	       -->
    <!--
    No domain calls for bcm
    <xapl:variable name="domainTypeMasterDoc">
      <ROOT>
        <x2:execute command="bcm.framework.user_admin.user_admin_groups_new:getDomainTypeMasterData"/>
      </ROOT>
    </xapl:variable>
-->
    <!--     <xapl:print select="{$domainTypeMasterDoc}" /> -->
    <!-- prepare the RETURN  -->
    <xapl:variable name="returnValue">
      <!-- insert error info  -->
      <xapl:value-of select="$errorCode/*"/>
      <!-- prim domain info  -->
      <IN_PRIMARY_DOMAIN Value="{$s_inPrimaryDomain}"/>
      <!-- Tab info -->
      <xapl:value-of select="$userGroupPageTabs/*"/>
      <!-- user org domain info -->
      <IDENTITY_ORG_ID Value="{identity-user-org()}"/>
      <!-- view mode property  -->
      <VIEW_MODE Value="{$viewMode}"/>
      <!-- user group profile -->
      <xapl:value-of select="$userGroupProfile/*"/>
      <!-- org info for the new usr-grp creation  -->
      <xapl:value-of select="$organizationInfo/*"/>
      <!-- available role template box  -->
      <xapl:value-of select="$availableRoleTemplates/*"/>
      <!-- user groups type box -->
      <xapl:value-of select="$userGroupTypes/*"/>
      <!-- domain type master data -->
      <!-- <xapl:value-of select="$domainTypeMasterDoc/DOMAIN_TYPE_MASTER"/>-->
      <!--in case the user came from the user details screen, for the cancel link will need this info-->
      <xapl:if test="count($this/USERID) &gt; 0">
        <xapl:value-of select="$this/CANCELDEST"/>
        <xapl:value-of select="$this/USERID"/>
      </xapl:if>
    </xapl:variable>
    <!-- debug -->
    <!--    <xapl:print select="$returnValue" />-->
    <xapl:return>
      <xapl:value-of select="$returnValue"/>
    </xapl:return>
  </x2:command>
  <!-- ************************************************************************** -->
  <x2:command public="yes" description="_" name="getUserGroupPageTabs">
    <xapl:param name="userGroupProfileData"/>
    <xapl:param name="viewMode"/>
    <xapl:print select="{$userGroupProfileData}"/>
    <!--    	<xapl:print select="{$viewMode}"/>  -->
    <xapl:variable name="status" select="{$userGroupProfileData/USER_GRP_PROFILE/STATUS/@Value}"/>
    <xapl:variable name="id" select="{$userGroupProfileData/USER_GRP_PROFILE/ID/@Value}"/>
    <xapl:variable name="isSaveDisable" select="'yes'"/>
    <xapl:variable name="isUpdateDisable" select="'yes'"/>
    <!--     <xapl:print select="{$isSaveDisable}"/> -->
    <!--     <xapl:print select="{$isUpdateDisable}"/>     -->
    <xapl:variable name="isNewUserGroup" select="not( (string-length($id) &gt; 0) )"/>
    <xapl:variable name="isEditable" select=" 'false' "/>
    <xapl:choose>
      <xapl:when test=" string-length($viewMode) &gt; 0 and $viewMode = 'EDIT' ">
        <xapl:set-variable name="isEditable" select="'true'"/>
      </xapl:when>
    </xapl:choose>
    <xapl:print select="{$isNewUserGroup}"/>
    <xapl:print select="{$isEditable}"/>
    <xapl:choose>
      <xapl:when test=" $isEditable = 'true'">
        <xapl:if test="not($isNewUserGroup) ">
          <xapl:set-variable name="isSaveDisable" select="'yes'"/>
          <xapl:set-variable name="isUpdateDisable" select="'no'"/>
        </xapl:if>
        <xapl:if test="($isNewUserGroup)">
          <xapl:set-variable name="isSaveDisable" select="'no'"/>
          <xapl:set-variable name="isUpdateDisable" select="'yes'"/>
        </xapl:if>
      </xapl:when>
    </xapl:choose>
    <xapl:print select="{$isSaveDisable}"/>
    <xapl:print select="{$isUpdateDisable}"/>
    <xapl:return>
      <CONTAINER Scrollable="no">
        <xapl:choose>
          <xapl:when test="$isNewUserGroup">
            <HELP Url="{$pages:create_user_group_detail_help}"/>
          </xapl:when>
          <xapl:otherwise>
        <HELP Url="{$pages:user_group_detail_help}"/>
        </xapl:otherwise>
        </xapl:choose>
        <!-- help page for User group is required  -->
        <STEP OnClick="{$pages:user_admin_groups_new}" Selected="true" DisplayText="User Group Details">
          <BUTTONS>
            <!-- Add new user to this group; Org will be default org -->
            <!--
                <BUTTON DisplayText="Add New User" OnClick="javascript:add();" Disabled="no"/>
-->
            <BUTTON DisplayText="Cancel" OnClick="javascript:onCancel();"/>
            <DIVIDER/>
            <xapl:choose>
              <xapl:when test=" string-length($status) &gt; 0 and $status = 'ACTIVE' ">
                <BUTTON DisplayText="Assign Domain" Disabled="{$isUpdateDisable}" OnClick="javascript:onAssignDomain();"/>
                <BUTTON DisplayText="Deactivate" Disabled="{$isUpdateDisable}" Emphasized="false" OnClick="javascript:submitFormToDeactivate();"/>
                <DIVIDER/>
              </xapl:when>
              <xapl:otherwise>
                <BUTTON DisplayText="Activate" Disabled="{$isUpdateDisable}" Emphasized="false" OnClick="javascript:submitFormToActivate();"/>
                <DIVIDER/>
              </xapl:otherwise>
            </xapl:choose>
            <BUTTON DisplayText="Update" Disabled="{$isUpdateDisable}" Emphasized="false" OnClick="javascript:submitFormToModifyUserGroup();"/>
            <BUTTON DisplayText="Save As New" Disabled="{$isUpdateDisable}" Emphasized="false" OnClick="javascript:submitFormToCreateNewUserGroup('SAVE_AS');"/>
            <DIVIDER/>
            <BUTTON DisplayText="Save" Disabled="{$isSaveDisable}" Emphasized="true" OnClick="javascript:submitFormToCreateNewUserGroup('SAVE');"/>
          </BUTTONS>
        </STEP>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  <!-- ************************************************************************** -->
  <x2:command public="yes" description="_" name="getUserGroupTypes">
    <xapl:return>
      <USER_GROUP_TYPES>
        <USER_GROUP_TYPE Value="ADMIN" Name="Administrator"/>
        <USER_GROUP_TYPE Value="ENTERPRISE" Name="Enterprise"/>
        <!--
        <USER_GROUP_TYPE Value="CONSUMER" Name="Consumer"/>
-->
      </USER_GROUP_TYPES>
    </xapl:return>
  </x2:command>
  <!-- ************************************************************************** -->
  <x2:command public="yes" description="_" name="gotoUserGroupAssinableRoleTemplate">
    <web:display-page>
      <web:get-page name="user_admin_group_admin_role_template"/>
    </web:display-page>
  </x2:command>
  <!-- ************************************************************************** -->
  <x2:command public="yes" description="_" name="loadUserGroupAssinableRoleTemplate">
    <xapl:variable name="availableRoleTemplates">
      <ROOT>
        <x2:execute command="bcm.framework.user_admin.user_admin_groups_new:getAssignableRoles"/>
      </ROOT>
    </xapl:variable>
    <!--     <xapl:print select="$availableRoleTemplates" /> -->
    <!--     <xapl:print select="$userGroupXMLData" /> -->
    <xapl:variable name="pPage" select="{$pages:user_admin_groups_new_content}"/>
    <xapl:variable name="returnDoc">
      <RET_PAGE Value="{concat( $pPage ,'?ID=' , $userGroupXMLData/USER_GRP_PROFILE/ID/@Value )}"/>
      <CONTAINER>
        <xapl:value-of select="$availableRoleTemplates/*"/>
        <xapl:value-of select="$userGroupXMLData/USER_GRP_PROFILE/ASSINABLE_USER_GRP_ROLE_TEMPLATES"/>
      </CONTAINER>
    </xapl:variable>
    <!-- 	<xapl:print select="$returnDoc"/> -->
    <xapl:return>
      <xapl:value-of select="$returnDoc"/>
    </xapl:return>
  </x2:command>
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="assignRoleTemplateToUserGroup">
    <!--     <xapl:print select="$this" /> -->
    <!--     <xapl:print select="$userGroupXMLData" /> -->
    <xapl:variable name="userGroupID" select="{$userGroupXMLData/USER_GRP_PROFILE/ID/@Value}"/>
    <!-- 	<xapl:print select="$userGroupID" /> -->
    <xapl:variable name="apiArgument">
      <USR_GROUP_PROFILE>
        <ID Value="{$userGroupID}"/>
        <ASSIGNABLE_ROLE_TEMPLATES>
          <xapl:for-each select="$this/SELECTED_AVAILABLE_ROLE_TEMPLATES" varName="roleTemplate">
            <ROLE_TEMPLATE Value="{$roleTemplate/@Value}"/>
          </xapl:for-each>
        </ASSIGNABLE_ROLE_TEMPLATES>
      </USR_GROUP_PROFILE>
    </xapl:variable>
    <!-- 	<xapl:print select="$apiArgument"/> -->
    <xcore:execute-method name="//UserSecurity/addUserGroupAssignableRoles" entireResponse="true">
      <xapl:value-of select="$apiArgument"/>
    </xcore:execute-method>
    <!-- LOAD THE UPDATED DATA IN SESSION -->
    <x2:execute command="bcm.framework.user_admin.user_admin_groups_new:fetchUserGroupProfile">
      <x2:with-param name="userGroupID" select="{$userGroupID}"/>
    </x2:execute>
    <web:display-page>
      <web:get-page name="user_admin_group_admin_role_template_content"/>
    </web:display-page>
  </x2:command>
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="removeAssignedRoleTemplate">
    <!--      <xapl:print select="$this" /> -->
    <!--     <xapl:print select="$userGroupXMLData" /> -->
    <xapl:variable name="userGroupID" select="{$userGroupXMLData/USER_GRP_PROFILE/ID/@Value}"/>
    <!-- 	<xapl:print select="$userGroupID" /> -->
    <xapl:variable name="apiArgument">
      <USR_GROUP_PROFILE>
        <ID Value="{$userGroupID}"/>
        <ASSIGNABLE_ROLE_TEMPLATES>
          <xapl:for-each select="$this/SELECTED_CURRENT_ROLE_TEMPLATES" varName="roleTemplate">
            <ROLE_TEMPLATE Value="{$roleTemplate/@Value}"/>
          </xapl:for-each>
        </ASSIGNABLE_ROLE_TEMPLATES>
      </USR_GROUP_PROFILE>
    </xapl:variable>
    <!-- 	<xapl:print select="$apiArgument"/> -->
    <xcore:execute-method name="//UserSecurity/removeUserGroupAssignableRoles" entireResponse="true">
      <xapl:value-of select="$apiArgument"/>
    </xcore:execute-method>
    <!-- LOAD THE UPDATED DATA IN SESSION -->
    <x2:execute command="bcm.framework.user_admin.user_admin_groups_new:fetchUserGroupProfile">
      <x2:with-param name="userGroupID" select="{$userGroupID}"/>
    </x2:execute>
    <web:display-page>
      <web:get-page name="user_admin_group_admin_role_template_content"/>
    </web:display-page>
  </x2:command>
  <!--************************************************************************-->
  <!-- this method needs to be changed to pick up the assignable role from user group  -->
  <x2:command public="yes" description="_" name="getAssignableRoles">
    <x2:param name="pOrgId"/>
    <!--     <xapl:print select="$pOrgId"/> -->
    <xapl:variable name="id">
      <xapl:choose>
        <xapl:when test=" string-length($pOrgId) &gt; 0 ">
          <xapl:value-of select="$pOrgId"/>
        </xapl:when>
        <xapl:otherwise>
          <xapl:value-of select="identity-user-org()"/>
        </xapl:otherwise>
      </xapl:choose>
    </xapl:variable>
    <!--    <xapl:print select="$id"/> -->
    <xapl:variable name="identityOrg">
      <x2:execute command="bcm.framework.user_admin.user_admin_groups_new:getOrganization">
        <x2:with-param name="pId" select="$id"/>
      </x2:execute>
    </xapl:variable>
    <!--     <xapl:print select="$identityOrg"/> -->
    <!--     <xapl:print select="$pOrgId"/> -->
    <xapl:variable name="apiArgument">
      <ROOT>
        <USER_ID Value="{identity-user-id()}"/>
        <xapl:choose>
          <xapl:when test=" string-length($pOrgId) &gt; 0 ">
            <xapl:if test=" ($identityOrg/CUSTOMER_STATUS/@Value = 'ACTIVE') ">
              <ORG_TYPE Value="Customer"/>
            </xapl:if>
            <xapl:if test=" ($identityOrg/SELLER_STATUS/@Value = 'ACTIVE') ">
              <ORG_TYPE Value="Seller"/>
            </xapl:if>
            <xapl:if test=" ($pOrgId = '_SU_ORG_') or ($identityOrg/ID/@Value = '_SU_ORG_') ">
              <ORG_TYPE Value="System"/>
            </xapl:if>
          </xapl:when>
        </xapl:choose>
      </ROOT>
    </xapl:variable>
    <!--     <xapl:print select="$apiArgument"/> -->
    <xapl:variable name="responses">
      <xcore:execute-method name="//UserSecurity/getAssignableRoles" entireResponse="true">
        <xapl:value-of select="$apiArgument/*"/>
      </xcore:execute-method>
    </xapl:variable>
    <!--     <xapl:print select="$responses"/> -->
    <xapl:return>
      <ASSIGNABLE_ROLES>
        <xapl:for-each select="$responses/RESPONSE/USER_GRP_ASSIGNEMENT_MAP" varName="roleEntry">
          <ASSIGNABLE_ROLE>
            <TYPE_ID Value="ASSIGNABLE_ROLE"/>
            <VALUE_ID Value="{$roleEntry/ASSIGNABLE_ROLE_ID/@Value}"/>
            <DESCRIPTION Value="{$roleEntry/ASSIGNABLE_ROLE_NAME/@Value}"/>
          </ASSIGNABLE_ROLE>
        </xapl:for-each>
      </ASSIGNABLE_ROLES>
    </xapl:return>
  </x2:command>
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="getOrganization">
    <x2:param name="pId"/>
    <xapl:variable name="org">
      <xcore:execute-method name="//UserSecurity/getOrganization">
        <ID Value="{$pId}"/>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:return>
      <xapl:value-of select="$org"/>
    </xapl:return>
  </x2:command>
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="createNewUserGroup">
    <xapl:print select="{$this}"/>
    <!-- prepare the api arguments -->
    <xapl:variable name="addUserGroupArguments">
      <GRP_NAME Value="{$this/GRP_NAME/@Value}"/>
      <ORG_ID Value="{$this/ORG_ID/@Value}"/>
      <ROLE_TEMP_ID Value="{$this/ROLE_ID/@Value}"/>
      <GRP_TYPE Value="{$this/USER_GROUP_TYPE/@Value}"/>
      <DESC Value="{$this/DESCRIPTION/@Value}"/>
    </xapl:variable>
    <!-- 		<xapl:print select="{$addUserGroupArguments}"/> -->
    <xapl:variable name="addUserGroupResult">
      <xcore:execute-method name="//UserSecurity/addUserGroup" entireResponse="true">
        <xapl:value-of select="{$addUserGroupArguments}"/>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:variable name="responseStatus">
      <x2:execute command="bcm.framework.util:getResponseStatus">
        <x2:with-param name="response" select="$addUserGroupResult"/>
        <x2:with-param name="successMessage" select="'User Group saved successfully'"/>
      </x2:execute>
    </xapl:variable>
    <xapl:print select="{$responseStatus}"/>
    <xapl:print select="{$addUserGroupResult}"/>
    <xapl:print select="{$this/*}"/>
    <xapl:choose>
      <!-- check for error -->
      <xapl:when test="(string-length($responseStatus/ERROR_MESSAGE) &gt; 0 )">
        <xapl:variable name="onErrorApiArgs">
          <ROOT/>
        </xapl:variable>
        <docutil:add select="$onErrorApiArgs">
          <ERROR_MESSAGE Value="{$responseStatus/ERROR_MESSAGE/@Value}"/>
          <GRP_NAME Value="{$this/GRP_NAME/@Value}"/>
          <ORG_ID Value="{$this/ORG_ID/@Value}"/>
          <ROLE_TEMP_ID Value="{$this/ROLE_ID/@Value}"/>
          <GRP_TYPE Value="{$this/USER_GROUP_TYPE/@Value}"/>
          <DESC Value="{$this/DESCRIPTION/@Value}"/>
        </docutil:add>
        <xapl:print select="{$onErrorApiArgs}"/>
        <web:display-page>
          <web:get-page name="user_admin_groups_new">
            <xapl:value-of select="$onErrorApiArgs/*"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <!-- on no errors -->
      <xapl:otherwise>
        <web:display-page>
          <web:get-page name="user_admin_groups_new">
            <ID Value="{$addUserGroupResult/RESPONSE/USER_GROUP_ID/@Value}"/>
            <xapl:value-of select="$responseStatus"/>
          </web:get-page>
        </web:display-page>
      </xapl:otherwise>
    </xapl:choose>
  </x2:command>
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="modifyUserGroupDetails">
    <!-- 	  	<xapl:print select="{$this}"/> -->
    <!-- prepare the api arguments -->
    <xapl:variable name="modifyUserGroupArguments">
      <ID Value="{$this/ID/@Value}"/>
      <GRP_NAME Value="{$this/GRP_NAME/@Value}"/>
      <ORG_ID Value="{$this/ORG_ID/@Value}"/>
      <ROLE_TEMP_ID Value="{$this/ROLE_ID/@Value}"/>
      <GRP_TYPE Value="{$this/USER_GROUP_TYPE/@Value}"/>
      <DESC Value="{$this/DESCRIPTION/@Value}"/>
    </xapl:variable>
    <!-- 		<xapl:print select="{$modifyUserGroupArguments}"/> -->
    <xapl:variable name="modifyUserGroupResult">
      <xcore:execute-method name="//UserSecurity/modifyUserGroup" entireResponse="true">
        <xapl:value-of select="{$modifyUserGroupArguments}"/>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:variable name="responseStatus">
      <x2:execute command="bcm.framework.util:getResponseStatus">
        <x2:with-param name="response" select="$modifyUserGroupResult"/>
        <x2:with-param name="successMessage" select="'User Group modified successfully'"/>
      </x2:execute>
    </xapl:variable>
    <xapl:variable name="destForCancel">
      <xapl:choose>
        <xapl:when test="count($this/CANCELDEST) &gt; 0">
          <CANCELDEST Value="user_details"/>
          <USERID Value="{$this/USERID/@Value}"/>
        </xapl:when>
        <xapl:otherwise>
          <CANCELDEST Value="user_group"/>
        </xapl:otherwise>
      </xapl:choose>
    </xapl:variable>
    <!--<xapl:print select="{$modifyUserGroupResult}"/> -->
    <web:display-page>
      <web:get-page name="user_admin_groups_new">
        <ID Value="{$this/ID/@Value}"/>
        <xapl:value-of select="$responseStatus"/>
        <xapl:value-of select="$destForCancel"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!--************************************************************************-->
  <x2:command description="_" name="getDomainTypeMasterData">
    <xapl:variable name="returnVar">
      <xcore:get-document name="//UserSecurity/DOMAIN_TYPE" entireResponse="true"/>
    </xapl:variable>
    <!-- 		<xapl:print select="{$returnVar/RESPONSE/*}"/> -->
    <xapl:return>
      <DOMAIN_TYPE_MASTER>
        <xapl:value-of select="$returnVar/RESPONSE/*"/>
      </DOMAIN_TYPE_MASTER>
    </xapl:return>
  </x2:command>
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="addUsersToUserGroup">
    <xapl:variable name="addUserToUserGroupArgument">
      <USER_GROUP_ID Value="{$userGroupXMLData/USER_GRP_PROFILE/ID/@Value}"/>
      <USERS>
        <xapl:for-each select="{$this/ID}" varName="userID">
          <USER Value="{$userID/@Value}"/>
        </xapl:for-each>
      </USERS>
    </xapl:variable>
    <!--	<xapl:print select="{$addUserToUserGroupArgument/*}"/> -->
    <xcore:execute-method name="//UserSecurity/addUserToUserGroup" entireResponse="true">
      <xapl:value-of select="{$addUserToUserGroupArgument}"/>
    </xcore:execute-method>
    <xapl:variable name="destForCancel">
      <xapl:choose>
        <xapl:when test="count($this/CANCELDEST) &gt; 0">
          <CANCELDEST Value="user_details"/>
          <USERID Value="{$this/USERID/@Value}"/>
        </xapl:when>
        <xapl:otherwise>
          <CANCELDEST Value="user_group"/>
        </xapl:otherwise>
      </xapl:choose>
    </xapl:variable>
    <web:display-page>
      <web:get-page name="user_admin_groups_new">
        <ID Value="{$userGroupXMLData/USER_GRP_PROFILE/ID/@Value}"/>
        <xapl:value-of select="$destForCancel"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!--************************************************************************-->
