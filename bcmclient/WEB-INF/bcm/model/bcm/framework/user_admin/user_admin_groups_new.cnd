  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="returnToUserGroup">
    <xapl:print>PRINTING THIS INSIDE returnToUserGroup <xapl:value-of select="$this"/>
    </xapl:print>
    <docutil:set select="$this">
      <WHERE Value="USER_GROUP_MAIN"/>
    </docutil:set>
    <x2:execute command="bcm.framework.user_admin.user_admin_groups_new:goToPage">
      <x2:with-param name="this" select="$this"/>
    </x2:execute>
  </x2:command>
