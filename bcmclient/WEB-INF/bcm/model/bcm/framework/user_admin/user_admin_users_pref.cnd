<?xml version="1.0" encoding="UTF-8"?>
<x2:commands description="_" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:cfg="http://www.i2.com/configurability" xmlns:core="http://www.i2.com/core" xmlns:omx="http://www.i2.com/omx" xmlns:perm="http://www.i2.com/permissibility" xmlns:util="http://www.i2.com/util" xmlns:web="http://www.i2.com/web" xmlns:x2="http://www.i2.com/x2" xmlns:xapl="http://www.i2.com/xapl" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:docutil="http://www.i2.com/docutil" xmlns:xudl="http://www.i2.com/xudl" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity">
  <!-- **************************************************************************
     COMMAND NAME: 	view
     PURPOSE: 		This command is used to display the user preferences page
     SERVER CALLS:	None
     CLIENT CALLS:	None
     PARAMETERS:	None
     RETURN(XML):	Returns the User Preferences page
     AUTHOR:		Ashish Kapoor
    ************************************************************************** -->
  <x2:command public="yes" description="_" name="view">
    <xapl:if test=" $this/VIEW_MODE/@Value = 'PREFERENCE' ">
      <docutil:set select="$this">
        <ID Value="{identity-user-id()}"/>
      </docutil:set>
    </xapl:if>
    <web:display-page>
      <web:get-page name="user_admin_users_pref">
        <xapl:value-of select="$this/*"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!-- **************************************************************************
     COMMAND NAME: 	loadGeneralUserPref
     PURPOSE: 		This command returns the data related to general
            user preferences.
     SERVER CALLS:	None
     CLIENT CALLS:	bcm.framework.user_admin.user_admin_users_pref:getGeneralUserPrefContainer
            bcm.framework.user_admin.user_admin_users_pref:getEnabledUserOrderPoints
            bcm.framework.user_admin.user_admin_users_pref:getOrgCarriers
            bcm.framework.user_admin.user_admin_users_pref:getCostCenters
     PARAMETERS:	None
     RETURN(XML):	XML containing the list of general preferences of the user.
     AUTHOR:		Ashish Kapoor
    ************************************************************************** -->
  <x2:command public="yes" description="_" name="loadGeneralUserPref">
    <xapl:return>
      <x2:execute command="bcm.framework.user_admin.user_admin_users_pref:getGeneralUserPrefContainer"/>
      <CURRENT_USER_PREF>
        <x2:execute command="bcm.framework.user_admin.user_admin_users_pref:getGeneralUserPreferences"/>
      </CURRENT_USER_PREF>
      <ORDER_POINTS>
        <x2:execute command="bcm.framework.user_admin.user_admin_users_pref:getEnabledUserOrderPoints"/>
      </ORDER_POINTS>
      <ORG_CARRIERS>
        <x2:execute command="bcm.framework.user_admin.user_admin_users_pref:getOrgCarriers"/>
      </ORG_CARRIERS>
      <!-- Addition by ASHISH KAPOOR to fix Issue# 404612 - START -->
      <COST_CENTERS>
        <x2:execute command="bcm.framework.user_admin.user_admin_users_pref:getCostCenters"/>
      </COST_CENTERS>
      <!-- Addition by ASHISH KAPOOR to fix Issue# 404612 - END -->
    </xapl:return>
  </x2:command>
  <!-- **************************************************************************
     COMMAND NAME: 	loadNotificationUserPref
     PURPOSE: 		This command returns the data related to notification
            subscription preferences for the current user.
     SERVER CALLS:	None
     CLIENT CALLS:	bcm.framework.user_admin.user_admin_users_pref:getNotificationUserPrefContainer
            bcm.framework.user_admin.user_admin_users_pref:getCurrentNotificationSubscriptions
            bcm.framework.user_admin.user_admin_users_pref:getAvailableSubscriptionEvents
     PARAMETERS:	None
     RETURN(XML):	XML containing the list of notification subscription 
            preferences for the current user.
     AUTHOR:		Ashish Kapoor
    ************************************************************************** -->
  <x2:command public="yes" description="_" name="loadNotificationUserPref">
    <xapl:return>
      <x2:execute command="bcm.framework.user_admin.user_admin_users_pref:getNotificationUserPrefContainer"/>
      <CURRENT_SUBSCRIPTIONS>
        <x2:execute command="bcm.framework.user_admin.user_admin_users_pref:getCurrentNotificationSubscriptions"/>
      </CURRENT_SUBSCRIPTIONS>
      <AVAILABLE_SUBSCRIPTIONS>
        <x2:execute command="bcm.framework.user_admin.user_admin_users_pref:getAvailableSubscriptionEvents"/>
      </AVAILABLE_SUBSCRIPTIONS>
      <!-- Addition by ASHISH KAPOOR to fix Issue# 406036 - START -->
      <COMMUNICATION_PROTOCOLS>
        <PROTOCOL>
          <ID Value="HTTP"/>
          <NAME Value="HTTP"/>
        </PROTOCOL>
        <PROTOCOL>
          <ID Value="EMAIL"/>
          <NAME Value="Email"/>
        </PROTOCOL>
        <PROTOCOL>
          <ID Value="ALERT"/>
          <NAME Value="Alert"/>
        </PROTOCOL>
      </COMMUNICATION_PROTOCOLS>
      <!-- Addition by ASHISH KAPOOR to fix Issue# 406036 - END -->
    </xapl:return>
  </x2:command>
  <!-- **************************************************************************
     COMMAND NAME: 	getNotificationUserPrefContainer
     PURPOSE: 		This command returns the data relating to the
            container that displays general preferences.
     SERVER CALLS:	None
     CLIENT CALLS:	None
     PARAMETERS:	None
     RETURN(XML):	XML containing the details of the General User
            Preference container.
     AUTHOR:		Ashish Kapoor
    ************************************************************************** -->
  <x2:command public="yes" description="_" name="getNotificationUserPrefContainer">
    <xapl:return>
      <CONTAINER Scrollable="no">
        <STEP DisplayText="Notification Preferences" Selected="true"/>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  <!-- **************************************************************************
     COMMAND NAME: 	getGeneralUserPrefContainer
     PURPOSE: 		This command returns the data relating to the
            container that displays notification preferences.
     SERVER CALLS:	None
     CLIENT CALLS:	None
     PARAMETERS:	None
     RETURN(XML):	XML containing the details of the Notification User
            Preferences container.
     AUTHOR:		Ashish Kapoor
    ************************************************************************** -->
  <x2:command public="yes" description="_" name="getGeneralUserPrefContainer">
    <xapl:return>
      <CONTAINER Scrollable="no">
        <STEP DisplayText="General Preferences" Selected="true"/>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  <!-- **************************************************************************
     COMMAND NAME: 	getEnabledUserOrderPoints
     PURPOSE: 		This command is used to retrieve a list of
            enabled order points related to the org to
            which user belongs.
     SERVER CALLS:	UserSecurity/getEnabledOrderPoints
     CLIENT CALLS:	None
     PARAMETERS:	None
     RETURN(XML):	XML containing the list of enabled Order Points.
     AUTHOR:		Ashish Kapoor
    ************************************************************************** -->
  <x2:command public="yes" description="_" name="getEnabledUserOrderPoints">
    <!-- Get current User ID -->
    <xapl:variable name="userID">
      <identity:get-user-id/>
    </xapl:variable>
    <!-- Get the Organization ID to which current user belongs -->
    <xapl:variable name="userOrgID">
      <identity:get-org/>
    </xapl:variable>
    <!-- Get the additional information for the current user Organization -->
    <xapl:variable name="userOrgInfo">
      <x2:execute command="bcm.framework.user_admin.user_admin_users_pref:getOrgInfo">
        <x2:with-param name="pOrgID" select="$userOrgID"/>
      </x2:execute>
    </xapl:variable>
    <!-- Get user Org's Seller Status -->
    <xapl:variable name="userOrgSellerStatus">
      <xapl:value-of select="$userOrgInfo/SELLER_STATUS/@Value"/>
    </xapl:variable>
    <!-- Get user Org's Customer Status -->
    <xapl:variable name="userOrgCustomerStatus">
      <xapl:value-of select="$userOrgInfo/CUSTOMER_STATUS/@Value"/>
    </xapl:variable>
    <!-- Get the list of enabled order points -->
    <xapl:variable name="orderPointsList">
      <xcore:execute-method name="//UserSecurity/getEnabledOrderPoints" ReturnRowCount="yes" entireResponse="true">
        <USER_ID Value="{$userID}"/>
        <xapl:choose>
          <!-- Validate if the user Org is seller -->
          <xapl:when test="$userOrgSellerStatus != ''">
            <FILTER Name="SELLING_ORG_ID">
              <SELLING_ORG_ID Value="{$userOrgID}"/>
            </FILTER>
          </xapl:when>
          <!-- Validate if the user Org is customer -->
          <xapl:when test="$userOrgCustomerStatus != ''">
            <FILTER Name="CUSTOMER_ORG_ID">
              <CUSTOMER_ORG_ID Value="{$userOrgID}"/>
            </FILTER>
          </xapl:when>
        </xapl:choose>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:return>
      <xapl:value-of select="$orderPointsList/RESPONSE/ENABLED_ORDER_POINTS/ENABLED_ORDER_POINT"/>
    </xapl:return>
  </x2:command>
  <!-- **************************************************************************
     COMMAND NAME: 	getOrgCarriers
     PURPOSE: 		This command is used to retrieve a list of carriers
            related to the Org the user belongs.
     SERVER CALLS:	UserSecurity/getOrgCarrierInfoForOrg
     CLIENT CALLS:	None
     PARAMETERS:	None
     RETURN(XML):	XML containing the list of Org carriers.
     AUTHOR:		Ashish Kapoor
    ************************************************************************** -->
  <x2:command public="yes" description="_" name="getOrgCarriers">
    <!-- Get the Organization ID to which current user belongs -->
    <xapl:variable name="userOrgID">
      <identity:get-org/>
    </xapl:variable>
    <!-- Call server API to get the list of enabled order points -->
    <xapl:variable name="orgCarriersList">
      <xcore:execute-method name="//UserSecurity/getOrgCarrierInfoForOrg" ReturnRowCount="yes" entireResponse="true">
        <ORG_ID Value="{$userOrgID}"/>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:return>
      <xapl:value-of select="$orgCarriersList/RESPONSE/RESPONSE/ORG_CARRIER_INFO"/>
    </xapl:return>
  </x2:command>
  <!-- **************************************************************************
     COMMAND NAME: 	getOrgInfo
     PURPOSE: 		This command is used to retrieve a information
            related to the Org to which user belongs.
     SERVER CALLS:	UserSecurity/getOrganization
     CLIENT CALLS:	None
     PARAMETERS:	pOrgID - ID of the user Organization
     RETURN(XML):	XML containing the Organization info.
     AUTHOR:		Ashish Kapoor
    ************************************************************************** -->
  <x2:command public="yes" description="_" name="getOrgInfo">
    <x2:param name="pOrgID"/>
    <xapl:variable name="orgInfo">
      <xcore:execute-method name="//UserSecurity/getOrganization" ReturnRowCount="yes" entireResponse="true">
        <ID Value="{$pOrgID}"/>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:return>
      <!-- return the org data -->
      <xapl:value-of select="$orgInfo/RESPONSE/ORGANIZATION"/>
    </xapl:return>
  </x2:command>
  <!-- **************************************************************************
     COMMAND NAME: 	addGeneralUserPreferences
     PURPOSE: 		This command is used to add new general
            user preferences.
     SERVER CALLS:	EM/addUserDefaults
     CLIENT CALLS:	None
     PARAMETERS:	None
     RETURN(XML):	Status returned by server.
     AUTHOR:		Ashish Kapoor
    ************************************************************************** -->
  <x2:command public="yes" description="_" name="addGeneralUserPreferences">
    <!-- Get current user ID -->
    <xapl:variable name="userID">
      <identity:get-user-id/>
    </xapl:variable>
    <!-- Get org of current user -->
    <xapl:variable name="userOrg">
      <identity:get-org/>
    </xapl:variable>
    <!-- Call server API to save general user preferences -->
    <xapl:variable name="serverResponse">
      <xcore:execute-method name="//UserSecurity/addUserDefaults" ReturnRowCount="yes" entireResponse="true">
        <USER_ID Value="{$userID}"/>
        <ORG_ID Value="{$userOrg}"/>
        <DEF_CARRIER_ID Value="{$this/CARRIER/@Value}"/>
        <DEF_ORDER_POINT_ID Value="{$this/ORDER_POINT/@Value}"/>
        <DEF_ORDER_POINT_ID Value="{$this/ORDER_POINT/@Value}"/>
        <!-- Addition by ASHISH KAPOOR to fix Issue# 404612 - START -->
        <DEF_COST_CENTER_CODE Value="{$this/COST_CENTER/@Value}"/>
        <!-- Addition by ASHISH KAPOOR to fix Issue# 404612 - END -->
      </xcore:execute-method>
    </xapl:variable>
    <xapl:return>
      <xapl:for-each select="$serverResponse/RESPONSE" varName="responses">
        <xapl:choose>
          <xapl:when test="$responses/_RESULT/@Value = 'SEVERE_ERROR'">
            <web:display-page>
              <web:get-page name="omx_error_page"/>
            </web:display-page>
          </xapl:when>
          <xapl:otherwise>
            <web:display-page>
              <web:get-page name="user_admin_users_pref_content">
                <VIEW_MODE Value="'PREFERENCE'"/>
              </web:get-page>
            </web:display-page>
          </xapl:otherwise>
        </xapl:choose>
      </xapl:for-each>
    </xapl:return>
  </x2:command>
  <!-- **************************************************************************
     COMMAND NAME: 	updateGeneralUserPreferences
     PURPOSE: 		This command is used to update general
            user preferences.
     SERVER CALLS:	EM/modifyUserDefaults
     CLIENT CALLS:	None
     PARAMETERS:	None
     RETURN(XML):	Status returned by server.
     AUTHOR:		Ashish Kapoor
    ************************************************************************** -->
  <x2:command public="yes" description="_" name="updateGeneralUserPreferences">
    <!-- Get current user ID -->
    <xapl:variable name="userID">
      <identity:get-user-id/>
    </xapl:variable>
    <!-- Get current user ORG -->
    <xapl:variable name="userOrg">
      <identity:get-org/>
    </xapl:variable>
    <!-- Call server API to update general user preferences -->
    <xapl:variable name="serverResponse">
      <xcore:execute-method name="//UserSecurity/modifyUserDefaults" ReturnRowCount="yes" entireResponse="true">
        <USER_ID Value="{$userID}"/>
        <ORG_ID Value="{$userOrg}"/>
        <DEF_CARRIER_ID Value="{$this/CARRIER/@Value}"/>
        <DEF_ORDER_POINT_ID Value="{$this/ORDER_POINT/@Value}"/>
        <!-- Addition by ASHISH KAPOOR to fix Issue# 404612 - START -->
        <DEF_COST_CENTER_CODE Value="{$this/COST_CENTER/@Value}"/>
        <!-- Addition by ASHISH KAPOOR to fix Issue# 404612 - END -->
      </xcore:execute-method>
    </xapl:variable>
    <xapl:return>
      <xapl:for-each select="$serverResponse/RESPONSE" varName="responses">
        <xapl:choose>
          <xapl:when test="$responses/_RESULT/@Value = 'SEVERE_ERROR'">
            <web:display-page>
              <web:get-page name="omx_error_page"/>
            </web:display-page>
          </xapl:when>
          <xapl:otherwise>
            <web:display-page>
              <web:get-page name="user_admin_users_pref_content">
                <VIEW_MODE Value="'PREFERENCE'"/>
              </web:get-page>
            </web:display-page>
          </xapl:otherwise>
        </xapl:choose>
      </xapl:for-each>
    </xapl:return>
  </x2:command>
  <!-- **************************************************************************
     COMMAND NAME: 	getGeneralUserPref
     PURPOSE: 		This command is used to retrieve the values of general
            user default preferences.
     SERVER CALLS:	EM/getUserDefaults
     CLIENT CALLS:	None
     PARAMETERS:	None
     RETURN(XML):	XML containing the general user preferences.
     AUTHOR:		Ashish Kapoor
    ************************************************************************** -->
  <x2:command public="yes" description="_" name="getGeneralUserPreferences">
    <!-- Get current user ID -->
    <xapl:variable name="userID">
      <identity:get-user-id/>
    </xapl:variable>
    <!-- Get current user ORG -->
    <xapl:variable name="userOrg">
      <identity:get-org/>
    </xapl:variable>
    <!-- Call server API to get general user preferences -->
    <xapl:variable name="generalUserPref">
      <xcore:execute-method name="//UserSecurity/getUserDefaults" ReturnRowCount="yes" entireResponse="true">
        <USER_ID Value="{$userID}"/>
        <ORG_ID Value="{$userOrg}"/>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:return>
      <xapl:value-of select="$generalUserPref/RESPONSE/RESPONSE/USER_ORG_ENTITY_DEFAULTS"/>
    </xapl:return>
  </x2:command>
  <!-- **************************************************************************
     COMMAND NAME: 	getAvailableSubscriptionEvents
     PURPOSE: 		This command is used to list of notifications 
            that are available for subscriptions.
     SERVER CALLS: Nome
     CLIENT CALLS:	None
     PARAMETERS:	None
     RETURN(XML):	XML containing a list of notifications available
            for subscriptions.
     AUTHOR:		Ashish Kapoor
    ************************************************************************** -->
  <x2:command public="yes" description="_" name="getAvailableSubscriptionEvents">
    <!-- Get the list of available subscriptions -->
    <xapl:variable name="subscriptionEventsList">
      <xcore:get-document name="//MessagingService/MSG_EVENT">
        <CATEGORY Value="Subscription"/>
      </xcore:get-document>
    </xapl:variable>
    <xapl:return>
      <xapl:value-of select="$subscriptionEventsList"/>
    </xapl:return>
  </x2:command>
  <!-- **************************************************************************
     COMMAND NAME: 	subscribeToNotifications
     PURPOSE: 		This command is save the list of notifications
            to which user chooses to subscribe.
     SERVER CALLS: UserSecurity/addToSubscriptionList
     CLIENT CALLS:	None
     PARAMETERS:	None
     RETURN(XML):	XML containing a list of notifications available
            for subscriptions.
     AUTHOR:		Ashish Kapoor
    ************************************************************************** -->
  <x2:command public="yes" description="_" name="subscribeToNotifications">
    <!-- Get current user id -->
    <xapl:variable name="userID">
      <identity:get-user-id/>
    </xapl:variable>
    <!-- Get the list of available subscriptions -->
    <xapl:variable name="serverResponse">
      <!-- Loop through the Selected Available Notifications -->
      <xapl:for-each select="$this/SELECTED_AVAILABLE_NOTIFICATION" varName="selectedNotification">
        <!-- Loop through the selected Communication Protocols -->
        <xapl:for-each select="$this/COMM_PROTOCOL" varName="commProtocol">
          <!-- Parse the value of SELECTED_NOTIFICATION field to get NAME and SERVICE_NAME -->
          <xapl:variable name="msgEventID" select="$selectedNotification/@Value"/>
          <xapl:variable name="eventName" select="substring-before($msgEventID, '|')"/>
          <xapl:variable name="serviceName" select="substring-after($msgEventID, '|')"/>
          <!-- Call the server API to save the subscriptions -->
          <xcore:execute-method name="//UserSecurity/addToSubscriptionList" ReturnRowCount="yes" entireResponse="true">
            <USER_ID Value="{$userID}"/>
            <SERVICE_NAME Value="{$serviceName}"/>
            <MSG_EVENT_NAME Value="{$eventName}"/>
            <COMM_PROTOCOL Value="{$commProtocol/@Value}"/>
          </xcore:execute-method>
        </xapl:for-each>
      </xapl:for-each>
    </xapl:variable>
    <xapl:return>
      <xapl:for-each select="$serverResponse" varName="responses">
        <xapl:choose>
          <xapl:when test="$responses/RESPONSE/_RESULT/@Value = 'SEVERE_ERROR'">
            <web:display-page>
              <web:get-page name="omx_error_page"/>
            </web:display-page>
          </xapl:when>
          <xapl:otherwise>
            <web:display-page>
              <web:get-page name="user_admin_users_pref_content">
                <VIEW_MODE Value="'PREFERENCE'"/>
              </web:get-page>
            </web:display-page>
          </xapl:otherwise>
        </xapl:choose>
      </xapl:for-each>
    </xapl:return>
  </x2:command>
  <!-- **************************************************************************
     COMMAND NAME: 	unsubscribeToNotifications
     PURPOSE: 		This command is to remove the subscriptions
            from the users subscribed notifications list.
     SERVER CALLS: UserSecurity/removeFromSubscriptionList
     CLIENT CALLS:	None
     PARAMETERS:	None
     RETURN(XML):	Server Status
     AUTHOR:		Ashish Kapoor
    ************************************************************************** -->
  <x2:command public="yes" description="_" name="unsubscribeToNotifications">
    <!-- Get current user id -->
    <xapl:variable name="userID">
      <identity:get-user-id/>
    </xapl:variable>
    <!-- Loop through the selected subscriptions -->
    <xapl:variable name="serverResponse">
      <xapl:for-each select="$this/SELECTED_CURRENT_NOTIFICATION" varName="selectedNotification">
        <!-- Parse the value of SELECTED_NOTIFICATION field to get
          NAME, SERVICE_NAME, and COMM_PROTOCOL -->
        <xapl:variable name="subscriptionID" select="$selectedNotification/@Value"/>
        <xapl:variable name="eventName" select="substring-before($subscriptionID, '|')"/>
        <xapl:set-variable name="subscriptionID" select="substring-after($subscriptionID, '|')"/>
        <xapl:variable name="serviceName" select="substring-before($subscriptionID, '|')"/>
        <xapl:variable name="commProtocol" select="substring-after($subscriptionID, '|')"/>
        <!-- Call the server API to remove subscribed notifications -->
        <xcore:execute-method name="//UserSecurity/removeFromSubscriptionList" ReturnRowCount="yes" entireResponse="true">
          <USER_ID Value="{$userID}"/>
          <SERVICE_NAME Value="{$serviceName}"/>
          <MSG_EVENT_NAME Value="{$eventName}"/>
          <COMM_PROTOCOL Value="{$commProtocol}"/>
        </xcore:execute-method>
      </xapl:for-each>
    </xapl:variable>
    <xapl:return>
      <xapl:for-each select="$serverResponse/RESPONSE" varName="responses">
        <xapl:choose>
          <xapl:when test="$responses/_RESULT/@Value = 'SEVERE_ERROR'">
            <web:display-page>
              <web:get-page name="omx_error_page"/>
            </web:display-page>
          </xapl:when>
          <xapl:otherwise>
            <web:display-page>
              <web:get-page name="user_admin_users_pref_content">
                <VIEW_MODE Value="'PREFERENCE'"/>
              </web:get-page>
            </web:display-page>
          </xapl:otherwise>
        </xapl:choose>
      </xapl:for-each>
    </xapl:return>
  </x2:command>
  <!-- **************************************************************************
     COMMAND NAME: 	getCurrentNotificationsSubscriptions
     PURPOSE: 		This command retrieves the list of current
            notification subscriptions for the user.
     SERVER CALLS: UserSecurity/getSubscribedUsersForEventAndService
     CLIENT CALLS:	None
     PARAMETERS:	None
     RETURN(XML):	XML containing a list of currently subscribed 
            notifications.
     AUTHOR:		Ashish Kapoor
    ************************************************************************** -->
  <x2:command public="yes" description="_" name="getCurrentNotificationSubscriptions">
    <!-- Get current user id -->
    <xapl:variable name="userID">
      <identity:get-user-id/>
    </xapl:variable>
    <xapl:variable name="currentSubscriptions">
      <!--xcore:execute-method name="//UserSecurity/getSubscribedUsersForEventAndService" ReturnRowCount="yes" entireResponse="true"-->
      <xcore:get-document name="//UserSecurity/SUBSCRIPTION_LIST">
        <USER_ID Value="{$userID}"/>
      </xcore:get-document>
      <!--/xcore:execute-method-->
    </xapl:variable>
    <!--xapl:print>
      ***** CURRENT SUBSCRIPTIONS *****
      <xapl:value-of select="$currentSubscriptions"/>
      *************************
    </xapl:print-->
    <xapl:return>
      <xapl:value-of select="$currentSubscriptions"/>
    </xapl:return>
  </x2:command>
  <!-- Addition by ASHISH KAPOOR to fix Issue# 404612 - START -->
  <!-- **************************************************************************
     COMMAND NAME: 	getCostCenters
     PURPOSE: 		This command retrieves the list of cost centers.
     SERVER CALLS: UserSecurity/getCodeMasterValue
     CLIENT CALLS:	None
     PARAMETERS:	None
     RETURN(XML):	XML containing a list of cost centers.
     AUTHOR:		Ashish Kapoor
    ************************************************************************** -->
  <x2:command public="yes" description="_" name="getCostCenters">
    <xapl:variable name="costCenters">
      <xcore:execute-method name="//UserSecurity/getCodeMasterValue" ReturnRowCount="yes" entireResponse="true">
        <TYPE_ID Value="COST_CENTER"/>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:return>
      <xapl:value-of select="$costCenters/RESPONSE/CODE_MASTER_VALUE"/>
    </xapl:return>
  </x2:command>
  <!-- Addition by ASHISH KAPOOR to fix Issue# 404612 - END -->
</x2:commands>
