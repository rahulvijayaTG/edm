<?xml version="1.0" encoding="UTF-8"?>
<x2:commands description="_" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:cfg="http://www.i2.com/configurability" xmlns:core="http://www.i2.com/core" xmlns:omx="http://www.i2.com/omx" xmlns:perm="http://www.i2.com/permissibility" xmlns:util="http://www.i2.com/util" xmlns:web="http://www.i2.com/web" xmlns:x2="http://www.i2.com/x2" xmlns:xapl="http://www.i2.com/xapl" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:docutil="http://www.i2.com/docutil" xmlns:xudl="http://www.i2.com/xudl" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity">
  <!-- **************************************************************************
************************************************************************** -->
  <x2:command public="yes" description="_" name="init">
    <xapl:variable name="domainVariable" resolver="session" global="true"/>
    <xapl:variable name="userGrpVariable" resolver="session" global="true"/>
  </x2:command>
  <!-- **************************************************************************
************************************************************************** -->
  <x2:command public="yes" description="_" name="search">
    <docutil:remove select="$this/AUTH_DOCS"/>
    <xapl:variable name="domainType" select="$this/domainType/@Value"/>
    <xapl:print select="$domainVariable"/>
    <xapl:print select="$this"/>
    <xapl:print select="$domainType"/>
    <xapl:variable name="flag"/>
    <xapl:variable name="searchKey" select="$this/searchKey/@Value"/>
    <xapl:set-variable name="flag">True</xapl:set-variable>
    <xapl:if test="string-length($searchKey)&lt;1">
      <xapl:set-variable name="flag">ALL</xapl:set-variable>
    </xapl:if>
    <xapl:if test="$searchKey='*'">
      <xapl:set-variable name="flag">ALL</xapl:set-variable>
    </xapl:if>
    <xapl:print select="$flag"/>
    <xapl:if test="$flag='True'">
      <xapl:if test="contains($searchKey,'*')">
        <xapl:if test="(string-length(substring-after($searchKey,'*'))) &gt; 0">
          <xapl:set-variable name="searchKey" select="substring-after(searchKey,'*')"/>
        </xapl:if>
        <xapl:if test="(string-length(substring-before($searchKey,'*')))&gt;0">
          <xapl:set-variable name="searchKey" select="{substring-before($searchKey,'*')}"/>
        </xapl:if>
        <xapl:set-variable name="flag">False</xapl:set-variable>
      </xapl:if>
    </xapl:if>
    <xapl:variable name="searchResult">
      <AUTH_DOCS/>
    </xapl:variable>
    <xapl:for-each select="$domainVariable/AUTH_DOC[@Name=$domainType]" varName="authDoc">
      <xapl:variable name="localDoc">
        <AUTH_DOC Name="{$authDoc/@Name}"/>
      </xapl:variable>
      <xapl:for-each select="$authDoc/AUTH_ID" varName="idDoc">
        <xapl:choose>
          <xapl:when test="$flag='False'">
            <xapl:if test="contains($idDoc/descendant::*/@Value,$searchKey)">
              <docutil:add select="$localDoc">
                <xapl:value-of select="$idDoc"/>
              </docutil:add>
            </xapl:if>
          </xapl:when>
          <xapl:when test="$flag='ALL'">
            <docutil:add select="$localDoc">
              <xapl:value-of select="$idDoc"/>
            </docutil:add>
          </xapl:when>
          <xapl:otherwise>
            <xapl:if test="$idDoc/descendant::*/@Value=$searchKey">
              <docutil:add select="$localDoc">
                <xapl:value-of select="$idDoc"/>
              </docutil:add>
            </xapl:if>
          </xapl:otherwise>
        </xapl:choose>
      </xapl:for-each>
      <docutil:add select="$searchResult">
        <xapl:value-of select="$localDoc"/>
      </docutil:add>
    </xapl:for-each>
    <xapl:value-of select="$this"/>
    <xapl:variable name="resultString">
      <docutil:xml-to-string>
        <xapl:value-of select="{$searchResult}"/>
      </docutil:xml-to-string>
    </xapl:variable>
    <xapl:value-of select="$this"/>
    <xapl:value-of select="$this/*"/>
    <web:display-page>
      <web:get-page name="searchDomainResult">
        <xapl:value-of select="$this/*"/>
        <resultString Value="{$resultString}"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!-- **************************************************************************
************************************************************************** -->
  <x2:command public="yes" description="_" name="merge">
    <xapl:print select="$this"/>
    <xapl:variable name="domainType" select="$this/domainType/@Value"/>
    <xapl:print select="$domainType"/>
    <xapl:print select="$domainVariable"/>
    <xapl:variable name="addVar">
      <var/>
    </xapl:variable>
    <xapl:for-each select="$this/edit" varName="currVar">
      <docutil:add select="$addVar">
        <edit Value="{$currVar/@Value}"/>
      </docutil:add>
    </xapl:for-each>
    <xapl:for-each select="$this/view" varName="currVar">
      <docutil:add select="$addVar">
        <view Value="{$currVar/@Value}"/>
      </docutil:add>
    </xapl:for-each>
    <xapl:print select="$addVar"/>
    <xapl:variable name="nodeName" select="name($domainVariable/AUTH_DOC[@Name=$domainType]/AUTH_ID/descendant::*)"/>
    <xapl:print select="$nodeName"/>
    <xapl:print select="$addVar"/>
    <xapl:for-each select="$addVar/edit" varName="currVar">
      <xapl:print select="$currVar"/>
      <docutil:remove select="$addVar/view[@Value=$currVar/@Value]"/>
      <xapl:print select="$addVar"/>
      <xapl:variable name="flag" select="'False'"/>
      <xapl:for-each select="$userGrpVariable/AUTH_DOC[@Name=$domainType]/*" varName="idDoc">
        <xapl:if test="$idDoc/descendant::*/@Value=$currVar/@Value">
          <xapl:set-variable name="flag" select="'True'"/>
          <xapl:print>******sumanta</xapl:print>
          <xapl:print select="$idDoc"/>
          <docutil:set select="$idDoc/descendant::*/@Action">
            <xapl:value-of select="'_ALL_'"/>
          </docutil:set>
          <xapl:print>******sumanta</xapl:print>
        </xapl:if>
      </xapl:for-each>
      <xapl:if test="$flag='False'">
        <xapl:print>**********ENTERED HERE TO ADD</xapl:print>
        <docutil:add select="$userGrpVariable/AUTH_DOC[@Name=$domainType]">
          <AUTH_ID>
            <docutil:element name="{$nodeName}" Value="{$currVar/@Value}" Action="_ALL_"/>
          </AUTH_ID>
        </docutil:add>
      </xapl:if>
    </xapl:for-each>
    <xapl:for-each select="$addVar/view" varName="currVar">
      <xapl:print select="$currVar"/>
      <xapl:variable name="flag" select="'False'"/>
      <xapl:for-each select="$userGrpVariable/AUTH_DOC[@Name=$domainType]/*" varName="idDoc">
        <xapl:if test="$idDoc/descendant::*/@Value=$currVar/@Value">
          <xapl:set-variable name="flag" select="'True'"/>
          <!--
          <docutil:set select="$idDoc/descendant::*/@Action='_VIEW_ONLY_'"/>
          -->
        </xapl:if>
      </xapl:for-each>
      <xapl:if test="$flag='False'">
        <docutil:add select="$userGrpVariable/AUTH_DOC[@Name=$domainType]">
          <AUTH_ID>
            <docutil:element name="{$nodeName}" Value="{$currVar/@Value}" Action="_VIEW_ONLY_"/>
          </AUTH_ID>
        </docutil:add>
      </xapl:if>
    </xapl:for-each>
    <xapl:print select="$userGrpVariable"/>
    <web:display-page>
      <web:get-page name="domainTree">
        <xapl:value-of select="$this/*"/>
        <NOT_FROM_GRP_DETAIL Value="True"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!-- **************************************************************************
************************************************************************** -->
  <x2:command public="yes" description="_" name="setDomainFormat">
    <xapl:print>******entered setDomainFormat************</xapl:print>
    <xapl:set-variable name="userGrpVariable">
      <AUTH_DOCS/>
    </xapl:set-variable>
    <xapl:for-each select="$domainVariable/*" varName="authDoc">
      <xapl:print select="$authDoc/@Name"/>
      <docutil:add select="$userGrpVariable">
        <AUTH_DOC Name="{$authDoc/@Name}"/>
      </docutil:add>
    </xapl:for-each>
  </x2:command>
  <!-- **************************************************************************
************************************************************************** -->
  <x2:command public="yes" description="_" name="remove">
    <xapl:print>**********entered remove</xapl:print>
    <xapl:print select="$this"/>
    <xapl:variable name="node" select="$this/node/@Value"/>
    <xapl:choose>
      <xapl:when test="contains($node,'#')">
        <xapl:variable name="authDoc" select="{substring-before($node,'#')}"/>
        <xapl:variable name="isView" select="{substring-after($node,'#')}"/>
        <xapl:choose>
          <xapl:when test="contains($isView,'#')">
            <xapl:variable name="isEdit" select="{substring-before($isView,'#')}"/>
            <xapl:variable name="id" select="{substring-after($isView,'#')}"/>
            <xapl:for-each select="$userGrpVariable/AUTH_DOC[@Name=$authDoc]/*" varName="idDoc">
              <xapl:if test="$idDoc/descendant::*/@Value=$id">
                <xapl:if test="$isEdit='View'">
                  <docutil:remove select="$idDoc"/>
                </xapl:if>
                <xapl:if test="$isEdit='Edit'">
                  <docutil:set select="$idDoc/descendant::*/@Action">
                    <xapl:value-of select="'_VIEW_ONLY_'"/>
                  </docutil:set>
                </xapl:if>
              </xapl:if>
            </xapl:for-each>
          </xapl:when>
          <xapl:otherwise>
            <xapl:choose>
              <xapl:when test="$isView='View'">
                <docutil:remove select="$userGrpVariable/AUTH_DOC[@Name=$authDoc]/*"/>
              </xapl:when>
              <xapl:otherwise>
                <xapl:print>************DID COME HERE****************</xapl:print>
                <xapl:print select="$node"/>
                <xapl:for-each select="$userGrpVariable/AUTH_DOC[@Name=$authDoc]/*" varName="idDoc">
                  <xapl:print>************B4****************</xapl:print>
                  <xapl:print select="$idDoc"/>
                  <xapl:if test="$idDoc/descendant::*/@Action='_ALL_'">
                    <xapl:print>************AFTER***************</xapl:print>
                    <xapl:print select="$idDoc"/>
                    <xapl:variable name="temp">
                      <xapl:value-of select="'_VIEW_ONLY_'"/>
                    </xapl:variable>
                    <xapl:print select="$temp"/>
                    <docutil:set select="$idDoc/descendant::*/@Action">
                      <xapl:value-of select="'_VIEW_ONLY_'"/>
                    </docutil:set>
                    <xapl:print select="'**********PRITNIG AFTER REMOVE******************'"/>
                    <xapl:print select="$idDoc"/>
                  </xapl:if>
                </xapl:for-each>
              </xapl:otherwise>
            </xapl:choose>
          </xapl:otherwise>
        </xapl:choose>
      </xapl:when>
      <xapl:otherwise>
        <docutil:delete-nodes select="$userGrpVariable/AUTH_DOC[@Name=$node]" name="AUTH_ID"/>
        <xapl:print select="$userGrpVariable/AUTH_DOC[@Name=$node]/*"/>
      </xapl:otherwise>
    </xapl:choose>
    <web:display-page>
      <web:get-page name="domainTree">
        <xapl:value-of select="$this/*"/>
        <NOT_FROM_GRP_DETAIL Value="True"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!-- **************************************************************************
************************************************************************** -->
  <x2:command public="yes" description="_" name="save">
    <xapl:print>*********PRINTING userGrpVariable</xapl:print>
    <xapl:print select="$userGrpVariable"/>
    <xapl:variable name="response">
      <xcore:execute-method name="//UserSecurity/manageUserGroupAuthorization" entireResponse="true">
        <USER_GRP_ID Value="{$userGroupXMLData/USER_GRP_PROFILE/ID/@Value}"/>
        <xapl:value-of select="$userGrpVariable/*"/>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:variable name="responseStatus">
      <x2:execute command="bcm.framework.user_admin.assignDomainController:getResponseStatus">
        <x2:with-param name="response" select="$response"/>
      </x2:execute>
    </xapl:variable>
    <docutil:set select="$this">
      <xapl:value-of select="$responseStatus"/>
    </docutil:set>
    <xapl:print select="$this"/>
    <xapl:choose>
      <xapl:when test="name($responseStatus) = 'ERROR_MESSAGE' ">
        <web:display-page>
          <web:get-page name="assignDomainToUserGrp">
            <NOT_FROM_GRP_DETAIL Value="True"/>
            <ERROR_MESSAGE Value="{$this/ERROR_MESSAGE/@Value}"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:otherwise>
        <docutil:set select="$this">
          <WHERE Value="USER_GROUP_MAIN"/>
          <SUCCESS_MESSAGE Value="{$responseStatus/SUCCESS_MESSAGE/@Value}"/>
        </docutil:set>
        <x2:execute command="bcm.framework.user_admin.user_admin_groups_new:goToPage">
          <x2:with-param name="this" select="$this"/>
        </x2:execute>
      </xapl:otherwise>
    </xapl:choose>
  </x2:command>
  <!-- **************************************************************************
************************************************************************** -->
  <x2:command public="yes" description="_" name="getResponseStatus">
    <x2:param name="response"/>
    <xapl:variable name="errorMessage"/>
    <xapl:variable name="successMessage"/>
    <xapl:set-variable name="errorMessage"/>
    <xapl:set-variable name="successMessage"/>
    <xapl:print>#######PRINTING RESPONSE</xapl:print>
    <xapl:print select="$response"/>
    <xapl:choose>
      <xapl:when test="not($response) or $response/@Status = 'Error' or $response/RESPONSE/@Status = 'Error' or $response/RESPONSE/_RESULT/@Value = 'ERROR' or $response/RESPONSE/@Status = 'Error' or $response/RESPONSE/_RESULT/@Value = 'SEVERE_ERROR' ">
        <xapl:choose>
          <xapl:when test="not(string-length($response/@Description) = 0)">
            <xapl:if test="contains($response/@Description, 'Error preparing stmt:')">
              <xapl:print>%%%%%%%%5ENTERED Error preparing stmt%%%%%%%%5</xapl:print>
              <xapl:set-variable name="errorMessage">
                <xapl:value-of select="{substring-before($response/@Description, 'Error preparing stmt:' )}"/>
              </xapl:set-variable>
            </xapl:if>
            <xapl:set-variable name="errorMessage">
              <xapl:value-of select="$response/@Description"/>
            </xapl:set-variable>
            <xapl:print>**********ENTERED THE ERROR HANDLING</xapl:print>
            <xapl:print select="errorMessage"/>
          </xapl:when>
          <xapl:when test="not(string-length($response/RESPONSE/@Description) = 0)">
            <xapl:set-variable name="errorMessage">
              <xapl:value-of select="{$response/RESPONSE/@Description}"/>
            </xapl:set-variable>
          </xapl:when>
          <xapl:when test="$response/RESPONSE/_RESULT/@Value = 'ERROR'">
            <xapl:set-variable name="errorMessage">
              <xapl:value-of select="{$response/RESPONSE/_RESULT/_ERROR/@Value}"/>
            </xapl:set-variable>
          </xapl:when>
        </xapl:choose>
      </xapl:when>
      <xapl:otherwise>
        <xapl:set-variable name="successMessage">Domain Assigned successfully.</xapl:set-variable>
      </xapl:otherwise>
    </xapl:choose>
    <xapl:print select="{$errorMessage}"/>
    <xapl:print select="{$successMessage}"/>
    <xapl:return>
      <xapl:if test="not(string-length($errorMessage) = 0)">
        <ERROR_MESSAGE Value="{$errorMessage}"/>
      </xapl:if>
      <xapl:if test="not(string-length($successMessage) = 0)">
        <SUCCESS_MESSAGE Value="{$successMessage}"/>
      </xapl:if>
    </xapl:return>
  </x2:command>
  <!-- **************************************************************************
************************************************************************** -->
 <x2:command public="yes" description="_" name="i18n">
    <i18n:text>Domain Assigned successfully.</i18n:text>
</x2:command>    
</x2:commands>
