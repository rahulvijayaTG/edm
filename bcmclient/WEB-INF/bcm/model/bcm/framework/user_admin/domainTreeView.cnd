<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- **********************************************************************
 *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
    <xapl:print select="$this"/>
    <xapl:print select="$userGroupXMLData"/>
    <xapl:variable name="userData"/>
    <xapl:if test="count($this/NOT_FROM_GRP_DETAIL)&lt; 1">
      <xapl:variable name="userId">
        <identity:get-user-id/>
      </xapl:variable>
      <xapl:variable name="data">
        <xcore:execute-method name="//UserSecurity/getUserAuthorization" entireResponse="true">
          <USER_ID Value="{$userId}"/>
        </xcore:execute-method>
      </xapl:variable>
      <xapl:set-variable name="domainVariable">
        <docutil:to-xml select="$data/RESPONSE/USR_GRP_AUTH_MAP/UG_AUTH_FORM/@Value"/>
      </xapl:set-variable>
      <xapl:set-variable name="userData">
        <xcore:execute-method name="//UserSecurity/getUserGroupAuthorization" entireResponse="true">
          <USER_GROUP_ID Value="{$userGroupXMLData/USER_GRP_PROFILE/ID/@Value}"/>
        </xcore:execute-method>
      </xapl:set-variable>
      <xapl:print select="$userData"/>
      <xapl:choose>
        <xapl:when test="count($userData/RESPONSE/USR_GRP_AUTH_MAP)&gt;0">
          <xapl:set-variable name="userGrpVariable">
            <docutil:to-xml select="$userData/RESPONSE/USR_GRP_AUTH_MAP/UG_AUTH_FORM/@Value"/>
          </xapl:set-variable>
        </xapl:when>
        <xapl:otherwise>
          <x2:execute command="bcm.framework.user_admin.assignDomainController:setDomainFormat"/>
        </xapl:otherwise>
      </xapl:choose>
      <xapl:print select="$userGrpVariable"/>
      <xapl:print select="$domainVariable"/>
    </xapl:if>
    <xapl:set-variable name="userData">
      <docutil:xml-to-string>
        <xapl:value-of select="{$userGrpVariable}"/>
      </docutil:xml-to-string>
    </xapl:set-variable>
    <xapl:print select="$userData"/>
    <xapl:print>PRINTING DATA
      <docutil:to-xml select="$userData"/>
    </xapl:print>
    <xapl:print select="$domainVariable"/>
    <xapl:return>
      <!-- Container-->
      <xapl:if test="count($this/ERROR_MESSAGE)&gt; 1">
        <ERROR_MESSAGE Value="{$this/ERROR_MESSAGE/@Value}"/>
      </xapl:if>
      <xapl:if test="count($this/SUCCESS_MESSAGE)&gt; 1">
        <SUCCESS_MESSAGE Value="{$this/SUCCESS_MESSAGE/@Value}"/>
      </xapl:if>
      <xapl:set-variable name="this" select=""/>
      <x2:execute command="bcm.framework.user_admin.domainTreeView:getContainer">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
      <docutil:to-xml select="$userData"/>
      <!-- return parameters-->
      <xapl:value-of select="$this/*[string-length(@Value) &gt; 0]"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <x2:param name="pPage"/>
    <xapl:return>
      <CONTAINER Scrollable="yes"/>
      <BUTTONS>
        <BUTTON Id="Cancel" Name="Cancel" DisplayText="Cancel" OnClick="javascript:onCancel()"/>
        <BUTTON Id="SaveAndReturn" Name="SaveAndReturn" DisplayText="Save And Return" OnClick="javascript:onSaveAndReturn()"/>
      </BUTTONS>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    <xapl:return>
      <HEADER>
        <APP_NAME Value="MDM"/>
        <TOGGLE_NAV Value="../"/>
        <HEADING Value="User Groups"/>
        <HEADING_LINK Value="{$pages:user_admin_group_search}"/>
        <HEADING2 Value="User Group Profile"/>
        <HEADING2_LINK Value="{$pages:user_group_profile_return}"/>
        <HEADING3 Value="{concat('Assign Domain : ' ,$userGroupXMLData/USER_GRP_PROFILE/GRP_NAME/@Value)}"/>
        <HOME Value="bcm/framework/home.jsp"/>
      </HEADER>
    </xapl:return>
  </x2:command>
</x2:commands>
