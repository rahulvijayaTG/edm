<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" description="_">
    <!-- ********************************************************************** 
  *********************************************************************** -->
    <!--x2:command name="init" public="yes" description="_">
      <xapl:variable name="userFavorites" resolver="session" global="true"/>
    </x2:command-->
    <!-- **********************************************************************
    *********************************************************************** -->
    <x2:command public="yes" description="_" name="initUserFavorites">
      <x2:param name="this"/>
      <xapl:if test="not($userFavorites)">
        <xapl:set-variable name="userFavorites">
          <Folder Name="Favorites"/>
        </xapl:set-variable>
      </xapl:if>
      <xapl:print>
          initUserFavorites:::
          <xapl:value-of select="$userFavorites"/>
      </xapl:print>
    </x2:command>
    <!-- **********************************************************************
    *********************************************************************** -->
    <x2:command public="yes" description="_" name="getUserFavorites">
      <xapl:print>
          getUserFavorites:::
          <xapl:value-of select="$userFavorites"/>
      </xapl:print>
      <xapl:return>
        <xapl:value-of select="$userFavorites"/>
      </xapl:return>
    </x2:command>
    <!-- **********************************************************************
    *********************************************************************** -->

  
    <x2:command public="yes" description="-" name="saveFavorite">
        <xapl:print select="$this"/>
        <xapl:print select="$loginUserId"/>
        <xapl:variable name="favIdRes">
            <xcore:execute-method name="//BCMMasterService/getUniqueId" entireResponse="true">
                <DOCUMENT_NAME Value="FAVORITE"/>
            </xcore:execute-method>
        </xapl:variable>
        <xapl:variable name="favId">
            <xapl:value-of select="$favIdRes/RESPONSE/UNIQUE_ID/@Value"/>        
        </xapl:variable>
        
        <xapl:variable name="pageUrl">
            <xapl:value-of select="$header/BREADCRUMBS/BREADCRUMB[ @Index = last() - 1]/URL/@Value"/>        
        </xapl:variable>
        
        <xapl:variable name="relativeUrl">
              <x2:execute command="bcm.framework.favorites.controller:removeEmptyParams">
                    <x2:with-param name="url" select="$pageUrl"/>
              </x2:execute>
        </xapl:variable>
        
        <xapl:variable name="favAttr"><xapl:value-of select="concat('&amp;FAV_ID=',$favId,'&amp;MODE=START')"/></xapl:variable>
        <xapl:variable name="favUrl">
            <xapl:value-of select="concat($relativeUrl, $favAttr)"/>
        </xapl:variable>
        
        <xapl:print>unique id
            <xapl:value-of select="{$favId}"/>
        </xapl:print>
      
      <xapl:print>
          UserFavorites:::
          <xapl:value-of select="$userFavorites"/>
          PageUrl::<xapl:value-of select="$favUrl"/>
          UserPreferences::  
                    <xapl:choose>
                        <xapl:when test="string-length($this/TABLE_NAME/@Value)>0">
                            <xapl:value-of select="{$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]}"/>
                        </xapl:when>
                        <xapl:otherwise>
                            <xapl:value-of select="{$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/FORM[@Name= $this/FORM_NAME[1]/@Value]}"/>
                        </xapl:otherwise>
                    </xapl:choose>      
      </xapl:print>
      
        <xapl:choose>
            <xapl:when test="string-length($this/selected_id/@Value) = 0 or $this/selected_id/@Value='Favorites_root'">
                <!--xapl:if test="count($userFavorites/Favorite[@Name=$this/favnametxt/@Value]) > 0">
                    <docutil:remove select="$userFavorites/Favorite[@Name=$this/favnametxt/@Value]"/>
                </xapl:if-->
                <docutil:add select="$userFavorites">
                    <Favorite Name="{$this/favnametxt/@Value}" Id="{$favId}" IsFolder="no" URL="{$favUrl}"/>
                </docutil:add>
            </xapl:when>
            <xapl:otherwise>
                <xapl:variable name="folderToAdd"/>
                <xapl:choose>
                    <xapl:when test="$userFavorites//*[@Id=$this/selected_id/@Value]/@IsFolder='yes'">
                        <xapl:set-variable name="folderToAdd">
                            <xapl:value-of select="$userFavorites//*[@Id=$this/selected_id/@Value]"/>
                        </xapl:set-variable>
                    </xapl:when>
                    <xapl:otherwise>
                        <xapl:set-variable name="folderToAdd">
                            <xapl:value-of select="$userFavorites//*[@Id=$this/selected_id/@Value]/parent::node()"/>
                        </xapl:set-variable>
                    </xapl:otherwise>
                </xapl:choose>
                <docutil:add select="$folderToAdd">
                    <Favorite Name="{$this/favnametxt/@Value}" Id="{$favId}" IsFolder="no" URL="{$favUrl}"/>
                </docutil:add>
            </xapl:otherwise>
        </xapl:choose>
        <xapl:variable name="saveFavoriteRes">
            <xcore:execute-method name="//UserSecurity/saveFavorite" entireResponse="true">
                <USER_ID Value="{$loginUserId}"/>
                <FAV_ID Value="{$favId}"/>
                <FAV_NAME Value="{$this/favnametxt/@Value}"/>
                <URL Value="{$favUrl}"/>
                <HIERARCHY_XML>
                    <xapl:value-of select="{$userFavorites}"/>
                </HIERARCHY_XML>
                <FAVORITE_XML>
                    <xapl:choose>
                        <xapl:when test="string-length($this/TABLE_NAME/@Value)>0">
                            <xapl:value-of select="{$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]}"/>
                        </xapl:when>
                        <xapl:otherwise>
                            <xapl:value-of select="{$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/FORM[@Name= $this/FORM_NAME[1]/@Value]}"/>
                        </xapl:otherwise>
                    </xapl:choose>      
                </FAVORITE_XML>
            </xcore:execute-method>
        </xapl:variable>
        <xapl:variable name="status">
              <x2:execute command="bcm.framework.util:getResponseStatus">
                    <x2:with-param name="response" select="$saveFavoriteRes"/>
                    <x2:with-param name="successMessage" select=" 'Favorite is saved successfully.' "/>
              </x2:execute>
            </xapl:variable>        
        <xapl:print select="$saveFavoriteRes"/>
        <xapl:choose>
            <xapl:when test="$saveFavoriteRes/@Status='Success'">
                <x2:execute command="bcm.framework.breadcrumb.controller:back"/>
            </xapl:when>
            <xapl:otherwise>
                <web:display-page>
                    <web:get-page name="createFavorite">
                        <xapl:value-of select="$this/*"/>
                        <xapl:value-of select="$status"/>
                     </web:get-page>
                </web:display-page>
            </xapl:otherwise>
        </xapl:choose>            
    </x2:command>
    

    <x2:command public="yes" description="-" name="updateFavorite">
        <xapl:print select="$this"/>
        <xapl:print select="$loginUserId"/>

        <xapl:variable name="favId"/>
        <xapl:variable name="favToUpdate"/>
        
      
        <xapl:choose>
            <xapl:when test="string-length($this/selected_id/@Value) = 0 or $this/selected_id/@Value='Favorites_root'">
                <xapl:set-variable name="favToUpdate">
                    <xapl:value-of select="$userFavorites/Favorite[@Name=$this/favnametxt/@Value]"/>
                </xapl:set-variable>
                <xapl:set-variable name="favId">
                    <xapl:value-of select="$favToUpdate/@Id"/>
                </xapl:set-variable>
            </xapl:when>
            <xapl:otherwise>
                <xapl:variable name="folderToAdd"/>
                <xapl:choose>
                    <xapl:when test="$userFavorites//*[@Id=$this/selected_id/@Value]/@IsFolder='yes'">
                        <xapl:set-variable name="folderToAdd">
                            <xapl:value-of select="$userFavorites//*[@Id=$this/selected_id/@Value]"/>
                        </xapl:set-variable>
                    </xapl:when>
                    <xapl:otherwise>
                        <xapl:set-variable name="folderToAdd">
                            <xapl:value-of select="$userFavorites//*[@Id=$this/selected_id/@Value]/parent::node()"/>
                        </xapl:set-variable>
                    </xapl:otherwise>
                </xapl:choose>
                <xapl:set-variable name="favToUpdate">
                    <xapl:value-of select="$folderToAdd/Favorite[@Name=$this/favnametxt/@Value]"/>
                </xapl:set-variable>
                <xapl:set-variable name="favId">
                    <xapl:value-of select="$folderToAdd/@Id"/>
                </xapl:set-variable>
            </xapl:otherwise>
        </xapl:choose>
        
        <xapl:variable name="pageUrl">
            <xapl:value-of select="$header/BREADCRUMBS/BREADCRUMB[ @Index = last() - 1]/URL/@Value"/>        
        </xapl:variable>
        
        <xapl:variable name="relativeUrl">
              <x2:execute command="bcm.framework.favorites.controller:removeEmptyParams">
                    <x2:with-param name="url" select="$pageUrl"/>
              </x2:execute>
        </xapl:variable>

        
        <!--xapl:variable name="relativeUrl">
            <xapl:value-of select="{substring-after(substring-after($pageUrl, '/'),'/')}"/>        
        </xapl:variable-->
        
        
        <xapl:variable name="favAttr"><xapl:value-of select="concat('FAV_ID=',$favId,'&amp;MODE=START')"/></xapl:variable>
        <xapl:variable name="favUrl">
            <xapl:value-of select="concat($relativeUrl, $favAttr)"/>
        </xapl:variable>
        
        <xapl:choose>
            <xapl:when test="string-length($this/selected_id/@Value) = 0 or $this/selected_id/@Value='Favorites_root'">
                <docutil:set select="$userFavorites/Favorite[@Name=$this/favnametxt/@Value]/@URL">
                    <xapl:value-of select="$favUrl"/>
                </docutil:set>
            </xapl:when>
            <xapl:otherwise>
                <xapl:variable name="folderToAdd"/>
                <xapl:choose>
                    <xapl:when test="$userFavorites//*[@Id=$this/selected_id/@Value]/@IsFolder='yes'">
                        <xapl:set-variable name="folderToAdd">
                            <xapl:value-of select="$userFavorites//*[@Id=$this/selected_id/@Value]"/>
                        </xapl:set-variable>
                    </xapl:when>
                    <xapl:otherwise>
                        <xapl:set-variable name="folderToAdd">
                            <xapl:value-of select="$userFavorites//*[@Id=$this/selected_id/@Value]/parent::node()"/>
                        </xapl:set-variable>
                    </xapl:otherwise>
                </xapl:choose>
                <docutil:set select="$folderToAdd/Favorite[@Name=$this/favnametxt/@Value]/@URL">
                    <xapl:value-of select="$favUrl"/>
                </docutil:set>
                
            </xapl:otherwise>
        </xapl:choose>

        
        <xapl:print>unique id
            <xapl:value-of select="{$favId}"/>
        </xapl:print>
      

      <xapl:print>
          UserFavorites:::
          <xapl:value-of select="$userFavorites"/>
          PageUrl::<xapl:value-of select="$favUrl"/>
          UserPreferences::  
                    <xapl:choose>
                        <xapl:when test="string-length($this/TABLE_NAME/@Value)>0">
                            <xapl:value-of select="{$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]}"/>
                        </xapl:when>
                        <xapl:otherwise>
                            <xapl:value-of select="{$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/FORM[@Name= $this/FORM_NAME[1]/@Value]}"/>
                        </xapl:otherwise>
                    </xapl:choose>      
      </xapl:print>

        
        
        <xapl:variable name="saveFavoriteRes">
            <xcore:execute-method name="//UserSecurity/saveFavorite" entireResponse="true">
                <USER_ID Value="{$loginUserId}"/>
                <FAV_ID Value="{$favId}"/>
                <FAV_NAME Value="{$this/favnametxt/@Value}"/>
                <URL Value="{$favUrl}"/>
                <HIERARCHY_XML>
                    <xapl:value-of select="{$userFavorites}"/>
                </HIERARCHY_XML>
                <FAVORITE_XML>
                    <xapl:choose>
                        <xapl:when test="string-length($this/TABLE_NAME/@Value)>0">
                            <xapl:value-of select="{$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]}"/>
                        </xapl:when>
                        <xapl:otherwise>
                            <xapl:value-of select="{$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/FORM[@Name= $this/FORM_NAME[1]/@Value]}"/>
                        </xapl:otherwise>
                    </xapl:choose>      
                </FAVORITE_XML>
            </xcore:execute-method>
        </xapl:variable>
        <xapl:variable name="status">
              <x2:execute command="bcm.framework.util:getResponseStatus">
                    <x2:with-param name="response" select="$saveFavoriteRes"/>
                    <x2:with-param name="successMessage" select=" 'Favorite is saved successfully.' "/>
              </x2:execute>
            </xapl:variable>        
        <xapl:print select="$saveFavoriteRes"/>
        <xapl:choose>
            <xapl:when test="$saveFavoriteRes/@Status='Success'">
                <x2:execute command="bcm.framework.breadcrumb.controller:back"/>
            </xapl:when>
            <xapl:otherwise>
                <web:display-page>
                    <web:get-page name="createFavorite">
                        <xapl:value-of select="$this/*"/>
                        <xapl:value-of select="$status"/>
                     </web:get-page>
                </web:display-page>
            </xapl:otherwise>
        </xapl:choose>            
    </x2:command>

    <x2:command public="yes" description="-" name="createFolder">
        <xapl:print select="$this"/>
        <xapl:variable name="folderId">
            <xcore:execute-method name="//BCMMasterService/getUniqueId" entireResponse="true">
                <DOCUMENT_NAME Value="FOLDER"/>
            </xcore:execute-method>
        </xapl:variable>
        <xapl:print>
              UserFavorites:::
              <xapl:value-of select="$userFavorites"/>
              PageUrl::
              <xapl:value-of select="$header/BREADCRUMBS/BREADCRUMB[ @Index = last() - 1]/URL/@Value"/>      
        </xapl:print>
        <xapl:choose>
            <xapl:when test="string-length($this/selected_id/@Value) = 0 or $this/selected_id/@Value='Favorites_root'">
                <docutil:add select="$userFavorites">
                    <Folder Name="{$this/favnametxt/@Value}" Id="{$folderId/RESPONSE/UNIQUE_ID/@Value}" IsFolder="yes"/>
                </docutil:add>
            </xapl:when>
            <xapl:otherwise>
                <xapl:variable name="folderToAdd"/>
                <xapl:choose>
                    <xapl:when test="$userFavorites//*[@Id=$this/selected_id/@Value]/@IsFolder='yes'">
                        <xapl:set-variable name="folderToAdd">
                            <xapl:value-of select="$userFavorites//*[@Id=$this/selected_id/@Value]"/>
                        </xapl:set-variable>
                    </xapl:when>
                    <xapl:otherwise>
                        <xapl:set-variable name="folderToAdd">
                            <xapl:value-of select="$userFavorites//*[@Id=$this/selected_id/@Value]/parent::node()"/>
                        </xapl:set-variable>
                    </xapl:otherwise>
                </xapl:choose>
            
                <docutil:add select="$folderToAdd">
                    <Folder Name="{$this/favnametxt/@Value}" Id="{$folderId/RESPONSE/UNIQUE_ID/@Value}" IsFolder="yes"/>
                </docutil:add>
            </xapl:otherwise>
        </xapl:choose>
        <xapl:variable name="saveFolderResponse">
            <xcore:execute-method name="//UserSecurity/saveFavoritesHierarchy" entireResponse="true">
                <USER_ID Value="{$loginUserId}"/>
                <HIERARCHY_XML>
                    <xapl:value-of select="{$userFavorites}"/>
                </HIERARCHY_XML>
            </xcore:execute-method>
        </xapl:variable>
        <xapl:choose>
            <xapl:when test="$this/IS_MANAGE_FAVORITES_PAGE/@Value = 'yes'">
                <web:display-page>
                    <web:get-page name="manageFavorites">
                        <xapl:value-of select="$this/*"/>
                     </web:get-page>
                </web:display-page>
            </xapl:when>
            <xapl:otherwise>
                <web:display-page>
                    <web:get-page name="createFavorite">
                        <xapl:value-of select="$this/*"/>
                     </web:get-page>
                </web:display-page>
            </xapl:otherwise>
        </xapl:choose>
    </x2:command>
    

    <x2:command public="yes" description="-" name="rename">
        <xapl:print select="$this"/>
        <xapl:print>
              UserFavorites:::
              <xapl:value-of select="$userFavorites"/>
              PageUrl::
              <xapl:value-of select="$header/BREADCRUMBS/BREADCRUMB[ @Index = last() - 1]/URL/@Value"/>      
              <xapl:value-of select="$this/favnametxt/@Value"/>
              <xapl:value-of select="$this/selected_id/@Value"/>
        </xapl:print>
        
        <xapl:choose>
            <xapl:when test="string-length($this/selected_id/@Value) = 0">
            </xapl:when>
            <xapl:when test="$this/selected_id/@Value='Favorites_root'">
                <docutil:set select="$userFavorites/@Name">
                    <xapl:value-of select="$this/favnametxt/@Value"/>
                </docutil:set>
            </xapl:when>
            <xapl:otherwise>
                <docutil:set select="$userFavorites//*[@Id=$this/selected_id/@Value]/@Name">
                    <xapl:value-of select="$this/favnametxt/@Value"/>
                </docutil:set>
            </xapl:otherwise>
        </xapl:choose>
        <xapl:variable name="saveFolderResponse">
            <xcore:execute-method name="//UserSecurity/saveFavoritesHierarchy" entireResponse="true">
                <USER_ID Value="{$loginUserId}"/>
                <HIERARCHY_XML>
                    <xapl:value-of select="{$userFavorites}"/>
                </HIERARCHY_XML>
            </xcore:execute-method>
        </xapl:variable>
        <web:display-page>
            <web:get-page name="manageFavorites">
                <xapl:value-of select="$this/*"/>
             </web:get-page>
        </web:display-page>
    </x2:command>

    <x2:command public="yes" description="-" name="delete">
        <xapl:print select="$this"/>
        <xapl:print>
              UserFavorites:::
              <xapl:value-of select="$userFavorites"/>
              PageUrl::
              <xapl:value-of select="$header/BREADCRUMBS/BREADCRUMB[ @Index = last() - 1]/URL/@Value"/>      
              <xapl:value-of select="$this/favnametxt/@Value"/>
              <xapl:value-of select="$this/selected_id/@Value"/>
        </xapl:print>
        
        <xapl:variable name="updatedFavHierarchy">
            <xapl:clone select="$userFavorites"/>
        </xapl:variable>
        <docutil:remove select="$updatedFavHierarchy//*[@Id=$this/selected_id/@Value]"/>
        <xapl:print select="$updatedFavHierarchy"/>
        
        <xapl:variable name="deleteFavResponse"/>
        <xapl:variable name="favoriteList">
            <FAVORITES_LIST/>
        </xapl:variable>

        <xapl:choose>
            <xapl:when test="$this/isFolder/@Value='yes'">
                <xapl:variable name="folderToRemove">
                    <xapl:value-of select="$userFavorites//*[@Id=$this/selected_id/@Value]"/>
                </xapl:variable>
                <xapl:print>
                    <xapl:value-of select="$folderToRemove"/>
                    <xapl:value-of select="$favoriteList"/>
                </xapl:print> 
                <xapl:for-each select="$folderToRemove//Favorite" varName="favorite">
                    <docutil:add select="$favoriteList">
                        <xapl:value-of select="$favorite"/>
                    </docutil:add>
                </xapl:for-each>
                <xapl:print>
                    <xapl:value-of select="$favoriteList"/>
                </xapl:print> 
            </xapl:when>
            <xapl:otherwise>
                <docutil:add select="$favoriteList">
                    <xapl:value-of select="$userFavorites//Favorite[@Id=$this/selected_id/@Value]"/>
                </docutil:add>
            </xapl:otherwise>
        </xapl:choose>
        
        <xapl:set-variable name="deleteFavResponse">
            <xapl:choose>
                <xapl:when test="count($favoriteList/Favorite) > 0 ">
                    <xcore:execute-method name="//UserSecurity/deleteFavorite" entireResponse="true">
                        <USER_ID Value="{$loginUserId}"/>
                        <HIERARCHY_XML>
                            <xapl:value-of select="{$updatedFavHierarchy}"/>
                        </HIERARCHY_XML>
                        <xapl:value-of select="{$favoriteList}"/>
                        <FAV_ID Value="{$this/selected_id/@Value}"/>
                    </xcore:execute-method>
                </xapl:when>
                <xapl:otherwise>
                    <RESPONSES>
                        <RESPONSE Status="Success"/>
                    </RESPONSES>    
                </xapl:otherwise>
           </xapl:choose> 
        </xapl:set-variable>
        
        <xapl:if test="$deleteFavResponse/RESPONSE/@Status='Success'">
            <xapl:set-variable name="userFavorites">
                <xapl:value-of select="$updatedFavHierarchy"/>
            </xapl:set-variable>
        </xapl:if>
        <xapl:print select="$deleteFavResponse"/>
        
        <web:display-page>
            <web:get-page name="manageFavorites">
                <xapl:value-of select="$this/*"/>
             </web:get-page>
        </web:display-page>
    </x2:command>

    <x2:command public="yes" description="-" name="moveToFolder">
        <xapl:print select="$this"/>
        <xapl:print>
              UserFavorites:::
              <xapl:value-of select="$userFavorites"/>
              PageUrl::
              <xapl:value-of select="$header/BREADCRUMBS/BREADCRUMB[ @Index = last() - 1]/URL/@Value"/>      
              <xapl:value-of select="$this/favnametxt/@Value"/>
              <xapl:value-of select="$this/selected_id/@Value"/>
        </xapl:print>
        
        <xapl:choose>
            <xapl:when test="string-length($this/selected_id/@Value) = 0 or $this/selected_id/@Value='Favorites_root'">
            </xapl:when>
            <xapl:otherwise>
                <xapl:variable name="sourceNode">
                    <xapl:value-of select="$userFavorites//*[@Id=$this/selected_id/@Value]"/>
                </xapl:variable>
                <xapl:variable name="folderToMove">
                    <xapl:value-of select="$userFavorites//*[@Id=$this/selected_target_id/@Value]"/>
                </xapl:variable>
                <xapl:choose>
                    <xapl:when test="count($folderToMove/child::*[@Name=$this/selected_name/@Value])>0">
                        <xapl:print>duplicate</xapl:print>
                        <xapl:variable name="errMsg">
                            <i18n:text>Name already exists in the target folder.</i18n:text>                            
                        </xapl:variable>
                        <web:display-page>
                            <web:get-page name="manageFavorites">
                                <ERROR_MESSAGE Value="{$errMsg}"/>
                                <xapl:value-of select="$this/*"/>
                             </web:get-page>
                        </web:display-page>
                    </xapl:when>
                </xapl:choose>
                <docutil:remove select="$userFavorites//*[@Id=$this/selected_id/@Value]"/>
                <xapl:choose>
                    <xapl:when test="string-length($this/selected_target_id/@Value) = 0 or $this/selected_target_id/@Value='Favorites_root'">
                        <docutil:add select="$userFavorites">
                            <xapl:value-of select="$sourceNode"/>
                        </docutil:add>
                    </xapl:when>
                    <xapl:otherwise>
                        <docutil:add select="$userFavorites//*[@Id=$this/selected_target_id/@Value]">
                            <xapl:value-of select="$sourceNode"/>
                        </docutil:add>
                    </xapl:otherwise>
                </xapl:choose>      
                <xapl:print> 
                    folder/fav to move:: <xapl:value-of select="$sourceNode"/>
                    userFavorites after Move :: <xapl:value-of select="$userFavorites"/>
                </xapl:print>
            </xapl:otherwise>
        </xapl:choose>
        <xapl:variable name="saveFolderResponse">
            <xcore:execute-method name="//UserSecurity/saveFavoritesHierarchy" entireResponse="true">
                <USER_ID Value="{$loginUserId}"/>
                <HIERARCHY_XML>
                    <xapl:value-of select="{$userFavorites}"/>
                </HIERARCHY_XML>
            </xcore:execute-method>
        </xapl:variable>
        <web:display-page>
            <web:get-page name="manageFavorites">
                <xapl:value-of select="$this/*"/>
             </web:get-page>
        </web:display-page>

    </x2:command>

    <x2:command public="yes" description="-" name="moveUp">
        <xapl:print select="$this"/>
        <xapl:print>
              UserFavorites:::
              <xapl:value-of select="$userFavorites"/>
              PageUrl::
              <xapl:value-of select="$header/BREADCRUMBS/BREADCRUMB[ @Index = last() - 1]/URL/@Value"/>      
              <xapl:value-of select="$this/favnametxt/@Value"/>
              <xapl:value-of select="$this/selected_id/@Value"/>
        </xapl:print>
        
        <xapl:choose>
            <xapl:when test="string-length($this/selected_id/@Value) = 0 or $this/selected_id/@Value='Favorites_root'">
            </xapl:when>
            <xapl:otherwise>
                <xapl:variable name="updatedFavHierarchy">
                    <xapl:clone select="$userFavorites"/>
                </xapl:variable>
                <xapl:variable name="MoveFromNode">
                    <xapl:value-of select="$updatedFavHierarchy//*[@Id=$this/selected_id/@Value]"/>
                </xapl:variable>
                <xapl:variable name="MoveToId">
                    <xapl:value-of select="$updatedFavHierarchy//*[@Id=$this/selected_id/@Value]/preceding-sibling::*[1]/@Id"/>
                </xapl:variable>
                <xapl:variable name="MoveToNode">
                    <xapl:value-of select="$updatedFavHierarchy//*[@Id=$MoveToId]"/>
                </xapl:variable>
                <xapl:variable name="followingNodes">
                    <xapl:value-of select="$updatedFavHierarchy//*[@Id=$this/selected_id/@Value]/following-sibling::*"/>
                </xapl:variable>
                <xapl:variable name="parentNode">
                    <xapl:value-of select="$updatedFavHierarchy//*[@Id=$MoveToId]/parent::node()"/>
                </xapl:variable>
                <docutil:remove select="$userFavorites//*[@Id=$MoveToId]/following-sibling::*"/>
                <docutil:remove select="$userFavorites//*[@Id=$MoveToId]"/>
                
                <xapl:choose>
                    <xapl:when test="$parentNode/@Id='Favorites_root'">
                        <docutil:add select="$userFavorites">
                            <xapl:value-of select="$MoveFromNode"/>
                        </docutil:add> 
                        <docutil:add select="$userFavorites">
                            <xapl:value-of select="$MoveToNode"/>
                        </docutil:add> 
                        <docutil:add select="$userFavorites">
                            <xapl:value-of select="$followingNodes"/>
                        </docutil:add> 
                    </xapl:when>
                    <xapl:otherwise>
                        <docutil:add select="$userFavorites//*[@Id=$parentNode/@Id]">
                            <xapl:value-of select="$MoveFromNode"/>
                        </docutil:add> 
                        <docutil:add select="$userFavorites//*[@Id=$parentNode/@Id]">
                            <xapl:value-of select="$MoveToNode"/>
                        </docutil:add> 
                        <docutil:add select="$userFavorites//*[@Id=$parentNode/@Id]">
                            <xapl:value-of select="$followingNodes"/>
                        </docutil:add> 
                    </xapl:otherwise>
                </xapl:choose>    
                <xapl:print>
                    MOVE FROM ::: <xapl:value-of select="$MoveFromNode/@Name"/>
                     TO :::<xapl:value-of select="$MoveToNode/@Name"/>
                     parent ::: <xapl:value-of select="$parentNode/@Name"/>
                     successors::<xapl:value-of select="$followingNodes"/>
                     updated favorites :::
                     <xapl:value-of select="$userFavorites"/>
                </xapl:print>
            </xapl:otherwise>
        </xapl:choose>
        <xapl:variable name="saveFolderResponse">
            <xcore:execute-method name="//UserSecurity/saveFavoritesHierarchy" entireResponse="true">
                <USER_ID Value="{$loginUserId}"/>
                <HIERARCHY_XML>
                    <xapl:value-of select="{$userFavorites}"/>
                </HIERARCHY_XML>
            </xcore:execute-method>
        </xapl:variable>
        <web:display-page>
            <web:get-page name="manageFavorites">
                <xapl:value-of select="$this/*"/>
             </web:get-page>
        </web:display-page>
    </x2:command>    

    <x2:command public="yes" description="-" name="moveDown">
        <xapl:print select="$this"/>
        <xapl:print>
              UserFavorites:::
              <xapl:value-of select="$userFavorites"/>
              PageUrl::
              <xapl:value-of select="$header/BREADCRUMBS/BREADCRUMB[ @Index = last() - 1]/URL/@Value"/>      
              <xapl:value-of select="$this/favnametxt/@Value"/>
              <xapl:value-of select="$this/selected_id/@Value"/>
        </xapl:print>
        
        <xapl:choose>
            <xapl:when test="string-length($this/selected_id/@Value) = 0 or $this/selected_id/@Value='Favorites_root'">
            </xapl:when>
            <xapl:otherwise>
                <xapl:variable name="updatedFavHierarchy">
                    <xapl:clone select="$userFavorites"/>
                </xapl:variable>
                <xapl:variable name="MoveFromNode">
                    <xapl:value-of select="$updatedFavHierarchy//*[@Id=$this/selected_id/@Value]"/>
                </xapl:variable>
                <xapl:variable name="MoveToId">
                    <xapl:value-of select="$updatedFavHierarchy//*[@Id=$this/selected_id/@Value]/following-sibling::*[1]/@Id"/>
                </xapl:variable>
                
                <xapl:if test="string-length($MoveToId) > 0">
                    <xapl:variable name="MoveToNode">
                        <xapl:value-of select="$updatedFavHierarchy//*[@Id=$MoveToId]"/>
                    </xapl:variable>
                    <xapl:variable name="followingNodes">
                        <xapl:value-of select="$updatedFavHierarchy//*[@Id=$MoveToId]/following-sibling::*"/>
                    </xapl:variable>
                    <xapl:variable name="parentNode">
                        <xapl:value-of select="$updatedFavHierarchy//*[@Id=$MoveToId]/parent::node()"/>
                    </xapl:variable>
                    <docutil:remove select="$userFavorites//*[@Id=$this/selected_id/@Value]/following-sibling::*"/>
                    <docutil:remove select="$userFavorites//*[@Id=$this/selected_id/@Value]"/>

                    <xapl:choose>
                        <xapl:when test="$parentNode/@Id='Favorites_root'">
                            <docutil:add select="$userFavorites">
                                <xapl:value-of select="$MoveToNode"/>
                            </docutil:add> 
                            <docutil:add select="$userFavorites">
                                <xapl:value-of select="$MoveFromNode"/>
                            </docutil:add> 
                            <docutil:add select="$userFavorites">
                                <xapl:value-of select="$followingNodes"/>
                            </docutil:add> 
                        </xapl:when>
                        <xapl:otherwise>
                            <docutil:add select="$userFavorites//*[@Id=$parentNode/@Id]">
                                <xapl:value-of select="$MoveToNode"/>
                            </docutil:add> 
                            <docutil:add select="$userFavorites//*[@Id=$parentNode/@Id]">
                                <xapl:value-of select="$MoveFromNode"/>
                            </docutil:add> 
                            <docutil:add select="$userFavorites//*[@Id=$parentNode/@Id]">
                                <xapl:value-of select="$followingNodes"/>
                            </docutil:add> 
                        </xapl:otherwise>
                    </xapl:choose>    
                    <xapl:print>
                        MOVE FROM ::: <xapl:value-of select="$MoveFromNode/@Name"/>
                         TO :::<xapl:value-of select="$MoveToNode/@Name"/>
                         parent ::: <xapl:value-of select="$parentNode/@Name"/>
                         successors::<xapl:value-of select="$followingNodes"/>
                         updated favorites :::
                         <xapl:value-of select="$userFavorites"/>
                    </xapl:print>
                    <xapl:variable name="saveFolderResponse">
                        <xcore:execute-method name="//UserSecurity/saveFavoritesHierarchy" entireResponse="true">
                            <USER_ID Value="{$loginUserId}"/>
                            <HIERARCHY_XML>
                                <xapl:value-of select="{$userFavorites}"/>
                            </HIERARCHY_XML>
                        </xcore:execute-method>
                    </xapl:variable>
                 </xapl:if>   
            </xapl:otherwise>
        </xapl:choose>
        <web:display-page>
            <web:get-page name="manageFavorites">
                <xapl:value-of select="$this/*"/>
             </web:get-page>
        </web:display-page>
    </x2:command>    
    
    <x2:command public="yes" description="_" name="removeEmptyParams">
        <x2:param name="url"/>
        
        <xapl:variable name="relativeUrl">
            <xapl:value-of select="{substring-after(substring-after($url, '/'),'/')}"/>        
        </xapl:variable>
        <xapl:variable name="baseUrl">
            <xapl:value-of select="{concat(substring-before($relativeUrl,'?'),'?')}"/>        
        </xapl:variable>
        <xapl:variable name="params">
            <xapl:value-of select="{substring-after($relativeUrl,'?')}"/>        
        </xapl:variable>
        <xapl:print select="$params"/>
        <xapl:variable name="paramXML">
          <x2:execute command="bcm.framework.util:createXMLFromString">
            <x2:with-param name="string" select="$params"/>
            <x2:with-param name="delimeter" select="'&amp;'"> </x2:with-param>
            <x2:with-param name="tagname" select="'PARAM'"></x2:with-param>
          </x2:execute>
        </xapl:variable>
        <xapl:print select="$paramXML"/>
        <xapl:for-each select="$paramXML/PARAM" varName="currentParam">
            <xapl:variable name="paramName">
                <xapl:value-of select="{substring-before($currentParam/@Value,'=')}"/>
            </xapl:variable>
            <xapl:variable name="paramVal">
                <xapl:value-of select="{substring-after($currentParam/@Value,'=')}"/>
            </xapl:variable>
            <xapl:if test="string-length($paramVal)>0 and $paramName!='FAV_ID' and $paramName!='MODE'">
                <xapl:set-variable name="baseUrl">
                    <xapl:value-of select="{concat($baseUrl,$currentParam/@Value,'&amp;')}"/>                    
                </xapl:set-variable>
            </xapl:if>
        </xapl:for-each>
        
        <xapl:print select="$baseUrl"/>
        
        <xapl:return>
            <xapl:value-of select="$baseUrl"/>
        </xapl:return>
    </x2:command>
</x2:commands>
    