<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="init" public="yes" description="_">
  </x2:command>
  <!-- **********************************************************************
       *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
    <xapl:print select="$this"/>
    <xapl:print select="$userFavorites"/>
    <!-- BREADCRUMBS AT TOP OR AFTER CLEAN-CONTEXT-->
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
      <x2:with-param name="display" select="'Create Favorite Page'"/>
      <x2:with-param name="page" select="'createFavorite'"/>
      <x2:with-param name="this" select="{$this}"/>
    </x2:execute>
    
    <!--xapl:variable name="favoriteTree">
        <Folder Name="Favorite">
            <Folder Name="Supply Chains">
                <Folder Name="BOM">
                    <Favorite Name="Finished Goods" Id="1"/>
                    <Favorite Name="Jumbo" Id="2"/>
                </Folder>
                <Folder Name="ROUTINGS">
                    <Folder Name="FAB">
                        <Favorite Name="Fab1" Id="3"/>
                        <Favorite Name="Fab 2" Id="4"/>
                    </Folder>
                </Folder>
                <Folder Name="OtherFolder"/>
            </Folder>
        </Folder>
    </xapl:variable-->    
    <xapl:variable name="fromUrl">
        <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
    </xapl:variable>

    <xapl:return>
      <!-- Page Header-->
      <x2:execute command="bcm.framework.favorites.createView:getHeader">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
      <!-- Top Level Container -->
      <x2:execute command="bcm.framework.favorites.createView:getContainer">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
        
      <xapl:value-of select="$userFavorites"/>
      <xapl:value-of select="$this/*"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    <xapl:return>
      <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
        <xapl:return>
      <CONTAINER Scrollable="yes">
        <!--HELP Url="{$helpFile}"/-->
        <STEP Name="EditTable" DisplayText="Favorite Manager" Selected="true">
          <BUTTONS>
            <BUTTON Id="createFolder" Name="createFolder" DisplayText="Create Folder" OnClick="javascript:createFolder()"/>
            <BUTTON Id="cancel" Name="Cancel" DisplayText="Cancel" OnClick="javascript:onCancel()"/>
            <BUTTON Id="save_and_return" Name="SaveAndReturn" DisplayText="Save Favorite" OnClick="javascript:onSaveAndReturn()" Emphasized="true"/>
          </BUTTONS>
        </STEP>
      </CONTAINER>
    </xapl:return>
  </x2:command>
</x2:commands>
