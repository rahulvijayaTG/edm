  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getNCForms">
    <docutil:add select="$metaDataForms">
      <SERVICE Name="BCMNCService">
        <xcore:execute-method name="//BCMNCService/getForms"/>
      </SERVICE>
    </docutil:add>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getMasterForms">
    <docutil:add select="$metaDataForms">
      <SERVICE Name="BCMMasterService">
        <xcore:execute-method name="//BCMMasterService/getForms"/>
      </SERVICE>
    </docutil:add>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getADWForms">
    <docutil:add select="$metaDataForms">
      <SERVICE Name="ADWService">
        <xcore:execute-method name="//ADWService/getForms"/>
      </SERVICE>
    </docutil:add>
    <!--xapl:print>
      inGetADWForms->metaDataForms
      <xapl:value-of select="$metaDataForms"/>
    </xapl:print-->
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getOutboundForms">
    <docutil:add select="$metaDataForms">
      <SERVICE Name="BCMOutboundService">
        <xcore:execute-method name="//BCMOutboundService/getForms"/>
      </SERVICE>
    </docutil:add>
  </x2:command>
  <!-- **********************************************************************
  **************************  FOLDERS  ************************************ -->
  <x2:command public="yes" description="_" name="getInputFolders">
    <!--EQ:568412 Modified getFolders. Folder should contain documents that have Source =SOURCE and not of class TABLE_CLASS -->
    <xapl:set-variable name="inputFolders">
      <xcore:execute-method name="//BCMINService/getFolders" entireResponse="false">
        <ROOT>
			     <SOURCE Value="BACKEND"/>
			     <SOURCE Value="BOTH"/>
			     <TABLE_CLASS Value="TRANSACTION"/>
			     <TABLE_CLASS Value="PLAN"/>
			  </ROOT>
      </xcore:execute-method>
    </xapl:set-variable>
  </x2:command>

    <x2:command public="yes" description="_" name="getErrorFolders">
      <xapl:set-variable name="errorFolders">
        <xcore:execute-method name="//BCMINService/getErrorFolders" entireResponse="false">
           <ROOT>
					    <SOURCE Value="BACKEND"/>
					    <SOURCE Value="BOTH"/>
					 </ROOT>
      </xcore:execute-method>
      </xapl:set-variable>
      <docutil:remove select="$errorFolders//DOCUMENT[@AuditTrail]"/>


    <xapl:print> chandi Error folders <xapl:value-of select="$errorFolders"/>
    </xapl:print>
    </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getNcFolders">
    <!--EQ:568412 Modified getFolders. Folder should contain documents that have Source =SOURCE and not of class TABLE_CLASS -->
    <xapl:set-variable name="ncFolders">
      <xcore:execute-method name="//BCMNCService/getFolders" entireResponse="false">
        <ROOT>
          <SOURCE Value="BACKEND"/>
          <SOURCE Value="BOTH"/>
          <TABLE_CLASS Value="TRANSACTION"/>
          <TABLE_CLASS Value="PLAN"/>
        </ROOT>
      </xcore:execute-method>
    </xapl:set-variable>
    <docutil:remove select="$ncFolders//DOCUMENT[@AuditTrail]"/>

  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getMasterFolders">
    <xapl:variable name="masterFoldersAll">
      <ROOT>
        <xcore:execute-method name="//BCMMasterService/getFolders" entireResponse="false"/>
      </ROOT>
    </xapl:variable>
    <xapl:variable name="masterFolders1">
      <xapl:clone select="{$masterFoldersAll}"/>
    </xapl:variable>
    <docutil:remove select="$masterFolders1/ALL_FOLDERS/FOLDER/DOCUMENTS/DOCUMENT[@AuditTrail]"/>
    <xapl:set-variable name="masterFolders">
      <xapl:value-of select="{$masterFolders1/*}"/>
    </xapl:set-variable>
    <xapl:variable name="masterFolders2">
      <xapl:clone select="{$masterFoldersAll}"/>
    </xapl:variable>
    <docutil:remove select="$masterFolders2/ALL_FOLDERS/FOLDER/DOCUMENTS/DOCUMENT[not(@AuditTrail)]"/>
    <docutil:remove select="$masterFolders2/ALL_FOLDERS/FOLDER[count(DOCUMENTS/DOCUMENT[@AuditTrail]) = 0]"/>
    <xapl:set-variable name="masterAuditTrailFolders">
      <xapl:value-of select="{$masterFolders2/*}"/>
    </xapl:set-variable>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getOutboundFolders">
    <xapl:set-variable name="outboundFolders">
      <xcore:execute-method name="//BCMOutboundService/getFolders" entireResponse="false">
			       <ROOT>
							 <SOURCE Value="BACKEND"/>
							 <SOURCE Value="BOTH"/>
							 <SOURCE Value="MASTER"/>
							 <TABLE_CLASS Value="TRANSACTION"/>
							 <TABLE_CLASS Value="PLAN"/>
						  </ROOT>
			</xcore:execute-method>
    </xapl:set-variable>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getAdwFolders">
    <xapl:set-variable name="adwFolders">
      <xcore:execute-method name="//ADWService/getFolders" entireResponse="false"/>
    </xapl:set-variable>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getUserSecurityForms">
    <docutil:add select="$metaDataForms">
      <SERVICE Name="UserSecurity">
        <xcore:execute-method name="//UserSecurity/getForms"/>
      </SERVICE>
    </docutil:add>
  </x2:command>
  <!-- **********************************************************************
      *********************************************************************** -->
  <x2:command public="yes" description="_" name="getUserSecurityTables">
      <xapl:variable name="xCoreSrvcName">
      <x2:get-xcore-service-name name="UserSecurity"/>
    </xapl:variable>

    <docutil:add select="$metaData">
      <SERVICE Name="UserSecurity" xName="{$xCoreSrvcName}">
        <xcore:execute-method name="//UserSecurity/getTables" entireResponse="false"/>
      </SERVICE>
    </docutil:add>
  </x2:command>
  <!-- **********************************************************************
      *********************************************************************** -->
  <x2:command public="yes" description="_" name="getInstances">
    <xapl:variable name="response">
      <xcore:execute-method name="//BCMMasterService/getInstances" entireResponse="true"/>
    </xapl:variable>
    <xapl:for-each select="$response/RESPONSE/SQL_RESULT" varName="child">
      <docutil:add select="$appInstances">
        <instanceID Value="{$child/INSTANCE_ID/@Value}"/>
      </docutil:add>
    </xapl:for-each>
    <xapl:print>PRINTING appInstances DURING RELOAD ... </xapl:print>
    <xapl:print select="{$appInstances}"/>
  </x2:command>
  <!-- **********************************************************************
      *********************************************************************** -->
  <x2:command public="yes" description="_" name="getInstanceEnabled">
    <xapl:variable name="response">
      <xcore:execute-method name="//BCMMasterService/isInstanceEnabled" entireResponse="false"/>
    </xapl:variable>
    <xapl:set-variable name="appInstanceEnabled" select="$response/@Value"/>
    <xapl:print>PRINTING INSTANCEENABLED DURING RELOAD ... </xapl:print>
    <xapl:print select="{$appInstanceEnabled}"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getDataValidationForms">
    <docutil:add select="$metaDataForms">
      <SERVICE Name="dataValidationService">
        <xcore:execute-method name="//dataValidationService/getForms"/>
      </SERVICE>
    </docutil:add>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
</x2:commands>
