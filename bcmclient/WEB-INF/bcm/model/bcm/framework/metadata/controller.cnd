    </xapl:variable>
    <docutil:add select="$metaData">
      <SERVICE Name="BCMOutboundService"  xName="{$xCoreSrvcName}">
        <xcore:execute-method name="//BCMOutboundService/getTables" entireResponse="false"/>
      </SERVICE>
    </docutil:add>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getMasterTables">
    <xapl:variable name="xCoreSrvcName">
      <x2:get-xcore-service-name name="BCMMasterService"/>
    </xapl:variable>

	<docutil:add select="$metaData">
      <SERVICE Name="BCMMasterService"  xName="{$xCoreSrvcName}">
        <xcore:execute-method name="//BCMMasterService/getTables" entireResponse="false"/>
  	  </SERVICE>
    </docutil:add>
