<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:scenario="http://www.i2.com/scenario" xmlns:bcm="http://www.i2.com/bcm" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:identity="http://www.i2.com/identity" xmlns:i18n="http://www.i2.com/i18n" description="_">
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="init" public="yes" description="_">
    <xapl:print>PRINTING INSIDE BCM MODEL BCM FRAMEWORK INSTANCES CONTROLLER</xapl:print>
    <xapl:variable name="currentInstance" resolver="session" global="true"/>
    <xapl:variable name="currentUsersInstances" resolver="session" global="true"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="onSelectInstance">
    <xapl:set-variable name="currentInstance" select="{$this/combo_instanceID/@Value}"/>
    <xapl:print select="$currentInstance"/>
    <!-- Fetch base scenario for selected instance -->
    <xapl:variable name="response">
      <xcore:execute-method name="//BCMMasterService/getBaseScenarioForInstance" entireResponse="false">
        <instanceID Value="{$currentInstance}"/>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:print select="$response"/>
    <xapl:variable name="scName" select="{$response/name/@Value}"/>
    <xapl:print select="$scName"/>
    <!-- Set scenario to the scenarioID in $response -->
    <scenario:set-scenario ScenarioId="{$response/scenarioID/@Value}"/>
    <xapl:variable name="currentScenario">
      <scenario:get-scenario-id/>
    </xapl:variable>
    <xapl:print select="$currentScenario"/>
    
    <!-- set the security variables so it will force user to set security context for new instance -->
    <x2:execute command="bcm.framework.login:setSecurityVars"/>
    
    <web:display-page>
      <web:get-page name="solutionIndex">
        <ACTIVITY Value="bcmReferenceStaging"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
</x2:commands>
