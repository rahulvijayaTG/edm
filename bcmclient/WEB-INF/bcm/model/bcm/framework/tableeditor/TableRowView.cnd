<!-- ONLINE HELP -->

    <xapl:variable name="helpDirectory">
        <xapl:value-of select="{$helpFileDirectory}"/>
    </xapl:variable>
    <xapl:print select="$helpDirectory"/>

    <xapl:variable name="helpFile">
      <xapl:choose>
        <xapl:when test=" $this/TABLE_ROW_OPERATION/@Value = 'EDIT' ">
        <xapl:choose>
	        <xapl:when test="$helpFileName/TABLE_HELPFILE_MAP/*[@Name=$this/TABLE_NAME[1]/@Value] and string-length($helpFileName/TABLE_HELPFILE_MAP/*[@Name=$this/TABLE_NAME[1]/@Value]/@editHelpFile) > 0">
	              <xapl:value-of select="concat($helpDirectory,'/',$helpFileName/TABLE_HELPFILE_MAP/*[@Name=$this/TABLE_NAME[1]/@Value]/@editHelpFile)"/>
	        </xapl:when>
	        <xapl:otherwise>
	  	      <xapl:value-of select="concat($helpDirectory,'/',$helpFileName/DEFAULT_HELP_FILENAME/@editHelpFile)"/>
	        </xapl:otherwise>

	</xapl:choose>
        </xapl:when>

        <xapl:when test=" $this/TABLE_ROW_OPERATION/@Value = 'ADD' ">
        <xapl:choose>
        	<xapl:when test="$helpFileName/TABLE_HELPFILE_MAP/*[@Name=$this/TABLE_NAME[1]/@Value] and string-length($helpFileName/TABLE_HELPFILE_MAP/*[@Name=$this/TABLE_NAME[1]/@Value]/@createHelpFile) > 0">
          <xapl:print>INSIDE IFTEST</xapl:print>
          <xapl:print><xapl:value-of select="$helpFileName/TABLE_HELPFILE_MAP/*[@Name=$this/TABLE_NAME[1]/@Value]/@createHelpFile"/></xapl:print>

        	      <xapl:value-of select="concat($helpDirectory,'/',$helpFileName/TABLE_HELPFILE_MAP/*[@Name=$this/TABLE_NAME[1]/@Value]/@createHelpFile)"/>
        	</xapl:when>
	        <xapl:otherwise>
          <xapl:print>INSIDE ELSETEST</xapl:print>
	  	      <xapl:value-of select="concat($helpDirectory,'/',$helpFileName/DEFAULT_HELP_FILENAME/@createHelpFile)"/>
	        </xapl:otherwise>
	</xapl:choose>
	</xapl:when>

        <xapl:when test=" $this/TABLE_ROW_OPERATION/@Value = 'COPY' ">
        <xapl:choose>
        	<xapl:when test="$helpFileName/TABLE_HELPFILE_MAP/*[@Name=$this/TABLE_NAME[1]/@Value] and string-length($helpFileName/TABLE_HELPFILE_MAP/*[@Name=$this/TABLE_NAME[1]/@Value]/@copyHelpFile)>0">
        	      <xapl:value-of select="concat($helpDirectory,'/',$helpFileName/TABLE_HELPFILE_MAP/*[@Name=$this/TABLE_NAME[1]/@Value]/@copyHelpFile)"/>
        	</xapl:when>
	        <xapl:otherwise>
	  	      <xapl:value-of select="concat($helpDirectory,'/',$helpFileName/DEFAULT_HELP_FILENAME/@copyHelpFile)"/>
	        </xapl:otherwise>
	</xapl:choose>
	</xapl:when>

 <xapl:when test=" $this/TABLE_ROW_OPERATION/@Value = 'GROUP_EDIT' ">
  <xapl:choose>
        	<xapl:when test="$helpFileName/TABLE_HELPFILE_MAP/*[@Name=$this/TABLE_NAME[1]/@Value] and string-length($helpFileName/TABLE_HELPFILE_MAP/*[@Name=$this/TABLE_NAME[1]/@Value]/@massUpdateHelpFile)>0">
        	      <xapl:value-of select="concat($helpDirectory,'/',$helpFileName/TABLE_HELPFILE_MAP/*[@Name=$this/TABLE_NAME[1]/@Value]/@massUpdateHelpFile)"/>
        	</xapl:when>
	        <xapl:otherwise>
	  	      <xapl:value-of select="concat($helpDirectory,'/',$helpFileName/DEFAULT_HELP_FILENAME/@massUpdateHelpFile)"/>
	        </xapl:otherwise>
	</xapl:choose>
 </xapl:when>

        <!-- <xapl:when test=" $this/TABLE_ROW_OPERATION/@Value = 'GROUP_EDIT' ">
        	<xapl:value-of select="concat($helpDirectory,'/','mass_update.html')"/>
        </xapl:when>

        <xapl:otherwise>
  	      <xapl:value-of select="concat($helpDirectory,'/',$helpFileName/DEFAULT_HELP_FILENAME/@editHelpFile)"/>
        </xapl:otherwise> -->
      </xapl:choose>

    </xapl:variable>
    <xapl:print select="$helpFile"/>
<!-- ONLINE HELP -->

    <xapl:return>
	  <!-- EQ 521502 -->
      <CONTAINER Scrollable="no">
        <HELP Url="{$helpFile}"/>
        <STEP Name="EditTable" DisplayText="{$this/TABLE_NAME[1]/@Value}" OnClick="{concat('$pages:', $onClickPage)}" Selected="true">
          <BUTTONS>
            <BUTTON Id="back_button" Name="Back" DisplayText="Cancel" OnClick="javascript:onTableEditor()"/>
            <xapl:choose>
              <xapl:when test=" $this/TABLE_ROW_OPERATION/@Value = 'EDIT' ">
                <xapl:choose>
                  <xapl:when test="count($this/SELECTED_ID) > 1 ">
                    <BUTTON Id="commit_button" Name="Commit" DisplayText="Save And Return" OnClick="javascript:onEditCommitAll()" Emphasized="true"/>
                  </xapl:when>
                  <xapl:otherwise>
                    <BUTTON Id="commit_button" Name="Commit" DisplayText="Save And Return" OnClick="javascript:onEditCommitOne()" Emphasized="true"/>
                  </xapl:otherwise>
                </xapl:choose>
              </xapl:when>
              <xapl:when test=" $this/TABLE_ROW_OPERATION/@Value = 'GROUP_EDIT' ">
                <xapl:choose>
                  <xapl:when test="$this/UPDATE_ALL/@Value = 'YES' ">
                    <BUTTON Id="commit_button" Name="Commit" DisplayText="Save And Return" OnClick="javascript:onGroupEditCommitAll()" Emphasized="true"/>
                  </xapl:when>
                  <xapl:otherwise>
                    <BUTTON Id="commit_button" Name="Commit" DisplayText="Save And Return" OnClick="javascript:onGroupEditCommit()" Emphasized="true"/>
                  </xapl:otherwise>
                </xapl:choose>
              </xapl:when>
              <xapl:otherwise>
                <xapl:if test="$this/TABLE_ROW_OPERATION/@Value = 'ADD' ">
                  <BUTTON Id="save_button" Name="Save" DisplayText="Save" OnClick="javascript:onSaveAndReturn(false)"/>
                </xapl:if>
                <BUTTON Id="save_and_return_button" Name="Save" DisplayText="Save And Return" OnClick="javascript:onSaveAndReturn(true)" Emphasized="true"/>
              </xapl:otherwise>
            </xapl:choose>
          </BUTTONS>
        </STEP>
      </CONTAINER>
    </xapl:return>
  </x2:command>
<!--*********************************************************************************
  *********************************************************************************-->
 <x2:command public="yes" description="_" name="getSelectedIDData">
     <xapl:variable name="selectedTableData">
     <SELECTED_DATA/>
     </xapl:variable>
     <xapl:variable name="val"/>
     <xapl:variable name="colVal"/>
     <!--xapl:print select="$currentDbTable"/-->
     <xapl:print select="$pk"/>
     <!--xapl:print select="$this"/>
     <xapl:print select="$metaData/SERVICE[@Name=$this/SERVICE[1]/@Value]/DOCUMENTS/DOCUMENT[@Name = $this/REFERRED_TABLE[1]/@Value]"/-->
     
     <xapl:for-each varName="column" select="$currentDbTable/TABLE_NAME/COLUMNS/PROPERTY">
       <xapl:set-variable name="colVal" select="$column/@Name"/>
       <xapl:if test="string-length($column/@ToProperty)>0">
        <xapl:set-variable name="colVal" select="$column/@ToProperty"/>
       </xapl:if>
       <xapl:print>Col val is <xapl:value-of select="$colVal"/></xapl:print>
       <xapl:choose>
         <xapl:when test="$column/@PrimaryKey = 'yes'">
            <xapl:for-each varName="pkElement" select="$pk/NAME">
            <xapl:if test="$pkElement/@Value = $colVal">
              <xapl:if test="$column/@Refers = $this/REFERRED_TABLE/@Value">
                <xapl:print select="$column/@Name"/>
                <xapl:print select="$column/@Refers"/>
                <xapl:set-variable name="val">
                <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
                 <x2:with-param name="selectedId" select="$this/SELECTED_FK_ID/@Value"/>
                 <x2:with-param name="key" select="$colVal"/>
                </x2:execute>
               </xapl:set-variable>
               <docutil:add select="$selectedTableData">
                <docutil:element name="{$pkElement/@Value}" Value="{$val}"/>
               </docutil:add>
               <docutil:remove select="$this/*[name() = $pkElement/@Value]"/>
              </xapl:if>
            </xapl:if>
            </xapl:for-each>
         </xapl:when>
        <xapl:when test="$colVal = $this/FROM_COLUMN/@Value or $colVal = $this/REFERRED_COLUMN/@Value">
        <!--EQ:571483 TO get the value of the composite keys (which is not the primary keys in the 
            FROM _TABLE) in different table -->
          <xapl:variable name="docLinks">
                <DOC_LINKS>
                  <xcore:execute-method name="{concat('//', $this/SERVICE/@Value, '/getLinks')}" entireResponse="false">
                    <TABLE_NAME Value="{$currentDbTable/TABLE_NAME/@Value}"/>
                  </xcore:execute-method>
                </DOC_LINKS>
           </xapl:variable>
           
           <!--xapl:print>
           <xapl:value-of select="$docLinks"/>
           </xapl:print-->
           
           <xapl:variable name="docLink">
            <ALL_LINKS>
             <xapl:value-of select = "$docLinks/DOCUMENTLINK[@Name = $this/REFERRED_TABLE/@Value ] "/>
            </ALL_LINKS>
           </xapl:variable>
           
           
           
           <!--xapl:print>
           <xapl:value-of select="{substring-before($this/FROM_COLUMN/@Value, '_1' )}"/>
           <xapl:value-of select="$this/FROM_COLUMN/@Value"/>
           </xapl:print-->
           
           <!-- Eq: 575168 truncating from_column to get string before last underscore -->
           <x2:execute command="bcm.framework.tableeditor.TableRowView:getTruncatedColumnName">
	     <x2:with-param name="columnName" select="$this/FROM_COLUMN/@Value"/>
           </x2:execute>
           
           
           <!-- Eq: 575168 Getting the remaining string after the last underscore from  From_Coulmn-->
           <xapl:variable name="remainingString">
	   	<xapl:value-of select="{substring-after($this/FROM_COLUMN/@Value, $truncatedColumnName )}"/>
	   </xapl:variable>  
           
           <xapl:variable name="referedLink"/>
            
           <xapl:choose>
           <xapl:when test=" $this/TABLE_ROW_OPERATION/@Value = 'EDIT' ">          
		           
		  <xapl:set-variable name="referedLink">
			<REFERED_LINK>
			 <xapl:value-of select = "$docLink/DOCUMENTLINK[MAP_PROPERTY/@From = $truncatedColumnName] "/>
			</REFERED_LINK>
		  </xapl:set-variable>     
		  
           </xapl:when>
           
           <xapl:otherwise>
           
		   <xapl:set-variable name="referedLink">
		     <REFERED_LINK>
		      <xapl:value-of select = "$docLink/DOCUMENTLINK[MAP_PROPERTY/@From = $this/FROM_COLUMN/@Value] "/>
		     </REFERED_LINK>
		    </xapl:set-variable>
            
           </xapl:otherwise>
           </xapl:choose>
           <xapl:print select="$truncatedColumnName"/> 
           <xapl:print select="$docLink"/>
           <xapl:print select="$referedLink"/>
           <xapl:for-each varName="referedTo" select="$referedLink/DOCUMENTLINK/MAP_PROPERTY">
              <xapl:set-variable name="val">
                <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
                  <x2:with-param name="selectedId" select="$this/SELECTED_FK_ID/@Value"/>
                  <x2:with-param name="key" select="$referedTo/@To"/>
                </x2:execute>
              </xapl:set-variable>
              <docutil:add select="$selectedTableData"> 
              <xapl:choose>
                  <xapl:when test=" $this/TABLE_ROW_OPERATION/@Value = 'EDIT' ">
                   <!-- Eq : 575168 concatenating underscore and the index that gets added in case of Edit ex For Edit _1 gets concatenated and for multiple edit _1 ,_2 gets concatenated -->
                      <docutil:element name="{concat($referedTo/@From, $remainingString)}" Value="{$val}"/>
                  </xapl:when>
                  <xapl:otherwise>
                      <docutil:element name="{$referedTo/@From}" Value="{$val}"/>
                  </xapl:otherwise>
               </xapl:choose>               
              </docutil:add>
              </xapl:for-each>
            </xapl:when>
        <!--EQ:571483 TO get the value of the composite keys (which is not the primary keys in the 
            FROM _TABLE) in different table -->
            
        </xapl:choose>
      </xapl:for-each> 
      <docutil:remove select="$this/*[name() = $this/FROM_COLUMN/@Value]"/>
      <xapl:print select="$selectedTableData"/>
      <docutil:add select="$this">
        <xapl:value-of select="$selectedTableData/*" />
      </docutil:add>
   </x2:command>
   <!--*********************************************************************************
  *********************************************************************************-->
   <!-- used to set session variable truncatedColumnName to contain  substring before the last underscore in the given string -->
   <x2:command public="yes" description="_" name="getTruncatedColumnName">
      <x2:param name="columnName"/>
      <xapl:variable name="exitFroLoop" select="'false'"/>
      <xapl:set-variable name="truncatedColumnName"/>
      <xapl:print>
            inside    getTruncatedMemberName
            <xapl:value-of select="$exitFroLoop"/>
            <xapl:value-of select="$columnName"/>
      </xapl:print>
      <xapl:variable name="substrAfter"/>
      <xapl:variable name="substrBefore"/>
      <xapl:while test="$exitFroLoop = 'false'">
      <xapl:print>
            inside    while getTruncatedMemberName
            <xapl:value-of select="$exitFroLoop"/>
      </xapl:print>

        <xapl:set-variable name="substrAfter" select="substring-after($columnName, '_')"/>
        <xapl:print select="$substrAfter"/>

        <xapl:set-variable name="substrBefore" select="substring-before($columnName, '_')"/>
        <xapl:print select="$substrBefore"/>

        <xapl:set-variable name="columnName" select="$substrAfter"/>
        <xapl:choose>
            <xapl:when test="string-length($substrBefore ) > 0">
                <xapl:set-variable name="truncatedColumnName" select="concat($truncatedColumnName,'_',$substrBefore)"/>
                <xapl:print select="$truncatedColumnName"/>
            </xapl:when>
            <xapl:otherwise>
                <xapl:set-variable name="exitFroLoop" select="'true'"/>
            </xapl:otherwise>
        </xapl:choose>

      </xapl:while>

      <xapl:set-variable name="truncatedColumnName" select="substring-after($truncatedColumnName, '_')"/>
      <xapl:print select="$truncatedColumnName"/>
    </x2:command>     <!--*********************************************************************************
  *********************************************************************************-->
</x2:commands>