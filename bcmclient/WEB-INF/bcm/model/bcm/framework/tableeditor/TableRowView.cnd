<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="init" public="yes" description="_">
    <xapl:variable name="groupeditrows" resolver="session" global="true"/>
    <xapl:variable name="truncatedColumnName" resolver="session" global="true"/>
  </x2:command>
  <!-- **********************************************************************
       *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
    <xapl:print select="$this"/>
    <xapl:print select="$sessionData"/>     
    <!-- reset the sessionData in case of ERROR MESSAGE-->
    <xapl:if test="$this/USE_SESSIONDATA/@Value = 'TRUE'">
      <xapl:print>
        ::::resetting in $this all the old values from sessionData:::
        <xapl:value-of select="$sessionData"/>
      </xapl:print>
      <xapl:choose>
        <xapl:when test="$this/FROM_SELECT_FOREIGN_KEY/@Value = 'true'">
          <docutil:add select="$this">
            <xapl:value-of select="$sessionData/*[name() = $this/FROM_TABLE/@Value]/*"/>
          </docutil:add>
        </xapl:when>
        <xapl:otherwise>
          <docutil:add select="$this">
            <xapl:value-of select="$sessionData/*[name() = $this/TABLE_NAME/@Value]/*"/>
          </docutil:add>
        </xapl:otherwise>
      </xapl:choose>
    </xapl:if>
   
    <!--xapl:print select="$this"/-->
      
    <!-- BREADCRUMBS AT TOP OR AFTER CLEAN-CONTEXT-->
    <xapl:variable name="pageName">
      <xapl:choose>
        <xapl:when test=" $this/TABLE_ROW_OPERATION/@Value = 'ADD' "><i18n:text>Add Page</i18n:text></xapl:when>
        <xapl:when test=" $this/TABLE_ROW_OPERATION/@Value = 'COPY' "><i18n:text>Copy Page</i18n:text></xapl:when>
        <xapl:when test=" $this/TABLE_ROW_OPERATION/@Value = 'EDIT' "><i18n:text>Edit Page</i18n:text></xapl:when>
        <xapl:when test=" $this/TABLE_ROW_OPERATION/@Value = 'GROUP_EDIT' "><i18n:text>Group Edit Page</i18n:text></xapl:when>
      </xapl:choose>
    </xapl:variable>
    <xapl:variable name="tableName">
      <i18n:text>
        <xapl:value-of select="$this/TABLE_NAME[1]/@Value"/>
      </i18n:text>
    </xapl:variable>
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
      <x2:with-param name="display" select=" concat($tableName, ' ', $pageName)"/>
      <x2:with-param name="page" select="'tablerow'"/>
      <x2:with-param name="this" select="{$this}"/>
    </x2:execute>
    <!-- re-create the currentdbtable in session if its not there -->
    <xapl:choose>
      <xapl:when test="($currentDbTable/TABLE_NAME/@Value = $this/TABLE_NAME[1]/@Value and $currentDbTable/TABLE_NAME/@Service = $this/SERVICE[1]/@Value)"/>
      <xapl:otherwise>
        <!-- create table in session adding default presentation from metadata -->
        <x2:execute command="bcm.framework.tableeditor.Table:create">
          <x2:with-param name="this" select="{$this}"/>
          <x2:with-param name="pTableName" select="{$this/TABLE_NAME[1]/@Value}"/>
        </x2:execute>
      </xapl:otherwise>
    </xapl:choose>

    <xapl:variable name="row">
      <xapl:choose>
        <xapl:when test=" $this/TABLE_ROW_OPERATION/@Value = 'ADD' ">
          <ROWS>
            <x2:execute command="bcm.framework.tableeditor.Table:getEmptyRow">
              <x2:with-param name="this" select="$this"/>
            </x2:execute>
          </ROWS>
        </xapl:when>
        <xapl:when test=" $this/TABLE_ROW_OPERATION/@Value = 'COPY' ">
          <xapl:choose>
            <xapl:when test="$this/ERROR_MESSAGE">
              <ROWS>
                <x2:execute command="bcm.framework.tableeditor.Table:getEmptyRow">
                  <x2:with-param name="this" select="$this"/>
                </x2:execute>
              </ROWS>
            </xapl:when>
            <xapl:otherwise>
              <docutil:set select="$this">
                <x2:execute command="bcm.framework.tableeditor.Table:createXMLFromSelectedId">
                  <x2:with-param name="selectedId" select="$this/SELECTED_ID/@Value"/>
                </x2:execute>
              </docutil:set>
              <ROWS>
                <xapl:choose>
                  <xapl:when test="count($this/SELECTED_ID) > 0 and string-length($this/SELECTED_ID/@Value) > 0">
                    <x2:execute command="bcm.framework.tableeditor.Row:getOrCreateRow">
                      <x2:with-param name="this" select="$this"/>
                    </x2:execute>
                  </xapl:when>
                  <xapl:otherwise>
                    <x2:execute command="bcm.framework.tableeditor.Table:getEmptyRow">
                      <x2:with-param name="this" select="$this"/>
                    </x2:execute>
                  </xapl:otherwise>
                </xapl:choose>
              </ROWS>
            </xapl:otherwise>
          </xapl:choose>
        </xapl:when>
        <xapl:when test=" $this/TABLE_ROW_OPERATION/@Value = 'EDIT' ">
          <xapl:print select="{$this}"/>
          <ROWS>
            <xapl:choose>
              <xapl:when test="$this/FROM_SELECT_FOREIGN_KEY/@Value = 'true' or $this/ERROR_MESSAGE">
                <xapl:for-each varName="id" select="$this/SELECTED_ID">
                  <x2:execute command="bcm.framework.tableeditor.Table:getEmptyRow">
                    <x2:with-param name="this" select="{$this}"/>
                    <x2:with-param name="pTableName" select="{$this/TABLE_NAME[1]/@Value}"/>
                  </x2:execute>
                </xapl:for-each>
              </xapl:when>
              <xapl:otherwise>
                <xapl:for-each varName="id" select="$this/SELECTED_ID">
                  <xapl:variable name="selecteIdXMLTree">
                    <x2:execute command="bcm.framework.tableeditor.Table:createXMLFromSelectedId">
                      <x2:with-param name="selectedId" select="$id/@Value"/>
                    </x2:execute>
                  </xapl:variable>
                  <docutil:set select="$this">
                    <xapl:value-of select="$selecteIdXMLTree"/>
                  </docutil:set>
                  <x2:execute command="bcm.framework.tableeditor.Row:getOrCreateRow">
                    <x2:with-param name="this" select="$this"/>
                  </x2:execute>
                </xapl:for-each>
              </xapl:otherwise>
            </xapl:choose>
          </ROWS>
        </xapl:when>
      </xapl:choose>
    </xapl:variable>
    <xapl:print select="$row"/>
    <xapl:if test=" $this/TABLE_ROW_OPERATION/@Value = 'COPY' ">
      <xapl:for-each varName="field" select="$row/ROW/FIELD">
        <xapl:if test=" $field/@PrimaryKey = 'yes' ">
          <docutil:remove select="$field/@Value"/>
        </xapl:if>
      </xapl:for-each>
    </xapl:if>
    <!-- START Group Edit related part -->
    <xapl:if test=" $this/TABLE_ROW_OPERATION/@Value = 'GROUP_EDIT' ">
      <xapl:if test="not($this/FROM_SELECT_FOREIGN_KEY) or $this/FROM_SELECT_FOREIGN_KEY/@Value != 'true'">
        <xapl:set-variable name="groupeditrows">
          <ROWS>
            <xapl:for-each varName="id" select="$this/SELECTED_ID">
              <xapl:variable name="selecteIdXMLTree">
                <x2:execute command="bcm.framework.tableeditor.Table:createXMLFromSelectedId">
                  <x2:with-param name="selectedId" select="$id/@Value"/>
                </x2:execute>
              </xapl:variable>
              <docutil:set select="$this">
                <xapl:value-of select="$selecteIdXMLTree"/>
              </docutil:set>
              <xapl:value-of select="$selecteIdXMLTree"/>
            </xapl:for-each>
            <x2:execute command="bcm.framework.tableeditor.Table:getEmptyRow">
              <x2:with-param name="this" select="$this"/>
            </x2:execute>
          </ROWS>
        </xapl:set-variable>
        <!--xapl:print>
                     groupeditrows:::
              <xapl:value-of select="$groupeditrows"/>
        </xapl:print-->
      </xapl:if>
    </xapl:if>
    <xapl:variable name="totalRecordCount"/>
    <xapl:choose>
      <xapl:when test="$this/UPDATE_ALL/@Value = 'NO'">
        <xapl:set-variable name="totalRecordCount" select="round(count($this/SELECTED_ID))"/>
      </xapl:when>
      <xapl:otherwise>
        <xapl:set-variable name="totalRecordCount" select="$this/RECORD_COUNT/@Value"/>
      </xapl:otherwise>
    </xapl:choose>
    <!-- END Group Edit related part -->
    <xapl:variable name="dateFormat">
      <identity:get-date-format format="common"/>
    </xapl:variable>
    <xapl:variable name="dateTimeFormat">
      <identity:get-date-format format="datetime"/>
    </xapl:variable>
     <xapl:print select="$this"/>
    <xapl:if test="string-length($this/SELECTED_FK_ID/@Value) > 0 ">
       <x2:execute command="bcm.framework.tableeditor.TableRowView:getSelectedIDData">
       <x2:with-param name="this" select="{$this}"/>
       </x2:execute>
    </xapl:if>
    <xapl:return>
      <!-- Page Header-->
      <x2:execute command="bcm.framework.tableeditor.TableRowView:getHeader">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
      <!-- Top Level Container -->
      <x2:execute command="bcm.framework.tableeditor.TableRowView:getContainer">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
      <xapl:choose>
        <xapl:when test=" $this/TABLE_ROW_OPERATION/@Value = 'GROUP_EDIT' ">
          <xapl:value-of select="$groupeditrows"/>
          <TOTAL_RECORD_COUNT Value="{$totalRecordCount}"/>
        </xapl:when>
        <xapl:otherwise>
          <xapl:value-of select="$row"/>
        </xapl:otherwise>
      </xapl:choose>
      <xapl:value-of select="$this/*"/>
      <FORMAT Date="{$dateFormat}"/>
      <DATETIMEFORMAT Date="{$dateTimeFormat}"/>
      <xapl:choose>
        <xapl:when test="$currentDbTable/TABLE_NAME/@SurrogateKey='yes' and count($currentDbTable/TABLE_NAME/COLUMNS/PROPERTY[@PrimaryKey = 'yes' and @Name!='SCENARIO_ID']) = 1 ">
            <SurrogateKey Value="yes"/>
        </xapl:when>
        <xapl:otherwise>
            <SurrogateKey Value="no"/>
        </xapl:otherwise>
      </xapl:choose>
      <xapl:value-of select="$currentTablesOptionData/SERVICE[@Name =
      $this/SERVICE[1]/@Value]/TABLE[@Name = $this/TABLE_NAME[1]/@Value]/OPTION_TYPES"/>
      <xapl:print>
        ANISH OPTIONS:::
              <xapl:value-of select="$currentTablesOptionData/SERVICE[@Name =
      $this/SERVICE[1]/@Value]/TABLE[@Name = $this/TABLE_NAME[1]/@Value]/OPTION_TYPES"/>
        </xapl:print>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    <xapl:return>
      <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <xapl:variable name="onClickPage">
      <xapl:choose>
        <xapl:when test=" $this/TABLE_ROW_OPERATION/@Value = 'ADD'
        or $this/TABLE_ROW_OPERATION/@Value = 'COPY'">adddbrow</xapl:when>
        <xapl:when test=" $this/TABLE_ROW_OPERATION/@Value = 'EDIT' ">editdbrow</xapl:when>
        <xapl:when test=" $this/TABLE_ROW_OPERATION/@Value = 'GROUP_EDIT' ">groupeditdbrow</xapl:when>
      </xapl:choose>
    </xapl:variable>

    <!-- need to pick help file from XDOC -->
<!-- ONLINE HELP Commenting -->
<!--
