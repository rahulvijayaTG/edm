<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
	<x2:command public="yes" description="_" name="init">
		<xapl:variable name="currentTableLinks" resolver="session" global="true"/>
	</x2:command>
	<x2:command public="yes" description="_" name="loadLinks">
		<xapl:print select="$this"/>
		<!-- BREADCRUMBS AT TOP OR AFTER CLEAN-CONTEXT-->
		<xapl:variable name="breadcrumb1">
			<i18n:text>
				<xapl:value-of select="$this/TABLE_NAME[1]/@Value"/>
			</i18n:text>
		</xapl:variable>
		<xapl:variable name="breadcrumb2">
			<i18n:text>Links Page</i18n:text>
		</xapl:variable>
		<x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
			<x2:with-param name="display" select="concat($breadcrumb1, '  ', $breadcrumb2)"/>
			<x2:with-param name="page" select="'tableLinks'"/>
			<x2:with-param name="this" select="{$this}"/>
		</x2:execute>
        <xapl:variable name="tableLinks" select="$currentTableLinks/TABLE[@Name = $this/TABLE_NAME[1]/@Value]"/>
        <xapl:for-each select="$tableLinks/DOCUMENTLINK" varName="docLink">
            <xapl:variable name="urlSuffix" />
            <xapl:for-each select="$docLink/MAP_PROPERTY" varName="property">
                <xapl:set-variable name="urlSuffix">
                    <xapl:value-of select="concat($urlSuffix, '&amp;F_', $property/@To,'=', $property/@Value)"/>
                </xapl:set-variable>
            </xapl:for-each>
            <docutil:set select="$docLink/@URLSuffix">
                <xapl:value-of select="$urlSuffix"/>
            </docutil:set>
        </xapl:for-each>
		<xapl:return>
			<!-- Page Header-->
			<x2:execute command="bcm.framework.tableeditor.TableLinksView:getHeader">
				<x2:with-param name="this" select="{$this}"/>
			</x2:execute>
			<!-- Container-->
			<x2:execute command="bcm.framework.tableeditor.TableLinksView:getContainer">
				<x2:with-param name="this" select="{$this}"/>
				<x2:with-param name="pPage" select="'tableLinks'"/>
			</x2:execute>
			<xapl:value-of select="$this/*"/>
            <xapl:value-of select="$tableLinks/*"/>
		</xapl:return>
	</x2:command>
	<!--  **********************************************************************
  *********************************************************************** -->
	<x2:command public="yes" description="_" name="getHeader">
		<!-- change the header home -->
		<xapl:return>
			<x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
		</xapl:return>
	</x2:command>
	<!-- **********************************************************************
  *********************************************************************** -->
	<x2:command public="yes" description="_" name="getContainer">
		<x2:param name="pPage"/>
		<xapl:variable name="header1">
		  <i18n:text>
		    <xapl:value-of select="$this/TABLE_NAME/@Value"/>
		  </i18n:text>
		</xapl:variable>
		<xapl:variable name="header2">
		  <i18n:text>Links Page</i18n:text>
		</xapl:variable>
		<xapl:return>
			<CONTAINER Scrollable="no">
				<HELP Url="../../help/where_used_help.htm"/>
				<STEP Name="ViewLinksTable" DisplayText="{concat($header1,'  ', $header2)}" OnClick="{$pages:tableLinks}" Selected="{$pPage = 'tableLinks'}"/>
				<BUTTONS>
					<BUTTON Id="back" Name="Back" DisplayText="Back" OnClick="javascript:onBack()" DisableOnClick="true" ActionType="_VIEW_ONLY_"/>
				</BUTTONS>
			</CONTAINER>
		</xapl:return>
	</x2:command>
</x2:commands>
