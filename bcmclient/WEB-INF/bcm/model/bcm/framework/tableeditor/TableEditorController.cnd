  <!--  **********************************************************************
  ******************************************************
  ***************** -->
  <x2:command public="yes" name="gotoSelectForeignKey">
    <!--
    Since the user is going to another table to select a foreign key,
    save the values that he has entered in the current form, so that
    when he comes back to the add page again, the entered values would
    be retained.
    -->
    <docutil:set select="$sessionData">
      <docutil:element name="{$this/FROM_TABLE/@Value}">
        <xapl:value-of select="$this/*[string-length(@Value) > 0] "/>
      </docutil:element>
    </docutil:set>
    <xapl:print select="$sessionData"/>
    <xapl:variable name="optionalParams">
      <ROOT>
        <xapl:value-of select="$this/REFERRED_COLUMN"/>
        <xapl:value-of select="$this/FROM_COLUMN"/>
      </ROOT>
    </xapl:variable>
    <x2:execute command="bcm.framework.ContextController:setContext">
      <x2:with-param name="fromPage" select="$this/PAGE/@Value"/>
      <x2:with-param name="fromTable" select="$this/TABLE_NAME/@Value"/>
      <x2:with-param name="toPage" select="'tableeditor'"/>
      <x2:with-param name="toTable" select="$this/REFERRED_TABLE/@Value"/>
      <x2:with-param name="optionalParams" select="$optionalParams"/>
    </x2:execute>
    <web:display-page>
      <web:get-page name="tableeditor">
        <xapl:value-of select="$this/FROM_TABLE"/>
        <xapl:value-of select="$this/FROM_COLUMN"/>
        <xapl:value-of select="$this/REFERRED_TABLE"/>
        <xapl:value-of select="$this/REFERRED_COLUMN"/>
        <TABLE_NAME Value="{$this/REFERRED_TABLE/@Value}"/>
        <DO_SEARCH Value="No"/>
        <xapl:value-of select="$this/SERVICE"/>
        <xapl:value-of select="$this/DIRECTORY"/>
        <xapl:value-of select="$this/FILE"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!--
  ******************************************************
  ***************** -->
  <x2:command public="yes" name="selectForeignKey">
    <xapl:variable name="pageContext">
      <x2:execute command="bcm.framework.ContextController:getPageContext">
        <x2:with-param name="currentPage" select="'tableeditor'"/>
        <x2:with-param name="currentTable" select="$this/TABLE_NAME/@Value"/>
      </x2:execute>
    </xapl:variable>
     <!--<xapl:variable name="selectedColumnValue">
          <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
            <x2:with-param name="selectedId" select="$this/SELECTED_ID/@Value"/>
            <x2:with-param name="key" select="$pageContext/REFERRED_COLUMN/@Value"/>
          </x2:execute>
        </xapl:variable>
        <xapl:print select="$sessionData"/>
        <xapl:print select="$sessionData/*[name() = $pageContext/FROM_TABLE/@Value]"/>
        <xapl:print select="$this/TABLE_NAME/@Value"/>
        <xapl:print select="$selectedColumnValue"/>
        <xapl:print select="$pageContext"/>
        <xapl:print select="$pageContext/FROM_COLUMN/@Value"/>
        <docutil:remove select="$sessionData/*[name() = $pageContext/FROM_TABLE/@Value]/
        *[name() = $pageContext/FROM_COLUMN/@Value]"/-->

        <web:display-page>
          <web:get-page name="{$pageContext/FROM_PAGE/@Value}">
            <!--<xapl:value-of select="$sessionData/*[name() = $pageContext/FROM_TABLE/@Value]/*"/>
            <docutil:element name="{$pageContext/FROM_COLUMN/@Value}" Value="{$selectedColumnValue}"/>-->
            <FROM_SELECT_FOREIGN_KEY Value="true"/>
            <FROM_TABLE Value="{$pageContext/FROM_TABLE/@Value}"/>
            <USE_SESSIONDATA Value="TRUE"/>
            <SELECTED_FK_ID Value="{$this/SELECTED_ID/@Value}"/>
          </web:get-page>
    </web:display-page>
  </x2:command>
  <!--******************************************************
      ***************************************************** -->
  <x2:command public="yes" name="cancel">
    <xapl:variable name="pageContext">
      <x2:execute command="bcm.framework.ContextController:getPageContext">
        <x2:with-param name="currentPage" select="'tableeditor'"/>
        <x2:with-param name="currentTable" select="$this/TABLE_NAME/@Value"/>
      </x2:execute>
    </xapl:variable>
    <xapl:print select="$sessionData"/>
    <xapl:print select="$sessionData/*[name() = $pageContext/FROM_TABLE/@Value]"/>
    <xapl:print select="$this/TABLE_NAME/@Value"/>
    <!--xapl:print select="$selectedColumnValue"/-->
    <xapl:print select="$pageContext"/>
    <xapl:print select="$pageContext/FROM_COLUMN/@Value"/>
    <!--docutil:remove select="$sessionData/*[name() = $pageContext/FROM_TABLE/@Value]/
        *[name() = $pageContext/FROM_COLUMN/@Value]"/-->
    <web:display-page>
      <web:get-page name="{$pageContext/FROM_PAGE/@Value}">
        <FROM_SELECT_FOREIGN_KEY Value="true"/>
        <FROM_TABLE Value="{$pageContext/FROM_TABLE/@Value}"/>
        <USE_SESSIONDATA Value="TRUE"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!--  **********************************************************************
  ******************************************************
  ***************** -->
  <x2:command public="yes" description="_" name="linkToTable">
    <x2:execute command="bcm.framework.ContextController:removeOldContextForColumnLink">
      <x2:with-param name="toPage" select=" 'tableeditor' "/>
      <x2:with-param name="toTable" select="$this/TABLE_NAME/@Value"/>
    </x2:execute>
    <web:display-page>
      <web:get-page name="tableeditor">
        <xapl:value-of select="$this/TABLE_NAME"/>
        <!--
        Table Editor page expects the filter column-names to be prefixed with
        'F'. Hence here an element is created with name as the column name
        prefixed with 'F', and the value as the value of the filter.
        -->
        <docutil:element name="{$this/LINKED_COLUMN_SEARCH_NAME/@Value}" Value="{$this/*[name()=$this/COLUMN_NAME/@Value]/@Value}"/>
        <!--
        Pass a parameter to the Table Editor framework to signify that the user has
        come to a certain table editor page by clicking on a foreign key link.
        -->
        <FROM_COLUMN_LINK Value="yes"/>
        <DO_SEARCH Value="yes"/>
        <xapl:value-of select="$this/SERVICE"/>
        <xapl:value-of select="$this/DIRECTORY"/>
        <xapl:value-of select="$this/FILE"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <x2:command public="yes" name="findWhereUsed">
    <xapl:variable name="docLinks">
      <DOC_LINKS>
        <xcore:execute-method name="{concat('//', $this/SERVICE/@Value, '/getLinks')}" entireResponse="false">
          <TABLE_NAME Value="{$this/TABLE_NAME/@Value}"/>
        </xcore:execute-method>
      </DOC_LINKS>
    </xapl:variable>
    <xapl:print select="$docLinks"/>
    <xapl:variable name="selectedIdXMLTree">
      <x2:execute command="bcm.framework.tableeditor.Table:createXMLFromSelectedId">
        <x2:with-param name="selectedId" select="$this/SELECTED_ID/@Value"/>
      </x2:execute>
    </xapl:variable>
    <xapl:for-each select="$docLinks/DOCUMENTLINK" varName="docLink">
      <xapl:for-each select="$docLink/MAP_PROPERTY" varName="property">
        <docutil:set select="$property/@Value">
          <xapl:value-of select="$selectedIdXMLTree/*[name() = $property/@From]/@Value"/>
        </docutil:set>
      </xapl:for-each>
      <docutil:set select="$docLink/@DisplayName">
        <xapl:value-of select="$metaData/SERVICE[@Name=$this/SERVICE/@Value]/
        DOCUMENTS/DOCUMENT[ @Name = $docLink/@Name]/@DisplayName"/>
      </docutil:set>
      <docutil:set select="$docLink/MAP_PROPERTY/@FromDisplayName">
      <!--   <xapl:variable name="dispName">
          <xapl:value-of select="$docLink/MAP_PROPERTY/[@From!='SCENARIO_ID']"/>
        </xapl:variable>
         -->
        <xapl:value-of select="$metaData/SERVICE[@Name=$this/SERVICE/@Value]/
        DOCUMENTS/DOCUMENT[ @Name = $this/TABLE_NAME/@Value ]/
        PROPERTY[@Name = $docLink/MAP_PROPERTY[@From!='SCENARIO_ID']]/@DisplayName"/>
      </docutil:set>
      <docutil:set select="$docLink/MAP_PROPERTY/@ToDisplayName">
        <xapl:value-of select="$metaData/SERVICE[@Name=$this/SERVICE/@Value]/
        DOCUMENTS/DOCUMENT[ @Name = $docLink/@Name ]/
        PROPERTY[@Name = $docLink/MAP_PROPERTY[@To!='SCENARIO_ID']]/@DisplayName"/>
      </docutil:set>
    </xapl:for-each>
    <xapl:print select="$docLinks"/>
    <xapl:if test="count($currentTableLinks/*) = 0">
      <xapl:set-variable name="currentTableLinks">
        <TABLE_LINKS/>
      </xapl:set-variable>
    </xapl:if>
    <xapl:choose>
      <xapl:when test="$currentTableLinks/*[@Name = $this/TABLE_NAME/@Value] ">
        <docutil:remove select="$currentTableLinks/TABLE[@Name = $this/TABLE_NAME/@Value]"/>
        <docutil:add select="$currentTableLinks">
          <TABLE Name="{$this/TABLE_NAME/@Value}">
            <xapl:value-of select="$docLinks/*"/>
          </TABLE>
        </docutil:add>
      </xapl:when>
      <xapl:otherwise>
        <docutil:add select="$currentTableLinks">
          <TABLE Name="{$this/TABLE_NAME/@Value}">
            <xapl:value-of select="$docLinks/*"/>
          </TABLE>
        </docutil:add>
      </xapl:otherwise>
    </xapl:choose>
    <xapl:print>
       #######     $currentTableLinks= <xapl:value-of select="$currentTableLinks"/>
    </xapl:print>
    <web:display-page>
      <web:get-page name="tableLinks">
        <xapl:value-of select="$this/SERVICE"/>
        <xapl:value-of select="$this/TABLE_NAME"/>
        <xapl:value-of select="$selectedIdXMLTree/*"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!--  **********************************************************************
  ******************************************************
  ***************** -->
  <x2:command public="yes" description="_" name="refresh">
    <!-- BEGIN [[ Changes by Nitin Goel to make a wrapper around table editors,
                the return page name should be a variable -->
    <xapl:variable name="returnPageSuccess"/>
    <xapl:choose>
      <xapl:when test="string-length($this/RETURN_URL/@Value) > 0">
        <xapl:set-variable name="returnPageSuccess" select="$this/RETURN_URL/@Value"/>
      </xapl:when>
      <xapl:otherwise>
        <xapl:set-variable name="returnPageSuccess" select="'tableeditor'"/>
      </xapl:otherwise>
    </xapl:choose>
    <!-- ]]END Changes by NG -->
    <web:display-page>
      <web:get-page name="{$returnPageSuccess}">
        <DO_SEARCH Value="{$this/DO_SEARCH/@Value}"/>
        <TABLE_NAME Value="{$this/TABLE_NAME/@Value}"/>
        <SERVICE Value="{$this/SERVICE/@Value}"/>
        <DIRECTORY Value="{$this/DIRECTORY/@Value}"/>
        <FILE Value="{$this/FILE/@Value}"/>
        <USE_OLD_FILTER Value="TRUE"/>
        <xapl:value-of select="$this/START_COUNT"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!--  **********************************************************************
  ******************************************************
  ***************** -->
  <x2:command public="yes" description="_" name="clearFilter">
    <!-- clean the sessional header filter -->
    <docutil:remove select="$currentPref/SERVICE[@Name = $this/SERVICE/@Value]/TABLE[@Name = $this/TABLE_NAME/@Value]/FILTERS/*"/>
    <docutil:remove select="$currentPref/SERVICE[@Name = $this/SERVICE/@Value]/TABLE[@Name = $this/TABLE_NAME/@Value]/ORDER_BY"/>
    <!-- clean the sessional expression filter -->
    <xapl:set-variable name="filterXml"/>
    <web:display-page>
      <web:get-page name="tableeditor">
        <DO_SEARCH Value="Yes"/>
        <TABLE_NAME Value="{$this/TABLE_NAME/@Value}"/>
        <SERVICE Value="{$this/SERVICE/@Value}"/>
        <DIRECTORY Value="{$this/DIRECTORY/@Value}"/>
        <FILE Value="{$this/FILE/@Value}"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="deleteDBRows">
    <xapl:print select="$this"/>
    <xapl:print select="$this/SELECTED_ID/@Value"/>
    <xapl:print select="$this/TABLE_NAME[1]/@Value"/>
    <xapl:variable name="request"/>
    <xapl:variable name="serverResponse"/>
    <!--<xapl:variable name="status">Success</xapl:variable>
    <xapl:variable name="desc"/>-->
    <xapl:choose>
      <xapl:when test="$this/SERVICE/@Value = 'BCMMasterService' or $this/SERVICE/@Value = 'BCMOutboundService'  ">
        <xapl:set-variable name="request" select="concat('//', $this/SERVICE/@Value, '/doPersist')"/>
        <xapl:set-variable name="serverResponse">
          <xcore:execute-method name="{$request}" DocumentName="{$this/TABLE_NAME/@Value}" Action="DELETE" entireResponse="true" isBulkRequest="false">
            <OR>
              <xapl:for-each varName="selectedId" select="$this/SELECTED_ID">
                <AND>
                  <xapl:variable name="selecteIdXMLTree">
                    <x2:execute command="bcm.framework.tableeditor.Table:createXMLFromSelectedId">
                      <x2:with-param name="selectedId" select="$selectedId/@Value"/>
                    </x2:execute>
                  </xapl:variable>
                  <xapl:print select="$selecteIdXMLTree/*"/>
                  <xapl:value-of select="$selecteIdXMLTree/*"/>
                  <xapl:value-of select="$this/LAST_MODIFIED_DATE"/>
                </AND>
              </xapl:for-each>
            </OR>
          </xcore:execute-method>
        </xapl:set-variable>
      </xapl:when>
      <xapl:otherwise>
        <xapl:set-variable name="request" select="{concat('//' , $this/SERVICE/@Value , '/', $this/TABLE_NAME[1]/@Value)}"/>
        <xapl:set-variable name="serverResponse">
          <xcore:remove-document name="{$request}" outputResponse="true">
            <OR>
              <xapl:for-each varName="selectedId" select="$this/SELECTED_ID">
                <AND>
                  <xapl:variable name="selecteIdXMLTree">
                    <x2:execute command="bcm.framework.tableeditor.Table:createXMLFromSelectedId">
                      <x2:with-param name="selectedId" select="$selectedId/@Value"/>
                    </x2:execute>
                  </xapl:variable>
                  <xapl:print select="$selecteIdXMLTree/*"/>
                  <xapl:value-of select="$selecteIdXMLTree/*"/>
                </AND>
              </xapl:for-each>
            </OR>
          </xcore:remove-document>
        </xapl:set-variable>
      </xapl:otherwise>
    </xapl:choose>
    <xapl:print select="$serverResponse"/>
    <xapl:variable name="status">
      <x2:execute command="bcm.framework.util:getResponseStatus">
        <x2:with-param name="response" select="$serverResponse"/>
        <x2:with-param name="successMessage">
          <i18n:text>Record(s) successfully deleted</i18n:text>
        </x2:with-param>
      </x2:execute>
    </xapl:variable>
    <xapl:print select="$status"/>
    <!-- don't remember the selection -->
    <docutil:set select="$this">
      <xapl:value-of select="$status"/>
    </docutil:set>
    <xapl:print select="$this"/>
    <docutil:remove select="$this/SELECTED_ID"/>
    <xapl:choose>
      <xapl:when test="name($status) = 'SUCCESS_MESSAGE' ">
        <web:display-page>
          <web:get-page name="tableeditor">
            <xapl:value-of select="$this/SUCCESS_MESSAGE"/>
            <DO_SEARCH Value="yes"/>
            <xapl:value-of select="$this/TABLE_NAME"/>
            <xapl:value-of select="$this/SERVICE"/>
            <xapl:value-of select="$this/DIRECTORY"/>
            <xapl:value-of select="$this/FILE"/>
            <USE_OLD_FILTER Value="TRUE"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:when test="name($status) = 'ERROR_MESSAGE' ">
        <web:display-page>
          <web:get-page name="tableeditor">
            <xapl:value-of select="{$this/*}"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
    </xapl:choose>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="addDBRow">
    <!-- set the sessionData in case of ERROR MESSAGE-->
    <docutil:set select="$sessionData">
      <docutil:element name="{$this/TABLE_NAME/@Value}">
        <xapl:value-of select="$this/*[string-length(@Value) > 0] "/>
      </docutil:element>
    </docutil:set>
    <docutil:remove select="$this/*[string-length(@Value) =0 ]"/>
    <xapl:print select="$this"/>
    <xapl:variable name="request"/>
    <xapl:variable name="status">Success</xapl:variable>
    <xapl:variable name="desc"/>
    <xapl:variable name="serverResponse">
      <xapl:choose>
        <xapl:when test="$this/SERVICE/@Value = 'BCMMasterService' or $this/SERVICE/@Value = 'BCMOutboundService'  ">
          <xapl:set-variable name="request" select="concat('//', $this/SERVICE/@Value, '/doPersist')"/>
          <xcore:execute-method name="{$request}" DocumentName="{$this/TABLE_NAME/@Value}" Action="INSERT" entireResponse="true" isBulkRequest="false">
            <xapl:for-each select="$currentDbTable/TABLE_NAME/COLUMNS/PROPERTY" varName="col">
              <xapl:value-of select="$this/*[name() = $col/@Name]"/>
            </xapl:for-each>
          </xcore:execute-method>
        </xapl:when>
        <xapl:otherwise>
          <xapl:set-variable name="request" select="{concat('//' , $this/SERVICE/@Value , '/', $this/TABLE_NAME[1]/@Value)}"/>
          <xcore:add-document name="{$request}" outputResponse="true">
            <xapl:for-each select="$currentDbTable/TABLE_NAME/COLUMNS/PROPERTY" varName="col">
              <xapl:value-of select="$this/*[name() = $col/@Name]"/>
            </xapl:for-each>
          </xcore:add-document>
        </xapl:otherwise>
      </xapl:choose>
    </xapl:variable>
    <xapl:print select="$serverResponse"/>
    <xapl:print select="$desc"/>
    <!--start calling util.cnd always anish-->
    <xapl:variable name="statusXml">
      <x2:execute command="bcm.framework.util:getResponseStatus">
        <x2:with-param name="response" select="$serverResponse"/>
        <x2:with-param name="successMessage">
          <i18n:text>The record has been successfully added!</i18n:text>
        </x2:with-param>
      </x2:execute>
    </xapl:variable>
    <xapl:if test="name($statusXml)='ERROR_MESSAGE'">
      <xapl:set-variable name="status">Error</xapl:set-variable>
      <xapl:set-variable name="desc">
        <xapl:value-of select="$statusXml/@Value"/>
      </xapl:set-variable>
    </xapl:if>
    <!--end calling util.cnd always anish-->
    <!-- create table in session with column names -->
    <xapl:choose>
      <xapl:when test="$this/RETURN/@Value = 'true' and $status = 'Success'">
        <!-- Clean the sessionData-->
        <docutil:remove select="$sessionData/*[name() = $this/TABLE_NAME/@Value]/*"/>
        <web:display-page>
          <web:get-page name="tableeditor">
            <xapl:value-of select="$this/SERVICE"/>
            <xapl:value-of select="$this/TABLE_NAME"/>
            <DO_SEARCH Value="Yes"/>
            <SUCCESS_MESSAGE Value="The record has been successfully added!"/>
            <USE_OLD_FILTER Value="TRUE"/>
            <xapl:value-of select="$this/DIRECTORY"/>
            <xapl:value-of select="$this/FILE"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:otherwise>
        <web:display-page>
          <web:get-page name="tablerow">
            <xapl:choose>
              <xapl:when test="{$status = 'Success'}">
                <!-- Clean the sessionData-->
                <docutil:remove select="$sessionData/*[name() = $this/TABLE_NAME/@Value]/*"/>
                <SUCCESS_MESSAGE Value="The record has been successfully added!"/>
                <xapl:variable name="selectedId" select="'#'"/>
                <xapl:for-each select="$serverResponse/RESPONSE/*" varName="child">
                  <xapl:set-variable name="selectedId" select="concat( $selectedId , name($child) , '=' , $child/@Value , '#' )"/>
                </xapl:for-each>
                <xapl:print>
                     SHIFTING TO EDIT MODE    :::
                     <xapl:value-of select="$selectedId"/>
                </xapl:print>
                <docutil:set select="$this">
                  <TABLE_ROW_OPERATION Value="EDIT"/>
                  <SELECTED_ID Value="{$selectedId}"/>
                </docutil:set>
                <xapl:value-of select="$this/TABLE_ROW_OPERATION"/>
                <xapl:value-of select="$this/SELECTED_ID"/>
                <DO_SEARCH Value="yes"/>
                <xapl:value-of select="$this/TABLE_NAME"/>
                <xapl:value-of select="$this/SERVICE"/>
                <xapl:value-of select="$this/DIRECTORY"/>
                <xapl:value-of select="$this/FILE"/>
              </xapl:when>
              <xapl:when test="{$status = 'Error'}">
                <ERROR_MESSAGE Value="{$desc}"/>
                <USE_SESSIONDATA Value="TRUE"/>
                <xapl:value-of select="$this/TABLE_NAME"/>
              </xapl:when>
              <xapl:otherwise>
                <ERROR_MESSAGE Value="Unknown Error!!!"/>
                <USE_SESSIONDATA Value="TRUE"/>
                <xapl:value-of select="$this/TABLE_NAME"/>
              </xapl:otherwise>
            </xapl:choose>
          </web:get-page>
        </web:display-page>
      </xapl:otherwise>
    </xapl:choose>
  </x2:command>
  <!-- **********************************************************************
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="updateDBRows">
    <!-- set the sessionData in case of ERROR MESSAGE-->
    <docutil:set select="$sessionData">
      <docutil:element name="{$this/TABLE_NAME/@Value}">
        <xapl:value-of select="$this/*[string-length(@Value) > 0] "/>
      </docutil:element>
    </docutil:set>
    <xapl:print select="$this"/>
    <xapl:print select="count($this/SELECTED_ID)"/>
    <xapl:variable name="dbrows">
      <ROW_LIST>
        <!-- take the element for making rows from the collated tree on basis of sequence selected -->
        <xapl:for-each select="$this/SEQUENCE" varName="seq">
          <ROW>
            <xapl:for-each select="$currentDbTable/TABLE_NAME/COLUMNS/PROPERTY" varName="col">
              <!-- BEGIN [[ Changes by Nitin Goel to support wrapper around table editors. I should be
                    able to hide certain properties of a table, and not have them reset to null here -->
              <xapl:variable name="operator" select="$this/*[name() = concat($col/@Name, '_',$seq/@Value, '_OPERATOR')]/@Value"/>
              <xapl:choose>
                <xapl:when test="string($operator) and ($col/@Type = 'int' or $col/@Type = 'float' or $col/@Type = 'double')">
                  <xapl:variable name="operatorValue" select="$this/*[name() = concat($col/@Name, '_',$seq/@Value, '_OPERATOR_VALUE')]/@Value"/>
                  <xapl:if test="string-length($operatorValue) &gt; 0">
                    <xapl:variable name="expression">
                      <xapl:choose>
                        <xapl:when test="$operator = 'INCREMENT'">
                      <xapl:value-of select="concat('#|', $col/@Value, '|# +#[', $operatorValue, '^', $dataType, ']#' )"/>
                    </xapl:when>
                    <xapl:when test="$operator = 'DECREMENT'">
                      <xapl:value-of select="concat('#|', $col/@Value, '|# - #[', $operatorValue, '^', $dataType, ']#' )"/>
                    </xapl:when>
                    <xapl:when test="$operator = 'INFLATE'">
                      <xapl:value-of select="concat('#|', $col/@Value, '|# * #[', (100 + number($operatorValue)) div 100, '^', $dataType,']#' )"/>
                    </xapl:when>
                    <xapl:when test="$operator = 'DEFLATE'">
                      <xapl:value-of select="concat('#|', $col/@Value, '|# * #[', (100 - number($operatorValue)) div 100, '^', $dataType,']#' )"/>
                        </xapl:when>
                      </xapl:choose>
                    </xapl:variable>
                    <xapl:print select="$expression"/>
                    <xapl:choose>
                      <xapl:when test="$operator = 'SET'">
                        <xapl:print select="$col/@Name"/>
                        <xapl:print select="$this/*[ name()= concat($col/@Name,'_',$seq/@Value) ]/@Value"/>
                        <docutil:element name="{$col/@Name}" Value="{$operatorValue}"/>
                      </xapl:when>
                      <xapl:otherwise>
                        <xapl:print select="$col/@Name"/>
                        <xapl:print select="$expression"/>
                        <docutil:element name="{$col/@Name}" Expression="{$expression}"/>
                      </xapl:otherwise>
                    </xapl:choose>
                  </xapl:if>
                </xapl:when>
                <xapl:when test="string-length($this/*[ name()= concat($col/@Name,'_',$seq/@Value) ]/@Value ) > 0 ">
                  <docutil:element name="{$col/@Name}" Value="{$this/*[ name()= concat($col/@Name,'_',$seq/@Value) ]/@Value}"/>
                </xapl:when>
                <xapl:when test="$this/*[name()= concat($col/@Name,'_',$seq/@Value)]">
                  <xapl:when test="string-length($this/*[ name()= concat($col/@Name,'_',$seq/@Value) ]/@Value ) = 0 ">
                    <docutil:element name="{$col/@Name}"/>
                  </xapl:when>
                </xapl:when>
              </xapl:choose>
              <!-- ]] END: Changes by Nitin Goel -->
            </xapl:for-each>
          </ROW>
        </xapl:for-each>
      </ROW_LIST>
    </xapl:variable>
    <!-- only db rows to be updated -->
    <xapl:print select="$dbrows"/>
    <xapl:variable name="status">Success</xapl:variable>
    <xapl:variable name="desc">
      <xapl:value-of select="''"/>
    </xapl:variable>
    <xapl:variable name="msg">
      <xapl:value-of select="''"/>
    </xapl:variable>
    <xapl:variable name="request"/>
    <xapl:choose>
      <xapl:when test="$this/SERVICE/@Value = 'BCMMasterService' or $this/SERVICE/@Value = 'BCMOutboundService'  ">
        <xapl:set-variable name="request" select="concat('//', $this/SERVICE/@Value, '/doPersist')"/>
      </xapl:when>
      <xapl:otherwise>
        <xapl:set-variable name="request" select="concat('//', $this/SERVICE/@Value, '/modifyDocument')"/>
      </xapl:otherwise>
    </xapl:choose>
    <xapl:for-each select="$dbrows/ROW" varName="row">
      <xapl:variable name="serverResponse">
        <xcore:execute-method name="{$request}" Action="UPDATE" DocumentName="{$this/TABLE_NAME/@Value}" entireResponse="true" isBulkRequest="false">
          <DOCUMENT_CONTEXT>
            <xapl:for-each select="$currentDbTable/TABLE_NAME/COLUMNS/PROPERTY[@PrimaryKey]" varName="col">
              <xapl:value-of select="{$row/*[name() = $col/@Name]}"/>
            </xapl:for-each>
            <xapl:value-of select="$this/LAST_MODIFIED_DATE"/>
          </DOCUMENT_CONTEXT>
          <UPDATE_PROPERTIES>
            <xapl:for-each select="$currentDbTable/TABLE_NAME/COLUMNS/PROPERTY[not(@PrimaryKey)]" varName="col">
              <xapl:value-of select="{$row/*[name() = $col/@Name]}"/>
            </xapl:for-each>
          </UPDATE_PROPERTIES>
        </xcore:execute-method>
      </xapl:variable>
      <!--start calling util.cnd always anish-->
      <xapl:variable name="statusXml">
        <x2:execute command="bcm.framework.util:getResponseStatus">
          <x2:with-param name="response" select="$serverResponse"/>
          <x2:with-param name="successMessage">
            <i18n:text>Record(s) successfully updated!</i18n:text>
          </x2:with-param>
        </x2:execute>
      </xapl:variable>
      <xapl:if test="name($statusXml)='ERROR_MESSAGE'">
        <xapl:set-variable name="status">Error</xapl:set-variable>
        <xapl:set-variable name="desc">
          <xapl:value-of select="$statusXml/@Value"/>
        </xapl:set-variable>
      </xapl:if>
      <!--end calling util.cnd always anish-->
    </xapl:for-each>
    <!-- BEGIN [[ Changes by Nitin Goel to make a wrapper around table editors,
                the return page name should be a variable -->
    <xapl:variable name="returnPageSuccess"/>
    <xapl:variable name="returnPageError"/>
    <xapl:choose>
      <xapl:when test="string-length($this/RETURN_URL/@Value) > 0">
        <xapl:set-variable name="returnPageSuccess" select="$this/RETURN_URL/@Value"/>
      </xapl:when>
      <xapl:otherwise>
        <xapl:set-variable name="returnPageSuccess" select="'tableeditor'"/>
      </xapl:otherwise>
    </xapl:choose>
    <xapl:choose>
      <xapl:when test="string-length($this/ERROR_RETURN_URL/@Value) > 0">
        <xapl:set-variable name="returnPageError" select="$this/ERROR_RETURN_URL/@Value"/>
      </xapl:when>
      <xapl:otherwise>
        <xapl:set-variable name="returnPageError" select="'tablerow'"/>
      </xapl:otherwise>
    </xapl:choose>
    <xapl:choose>
      <xapl:when test="{$status = 'Success'}">
        <!-- Clean the sessionData-->
        <docutil:remove select="$sessionData/*[name() = $this/TABLE_NAME/@Value]/*"/>
        <web:display-page>
          <web:get-page name="{$returnPageSuccess}">
            <SUCCESS_MESSAGE Value="Record(s) successfully updated!"/>
            <DO_SEARCH Value="yes"/>
            <xapl:value-of select="$this/TABLE_NAME"/>
            <xapl:value-of select="$this/SERVICE"/>
            <xapl:value-of select="$this/DIRECTORY"/>
            <xapl:value-of select="$this/FILE"/>
            <USE_OLD_FILTER Value="TRUE"/>
            <xapl:value-of select="$this/START_COUNT"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:when test="$status = 'Error'">
        <web:display-page>
          <web:get-page name="{$returnPageError}">
            <ERROR_MESSAGE Value="{$desc}"/>
            <USE_SESSIONDATA Value="TRUE"/>
            <xapl:value-of select="$this/TABLE_NAME"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:otherwise>
        <web:display-page>
          <web:get-page name="{$returnPageError}">
            <ERROR_MESSAGE Value="Unknown Error!!!"/>
            <USE_SESSIONDATA Value="TRUE"/>
            <xapl:value-of select="$this/TABLE_NAME"/>
          </web:get-page>
        </web:display-page>
      </xapl:otherwise>
    </xapl:choose>
    <!-- END]] Changes by NG -->
  </x2:command>
  <!--  **********************************************************************
        *********************************************************************** -->
  <x2:command public="yes" description="_" name="commit">
    <!-- set the sessionData in case of ERROR MESSAGE-->
    <docutil:set select="$sessionData">
      <docutil:element name="{$this/TABLE_NAME/@Value}">
        <xapl:value-of select="$this/*[string-length(@Value) > 0] "/>
      </docutil:element>
    </docutil:set>
    <xapl:print select="$this"/>
    <xapl:print select="count($this/SELECTED_COLUMN)"/>
    <xapl:variable name="selectedColumns">
      <COLUMNS>
        <xapl:for-each select="$this/SELECTED_COLUMN" varName="col">
          <xapl:variable name="dataType" select="$currentDbTable/TABLE_NAME/COLUMNS/PROPERTY[@Name = $col/@Value]/@Type"/>
          <xapl:print select="$dataType"/>
          <xapl:variable name="operator" select="$this/*[name() = concat($col/@Value, '_OPERATOR')]/@Value"/>
          <xapl:variable name="operatorValue" select="$this/*[name() = concat($col/@Value, '_OPERATOR_VALUE')]/@Value"/>
          <xapl:choose>
            <xapl:when test="string($operatorValue) and ($dataType = 'int' or $dataType = 'float' or $dataType = 'double')">
              <xapl:print select="$operator"/>
              <xapl:print select="$operatorValue"/>
              <xapl:if test="string-length($operatorValue) &gt; 0">
                <xapl:variable name="expression">
                  <xapl:choose>
                    <xapl:when test="$operator = 'INCREMENT'">
                      <xapl:value-of select="concat('#|', $col/@Value, '|# +#[', $operatorValue, '^', $dataType, ']#' )"/>
                    </xapl:when>
                    <xapl:when test="$operator = 'DECREMENT'">
                      <xapl:value-of select="concat('#|', $col/@Value, '|# - #[', $operatorValue, '^', $dataType, ']#' ) "/>
                    </xapl:when>
                    <xapl:when test="$operator = 'INFLATE'">
                      <xapl:value-of select="concat('#|', $col/@Value, '|# * #[', (100 + number($operatorValue)) div 100, '^', $dataType,']#' )"/>
                    </xapl:when>
                    <xapl:when test="$operator = 'DEFLATE'">
                      <xapl:value-of select="concat('#|', $col/@Value, '|# * #[', (100 - number($operatorValue)) div 100, '^', $dataType,']#' )"/>
                    </xapl:when>
                  </xapl:choose>
                </xapl:variable>
                <xapl:print select="$expression"/>
                <xapl:choose>
                  <xapl:when test="$operator = 'SET'">
                    <xapl:print select="$col/@Name"/>
                    <xapl:print select="$this/*[ name()= concat($col/@Name,'_',$seq/@Value) ]/@Value"/>
                    <docutil:element name="{$col/@Value}" Value="{$operatorValue}"/>
                  </xapl:when>
                  <xapl:otherwise>
                    <xapl:print select="$col/@Name"/>
                    <xapl:print select="$expression"/>
                    <docutil:element name="{$col/@Value}" Expression="{$expression}"/>
                  </xapl:otherwise>
                </xapl:choose>
              </xapl:if>
            </xapl:when>
            <xapl:when test="string-length($this/*[ name()= $col/@Value ]/@Value ) > 0 ">
              <docutil:element name="{$col/@Value}" Value="{$this/*[ name()= $col/@Value ]/@Value}"/>
            </xapl:when>
            <xapl:when test="string-length($this/*[ name()= $col/@Value ]/@Value ) = 0 ">
              <docutil:element name="{$col/@Value}"/>
            </xapl:when>
          </xapl:choose>
        </xapl:for-each>
      </COLUMNS>
    </xapl:variable>
    <!-- only db rows to be updated -->
    <xapl:print select="$selectedColumns"/>
    <xapl:print select="$groupeditrows"/>
    <xapl:variable name="status">Success</xapl:variable>
    <xapl:variable name="desc"/>
    <xapl:variable name="request"/>
    <xapl:choose>
      <xapl:when test="$this/SERVICE/@Value = 'BCMMasterService' or $this/SERVICE/@Value = 'BCMOutboundService'  ">
        <xapl:set-variable name="request" select="concat('//', $this/SERVICE/@Value, '/doPersist')"/>
      </xapl:when>
      <xapl:otherwise>
        <xapl:set-variable name="request" select="concat('//', $this/SERVICE/@Value, '/modifyDocument')"/>
      </xapl:otherwise>
    </xapl:choose>
    <xapl:variable name="serverResponse">
      <xcore:execute-method name="{$request}" Action="MASS_UPDATE" DocumentName="{$this/TABLE_NAME/@Value}" entireResponse="true" isBulkRequest="false">
        <DOCUMENT_CONTEXT>
          <OR>
            <xapl:for-each select="$groupeditrows/SELECTED_IDS" varName="pks">
              <AND>
                <xapl:value-of select="$pks/*"/>
              </AND>
            </xapl:for-each>
          </OR>
        </DOCUMENT_CONTEXT>
        <UPDATE_PROPERTIES>
          <xapl:value-of select="$selectedColumns/*"/>
        </UPDATE_PROPERTIES>
      </xcore:execute-method>
    </xapl:variable>
    <!--start calling util.cnd always anish-->
    <xapl:variable name="statusXml">
      <x2:execute command="bcm.framework.util:getResponseStatus">
        <x2:with-param name="response" select="$serverResponse"/>
        <x2:with-param name="successMessage">
          <i18n:text>Record(s) successfully updated!</i18n:text>
        </x2:with-param>
      </x2:execute>
    </xapl:variable>
    <xapl:if test="name($statusXml)='ERROR_MESSAGE'">
      <xapl:set-variable name="status">Error</xapl:set-variable>
      <xapl:set-variable name="desc">
        <xapl:value-of select="$statusXml/@Value"/>
      </xapl:set-variable>
    </xapl:if>
    <!--end calling util.cnd always anish-->
    <!-- display the page with changed data -->
    <!-- BEGIN [[ Changes by Nitin Goel to make a wrapper around table editors,
                the return page name should be a variable -->
    <xapl:variable name="returnPageSuccess"/>
    <xapl:variable name="returnPageError"/>
    <xapl:choose>
      <xapl:when test="string-length($this/RETURN_URL/@Value) > 0">
        <xapl:set-variable name="returnPageSuccess" select="$this/RETURN_URL/@Value"/>
      </xapl:when>
      <xapl:otherwise>
        <xapl:set-variable name="returnPageSuccess" select="'tableeditor'"/>
      </xapl:otherwise>
    </xapl:choose>
    <xapl:choose>
      <xapl:when test="string-length($this/ERROR_RETURN_URL/@Value) > 0">
        <xapl:set-variable name="returnPageError" select="$this/ERROR_RETURN_URL/@Value"/>
      </xapl:when>
      <xapl:otherwise>
        <xapl:set-variable name="returnPageError" select="'tablerow'"/>
      </xapl:otherwise>
    </xapl:choose>
    <xapl:choose>
      <xapl:when test="{$status = 'Success'}">
        <web:display-page>
          <web:get-page name="{$returnPageSuccess}">
            <!-- Clean the sessionData-->
            <docutil:remove select="$sessionData/*[name() = $this/TABLE_NAME/@Value]/*"/>
            <SUCCESS_MESSAGE Value="Record(s) successfully updated!"/>
            <DO_SEARCH Value="yes"/>
            <xapl:value-of select="$this/TABLE_NAME"/>
            <xapl:value-of select="$this/SERVICE"/>
            <xapl:value-of select="$this/DIRECTORY"/>
            <xapl:value-of select="$this/FILE"/>
            <USE_OLD_FILTER Value="TRUE"/>
            <xapl:value-of select="$this/START_COUNT"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:when test="$status = 'Error'">
        <web:display-page>
          <web:get-page name="{$returnPageError}">
            <ERROR_MESSAGE Value="{$desc}"/>
            <USE_SESSIONDATA Value="TRUE"/>
            <xapl:value-of select="$this/TABLE_NAME"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:otherwise>
        <web:display-page>
          <web:get-page name="{$returnPageError}">
            <ERROR_MESSAGE Value="Unknown Error!!!"/>
            <USE_SESSIONDATA Value="TRUE"/>
            <xapl:value-of select="$this/TABLE_NAME"/>
          </web:get-page>
        </web:display-page>
      </xapl:otherwise>
    </xapl:choose>
    <!-- END]] Changes by NG -->
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="commitAll">
    <!-- set the sessionData in case of ERROR MESSAGE-->
    <docutil:set select="$sessionData">
      <docutil:element name="{$this/TABLE_NAME/@Value}">
        <xapl:value-of select="$this/*[string-length(@Value) > 0] "/>
      </docutil:element>
    </docutil:set>
    <xapl:print select="$this"/>
    <xapl:print select="count($this/SELECTED_COLUMN)"/>
    <xapl:variable name="selectedColumns">
      <COLUMNS>
        <xapl:for-each select="$this/SELECTED_COLUMN" varName="col">
          <xapl:variable name="dataType" select="$currentDbTable/TABLE_NAME/COLUMNS/PROPERTY[@Name = $col/@Value]/@Type"/>
          <xapl:print select="$dataType"/>
          <xapl:variable name="operator" select="$this/*[name() = concat($col/@Value, '_OPERATOR')]/@Value"/>
          <xapl:variable name="operatorValue" select="$this/*[name() = concat($col/@Value, '_OPERATOR_VALUE')]/@Value"/>
          <xapl:choose>
            <xapl:when test="string($operatorValue) and ($dataType = 'int' or $dataType = 'float' or $dataType = 'double')">
              <xapl:print select="$operator"/>
              <xapl:print select="$operatorValue"/>
              <xapl:if test="string-length($operatorValue) &gt; 0">
                <xapl:variable name="expression">
                  <xapl:choose>
                    <xapl:when test="$operator = 'INCREMENT'">
                      <xapl:value-of select="concat('#|', $col/@Value, '|# +#[', $operatorValue, '^', $dataType, ']#' )"/>
                    </xapl:when>
                    <xapl:when test="$operator = 'DECREMENT'">
                      <xapl:value-of select="concat('#|', $col/@Value, '|# - #[', $operatorValue, '^', $dataType, ']#' )"/>
                    </xapl:when>
                    <xapl:when test="$operator = 'INFLATE'">
                      <xapl:value-of select="concat('#|', $col/@Value, '|# * #[', (100 + number($operatorValue)) div 100, '^', $dataType,']#' )"/>
                    </xapl:when>
                    <xapl:when test="$operator = 'DEFLATE'">
                      <xapl:value-of select="concat('#|', $col/@Value, '|# * #[', (100 - number($operatorValue)) div 100, '^', $dataType,']#' )"/>
                    </xapl:when>
                  </xapl:choose>
                </xapl:variable>
                <xapl:print select="$expression"/>
                <xapl:choose>
                  <xapl:when test="$operator = 'SET'">
                    <xapl:print select="$col/@Name"/>
                    <xapl:print select="$this/*[ name()= concat($col/@Name,'_',$seq/@Value) ]/@Value"/>
                    <docutil:element name="{$col/@Value}" Value="{$operatorValue}"/>
                  </xapl:when>
                  <xapl:otherwise>
                    <xapl:print select="$col/@Name"/>
                    <xapl:print select="$expression"/>
                    <docutil:element name="{$col/@Value}" Expression="{$expression}"/>
                  </xapl:otherwise>
                </xapl:choose>
              </xapl:if>
            </xapl:when>
            <xapl:when test="string-length($this/*[ name()= $col/@Value ]/@Value ) > 0 ">
              <docutil:element name="{$col/@Value}" Value="{$this/*[ name()= $col/@Value ]/@Value}"/>
            </xapl:when>
            <xapl:when test="string-length($this/*[ name()= $col/@Value ]/@Value ) = 0 ">
              <docutil:element name="{$col/@Value}"/>
            </xapl:when>
          </xapl:choose>
        </xapl:for-each>
      </COLUMNS>
    </xapl:variable>
    <!-- only db rows to be updated -->
    <xapl:print select="$selectedColumns"/>
    <xapl:variable name="status">Success</xapl:variable>
    <xapl:variable name="desc"/>
    <xapl:variable name="request"/>
    <xapl:choose>
      <xapl:when test="$this/SERVICE/@Value = 'BCMMasterService' or $this/SERVICE/@Value = 'BCMOutboundService'  ">
        <xapl:set-variable name="request" select="concat('//', $this/SERVICE/@Value, '/doPersist')"/>
      </xapl:when>
      <xapl:otherwise>
        <xapl:set-variable name="request" select="concat('//', $this/SERVICE/@Value, '/modifyDocument')"/>
      </xapl:otherwise>
    </xapl:choose>
    <xapl:variable name="serverResponse">
      <xcore:execute-method name="{$request}" Action="MASS_UPDATE" DocumentName="{$this/TABLE_NAME/@Value}" entireResponse="true" isBulkRequest="false">
        <DOCUMENT_CONTEXT>
          <!-- Expression Filters-->
          <xapl:print>
                EXPRESSION FILTERS::
                <xapl:value-of select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/FILTERS/FILTER_DETAILS"/>
          </xapl:print>
          <xapl:if test="count($currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/FILTERS/FILTER_DETAILS) > 0">
            <FILTER_DETAILS>
              <xapl:value-of select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/FILTERS/FILTER_DETAILS/LOGICAL"/>
            </FILTER_DETAILS>
          </xapl:if>
          <!--<OR>-->
          <xapl:if test="count($currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/FILTERS/*) > 0">
            <docutil:set select="$this">
              <xapl:value-of select="$currentPref/SERVICE[@Name= $this/SERVICE[1]/@Value]/TABLE[@Name= $this/TABLE_NAME[1]/@Value]/FILTERS/*"/>
            </docutil:set>
            <xapl:for-each varName="column" select="$currentDbTable/TABLE_NAME/COLUMNS/PROPERTY">
              <xapl:if test="{ string-length($this/*[name()  = concat('F_',$column/@Name)]/@Value) != 0  and ($column/@Type = 'string' or $column/@Type = 'LongString' or $column/@Type = 'boolean')}">
                <xcore:search-by property="{$column/@Name}" value="{$this/*[name() = concat('F_' ,$column/@Name)]/@Value}"/>
              </xapl:if>
              <xapl:if test="{string-length($this/*[name() = concat('F_' ,$column/@Name)]/@Value) != 0  and ($column/@Type = 'int' or $column/@Type = 'float' or $column/@Type = 'double')}">
                <xcore:search-by property="{$column/@Name}" value="{$this/*[name() = concat('F_' ,$column/@Name)]/@Value}"/>
              </xapl:if>
              <xapl:if test="{string-length($this/*[name() = concat('F_' ,$column/@Name)]/@Value) != 0  and ($column/@Type = 'LongString')}">
                <xcore:search-by property="{$column/@Name}" value="{$this/*[name() = concat('F_' ,$column/@Name)]/@Value}"/>
              </xapl:if>
              <xapl:if test="($column/@Type = 'date' or $column/@Type = 'datetime')">
		     <xapl:if test="{string-length($this/*[name() = concat('F_' ,$column/@Name, '_DS')]/@Value) > 0}">
		      <xapl:print select="$this/*[name() = concat('F_' ,$column/@Name, '_DS')]/@Value"/>
		      <xcore:search-by property="{$column/@Name}" value="{$this/*[name() = concat('F_' ,$column/@Name, '_DS')]/@Value}" matchby="GREATER_EQUAL"/>
		     </xapl:if>
		     <xapl:if test="{string-length($this/*[name() = concat('F_' ,$column/@Name, '_DE')]/@Value) > 0}">
		      <xapl:variable name="toDate">                  
			 <xapl:value-of select="concat($this/*[name() = concat('F_' ,$column/@Name, '_DE')]/@Value,' 23:59:59')"/>                  
		      </xapl:variable>
		      <xapl:print select="$toDate"/>

		      <xcore:search-by property="{$column/@Name}" value="{$toDate}" matchby="LESS_EQUAL"/>
		      </xapl:if>
              </xapl:if>
            </xapl:for-each>
          </xapl:if>
          <!--</OR>-->
          <!--  ************************************************************** -->
          <!--  ************************************************************** -->
        </DOCUMENT_CONTEXT>
        <UPDATE_PROPERTIES>
          <xapl:value-of select="$selectedColumns/*"/>
        </UPDATE_PROPERTIES>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:print select="$serverResponse"/>
    <!--start calling util.cnd always anish-->
    <xapl:variable name="statusXml">
      <x2:execute command="bcm.framework.util:getResponseStatus">
        <x2:with-param name="response" select="$serverResponse"/>
        <x2:with-param name="successMessage">
          <i18n:text>Record(s) successfully updated!</i18n:text>
        </x2:with-param>
      </x2:execute>
    </xapl:variable>
    <xapl:if test="name($statusXml)='ERROR_MESSAGE'">
      <xapl:set-variable name="status">Error</xapl:set-variable>
      <xapl:set-variable name="desc">
        <xapl:value-of select="$statusXml/@Value"/>
      </xapl:set-variable>
    </xapl:if>
    <!--end calling util.cnd always anish-->
    <xapl:print> *************** response..
      <xapl:value-of select="$status"/>
      *************** description....
      <xapl:value-of select="$desc"/>
    </xapl:print>
    <!-- display the page with changed data -->
    <!-- BEGIN [[ Changes by Nitin Goel to make a wrapper around table editors,
                the return page name should be a variable -->
    <xapl:variable name="returnPageSuccess"/>
    <xapl:variable name="returnPageError"/>
    <xapl:choose>
      <xapl:when test="string-length($this/RETURN_URL/@Value) > 0">
        <xapl:set-variable name="returnPageSuccess" select="$this/RETURN_URL/@Value"/>
      </xapl:when>
      <xapl:otherwise>
        <xapl:set-variable name="returnPageSuccess" select="'tableeditor'"/>
      </xapl:otherwise>
    </xapl:choose>
    <xapl:choose>
      <xapl:when test="string-length($this/ERROR_RETURN_URL/@Value) > 0">
        <xapl:set-variable name="returnPageError" select="$this/ERROR_RETURN_URL/@Value"/>
      </xapl:when>
      <xapl:otherwise>
        <xapl:set-variable name="returnPageError" select="'tablerow'"/>
      </xapl:otherwise>
    </xapl:choose>
    <xapl:choose>
      <xapl:when test="{$status = 'Success'}">
        <!-- Clean the sessionData-->
        <docutil:remove select="$sessionData/*[name() = $this/TABLE_NAME/@Value]/*"/>
        <web:display-page>
          <web:get-page name="{$returnPageSuccess}">
            <SUCCESS_MESSAGE Value="Record(s) successfully updated!"/>
            <DO_SEARCH Value="yes"/>
            <xapl:value-of select="$this/TABLE_NAME"/>
            <xapl:value-of select="$this/SERVICE"/>
            <xapl:value-of select="$this/DIRECTORY"/>
            <xapl:value-of select="$this/FILE"/>
            <USE_OLD_FILTER Value="TRUE"/>
            <xapl:value-of select="$this/START_COUNT"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:when test="$status = 'Error'">
        <web:display-page>
          <web:get-page name="{$returnPageError}">
            <ERROR_MESSAGE Value="{$desc}"/>
            <USE_SESSIONDATA Value="TRUE"/>
            <xapl:value-of select="$this/TABLE_NAME"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:otherwise>
        <web:display-page>
          <web:get-page name="{$returnPageError}">
            <ERROR_MESSAGE Value="Unknown Error!!!"/>
            <USE_SESSIONDATA Value="TRUE"/>
            <xapl:value-of select="$this/TABLE_NAME"/>
          </web:get-page>
        </web:display-page>
      </xapl:otherwise>
    </xapl:choose>
    <!-- ]]END Changes by NG -->
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
</x2:commands>
