<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" description="_">
    <!-- ********************************************************************** 
  *********************************************************************** -->
    <x2:command public="yes" description="-" name="generate">
        <xapl:param name="pReportFormat"/>
        <xapl:param name="pReportData"/>
        <xapl:param name="this"/>
        <!-- Handle Errors - Start::-->
        <!-- Assumes that _ERROR tag indicates error -->
        <xapl:if test="count($pReportData/_ERROR) > 0">
            <xapl:return>
                <REPORT>
                    <xapl:value-of select="$pReportData/_ERROR"/>
                </REPORT>
            </xapl:return>
        </xapl:if>
        <!-- added by Poonam for CUSTOMISATION-->
        <xapl:variable name="varcustdisplay">
        <xapl:clone select="$pReportFormat"/>
        </xapl:variable>
       <xapl:choose>
  	    <xapl:when test="count($currentPref/SERVICE[@Name=$this/SERVICE/@Value]/TABLE[@Name = $this/TABLE_NAME/@Value]/DISPLAY_CUST)>0">
  	       <docutil:remove select="$varcustdisplay/FIELDS/FIELD[@DisplayType!='Hidden']"/>  	    
  	        <xapl:for-each varName="coltemp" select="$pReportFormat/FIELDS/FIELD"> 
	      	     <xapl:choose>
	      	         <xapl:when test="$coltemp/@Name = $currentPref/SERVICE[@Name=$this/SERVICE/@Value]/TABLE[@Name = $this/TABLE_NAME/@Value]/DISPLAY_CUST/*/@Name"> 
	      	         <docutil:add select="$varcustdisplay/FIELDS">
			       <xapl:value-of select="$coltemp"/>
			 </docutil:add>	      	          
			 <docutil:set select="$varcustdisplay/FIELDS/FIELD[@Name = $coltemp/@Name]/@Sequence">
			 	<xapl:value-of select="$currentPref/SERVICE[@Name=$this/SERVICE/@Value]/TABLE[@Name = $this/TABLE_NAME/@Value]/DISPLAY_CUST/FIELD[@Name = $coltemp/@Name]/@Sequence"/>
			 </docutil:set>
			 </xapl:when>
	      	        <xapl:otherwise/>
	             </xapl:choose>
	    </xapl:for-each>	
 	    <docutil:sort select="$varcustdisplay/FIELDS" sort-element="FIELD" sort-by="@Sequence" data-type="number" order="ascending"/>
      
	    <xapl:print>
	    original form
	    <xapl:value-of select="$pReportFormat"/>
	    new form

	    <xapl:value-of select="$varcustdisplay"/>

	    </xapl:print>

  	    </xapl:when>
  	    <xapl:otherwise/>
  	</xapl:choose>
  	<!-- added by Poonam for CUSTOMISATION-->
        <!-- Handle Errors - End.-->
        <xapl:return>
            <!-- Give default scroll -->
            <xapl:variable name="scrollable">
                <xapl:choose>
                    <xapl:when test="string-length($pReportFormat/@Scrollable) > 0">
                        <xapl:value-of select="$pReportFormat/@Scrollable"/>
                    </xapl:when>
                    <xapl:otherwise>no</xapl:otherwise>
                </xapl:choose>
            </xapl:variable>
            <!-- Give default scroll -->
            <xapl:variable name="totalRecordCount">
                <xapl:choose>
                    <xapl:when test="string-length($pReportData/@TotalRowCount) > 0">
                        <xapl:value-of select="$pReportData/@TotalRowCount"/>
                    </xapl:when>
                    <xapl:otherwise>
                        <xapl:value-of select="$pReportData/TOTAL_RECORD_COUNT/@Value"/>
                    </xapl:otherwise>
                </xapl:choose>
            </xapl:variable>
                 
            <REPORT TotalRecordCount="{$totalRecordCount}" StartAtRow="{$this/START_COUNT/@Value}" MaxRows="{$this/MAX_ROWS/@Value}" NoOfRows="{count($pReportData/*)}" NoOfColumns="{count($varcustdisplay/FIELDS/FIELD)}">
                <TABLE Title="{$pReportFormat/@Title}" DoSearch="{$this/DO_SEARCH/@Value}" NoRecordsTitle="{$pReportFormat/@NoRecordsTitle}" Scrollable="{$scrollable}" PagingTitle="{$pReportFormat/@PagingTitle}" FilterTitle="{$this/FILTER_TEXT/@Value}" NoTitle="{$pReportFormat/@NoTitle}">
                    <!-- Help -->
                    <xapl:if test="string-length($pReportFormat/HELP/@Url) > 0">
                        <HELP Url="{$pReportFormat/HELP/@Url}"/>
                    </xapl:if>
                    <!-- Header Row-->
                    <TR Header="yes">
                        <!-- Select All -->
                        <xapl:if test="$pReportFormat/@Selectable = 'All'">
                            <TD Name="SELECT_ALL" Header="yes" Select="multi" Type="CheckBox" Sequence="-100"/>
                        </xapl:if>
                        <xapl:if test="$pReportFormat/@Selectable = 'Single'">
                            <TD Select="single" Header="yes" Sequence="-100"/>
                        </xapl:if>
                        <!-- Header Columns -->
                        <xapl:for-each varName="col" select="$varcustdisplay/FIELDS/FIELD">
                            <!-- type-->
                            <xapl:variable name="type">
                                <xapl:choose>
                                    <xapl:when test="$col/@DisplayType = 'Hidden'">Hidden</xapl:when>
                                    <xapl:when test="$col/@Hidden = 'yes'">Hidden</xapl:when>
                                    <xapl:otherwise>Text</xapl:otherwise>
                                </xapl:choose>
                            </xapl:variable>
                            <!-- Align -->
                            <xapl:variable name="align">
                                <xapl:choose>
                                    <xapl:when test=" $col/@DisplayType = 'Number' ">right</xapl:when>
                                    <xapl:otherwise>left</xapl:otherwise>
                                </xapl:choose>
                            </xapl:variable>
                       <!-- Multisortorder -->   
                       <xapl:variable name="Multisortorder"/>   
                       <xapl:choose>     
                       <xapl:when test="count($currentPref/SERVICE[@Name=$this/SERVICE/@Value]/TABLE[@Name = $this/TABLE_NAME/@Value]/ORDER_BY) = 1"> 
                       <xapl:set-variable name="Multisortorder">
                       <xapl:value-of select="$currentPref/SERVICE[@Name=$this/SERVICE/@Value]/TABLE[@Name = $this/TABLE_NAME/@Value]/ORDER_BY/*[name() = $col/@Name][1]/@Sort" />			     
                       </xapl:set-variable>
                       </xapl:when>
                       <xapl:otherwise/>
                       </xapl:choose>
                        <!--xapl:print>
                        in reportdb
                        <xapl:value-of select="{$col/@Name}"/>
                        <xapl:value-of select="$Multisortorder"/>
                        </xapl:print-->  
                        <!-- Multisortnumber -->  
                       <xapl:variable name="Multisortnumber"/>                                               
                       <xapl:choose>
                       <xapl:when test="$currentPref/SERVICE[@Name=$this/SERVICE/@Value]/TABLE[@Name = $this/TABLE_NAME/@Value]/ORDER_BY/*[position()=1 and name() = $col/@Name]">
                           <xapl:set-variable name="Multisortnumber">
	                   <xapl:value-of select="'1'"/>
                           </xapl:set-variable>
                       </xapl:when> 
                       <xapl:otherwise>
                       <xapl:choose>
                       <xapl:when test="$currentPref/SERVICE[@Name=$this/SERVICE/@Value]/TABLE[@Name = $this/TABLE_NAME/@Value]/ORDER_BY/*[position()=2 and name() = $col/@Name]">
		                                  <xapl:set-variable name="Multisortnumber">
		       	                          <xapl:value-of select="'2'"/>
		                                  </xapl:set-variable>
                       </xapl:when> 
                       <xapl:otherwise>
                       <xapl:if test="$currentPref/SERVICE[@Name=$this/SERVICE/@Value]/TABLE[@Name = $this/TABLE_NAME/@Value]/ORDER_BY/*[position()=3 and name() = $col/@Name]">
		       		                                <xapl:set-variable name="Multisortnumber">
		       		       	                        <xapl:value-of select="'3'"/>
		       		                                </xapl:set-variable>
                       </xapl:if> 
                       </xapl:otherwise>
                       </xapl:choose>
                       </xapl:otherwise>
		       </xapl:choose>
                       
                        
                       <!--xapl:print>
                       number test                       
                       <xapl:value-of select="$Multisortnumber"/>
                       </xapl:print-->  
                                                                                                  
                       <!-- Value -->
                            <xapl:variable name="value">
                                <xapl:choose>
                                    <xapl:when test="$col/@DisplayType = 'Hidden' or $col/@DisplayType = 'Image'">
                                        <xapl:value-of select="$col/@Value"/>
                                    </xapl:when>
                                    <xapl:otherwise>
                                        <i18n:text><xapl:value-of select="$col/@DisplayText"/></i18n:text>
                                    </xapl:otherwise>
                                </xapl:choose>
                            </xapl:variable>
                       <xapl:choose>     
                       <xapl:when test="count($currentPref/SERVICE[@Name=$this/SERVICE/@Value]/TABLE[@Name = $this/TABLE_NAME/@Value]/ORDER_BY) = 1">
                           <TD I18Nize="{$col/@I18Nize}" Sequence="{$col/@Sequence}" Header="yes" Name="{$col/@Name}" Value="{$value}" Sortable="{$col/@Sortable}" Primarykey="{$col/@Primarykey}" Type="{$type}" Align="{$align}" Multisortorder="{$Multisortorder}" Multisortnumber="{$Multisortnumber}"/>
                       </xapl:when>
                       <xapl:otherwise>
                            <TD I18Nize="{$col/@I18Nize}" Sequence="{$col/@Sequence}" Header="yes" Name="{$col/@Name}" Value="{$value}" Sortable="{$col/@Sortable}" Primarykey="{$col/@Primarykey}" Type="{$type}" Align="{$align}"/>
                       </xapl:otherwise>
                       </xapl:choose>
                        </xapl:for-each>
                    </TR>
                    <!-- Filter Header Row-->
                    <!--FORM DataSourceName="//BCMINService/getFilterData" Name="search_form" Action="dbtable.jsp" Method="GET" Target="appFrame"-->
                    <TR Filter="yes">
                        <!-- Select All -->
                        <xapl:if test="$pReportFormat/@Selectable = 'All'">
                            <TD Sequence="-100"/>
                        </xapl:if>
                        <xapl:if test="$pReportFormat/@Selectable = 'Single'">
                            <TD Sequence="-100"/>
                        </xapl:if>
                        <!-- Filter Header Columns -->
                        <xapl:for-each varName="col" select="$varcustdisplay/FIELDS/FIELD">
                        <!--<xapl:print> 
              <xapl:value-of select="'filter_type :::'"/>
              <xapl:value-of select="$col"/>    
              <xapl:value-of select="$col/@Filter_type"/>            
                        </xapl:print> -->
                            <!-- type for filter (all text except hidden TODO anish (date/number) ) -->
                            <xapl:variable name="type">
                                <xapl:choose>
                                    <xapl:when test="$col/@DisplayType = 'Hidden'">None</xapl:when>
                                    <xapl:when test="$col/@DisplayType = 'DateTime'">DateFilter</xapl:when>
                                    <xapl:when test="$col/@DisplayType = 'Date'">DateFilter</xapl:when>
                                    <xapl:when test="$col/@DisplayType = 'Number'">NumberFilter</xapl:when>
                                    <xapl:when test="$col/@Filter_type = 'dropdown'">Select</xapl:when>
                                    <xapl:when test="$col/@Hidden = 'yes'">None</xapl:when>
                                    <xapl:otherwise>Text</xapl:otherwise>
                                </xapl:choose>
                            </xapl:variable>
                            <xapl:variable name="filter">
                                <xapl:value-of select="$col/@Filter"/>
                            </xapl:variable>
                            <!-- <xapl:print> 
                  <xapl:value-of select="'THIS IN CONTROLLER :::'"/>
                  <xapl:value-of select="$this"/>                            
                            </xapl:print> -->                            
                            <!-- Options if Select -->
                <xapl:variable name="options">
                  <xapl:choose>
                <xapl:when test="$col/@Filter_dataSourceType = 'Command'">
                  <x2:execute command="{$col/@Filter_dataSourceName}">
                    <x2:with-param name="this" select="{$this}"/>
                  </x2:execute>
                </xapl:when>
                  </xapl:choose>
                </xapl:variable>
                <!-- leave blank the image and checkbox filters -->
                <xapl:choose>
                  <xapl:when test="$col/@DisplayType = 'None'"/>
                  <xapl:otherwise>
                    <TD Sequence="{$col/@Sequence}" Name="{concat('F_' , $col/@Name)}" Type="{$type}" Filter="{$filter}" Value="{$this/*[name() = concat('F_' , $col/@Name) ]/@Value}">
                    <!-- Generate Options -->
                    <!--xapl:print select="$options"/-->
                      <xapl:for-each varName="option" select="{$options/PROPERTY[@Name =$col/@Name]/*}">
                          <!--<xapl:print select="$option/@Value"/>-->
                          <OPTION Id="{$option/@Value}" Value="{$option/@Value}"/>
                        </xapl:for-each>
                  </TD>
                  </xapl:otherwise>
                </xapl:choose>
            </xapl:for-each>
                    </TR>
                    <!--/FORM-->
                    <!-- Result Rows -->
                    <!-- Give default id - Used for check box (Value)-->
                    <xapl:variable name="idName">
                        <xapl:choose>
                            <xapl:when test="string-length($pReportFormat/@Id) > 0">
                                <xapl:value-of select="$pReportFormat/@Id"/>
                            </xapl:when>
                            <xapl:otherwise>ID</xapl:otherwise>
                        </xapl:choose>
                    </xapl:variable>
                    <xapl:variable name="selectedIdName1">
                        <xapl:choose>
                            <xapl:when test="string-length($pReportFormat/@SelectedId) > 0">
                                <xapl:value-of select="$pReportFormat/@SelectedId"/>
                            </xapl:when>
                            <xapl:otherwise>ID</xapl:otherwise>
                        </xapl:choose>
                    </xapl:variable>
                    <xapl:variable name="count" select="0"/>
                    <xapl:for-each varName="row" select="$pReportData/*[name() != 'TOTAL_RECORD_COUNT' and name() != 'START_AT_ROW']">
                        <!--xapl:print select="$row"/-->
                        <TR>
                            <xapl:set-variable name="count" select="$count + 1"/>
                            <!-- Select Box -->
                            <!-- MultiSelect -->
                            <xapl:variable name="rowId"/>
                            <xapl:choose>
                                <xapl:when test="$idName = '#'">
                                    <xapl:for-each varName="idName1" select="$pk/NAME">
                                        <xapl:set-variable name="rowId">
                                            <xapl:value-of select="concat( $rowId , '#', $idName1/@Value , '=', get-child-by-name( $row, $idName1/@Value)/@Value ) "/>
                                        </xapl:set-variable>
                                    </xapl:for-each>
                                    <!-- append a # at end too for looping -->
                                    <xapl:set-variable name="rowId">
                                        <xapl:value-of select="concat( $rowId , '#') "/>
                                    </xapl:set-variable>
                                </xapl:when>
                                <xapl:otherwise>
                                    <xapl:set-variable name="rowId">
                                        <xapl:value-of select=" get-child-by-name( $row, $idName)/@Value "/>
                                    </xapl:set-variable>
                                </xapl:otherwise>
                            </xapl:choose>
                            <xapl:variable name="checked">
                                <xapl:choose>
                                    <xapl:when test="count($this/*[name()= $selectedIdName1 and ./@Value = $rowId] ) > 0">true</xapl:when>
                                    <xapl:otherwise>false</xapl:otherwise>
                                </xapl:choose>
                            </xapl:variable>
                            <!--xapl:print select="$checked"/-->
                            <xapl:variable name="quote">'</xapl:variable>
                            <xapl:variable name="onSelectRow">
                                <xapl:value-of select="concat('javascript:onSelectRow(', $quote, $rowId ,$quote, ');javascript:unCheckSelectAllRow();')"/>
                            </xapl:variable>
                            <!--xapl:print select="$onSelectRow"/-->
                            <xapl:if test="$pReportFormat/@Selectable = 'All'">
                                <TD Name="{$selectedIdName1}" Select="multi" Type="CheckBox" Value="{$rowId}" Checked="{$checked}" OnClick="{$onSelectRow}" Sequence="-100"/>
                            </xapl:if>
                            <!-- Single Select in 1 Row - Checked-->
                            <xapl:if test="$pReportFormat/@Selectable = 'Single' and $count='1'">
                                <TD Name="{$selectedIdName1}" Select="single" Type="Radio" Value="{$rowId}" Checked=" " Sequence="-100"/>
                            </xapl:if>
                            <!-- Single Select not in 1 Row - unChecked-->
                            <xapl:if test="$pReportFormat/@Selectable = 'Single' and $count !='1'">
                                <TD Name="{$selectedIdName1}" Select="single" Type="Radio" Value="{$rowId}" Sequence="-100"/>
                            </xapl:if>
                            <!-- Result Columns -->
                            <xapl:for-each varName="col" select="$varcustdisplay/FIELDS/FIELD">
                                <!-- Default - Start:: -->
                                <!-- type -->
                                <xapl:variable name="type">
                                    <xapl:choose>
                                        <xapl:when test="$col/@DisplayType = 'Hidden'">None</xapl:when>
                                        <xapl:otherwise>
                                            <xapl:value-of select="$col/@DisplayType"/>
                                        </xapl:otherwise>
                                    </xapl:choose>
                                </xapl:variable>
                                <!-- format -->
                                <xapl:variable name="format">
                                    <xapl:choose>
                                        <xapl:when test="string-length($col/@Format) > 0">
                                            <xapl:value-of select="$col/@Format"/>
                                        </xapl:when>
                                        <xapl:otherwise/>
                                    </xapl:choose>
                                </xapl:variable>
                                <!-- image -->
                                <xapl:variable name="image">
                                    <xapl:choose>
                                        <xapl:when test="string-length($col/@Image) > 0">
                                            <xapl:value-of select="$col/@Image"/>
                                        </xapl:when>
                                        <xapl:otherwise/>
                                    </xapl:choose>
                                </xapl:variable>
                                <!-- decimals -->
                                <xapl:variable name="decimals">
                                    <xapl:choose>
                                        <xapl:when test="string-length($col/@Decimals) > 0">
                                            <xapl:value-of select="$col/@Decimals"/>
                                        </xapl:when>
                                        <xapl:otherwise/>
                                    </xapl:choose>
                                </xapl:variable>
                                <!--xapl:print select="$type"/>
              <xapl:print select="$image"/-->
                                <!-- Value -->
                                <xapl:variable name="value">
                                    <xapl:choose>
                                        <!-- If Datasource Is Document Link -->
                                        <xapl:when test="$col/@DataSourceType = 'Link'">
                                            <xapl:value-of select="{$row/*/*[name() = $col/@DataSourceName][1]/*[name() = $col/@Name][1]/@Value}"/>
                                        </xapl:when>
                                        <!-- If Datasource is Self  -->
                                        <xapl:when test="{string-length(get-child-by-name( $row, $col/@Name )/@Value) > 0}">
                                            <xapl:value-of select="{get-child-by-name($row, $col/@Name)/@Value}"/>
                                        </xapl:when>
                                        <xapl:otherwise>
                                            <xapl:value-of select="$col/@Value"/>
                                        </xapl:otherwise>
                                    </xapl:choose>
                                </xapl:variable>
                                <!-- Options if Select -->
                                <xapl:variable name="options">
                                    <xapl:choose>
                                        <xapl:when test="$col/@DataSourceType = 'Command'">
                                            <!--
                      <x2:execute command="{$col/@DataSourceName}">
                        <x2:with-param name="this" select="{$this}"/>
 -                      </x2:execute>
-->
                                        </xapl:when>
                                        <xapl:when test="$col/@DataSourceType = 'Method'">
                                            <xcore:execute-method name="{$col/@DataSourceName}"/>
                                        </xapl:when>
                                    </xapl:choose>
                                </xapl:variable>
                                <xapl:variable name="encodedParam"/>
                                <xapl:variable name="onclick"/>
                                <xapl:choose>
                                    <xapl:when test="$col/@OnClick">
                                        <xapl:value-of select="$col/@OnClick"/>
                                    </xapl:when>
                                    <xapl:when test="string-length($col/@Url) > 0">
                                        <xapl:choose>
                                            <!-- If all row data need to be passed -->
                                            <xapl:when test="$col/@UrlParam = 'All'">
                                                <xapl:variable name="pParam"/>
                                                <xapl:set-variable name="encodedParam">
                                                    <xapl:if test="string-length($rowId) > 0">
                                                        <web:url-encode select="$rowId"/>
                                                    </xapl:if>
                                                </xapl:set-variable>
                                                <xapl:set-variable name="pParam">
                                                    <xapl:value-of select="concat($selectedIdName1,'=',$encodedParam , '&amp;')"/>
                                                </xapl:set-variable>
                                                <xapl:for-each varName="othercol" select="$varcustdisplay/FIELDS/FIELD">
                                                    <!-- Value -->
                                                    <xapl:variable name="othercolvalue">
                                                        <xapl:choose>
                                                            <!-- If Datasource Is Document Link -->
                                                            <xapl:when test="$othercol/@DataSourceType = 'Link'">
                                                                <xapl:value-of select="{$row/*/*[name() = $othercol/@DataSourceName][1]/*[name() = $othercol/@Name][1]/@Value}"/>
                                                            </xapl:when>
                                                            <!-- If Datasource is Self  -->
                                                            <xapl:when test="{string-length(get-child-by-name($row, $othercol/@Name)/@Value) > 0}">
                                                                <xapl:value-of select="{get-child-by-name($row, $othercol/@Name)/@Value}"/>
                                                            </xapl:when>
                                                            <xapl:otherwise>
                                                                <xapl:value-of select="$othercol/@Value"/>
                                                            </xapl:otherwise>
                                                        </xapl:choose>
                                                    </xapl:variable>
                                                    <xapl:if test="$othercolvalue != 'null' and string-length($othercolvalue) > 0">
                                                        <xapl:set-variable name="encodedParam">
                                                            <web:url-encode select="$othercolvalue"/>
                                                        </xapl:set-variable>
                                                        <xapl:set-variable name="pParam">
                                                            <xapl:value-of select="concat($pParam,$othercol/@Name,'=',$encodedParam, '&amp;')"/>
                                                        </xapl:set-variable>
                                                    </xapl:if>
                                                </xapl:for-each>
                                                <xapl:set-variable name="onclick">
                                                    <xapl:value-of select="concat($col/@Url, '?', $pParam)"/>
                                                </xapl:set-variable>
                                            </xapl:when>
                                            <!-- ParamName and Value-->
                                            <xapl:when test="string-length($col/@UrlParamName) > 0">
                                                <xapl:set-variable name="encodedParam">
                                                    <xapl:if test="string-length($value) > 0">
                                                        <web:url-encode select="$value"/>
                                                    </xapl:if>
                                                </xapl:set-variable>
                                                <xapl:set-variable name="onclick">
                                                    <xapl:value-of select="concat($col/@Url, '?', $col/@UrlParamName, '=' , $encodedParam)"/>
                                                </xapl:set-variable>
                                            </xapl:when>
                                            <!-- Default - Name and Value-->
                                            <xapl:otherwise>
                                                <xapl:set-variable name="encodedParam">
                                                    <xapl:if test="string-length($value) > 0">
                                                        <web:url-encode select="$value"/>
                                                    </xapl:if>
                                                </xapl:set-variable>
                                                <xapl:set-variable name="onclick">
                                                    <xapl:choose>
                                                        <xapl:when test="contains($col/@Url, '?')">
                                                            <xapl:value-of select="concat($col/@Url, '&amp;', $col/@Name, '=', $encodedParam)"/>
                                                        </xapl:when>
                                                        <xapl:otherwise>
                                                            <xapl:value-of select="concat($col/@Url, '?', $col/@Name, '=', $encodedParam)"/>
                                                        </xapl:otherwise>
                                                    </xapl:choose>
                                                </xapl:set-variable>
                                            </xapl:otherwise>
                                        </xapl:choose>
                                    </xapl:when>
                                    <xapl:otherwise/>
                                </xapl:choose>
                                <!-- Default - End. -->
                                <!--xapl:print>       
                ################### <xapl:value-of select="$value"/>
                </xapl:print-->
                                <!-- Put the TD -->
                                <TD I18Nize="{$col/@I18Nize}" Sequence="{$col/@Sequence}" Url="{$onclick}" Type="{$type}" Image="{$image}" Decimals="{$decimals}" Format="{$format}" Name="{$col/@Name}" Value="{$value}" NoWrap="{$col/@DisplayNoWrap}" Editable="{$col/@Editable}" SelectAll="{$col/@SelectAll}" Target="{$col/@Target}" Required="{$col/@Required}">
                                    <!-- Generate Options -->
                                    <xapl:for-each varName="option" select="{$options/*}">
                                        <OPTION Id="{$option/VALUE_ID/@Value}" Value="{$option/DESCRIPTION/@Value}"/>
                                    </xapl:for-each>
                                </TD>
                            </xapl:for-each>
                        </TR>
                    </xapl:for-each>
                    <xapl:if test="get-child-by-name( $this, $selectedIdName1)">
                        <TR Type="Hidden">
                            <!-- Hide Previously selected Fields -->
                            <!-- For each selected id -->
                            <xapl:for-each select="get-child-by-name( $this, $selectedIdName1 )/@Value" varName="id">
                                <!-- Need to change this too -->
                                <xapl:if test="count($pReportData/*/*[name() = $idName and @Value = $id]) = 0">
                                    <TD Name="{$selectedIdName1}" Type="Hidden" Value="{$id}"/>
                                </xapl:if>
                            </xapl:for-each>
                        </TR>
                    </xapl:if>
                    <xapl:value-of select="$pReportFormat/BUTTONS"/>
                    <xapl:value-of select="$pReportFormat/PAGINATION"/>
                </TABLE>
            </REPORT>
        </xapl:return>
    </x2:command>
    <!-- ********************************************************************** 
  *********************************************************************** -->
    <x2:command public="yes" description="_" name="generate_csv">
        <x2:param name="pReportFormat"/>
        <x2:param name="pReportData"/>
        <!-- Table -->
        <xapl:variable name="csvTable">
            <RESULT Value=""/>
        </xapl:variable>
        <!-- Table Header -->
        <xapl:variable name="tableHeader">
            <RESULT Value=""/>
        </xapl:variable>
        <xapl:for-each varName="col" select="$pReportFormat/FIELDS/FIELD[string-length(@Type) = 0 or @Type !='Hidden']">
            <!-- Get i18n col header -->
            <xapl:variable name="colHeader">
                <i18n:text>
                    <xapl:value-of select="$col/@DisplayText"/>
                </i18n:text>
            </xapl:variable>
            <!-- Add col header  to table header -->
            <docutil:set select="$tableHeader/@Value">
                <xapl:value-of select="concat($tableHeader/@Value, $colHeader , ',')"/>
            </docutil:set>
        </xapl:for-each>
        <!-- Add table Header to table -->
        <docutil:set select="$csvTable/@Value">
            <xapl:value-of select="concat($csvTable/@Value, $tableHeader/@Value , '&#10;')"/>
        </docutil:set>
        <xapl:variable name="tableRow">
            <RESULT Value=""/>
        </xapl:variable>
        <xapl:for-each varName="row" select="$pReportData/*[name() != 'TOTAL_RECORD_COUNT' and name() != 'START_AT_ROW']">
            <!-- Table Row -->
            <docutil:remove select="$tableRow/@Value"/>
            <xapl:for-each varName="col" select="$pReportFormat/FIELDS/FIELD[(string-length(@Type) = 0 ) or @Type != 'Hidden']">
                <!-- Give default type -->
                <xapl:variable name="type">
                    <xapl:choose>
                        <xapl:when test="string-length($col/@DisplayType) > 0">
                            <xapl:value-of select="$col/@DisplayType"/>
                        </xapl:when>
                        <xapl:when test="$col/@Type = 'Hidden'">None</xapl:when>
                        <xapl:otherwise>Text</xapl:otherwise>
                    </xapl:choose>
                </xapl:variable>
                <!-- TODO-  I18n: on cell data -->
                <!-- get i18n cell Data -->
                <xapl:variable name="cellData">
                    <xapl:choose>
                        <!-- If Datasource Is Document Link -->
                        <xapl:when test="$col/@DataSourceType = 'Link'">
                            <xapl:value-of select="$row/*/*[name() = $col/@DataSourceName]/*[name() = $col/@Name]/@Value"/>
                        </xapl:when>
                        <!-- If Datasource is Self  -->
                        <xapl:otherwise>
                            <xapl:value-of select="$row/*[name() = $col/@Name]/@Value"/>
                        </xapl:otherwise>
                    </xapl:choose>
                </xapl:variable>
                <xapl:variable name="cellData_i18n">
                    <x2:execute command="core.report.controller:i18nize">
                        <x2:with-param name="pData" select="$cellData"/>
                        <x2:with-param name="pType" select="$col"/>
                    </x2:execute>
                </xapl:variable>
                <!-- Add the cell to the Row -->
                <docutil:set select="$tableRow/@Value">
                    <xapl:value-of select="concat($tableRow/@Value, $cellData_i18n, ',')"/>
                </docutil:set>
            </xapl:for-each>
            <!-- Column -->
            <!-- Add the row to table -->
            <docutil:set select="$csvTable/@Value">
                <xapl:value-of select="concat($csvTable/@Value, $tableRow/@Value, '&#10;')"/>
            </docutil:set>
        </xapl:for-each>
        <!-- Row -->
        <xapl:print> csv <xapl:value-of select="{$csvTable}"/>
        </xapl:print>
        <xapl:return>
            <xapl:value-of select="$csvTable/@Value"/>
        </xapl:return>
    </x2:command>
    <!-- ********************************************************************** 
  *********************************************************************** -->
    <x2:command public="yes" description="_" name="getHiddenFields">
        <xapl:return>
            <FIELD Type="Hidden" Name="DIRECTORY" Value="{$this/DIRECTORY[position() = 1]/@Value}"/>
            <FIELD Type="Hidden" Name="FILE" Value="{$this/FILE[position() = 1]/@Value}"/>
            <FIELD Type="Hidden" Name="PAGE" Value="{$this/PAGE[position() = 1]/@Value}"/>
            <FIELD Name="SORT_BY" Type="Hidden" Value="{$this/SORT_BY[position() = 1]/@Value}"/>
            <!-- DOC_TYPE will go -->
            <FIELD Name="DOC_TYPE" Type="Hidden" Value="{$this/DOC_TYPE[position() = 1]/@Value}"/>
            <FIELD Name="OBJECT_TYPE" Type="Hidden" Value="{$this/OBJECT_TYPE[position() = 1]/@Value}"/>
            <FIELD Type="Hidden" Name="JSCRIPT" Value="{$this/JSCRIPT[position() = 1]/@Value}" Visibility="Simple"/>
            <FIELD Type="Hidden" Name="SHOW_HEADER" Value="{$this/SHOW_HEADER[position() = 1]/@Value}" Visibility="Simple"/>
            <FIELD Name="SORT_ORDER" Type="Hidden" Value="{$this/SORT_ORDER[position() = 1]/@Value}"/>
            <FIELD Type="Hidden" Name="RET_PAGE" Value="{$this/RET_PAGE[position() = 1]/@Value}" Visibility="Simple"/>
            <FIELD Type="Hidden" Name="DO_SEARCH" Value="{$this/DO_SEARCH/@Value}" Visibility="Simple"/>
        </xapl:return>
    </x2:command>
    <!-- ********************************************************************** 
  *********************************************************************** -->
    <x2:command public="yes" description="_" name="getHiddenFields_saveReport">
        <xapl:return/>
    </x2:command>
    <!-- ********************************************************************** 
  *********************************************************************** -->
    <x2:command public="yes" description="_" name="saveReport">
        <xapl:print>
      SAVE THIS REPORT
        <xapl:value-of select="$this"/>
        </xapl:print>
        <docutil:set select="$this">
            <MAX_ROWS Value="100000"/>
            <START_COUNT Value="0"/>            
        </docutil:set>
        <x2:param name="directory" select="$this/DIRECTORY/@Value"/>
        <x2:param name="file" select="$this/FILE/@Value"/>
        <x2:param name="pFormat" select="'xls'"/>
        <!--xapl:variable name="getSearchFormConfig">
      <xapl:value-of select="concat($directory,'.', $file,':getSearchFormConfig')"/>
    </xapl:variable-->
        <xapl:variable name="getSearchReportConfig">
            <xapl:value-of select="concat($directory,'.', $file,':getReportConfig')"/>
        </xapl:variable>
        <xapl:variable name="getReportData">
            <xapl:value-of select="concat($directory,'.', $file,':getReportData')"/>
        </xapl:variable>
        <xapl:variable name="fileName" select="concat($this/TABLE_NAME/@Value, '.', 'xls')"/>
        <!-- Get Form Config-->
        <!--xapl:variable name="form">
      <x2:execute command="{$getSearchFormConfig}">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
    </xapl:variable-->
        <!-- Get Report Config -->
        <xapl:variable name="reportFormat">
            <x2:execute command="{$getSearchReportConfig}">
                <x2:with-param name="this" select="{$this}"/>
            </x2:execute>
        </xapl:variable>
        <!-- Get Report Data -->
        <docutil:set select="$this/DO_SEARCH/@Value">Yes</docutil:set>
        <xapl:variable name="reportData">
            <x2:execute command="{$getReportData}">
               <x2:with-param name="pIds">
                 <xapl:if test="$this/EXPORT_ALL/@Value='NO'">
                    <IDS>
                      <OR>
                        <xapl:for-each varName="selectedId" select="$this/SELECTED_ID">
                          <AND>
                            <xapl:variable name="selecteIdXMLTree">
                              <x2:execute command="bcm.framework.tableeditor.Table:createXMLFromSelectedId">
                                <x2:with-param name="selectedId" select="$selectedId/@Value"/>
                              </x2:execute>
                            </xapl:variable>
                            <xapl:print select="$selecteIdXMLTree/*"/>
                            <xapl:value-of select="$selecteIdXMLTree/*"/>
                            <xapl:value-of select="$this/LAST_MODIFIED_DATE"/>
                          </AND>
                        </xapl:for-each>
                      </OR>
                    </IDS>
                  </xapl:if>
              </x2:with-param>
              <x2:with-param name="this" select="$this"/>
            </x2:execute>
        </xapl:variable>
        <xapl:print>
      REPORT DATA :::::::::::
        <xapl:value-of select="$reportData"/>
        </xapl:print>
        <!-- get Actual Report-->
        <xapl:variable name="report">
            <xapl:choose>
                <xapl:when test="$pFormat = 'csv'">
                    <x2:execute command="core.report.controller:generate_csv">
                        <x2:with-param name="pReportData" select="$reportData"/>
                        <x2:with-param name="pReportFormat" select="$reportFormat"/>
                    </x2:execute>
                </xapl:when>
                <xapl:when test="$pFormat = 'xls'">
                    <x2:execute command="core.report.controller:generate_csv">
                        <x2:with-param name="pReportData" select="$reportData"/>
                        <x2:with-param name="pReportFormat" select="$reportFormat"/>
                    </x2:execute>
                </xapl:when>
                <xapl:when test="$pFormat = 'xml'">
                    <xapl:value-of select="$reportData"/>
                </xapl:when>
            </xapl:choose>
        </xapl:variable>
        <xapl:print>
      REPORT CSV :::::::::::
        <xapl:value-of select="$report"/>
        </xapl:print>
        <!-- downloadFile-->
        <x2:execute command="bcm.framework.common:downloadFile">
            <x2:with-param name="pFileContents" select="$report"/>
            <x2:with-param name="pFileName" select="$fileName"/>
            <x2:with-param name="pFileType" select="'text'"/>
        </x2:execute>
    </x2:command>
    <!-- ********************************************************************** 
  *********************************************************************** -->
    <x2:command public="yes" description="_" name="downloadDocument">
        <x2:param name="pFile" select="$this/FILE/@Value"/>
        <x2:param name="pDataSourceName" select="$this/DATA_SOURCE_NAME/@Value"/>
        <x2:param name="pDataRootName" select="concat($this/OBJECT_TYPE/@Value, 'S')"/>
        <x2:param name="pIdFilterName" select="$this/ID_FILTER_NAME/@Value"/>
        <xapl:variable name="fileName" select="concat($pFile, '.', 'xml')"/>
        <!-- Get the data -->
        <xapl:variable name="data">
            <docutil:element name="{$pDataRootName}">
                <xapl:for-each varName="id" select="{$this/ID}">
                    <xcore:execute-method name="{$pDataSourceName}">
                        <docutil:element name="{$pIdFilterName}" Value="{$id/@Value}"/>
                    </xcore:execute-method>
                </xapl:for-each>
            </docutil:element>
        </xapl:variable>
        <!-- downloadFile-->
        <x2:execute command="bcm.framework.common:downloadFile">
            <x2:with-param name="pFileContents" select="$data"/>
            <x2:with-param name="pFileName" select="$fileName"/>
            <x2:with-param name="pFileType" select="'xml'"/>
        </x2:execute>
    </x2:command>
    <!-- ********************************************************************** 
  *********************************************************************** -->
    <x2:command public="yes" description="_" name="i18nize">
        <x2:param name="pData"/>
        <x2:param name="pType"/>
        <xapl:variable name="type">
            <xapl:choose>
                <xapl:when test="$pType/@Type">
                    <xapl:value-of select="$pType/@Type"/>
                </xapl:when>
                <xapl:otherwise>Text</xapl:otherwise>
            </xapl:choose>
        </xapl:variable>
        <xapl:variable name="format">
            <xapl:choose>
                <xapl:when test="$pType/@Format">
                    <xapl:value-of select="$pType/@Format"/>
                </xapl:when>
                <xapl:otherwise>common</xapl:otherwise>
            </xapl:choose>
        </xapl:variable>
        <xapl:variable name="datetimeformat">datetime</xapl:variable>
        
        <xapl:return>
            <xapl:choose>
                <xapl:when test="$type='Text'">
                    <i18n:text>
                        <xapl:value-of select="$pData"/>
                    </i18n:text>
                </xapl:when>
                <xapl:when test="$type='Currency'">
                    <i18n:currency>
                        <xapl:value-of select="$pData"/>
                    </i18n:currency>
                </xapl:when>
                <xapl:when test="$type='Number'">
                    <i18n:number>
                        <xapl:value-of select="$pData"/>
                    </i18n:number>
                </xapl:when>
                <xapl:when test="$type='Date'">
                    <i18n:date format="{$format}">
                        <xapl:value-of select="$pData"/>
                    </i18n:date>
                </xapl:when>
                <xapl:when test="$type='DateTime'">
                    <i18n:date format="{$datetimeformat}">
                        <xapl:value-of select="$pData"/>
                    </i18n:date>
                </xapl:when>
            </xapl:choose>
        </xapl:return>
    </x2:command>
</x2:commands>
