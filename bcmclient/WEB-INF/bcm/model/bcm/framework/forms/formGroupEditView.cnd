<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:xapl="http://www.i2.com/xapl" xmlns:i18n="http://www.i2.com/i18n" xmlns:docutil="http://www.i2.com/docutil" xmlns:xcore="http://www.i2.com/xcore" xmlns:identity="http://www.i2.com/identity" >
  <x2:command name="getPageContent" public="yes">
    <xapl:print select="$this"/>
    <docutil:add select="$this">
      <xapl:value-of select="$requestParams/*"/>
    </docutil:add>
    <xapl:print select="$this"/>
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
      <x2:with-param name="display" select=" 'Group Edit Page' "/>
      <x2:with-param name="page" select=" 'groupEditForm' "/>
      <x2:with-param name="this" select="$this"/>
    </x2:execute>
    <!-- create form in session -->
    <x2:execute command="bcm.framework.queryform.Form:create">
      <x2:with-param name="pFormName" select="$this/FORM_NAME[1]/@Value"/>
      <x2:with-param name="pServiceName" select="$this/SERVICE[1]/@Value"/>
    </x2:execute>

    <xapl:variable name="dateFormat">
      <identity:get-date-format format="common"/>
    </xapl:variable>

    <xapl:return>
      <PAGE>
        <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
        <!--        <x2:execute command="bcm.framework.forms.formGroupEditView:getHeader"/>-->
        <x2:execute command="bcm.framework.forms.formGroupEditView:getPageLayout">
          <x2:with-param name="this" select="{$this}"/>
        </x2:execute>
        <PRESENTATION>
          <x2:execute command="bcm.framework.forms.formGroupEditView:getPresentation">
            <x2:with-param name="tableName" select="$this/TABLE_NAME/@Value"/>
            <x2:with-param name="formId" select="$this/FORM_ID/@Value"/>
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
        </PRESENTATION>
        <!--xapl:print>
		  BEFORE ADD TO THIS##
		  this##
		  <xapl:value-of select="$this"/>
		  AND sessionData ##
		  <xapl:value-of select="$sessionData"/>
	   </xapl:print-->

	   <!--Starts here
	   Added the snippet below to add prev form data when user comes back from table editr fk look-up. Before adding sessiondata, removing elements from $this to
	   prevent it from growing huge with duplicate data.-->

	   <xapl:if test="$this/USE_SESSIONDATA/@Value = 'TRUE'">
	    <xapl:if test="$this/FROM_SELECT_FOREIGN_KEY/@Value = 'true'">
		  <xapl:for-each varName="s_vars" select="$sessionData/SESSION_DATA/*">
		    <xapl:variable name="curPropName">
			  <xapl:value-of select="name($s_vars)"/>
		    </xapl:variable>
		    <docutil:remove select="$this/*[name() = $curPropName]"/>
		  </xapl:for-each>
		  <docutil:add select="$this">
		    <xapl:value-of select="$sessionData/SESSION_DATA/*"/>
		  </docutil:add>
		  <docutil:remove select="$sessionData/SESSION_DATA/*"/>
	      <docutil:set select="$this/USE_SESSIONDATA/@Value = 'NO'"/>
	    </xapl:if>
	    <!-- ends here-->
	    <!--xapl:print>
		  AFTER ADD TO THIS##
		  <xapl:value-of select="$this"/>
	     </xapl:print-->
	   </xapl:if>
        <SUBMITTED_DATA>
          <xapl:value-of select="$this/*"/>
        </SUBMITTED_DATA>
      </PAGE>
      <FORMAT Date="{$dateFormat}"/>
      <xapl:if test="count($this/ERROR_MESSAGE) > 0 ">
        <ERROR_MESSAGE Value="{$this/ERROR_MESSAGE/@Value}"/>
      </xapl:if>
    </xapl:return>
  </x2:command>
  <x2:command name="getHeader">
    <xapl:return>
      <HEADER>
        <APP_NAME Value="Data Management"/>
        <TOGGLE_NAV Value="../"/>
        <HEADING Value="Group Edit Page"/>
        <HOME Value="bcm/framework/home.jsp"/>
      </HEADER>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="getPageLayout">
    <x2:param name="this"/>
        <xapl:variable name="helpUrl">
           <xapl:choose>
           <xapl:when test="$this/FORM_ID/@Value = 'MST_OP_SRCH_FORM' ">
              <xapl:value-of select=" 'Mass_update_operations.htm' "/>
           </xapl:when>
           <xapl:otherwise>
              <xapl:value-of select=" 'mass_update.html' "/>
           </xapl:otherwise>
           </xapl:choose>
         </xapl:variable>
<!--    <xapl:variable name="helpUrl">
      <xapl:choose>
        <xapl:when test="$this/FORM_ID/@Value = 'BOD_GROUP_EDIT_FORM' ">
          <xapl:value-of select=" 'updateBOD_help.htm' "/>
        </xapl:when>
        <xapl:when test="$this/FORM_ID/@Value = 'MST_CR_GRP_GROUP_EDIT_FORM' ">
          <xapl:value-of select=" 'updateCrGroup_help.htm' "/>
        </xapl:when>
        <xapl:when test="$this/FORM_ID/@Value = 'MST_IBR_GROUP_EDIT_FORM' ">
          <xapl:value-of select=" 'updateMfgOperation_help.htm' "/>
        </xapl:when>
        <xapl:when test="$this/FORM_ID/@Value = 'MST_ILC_DEM_STAT_GROUP_EDIT_FORM' ">
          <xapl:value-of select=" 'updateILCDemand_help.htm' "/>
        </xapl:when>
        <xapl:when test="$this/FORM_ID/@Value = 'MST_ILC_GROUP_EDIT_FORM' ">
          <xapl:value-of select=" 'updateILC_help.htm' "/>
        </xapl:when>
        <xapl:when test="$this/FORM_ID/@Value = 'MST_IL_GROUP_EDIT_FORM' ">
          <xapl:value-of select=" 'updateIL_help.htm' "/>
        </xapl:when>
        <xapl:when test="$this/FORM_ID/@Value = 'MST_IL_REP_PARAM_GROUP_EDIT_FORM' ">
          <xapl:value-of select=" 'updateILTime_help.htm' "/>
        </xapl:when>
        <xapl:when test="$this/FORM_ID/@Value = 'MST_OLT_GRP_GROUP_EDIT_FORM' ">
          <xapl:value-of select=" 'updateOLTGroup_help.htm' "/>
        </xapl:when>
      </xapl:choose>
    </xapl:variable>-->
    <!-- change made for 539199 -->
    <xapl:variable name="containerTitle">
          <i18n:text>Group Edit Form Contents</i18n:text>
    </xapl:variable>
    <!-- change made for 539199 -->
    <xapl:return>
     <xapl:variable name="Header">
           <i18n:text>Group Edit Form Contents</i18n:text>
     </xapl:variable>
     <LAYOUT>

        <CONTAINER Title="{$Header}" Id="groupEditContainer" Scrollable="yes" NonScrollableAreaWidth="15">
          <HELP Url="{concat('../../help/', $helpUrl)}"/>
          <CUSTOM_TEMPLATE/>
          <BUTTONS>
            <BUTTON Id="cancel" DisplayText="Cancel" OnClick="javascript:onCancel();" DisableOnClick="true"/>
            <BUTTON Id="save" DisplayText="Save And Return" Emphasized="yes" OnClick="javascript:onSave();" DisableOnClick="true"/>
          </BUTTONS>
        </CONTAINER>
      </LAYOUT>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="getPresentation">
    <x2:param name="tableName"/>
    <x2:param name="formId"/>
    <x2:param name="this"/>
    <!-- Property option types for dropdowns would have been set in session; use them -->
    <xapl:variable name="optionTypes">
      <x2:execute command="bcm.framework.queryform.Form:getOptionTypes">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
      <!--
      <xapl:value-of select="$currentFormsOptionData/SERVICE[@Name = $this/SERVICE/@Value]/FORM[@Name = $currentForm/@Id]/OPTION_TYPES"/>
-->
    </xapl:variable>
    <xapl:print select="$optionTypes"/>
    <xapl:variable name="presentation">
      <!-- The @Name attribute at the HTML_TABLE level below is not being used currently; So setting it to the first updatable document in the queryform -->
      <HTML_TABLE Name="{$currentForm/UPDATE_DOCUMENTS/DOCUMENT[1]/@Name}">
        <xapl:for-each select="$currentForm/RESULT_PROPERTIES/RESULT_PROPERTY[PRESENTATION/GROUP_EDITABLE/@Value = 'yes' ]" varName="column">
          <!-- For properties which have enumerated values that need to appear as a dropdown, will these values as children of the PROPERTY -->
          <xapl:variable name="displayType">
            <xapl:choose>
              <xapl:when test="count($column/DATASOURCE) > 0">
                <xapl:value-of select="'dropdown'"/>
              </xapl:when>
              <xapl:otherwise>
                <xapl:value-of select="$column/PRESENTATION/SEARCH_BY/@Value"/>
              </xapl:otherwise>
            </xapl:choose>
          </xapl:variable>
          <xapl:variable name="req">
            <xapl:if test="$column/@Required = 'yes'">
              <xapl:value-of select="$column/@Required"/>
            </xapl:if>
          </xapl:variable>
          <PROPERTY
            Name="{$column/@Property}"
            Document="{$column/@Document}"
            DisplayName="{$column/@DisplayName}"
            DefaultValue="{$column/@DefaultValue}"
            Type="{$column/@Type}"
            MinValue="{$column/@MinValue}"
            MaxValue="{$column/@MaxValue}"
            DisplayType="{$displayType}"
            Required="{$req}"
            Refers="{$column/@Refers}"
            ReferredColumn="{$column/@ReferredColumn}"
            Hyperlink="{$column/PRESENTATION/GROUP_EDITABLE_HYPERLINK/@Value}">
            <xapl:if test="count($column/DATASOURCE) > 0">
              <xapl:value-of select="$optionTypes/PROPERTY[@Name = $column/@Property]/VALID_VALUE"/>
            </xapl:if>
          </PROPERTY>
        </xapl:for-each>
      </HTML_TABLE>
    </xapl:variable>
    <xapl:print select="$presentation"/>
    <xapl:return>
      <xapl:value-of select="$presentation"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
</x2:commands>
