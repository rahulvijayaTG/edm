<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- **********************************************************************
  *********************************************************************** -->
  
  <x2:command public="yes" description="_" name="load">
    <x2:param name="this" select="$this"/>
    
    <docutil:remove select="$this/MAX_ROWS"/>
    <xapl:if test="$this/MODE/@Value = 'START'">
      <docutil:remove select="$this/MODE"/>
      <x2:execute command="bcm.context.controller:cleanContext"/>
    </xapl:if>
    <!-- BREADCRUMBS AT TOP OR AFTER CLEAN-CONTEXT-->
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
      <x2:with-param name="display" select="'Data Validation Error Details'"/>
      <x2:with-param name="page" select="'dataValidationErrorDetail'"/>
      <x2:with-param name="this" select="{$this}"/>
    </x2:execute>

    <xapl:variable name="validationForm">
      <x2:execute command="bcm.framework.queryform.Form:getFormContainer">
        <x2:with-param name="this" select="$this"/>
        <x2:with-param name="pSearchParam" select="$searchParam"/>
        <x2:with-param name="pFormName" select="'DATA_VALIDATION_ERROR_FORM'"/>
        <x2:with-param name="pServiceName" select="'BCMMasterService'"/>
        <x2:with-param name="pSearchReportConfigSource" select="'bcm.framework.alerts.data_validation_summary.data_validation_error_details.dataValidationErrorDetailView:getReportConfig'"/>
        <x2:with-param name="pReportDataSource" select="'bcm.framework.alerts.data_validation_summary.data_validation_error_details.dataValidationErrorDetailView:getReportData'"/>
      </x2:execute>
    </xapl:variable>
    <xapl:print>
  validationForm = <xapl:value-of select="$validationForm"/>
    </xapl:print>
    <xapl:return>
      <!-- Page Header-->
      <x2:execute command="bcm.framework.alerts.data_validation_summary.data_validation_error_details.dataValidationErrorDetailView:getHeader">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
      <!-- Container-->
      <x2:execute command="bcm.framework.alerts.data_validation_summary.data_validation_error_details.dataValidationErrorDetailView:getContainer">
        <x2:with-param name="this" select="{$this}"/>
        <x2:with-param name="pPage" select="'dataValidationErrorDetail'"/>
      </x2:execute>
      <xapl:value-of select="$validationForm"/>
      <!-- return parameters-->
      <xapl:value-of select="$this/*[string-length(@Value) &gt; 0]"/>
      <xapl:value-of select="$context"/>
      <xapl:value-of select="$systemProperties"/>
      <xapl:if test="$userPermissionViewForbcmManageLocation!='True'">
         <ERROR_MESSAGE Value="You do not have view permissions"/>
      </xapl:if>
    </xapl:return>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    <xapl:return>
      <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <x2:param name="pPage"/>
    <xapl:variable name="userPermissionViewForbcmManageLocation">
     <x2:execute command="bcm.framework.common:checkAccessPermissions">
       <x2:with-param name="activityName" select="'bcmManageLocation'"/>
       <x2:with-param name="accessLevel" select="'View'"/>
     </x2:execute>
    </xapl:variable>    
    <xapl:return>
      <CONTAINER Scrollable="yes">
        <STEP Name="ViewForm" DisplayText="Data Validation Error Search" OnClick="{$pages:dataValidationErrorDetail}" Selected="{$pPage = 'dataValidationErrorDetail'}"/>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportConfig">
    <x2:param name="this" select="$this"/>
    <xapl:return>
      <!--REPORT Action="{$pages:dataValidationErrorDetail}" Selectable="All" Scrollable="no" ScrollableContainer="yes" ShowFilter="yes" Id="CLASSIFICATION_ERROR_MAP.UI_ADDRESS|LOG_ERROR_DATA.PRIMARY_KEY|ENTITY_CLASSIFICATION.DOCUMENT_NAME|ENTITY_CLASSIFICATION.SERVICE|LOG_ERROR_DATA.SURR_KEY" SelectedId="SELECTED_ID" PagingTitle="yes"-->
      <REPORT Action="{$pages:dataValidationErrorDetail}" Selectable="All" Scrollable="no" ScrollableContainer="yes" ShowFilter="yes" Id="LOG_ERROR_DATA.PRIMARY_KEY|LOG_ERROR_DATA.SURR_KEY|ENTITY_CLASSIFICATION.DOCUMENT_NAME" SelectedId="SELECTED_ID" PagingTitle="yes">
        <FIELDS>
          <FIELD Name="ACTION" DisplayType="Hidden"/>
          <FIELD Name="ERROR_DATA" DisplayType="Hidden"/>
          <FIELD Name="MARKED" DisplayType="Hidden"/>
          <FIELD Name="UPDATE_ALL" DisplayType="Hidden" Value="{$this/UPDATE_ALL/@Value}"/>
          <xapl:print select="$this/PAGE/@Value"/>
          <!--get form's report fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
          <!-- get Hidden Fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
        </FIELDS>
        <BUTTONS>
	  <BUTTON Id="Cancel" Name="Cancel" DisplayText="Cancel" OnClick="{$pages:dataValidationSummary}"/>
    	  <BUTTON Id="Export" Name="Update" DisplayText="Mark Unchecked" OnClick="javascript:onUpdate('False')" DisableOnClick="true" Disabled="report"/>
	  <BUTTON Id="Delete" Name="Delete" DisplayText="Delete" OnClick="javascript:onDelete()" Disabled="report"/>
	  <BUTTON Id="Export" Name="Export" DisplayText="Export to Excel" OnClick="javascript:onExportToExcelGlobal('dataValidationErrorDetail','xls')" DisableOnClick="true" Disabled="report"/>
	  <BUTTON Id="Search" Name="Search" DisplayText="Search" OnClick="javascript:dispatchSearch()" DisableOnClick="true" Emphasized="yes"/>
        
        </BUTTONS>
        <PAGINATION/>
      </REPORT>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportData">
    <x2:param name="this"/>
    <xapl:variable name="returnVar">
      <x2:execute command="bcm.framework.queryform.Form:getFormReportData">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
    </xapl:variable>
    <xapl:print>
    **********  Value of returnVar in getReportData**********
      <xapl:value-of select="$returnVar"/>
    </xapl:print>
    <xapl:return>
      <xapl:value-of select="$returnVar"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getSearchPage">
    <x2:param name="this" select="$this"/>
    <xapl:print>
    **********  Value of this in getSearchPage**********
      <xapl:value-of select="$this"/>
    </xapl:print>
 		<docutil:remove select="$this/LOG_ERROR_DATA.ID"/>
 		<docutil:remove select="$this/LOG_ERROR_DATA.SURR_KEY"/>
 		<docutil:remove select="$this/CLASSIFICATION_ERROR_MAP.UI_ADDRESS"/>
 		
    <docutil:set select="$this/MARKED/@Value">
      <xapl:value-of select="'True'"/>
    </docutil:set>

    <docutil:remove select="$this/SELECTED_ID"/>

    <docutil:add select="$this">
      <SELECTED_ID Value="{$this/ERROR_DATA/@Value}"/>
    </docutil:add>

    <!--xapl:variable name="pageName">
      <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
        <x2:with-param name="selectedId" select="$this/ERROR_DATA/@Value"/>
        <x2:with-param name="key" select="'CLASSIFICATION_ERROR_MAP.UI_ADDRESS'"/>
      </x2:execute>
    </xapl:variable>
    <xapl:variable name="serviceName">
      <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
        <x2:with-param name="selectedId" select="$this/ERROR_DATA/@Value"/>
        <x2:with-param name="key" select="'ENTITY_CLASSIFICATION.SERVICE'"/>
      </x2:execute>
    </xapl:variable>
    <xapl:variable name="tableName">
      <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
        <x2:with-param name="selectedId" select="$this/TABLE_NAME/@Value"/>
        <x2:with-param name="key" select="'ENTITY_CLASSIFICATION.DOCUMENT_NAME'"/>
      </x2:execute>
    </xapl:variable>
    <xapl:variable name="primaryKeys">
      <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
        <x2:with-param name="selectedId" select="$this/PRIMARY_KEY/@Value"/>
        <x2:with-param name="key" select="'LOG_ERROR_DATA.PRIMARY_KEY'"/>
      </x2:execute>
    </xapl:variable-->
    <xapl:variable name="primaryKeys"/>
    <xapl:set-variable name = "primaryKeys" select="{substring-after($this/PRIMARY_KEY/@Value,'LOG_ERROR_DATA.PRIMARY_KEY=')}"/>

		<x2:execute command="bcm.framework.alerts.data_validation_summary.data_validation_error_details.dataValidationErrorDetailView:updateOneRecord">
      <x2:with-param name="this" select="$this"/>
      <x2:with-param name="pk" select="$primaryKeys"/>
    </x2:execute>      
    
    <xapl:print>
    **********  Value of primaryKeys in getSearchPage**********
      <xapl:value-of select="$primaryKeys"/>
      <xapl:value-of select="$pageName"/>
    </xapl:print>

    <xapl:variable name="primaryKeysXml">
      <x2:execute command="bcm.framework.alerts.data_validation_summary.data_validation_error_details.dataValidationErrorDetailView:getPrimaryKeyData">
        <x2:with-param name="selectedId" select="$primaryKeys"/>
      </x2:execute>
    </xapl:variable>
    <docutil:remove select="$this/SERVICE_NAME"/>
    <docutil:remove select="$this/FORM_NAME"/>

    <docutil:set select="$this">
      <xapl:value-of select="$primaryKeysXml/*"/>
      <DO_SEARCH Value="yes"/>
      <DIRECTORY Value="bcm.framework.tableeditor"/>
      <FILE Value="TableEditorView"/>
      <!--MODE Value="START"/-->
      <!--TABLE_NAME Value="{$tableName}"/-->
      <SERVICE Value="{$this/SERVICE/@Value}"/>
    </docutil:set>
    <xapl:print>
    	printing this here<xapl:value-of select="$this"/>
    </xapl:print>
    <web:display-page>
      <web:get-page name="tableeditor">
        <xapl:value-of select="$this/*"/>
      </web:get-page>    
    </web:display-page>
  </x2:command>
  <!-- **********************************************************************
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="getPrimaryKeyData">
    <x2:param name="selectedId"/>
    <xapl:variable name="keyValue"/>
    <xapl:variable name="keyValueXml"/>
    <xapl:variable name="pkXml"><ROOT/></xapl:variable>
    <!--x2:param name="key"/-->

         <xapl:while test="$selectedId != '*'">
	    <xapl:set-variable name="keyValue" select="{substring-before( substring-after($selectedId , '*' ) , '*')}"/>
	    <xapl:print>VALUE ::::  of key Value Pair  
	    	<xapl:value-of select="$keyValue"/>
	    </xapl:print>
	    <xapl:set-variable name="keyValueXml">
	      <x2:execute command="bcm.framework.alerts.data_validation_summary.data_validation_error_details.dataValidationErrorDetailView:getKeyValueXml">
	        <x2:with-param name="keyValue" select="$keyValue"/>
	      </x2:execute>
	    </xapl:set-variable>
	    <xapl:print>VALUE ::::  of keyValueXml
	    	<docutil:to-xml select="$keyValueXml"/>
	    </xapl:print>
	    <docutil:add select="$pkXml">
              <docutil:to-xml select="$keyValueXml"/>
	    </docutil:add>
  	    <xapl:set-variable name="selectedId" select="{substring-after($selectedId , concat('*' , $keyValue)  )}"/>
         </xapl:while>

	    <xapl:print>VALUE ::::  of pkXml
	    	<xapl:value-of select="$pkXml"/>
	    </xapl:print>

    <xapl:return>
      <xapl:value-of select="$pkXml"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="getKeyValueXml">
    <x2:param name="keyValue"/>
    <xapl:variable name="key"/>
    <xapl:variable name="value"/>
    <xapl:variable name="dQuote">&quot;</xapl:variable>
    <xapl:variable name="keyValueXml"/>

    <xapl:set-variable name="key" select="{substring-before($keyValue , '=')}"/>
    <xapl:print>Key ::::  
    	<xapl:value-of select="$key"/>
    </xapl:print>
    <xapl:set-variable name="value" select="{substring-after($keyValue , '=')}"/>
    <xapl:print>Value ::::  
    	<xapl:value-of select="$value"/>
    </xapl:print>
    <xapl:set-variable name="keyValueXml" select="{concat('&lt;' , 'F_', $key , ' ' , 'Value=' , $dQuote , $value , $dQuote , '/' , '&gt;')}"/>
    <xapl:return>
      <xapl:value-of select="$keyValueXml"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="updateRecord">
	    <x2:param name="this" select="$this"/>
	    <xapl:variable name="pk"/>
	    <xapl:variable name="surrKey"/>
	    <xapl:print select="$this"/>
	    <xapl:variable name="request" select="{concat('//' , 'BCMMasterService/modifyDocSmart')}"/>
	    <xapl:variable name="serverResponse">
	      <xcore:execute-method name="{$request}" Action="MASS_UPDATE" DocumentName="LOG_ERROR_DATA" entireResponse="true" isBulkRequest="false">
	        <DOCUMENT_CONTEXT>
	          <OR>
	            <xapl:for-each select="$this/SELECTED_ID" varName="pks">
	              <xapl:set-variable name="pk">
											<x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
												<x2:with-param name="selectedId" select="$pks/@Value"/>
												<x2:with-param name="key" select="'LOG_ERROR_DATA.PRIMARY_KEY'"/>
											</x2:execute>
		      			</xapl:set-variable>
	              <xapl:set-variable name="surrKey">
											<x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
												<x2:with-param name="selectedId" select="$pks/@Value"/>
												<x2:with-param name="key" select="'LOG_ERROR_DATA.SURR_KEY'"/>
											</x2:execute>
		      			</xapl:set-variable>
	              <AND>
										<SURR_KEY Value="{$surrKey}"/>
										<PRIMARY_KEY  Value="{$pk}"/> 
	              </AND>
	            </xapl:for-each>
	          </OR>
	        </DOCUMENT_CONTEXT>
	        <UPDATE_PROPERTIES>
	          <MARKED Value="{$this/MARKED/@Value}"/>
	        </UPDATE_PROPERTIES>
	      </xcore:execute-method>
	    </xapl:variable> 
		    <xapl:print>VALUE ::::  of serverResponse in Update
		    	<xapl:value-of select="$serverResponse"/>
		    </xapl:print>
	      <web:display-page>
	        <web:get-page name="dataValidationErrorDetail">
	          <xapl:value-of select="$this"/>
	        </web:get-page>    
	      </web:display-page>
	   
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="deleteRecord">
    <x2:param name="this" select="$this"/>
    <xapl:variable name="pk"/>
    <xapl:variable name="surrKey"/>
    <xapl:variable name="request" select="{concat('//' , 'BCMMasterService/LOG_ERROR_DATA')}"/>
    <xapl:variable name="serverResponse">
      <xcore:remove-document name="{$request}" outputResponse="true">
        <OR>
          <xapl:for-each varName="pks" select="$this/SELECTED_ID">
             <xapl:set-variable name="pk">
	      <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
		<x2:with-param name="selectedId" select="$pks/@Value"/>
		<x2:with-param name="key" select="'LOG_ERROR_DATA.PRIMARY_KEY'"/>
	      </x2:execute>
	    </xapl:set-variable>
            <xapl:set-variable name="surrKey">
	      <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
		<x2:with-param name="selectedId" select="$pks/@Value"/>
		<x2:with-param name="key" select="'LOG_ERROR_DATA.SURR_KEY'"/>
	      </x2:execute>
	    </xapl:set-variable>
            <AND>
	      <SURR_KEY Value="{$surrKey}"/>
	      <PRIMARY_KEY  Value="{$pk}"/> 
            </AND>
          </xapl:for-each>
        </OR>
      </xcore:remove-document>
    </xapl:variable>
	    <xapl:print>VALUE ::::  of serverResponse in Delete
	    	<xapl:value-of select="$serverResponse"/>
	    </xapl:print>
    <docutil:remove select="$this/SELECTED_ID"/>
    <docutil:remove select="$this/MARKED"/>
    <web:display-page>
      <web:get-page name="dataValidationErrorDetail">
        <xapl:value-of select="$this/*"/>
      </web:get-page>    
    </web:display-page>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="updateOneRecord">
	    <x2:param name="this" select="$this"/>
	    <x2:param name="pk" select="$primaryKeys"/>
	    <!--xapl:variable name="pk"/>
	    <xapl:variable name="surrKey"/-->
	    <xapl:variable name="request" select="{concat('//' , 'BCMMasterService/modifyDocSmart')}"/>
	    <xapl:variable name="serverResponse">
	      <xcore:execute-method name="{$request}" Action="MASS_UPDATE" DocumentName="LOG_ERROR_DATA" entireResponse="true" isBulkRequest="false">
	        <DOCUMENT_CONTEXT>
	          <OR>
	          		<AND>
		        			<SURR_KEY Value="{$this/SURR_KEY/@Value}"/>
		        			<PRIMARY_KEY  Value="{$pk}"/> 
	              </AND>
	          </OR>
	        </DOCUMENT_CONTEXT>
	        <UPDATE_PROPERTIES>
	          <MARKED Value="{$this/MARKED/@Value}"/>
	        </UPDATE_PROPERTIES>
	      </xcore:execute-method>
	    </xapl:variable>
		    <xapl:print>VALUE ::::  of serverResponse in Update
		    	<xapl:value-of select="$serverResponse"/>
		    </xapl:print>
	      <web:display-page>
	        <web:get-page name="dataValidationErrorDetail">
	          <xapl:value-of select="$this"/>
	        </web:get-page>    
	      </web:display-page>
	    
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
</x2:commands>
