<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
    <x2:param name="this" select="$this"/>
    <xapl:if test="$this/MODE/@Value = 'START'">
      <docutil:remove select="$this/MODE"/>
      <x2:execute command="bcm.context.controller:cleanContext"/>
    </xapl:if>
    <!-- BREADCRUMBS AT TOP OR AFTER CLEAN-CONTEXT-->
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
      <x2:with-param name="display" select="'Data Validation Summary'"/>
      <x2:with-param name="page" select="'dataValidationSummary'"/>
      <x2:with-param name="this" select="{$this}"/>
    </x2:execute>
    
    <!--docutil:set select="$this">
      <DO_SEARCH Value="Yes"/>
      <SERVICE Value="BCMMasterService"/>
      <FORM_NAME Value="MST_LOC_FORM"/>
    </docutil:set-->
    
    <xapl:variable name="reportData">
      <!--x2:execute command="bcm.framework.queryform.Form:getFormContainer">
        <x2:with-param name="this" select="$this"/>
        <x2:with-param name="pSearchParam" select="$searchParam"/>
        <x2:with-param name="pFormName" select="'MST_LOC_FORM'"/>
        <x2:with-param name="pServiceName" select="'BCMMasterService'"/>
        <x2:with-param name="pSearchReportConfigSource" select="'bcm.location.view:getReportConfig'"/>
        <x2:with-param name="pReportDataSource" select="'bcm.location.view:getReportData'"/>
      </x2:execute-->
      <x2:execute command="bcm.framework.alerts.data_validation_summary.dataValidationSummaryView:getData">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
    </xapl:variable>
    
    <!--xapl:print>
  locationForm = <xapl:value-of select="$locationForm"/>
    </xapl:print-->
    <xapl:return>
    
      <!-- Page Header-->
      <x2:execute command="bcm.framework.alerts.data_validation_summary.dataValidationSummaryView:getHeader">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
      <!-- Container-->
      
      <x2:execute command="bcm.framework.alerts.data_validation_summary.dataValidationSummaryView:getContainer">
        <x2:with-param name="this" select="{$this}"/>
        <x2:with-param name="pPage" select=" 'dataValidationSummary' "/>
      </x2:execute>
      <xapl:value-of select="$reportData"/>
      <!-- return parameters-->
      
      <xapl:value-of select="$this/*[string-length(@Value) &gt; 0]"/>
      <xapl:value-of select="$context"/>
      <xapl:value-of select="$systemProperties"/>
    </xapl:return>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    <xapl:return>
      <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <x2:param name="pPage"/>
    <xapl:return>
      <CONTAINER Scrollable="yes">
        <!--EXPRESSION_FILTER Value="no"/-->
        <!--HELP Url="../help/location_help.htm"/-->
        <STEP Name="ViewForm" DisplayText="Data Validation Error Summary" OnClick="{$pages:dataValidationSummary}" Selected="{$pPage = 'dataValidationSummary'}"/>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportConfig">
    <x2:param name="this" select="$this"/>
    <xapl:return>
      <REPORT Action="{$pages:dataValidationSummary}" Selectable="None" Scrollable="no" ScrollableContainer="yes" ShowFilter="no" Id="ERROR_RECORD.CLASSIFICATION" SelectedId="SELECTED_ID" NoTitle="yes">
        <FIELDS>
          <FIELD Name="ACTION" DisplayType="Hidden"/>
          <FIELD Name="UPDATE_ALL" DisplayType="Hidden" Value="{$this/UPDATE_ALL/@Value}"/>
          <!--xapl:print select="$this/PAGE/@Value"/-->
          <!--get form's report fields -->
          <!--x2:execute command="bcm.framework.queryform.Form:getFormReportFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute-->

	  <!--FIELD Sequence="0.1" DisplayType="Text" Hidden="no" Name="" DisplayText="" DisplayNoWrap="no" Sortable="no" />
          
	  <FIELD Sequence="0.2" DisplayType="Text" Hidden="no" Name="Severity" DisplayText="Severity" DisplayNoWrap="no" Sortable="no" /-->

	  <FIELD Property="Classification" Filter="no" Sequence="1.0" DisplayType="Text" Hidden="no" Name="ERROR_RECORD.CLASSIFICATION" DisplayText="Classification" DisplayNoWrap="no" Sortable="no" />
	  
	  <FIELD Property="S1" Filter="no" Sequence="1.1" DisplayType="Text" Hidden="no" Name="ERROR_RECORD.S1" DisplayText="S1" DisplayNoWrap="no" OnClick="getErrorsS1" Sortable="no" />
	  
	  <FIELD Property="S2" Filter="no" Sequence="1.2" DisplayType="Text" Hidden="no" Name="ERROR_RECORD.S2" DisplayText="S2" DisplayNoWrap="no" OnClick="getErrorsS2" Sortable="no" />
	  
	  <FIELD Property="S3" Filter="no" Sequence="1.3" DisplayType="Text" Hidden="no" Name="ERROR_RECORD.S3" DisplayText="S3" DisplayNoWrap="no" OnClick="getErrorsS3" Sortable="no" />
	  
	  <FIELD Property="S4" Filter="no" Sequence="1.4" DisplayType="Text" Hidden="no" Name="ERROR_RECORD.S4" DisplayText="S4" DisplayNoWrap="no" OnClick="getErrorsS4" Sortable="no" />
	  
	  <FIELD Property="Total" Filter="no" Sequence="1.5" DisplayType="Text" Hidden="no" Name="ERROR_RECORD.Total" DisplayText="Total" DisplayNoWrap="no" OnClick="getErrorsAll" Sortable="no" />
	   
          <!-- get Hidden Fields -->
          <!--x2:execute command="bcm.framework.queryform.Form:getFormReportHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute-->
        </FIELDS>
        <!--BUTTONS>
          <BUTTON Id="Export" Name="Export" DisplayText="Export to Excel" OnClick="javascript:onExportToExcel('dataValidationSummary','xls')" DisableOnClick="true" Disabled="report"/>
        </BUTTONS-->
        <PAGINATION/>
      </REPORT>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportData">
    <!--x2:param name="this"/-->
    <xapl:variable name="returnReportData">
      <xcore:execute-method name="//BCMMasterService/getDataValidationErrorSummary" entireResponse="true"/>
	  <!--RESPONSE TotalRowCount="3" Status="Success">
	    <JOIN_RESULT>
		<ERROR_RECORD.Classification Value="BOM Validation"/>
		<ERROR_RECORD.S1 Value="2"/>
		<ERROR_RECORD.S2 Value="3"/>
		<ERROR_RECORD.S3 Value="3"/>
		<ERROR_RECORD.S4 Value="3"/>
		<ERROR_RECORD.Total Value="11"/>
	    </JOIN_RESULT>
	    <JOIN_RESULT>
		<ERROR_RECORD.Classification Value="Item Validation"/>
		<ERROR_RECORD.S1 Value="2"/>
		<ERROR_RECORD.S2 Value="3"/>
		<ERROR_RECORD.S3 Value="3"/>
		<ERROR_RECORD.S4 Value="3"/>
		<ERROR_RECORD.Total Value="11"/>
	    </JOIN_RESULT>
	    <JOIN_RESULT>
		<ERROR_RECORD.Classification Value="Routing Validation"/>
		<ERROR_RECORD.S1 Value="2"/>
		<ERROR_RECORD.S2 Value="3"/>
		<ERROR_RECORD.S3 Value="3"/>
		<ERROR_RECORD.S4 Value="3"/>
		<ERROR_RECORD.Total Value="11"/>
	    </JOIN_RESULT>
	  </RESPONSE-->
    </xapl:variable>

    <xapl:print>
  	#########returnReportData= <xapl:value-of select="$returnReportData"/>
  	#########returnReportData/RESPONSES= <xapl:value-of select="$returnReportData/*"/>
    </xapl:print>

    <xapl:return>
      <xapl:value-of select="$returnReportData/*"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getData">
    <x2:param name="this"/>

    <!-- Get Report Config -->
    <xapl:variable name="reportFormat">
      <x2:execute command="bcm.framework.alerts.data_validation_summary.dataValidationSummaryView:getReportConfig">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
    </xapl:variable>

    <!-- Get Report Data -->
    <xapl:variable name="reportData">
      <x2:execute command="bcm.framework.alerts.data_validation_summary.dataValidationSummaryView:getReportData">
        <!--x2:with-param name="pReportFormat" select="$reportFormat"/>
        <x2:with-param name="pForm" select="{$filledForm}"/>
        <x2:with-param name="this" select="{$this}"/-->
      </x2:execute>
    </xapl:variable>

    <xapl:variable name="returnVar">

      <SEARCH>
      
        <!-- Return Generated Report -->
        <x2:execute command="bcm.framework.queryform.reportformfilter.controller:generate">
          <x2:with-param name="pReportFormat" select="$reportFormat"/>
          <x2:with-param name="pReportData" select="$reportData"/>
          <x2:with-param name="this" select="{$this}"/>
        </x2:execute>
        
        <xapl:value-of select="$systemProperties"/>

      </SEARCH>

    </xapl:variable>

    <xapl:print>
  	#########reportFormat = <xapl:value-of select="$reportFormat"/>
    </xapl:print>
    <xapl:print>
  	#########reportData = <xapl:value-of select="$reportData"/>
    </xapl:print>
    <xapl:print>
  	#########returnVar = <xapl:value-of select="$returnVar"/>
    </xapl:print>

    <xapl:return>
      <xapl:value-of select="$returnVar"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getErrorSearchPage">
    <x2:param name="this" select="$this"/>
    <docutil:set select="$this">
      <F_CLASSIFICATION_ERROR_MAP.SEVERITY Value="{$this/Severity/@Value}"/>
      <F_ENTITY_CLASSIFICATION.CLASSIFICATION Value="{$this/Classification/@Value}"/>
      <DO_SEARCH Value="yes"/>
      <START_COUNT Value="0"/>
    </docutil:set>
    <web:display-page>
      <web:get-page name="dataValidationErrorDetail">
        <xapl:value-of select="$this/*"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!-- **********************************************************************
     *********************************************************************** -->
</x2:commands>