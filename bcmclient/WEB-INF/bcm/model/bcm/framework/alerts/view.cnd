<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:identity="http://www.i2.com/identity" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" description="_">
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    <xapl:return>
      <x2:execute command="bcm.framework.index:getHeader">
        <x2:with-param name="pHeading" select="'Alerts'"/>
      </x2:execute>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
       *********************************************************************** -->
  <x2:command public="yes" description="_" name="redirectToObjectHome">
    <xapl:print select="{$this}"/>
    <xapl:print select="{$this/DOCUMENT_ID/@Value}"/>
    <xapl:variable name="documentID" select="concat($this/DOCUMENT_ID/@Value,'^')"/>
    <xapl:print select="{$documentID}"/>
    <xapl:variable name="documentName">
      <x2:execute command="bcm.framework.alerts.view:getValueFromDocumentId">
        <x2:with-param name="documentId" select="$documentID"/>
        <x2:with-param name="key" select="'DOC_NAME'"/>
      </x2:execute>
    </xapl:variable>
    <xapl:print select="{$documentName}"/>
    <xapl:choose>
      <!-- Location -->
      <xapl:when test=" $documentName ='Location' ">
        <xapl:variable name="locationID">
          <x2:execute command="bcm.framework.alerts.view:getValueFromDocumentId">
            <x2:with-param name="documentId" select="$documentID"/>
            <x2:with-param name="key" select="'locationID'"/>
          </x2:execute>
        </xapl:variable>
        <xapl:print select="{$locationID}"/>
      </xapl:when>
      <!-- Item -->
      <xapl:when test=" $documentName ='Item' ">
        <xapl:variable name="itemID">
          <x2:execute command="bcm.framework.alerts.view:getValueFromDocumentId">
            <x2:with-param name="documentId" select="$documentID"/>
            <x2:with-param name="key" select="'itemID'"/>
          </x2:execute>
        </xapl:variable>
        <xapl:print select="{$itemID}"/>
      </xapl:when>
      <!-- Item Location -->
      <xapl:when test=" $documentName ='ItemLocationMaster' ">
        <xapl:variable name="itemID">
          <x2:execute command="bcm.framework.alerts.view:getValueFromDocumentId">
            <x2:with-param name="documentId" select="$documentID"/>
            <x2:with-param name="key" select="'itemID'"/>
          </x2:execute>
        </xapl:variable>
        <xapl:print select="{$itemID}"/>
        <xapl:variable name="locationID">
          <x2:execute command="bcm.framework.alerts.view:getValueFromDocumentId">
            <x2:with-param name="documentId" select="$documentID"/>
            <x2:with-param name="key" select="'locationID'"/>
          </x2:execute>
        </xapl:variable>
        <xapl:print select="{$locationID}"/>
        <xapl:variable name="input">
          <root>
            <itemID Value="{$itemID}"/>
            <locationID Value="{$locationID}"/>
            <LEVEL Value="3"/>
          </root>
        </xapl:variable>
        <x2:execute command="bcm.supply_chain.controller:viewSC">
          <x2:with-param name="this" select="$input"/>
        </x2:execute>
      </xapl:when>
      <!-- BOM  -->
      <xapl:when test=" $documentName ='BOM' ">
        <xapl:variable name="bomID">
          <x2:execute command="bcm.framework.alerts.view:getValueFromDocumentId">
            <x2:with-param name="documentId" select="$documentID"/>
            <x2:with-param name="key" select="'BOMID'"/>
          </x2:execute>
        </xapl:variable>
        <xapl:print select="{$bomID}"/>
        <xapl:variable name="input">
          <root>
            <BOM.BOMID Value="{$bomID}"/>
          </root>
        </xapl:variable>
        <x2:execute command="bcm.bom.details.controller:displayOnID">
          <x2:with-param name="this" select="$input"/>
        </x2:execute>
      </xapl:when>
      <!-- Routing -->
      <xapl:when test=" $documentName ='Routing' ">
        <xapl:variable name="routID">
          <x2:execute command="bcm.framework.alerts.view:getValueFromDocumentId">
            <x2:with-param name="documentId" select="$documentID"/>
            <x2:with-param name="key" select="'routingID'"/>
          </x2:execute>
        </xapl:variable>
        <xapl:print select="{$routID}"/>
        <xapl:variable name="input">
          <root>
            <ROUTINGID Value="{$routID}"/>
            <DO_SEARCH Value="Yes"/>
          </root>
        </xapl:variable>
        <x2:execute command="bcm.routingop.operation.view:getDetails">
          <x2:with-param name="this" select="$input"/>
        </x2:execute>
      </xapl:when>
      <!-- IBR -->
      <xapl:when test=" $documentName ='ItemBOMRouting' ">
        <xapl:variable name="ibrID">
          <x2:execute command="bcm.framework.alerts.view:getValueFromDocumentId">
            <x2:with-param name="documentId" select="$documentID"/>
            <x2:with-param name="key" select="'IBRID'"/>
          </x2:execute>
        </xapl:variable>
        <xapl:print select="{$ibrID}"/>
      </xapl:when>
    </xapl:choose>
    <xapl:print select="'******** ending redirectToObjectHome()'"/>
    <xapl:print select="{$this}"/>
    <xapl:print select="'*******************'"/>
    <xcore:execute-method name="//MessagingService/delAlert">
      <ALERT_ID Value="{$this/ID[1]/@Value}"/>
    </xcore:execute-method>
  </x2:command>
  <!-- ********************************************************************** 
       *********************************************************************** -->
  <x2:command public="yes" description="_" name="getValueFromDocumentId">
    <x2:param name="documentId"/>
    <x2:param name="key"/>
    <xapl:print>
      <xapl:value-of select="$key"/>=<xapl:value-of select="$documentId"/>
    </xapl:print>
    <xapl:variable name="value" select="{substring-before( substring-after($documentId , concat($key,':') ) , '^')}"/>
    <xapl:print>
         VALUE ::::<xapl:value-of select="$value"/>
    </xapl:print>
    <xapl:return>
      <xapl:value-of select="$value"/>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
       *********************************************************************** -->
  <x2:command public="yes" description="_" name="getTabs">
    <xapl:print select="{$this}"/>
    <xapl:variable name="priority" select="0"/>
    <xapl:if test="string-length($this/PRIORITY[1]/@Value) &gt; 0">
      <xapl:set-variable name="priority" select="{$this/PRIORITY[1]/@Value}"/>
    </xapl:if>
    <xapl:return>
      <CONTAINER Scrollable="yes">
        <xapl:choose>
          <xapl:when test="$this/WHERE/@Value = 'alerts_page' ">
            <HELP Url="../../help/alerts_help.htm"/>
          </xapl:when>
          <xapl:otherwise>
            <HELP Url="../../help/alerts_help.htm"/>
          </xapl:otherwise>
        </xapl:choose>
        <xapl:variable name="singleQuote">'</xapl:variable>
       
        <STEP DisplayText="Fatal Alerts" OnClick="{concat('javascript:display(',$singleQuote,$pages:data_management_display,$singleQuote,',',$singleQuote,'0',$singleQuote,');')}" Selected="{$priority = '0'}"/>
        <STEP DisplayText="Severe Alerts" OnClick="{concat('javascript:display(',$singleQuote,$pages:data_management_display,$singleQuote,',',$singleQuote,'1',$singleQuote,');')}" Selected="{$priority = '1'}"/>
        <STEP DisplayText="Warning Alerts" OnClick="{concat('javascript:display(',$singleQuote,$pages:data_management_display,$singleQuote,',',$singleQuote,'2',$singleQuote,');')}" Selected="{$priority = '2'}"/>
        <STEP DisplayText="Information   Alerts" OnClick="{concat('javascript:display(',$singleQuote,$pages:data_management_display,$singleQuote,',',$singleQuote,'3',$singleQuote,');')}" Selected="{$priority = '3'}"/>
       </CONTAINER>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
       *********************************************************************** -->
  <x2:command public="yes" description="_" name="getMyAlertsCount">
    <xapl:variable name="bcm_alerts">
      <x2:execute command="bcm.framework.alerts.model:getBCMAlerts">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
    </xapl:variable>
    <xapl:return>
      <MY_ALERTS>
        <ID Value="342342343"/>
        <MSG_TEMPLATE_NAME Value="createCoMT"/>
        <SERVICE_NAME Value="ORDER_ADMIN"/>
        <DOCUMENT_NAME Value="CUSTOMER_ORDER"/>
        <DOCUMENT_ID Value="CO-1"/>
        <CREATION_DATE Value="11/17/20001 11:00:00"/>
        <MESSAGE Value="Item No CO-1 has been changed"/>
        <PRIORITY Value="5"/>
        <MSG_ALERT_ARGS>
          <MSG_ALERT_ARG>
            <ALERT_ID Value="342342343"/>
            <ARG_INDEX Value="0"/>
            <ARG_VALUE Value="CO-1"/>
          </MSG_ALERT_ARG>
        </MSG_ALERT_ARGS>
        <ALERT url="{$pages:data_management_display}" title="Data Management Alerts" count="{$bcm_alerts/@TotalRowCount}"/>
      </MY_ALERTS>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
    *********************************************************************** -->
  <x2:command public="yes" description="_" name="i18n">
    <i18n:text>Alerts</i18n:text>
    <i18n:text>Clear</i18n:text>
    <i18n:text>Data Management Alerts</i18n:text>
    <i18n:text>No Alerts Found.</i18n:text>
    <i18n:text>Time Issued</i18n:text>
    <i18n:text>Description</i18n:text>
    <i18n:text name="PLEASE_SELECT_ALERT">Please select an alert.</i18n:text>
  </x2:command>
  <!-- ********************************************************************** 
     *********************************************************************** -->
</x2:commands>
