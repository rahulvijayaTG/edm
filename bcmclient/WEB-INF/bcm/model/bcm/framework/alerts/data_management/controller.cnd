<?xml version="1.0" encoding="UTF-8"?>
<x2:commands 
             xmlns:x2="http://www.i2.com/x2" 
             xmlns:core="http://www.i2.com/core" 
             xmlns:xcore="http://www.i2.com/xcore" 
             xmlns:xcore-db="http://www.i2.com/xcore-db" 
             xmlns:xapl="http://www.i2.com/xapl" 
             xmlns:web="http://www.i2.com/web" 
             xmlns:docutil="http://www.i2.com/docutil" 
             xmlns:util="http://www.i2.com/util" 
             xmlns:xudl="http://www.i2.com/xudl" 
             xmlns:cfg="http://www.i2.com/configurability" 
             xmlns:perm="http://www.i2.com/permissibility" 
             xmlns:omx="http://www.i2.com/omx" 
             xmlns:identity="http://www.i2.com/identity" description="_">  
 
 
  <!-- ********************************************************************** 
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="display">
    <xapl:print select="{$this}"/>
    <web:display-page>
      <web:get-page name="data_management">
        <xapl:if test="string-length($this/PRIORITY[1]/@Value) &gt; 0">
          <PRIORITY Value="{$this/PRIORITY[1]/@Value}"/>
        </xapl:if>
        <xapl:value-of select="$this/*"/>
      </web:get-page>
    </web:display-page>

  </x2:command>
 
 
   <!-- ********************************************************************** 
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="clear">
    <xapl:print select="{$this}"/>

    <xapl:for-each varName="id" select="$this/ID/@Value">
      <xcore:execute-method name="//MessagingService/delAlert">
        <ALERT_ID Value="{$id}"/>
      </xcore:execute-method>
    </xapl:for-each>
    
    <x2:execute command="bcm.framework.alerts.data_management.controller:display">
      <x2:with-param name="this" select="$this"/>
    </x2:execute>
    
  </x2:command>
  
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="viewDocument">

        <x2:execute command="bcm.framework.alerts.data_management.controller:viewItem">
          <x2:with-param name="pId" select="$this/DOCUMENT_ID/@Value"/>
        </x2:execute>


        <!--xapl:variable name="page">
          <xapl:choose>
            <xapl:when test="$this/DOCUMENT_NAME/@Value = 'OUT_ITEM'">
              <web:get-page name="viewdbrow">
                <ID Value="{$this/DOCUMENT_ID/@Value}"/>
                
              </web:get-page>
            </xapl:when>
          </xapl:choose>
        </xapl:variable-->

        <!-- Display - Page -->
        <!--xapl:if test="string-length($page) > 0">
        <web:display-page>
          <xapl:value-of select="$page"/>
        </web:display-page>
        </xapl:if-->


  </x2:command>



  <!-- ********************************************************************** 
       *********************************************************************** -->
  <x2:command public="yes" description="_" name="viewItem">
    <x2:param name="pId"/>

    <xapl:variable name="item">
      <xcore:get-document name="//BCMMasterService/OUT_ITEM">
        <xcore:search-by property="ITEM_ID" value="{$pId}" matchby="EQUAL"/>
      </xcore:get-document>
    </xapl:variable>
    
    <xapl:print select="$item"/>
    
        <web:display-page>
              <web:get-page name="view_out_item_dbrow">
                <xapl:value-of select="$item/*"/>
                <TABLE_NAME Value="OUT_ITEM"/>
              </web:get-page>
        </web:display-page>
    

  </x2:command>

<!-- ********************************************************************** 
       *********************************************************************** -->  
</x2:commands>
