<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- ********************************************************************** 
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="getFormConfig">
    <xapl:return>
      <!-- Search Fields -->
      <!--FORM Type="Hidden" Name="search_form" Target="appFrame">
        <x2:execute command="core.search.view:getHiddenFields">
          <x2:with-param name="this" select="$this"/>
        </x2:execute>
      </FORM-->
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
    *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportConfig">
    <xapl:print>PRINTING THIS INSIDE GETREPORTCONFIG <xapl:value-of select="$this"/> </xapl:print>
    <xapl:return>
      <REPORT Selectable="All" Title="Alerts" Document="{$this/DOC_TYPE/@Value}" PagingTitle="yes">
        <FIELDS>
          <FIELD Name="ID" DisplayText="Alert ID"/>
          <FIELD Name="CREATION_DATE" DisplayText="Time Issued" DisplayType="Date" Format="DateTime" Sortable="yes"/>
          <FIELD Name="MESSAGE" Sortable="no" DisplayText="Description" />
          <!-- Hidden fields -->
          <FIELD Name="DOCUMENT_NAME" Type="Hidden" DisplayType="Hidden"/>
          <FIELD Name="DOCUMENT_ID" Type="Hidden" DisplayType="Hidden"/>
          <xapl:if test="string-length($this/WHERE[1]/@Value) &gt; 0">
            <FIELD Name="WHERE" Type="Hidden" Value="{$this/WHERE[1]/@Value}"/>
          </xapl:if>
          <FIELD Name="PRIORITY" Type="Hidden" Value="{$this/PRIORITY[1]/@Value}"/>
          <!-- Hidden Fields -->
          <x2:execute command="core.report.view:getHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
        </FIELDS>
        <PAGINATION/>
        <BUTTONS>
          <BUTTON Name="Clear" Id="clearButton" DisplayText="Clear" Disabled="report" OnClick="javascript:onClear();"/>
        </BUTTONS>
      </REPORT>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportData">
    <xapl:print select="$this"/>

    <xapl:variable name="userId">
      <identity:get-user-id/>
    </xapl:variable>
    <xapl:variable name="data">
        <!-- Get Data -->
        <xcore:execute-method name="//MessagingService/getBCMAlertsForUser" StartAtRow="{$this/START_COUNT[1]/@Value}" MaxRows="{$this/MAX_ROWS[1]/@Value}"   ReturnRowCount="{$this/RETURN_ROW_COUNT[1]/@Value}" entireResponse="true">
          <USER_ID Value="{identity-user-id()}"/>
          <PRIORITY Value="{$this/PRIORITY[1]/@Value}"/>
          <ORDER_BY>
            <docutil:element name="{$this/SORT_BY[1]/@Value}" Sort="{$this/SORT_ORDER[1]/@Value}"/>
            <docutil:element name="{$this/SORT_BY2[1]/@Value}" Sort="{$this/SORT_ORDER[1]/@Value}"/>
          </ORDER_BY>
        </xcore:execute-method>
    </xapl:variable>
    <docutil:remove select="$data/RESPONSE/_RESULT"/>
    <docutil:set select="$data/RESPONSE/MSG_ALERTS">
      <TOTAL_RECORD_COUNT Value="{$data/RESPONSE/MSG_ALERTS/@TotalRowCount}"/>
      <START_AT_ROW Value="{$this/START_COUNT[1]/@Value}"/>
    </docutil:set>
    <xapl:return> 
      <xapl:value-of select="{$data/RESPONSE/MSG_ALERTS}"/>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
     *********************************************************************** -->
     
  <x2:command public="yes" description="_" name="getSearch">
    <x2:param name="directory" select="$this/DIRECTORY/@Value"/>
    <x2:param name="file" select="$this/FILE/@Value"/>

    <x2:param name="pSearchFormConfigSource" select="concat($directory,'.', $file,':getSearchFormConfig')"/>
    <x2:param name="pSearchReportConfigSource" select="concat($directory,'.', $file,':getSearchReportConfig')"/>
    <x2:param name="pReportDataSource" select="concat($directory,'.', $file,':getReportData')"/>

    <x2:param name="pSearchParams"/>
    <x2:param name="this"/>

      <!-- Sets the given params into $this (if not already present ONLY) -->
      <x2:execute command = "bcm.framework.common:setProperties">
        <x2:with-param name="pDocument" select="$this"/>
        <x2:with-param name="pProperties" select="$pSearchParams"/>
      </x2:execute>    

    <!-- Sets the default params into $this (if not already present ONLY) -->
    <x2:execute command = "core.search.search:setDefaults">
      <x2:with-param name="this" select="$this"/>
    </x2:execute>    

    <xapl:print> core:getSearch this <xapl:value-of select="{$this}"/> </xapl:print>
    
    <!-- Get Form Config-->
    <xapl:variable name="form">
      <x2:execute command="{$pSearchFormConfigSource}">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>  
    </xapl:variable> 
    
    <!-- Get Filled Form -->
    <xapl:variable name="filledForm">
      <x2:execute command="core.form.controller:fill">
        <x2:with-param name="pForm" select="{$form}"/>
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>  
    </xapl:variable>   
    
    
    <!-- Get Report Config -->
    <xapl:variable name="reportFormat">        
      <x2:execute command="{$pSearchReportConfigSource}">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
    </xapl:variable>

    
    <!-- Get Report Data -->
    <xapl:variable name="reportData">
      <x2:execute command="{$pReportDataSource}">
        <x2:with-param name="pForm" select="{$filledForm}"/>
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
    </xapl:variable>   
    
        
    <xapl:return>
      <SEARCH>
        <!-- Return Filled Form -->
        <xapl:value-of select="$filledForm"/>
        
        <!-- Return Generated Report -->
        <x2:execute command="bcm.framework.alerts.data_management.search:generate">
          <x2:with-param name="pReportFormat" select="$reportFormat"/>
          <x2:with-param name="pReportData" select="$reportData"/>
          <x2:with-param name="this" select="{$this}"/>          
        </x2:execute>  
        
      </SEARCH>
      
    </xapl:return>
  </x2:command>
  


  <!-- ********************************************************************** 
     *********************************************************************** -->
  <x2:command public="yes" description="-" name="generate">
    <xapl:param name="pReportFormat"/>
    <xapl:param name="pReportData"/>
    <xapl:param name="this"/>
    <!-- Handle Errors - Start::-->
    <!-- Assumes that _ERROR tag indicates error -->
    <xapl:if test="count($pReportData/_ERROR) > 0">
      <xapl:return>
        <REPORT>
          <xapl:value-of select="$pReportData/_ERROR"/>
        </REPORT>
      </xapl:return>
    </xapl:if>
    <!-- Handle Errors - End.-->
    <xapl:return>
      <!-- Give default scroll -->
      <xapl:variable name="scrollable">
        <xapl:choose>
          <xapl:when test="string-length($pReportFormat/@Scrollable) > 0">
            <xapl:value-of select="$pReportFormat/@Scrollable"/>
          </xapl:when>
          <xapl:otherwise>no</xapl:otherwise>
        </xapl:choose>
      </xapl:variable>
      <!-- Give default scroll -->
      <xapl:variable name="totalRecordCount">
        <xapl:choose>
          <xapl:when test="string-length($pReportData/@TotalRowCount) > 0">
            <xapl:value-of select="$pReportData/@TotalRowCount"/>
          </xapl:when>
          <xapl:otherwise>
            <xapl:value-of select="$pReportData/TOTAL_RECORD_COUNT/@Value"/>
          </xapl:otherwise>
        </xapl:choose>
      </xapl:variable>
      <REPORT TotalRecordCount="{$totalRecordCount}" StartAtRow="{$this/START_COUNT/@Value}" MaxRows="{$this/MAX_ROWS/@Value}" NoOfRows="{count($pReportData/*)}" NoOfColumns="{count($pReportFormat/FIELDS/FIELD)}">
        <TABLE Title="{$pReportFormat/@Title}" DoSearch="{$this/DO_SEARCH/@Value}" NoRecordsTitle="{$pReportFormat/@NoRecordsTitle}" Scrollable="{$scrollable}" PagingTitle="{$pReportFormat/@PagingTitle}" NoTitle="{$pReportFormat/@NoTitle}">
          <!-- Help -->
          <xapl:if test="string-length($pReportFormat/HELP/@Url) > 0">
            <HELP Url="{$pReportFormat/HELP/@Url}"/>
          </xapl:if>
          <!-- Header Row-->
          <TR Header="yes">
            <!-- Select All -->
            <xapl:if test="$pReportFormat/@Selectable = 'All'">
              <TD Name="SELECT_ALL" Type="CheckBox"/>
            </xapl:if>
            <xapl:if test="$pReportFormat/@Selectable = 'Single'">
              <TD/>
            </xapl:if>
            <!-- Header Columns -->
            <xapl:for-each varName="col" select="$pReportFormat/FIELDS/FIELD">
              <!-- Value -->
              <xapl:variable name="value">
                <xapl:choose>
                  <xapl:when test="$col/@Type = 'Hidden'">
                    <xapl:value-of select="$col/@Value"/>
                  </xapl:when>
                  <xapl:otherwise>
                    <xapl:value-of select="$col/@DisplayText"/>
                  </xapl:otherwise>
                </xapl:choose>
              </xapl:variable>
              <TD Name="{$col/@Name}" Value="{$value}" Sortable="{$col/@Sortable}" Type="{$col/@Type}"/>
            </xapl:for-each>
          </TR>
          <!-- Result Rows -->
          <!-- Give default id - Used for check box (Value)-->
          <xapl:variable name="idName">
            <xapl:choose>
              <xapl:when test="string-length($pReportFormat/@Id) > 0">
                <xapl:value-of select="$pReportFormat/@Id"/>
              </xapl:when>
              <xapl:otherwise>ID</xapl:otherwise>
            </xapl:choose>
          </xapl:variable>
          <xapl:variable name="selectedIdName1">
            <xapl:choose>
              <xapl:when test="string-length($pReportFormat/@SelectedId) > 0">
                <xapl:value-of select="$pReportFormat/@SelectedId"/>
              </xapl:when>
              <xapl:otherwise>ID</xapl:otherwise>
            </xapl:choose>
          </xapl:variable>
          <xapl:variable name="count" select="0"/>
          <xapl:for-each varName="row" select="$pReportData/*[name() != 'TOTAL_RECORD_COUNT' and name() != 'START_AT_ROW']">
            <TR>
              <xapl:set-variable name="count" select="$count + 1"/>
              <!-- Select Box -->
              <!-- MultiSelect -->
              <xapl:variable name="rowId">
                <xapl:value-of select="get-child-by-name( $row, $idName)/@Value"/>
              </xapl:variable>
              <xapl:variable name="checked">
                <xapl:choose>
                  <xapl:when test="count($this/*[name()= $selectedIdName1 and ./@Value = $rowId] ) > 0">true</xapl:when>
                  <xapl:otherwise>false</xapl:otherwise>
                </xapl:choose>
              </xapl:variable>
              <xapl:variable name="quote">'</xapl:variable>
              <xapl:variable name="onSelectRow">
                <xapl:value-of select="concat('javascript:onSelectRow(', $quote, get-child-by-name( $row, $idName)/@Value,$quote, ');')"/>
              </xapl:variable>
              <xapl:if test="$pReportFormat/@Selectable = 'All'">
                <TD Name="{$selectedIdName1}" Type="CheckBox" Value="{get-child-by-name($row, $idName)/@Value}" Checked="{$checked}" OnClick="{$onSelectRow}"/>
              </xapl:if>
              <!-- Single Select in 1 Row - Checked-->
              <xapl:if test="$pReportFormat/@Selectable = 'Single' and $count='1'">
                <TD Name="{$selectedIdName1}" Type="Radio" Value="{get-child-by-name($row, $idName)/@Value}" Checked=" "/>
              </xapl:if>
              <!-- Single Select not in 1 Row - unChecked-->
              <xapl:if test="$pReportFormat/@Selectable = 'Single' and $count !='1'">
                <TD Name="{$selectedIdName1}" Type="Radio" Value="{get-child-by-name($row, $idName)/@Value}"/>
              </xapl:if>
              <!-- Result Columns -->
              <xapl:for-each varName="col" select="$pReportFormat/FIELDS/FIELD">
                <!-- Default - Start:: -->
                <!-- type -->
                <xapl:variable name="type">
                  <xapl:choose>
                    <xapl:when test="string-length($col/@DisplayType) > 0">
                      <xapl:value-of select="$col/@DisplayType"/>
                    </xapl:when>
                    <xapl:when test="$col/@Type = 'Hidden'">None</xapl:when>
                    <xapl:when test="string-length($col/@Type) > 0">
                      <xapl:value-of select="$col/@Type"/>
                    </xapl:when>
                    <xapl:otherwise>Text</xapl:otherwise>
                  </xapl:choose>
                </xapl:variable>
                <!-- format -->
                <xapl:variable name="format">
                  <xapl:choose>
                    <xapl:when test="string-length($col/@Format) > 0">
                      <xapl:value-of select="$col/@Format"/>
                    </xapl:when>
                    <xapl:otherwise/>
                  </xapl:choose>
                </xapl:variable>
                <!-- decimals -->
                <xapl:variable name="decimals">
                  <xapl:choose>
                    <xapl:when test="string-length($col/@Decimals) > 0">
                      <xapl:value-of select="$col/@Decimals"/>
                    </xapl:when>
                    <xapl:otherwise/>
                  </xapl:choose>
                </xapl:variable>
                <!-- Value -->
                <xapl:variable name="value">
                  <xapl:choose>
                    <!-- If Datasource Is Document Link -->
                    <xapl:when test="$col/@DataSourceType = 'Link'">
                      <xapl:value-of select="{$row/*/*[name() = $col/@DataSourceName][1]/*[name() = $col/@Name][1]/@Value}"/>
                    </xapl:when>
                    <!-- If Datasource is Self  -->
                    <xapl:when test="{string-length(get-child-by-name( $row, $col/@Name )/@Value) > 0}">
                      <xapl:value-of select="{get-child-by-name($row, $col/@Name)/@Value}"/>
                    </xapl:when>
                    <xapl:otherwise>
                      <xapl:value-of select="$col/@Value"/>
                    </xapl:otherwise>
                  </xapl:choose>
                </xapl:variable>
                <!-- Options if Select -->
                <xapl:variable name="options">
                  <xapl:choose>
                    <xapl:when test="$col/@DataSourceType = 'Command'">
                      <x2:execute command="{$col/@DataSourceName}">
                        <x2:with-param name="this" select="{$this}"/>
                      </x2:execute>
                    </xapl:when>
                    <xapl:when test="$col/@DataSourceType = 'Method'">
                      <xcore:execute-method name="{$col/@DataSourceName}"/>
                    </xapl:when>
                  </xapl:choose>
                </xapl:variable>
                <xapl:variable name="encodedParam"/>
                <xapl:variable name="onclick"/>
                <xapl:choose>
                  <xapl:when test="$col/@OnClick">
                    <xapl:value-of select="$col/@OnClick"/>
                  </xapl:when>
                  <xapl:when test="string-length($col/@Url) > 0">
                    <xapl:choose>
                      <!-- If all row data need to be passed -->
                      <xapl:when test="$col/@UrlParam = 'All'">
                        <xapl:variable name="pParam"/>
                        <xapl:set-variable name="encodedParam">
                  <xapl:if test="string-length($rowId) > 0">
                            <web:url-encode select="$rowId"/>
                  </xapl:if>
                        </xapl:set-variable>
                        <xapl:set-variable name="pParam">
                          <xapl:value-of select="concat($selectedIdName1,'=',$encodedParam , '&amp;')"/>
                        </xapl:set-variable>
                        <xapl:for-each varName="othercol" select="$pReportFormat/FIELDS/FIELD">
                          <!-- Value -->
                          <xapl:variable name="othercolvalue">
                            <xapl:choose>
                              <!-- If Datasource Is Document Link -->
                              <xapl:when test="$othercol/@DataSourceType = 'Link'">
                                <xapl:value-of select="{$row/*/*[name() = $othercol/@DataSourceName][1]/*[name() = $othercol/@Name][1]/@Value}"/>
                              </xapl:when>
                              <!-- If Datasource is Self  -->
                              <xapl:when test="{string-length(get-child-by-name($row, $othercol/@Name)/@Value) > 0}">
                                <xapl:value-of select="{get-child-by-name($row, $othercol/@Name)/@Value}"/>
                              </xapl:when>
                              <xapl:otherwise>
                                <xapl:value-of select="$othercol/@Value"/>
                              </xapl:otherwise>
                            </xapl:choose>
                          </xapl:variable>
                          <xapl:if test="$othercolvalue != 'null' and string-length($othercolvalue) > 0">
                            <xapl:set-variable name="encodedParam">
                              <web:url-encode select="$othercolvalue"/>
                            </xapl:set-variable>
                            <xapl:set-variable name="pParam">
                              <xapl:value-of select="concat($pParam,$othercol/@Name,'=',$encodedParam, '&amp;')"/>
                            </xapl:set-variable>
                          </xapl:if>
                        </xapl:for-each>
                        <xapl:set-variable name="onclick">
                          <xapl:value-of select="concat($col/@Url, '?', $pParam)"/>
                        </xapl:set-variable>
                      </xapl:when>
                      <!-- ParamName and Value-->
                      <xapl:when test="string-length($col/@UrlParamName) > 0">
                        <xapl:set-variable name="encodedParam">
                  <xapl:if test="string-length($value) > 0">
                            <web:url-encode select="$value"/>
                  </xapl:if>
                        </xapl:set-variable>
                        <xapl:set-variable name="onclick">
                          <xapl:value-of select="concat($col/@Url, '?', $col/@UrlParamName, '=' , $encodedParam)"/>
                        </xapl:set-variable>
                      </xapl:when>
                      <!-- Default - Name and Value-->
                      <xapl:otherwise>
                        <xapl:set-variable name="encodedParam">
                  <xapl:if test="string-length($value) > 0">
                            <web:url-encode select="$value"/>
                  </xapl:if>
                        </xapl:set-variable>
                        <xapl:set-variable name="onclick">
                          <xapl:value-of select="concat($col/@Url, '?', $col/@Name, '=', $encodedParam)"/>
                        </xapl:set-variable>
                      </xapl:otherwise>
                    </xapl:choose>
                  </xapl:when>
                  <xapl:otherwise/>
                </xapl:choose>
                <!-- Default - End. -->
                <!-- Put the TD -->
                <TD Url="{$onclick}" Type="{$type}" Decimals="{$decimals}" Format="{$format}" Name="{$col/@Name}" Value="{$value}" NoWrap="{$col/@DisplayNoWrap}" Editable="{$col/@Editable}" SelectAll="{$col/@SelectAll}" Target="{$col/@Target}">
                  <!-- Generate Options -->
                  <xapl:for-each varName="option" select="{$options/*}">
                    <OPTION Id="{$option/VALUE_ID/@Value}" Value="{$option/DESCRIPTION/@Value}"/>
                  </xapl:for-each>
                </TD>
              </xapl:for-each>
            </TR>
          </xapl:for-each>

          <xapl:if test="get-child-by-name( $this, $selectedIdName1)">
            <TR Type="Hidden">
            <!-- Hide Previously selected Fields -->
            <!-- For each selected id -->
            <xapl:for-each select="get-child-by-name( $this, $selectedIdName1 )/@Value" varName="id">
              <!-- Need to change this too -->              
              <xapl:if test="count($pReportData/*/*[name() = $idName and @Value = $id]) = 0">
               <TD Name="{$selectedIdName1}" Type="Hidden" Value ="{$id}" />
              </xapl:if>
            </xapl:for-each>
            </TR>
          </xapl:if>

          <xapl:value-of select="$pReportFormat/BUTTONS"/>
          <xapl:value-of select="$pReportFormat/PAGINATION"/>
        </TABLE>
      </REPORT>
    </xapl:return>
  </x2:command>
     
</x2:commands>
