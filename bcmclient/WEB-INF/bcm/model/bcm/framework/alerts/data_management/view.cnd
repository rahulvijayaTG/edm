<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" description="_">  
  

<!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
    
    <!-- Search Param Overrides - Start:-->    
    <xapl:variable name="searchParams">
      <SEARCH_PARAM>
        <SORT_BY Value="CREATION_DATE"/>
        <!-- Change this later - after the messaging service problem of queueing up requests is solved -->
        <SORT_BY2 Value="MESSAGE"/>
        <SORT_ORDER Value="Ascending"/>
      </SEARCH_PARAM>
    </xapl:variable>  
    <!-- Search Param Overrides.  End-->    
    
    <xapl:if test="string-length($this/PRIORITY[1]/@Value) = 0">
        <docutil:set select="$this">
            <PRIORITY Value="0"/>
        </docutil:set>
    </xapl:if>
    <docutil:set select="$this">
        <DO_SEARCH Value="Yes"/>
    </docutil:set>
    <docutil:remove select="$this/WHERE"/>
    
    <xapl:print>
    <xapl:value-of select="count($this/START_COUNT)"/>
    Before Changing Start_Count
    </xapl:print>
    
    <xapl:print select="$this"/>
    
    <xapl:if test="count($this/START_COUNT) > 1">
    	<xapl:variable name="stCtValue">
    		<xapl:value-of select="$this/START_COUNT[count($this/START_COUNT)]/@Value"/>
    	</xapl:variable>
    	<docutil:remove select="$this/START_COUNT"/>
    	<docutil:add select="$this">
    		<START_COUNT Value="{$stCtValue}"/>
    	</docutil:add>
		</xapl:if>
    
    <xapl:print select="$this"/>
    
    <xapl:return>

      <!-- Header -->
      <x2:execute command="bcm.framework.alerts.view:getHeader"/>
      
      <!-- Tabs -->
      <x2:execute command="bcm.framework.alerts.view:getTabs">
        <x2:with-param name="pPage" select="'data_management'"/>
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>

      <!-- Search / Form and Report -->  
      <x2:execute command="bcm.framework.alerts.data_management.search:getSearch">
        <x2:with-param name="this" select="$this"/>
        <x2:with-param name="pSearchParams" select="{$searchParams}"/>
        <x2:with-param name="pSearchFormConfigSource" select="'bcm.framework.alerts.data_management.search:getFormConfig'"/>
        <x2:with-param name="pSearchReportConfigSource" select="'bcm.framework.alerts.data_management.search:getReportConfig'"/>
        <x2:with-param name="pReportDataSource" select="'bcm.framework.alerts.data_management.search:getReportData'"/>
      </x2:execute>
      
      
      
      <!-- Links -->
      <x2:execute command="bcm.framework.alerts.data_management.view:getLinks">
        <x2:with-param name="this" select="$this"/>
        <x2:with-param name="pPage" select="'data_management'"/>
      </x2:execute>
      
    </xapl:return>
    
  </x2:command>  


  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getLinks">
    <x2:param name="this"/>

    <xapl:return>
      <LINKS>
        <x2:execute command="core.links.controller:register">
          <x2:with-param name="this" select="$this"/>
        </x2:execute>
      </LINKS>
    </xapl:return>

  </x2:command>
<!-- ********************************************************************** 
     *********************************************************************** -->
  </x2:commands>
