<?xml version="1.0" encoding="UTF-8"?>
<x2:commands description="_" xmlns:cfg="http://www.i2.com/configurability" xmlns:core="http://www.i2.com/core" xmlns:omx="http://www.i2.com/omx" xmlns:perm="http://www.i2.com/permissibility" xmlns:util="http://www.i2.com/util" xmlns:web="http://www.i2.com/web" xmlns:x2="http://www.i2.com/x2" xmlns:xapl="http://www.i2.com/xapl" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:docutil="http://www.i2.com/docutil" xmlns:oa="http://www.i2.com/oa" xmlns:xudl="http://www.i2.com/xudl" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity">

  <!--
  *******************************************************************
  *******************************************************************
  -->
  <x2:command name="init" public="yes">
    <!--
    tableContext is used for storing the flow the pages that are visited
    by the user when he is doing some operations using the Table Editors.

    Here, I have taken into account the fact that the user may be using the browser's
    Back and Forward Buttons. All the context information is stored till the user clicks
    on the Navigation bar to move to a new Table Editor page. So, in the meantime
    if the user is using the Back and Forward buttons to move across pages, his
    context is still safely stored for him.
    -->
    <xapl:variable name="tableContext" resolver="session" global="true"/>
  </x2:command>

  <!--
  *******************************************************************
  This command is called when the user moves from one TableEditor
  page to another for doing any operation(for e.g. from View Table Data to
  Add, and then to Select Foreign Key).

  @param fromPage   the page from where the user is going to another page
                                for some operation, and to where he would have to return
                                back to after doing some operations on the toPage. Typically
                                this page calls this command, passing the context information.

  @param fromTable  fromPage and fromTable uniquely identify the page on the
                                Table Editor.(for e.g. adddbrow, or editdbrow of some table)

  @param toPage      the page to which the user is going to. This page would later
                               call the getPageContext command in case the user wants
                               to return back to the page where he has come from, after
                               doing some operation.

  @param toTable     the table to which the user is going to.

  @param optionalParams   any optional XML data that you want to be stored as
                                        part of context and retrieved later.
  @return Nothing.
  *******************************************************************
  -->
  <x2:command name="setContext" public="yes">
    <x2:param name="fromPage"/>
    <x2:param name="fromTable"/>
    <x2:param name="toPage"/>
    <x2:param name="toTable"/>
    <x2:param name="optionalParams"/>

    <!--
    Initialize the tableContext the first time the user visits any page on TableEditors.
    A root tag PAGES is created,  since the data for visits multiple pages would be
    stored in this session variable.

    TODO Move it to the initSession
    -->
    <xapl:if test="not($tableContext)">
      <xapl:set-variable name="tableContext">
        <PAGES/>
      </xapl:set-variable>
    </xapl:if>

    <xapl:print>BEFORE SETTING
      <xapl:value-of select="$tableContext"/>
    </xapl:print>
    <!--
    Extract the parameters and store in in the appropriate elements
    of the PAGE element.
    -->
    <xapl:choose>
      <xapl:when test="$tableContext/PAGE_CONTEXT[(FROM_PAGE/@Value = $fromPage)
      and (FROM_TABLE/@Value = $fromTable)]">
        <docutil:set select="$tableContext/PAGE_CONTEXT[(FROM_PAGE/@Value = $fromPage)
      and (FROM_TABLE/@Value = $fromTable)]">
          <TO_PAGE Value="{$toPage}"/>
          <TO_TABLE Value="{$toTable}"/>
          <xapl:value-of select="$optionalParams/*"/>
        </docutil:set>
      </xapl:when>
      <xapl:when test="$tableContext/PAGE_CONTEXT[(TO_PAGE/@Value = $toPage)
      and (TO_TABLE/@Value = $toTable)]">
        <docutil:set select="$tableContext/PAGE_CONTEXT[(TO_PAGE/@Value = $toPage)
      and (TO_TABLE/@Value = $toTable)]">
          <FROM_PAGE Value="{$fromPage}"/>
          <FROM_TABLE Value="{$fromTable}"/>
          <xapl:value-of select="$optionalParams/*"/>
        </docutil:set>
      </xapl:when>
      <xapl:otherwise>
        <docutil:add select="$tableContext">
          <PAGE_CONTEXT>
            <FROM_PAGE Value="{$fromPage}"/>
            <FROM_TABLE Value="{$fromTable}"/>
            <TO_PAGE Value="{$toPage}"/>
            <TO_TABLE Value="{$toTable}"/>
            <xapl:value-of select="$optionalParams/*"/>
          </PAGE_CONTEXT>
        </docutil:add>
      </xapl:otherwise>
    </xapl:choose>
    <xapl:print>AFTER SETTING
      <xapl:value-of select="$tableContext"/>
    </xapl:print>
  </x2:command>

  <!--
  *******************************************************************
  This command is called from the page where the user has come to for some
  doing some operation(for e.g. the user has come to Item Table for selecting
  the foreign key for a ItemLocationMaster row).

  @currentPage  current Page the user is on.

  @currentTable current Table the user is working on.

  @return   Returns the pageContext that contains the information about which
                page the user has come from. The XML looks like this...
                <PAGE_CONTEXT>
                  <FROM_PAGE Value="" />
                  <FROM_TABLE Value="" />
                  <TO_PAGE Value="" />
                  <TO_TABLE Value="" />
                </PAGE_CONTEXT>
  *******************************************************************
  -->
  <x2:command name="getPageContext" public="yes">
    <x2:param name="currentPage"/>
    <x2:param name="currentTable"/>

    <!--
    Return the page context whose TO_PAGE and TO_TABLE match
    the given currentPage and currenTable
    -->
    <xapl:print select="$currentPage"/>
    <xapl:print select="$currentTable"/>

    <xapl:print>
      RETURNING THIS PAGECONTEXT
      <xapl:value-of select="$tableContext/PAGE_CONTEXT[
      (TO_PAGE/@Value = $currentPage) and (TO_TABLE/@Value = $currentTable)]"/>
    </xapl:print>
    <xapl:return>
      <xapl:value-of select="$tableContext/PAGE_CONTEXT[
      (TO_PAGE/@Value = $currentPage) and (TO_TABLE/@Value = $currentTable)]"/>
    </xapl:return>
  </x2:command>

  <!--
  *******************************************************************
  This command is called to clean the context whenever the user is clicking on
  Navigation bar to go to a new Table Editor page.
  *******************************************************************
  -->
  <x2:command name="cleanContext" public="yes">
    <!--
    Erase all the contents of the tableContext.
    -->
    <xapl:set-variable name="tableContext">
      <PAGES/>
    </xapl:set-variable>
    <!-- clean the workflow context --><!-- init the breadcrumbs-->
    <x2:execute command="bcm.context.controller:cleanContext"/>
   <!--
    Initialize the sessionData the first time the user goes for selecting
    the foreign key in any table or EDIT/UPDATE/MASS UPDATE of selected records. A root tag TABLES is created, since the data for
    multiple tables may be stored in this session variable.

    TODO Move it to the initSession
    -->
     <xapl:set-variable name="sessionData">
      <TABLES/>
    </xapl:set-variable>

  </x2:command>

  <!--
  *******************************************************************
  This command is called when the user clicks on a column link to reach another
  Table Editor page. If the user has gone to target table editor page from some
  other page, that context information would be erased.
  *******************************************************************
  -->
  <x2:command name="removeOldContextForColumnLink" public="yes">
    <x2:param name="toPage"/>
    <x2:param name="toTable"/>

    <xapl:print select="$toPage"/>
    <xapl:print select="$toTable"/>
    <xapl:print select="$tableContext"/>

    <xapl:print select="$tableContext/PAGE_CONTEXT[(TO_PAGE/@Value =
    $toPage) and (TO_TABLE/@Value = $toTable)]"/>
    <docutil:remove select="$tableContext/PAGE_CONTEXT[(TO_PAGE/@Value =
    $toPage) and (TO_TABLE/@Value = $toTable)]"/>

    <xapl:print select="$tableContext"/>
  </x2:command>

  <!--
  *******************************************************************
  This command is called to check whether the user has come to this page from
  another page. If yes, this command returns yes.
  *******************************************************************
  -->
  <x2:command name="doesFromPageExist" public="yes">
    <x2:param name="currentPage"/>
    <x2:param name="currentTable"/>

    <xapl:print select="$currentPage"/>
    <xapl:print select="$currentTable"/>
    <xapl:print select="$tableContext"/>

    <xapl:if test="$tableContext/PAGE_CONTEXT[(TO_PAGE/@Value = $currentPage)
    and (TO_TABLE/@Value = $currentTable)]">
      <xapl:return>true</xapl:return>
    </xapl:if>

    <xapl:return>false</xapl:return>
  </x2:command>
</x2:commands>