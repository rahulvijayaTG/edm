<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
    <xapl:variable name="searchParams">
      <SEARCH_PARAM/>
    </xapl:variable>
    <xapl:choose>
      <xapl:when test="{count($this/SORT_BY) = 0}">
        <docutil:add select="{$this}">
          <SORT_BY Value="DOC_NAME"/>
        </docutil:add>
      </xapl:when>
      <xapl:when test="{string-length($this/SORT_BY/@Value) = 0}">
        <docutil:set select="{$this/SORT_BY/@Value}">DOC_NAME</docutil:set>
      </xapl:when>
    </xapl:choose>
    <xapl:return>
      <!-- Page Header-->
      <x2:execute command="bcm.framework.validation.view:getHeader">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
      <!-- Container-->
      <x2:execute command="bcm.framework.validation.view:getContainer">
        <x2:with-param name="this" select="{$this}"/>
        <x2:with-param name="pPage" select="'all_documents'"/>
      </x2:execute>
      <!-- Search / Form and Report -->
      <x2:execute command="core.search.search:getSearch">
        <x2:with-param name="this" select="$this"/>
        <x2:with-param name="pSearchParam" select="{$searchParam}"/>
        <x2:with-param name="pSearchFormConfigSource" select="'bcm.framework.validation.view:getFormConfig'"/>
        <x2:with-param name="pSearchReportConfigSource" select="'bcm.framework.validation.view:getReportConfig'"/>
        <x2:with-param name="pReportDataSource" select="'bcm.framework.validation.view:getReportData'"/>
      </x2:execute>
      <!-- Links -->
      <x2:execute command="bcm.framework.validation.view:getLinks">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
      <xapl:value-of select="$this/*"/>
    </xapl:return>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    <xapl:print select="$this"/>
    <!-- change the header home -->
    <xapl:return>
      <HEADER>
        <APP_NAME Value="MDM"/>
        <TOGGLE_NAV Value="../"/>
        <HEADING Value="Data Errors"/>
        <HOME Value="bcm/framework/home.jsp"/>
      </HEADER>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <xapl:return>
      <CONTAINER>
        <HELP Url="../../help/errorDocs_help.htm"/>
        <STEP Name="ErrorDocuments" DisplayText="Documents" OnClick="{$pages:all_documents}" Selected="true"/>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getFormConfig">
    <xapl:return>
      <FORM MethodName="//BCMMasterService/getActiveDocuments" Name="search_form" Action="documents.jsp" Method="GET" Target="appFrame">
        <FIELD Type="Text" DisplayText="Entity Name" Name="DOCUMENT_NAME" Value="*" Visibility="Simple"/>
<!--
        <FIELD Type="DateRange" DisplayText="Date Loaded" Name="DATE_LOADED" Value="" Visibility="Simple"/>
-->
        <x2:execute command="omx.search.search:getHiddenFields">
          <x2:with-param name="this" select="$this"/>
        </x2:execute>
        <BUTTONS>
          <BUTTON Name="search" DisplayText="Search" OnClick="javascript:onSearch()" Emphasized="no"/>
        </BUTTONS>
      </FORM>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportConfig">
    <xapl:return>
<!--
      <REPORT Title="Date Loaded: " Selectable="None" Scrollable="yes" SelectedId="SELECTED_ID" PagingTitle="yes">
-->
      <REPORT Selectable="None" SelectedId="SELECTED_ID" PagingTitle="yes">
        <FIELDS>
          <FIELD Name="DOC_NAME" DisplayText="Name" Url="{$pages:document_error_log}" UrlParam="All" Sortable="yes"/>
          <FIELD Name="DATE_LOADED" DisplayText="Date Loaded" Sortable="yes"/>
          <FIELD Name="ERROR_COUNT" DisplayText="No. of records in error" Sortable="no"/>
          <!-- Hidden Fields -->
          <FIELD Type="Hidden" Name="SERVICE_NAME" Sortable="yes"/>
          <x2:execute command="omx.report.report:getHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
        </FIELDS>
        <PAGINATION/>
      </REPORT>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportData">
    <x2:param name="pForm"/>
    <xapl:print>PRINTING THIS INSIDE VIEW_GETREPORTDATEA <xapl:value-of select="$this"/></xapl:print>
    <xapl:variable name="data">
      <xcore:execute-method name="//BCMMasterService/getActiveDocuments" StartAtRow="{$this/START_COUNT[1]/@Value}" MaxRows="{$this/MAX_ROWS[1]/@Value}" ReturnRowCount="{$this/RETURN_ROW_COUNT[1]/@Value}" entireResponse="true">
        <DOCUMENT_NAME Value="{$this/DOCUMENT_NAME/@Value}"/>
        <DATE_LOADED Value="{$this/DATE_LOADED_FIRST/@Value}"/>
      </xcore:execute-method>
    </xapl:variable>

    <xapl:variable name="dateLoaded" select="$data/RESPONSE/REPORT/START_TIME/@Value"/>
    <docutil:remove select="$data/RESPONSE/REPORT"/>

    <xapl:for-each varName="activeDoc" select="$data/RESPONSE/ACTIVE_DOCUMENTS/ACTIVE_DOCUMENT">
      <xapl:if test="(count($activeDoc/ERROR_COUNT) = 0) or ($activeDoc/ERROR_COUNT/@Value = 0)">
        <docutil:remove select="$activeDoc"/>
      </xapl:if>
    </xapl:for-each>
    <!-- Note: 
                For pagination to work, the response that this method sends back should have TOTAL_RECORD_COUNT at the header level itself. So putting all children of <ACTIVE_DOCUMENTS/> at the $data/RESPONSE level and removing <ACTIVE_DOCUMENTS/> -->
    <xapl:for-each varName="activeDoc" select="$data/RESPONSE/ACTIVE_DOCUMENTS/ACTIVE_DOCUMENT">
      <docutil:set select="$activeDoc">
        <DATE_LOADED Value="{$dateLoaded}"/>
      </docutil:set>
      <docutil:add select="$data/RESPONSE">
        <xapl:value-of select="$activeDoc"/>
      </docutil:add>
    </xapl:for-each>
    <docutil:remove select="$data/RESPONSE/ACTIVE_DOCUMENTS"/>
    
    <!-- Add the total record count  -->
    <docutil:set select="$data/RESPONSE">
      <TOTAL_RECORD_COUNT Value="{(count($data/RESPONSE/ACTIVE_DOCUMENT))}"/>
      <START_AT_ROW Value="{$this/START_COUNT[1]/@Value}"/>
    </docutil:set>
    <xapl:print>PRINTING DATA INSIDE GETREPORTDATA </xapl:print>
    <xapl:print select="$data"/>
    <xapl:return>
      <xapl:value-of select="{$data/RESPONSE}"/>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getLinks">
    <xapl:return>
      <LINKS>
        <x2:execute command="bcm.framework.common:getLinks">
          <x2:with-param name="pPage" select="'all_documents'"/>
          <x2:with-param name="this" select="$this"/>
          <x2:with-param name="pReturnLink" select="$this/RET_PAGE/@Value"/>
        </x2:execute>
      </LINKS>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
</x2:commands>
