<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- **********************************************************************
  *********************************************************************** -->
 <x2:command name="init" public="yes" description="_">
 </x2:command>

  <x2:command public="yes" description="_" name="load">

    <xapl:if test="$this/MODE/@Value = 'START'">
      <docutil:remove select="$this/MODE"/>
      <x2:execute command="bcm.context.controller:cleanContext"/>
    </xapl:if>
     <xapl:choose>
      <xapl:when test="{count($this/SORT_BY[1]) = 0}">
        <docutil:remove select="$this/SORT_ORDER"/>
        <docutil:add select="{$this}">
          <SORT_BY Value="WORKFLOW_STATUS.WORKFLOW_START_TIME"/>
          <SORT_ORDER Value="Descending"/>
        </docutil:add>
      </xapl:when>
      <xapl:when test="{string-length($this/SORT_BY/@Value) = 0}">
        <docutil:set select="{$this/SORT_BY/@Value}">WORKFLOW_STATUS.WORKFLOW_START_TIME</docutil:set>
        <docutil:remove select="$this/SORT_ORDER"/>
        <docutil:add select="{$this}">
          <SORT_ORDER Value="Descending"/>
        </docutil:add>
      </xapl:when>
    </xapl:choose>

    <!-- BREADCRUMBS AT TOP OR AFTER CLEAN-CONTEXT-->
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
      <x2:with-param name="display" select="'Error Summary'"/>
      <x2:with-param name="page" select="'errorSummary'"/>
      <x2:with-param name="this" select="{$this}"/>
    </x2:execute>

    <xapl:variable name="form">
      <x2:execute command="bcm.framework.queryform.Form:getFormContainer">
        <x2:with-param name="this" select="$this"/>
        <x2:with-param name="pSearchParam" select="$searchParam"/>
        <x2:with-param name="pFormName" select="'ERROR_SUMMARY_FORM'"/>
        <x2:with-param name="pServiceName" select="'E2EService'"/>
        <x2:with-param name="pSearchFormConfigSource" select="'bcm.framework.e2e.errorSummary.view:getFormConfig'"/>
        <x2:with-param name="pSearchReportConfigSource" select="'bcm.framework.e2e.errorSummary.view:getReportConfig'"/>
        <x2:with-param name="pReportDataSource" select="'bcm.framework.e2e.errorSummary.view:getReportData'"/>
      </x2:execute>
    </xapl:variable>

  <xapl:variable name="wfStartTime">
    <xapl:value-of select="$currentFormsData/RESPONSE/JOIN_RESULT[1]/WORKFLOW_STATUS.WORKFLOW_START_TIME/@Value"/>
  </xapl:variable>
    <xapl:variable name="wfEndTime">
      <xapl:value-of select="$currentFormsData/RESPONSE/JOIN_RESULT[1]/WORKFLOW_STATUS.WORKFLOW_END_TIME/@Value"/>
    </xapl:variable>

  <xapl:print>
    errorgentime!! <xapl:value-of select="$wfStartTime"/>
  </xapl:print>
  <xapl:return>
      <!-- Page Header-->
      <x2:execute command="bcm.framework.e2e.errorSummary.view:getHeader">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>

      <!-- Container-->
      <x2:execute command="bcm.framework.e2e.errorSummary.view:getContainer">
        <x2:with-param name="this" select="{$this}"/>
        <x2:with-param name="pPage" select="'errorSummary'"/>
      </x2:execute>

      <!-- Search / Form and Report -->
      <xapl:value-of select="$form"/>

      <!-- return filter parameters-->
      <xapl:value-of select="$this/*[string-length(@Value) > 0 ]"/>

      <!-- return context-->
      <xapl:value-of select="$context"/>

      <!-- return error gen time-->
      <WF_START_TIME Value="{$wfStartTime}"/>
      <WF_END_TIME Value="{$wfEndTime}"/>

    </xapl:return>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    <xapl:return>
      <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <x2:param name="pPage"/>
    <xapl:return>
      <CONTAINER Scrollable="no">
        <EXPRESSION_FILTER Value="yes"/>
        <STEP DisplayText="Error Summary" OnClick="{$pages:errorSummary}" Selected="{$pPage = 'errorSummary'}"/>

      </CONTAINER>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportConfig">
    <xapl:return>
      <REPORT Title="Error Summary" Selectable="Single" Action="errorSummary.jsp" Method="POST" Scrollable="yes" ScrollableContainer="no" Id="WORKFLOW_STATUS.LOAD_ID|WORKFLOW_STATUS.DATA_CONTEXT_WF_ID|ERROR_SUMMARY.WF_ID|ERROR_SUMMARY.ERROR_DOCUMENT_NAME|ERROR_SUMMARY.DOCUMENT_NAME|ERROR_SUMMARY.ERROR_SEVERITY" ShowFilter="no" SelectedId="SELECTED_ID" PagingTitle="yes" NoRecordsTitle="No Records found">
        <FIELDS>
          <!--get form's report fields -->
          <FIELD Name="CURRENT_ID" DisplayType="Hidden" Value=""/>
          <FIELD Name="MODE" DisplayType="Hidden" Value=""/>
          <x2:execute command="bcm.framework.queryform.Form:getFormReportFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
          <!-- get Hidden Fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
         </FIELDS>
        <BUTTONS>
               <!--BUTTON Id="exportToExcel" Name="exportToExcel" DisplayText="Export to Excel" OnClick="javascript:onExportToExcelGlobal('error_summary','xls')" DisableOnClick="true" Disabled="report"/-->
               <BUTTON Id="reloadAll" Name="reloadAll" DisplayText="Reload All" OnClick="javascript:startErrorCorrection()" DisableOnClick="true" Emphasized="false"/>
               <BUTTON Id="reload" Name="reload" DisplayText="Reload" OnClick="javascript:reloadErrorDataToMaster()" DisableOnClick="true" Emphasized="false"/>
               <!--BUTTON Id="search" Name="Search" DisplayText="Search" OnClick="javascript:dispatchSearch()" DisableOnClick="true" Emphasized="true"/-->
        </BUTTONS>
         <PAGINATION/>
        </REPORT>
    </xapl:return>
  </x2:command>
<!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getFormConfig">
    <x2:param name="this" select="$this"/>
    <xapl:print>
      Value of this in getFormConfig
      <xapl:value-of select="$this"/>
    </xapl:print>
    <xapl:variable name="request"/>
    <xapl:set-variable name="request" select="{concat('//' , $this/SERVICE/@Value, '/getFormData')}"/>
    <xapl:return>
      <FORM Name="search_form" Action="errorSummary.jsp" NoOfCols="2" method="POST" Target="appFrame">
        <!--get all search form fields -->
        <x2:execute command="bcm.framework.queryform.Form:getFormSearchFields">
          <x2:with-param name="this" select="$this"/>
        </x2:execute>
        <FIELD Name="search_param" Type="Hidden" Value="yes"/>

        <x2:execute command="bcm.framework.queryform.Form:getFormSearchHiddenFields">
          <x2:with-param name="this" select="$this"/>
        </x2:execute>
        <BUTTONS>
             <BUTTON Name="search" DisplayText="Search" OnClick="javascript:onSearch()" Emphasized="yes"/>
        </BUTTONS>
      </FORM>
    </xapl:return>
  </x2:command>


    <x2:command public="yes" description="_" name="getReportData">
      <x2:param name="this"/>
      <xapl:return>
        <x2:execute command="bcm.framework.queryform.Form:getFormReportData">
          <x2:with-param name="this" select="$this"/>
          <x2:with-param name="fromProperty" select="'SEARCH_PROPERTY'"/>
          <x2:with-param name="delimeter" select="'_' "/>
        </x2:execute>
        </xapl:return>
    </x2:command>

    <x2:command public="yes" description="_" name="startErrorCorrection">
      <x2:param name="this"/>
        <xapl:print>starting error correction workflow</xapl:print>
        <xapl:print>selected ID::: <xapl:value-of select="$this/SELECTED_ID[1]/@Value"/></xapl:print>
        <xapl:variable name="loadId">
          <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
            <x2:with-param name="selectedId" select="$this/SELECTED_ID[1]/@Value"/>
            <x2:with-param name="key" select="'WORKFLOW_STATUS.LOAD_ID'"/>
          </x2:execute>
        </xapl:variable>
        <xapl:variable name="workflowId">
	  <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
	    <x2:with-param name="selectedId" select="$this/SELECTED_ID[1]/@Value"/>
	    <x2:with-param name="key" select="'ERROR_SUMMARY.WF_ID'"/>
	  </x2:execute>
        </xapl:variable>
        <xapl:print>load id ID::: <xapl:value-of select="$loadId"/></xapl:print>
        <xcore:execute-method name="//E2EService/startErrorCorrectionWorkflowAsynch"  synchronous="no" entireResponse="true" >
        	<LOAD_ID Value="{$loadId}"/>
        	<LOAD_WF_ID Value="{$workflowId}"/>
        </xcore:execute-method>
        <web:display-page>
            <web:get-page name="errorSummary">
                <!--<xapl:value-of select="$this/*"/>
                Trimming request to send only required parameters-->
                <FORM_NAME Value="{$this/FORM_NAME/@Value}" />
		<PAGE Value="{$this/PAGE/@Value}" />
		<SERVICE Value="{$this/SERVICE/@Value}" />
		<MODE Value="{$this/MODE/@Value}" />
		<SELECTED_ID Value="{$this/SELECTED_ID/@Value}" />
		<DO_SEARCH Value="{$this/DO_SEARCH/@Value}"/>
		<DIRECTORY Value="{$this/DIRECTORY/@Value}"/>
		<FILE Value="{$this/FILE/@Value}"/>
		<xapl:choose>
			<xapl:when test="string-length($this/START_COUNT/@Value) > 0 ">
			  <START_COUNT Value="{$this/START_COUNT/@Value}" />
			</xapl:when>
			<xapl:otherwise>
			 <START_COUNT Value="0" />
			</xapl:otherwise>
		</xapl:choose>
		<MAX_ROWS Value="15" />
		<xapl:if test="string-length($this/DISPLAY_COUNT/@Value) > 0 ">
		    <DISPLAY_COUNT Value="{$this/DISPLAY_COUNT/@Value}" />
		</xapl:if>
		<xapl:choose>
				<xapl:when test="string-length($this/SORT_BY/@Value) > 0 ">
				       <SORT_BY Value="{$this/SORT_BY/@Value}" />
				</xapl:when>
				<xapl:otherwise>
					<xapl:print>chandy!! coming here</xapl:print>
				 	<SORT_BY Value="WORKFLOW_STATUS.WORKFLOW_START_TIME" />
				        <SORT_ORDER Value="Descending" />
				</xapl:otherwise>
		</xapl:choose>
		<xapl:if test="string-length($this/SORT_ORDER/@Value) > 0 ">
		    <SORT_ORDER Value="{$this/SORT_ORDER/@Value}" />
		</xapl:if>
		<USE_OLD_FILTER Value="{$this/USE_OLD_FILTER/@Value}" />
		<xapl:choose>
		  <xapl:when test="string-length($this/pagenum/@Value) > 0 ">
		   <pagenum Value="{$this/pagenum/@Value}" />
		  </xapl:when>
		  <xapl:otherwise>
		   <pagenum Value="0" />
		  </xapl:otherwise>
		</xapl:choose>
		<xapl:value-of select="$this/*[substring-before(name() ,  '_'  )  = 'F' and string-length(./@Value) > 0 ]"/>
                <SUCCESS_MESSAGE Value="Error Correction Workflow has been started"/>
             </web:get-page>
        </web:display-page>

    </x2:command>

    <x2:command public="yes" description="_" name="reloadDataByEntity">
      <x2:param name="this"/>
        <xapl:print>starting error correction workflow by entity</xapl:print>

        <xapl:variable name="documentName">
          <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
            <x2:with-param name="selectedId" select="$this/SELECTED_ID[1]/@Value"/>
            <x2:with-param name="key" select="'ERROR_SUMMARY.DOCUMENT_NAME'"/>
          </x2:execute>
        </xapl:variable>
        <xapl:variable name="workflowId">
	  <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
	    <x2:with-param name="selectedId" select="$this/SELECTED_ID[1]/@Value"/>
	    <x2:with-param name="key" select="'ERROR_SUMMARY.WF_ID'"/>
	  </x2:execute>
        </xapl:variable>
        <xcore:execute-method name="//E2EService/startErrorCorrectionForEntity"  synchronous="no" entireResponse="true" >
                   <LOGICAL_NAME Value ="{$documentName}"/>
                   <LOAD_WF_ID Value="{$workflowId}"/>
        </xcore:execute-method>

        <web:display-page>
            <web:get-page name="errorSummary">
                <!--<xapl:value-of select="$this/*"/>
                Trimming request to send only required parameters-->
                <FORM_NAME Value="{$this/FORM_NAME/@Value}" />
                <PAGE Value="{$this/PAGE/@Value}" />
                <SERVICE Value="{$this/SERVICE/@Value}" />
                <MODE Value="{$this/MODE/@Value}" />
                <SELECTED_ID Value="{$this/SELECTED_ID/@Value}" />
                <DO_SEARCH Value="{$this/DO_SEARCH/@Value}"/>
         	<DIRECTORY Value="{$this/DIRECTORY/@Value}"/>
         	<FILE Value="{$this/FILE/@Value}"/>
		<xapl:choose>
			<xapl:when test="string-length($this/START_COUNT/@Value) > 0 ">
			  <START_COUNT Value="{$this/START_COUNT/@Value}" />
			</xapl:when>
			<xapl:otherwise>
			 <START_COUNT Value="0" />
			</xapl:otherwise>
         	</xapl:choose>
         	<MAX_ROWS Value="15" />
         	<xapl:if test="string-length($this/DISPLAY_COUNT/@Value) > 0 ">
		    <DISPLAY_COUNT Value="{$this/DISPLAY_COUNT/@Value}" />
		</xapl:if>
		<xapl:choose>
		<xapl:when test="string-length($this/SORT_BY/@Value) > 0 ">
		       <SORT_BY Value="{$this/SORT_BY/@Value}" />
		</xapl:when>
		<xapl:otherwise>
			<xapl:print>chandy!! coming here</xapl:print>
		 	<SORT_BY Value="WORKFLOW_STATUS.WORKFLOW_START_TIME" />
		        <SORT_ORDER Value="Descending" />
		</xapl:otherwise>
		</xapl:choose>
		<xapl:if test="string-length($this/SORT_ORDER/@Value) > 0 ">
		    <SORT_ORDER Value="{$this/SORT_ORDER/@Value}" />
                </xapl:if>
		<USE_OLD_FILTER Value="{$this/USE_OLD_FILTER/@Value}" />
		<xapl:choose>
		  <xapl:when test="string-length($this/pagenum/@Value) > 0 ">
		   <pagenum Value="{$this/pagenum/@Value}" />
		  </xapl:when>
		  <xapl:otherwise>
		   <pagenum Value="0" />
		  </xapl:otherwise>
		</xapl:choose>
		<xapl:value-of select="$this/*[substring-before(name() ,  '_'  )  = 'F' and string-length(./@Value) > 0 ]"/>
                <SUCCESS_MESSAGE Value="Error Correction Workflow has been started"/>
             </web:get-page>
        </web:display-page>
    </x2:command>


  <x2:command public="yes" description="_" name="loadErrorTableEditor">
        <xapl:variable name="documentName">
          <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
            <x2:with-param name="selectedId" select="$this/CURRENT_ID[1]/@Value"/>
            <x2:with-param name="key" select="'ERROR_SUMMARY.ERROR_DOCUMENT_NAME'"/>
          </x2:execute>
        </xapl:variable>
        <xapl:variable name="severity">
          <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
            <x2:with-param name="selectedId" select="$this/CURRENT_ID[1]/@Value"/>
            <x2:with-param name="key" select="'ERROR_SUMMARY.ERROR_SEVERITY'"/>
          </x2:execute>
        </xapl:variable>
        <xapl:variable name="workflowId">
          <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
            <x2:with-param name="selectedId" select="$this/CURRENT_ID[1]/@Value"/>
            <x2:with-param name="key" select="'ERROR_SUMMARY.WF_ID'"/>
          </x2:execute>
        </xapl:variable>
        <xapl:variable name="dataContextWfId">
          <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
            <x2:with-param name="selectedId" select="$this/CURRENT_ID[1]/@Value"/>
            <x2:with-param name="key" select="'WORKFLOW_STATUS.DATA_CONTEXT_WF_ID'"/>
          </x2:execute>
        </xapl:variable>
        
         <xapl:variable name="thisParamErrTable">
         <ROOT>
                   <DO_SEARCH Value="Yes"/>
	           <TABLE_NAME Value="{$documentName}"/>
	           <SERVICE Value="BCMINService"/>
	           <DIRECTORY Value="bcm.framework.tableeditor"/>
	           <FILE Value="TableEditorView"/>
	           <F_SYS_ERR_SEVERITY Value="{$severity}"/>
	           <MODE Value="{$this/MODE/@Value}"/>
	           <xapl:choose>
	           	<xapl:when test="string-length($dataContextWfId)>0">
	           		<F_WORKFLOW_ID Value="{$dataContextWfId}"/>
	           	</xapl:when>
	           	<xapl:otherwise>
	           		<F_WORKFLOW_ID Value="{$workflowId}"/>
	           	</xapl:otherwise>
	           </xapl:choose>
	   </ROOT>        
        </xapl:variable>
         
        <x2:execute command="bcm.framework.user_preferences.controller:updateAndApplyUserPreferencesForTableEditor">
	              <x2:with-param name="this" select="{$thisParamErrTable}"/>
        </x2:execute>
      <web:display-page>
        <web:get-page name="tableeditor">
        	<xapl:value-of select="{$thisParamErrTable/*}"/>
        </web:get-page>
      </web:display-page>
  </x2:command>


</x2:commands>
