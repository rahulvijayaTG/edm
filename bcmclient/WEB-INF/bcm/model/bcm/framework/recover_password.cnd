<?xml version="1.0" encoding="utf-8"?>
<x2:commands description="_" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:cfg="http://www.i2.com/configurability" xmlns:core="http://www.i2.com/core" xmlns:omx="http://www.i2.com/omx" xmlns:perm="http://www.i2.com/permissibility" xmlns:util="http://www.i2.com/util" xmlns:web="http://www.i2.com/web" xmlns:x2="http://www.i2.com/x2" xmlns:xapl="http://www.i2.com/xapl" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:docutil="http://www.i2.com/docutil" xmlns:xudl="http://www.i2.com/xudl">
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="recoverPassword">
    <xapl:print select="{$this}"/>
    <!--
<REQUESTS ServiceName="EM">
	<REQUEST Name="recoverPassword">
	  <USER_ID Value="user3"/>
	  <PWD_QUESTION Value="LAST_4_DIGITS_OF_SSN"/>
	  <PWD_ANSWER Value="my_pwd_answer"/>
	</REQUEST>
</REQUESTS>

-->
    <xapl:variable name="isSuccess">
      <xcore:execute-method name="//UserSecurity/recoverPassword" entireResponse="true">
        <USER_ID Value="{$this/USER_ID/@Value}"/>
        <PWD_QUESTION Value="{$this/PASSWORD_QUESTION/@Value}"/>
        <PWD_ANSWER Value="{$this/PASSWORD_ANSWER/@Value}"/>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:print select="{$isSuccess}"/>
    <xapl:choose>
      <xapl:when test="{$isSuccess/RESPONSE/@Status = 'Error'}">
        <web:display-page>
          <web:get-page name="forgotPasswd">
            <ERROR Value="true"/>
            <ERR_DESCRIPTION Value="{$isSuccess/RESPONSE/_RESULT/_ERROR/@Value}"/>
            <USER_NAME Value="{$this/USER_ID/@Value}"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:otherwise>
        <web:display-page>
          <web:get-page name="forgotPasswd">
            <ERROR Value="false"/>
            <ERR_DESCRIPTION Value="Your password has been sent to your email address."/>
          </web:get-page>
        </web:display-page>
      </xapl:otherwise>
    </xapl:choose>
  </x2:command>
  <!--************************************************************************-->
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="checkLoginName">
    <xapl:variable name="loginExists">
      <xcore:execute-method name="//UserSecurity/checkLoginName" entireResponse="true">
        <LOGIN_NAME Value="{$this/USER_NAME/@Value}"/>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:print select="{$loginExists}"/>
    <xapl:choose>
      <xapl:when test="{$loginExists/RESPONSE/USER_EXISTS/@Value = 'false'}">
        <web:display-page>
          <web:get-page name="login">
            <ERROR Value="true"/>
            <DESCRIPTION Value="User ID does not exist."/>
            <USER_NAME Value="{$this/USER_NAME/@Value}"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:when test="{$loginExists/RESPONSE/SECRET_QN_SET/@Value = 'false'}">
        <web:display-page>
          <web:get-page name="login">
            <ERROR Value="true"/>
            <DESCRIPTION Value="You have not set a password recovery question. Please login with the User ID and Password that was sent to you by e-mail."/>
            <USER_NAME Value="{$this/USER_NAME/@Value}"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:when test="{$loginExists/RESPONSE/USER_EXISTS/@Value = 'true'}">
        <web:display-page>
          <web:get-page name="forgotPasswd">
            <xapl:value-of select="$this/*"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
    </xapl:choose>
  </x2:command>
  <!--************************************************************************-->
</x2:commands>
