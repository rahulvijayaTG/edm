<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:scenario="http://www.i2.com/scenario" xmlns:x2="http://www.i2.com/x2" xmlns:identity="http://www.i2.com/identity" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" description="_">
  <x2:command public="yes" description="_" name="init">
    <xapl:variable name="firstTimeLoad" resolver="session" global="true"/>
    <xapl:variable name="fromLogin" resolver="session" global="true"/>
    <xapl:variable name="chooseAuthID" resolver="session" global="true"/>
    <xapl:variable name="loginUserId" resolver="session" global="true"/>
    <xapl:variable name="securityCheck" resolver="session" global="true"/>
    <xapl:variable name="sessionInstanceVar" resolver="session" global="true"/>
    <xapl:variable name="userFavorites" resolver="session" global="true"/>
  </x2:command>


  <x2:command public="yes" description="_" name="login">
    <!-- Invalidating session provided user has NOT come from My Profile page -->
<!--
    <xapl:if test="$this/MY_PROFILE/@Value != 'yes' ">
      <web:invalidate-session/>
    </xapl:if>
-->
  <xapl:variable name="sIdAtStart">
      <scenario:get-scenario-id/>
    </xapl:variable>
    
    <web:invalidate-session/>
    <xapl:variable name="isValid">
      <xcore:execute-method name="//UserSecurity/validateLogin" entireResponse="true">
        <LOGIN_NAME Value="{$this/USER_NAME/@Value}"/>
        <PASSWORD Value="{$this/PASSWORD/@Value}"/>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:choose>
        <xapl:when test="$loadTablesOnLogin='yes'">
            <xapl:set-variable name="firstTimeLoad" select="'no'"/>
        </xapl:when>
        <xapl:otherwise>
            <xapl:set-variable name="firstTimeLoad" select="'yes'"/>
        </xapl:otherwise>
    </xapl:choose>
    <xapl:choose>
      <xapl:when test="string-length($isValid/RESPONSE/_RESULT/_ERROR/@Value) = 0">
        <identity:create-identity userId="{$this/USER_NAME/@Value}"/>
         <!-- TODO  Need To Move this to  BcmIdentity.java-->
			<xapl:variable name="userId">
			 <identity:get-user-id/>
			</xapl:variable>
			<xapl:variable name="response1">
			<xcore:execute-method name="//UserSecurity/getRolesForUser" entireResponse="true">
				<USER_ID Value="{$userId}"/>
			</xcore:execute-method>
			</xapl:variable>
			<xapl:variable name="userRole">
			  <xapl:value-of select="$response1/RESPONSE/USER_ROLES/USER_ROLE[1]/ROLE_ID/@Value"/>
			</xapl:variable>
			<identity:set-property name="SINGLE_USER_ROLE" value="{$userRole}"/>
	
	<!-- TODO  End.  Need To Move this to  BcmIdentity.java-->

        <xapl:variable name="sIdAtEnd">
          <scenario:get-scenario-id/>
        </xapl:variable>
        
        <!-- load the document access control list for user -->
        <!--x2:execute command="bcm.framework.authorization.auth_controller:loadUserDocAccessControlList"/-->
      </xapl:when>
      <xapl:otherwise>
        <!-- if passwd is expired then go to change password page -->
        <xapl:if test="{$isValid/RESPONSE/_RESULT/_ERROR/@Value='PASSWORD_EXPIRED'}">
          <identity:create-identity userId="{$this/USER_NAME/@Value}"/>
          <!-- load the document access control list for user -->
          <!--x2:execute command="bcm.framework.authorization.auth_controller:loadUserDocAccessControlList"/-->
          <xapl:print>PASSWORD EXPIRED - REDIRECTING TO CHANGE PWD PAGE </xapl:print>
          <web:display-page>
            <web:get-page name="change_passwd">
              <CHANGE_PASSWORD Value="yes"/>
              <USER_NAME Value="{$this/USER_NAME/@Value}"/>
            </web:get-page>
          </web:display-page>
        </xapl:if>
        <xapl:otherwise>
          <web:display-page>
            <web:get-page name="login">
              <ERROR Value="true"/>
              <USER_NAME Value="{$this/USER_NAME}"/>
              <DESCRIPTION Value="{$isValid/RESPONSE/_RESULT/_ERROR/@Value}"/>
            </web:get-page>
          </web:display-page>
        </xapl:otherwise>
      </xapl:otherwise>
    </xapl:choose>
    <xapl:if test="{$this/CHANGE_PASSWD/@Value='yes'}">
      <xapl:print>CHANGE PASSWORD IS YES - REDIRECTING TO CHANGE PWD PAGE </xapl:print>
      <web:display-page>
        <web:get-page name="change_passwd">
          <CHANGE_PASSWORD Value="yes"/>
          <USER_NAME Value="{$this/USER_NAME/@Value}"/>
        </web:get-page>
      </web:display-page>
    </xapl:if>

    <x2:execute command="bcm.framework.login:setSecurityVars">
	<x2:with-param name="this" select="$this"/>
    </x2:execute>    
    
    
    <xapl:set-variable name="sessionInstanceVar" select="$appInstanceEnabled"/>

    <xapl:variable name="userFavoritesRes">
        <xcore:execute-method name="//UserSecurity/getFavoriteHierarchy" UserId="{$loginUserId}" entireResponse="true">
        </xcore:execute-method>
    </xapl:variable>
    <xapl:set-variable name="userFavorites">
        <xapl:value-of select="$userFavoritesRes/RESPONSE/*" />
    </xapl:set-variable>
    <xapl:print select="{$userFavorites}"/>

    <web:display-page>
      <web:get-page name="loginSuccess"/>
    </web:display-page>
  </x2:command>

  
  <!-- Return scenarioID of current scenario and username to display in top frame -->
    <xapl:variable name="currentScenario">
      <scenario:get-scenario-id/>
    </xapl:variable>
    <xapl:variable name="userName">
      <identity:get-user-name/>
    </xapl:variable>
    <xapl:variable name="currentScenarioDetails">
      <xcore:execute-method name="//BCMMasterService/getScenarioDetailsFromID" entireResponse="true">
        <scenarioID Value="{$currentScenario}"/>
      </xcore:execute-method>
    </xapl:variable>
    
  <x2:command public="yes" description="_" name="bypassLogin">
    <!-- Invalidating session provided user has NOT come from My Profile page -->
<!--
    <xapl:if test="$this/MY_PROFILE/@Value != 'yes' ">
      <web:invalidate-session/>
    </xapl:if>
-->

    <x2:execute command="core.login.controller:validateSession"/>

    <web:display-page>
      <web:get-page name="loginSuccess">
      <scenarioID Value="{$currentScenario}"/>
      <scenarioName Value="{$currentScenarioDetails/RESPONSE/ScenarioMaster/name/@Value}"/>
      <userName Value="{$userName}"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  
  <!-- setting security variables -->
  <x2:command public="yes" description="_" name="setSecurityVars">
  	<x2:param name="this"/>
    <xapl:set-variable name="fromLogin" select="'yes'"/>
    
    <xapl:variable name="isSecActExists" select="'no'"/>
    <xapl:set-variable name="chooseAuthID" select="'no'"/>
    <xapl:set-variable name="securityCheck" select="'no'"/>
    <xapl:variable name="NonAuthSecurityAct"  select="'no'"/>
  	<xapl:set-variable name="loginUserId">
  		<identity:get-user-id/>
  	</xapl:set-variable>
  	<xapl:print>Through session </xapl:print>
  	<xapl:print select="{$loginUserId}"/>

	<xapl:variable name="AuthDocDetails"/>
	<xapl:set-variable name="AuthDocDetails">
		<xcore:execute-method name="//BCMMasterService/getAuthorizingDocumets" UserId="{$loginUserId}" entireResponse="true">
		</xcore:execute-method>
	</xapl:set-variable>

	
	<perm:is-allowed document="TASKS" action="bcmManageAuthSecurity">
   	<xapl:set-variable name="isSecActExists">
   		<xapl:value-of select="'yes'"/>
        </xapl:set-variable>
        </perm:is-allowed>
            
        <perm:is-allowed document="TASKS" action="bcmManageNonAuthMasterSecurity">
	<xapl:set-variable name="NonAuthSecurityAct">
		<xapl:value-of select="'yes'"/>
	</xapl:set-variable>
        </perm:is-allowed>
            
	<xapl:print select="{$AuthDocDetails}"/>
	<xapl:print select="{$isSecActExists}"/>
	<xapl:print select="{$NonAuthSecurityAct}"/>
	
	<xapl:if test="$NonAuthSecurityAct = 'no'">
	<web:display-page>
	      <web:get-page name="solutionIndex">
	        <ACTIVITY Value="bcmReferenceStaging"/>
	      </web:get-page>
       </web:display-page>
	</xapl:if>
	
	
	
	<xapl:variable name="authDocCount" select="0"/>
	<xapl:variable name="isOnlyOneAuthDoc" select="'no'"/>	

	<xapl:for-each select= "$AuthDocDetails/RESPONSE/AUTH_DOC" varName="authDoc">
  	  <xapl:choose>
		<xapl:when test="count($authDoc/AUTH_ID) > 1 ">
			<xapl:set-variable name="authDocCount" select="$authDocCount + 1"/>
		</xapl:when>
		<xapl:otherwise>
			<xapl:if test="count($authDoc/AUTH_ID) = 1 ">
				<xapl:set-variable name="isOnlyOneAuthDoc">
			    		<xapl:value-of select="'yes'"/>
				</xapl:set-variable>
			</xapl:if>
		</xapl:otherwise>
	  </xapl:choose>
	</xapl:for-each>
	
	<xapl:if test="$isOnlyOneAuthDoc = 'yes'">
		<x2:execute command="bcm.framework.security.controller:setInputAuthDetails">
			<x2:with-param name="this" select="$this"/>
		</x2:execute>
		<x2:execute command="bcm.framework.security.controller:initializeSelectedAuthDetails">
			<x2:with-param name="this" select="$this"/>
		</x2:execute>
		<x2:execute command="bcm.framework.security.controller:setAuthContextForOneAuthEntitiy">
			<x2:with-param name="this" select="$this"/>
		</x2:execute>
		<xapl:set-variable name="isOnlyOneAuthDoc">
			<xapl:value-of select="'no'"/>
		</xapl:set-variable>		
	</xapl:if>
	
	<xapl:print select="{$authDocCount}"/>

  	<xapl:choose>
		<xapl:when test="$authDocCount > 0 and $isSecActExists = 'yes'">
			<xapl:set-variable name="securityCheck">
				<xapl:value-of select="'yes'"/>
			</xapl:set-variable>		
		</xapl:when>
		<xapl:otherwise>
			<xapl:set-variable name="securityCheck">
				<xapl:value-of select="'no'"/>
			</xapl:set-variable>		
		</xapl:otherwise>
	</xapl:choose>

	<xapl:print select="{$securityCheck}"/>

	<xapl:for-each select= "$AuthDocDetails/RESPONSE/AUTH_DOC" varName="authDoc">
		<xapl:if test="count($authDoc/AUTH_ID) > 1">
			<xapl:set-variable name="chooseAuthID">
				<xapl:value-of select="'yes'"/>
			</xapl:set-variable>
		</xapl:if>
	</xapl:for-each>
	<xapl:print select="{$chooseAuthID}"/>
  </x2:command>
  
</x2:commands>
