<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2"
xmlns:xcore="http://www.i2.com/xcore"
xmlns:xcore-db="http://www.i2.com/xcore-db"
xmlns:xapl="http://www.i2.com/xapl"
xmlns:web="http://www.i2.com/web"
xmlns:util="http://www.i2.com/util"
xmlns:i18n="http://www.i2.com/i18n" description="_">
<!-- *******************************************
***********************************************-->
<x2:command name="init" public="yes" description="load x2 config">
  <!-- x2 default configurations for table editor and query forms-->
  <xapl:variable name="x2config" resolver="application" global="true"/>
    <!--set global x2 config-->
    <xapl:set-variable name="x2config">
      <x2_config>
     <!-- TABLE EDITORS CONFIG-->
       <table_editor_config>
           <all_tables>
             <parameters>
               <!-- first time default search paramaeter [Yes, No] -->
               <param name="DO_SEARCH" service="*" value="No"/>
               <!-- total no of rows displayed in table editor-->
               <param name="MAX_ROWS" service="*" value="15"/>
             </parameters>
            </all_tables>
            <!-- override global settings-->
            <override_tables>
                <table name="PlanMaster" service="BcmMasterService">
                    <param name="ShowAllPropsInAdvancedFilter"  value="Yes"/>
                </table>
            </override_tables>
       </table_editor_config>

     <!-- QUERY FORMS CONFIG-->
      <query_form_config>
        <all_forms>
          <parameters>
            <!-- first time default search paramaeter  [Yes, No] -->
            <param name="DO_SEARCH" service="*" value="Yes"/>
            <!-- total no of rows displayed in query form-->
            <param name="MAX_ROWS" service="*" value="15"/>
          </parameters>
        </all_forms>
        <!-- override global settings-->
        <override_forms>
           <form name="MST_BUFFER_SRCH_FORM" service="BcmMasterService">
                <param name="ShowAllPropsInAdvancedFilter"  value="Yes"/>
           </form>
        </override_forms>
      </query_form_config>

      </x2_config>
    </xapl:set-variable>

<!-- COLUMN FREEZE N ONLINE HELP -->
<x2:execute command="bcm.framework.x2-config:initColHeadConfig"/>
<x2:execute command="bcm.framework.x2-config:customizeOnlineHelp"/>

</x2:command>
<!-- *******************************************
***********************************************-->

<!-- COLUMN FREEZE -->

<x2:command public="yes" description="_" name="initColHeadConfig">
        <xapl:variable name="colHeadConfig" resolver="application" global="true"/>
        <!--set global column header config-->
        <xapl:set-variable name="colHeadConfig">
            <COL_HEAD_CONFIG>
                <DEFAULT_COL_HEAD_CONFIG freezeCol="-999"/>
                <TABLE_COL_HEAD_CONFIG>
                    <TE Name="Dimension" freezeCol="1"/>
                    <TE Name="Hierarchy" freezeCol="2"/>
                    <TE Name="Level" freezeCol="4"/>
                    <TE Name="LevelHierarchy" freezeCol="1"/>
                    <TE Name="Member" freezeCol="1"/>
                    <TE Name="GSSCDataException" freezeCol="1"/>
                    <TE Name="ProductMaster" freezeCol="2"/>
                    <TE Name="PlanningParameters" freezeCol="1"/>
                    <TE Name="ConsumptionMaster" freezeCol="1"/>
                    <TE Name="LocationMaster" freezeCol="2"/>
                </TABLE_COL_HEAD_CONFIG>

                    <FORM_COL_HEAD_CONFIG freezeCol="-999">
                        <QF Name="MST_SAFETYSTOCK_VALIDATION_FORM" freezeCol="0"/>
                        <QF Name="MST_SAFETYSTOCK_ADV_FORM" freezeCol="0"/>
                        <QF Name="MST_ROOT_CAUSE_ANAL_FORM" freezeCol="0"/>
                        <QF Name="MST_DATA_CLEANSING_ADV_FORM" freezeCol="0"/>
                        <QF Name="MST_STD_INPUT_FORM" freezeCol="0"/>
                        <QF Name="MST_ADV_INPUT_FORM" freezeCol="0"/>

                        <QF Name="CALENDAR_SRCH_FORM" freezeCol="2"/>
                    </FORM_COL_HEAD_CONFIG>

            </COL_HEAD_CONFIG>
        </xapl:set-variable>
        <xapl:print>INSIDE x2-config::<xapl:value-of select="{$colHeadConfig}"/></xapl:print>
        <xapl:return>
            <xapl:value-of select="$colHeadConfig"/>
        </xapl:return>
    </x2:command>

<!-- *******************************************
***********************************************-->
<!-- ONLINE HELP -->

<x2:command public="yes" description="_" name="customizeOnlineHelp">
    <xapl:print>Begining of customize Online Help </xapl:print>

    <xapl:variable name="helpFileDirectory" resolver="application" global="true"/>

    <xapl:set-variable name="helpFileDirectory">
            <xapl:value-of select="'../../help'"/>
    </xapl:set-variable>


    <xapl:variable name="helpFileName" resolver="application" global="true"/>

    <xapl:set-variable name="helpFileName">
    <HELPFILE_CONFIG>
        <DEFAULT_HELP_FILENAME searchHelpFile="dbtable_help.htm" editHelpFile="table_editor_edit_help.htm" createHelpFile="table_editor_add_help.htm" copyHelpFile="copy_record.html" massUpdateHelpFile="mass_update.html"/>
        <TABLE_HELPFILE_MAP>
            <TABLE Name="Dimension" searchHelpFile="dimension_search_help.htm" editHelpFile="edit_dimension_help.htm" createHelpFile="create_dimension_help.htm" copyHelpFile="copy_dimension_help.htm"/>
            <TABLE Name="Hierarchy" searchHelpFile="hierarchy_search_help.htm" editHelpFile="edit_hierarchy_help.htm" createHelpFile="create_hierarchy_help.htm" copyHelpFile="copy_hierarchy_help.htm"/>
            <TABLE Name="Level" searchHelpFile="level_search_help.htm" editHelpFile="edit_level_help.htm" createHelpFile="create_level_help.htm" copyHelpFile="copy_level_help.htm"/>
            <TABLE Name="LevelHierarchy" searchHelpFile="levelhierarchy_search_help.htm" editHelpFile="edit_levelhierarchy_help.htm" createHelpFile="create_levelhierarchy_help.htm" copyHelpFile="copy_levelhierarchy_help.htm"/>
            <TABLE Name="Member" searchHelpFile="member_search_help.htm" editHelpFile="edit_member_help.htm" createHelpFile="create_member_help.htm" copyHelpFile="copy_member_help.htm"/>
            <TABLE Name="Location" searchHelpFile="location_help.htm" editHelpFile="location_edit_help.htm" copyHelpFile="copy_record.html"/>
            <TABLE Name="BOM" searchHelpFile="bom_help.htm" editHelpFile="bom_edit_help.htm" copyHelpFile="copy_record.html" massUpdateHelpFile="bom_mass_update_help.htm"/>
            <TABLE Name="HorizonReferenceMaster" searchHelpFile="Manage_TimeHierarchy_help.htm" editHelpFile="Manage_TimeHierarchy_help.htm" createHelpFile="Manage_TimeHierarchy_help.htm" copyHelpFile="Manage_TimeHierarchy_help.htm" />
        </TABLE_HELPFILE_MAP>
    </HELPFILE_CONFIG>
    </xapl:set-variable>

    <xapl:print>In customize Online Help
    <xapl:value-of select="$helpFileName"/>
    </xapl:print>

</x2:command>

<!-- *******************************************
***********************************************-->

</x2:commands>


