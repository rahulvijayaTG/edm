<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:ui="http://www.i2.com/ui" xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:report="http://www.i2.com/report" xmlns:i18n="http://www.i2.com/i18n" description="_">
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">

    <xapl:variable name="reportData">
      <xcore:execute-method name="//DataProfiling/getDataProfile" StartAtRow="0" MaxRows="1" ReturnRowCount="yes">
        <ID Value="{$this/ID/@Value}"/>
      </xcore:execute-method>
    </xapl:variable>
                                          
    <xapl:variable name="reportFormat">
      <!-- What columns to show and the column names -->
      <table id="bottomTable" displayText="Data Profile" select="DATA_PROFILE" rowSrc="COLUMN">
        <field-group id="tableColumns">
            <display-field name="FIELD" displayText="Field" value="{./@Name}"/>
            <display-field displayText="Type" name="DATA_TYPE" value="{DATA_TYPE/@Value}"/>
            <display-field displayText="Primary Key" name="PRIMARY_KEY"/>
            <display-field displayText="Unique Count" name="NUM_DISTINCT"/>
            <display-field displayText="Non-null Count" name="COUNT"/>
            <display-field displayText="Data Availability %" name="DATA_AVAILABILITY"/>
            <display-field displayText="Min" name="MIN"/>
            <display-field displayText="Max" name="MAX"/>
            <display-field displayText="Average" name="AVG"/>
            <display-field displayText="Min Length" name="MIN_LENGTH"/>
            <display-field displayText="Max Length" name="MAX_LENGTH"/>
            <display-field displayText="Average Length" name="AVG_LENGTH"/>
            <display-field displayText="Most Common Value" name="MOST_COMMON"/>
        </field-group>
      </table>
    </xapl:variable>

    <!-- get Actual Report-->
    <xapl:variable name="report">
      <x2:execute command="bcm.dataprofiling.common:generate_xlt">
        <x2:with-param name="pReportData" select="$reportData"/>
        <x2:with-param name="pReportFormat" select="$reportFormat"/>
      </x2:execute>
    </xapl:variable>
  
    <!-- downloadFile-->
    <x2:execute command="core.common:downloadFile">
      <x2:with-param name="pFileContents" select="$report"/>
      <x2:with-param name="pFileName" select="'profile.xlt'"/>
      <x2:with-param name="pFileType" select="'text'"/>
    </x2:execute>
    
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
</x2:commands>
