<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
    <!-- BREADCRUMBS AT TOP OR AFTER CLEAN-CONTEXT-->
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
      <x2:with-param name="display" select="'Update Outbound Staging'"/>
      <x2:with-param name="page" select="'outboundStagingRefreshPage'"/>
      <x2:with-param name="this" select="{$this}"/>
    </x2:execute>
    <xapl:variable name="returnDoc">
      <!-- Page Header-->
      <x2:execute command="bcm.outboundStaging.view:getHeader">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
      <!-- Container-->
      <x2:execute command="bcm.outboundStaging.view:getContainer">
        <x2:with-param name="this" select="{$this}"/>
        <x2:with-param name="pPage" select="'outboundStagingRefreshPage'"/>
      </x2:execute>
      <!-- Execute workflow if requested -->
      <xapl:choose>
        <xapl:when test="$this/REFRESH/@Value = 'yes' ">
          <x2:execute command="bcm.outboundStaging.view:refreshOutboundStaging">
            <x2:with-param name="this" select="{$this}"/>
          </x2:execute>
        </xapl:when>
        <xapl:otherwise>
          <MESSAGE Value="Click on 'Refresh' to refresh Outbound staging."/>
        </xapl:otherwise>
      </xapl:choose>
    </xapl:variable>
    <xapl:return>
      <xapl:value-of select="$returnDoc"/>
    </xapl:return>
  </x2:command>
  <!--  **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    <!-- change the header home -->
    <xapl:return>
     <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <xapl:variable name="startRefresh">
      <xapl:choose>
        <xapl:when test="$this/REFRESH/@Value = 'yes' ">yes</xapl:when>
        <xapl:otherwise>no</xapl:otherwise>
      </xapl:choose>
    </xapl:variable>
    <xapl:print select="$startRefresh"/>
    <xapl:return>
      <CONTAINER>
        <HELP Url="../help/outboundstaging_help.htm"/>
        <STEP Name="RefreshOutboundStaging" DisplayText="Refresh Outbound Staging" OnClick="{$pages:outboundStagingRefreshPage}" Selected="true"/>
        <BUTTONS>
          <BUTTON Id="Cancel" Name="Cancel" DisplayText="Cancel" OnClick="javascript:onCancel()" Disabled="no"/>
          <BUTTON Id="StartRefresh" Name="StartRefresh" DisplayText="Start Refresh" OnClick="javascript:onStartRefresh()" Disabled="{$startRefresh}" DisableOnClick="true"/>
        </BUTTONS>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="refreshOutboundStaging">
    <xapl:variable name="refreshResponse">
      <xcore:execute-method name="//BCMOutboundService/refeshOutBoundTablesWrapper" entireResponse="true"/>
    </xapl:variable>
    <xapl:print>PRINTING refreshResponse<xapl:value-of select="$refreshResponse"/>
    </xapl:print>
    <xapl:return>
      <xapl:value-of select="$refreshResponse"/>
      <xapl:choose>
        <xapl:when test="$refreshResponse/RESPONSE/@Value = 'Success' ">
          <MESSAGE Value="OUTBOUND_STAGING_REFRESH_INITIATED"/>
        </xapl:when>
        <xapl:when test="$refreshResponse/RESPONSE/@Value = 'Error' ">
          <MESSAGE Value="OUTBOUND_STAGING_REFRESH_FAILED"/>
        </xapl:when>
      </xapl:choose>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  
  <i18n:text>Synchronization to Outbound Staging Started</i18n:text>
  <i18n:text>Synchronization to Outbound Staging Completed</i18n:text>
  
</x2:commands>
