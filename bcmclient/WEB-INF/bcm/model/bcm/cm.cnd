            <TYPE_ID Value="DIST_UOM"/>
            <ORDER_BY>
              <VALUE_ID Sort="Ascending"/>
            </ORDER_BY>
          </xcore:get-document>
        </DISTANCE_CODES>
      </xapl:set-variable>
    </xapl:if>
    <xapl:print select="{concat('NUMBER OF DIST_UOMS = ', count($appDistUoms/*))}"/>
    <xapl:return>
      <xapl:value-of select="$appDistUoms"/>
    </xapl:return>
  </x2:command>
