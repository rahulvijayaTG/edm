  ********************************************************************************* -->
  <x2:command public="yes" description="_" name="getCalBasedAttributesForCalTypes">
    <xapl:if test="count($appCalendarDetailColumns/*) = 0">
      <xapl:set-variable name="appCalendarDetailColumns">
        <Root>
          <xcore:execute-method name="//BCMMasterService/getCalBasedAttributesForCalTypes" entireResponse="false"/>
        </Root>
      </xapl:set-variable>
    </xapl:if>
  </x2:command>
  
    <!-- **************************************************************************
    ********************************************************************************* -->
    <x2:command public="yes" description="_" name="getWeeklyHorizonData">
      <xapl:if test="count($appWeeklyHorizonData/*) = 0">
        <xapl:set-variable name="appWeeklyHorizonData">
          <Root>
            <xcore:execute-method name="//BCMMasterService/getHorizonData" entireResponse="true">
