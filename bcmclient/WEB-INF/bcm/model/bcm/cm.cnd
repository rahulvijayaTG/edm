  <x2:command public="yes" description="_" name="getBodSourcingPolicyValidValues">
    <xapl:if test="count($appBodSourcingPolicyValidValues/*) = 0">
      <xapl:variable name="validValues">
        <ValidValues>
          <xcore:get-document name="//UserSecurity/CODE_MASTER_VALUE">
            <STATUS Value="ACTIVE"/>
            <TYPE_ID Value="BOD_SOURCING_POLICIES"/>
            <ORDER_BY>
              <ID Sort="Ascending"/>
            </ORDER_BY>
          </xcore:get-document>
        </ValidValues>
      </xapl:variable>
      <xapl:set-variable name="appBodSourcingPolicyValidValues">
        <PROPERTY Name="sourcingPolicy" Document="BillofDistribution"/>
      </xapl:set-variable>
      <xapl:for-each varName="child" select="$validValues/CODE_MASTER_VALUE">
        <docutil:add select="$appBodSourcingPolicyValidValues">
          <VALID_VALUE Value="{$child/VALUE_ID/@Value}"/>
        </docutil:add>
      </xapl:for-each>
    </xapl:if>
    <xapl:print select="{concat('NUMBER OF TIME_CODES = ', count($appBodSourcingPolicyValidValues/*))}"/>
    <xapl:return>
      <xapl:value-of select="$appBodSourcingPolicyValidValues"/>
    </xapl:return>
  </x2:command>
