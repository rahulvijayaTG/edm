      <xapl:if test="count($appShipUOM/*) = 0">
        <xapl:set-variable name="appShipUOM">
          <SHIP_UOMS>
             <xcore:get-document name="//UserSecurity/CODE_MASTER_VALUE">
                <STATUS Value="ACTIVE"/>
          <TYPE_ID Value="SHIP_UOMS"/>
          <ORDER_BY>
            <ID Sort="Ascending"/>
                </ORDER_BY>
             </xcore:get-document>
          </SHIP_UOMS>
        </xapl:set-variable>  
      </xapl:if>
      <xapl:print select="{concat('NUMBER OF TIME_CODES = ', count($appShipUOM/*))}"/>
      <xapl:return>
        <xapl:value-of select="$appShipUOM"/>
      </xapl:return>
  </x2:command>
  <!-- **************************************************************************
  ********************************************************************************* -->
  <x2:command public="yes" description="_" name="getCalendarTypesValidValues">
    <xapl:if test="count($appCalendarTypesValidValues/*) = 0">
      <xapl:variable name="validValues">
        <ValidValues>
          <xcore:execute-method name="//BCMMasterService/getCalendarTypes" entireResponse="false"/>
        </ValidValues>
      </xapl:variable>
      <xapl:set-variable name="appCalendarTypesValidValues">
        <PROPERTY Name="calendarTypeID" Document="CalendarMaster"/>
      </xapl:set-variable>
      <xapl:for-each varName="child" select="$validValues/CalendarTypeMaster">
        <docutil:add select="$appCalendarTypesValidValues">
          <VALID_VALUE Description="{$child/name/@Value}" Value="{$child/calendarTypeID/@Value}"/>
        </docutil:add>
      </xapl:for-each>
    </xapl:if>
    <xapl:return>
      <OPTIONS>
        <xapl:value-of select="$appCalendarTypesValidValues"/>
      </OPTIONS>
    </xapl:return>
  </x2:command>
  <!-- **************************************************************************
  ********************************************************************************* -->
  <x2:command public="yes" description="_" name="getCalendarClassesValidValues">
    <xapl:if test="count($appCalendarClassesValidValues/*) = 0">
      <xapl:variable name="validValues">
        <ValidValues>
          <xcore:execute-method name="//BCMMasterService/getCalendarClasses" entireResponse="false"/>
        </ValidValues>
      </xapl:variable>
      <xapl:set-variable name="appCalendarClassesValidValues">
        <PROPERTY Name="class" Document="CalendarMaster"/>
      </xapl:set-variable>
      <xapl:for-each varName="child" select="$validValues/*">
        <docutil:add select="$appCalendarClassesValidValues">
          <VALID_VALUE Description="{$child/@Value}" Value="{$child/@Value}"/>
        </docutil:add>
      </xapl:for-each>
    </xapl:if>
    <xapl:return>
      <OPTIONS>
        <xapl:value-of select="$appCalendarClassesValidValues"/>
      </OPTIONS>
    </xapl:return>
  </x2:command>
