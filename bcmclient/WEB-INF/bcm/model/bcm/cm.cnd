<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:tree="http://www.i2.com/tree" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- ******************************************* -->
  <!-- This file contains Code Master get commands -->
  <!-- ******************************************* -->
  <!-- Static variables -->
  <x2:command public="yes" description="_" name="init">
    <x2:execute command="bcm.cm:defineCodeMasterValues"/>
  </x2:command>
  <!-- **************************************************************************
  ********************************************************************************* -->
  <x2:command public="yes" description="_" name="defineCodeMasterValues">
    <!-- UOM -->
    <xapl:variable name="appCMVUoms" resolver="session" global="true"/>
    <xapl:variable name="appDistUoms" resolver="session" global="true"/>
    <xapl:variable name="appDLTimeUoms" resolver="session" global="true"/>
    <xapl:variable name="appTransportModeServiceNames" resolver="session" global="true"/>
    <xapl:variable name="appTransportModeTransportTypes" resolver="session" global="true"/>
    <!-- EQ::557107 -->
    <xapl:variable name="appTimeUoms" resolver="session" global="true"/>
    <xapl:variable name="appBodSourcingPolicies" resolver="session" global="true"/>
    <xapl:variable name="appShipUOM" resolver="session" global="true"/>
    <xapl:variable name="appBodSourcingPolicyValidValues" resolver="session" global="true"/>
    <xapl:variable name="appResourceClass" resolver="session" global="true"/>
    <xapl:variable name="appResourceRFUOM" resolver="session" global="true"/>
    <xapl:variable name="appResourceNUOM" resolver="session" global="true"/>
    <xapl:variable name="appResourceLPolicy" resolver="session" global="true"/>
    <xapl:variable name="appResourceInitLUOM" resolver="session" global="true"/>
    <xapl:variable name="appHandlingCostUOM" resolver="session" global="true"/>
    <xapl:variable name="appHandlingCapacityUOM" resolver="session" global="true"/> 
    <xapl:variable name="appCalendarTypesValidValues" resolver="session" global="true"/>
    <xapl:variable name="appCalendarClassesValidValues" resolver="session" global="true"/>
    <xapl:variable name="appCalendarDetailColumns" resolver="session" global="true"/>
    <xapl:variable name="appCalEntriesEffStartDate" resolver="session" global="true"/>
    <xapl:variable name="appResourceType" resolver="session" global="true"/>
    <xapl:variable name="appResourceStatus" resolver="session" global="true"/>
    <xapl:variable name="appHandlingType" resolver="session" global="true"/>
    <xapl:variable name="appCapacityUOM" resolver="session" global="true"/>
    <xapl:variable name="appCostUOM" resolver="session" global="true"/>    
    <xapl:variable name="appStorageType" resolver="session" global="true"/>
    <xapl:variable name="appStorageClass" resolver="session" global="true"/>
    <xapl:variable name="appStorageCostUOM" resolver="session" global="true"/>  
    <xapl:variable name="appWeeklyHorizonData" resolver="session" global="true"/>
    <xapl:variable name="appMonthlyHorizonData" resolver="session" global="true"/>
    <!--EQ:569183-->
    <xapl:variable name="appOpRatePerUoms" resolver="session" global="true"/>
    <xapl:variable name="appOpRateUoms" resolver="session" global="true"/>
    <xapl:variable name="appOpReleaseFenceUOMs" resolver="session" global="true"/>
    <xapl:variable name="appBORRatePer" resolver="session" global="true"/>
    <xapl:variable name="appBORRateUOMs" resolver="session" global="true"/>
    <!--EQ:569183-->
    <!-- EQ: 512606 -->
    <xapl:variable name="appRatePer" resolver="session" global="true"/>
    <!-- End of EQ: 512606 -->
    <!-- EQ: 549156 -->
    <xapl:variable name="appCalendarUsage" resolver="session" global="true"/>
    <!-- End of EQ: 549156 -->
    <xapl:variable name="appDemandType" resolver="session" global="true"/>
    <xapl:variable name="appInventoryPolicy" resolver="session" global="true"/>

    
  </x2:command>
  <!-- **************************************************************************
  ********************************************************************************* -->
  <x2:command public="yes" description="_" name="load">
    <x2:execute command="bcm.cm:getQtyUOMs"/>
    <x2:execute command="bcm.cm:getDemandType"/>
    <x2:execute command="bcm.cm:getInventoryPolicy"/>
  </x2:command>
  <!-- **************************************************************************
  ********************************************************************************* -->
  <!-- Call this whenever cached values needs to be refreshed -->
  <x2:command public="yes" description="_" name="refresh">
    <xapl:set-variable name="appCMVUoms"/>
    <xapl:set-variable name="appDemandType"/>
    <xapl:set-variable name="appInventoryPolicy"/>
  </x2:command>
  <!-- **************************************************************************
  ********************************************************************************* -->
  <x2:command public="yes" description="_" name="getQtyUOMs">
    <xapl:if test="count($appCMVUoms/*) = 0">
      <xapl:set-variable name="appCMVUoms">
        <xcore:get-document name="//UserSecurity/CODE_MASTER_VALUE">
          <STATUS Value="ACTIVE"/>
          <TYPE_ID Value="QTY_UOM"/>
        </xcore:get-document>
      </xapl:set-variable>
    </xapl:if>
    <xapl:return>
      <UOMS>
        <xapl:value-of select="$appCMVUoms"/>
      </UOMS>
    </xapl:return>
  </x2:command>
  <!-- **************************************************************************
  ********************************************************************************* -->
  <x2:command public="yes" description="_" name="getCurrencyCodes">
    <xapl:if test="count($appCMVCurrencyCodes/*) = 0">
      <xapl:set-variable name="appCMVCurrencyCodes">
        <CURRENCY_CODES>
          <xcore:get-document name="//UserSecurity/CODE_MASTER_VALUE">
            <STATUS Value="ACTIVE"/>
            <TYPE_ID Value="CURRENCY"/>
            <ORDER_BY>
              <VALUE_ID Sort="Ascending"/>
            </ORDER_BY>
          </xcore:get-document>
        </CURRENCY_CODES>
      </xapl:set-variable>
    </xapl:if>
    <xapl:print select="{concat('NUMBER OF CURRENCIES = ', count($appCMVCurrencyCodes/*))}"/>
    <xapl:return>
      <xapl:value-of select="$appCMVCurrencyCodes"/>
    </xapl:return>
  </x2:command>
  <!-- **************************************************************************
  ********************************************************************************* -->
  <x2:command public="yes" description="_" name="getDistanceCodes">
