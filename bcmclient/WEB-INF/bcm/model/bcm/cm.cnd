  <!-- **************************************************************************
  ********************************************************************************* -->
  <x2:command public="yes" description="_" name="getOperationClass">
    <xapl:variable name="operationClass">
      <xcore:get-document name="//UserSecurity/CODE_MASTER_VALUE">
        <STATUS Value="ACTIVE"/>
        <TYPE_ID Value="OPERATION_CLASS"/>
      </xcore:get-document>
    </xapl:variable>
