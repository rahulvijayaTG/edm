  </x2:command>
  **************************************************************************
  ********************************************************************************* 
  <x2:command public="yes" description="_" name="getOperationType">
    <x2:param name="classValue" select="$classValue"/>
    <xapl:variable name="appOperationType"/>
    <xapl:variable name="operationClass">
      <xapl:if test="string-length($classValue) &gt; 0">
        <xcore:get-document name="//UserSecurity/CODE_MASTER_VALUE">
          <STATUS Value="ACTIVE"/>
          <TYPE_ID Value="OPERATION_CLASS"/>
          <VALUE_ID Value="{$classValue}"/>
        </xcore:get-document>
      </xapl:if>
    </xapl:variable>
    <xapl:variable name="operationType">
      <xcore:get-document name="//UserSecurity/CODE_MASTER_VALUE">
        <STATUS Value="ACTIVE"/>
        <TYPE_ID Value="OPERATION_TYPE"/>
        <xapl:if test="string-length($operationClass/ID/@Value) &gt; 0">
          <PARENT_ID Value="{$operationClass/ID/@Value}"/>
        </xapl:if>
      </xcore:get-document>
    </xapl:variable>
    <!--
    <xapl:variable name="operationClass">
      <xcore:get-document name="//UserSecurity/CODE_MASTER_VALUE">
        <STATUS Value="ACTIVE"/>
        <TYPE_ID Value="OPERATION_CLASS"/>
        <VALUE_ID Value="{$classValue}"/>
      </xcore:get-document>
    </xapl:variable>
    <xapl:variable name="operationType">
      <xcore:get-document name="//UserSecurity/CODE_MASTER_VALUE">
        <STATUS Value="ACTIVE"/>
        <TYPE_ID Value="OPERATION_TYPE"/>
        <PARENT_ID Value="{$operationClass/ID/@Value}"/>
      </xcore:get-document>
    </xapl:variable>
    -->
    <xapl:return>
      <OPERATION_TYPE>
        <xapl:value-of select="$operationType"/>
      </OPERATION_TYPE>
    </xapl:return>
  </x2:command>
  <x2:command public="yes" description="_" name="getHandlingType">
