				</perm:action>
				<perm:action value="bcmADWTableView">
					<perm:allow role="bcmADWTableView"/>
				</perm:action>
			</perm:state>
		</perm:define-permissions>
		<!-- **********************************************************************
    *********************************************************************** -->
