<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" description="_">
	<x2:command name="init" public="yes" description="_">
		<xapl:print>Defining BCM Permissions....</xapl:print>
		<perm:define-permissions document="BCM_ACTIVITY">
			<perm:state value="*">
				<perm:action value="manage_data">
					<perm:allow role="manage_data"/>
				</perm:action>
				<perm:action value="maintain_data">
					<perm:allow role="maintain_data"/>
				</perm:action>
				<perm:action value="maintain_in_stg_data">
					<perm:allow role="maintain_in_stg_data"/>
				</perm:action>
				<perm:action value="maintain_master_data">
					<perm:allow role="maintain_master_data"/>
				</perm:action>
				<perm:action value="master_data">
					<perm:allow role="master_data"/>
				</perm:action>
				<perm:action value="master_item_maintenance">
					<perm:allow role="master_item_maintenance"/>
				</perm:action>
				<perm:action value="upload_data">
					<perm:allow role="upload_data"/>
				</perm:action>
				<perm:action value="error_reports">
					<perm:allow role="error_reports"/>
				</perm:action>
				<!-- START: new nav pad -->
				<perm:action value="bcmDataManagement">
					<perm:allow role="bcmDataManagement"/>
				</perm:action>
				<perm:action value="bcmConfigureSystem">
					<perm:allow role="bcmConfigureSystem"/>
				</perm:action>
				<!-- END: new nav pad -->
			</perm:state>
		</perm:define-permissions>
		<!-- **********************************************************************
    *********************************************************************** -->
		<perm:define-permissions document="INSTANCES">
			<perm:state value="*">
				<perm:action value="staging">
					<perm:allow role="staging"/>
				</perm:action>
				<perm:action value="bcmInboundTableEdits">
