<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" 
xmlns:xcore="http://www.i2.com/xcore" 
xmlns:xcore-db="http://www.i2.com/xcore-db" 
xmlns:xapl="http://www.i2.com/xapl" 
xmlns:web="http://www.i2.com/web"
xmlns:util="http://www.i2.com/util" 
xmlns:i18n="http://www.i2.com/i18n" description="_">  

<x2:command name="init" public="yes" description="load x2 parameters">
    <!--loadTablesOnLogin is used to decide if the tables under view tables should be loaded on login-->
    <!--if the value is set to 'no' then the tables will be loaded when the user clicks on view tables -->
    <xapl:variable name="loadTablesOnLogin" resolver="application" global="true"/> 
    <xapl:variable name="showOutputStaging" resolver="application" global="true"/>
    <xapl:set-variable name="loadTablesOnLogin" select="'yes'"/>
    <xapl:set-variable name="showOutputStaging" select="'no'"/>
</x2:command>

</x2:commands>


