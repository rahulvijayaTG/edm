<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" 
xmlns:xcore="http://www.i2.com/xcore" 
xmlns:xcore-db="http://www.i2.com/xcore-db" 
xmlns:xapl="http://www.i2.com/xapl" 
xmlns:web="http://www.i2.com/web"
xmlns:docutil="http://www.i2.com/docutil" 
xmlns:util="http://www.i2.com/util" 
xmlns:i18n="http://www.i2.com/i18n" description="_">  

<x2:command name="Reload" public="yes" description="reloads the engine">
  <xapl:print>Reloading engine...</xapl:print>
  <x2:reload-engine/>
  <xapl:print>...reload complete.</xapl:print>
</x2:command>

<x2:command name="ClearTimer" public="yes" description="Clears timer logs.">
  <util:clear-timer/>
  <xapl:print>Clear timer...</xapl:print>
</x2:command>

<x2:command name="GotoErrorPage" public="yes" description="Forwards the browser to the not found page.">
  <web:display-page>
    <web:get-page name="omx_error_page">
      <MSG Value="Error has occured."/>
    </web:get-page>
  </web:display-page>
</x2:command>

<x2:command name="GotoNotFoundPage" public="yes" description="Forwards the browser to the not found page.">
  <web:display-page>
    <web:get-page name="omx_error_page">
      <MSG Value="Command Not Found"/>
    </web:get-page>
  </web:display-page>
</x2:command>

<x2:command name="GoToLocatorNotFound" public="yes" description="Forwards the browser to the not found page.">
  <web:display-page>
    <web:get-page name="omx_error_page">
      <MSG Value="Locator Not Found"/>
    </web:get-page>
  </web:display-page>
</x2:command>

<x2:command name="GoToServicesNotRegistered" public="yes" description="Forwards the browser to the not found page.">
  <web:display-page>
    <web:get-page name="omx_error_page">
      <MSG Value="Services Not Registered"/>
    </web:get-page>
  </web:display-page>
</x2:command>

</x2:commands>


