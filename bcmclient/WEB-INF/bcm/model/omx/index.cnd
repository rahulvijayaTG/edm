<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">  

<!-- ********************************************************************** 
     *********************************************************************** -->		  
	<x2:command public="yes" description="_" name="getMyProfile">
    <xapl:variable name="userId"><identity:get-user-id/></xapl:variable>
			<xapl:variable name="myprofile">
			<xcore:get-document name="//UserSecurity/USER_PROFILE">
				<ID Value="{$userId}"/>
				<FETCH_DOCUMENT_LINK Name="CONTACT_INFO_LINK"/>
				<FETCH_DOCUMENT_LINK Name="ORG_INFO_LINK"/>
				<FETCH_DOCUMENT_LINK Name="ROLE_LIST_LINK">
					<FETCH_DOCUMENT_LINK Name="ROLE_INFO_LINK"/>
				</FETCH_DOCUMENT_LINK>
			</xcore:get-document>
			</xapl:variable>
			<xapl:return>
				<xapl:value-of select="{$myprofile}"/>
			</xapl:return>
		
	</x2:command>


<!-- ********************************************************************** 
     *********************************************************************** -->		  
  <x2:command public="yes" description="_" name="getHomeHeader">

    <xapl:return>		
    <x2:execute command="omx.index:getHeader">
	  	<x2:with-param name="pHeading" select="'Home'"/>
	  	<x2:with-param name="pToggle" select="'../'"/>
    </x2:execute>
    </xapl:return>
          
	</x2:command>

  
<!-- ********************************************************************** 
     *********************************************************************** -->		    
  <x2:command public="yes" description="_" name="getHeader">
		<x2:param name="pHeading"/>
		<x2:param name="pHeadingUrl"/>
		<x2:param name="pHeading2"/>
		<x2:param name="this"/>    
		<x2:param name="pToggle" select="'../../'"/>
   
			<xapl:variable name="links">
				<docutil:collate name="LINK_DETAILS">
					<xapl:value-of select="{$this/LINK}"/>
					<xapl:value-of select="{$this/LINK_URL}"/>
					<xapl:value-of select="{$this/LINK_IMG_PATH}"/>
				</docutil:collate>
			</xapl:variable>

			<xapl:variable name="link">
				<LINKS>
					<xapl:for-each varName="linkDetail" select="{$links/LINK_DETAILS}">
						<LINK>
							<DISPLAY_TEXT Value="{$linkDetail/LINK/@Value}"/>
							<URL Value="{$linkDetail/LINK_URL/@Value}"/>
							<IMG_PATH Value="{$linkDetail/LINK_IMG_PATH/@Value}"/>
						</LINK>
					</xapl:for-each>
				</LINKS>
			</xapl:variable>
      
			<xapl:return>

      <HEADER>
				<APP_NAME Value="Distributed Order Management"/>
				<TOGGLE_NAV Value="{$pToggle}"/>
				<HEADING Value="{$pHeading}"/>
        <xapl:if test="string-length($pHeadingUrl) > 0">
	  			<HEADING_LINK Value="{$pHeadingUrl}"/>
        </xapl:if>
        <xapl:if test="string-length($pHeading2) > 0">
  				<HEADING2 Value="{$pHeading2}"/>
        </xapl:if>
<!--
				<xapl:value-of select="{$link}"/>
-->
				<HOME Value="omx/home.jsp"/>
      </HEADER>		

			</xapl:return>
	</x2:command>
<!-- ********************************************************************** 
     *********************************************************************** -->		  
</x2:commands>
