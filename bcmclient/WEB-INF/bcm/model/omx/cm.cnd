  <x2:command public="yes" description="_" name="getCurrencyCode">
    <x2:param name="pValueId"/>
    <xapl:return>
      <CURRENCY_CODES>
        <xcore:get-document name="//UserSecurity/CODE_MASTER_VALUE">
          <xcore:search-by property="VALUE_ID" value="{$pValueId}" matchby="EQUAL"/>
          <xcore:search-by property="TYPE_ID" value="CURRENCY" matchby="EQUAL"/>
        </xcore:get-document>
      </CURRENCY_CODES>
    </xapl:return>
  </x2:command>
  <x2:command public="yes" description="_" name="getLocales">
