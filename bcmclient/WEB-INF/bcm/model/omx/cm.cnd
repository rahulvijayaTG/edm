  <x2:command public="yes" description="_" name="getOrderTypes">
    <xapl:return>
      <ORDER_TYPES>
        <xcore:get-document name="//UserSecurity/CODE_MASTER_VALUE">
          <STATUS Value="ACTIVE"/>
          <TYPE_ID Value="ORDER_TYPE"/>
        </xcore:get-document>
      </ORDER_TYPES>
    </xapl:return>
  </x2:command>
