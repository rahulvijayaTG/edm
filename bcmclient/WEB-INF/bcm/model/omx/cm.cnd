  <x2:command public="yes" description="_" name="getPromisingPolicies">
    <x2:param name="pType"/>
    <x2:param name="pCfgType"/>
    <xapl:print>  pType <xapl:value-of select="{$pType}"/>
    </xapl:print>
    <xapl:print>  pCfgType <xapl:value-of select="{$pCfgType}"/>
    </xapl:print>
    <xapl:if test="string-length($pType)=0">
      <xapl:return>
        <PROMISING_POLICIES>
          <xcore:get-document name="//UserSecurity/CODE_MASTER_VALUE">
            <STATUS Value="ACTIVE"/>
            <TYPE_ID Value="PROMISING_POLICY"/>
          </xcore:get-document>
        </PROMISING_POLICIES>
      </xapl:return>
    </xapl:if>
    <!-- Line Item -->
    <xapl:if test="$pType= 'ORDER_LINE_ITEM'">
      <xapl:return>
        <PROMISING_POLICIES>
          <xcore:get-document name="//UserSecurity/CODE_MASTER_VALUE">
            <STATUS Value="ACTIVE"/>
            <TYPE_ID Value="STD_LI.PROMISING_POLICY"/>
          </xcore:get-document>
        </PROMISING_POLICIES>
      </xapl:return>
    </xapl:if>
    <!-- Omx(User)  Kit -->
    <xapl:if test="$pType= 'LINE_ITEM_GROUP' and $pCfgType= 'USER_CONFIGURED'">
      <xapl:return>
        <PROMISING_POLICIES>
          <xcore:get-document name="//UserSecurity/CODE_MASTER_VALUE">
            <STATUS Value="ACTIVE"/>
            <TYPE_ID Value="KIT_LI.PROMISING_POLICY"/>
          </xcore:get-document>
        </PROMISING_POLICIES>
      </xapl:return>
    </xapl:if>
    <!-- Configurator (System) Kit -->
    <xapl:if test="$pType= 'LINE_ITEM_GROUP' and $pCfgType= 'SYSTEM_CONFIGURED'">
      <xapl:return>
        <PROMISING_POLICIES>
          <xcore:get-document name="//UserSecurity/CODE_MASTER_VALUE">
            <STATUS Value="ACTIVE"/>
            <TYPE_ID Value="CFG_LI.PROMISING_POLICY"/>
          </xcore:get-document>
        </PROMISING_POLICIES>
      </xapl:return>
    </xapl:if>
  </x2:command>
