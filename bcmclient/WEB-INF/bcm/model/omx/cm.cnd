  <x2:command public="yes" description="_" name="getCreditReps">
    <xapl:variable name="identityOrg">
      <identity:get-org/>
    </xapl:variable>
    <xapl:return>
      <CREDIT_REPS>
        <xcore:get-document name="//UserSecurity/USER_PROFILE">
          <ORG_ID Value="{$identityOrg}"/>
          <QUERY_DOCUMENT_LINK Name="ROLE_LIST_LINK">
            <ROLE_ID Value="CR"/>
          </QUERY_DOCUMENT_LINK>
        </xcore:get-document>
      </CREDIT_REPS>
    </xapl:return>
  </x2:command>
  <!-- For Locations Advanced Search - with Select in getCountries -->
  <x2:command public="yes" description="_" name="getCountriesForLocSearch">
    <xapl:variable name="resCodes">
      <x2:execute command="omx.cm:getCountries"/>
    </xapl:variable>
    <xapl:variable name="countryCodes">
      <COUNTRIES>
        <CODE_MASTER_VALUE>
          <DESCRIPTION Value="SELECT_NONE"/>
          <VALUE_ID Value="SELECT_NONE"/>
        </CODE_MASTER_VALUE>
        <xapl:value-of select="$resCodes/*"/>
      </COUNTRIES>
    </xapl:variable>
    <docutil:remove select="{$countryCodes/COUNTRY_DEFAULT}"/>
    <docutil:add select="{$countryCodes}">
      <COUNTRY_DEFAULT Value="SELECT_NONE"/>
    </docutil:add>
    <xapl:return>
      <xapl:value-of select="{$countryCodes}"/>
    </xapl:return>
  </x2:command>
  <x2:command public="yes" description="_" name="getCountries">
    <x2:param name="pDefaultCountry" select="'USA'"/>
    <xapl:variable name="cachedCountryCodes" resolver="session"/>
    <xapl:if test="{count($cachedCountryCodes)=0}">
      <xapl:set-variable name="cachedCountryCodes">
        <COUNTRIES>
          <COUNTRY_DEFAULT Value="{$pDefaultCountry}"/>
          <xcore:get-document name="//UserSecurity/CODE_MASTER_VALUE">
            <STATUS Value="ACTIVE"/>
            <TYPE_ID Value="COUNTRY"/>
            <ORDER_BY>
              <VALUE_ID Sort="Ascending"/>
            </ORDER_BY>
          </xcore:get-document>
        </COUNTRIES>
      </xapl:set-variable>
    </xapl:if>
    <docutil:remove select="{$cachedCountryCodes/COUNTRIES/COUNTRY_DEFAULT}"/>
    <docutil:set select="{$cachedCountryCodes}">
      <COUNTRY_DEFAULT Value="{$pDefaultCountry}"/>
    </docutil:set>
    <xapl:return>
      <xapl:value-of select="{$cachedCountryCodes}"/>
    </xapl:return>
  </x2:command>
