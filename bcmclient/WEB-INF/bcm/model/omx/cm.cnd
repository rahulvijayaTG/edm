    </xapl:if>
    <xapl:return>
      <LOCALES>
        <LOCALE_DEFAULT Value="{$currentLocale/@Value}"/>
        <xcore:get-document name="//UserSecurity/CODE_MASTER_VALUE">
          <STATUS Value="ACTIVE"/>
          <TYPE_ID Value="LOCALE"/>
          <ORDER_BY>
            <DESCRIPTION Sort="Ascending"/>
          </ORDER_BY>
        </xcore:get-document>
      </LOCALES>
    </xapl:return>
  </x2:command>
