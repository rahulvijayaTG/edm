  <!-- TODO Use getStatesForCountry Inside -->
  <x2:command public="yes" description="_" name="getStates">
    <x2:param name="pUserId"/>
    <x2:param name="pRESET"/>
    <xapl:variable name="codeMasterEntry"/>
    <xapl:variable name="currentUser"/>
    <xapl:choose>
      <xapl:when test="(string-length($pUserId) != 0) and ($pRESET = 'true')">
        <xapl:set-variable name="currentUser">
          <xcore:get-document name="//UserSecurity/USER_PROFILE">
            <ID Value="{$pUserId}"/>
            <FETCH_DOCUMENT_LINK Name="CONTACT_INFO_LINK">
              <FETCH_DOCUMENT_LINK Name="ADDRESS_LINK"/>
            </FETCH_DOCUMENT_LINK>
          </xcore:get-document>
        </xapl:set-variable>
        <xapl:set-variable name="currentCountry">
          <xapl:value-of select="$currentUser/CONTACT_INFO_LINK/CONTACT/ADDRESS_LINK/ADDRESS/COUNTRY/@Value"/>
        </xapl:set-variable>
      </xapl:when>
      <xapl:otherwise>
        <xapl:if test="{string-length($currentCountry) = 0}">
          <xapl:set-variable name="currentCountry">USA</xapl:set-variable>
        </xapl:if>
      </xapl:otherwise>
    </xapl:choose>
    <xapl:set-variable name="codeMasterEntry">
      <xcore:get-document name="//UserSecurity/CODE_MASTER_VALUE">
        <STATUS Value="ACTIVE"/>
        <TYPE_ID Value="COUNTRY"/>
        <VALUE_ID Value="{$currentCountry}"/>
        <ORDER_BY>
          <VALUE_ID Sort="Ascending"/>
        </ORDER_BY>
      </xcore:get-document>
    </xapl:set-variable>
    <xapl:variable name="states">
      <STATES Type="State">
        <xcore:execute-method name="//UserSecurity/getCodeMasterValue">
          <PARENT_ID Value="{$codeMasterEntry/ID/@Value}"/>
        </xcore:execute-method>
      </STATES>
    </xapl:variable>
    <!-- add in the i18n text for the states so they can be sorted correctly -->
    <xapl:for-each select="$states/CODE_MASTER_VALUE" varName="state">
      <docutil:add select="$state">
        <xapl:variable name="text">
          <i18n:text>
            <xapl:value-of select="$state/DESCRIPTION/@Value"/>
          </i18n:text>
        </xapl:variable>
        <DISPLAY_TEXT Value="{$text}"/>
      </docutil:add>
    </xapl:for-each>
    <xapl:return>
      <xapl:value-of select="$states"/>
    </xapl:return>
  </x2:command>
  <x2:command public="yes" description="_" name="getStatesForCountry">
    <x2:param name="pCountry" select="'USA'"/>
    <xapl:variable name="codeMasterEntry"/>
    <xapl:set-variable name="codeMasterEntry">
      <xcore:get-document name="//UserSecurity/CODE_MASTER_VALUE">
        <STATUS Value="ACTIVE"/>
        <TYPE_ID Value="COUNTRY"/>
        <VALUE_ID Value="{$pCountry}"/>
        <ORDER_BY>
          <VALUE_ID Sort="Ascending"/>
        </ORDER_BY>
      </xcore:get-document>
    </xapl:set-variable>
    <xapl:variable name="states">
      <STATES Type="State">
        <xcore:execute-method name="//UserSecurity/getCodeMasterValue">
          <PARENT_ID Value="{$codeMasterEntry/ID/@Value}"/>
        </xcore:execute-method>
      </STATES>
    </xapl:variable>
    <!-- add in the i18n text for the states so they can be sorted correctly -->
    <xapl:for-each select="$states/CODE_MASTER_VALUE" varName="state">
      <docutil:add select="$state">
        <xapl:variable name="text">
          <i18n:text>
            <xapl:value-of select="$state/DESCRIPTION/@Value"/>
          </i18n:text>
        </xapl:variable>
        <DISPLAY_TEXT Value="{$text}"/>
      </docutil:add>
    </xapl:for-each>
    <xapl:return>
      <xapl:value-of select="$states"/>
    </xapl:return>
  </x2:command>
