<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- **********************************************************************
     *********************************************************************** -->
  <x2:command name="init" public="yes" description="_">
    <x2:execute command="omx.pages:defineCore"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="defineCore">
    <web:define-page name="change_passwd" url="/omx/change_passwd.jsp"/>
    <web:define-page name="forgotPasswd" url="/bcm/framework/forgotPassword.jsp"/>
    <web:define-xsl name="forgotPasswd" url="/bcm/framework/xsl/forgotPassword.xsl"/>
    <web:define-page name="forgotLoginName" url="/bcm/framework/forgotLoginName.jsp"/>
    <web:define-xsl name="forgotLoginName" url="/bcm/framework/xsl/forgotLoginName.xsl"/>
    <web:define-page name="close_and_refresh" url="/omx/close_and_refresh.html"/>
    <web:define-page name="confirmation_page" url="/omx/confirmation.jsp"/>
    <web:define-xsl name="omx_header" url="/omx/xsl/omx_header.xsl"/>
    <web:define-xsl name="change_passwd" url="/omx/xsl/change_passwd.xsl"/>
    <web:define-page name="change_passwd_inner" url="/omx/change_passwd_inner.jsp"/>
    <web:define-xsl name="change_passwd_inner" url="/omx/xsl/change_passwd_inner.xsl"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
</x2:commands>
