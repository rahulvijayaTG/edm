<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" description="_">  
  
  
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    
    <xapl:variable name="getHeader"><xapl:value-of select="concat($this/DIRECTORY/@Value,'.', 'pages',':getHeader')"/></xapl:variable>
    
    <xapl:return>		
      <x2:execute command="{$getHeader}">
        <x2:with-param name="pPage" select="$this/PAGE/@Value"/>
      </x2:execute>
      
    </xapl:return>
    
  </x2:command>
  
  
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
    <x2:param name="directory" select="$this/DIRECTORY[1]/@Value"/>
    <x2:param name="file" select="$this/FILE[1]/@Value"/>
    
    <xapl:variable name="getFormData"><xapl:value-of select="concat($directory,'.', $file,':getFormData')"/></xapl:variable>
    <xapl:variable name="getTabs"><xapl:value-of select="concat($directory,'.', 'pages',':getTabs')"/></xapl:variable>

    <xapl:variable name="formData">
      <x2:execute command="{$getFormData}">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
   </xapl:variable>   

    <xapl:return>
      <x2:execute command="{$getTabs}">
         <x2:param name="pPage" select="{$this/PAGE[1]/@Value}"/>
         <x2:param name="pId" select="{$formData/ID[1]/@Value}"/>
         <x2:param name="pEditable" select="{$formData/EDITABLE[1]/@Value}"/>
         <x2:param name="pIsNew" select="{$formData/IS_NEW[1]/@Value}"/>
         <x2:param name="pStatus" select="{$formData/STATUS[1]/@Value}"/>
      </x2:execute>

      <x2:execute command="omx.search.maintain:getForm">
        <x2:with-param name="pFormData" select="$formData"/>
        <x2:with-param name="directory" select="$this/DIRECTORY[1]/@Value"/>
        <x2:with-param name="file" select="$this/FILE[1]/@Value"/>
        <x2:with-param name="pEditable" select="$this/EDITABLE[1]/@Value"/>
        <x2:with-param name="pValidation" select="$this/VALIDATION[1]/@Value"/>
        <x2:with-param name="this" select="$this"/>

      </x2:execute>
      
    </xapl:return>
    
  </x2:command>  
  

  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getForm">
    <x2:param name="directory" select="$this/DIRECTORY[1]/@Value"/>
    <x2:param name="file" select="$this/FILE[1]/@Value"/>
    <x2:param name="pFormData" select="$this"/>
    <x2:param name="pEditable" select="$this/EDITABLE[1]/@Value"/>
    <x2:param name="pValidation" select="$this/VALIDATION[1]/@Value"/>
    <x2:param name="pFormStatus" select="$this/FORM_STATUS[1]/@Value"/>

    <xapl:variable name="getFormConfig"><xapl:value-of select="concat($directory,'.', $file,':getFormConfig')"/></xapl:variable>
    
    <!-- Get Form Config-->
    <xapl:variable name="form">
      <x2:execute command="{$getFormConfig}">
        <x2:with-param name="pEditable" select="$pEditable"/>
        <x2:with-param name="pFormData" select="$pFormData"/>        
        <x2:with-param name="pValidation" select="$pValidation"/>
        <x2:with-param name="pFormStatus" select="$pFormStatus"/>
      </x2:execute>  
    </xapl:variable> 
    
    <!-- Get Filled Form -->
    <xapl:variable name="filledForm">
      <x2:execute command="omx.search.maintain:getFilledForm">
        <x2:with-param name="pForm" select="{$form}"/>
        <x2:with-param name="pFormData" select="{$pFormData}"/>
        <x2:with-param name="this" select="{$this}"/><!-- For hidden fields only -->
      </x2:execute>  
    </xapl:variable>   
    <xapl:print>  filledForm <xapl:value-of select="{$filledForm}"/> </xapl:print>
    
    
    <!-- Add the form status -->
    <docutil:set select="$filledForm">
      <STATUS 
            Type ="{$this/ACTION_STATUS_TYPE[1]/@Value}" 
            DisplayText="{$this/ACTION_STATUS_MSG[1]/@Value}">
      </STATUS>       
             
    </docutil:set>

    <xapl:return>
      <!-- TODO: Change Root to MAINTAIN -->
      <SEARCH>
        <!-- Return Filled Form -->
        <xapl:value-of select="$filledForm"/>
      </SEARCH>
      
    </xapl:return>
  </x2:command>
  
  
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHiddenFields">
    <xapl:return>
      <!-- Always Put hidden at the end -->
      
       <FIELD 
               Type="Hidden" 
               Name="IS_NEW" 
               Visibility="Simple"/>

       <FIELD 
               Type="Hidden" 
               Name="EDITABLE" 
               Visibility="Simple"/>


       <FIELD 
               Type="Hidden" 
               Name="ACTION_STATUS_TYPE" 
               Visibility="Simple"/>

               
     <FIELD 
               Type="Hidden" 
               Name="ACTION_STATUS_MSG" 
               Visibility="Simple"/>
               
      <FIELD 
             Type="Hidden" 
             Name="DIRECTORY" 
             Visibility="Simple"/>
      
      <FIELD 
             Type="Hidden" 
             Name="FILE" 
             Visibility="Simple"/>
      
      
      <FIELD 
             Type="Hidden" 
             Name="DOC_TYPE" 
             Visibility="Simple"/>
      
      <FIELD 
             Type="Hidden" 
             Name="PAGE" 
             Visibility="Simple"/>
      
      <FIELD 
             Type="Hidden" 
             Name="OBJECT_TYPE" 
             Visibility="Simple"/>
             
       <FIELD 
             Type="Hidden" 
             Name="JSCRIPT" 
             Visibility="Simple"/>
      
      
    </xapl:return>      
    
  </x2:command>

  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getFilledForm">
    <x2:param name="pForm"/>
    <x2:param name="pFormData"/>
    <x2:param name="this" select="$this"/><!-- For hidden fields only -->

    
    <!-- TODO: Dont fill advanced if in simple mode -->
    <xapl:for-each varName="field" select="$pForm/FIELD">
       <xapl:choose>
       
        <!-- Date -->
        <xapl:when test="$field/@Type = 'DateRange'">
          <!-- Start -->            
          <docutil:set select="$fieldName"><xapl:value-of select="concat(@Name,'_FIRST')"/></docutil:set> 
          <docutil:set select="$field/@Value1">
            <xapl:value-of select="$pFormData/*[name() = $fieldName]/@Value"/>                 
          </docutil:set>  
          <!-- End -->     
          <docutil:set select="$fieldName"><xapl:value-of select="concat(@Name,'_LAST')"/></docutil:set> 
          <docutil:set select="$field/@Value2">
            <xapl:value-of select="$pFormData/*[name() = $fieldName]/@Value"/>                 
          </docutil:set>  
        </xapl:when>
       
        <!-- Select -->
        <xapl:when test="$field/@Type = 'Select'">
          <!-- Value -->  
          <docutil:set select="$field/@Value">
            <xapl:value-of select="$pFormData/*[name() = $field/@Name]/@Value"/>                 
          </docutil:set>  
          
          <xapl:variable name="optionIdSourceName">
                  <xapl:choose>
                    <xapl:when test="string-length($field/@OptionIdSourceName) > 0">
                      <xapl:value-of select="$field/@OptionIdSourceName"/>
                   </xapl:when>
                   <xapl:otherwise>VALUE_ID</xapl:otherwise>
                  </xapl:choose> 
          </xapl:variable>

          <xapl:variable name="optionDescriptionSourceName">
                  <xapl:choose>
                    <xapl:when test="string-length($field/@OptionDescriptionSourceName) > 0">
                      <xapl:value-of select="$field/@OptionDescriptionSourceName"/>
                   </xapl:when>
                   <xapl:otherwise>DESCRIPTION</xapl:otherwise>
                  </xapl:choose> 
          </xapl:variable>
          
          
          <!-- If data source is a command or method-->              
          <xapl:if test="$field/@DataSourceType = 'Command' or $field/@DataSourceType = 'Method'">
            
            <!-- Get Data -->
            <xapl:variable name="data">
              <xapl:choose>
                <xapl:when test="$field/@DataSourceType = 'Command'"> 
                  <xapl:choose>
                    <xapl:when test="count($field/DATA_SOURCE/PARAM) > 0">
                      <x2:execute command="{$field/@DataSourceName}">			 
                        <x2:with-param name="{$field/DATA_SOURCE/PARAM/@Name}" select="$pFormData/*[name() = $field/DATA_SOURCE/PARAM/@ValueSource]/@Value"/>
                      </x2:execute>
                   </xapl:when>
                   <xapl:otherwise>
                    <x2:execute command="{$field/@DataSourceName}"/>			 
                   </xapl:otherwise>
                  </xapl:choose> 
                </xapl:when>
                <xapl:when test="$field/@DataSourceType = 'Method'"> 
                  <xcore:execute-method name="{$field/@DataSourceName}"/>			 
                  
                </xapl:when>
              </xapl:choose> 
            </xapl:variable>

            <xapl:variable name="option"/>
            <!-- Generate Options -->
            <xapl:for-each varName="row" select="{$data/*}">

               <xapl:set-variable name="option"/>
               <xapl:set-variable name="option">
                <ROOT>
                  <OPTION Id="{$row/*[name() = $optionIdSourceName]/@Value}"/> 
                </ROOT>            
              </xapl:set-variable>
              <!-- If @ShowDescription is not there or it is not false -->              
              <xapl:if test="string-length($field/@ShowDescription) = 0 or $field/@ShowDescription != 'false'">
                <docutil:set select="$option/OPTION/@Value">
                  <xapl:value-of select="$row/*[name() = $optionDescriptionSourceName]/@Value"/>
                </docutil:set>
              </xapl:if> 

              <docutil:add select="$field">
                  <xapl:value-of select="$option/OPTION"/>
              </docutil:add>  
              
            </xapl:for-each>
          </xapl:if>
        </xapl:when>
       
       
        <!-- Hidden -->
        <xapl:when test="$field/@Type = 'Hidden'">
        <xapl:print>  $field/@Value before <xapl:value-of select="{$field/@Value}"/> </xapl:print>
        <xapl:print>  name before <xapl:value-of select="{$field/@Name}"/> </xapl:print>
          <xapl:if test="string-length($field/@Value) = 0">
            <!-- Value --> 
            <docutil:set select="$field/@Value">
              <xapl:choose>
                <xapl:when test="$field/@DataSourceName='FormData'">
                  <xapl:value-of select="$pFormData/*[name() = $field/@Name]/@Value"/>                 
                </xapl:when>
                <xapl:otherwise>
                  <xapl:value-of select="$this/*[name() = $field/@Name]/@Value"/>                 
                </xapl:otherwise>
              </xapl:choose> 
            </docutil:set>  
          </xapl:if>
        <xapl:print>  $field/@Value before <xapl:value-of select="{$field/@Value}"/> </xapl:print>
        </xapl:when>
        
        <!-- Text, Currency etc. -->
        <xapl:otherwise>
          <!-- Value -->  
          <docutil:set select="$field/@Value">
            <xapl:value-of select="$pFormData/*[name() = $field/@Name]/@Value"/>                 
          </docutil:set>  

        </xapl:otherwise>
      </xapl:choose>
   </xapl:for-each>  
    
    
    <xapl:return>
      <xapl:value-of select="$pForm"/>
    </xapl:return>
    
  </x2:command>

  
</x2:commands>


