<?xml version="1.0" encoding="utf-8"?>
<x2:commands description="_" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:cfg="http://www.i2.com/configurability" xmlns:core="http://www.i2.com/core" xmlns:omx="http://www.i2.com/omx" xmlns:perm="http://www.i2.com/permissibility" xmlns:util="http://www.i2.com/util" xmlns:web="http://www.i2.com/web" xmlns:x2="http://www.i2.com/x2" xmlns:xapl="http://www.i2.com/xapl" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:docutil="http://www.i2.com/docutil" xmlns:xudl="http://www.i2.com/xudl">
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="changePassword">
    <xapl:if test="$this/PROMPT_SECRET_QUESTION/@Value = 'yes' ">
      <xcore:execute-method name="//UserSecurity/setRecoveryQuestion" entireResponse="true">
        <!-- Storing user name (login name) instead of user id since both are unique -->
        <USER_ID Value="{$this/USER_NAME/@Value}"/>
        <xapl:value-of select="$this/PWD_QUESTION"/>
        <xapl:value-of select="$this/PWD_ANSWER"/>
      </xcore:execute-method>
    </xapl:if>
    <xapl:variable name="isSuccess">
      <xcore:execute-method name="//UserSecurity/changePassword" entireResponse="true">
        <ID Value="{identity-user-id()}"/>
        <xapl:value-of select="$this/OLD_PASSWORD"/>
        <xapl:value-of select="$this/NEW_PASSWORD"/>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:choose>
      <xapl:when test="{$isSuccess/RESPONSE/@Status = 'Error'}">
        <web:display-page>
          <web:get-page name="change_passwd">
            <ERROR Value="true"/>
            <DESCRIPTION Value="{$isSuccess/RESPONSE/_RESULT/_ERROR/@Value}"/>
            <USER_NAME Value="{$this/USER_NAME/@Value}"/>
            <xapl:if test="string-length($this/MY_PROFILE/@Value) &gt; 0">
              <MY_PROFILE Value="{$this/MY_PROFILE/@Value}"/>
            </xapl:if>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:otherwise>
        <!-- If user has come to change his/her pwd from My Profile link, redirect him/her to homepage; else to login page -->
        <xapl:choose>
          <xapl:when test="$this/MY_PROFILE/@Value = 'yes' ">
            <web:display-page>
              <web:get-page name="loginSuccess">
                <ACTIVITY Value="bcmDataManagement"/>
              </web:get-page>
            </web:display-page>
          </xapl:when>
          <xapl:otherwise>
            <web:display-page>
              <web:get-page name="login">
                <FROM Value="change_passwd"/>
              </web:get-page>
            </web:display-page>
          </xapl:otherwise>
        </xapl:choose>
      </xapl:otherwise>
    </xapl:choose>

  </x2:command>
  
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="changePasswordInner">
    <xapl:print> this in changePasswordInner: <xapl:value-of select="$this"/></xapl:print>
    <xapl:if test="$this/PROMPT_SECRET_QUESTION/@Value = 'yes' ">
      <xcore:execute-method name="//UserSecurity/setRecoveryQuestion" entireResponse="true">
        <!-- Storing user name (login name) instead of user id since both are unique -->
        <USER_ID Value="{$this/USER_NAME/@Value}"/>
        <xapl:value-of select="$this/PWD_QUESTION"/>
        <xapl:value-of select="$this/PWD_ANSWER"/>
      </xcore:execute-method>
    </xapl:if>
    <xapl:variable name="isSuccess">
      <xcore:execute-method name="//UserSecurity/changePassword" entireResponse="true">
        <ID Value="{identity-user-id()}"/>
        <xapl:value-of select="$this/OLD_PASSWORD"/>
        <xapl:value-of select="$this/NEW_PASSWORD"/>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:print> isSuccess in changePasswordInner: <xapl:value-of select="$isSuccess"/></xapl:print>
    <xapl:choose>
      <xapl:when test="{$isSuccess/RESPONSE/@Status = 'Error'}">
        <web:display-page>
          <web:get-page name="change_passwd_inner">
            <ERROR Value="true"/>
            <DESCRIPTION Value="{$isSuccess/RESPONSE/_RESULT/_ERROR/@Value}"/>
            <USER_NAME Value="{$this/USER_NAME/@Value}"/>
            <xapl:if test="string-length($this/MY_PROFILE/@Value) &gt; 0">
              <MY_PROFILE Value="{$this/MY_PROFILE/@Value}"/>
            </xapl:if>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:otherwise>        
        <xapl:choose>
          <xapl:when test="$this/MY_PROFILE/@Value = 'yes' ">
           <docutil:set select="$this">
                <ID Value="{identity-user-id()}"/>
                <WHERE Value="USER_DETAILS"/>
                <VIEW_MODE Value='PREFERENCE'/>
                <SUCCESS Value="true"/>
                <SUCCESS_MESSAGE Value="The Password has been successfully changed!"/>
            </docutil:set>                      
            <web:display-page>
                <web:get-page name="users_edit">
                    <xapl:value-of select="$this/*"/>                   
                </web:get-page>             
            </web:display-page>
          </xapl:when>
          <xapl:otherwise>
            <web:display-page>
              <web:get-page name="login">
                <FROM Value="change_passwd"/>
              </web:get-page>
            </web:display-page>
          </xapl:otherwise>
        </xapl:choose>
      </xapl:otherwise>
    </xapl:choose>

  </x2:command>  
</x2:commands>