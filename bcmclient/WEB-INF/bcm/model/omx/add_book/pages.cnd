<?xml version="1.0" encoding="UTF-8"?>
<x2:commands description="_" 
             xmlns:FUNCTION="http://www.i2.com/FUNCTION" 
             xmlns:REMOVE="http://www.i2.com/REMOVE" 
             xmlns:cfg="http://www.i2.com/configurability" 
             xmlns:core="http://www.i2.com/core" 
             xmlns:omx="http://www.i2.com/omx" 
             xmlns:perm="http://www.i2.com/permissibility" 
             xmlns:util="http://www.i2.com/util" 
             xmlns:web="http://www.i2.com/web" 
             xmlns:x2="http://www.i2.com/x2" 
             xmlns:xapl="http://www.i2.com/xapl" 
             xmlns:xcore="http://www.i2.com/xcore" 
             xmlns:xcore-db="http://www.i2.com/xcore-db" 
             xmlns:docutil="http://www.i2.com/docutil" 
             xmlns:xudl="http://www.i2.com/xudl"
             xmlns:identity="http://www.i2.com/identity">
               
  <!--************************************************************************--> 
  
  <x2:command name="init" public="yes" description="_">
    <x2:execute command="omx.add_book.pages:defineCore"/>
  </x2:command>

  <!--************************************************************************--> 
  
  <x2:command name="defineCore" public="yes" description="_">
    
    <web:define-page name="addrbook_home" url="/omx/add_book/org/index.jsp"/>
    
	<!-- Organization related pages -->
    <web:define-page name="select_org" url="/omx/add_book/org/select/org.jsp"/>
    <web:define-xsl name="select_org" url="/omx/add_book/org/select/xsl/org.xsl"/>
	<web:define-page name="select_customer" url="/omx/add_book/org/select/customer.jsp"/>
    <web:define-xsl name="select_customer" url="/omx/add_book/org/select/xsl/customer.xsl"/>
	<web:define-page name="select_org_contact" url="/omx/add_book/org/select/contact.jsp"/>
    <web:define-xsl name="select_org_contact" url="/omx/add_book/org/select/xsl/contact.xsl"/>
	<web:define-page name="select_payment_term" url="/omx/add_book/org/select/payment_term.jsp"/>
    <web:define-xsl name="select_payment_term" url="/omx/add_book/org/select/xsl/payment_term.xsl"/>
	<web:define-page name="select_shared_orgs" url="/omx/add_book/org/select/shared.jsp"/>
    <web:define-xsl name="select_shared_orgs" url="/omx/add_book/org/select/xsl/shared.xsl"/>
	<web:define-page name="add_org" url="/omx/add_book/org/add.jsp"/>
    <web:define-xsl name="add_org" url="/omx/add_book/org/xsl/add.xsl"/>
	<web:define-page name="edit_org" url="/omx/add_book/org/edit/org.jsp"/>
    <web:define-xsl name="edit_org" url="/omx/add_book/org/edit/xsl/org.xsl"/>
	<web:define-page name="org_overview" url="/omx/add_book/org/edit/overview.jsp"/>
	<web:define-xsl name="org_overview" url="/omx/add_book/org/edit/xsl/overview.xsl"/>
	<web:define-page name="org_contact" url="/omx/add_book/org/edit/contact.jsp"/>
	<web:define-xsl name="org_contact" url="/omx/add_book/org/edit/xsl/contact.xsl"/>
	<web:define-page name="org_shared" url="/omx/add_book/org/edit/shared.jsp"/>
    <web:define-xsl name="org_shared" url="/omx/add_book/org/edit/xsl/shared.xsl"/>
	<web:define-page name="org_buying_limits" url="/omx/add_book/org/edit/buying_limits.jsp"/>
	<web:define-xsl name="org_buying_limits" url="/omx/add_book/org/edit/xsl/buying_limits.xsl"/>
	<web:define-page name="org_nexus" url="/omx/add_book/org/edit/nexus.jsp"/>
	<web:define-xsl name="org_nexus" url="/omx/add_book/org/edit/xsl/nexus.xsl"/>
	<web:define-page name="org_payment_term" url="/omx/add_book/org/edit/payment_term.jsp"/>
	<web:define-xsl name="org_payment_term" url="/omx/add_book/org/edit/xsl/payment_term.xsl"/>
	<web:define-page name="org_buying_limits" url="/omx/add_book/org/edit/buying_limits.jsp"/>
	<web:define-xsl name="org_buying_limits" url="/omx/add_book/org/edit/xsl/buying_limits.xsl"/>
	<web:define-page name="org_account_code_segment" url="/omx/add_book/org/edit/account_code/segment.jsp"/>
	<web:define-xsl name="org_account_code_segment" url="/omx/add_book/org/edit/account_code/xsl/segment.xsl"/>
	<web:define-page name="org_account_code_value" url="/omx/add_book/org/edit/account_code/value.jsp"/>
	<web:define-xsl name="org_account_code_value" url="/omx/add_book/org/edit/account_code/xsl/value.xsl"/>
	
	<!-- Help -->
	<!-- Organization help -->
	<web:define-page name="add_book_details_help" url="/omx/help/search_results.html"/>
	<web:define-page name="select_org_help" url="/omx/help/search_enterprise.html"/>
	<web:define-page name="add_org_help" url="/omx/help/org_create.html"/>
	<web:define-page name="add_org_details_help" url="/omx/help/org_details.html"/>
	<web:define-page name="add_org_overview_help" url="/omx/help/org_view.html"/>
	<web:define-page name="select_child_org_help" url="/omx/help/org_view_child.html"/>
	<web:define-page name="select_org_contacts_help" url="/omx/help/contacts_add.html"/>
	<web:define-page name="nexus_states_help" url="/omx/help/nexus_states.html"/>
  </x2:command> 

  <!--************************************************************************--> 
  
  <x2:command public="yes" description="_" name="getAddBookHeader">
    <xapl:return>
      <x2:execute command="omx.index:getHeader">
        <x2:with-param name="pHeading" select="'Enterprise Model'"/>
      </x2:execute>
    </xapl:return> 
  </x2:command>
  
  <!--************************************************************************-->  

</x2:commands>
