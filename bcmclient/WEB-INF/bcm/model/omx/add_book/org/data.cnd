  <!--************************************************************************--> 
  
  <x2:command public="yes" description="_" name="getUserSellingOrg">
    
    <perm:is-allowed document="USER_DOMAIN" action="seller">
      <xapl:return>
        <identity:get-org />
      </xapl:return>
    </perm:is-allowed>
    
  </x2:command>
  
  <!--************************************************************************--> 

  <!-- JDJ -->  
  <x2:command public="yes" description="_" name="getUserCustomerOrg">
    
    <perm:is-allowed document="USER_DOMAIN" action="customer">
      <xapl:return>
        <identity:get-org />
      </xapl:return>
    </perm:is-allowed>
    
  </x2:command>
  
  <!--************************************************************************--> 
  
  <x2:command public="yes" description="_" name="getOrganization">
    <x2:param name="orgId" select="{$this/ORG_ID/@Value}" />
    <x2:param name="parentOrgId" select="{$this/PARENT_ORG_ID/@Value}" />  
    <x2:param name="pRefresh" select="{$this/REFRESH/@Value}" /> 
		
    <xapl:print>REFRESH<xapl:value-of select="$pRefresh"/></xapl:print> 
    
    <xapl:choose>
      <xapl:when test=" ($pRefresh = 'true') and (string-length($parentOrgId)= 0)">
        <xapl:set-variable name="currentCountry">
          <xapl:value-of select="{$tempForm/COUNTRY/@Value}"/>
        </xapl:set-variable>
        
        <xapl:return>
          <ORGANIZATION>
            <xapl:value-of select="{$tempForm/*}"/>
          </ORGANIZATION>
        </xapl:return>
      </xapl:when>

      <xapl:when test=" ($pRefresh = 'true') and (string-length($parentOrgId) &gt; 0)">
        <xapl:set-variable name="currentCountry">
          <xapl:value-of select="{$tempForm/COUNTRY/@Value}"/>
        </xapl:set-variable>
        
        <xapl:return>
          <ORGANIZATION>
            <xapl:value-of select="{$tempForm/*}"/>
            <PARENT_ORG_LINK>
              <xcore:execute-method name="//UserSecurity/getOrganization">
                <ID Value="{$parentOrgId}"/>
              </xcore:execute-method>
            </PARENT_ORG_LINK>
          </ORGANIZATION>
        </xapl:return>
      </xapl:when>
      
      <xapl:when test="{string-length($orgId) = 0}">
        <xapl:set-variable name="currentCountry">USA</xapl:set-variable>
        <xapl:return>
          
          <ORGANIZATION>
            <IS_NEW Value="true"/>
            <COUNTRY Value="USA"/>
            <CURRENCY_CODE Value="USD"/>
            <CUSTOMER_STATUS Value="NONE"/>
            <SELLER_STATUS Value="NONE"/>
            <xapl:if test="{string-length($parentOrgId) != 0}">
              <PARENT_ORG_ID Value="{$parentOrgId}"/>
              <PARENT_ORG_LINK>
                <xcore:execute-method name="//UserSecurity/getOrganization">
                  <ID Value="{$parentOrgId}"/>
                </xcore:execute-method>
              </PARENT_ORG_LINK>
            </xapl:if>
          </ORGANIZATION>
        </xapl:return>
      </xapl:when>
      <xapl:otherwise>
        
        <xapl:variable name="org">
          <xcore:execute-method name="//UserSecurity/getOrganization">
            <ID Value="{$orgId}"/>            
          </xcore:execute-method>
        </xapl:variable>
        
        <xapl:if test="{count($org/PARENT_ORG_ID) != 0}">
          <docutil:add select="{$org}">
            <PARENT_ORG_LINK>
              <xcore:execute-method name="//UserSecurity/getOrganization">
                <ID Value="{$org/PARENT_ORG_ID/@Value}"/>
              </xcore:execute-method>
            </PARENT_ORG_LINK>
          </docutil:add>
        </xapl:if>
	
          
        <perm:is-allowed document="ORGANIZATION" action="edit_global">            
					<docutil:add select="{$org}">
            <EDITABLE Value="true"/>
          </docutil:add>
        </perm:is-allowed>
        
        <xapl:set-variable name="currentCountry">
          <xapl:value-of select="{$org/COUNTRY/@Value}"/>
        </xapl:set-variable>
				
        <xapl:print>getOrganization!!!<xapl:value-of select="$org"/></xapl:print>
        
        <xapl:return>
          <xapl:value-of select="{$org}"/>
        </xapl:return>
        
        </xapl:otherwise>
      </xapl:choose>

  </x2:command>

  <!--************************************************************************--> 
  
  <x2:command public="yes" description="_" name="getLocalCustomer">
  <x2:param name="orgId" />
  <x2:param name="pRefresh" />
    
    <xapl:variable name="sellingOrg">
      <x2:execute command="omx.add_book.org.model:getUserSellingOrg"/>
    </xapl:variable>
    
    <xapl:print>
      sellingOrg: <xapl:value-of select="$sellingOrg" />
    </xapl:print>
	
	<xapl:variable name="localCustomers">
	  <xcore:execute-method name="//UserSecurity/getEnabledOrganizations">
	    <SELLING_ORG_ID Value="{$sellingOrg}"/>
		<FILTER Name="CUSTOMER_ORG_ID">
		  <xcore:search-by property="CUSTOMER_ORG_ID" value="{$orgId}" matchby="EQUAL"/>
		</FILTER>
	  </xcore:execute-method>
	</xapl:variable>
    
    <xapl:variable name="localCustomer" />
    <xapl:if test="{string-length($sellingOrg) != 0 and count($localCustomers/*) != 0}">
      <xapl:set-variable name="localCustomer">
		<xcore:execute-method name="//UserSecurity/getEnabledOrganization">
		  <SELLING_ORG_ID Value="{$sellingOrg}"/>
          <CUSTOMER_ORG_ID Value="{$orgId}"/>
		</xcore:execute-method>
      </xapl:set-variable>
    </xapl:if>
	
    <xapl:return>
        <xapl:choose>
		  <xapl:when test="{count($localCustomer) = 0}">
            <LOCAL_CUSTOMER>
              <IS_NEW Value="true"/>
              <CUSTOMER_ORG_ID Value="{$orgId}"/>
							
              <perm:is-allowed document="ORGANIZATION" action="edit_local">
                <EDITABLE Value="true"/>
              </perm:is-allowed>
              
            </LOCAL_CUSTOMER>
          </xapl:when>
          <xapl:otherwise>
		    <perm:is-allowed document="ORGANIZATION" action="edit_local">
              <docutil:add select="{$localCustomer}">
                <EDITABLE Value="true"/>
              </docutil:add>
            </perm:is-allowed>
            
            <xapl:value-of select="{$localCustomer}"/>
          </xapl:otherwise>
        </xapl:choose>
    </xapl:return>
    
  </x2:command>

  <!--************************************************************************--> 
  <!-- JDJ -->

  <x2:command public="yes" description="_" name="getLocalSeller">
  <x2:param name="orgId" />
  <x2:param name="pRefresh" />
    
    <xapl:variable name="custOrg">
      <x2:execute command="omx.add_book.org.model:getUserCustomerOrg"/>
    </xapl:variable>
    
    <xapl:print>
      custOrg: <xapl:value-of select="$custOrg" />
    </xapl:print>
    
    <xapl:variable name="localSeller" />
    <xapl:if test="{string-length($custOrg) != 0}">

      <xapl:set-variable name="localSeller">
        <xcore:execute-method name="//UserSecurity/getEnabledSellerOrganization">
          <CUSTOMER_ORG_ID Value="{$custOrg}"/>
          <SELLING_ORG_ID Value="{$orgId}"/>
        </xcore:execute-method>
      </xapl:set-variable>
 
      <xapl:return>
        <xapl:choose>
          <xapl:when test="{count($localSeller) = 0}">
            <LOCAL_SELLER>
              <IS_NEW Value="true"/>
              <SELLING_ORG_ID Value="{$orgId}"/>
							
              <perm:is-allowed document="ORGANIZATION" action="edit_local_seller">
                <EDITABLE Value="true"/>
              </perm:is-allowed>
              
            </LOCAL_SELLER>
          </xapl:when>
          <xapl:otherwise>
					
            <perm:is-allowed document="ORGANIZATION" action="edit_local_seller">
              <docutil:add select="{$localSeller}">
                <EDITABLE Value="true"/>
              </docutil:add>
            </perm:is-allowed>
            
            <xapl:value-of select="{$localSeller}"/>

          </xapl:otherwise>
        </xapl:choose>
      </xapl:return>
    </xapl:if>
    
  </x2:command>

  <!--************************************************************************--> 
  
  <x2:command public="yes" description="_" name="addEditOrganization">
     
   <xapl:variable name="response" />
	 
	 <xapl:print select="$this"/>
    
    <xapl:set-variable name="tempForm">
      <TEMP_FORM>
        <xapl:value-of select="$this/*"/>
      </TEMP_FORM>
    </xapl:set-variable>
    
    <xapl:if test="string-length($this/PARENT_ORG_ID/@Value) = 0">
      <docutil:remove select="{$this/PARENT_ORG_ID}"/>
    </xapl:if>
    
    <xapl:if test="string-length($this/IS_SINGLE_CORPORATE/@Value) = 0">
      <docutil:add select="$this">
        <IS_SINGLE_CORPORATE Value="false"/>
      </docutil:add>
    </xapl:if>
    
     <xapl:set-variable name="response">
        <xapl:variable name="status"><STATUS/></xapl:variable>
          <docutil:add select="$status">
            <xapl:choose>
              <xapl:when test="$this/CUSTOMER_STATUS/@Value = 'ACTIVE'">
                <IS_CUSTOMER Value="true"/>
              </xapl:when>
              <xapl:otherwise>
                <IS_CUSTOMER Value="false"/>
              </xapl:otherwise>
            </xapl:choose>
            <xapl:choose>
              <xapl:when test="$this/SELLER_STATUS/@Value = 'ACTIVE'">
                <IS_SELLER Value="true"/>
              </xapl:when>
              <xapl:otherwise>
                <IS_SELLER Value="false"/>
              </xapl:otherwise>
            </xapl:choose>
          </docutil:add>
        <xapl:choose>
        
        <xapl:when test="$this/IS_NEW/@Value = 'true'">
         
          <xcore:execute-method name="//UserSecurity/addOrg" entireResponse="true">

             <xapl:value-of select="$this/FULL_NAME"/>
             <xapl:value-of select="$this/NAME"/>            
             <xapl:value-of select="$this/ADDRESS1"/>
             <xapl:value-of select="$this/ADDRESS2"/>
             <xapl:value-of select="$this/ADDRESS3"/>
             <xapl:value-of select="$this/ADDRESS4"/>
             <xapl:value-of select="$this/ADDRESS5"/>
             <xapl:value-of select="$this/POSTAL_CODE"/>
             <xapl:value-of select="$this/CITY"/>
             <xapl:value-of select="$this/STATE"/>
             <xapl:value-of select="$this/COUNTRY"/>
						 <xapl:value-of select="$this/COUNTY"/>
						 <xapl:value-of select="$this/REGION"/>
             <xapl:value-of select="$this/URL"/>
             <xapl:value-of select="$this/PARENT_ORG_ID"/>
             <xapl:value-of select="$this/DEFAULT_FC_ID"/>
             <xapl:value-of select="$this/GENERATE_INVOICES"/>
             <xapl:value-of select="$this/ALLOWS_BACKORDERS"/>
             <xapl:value-of select="$this/IS_REPAIR_VENDOR"/>
             <xapl:value-of select="$this/IS_VRMA_REQUIRED"/>
             <xapl:value-of select="$this/TRANSFER_ORDERS_BILLABLE"/>
             <xapl:value-of select="$this/TAX_ID"/>
             <xapl:value-of select="$this/TAX_CODE"/>
             <xapl:value-of select="$this/CURRENCY_CODE"/>
             <xapl:value-of select="$this/IS_SINGLE_CORPORATE"/>
             <xapl:value-of select="$status/*"/>

          </xcore:execute-method>
          
        </xapl:when>
        
        <xapl:otherwise>
          
          <xcore:execute-method name="//UserSecurity/modifyOrganization" entireResponse="true">
             
             <xapl:value-of select="$this/ID"/>
             <xapl:value-of select="$this/ADDRESS_ID"/>
             <xapl:value-of select="$this/FULL_NAME"/>
             <xapl:value-of select="$this/NAME"/>
             <xapl:value-of select="$this/ADDRESS1"/>
             <xapl:value-of select="$this/ADDRESS2"/>
             <xapl:value-of select="$this/ADDRESS3"/>
             <xapl:value-of select="$this/ADDRESS4"/>
             <xapl:value-of select="$this/ADDRESS5"/>
             <xapl:value-of select="$this/POSTAL_CODE"/>
             <xapl:value-of select="$this/CITY"/>
             <xapl:value-of select="$this/STATE"/>
             <xapl:value-of select="$this/COUNTRY"/>
						 <xapl:value-of select="$this/COUNTY"/>
						 <xapl:value-of select="$this/REGION"/>
             <xapl:value-of select="$this/URL"/>
             <xapl:value-of select="$this/PARENT_ORG_ID"/>
             <xapl:value-of select="$this/DEFAULT_FC_ID"/>
             <xapl:value-of select="$this/GENERATE_INVOICES"/>
             <xapl:value-of select="$this/ALLOWS_BACKORDERS"/>
             <xapl:value-of select="$this/IS_REPAIR_VENDOR"/>
             <xapl:value-of select="$this/IS_VRMA_REQUIRED"/>
             <xapl:value-of select="$this/TRANSFER_ORDERS_BILLABLE"/>
             <xapl:value-of select="$this/TAX_ID"/>
             <xapl:value-of select="$this/TAX_CODE"/>
             <xapl:value-of select="$this/CURRENCY_CODE"/>
             <xapl:value-of select="$this/IS_SINGLE_CORPORATE"/>
             <xapl:value-of select="$status/*"/>
             
          </xcore:execute-method>
          
          <xapl:if test="$this/CUSTOMER_STATUS/@Value = 'ACTIVE'">
            <xcore:execute-method name="//UserSecurity/setOrganizationStatus" entireResponse="true">
              <xapl:value-of select="$this/ID"/>
              <xapl:value-of select="$this/CUSTOMER_STATUS"/>
            </xcore:execute-method>
          </xapl:if>
          
          <xapl:if test="$this/SELLER_STATUS/@Value = 'ACTIVE'">
            <xcore:execute-method name="//UserSecurity/setOrganizationStatus" entireResponse="true">
              <xapl:value-of select="$this/ID"/>
              <xapl:value-of select="$this/SELLER_STATUS"/>
            </xcore:execute-method>
          </xapl:if>
          
        </xapl:otherwise>
      </xapl:choose>
    </xapl:set-variable>
    
    <xapl:if test="string-length($response/RESPONSE/_RESULT/_ERROR/@Value) != 0">      
      <web:display-page>
        <web:get-page name="org_edit">
          <REFRESH Value="true"/>
          <ORG_ID Value="{$this/ORG_ID/@Value}"/>
          <PARENT_ORG_ID  Value="{$this/PARENT_ORG_ID/@Value}"/>
          <ERROR Value="{$response/RESPONSE/_RESULT/_ERROR/@Value}"/>
        </web:get-page>
      </web:display-page> 
    </xapl:if>
    
    <xapl:print>RESPONSE!!!<xapl:value-of select="$response"/></xapl:print>
    
    <xapl:variable name="result">
      <ROOT>
        <xapl:choose>
          <xapl:when test="{$this/IS_NEW/@Value = 'true'}">
            <ORG_ID Value="{$response/RESPONSE/ID/@Value}"/>
            <STATUS_MSG Value="Save Successful."/>
          </xapl:when>
          <xapl:otherwise>
            <ORG_ID Value="{$this/ORG_ID/@Value}"/>
            <STATUS_MSG Value="Save Successful."/>
          </xapl:otherwise>
        </xapl:choose>
     </ROOT>
    </xapl:variable>

    <x2:execute command="omx.add_book.messaging:setMessagingOptions">
      <x2:with-param name="entityType">Org</x2:with-param>
      <x2:with-param name="entityId"><xapl:value-of select="$result/ORG_ID/@Value"/></x2:with-param>
      <x2:with-param name="request"><xapl:value-of select="$this"/></x2:with-param>              
    </x2:execute>
    
    
    <web:display-page>
      <web:get-page name="org_edit">
        <xapl:value-of select="$result/*"/>   
      </web:get-page>
    </web:display-page>
    
  </x2:command>

  <!--************************************************************************--> 
  
  <x2:command public="yes" description="_" name="addEditLocalOrganization">
    
    <!--<docutil:remove select="{$tempForm}"/>-->
    <xapl:set-variable name="tempForm">
      <TEMP_FORM>
        <xapl:value-of select="{$this}"/>
      </TEMP_FORM>
    </xapl:set-variable>
    
    <xapl:variable name="sellingOrg">
      <x2:execute command="omx.add_book.org.model:getUserSellingOrg"/>
    </xapl:variable>

    <xapl:variable name="response">
      <xapl:choose>
        <xapl:when test="{$this/IS_NEW/@Value = 'true'}">
          <docutil:remove select="{$this/ID}"/>
          <xcore:execute-method name="//UserSecurity/addCustomerOrg" entireResponse="true">
            <SELLING_ORG_ID Value="{$sellingOrg}"/>
            <xapl:value-of select="{$this/*}"/>
          </xcore:execute-method>
        </xapl:when>
        <xapl:otherwise>
          <xcore:execute-method name="//UserSecurity/modifyCustomerOrg" entireResponse="true">
            <SELLING_ORG_ID Value="{$sellingOrg}"/>
            <xapl:value-of select="{$this/*}"/>
          </xcore:execute-method>
        </xapl:otherwise>
      </xapl:choose>
    </xapl:variable>
    
    <xapl:if test="string-length($response/RESPONSE/_RESULT/_ERROR/@Value) != 0">      
      
      <web:display-page>
        <web:get-page name="addrbook_view_org">
          <REFRESH_LOCAL Value="true"/>
          <ORG_ID Value="{$this/CUSTOMER_ORG_ID/@Value}"/>
          <ERROR Value="{$response/RESPONSE/_RESULT/_ERROR/@Value}"/>
        </web:get-page>
      </web:display-page>
        
    </xapl:if>
    
    <web:display-page>
      <web:get-page name="addrbook_view_org">
        <ORG_ID Value="{$this/CUSTOMER_ORG_ID/@Value}"/>
      </web:get-page>
    </web:display-page>
  </x2:command>

  <!--************************************************************************--> 
  <!-- JDJ -->

  <x2:command public="yes" description="_" name="addEditLocalSellerOrganization">

    <xapl:variable name="custOrg">
      <x2:execute command="omx.add_book.org.model:getUserCustomerOrg"/>
    </xapl:variable>

    <xcore:execute-method name="//UserSecurity/enableSellerOrganization">
      <CUSTOMER_ORG_ID Value="{$custOrg}"/>
      <SELLING_ORG_ID   Value="{$this/SELLER_ORG_ID/@Value}"/>
    </xcore:execute-method>
    
    <web:display-page>
      <web:get-page name="addrbook_view_org">
        <ORG_ID Value="{$this/SELLER_ORG_ID/@Value}"/>
      </web:get-page>
    </web:display-page>
  </x2:command>

  <!--************************************************************************--> 
  
  <x2:command public="yes" description="_" name="refreshOrg">

    <xapl:print>this in refresh<xapl:value-of select="$this"/></xapl:print>
    
    <xapl:set-variable name="tempForm">
      <TEMP_FORM>
        <xapl:value-of select="$this/*"/>
      </TEMP_FORM>
    </xapl:set-variable>
    
    <web:display-page>
      <web:get-page name="addrbook_view_org">
        <REFRESH Value="true"/>
        <xapl:if test="string-length($this/ID/@Value) &gt; 0">
          <ORG_ID Value="{$this/ID/@Value}"/>
        </xapl:if>
        <xapl:if test="string-length($this/PARENT_ORG_ID/@Value) &gt;  0">
          <xapl:value-of select="{$this/PARENT_ORG_ID}"/>
        </xapl:if>
      </web:get-page>
    </web:display-page>
    
  </x2:command>

  <!--************************************************************************--> 
  
  <x2:command public="yes" description="_" name="getOrganizationTabs">
    <x2:param name="page" select="$this/PAGE/@Value" />
    <x2:param name="orgId" select="$this/ORG_ID/@Value" />
    
    <xapl:variable name="fein">
      <xcore:execute-method name="//UserSecurity/getOrganization">
        <ID Value="{$orgId}"/>
      </xcore:execute-method>
    </xapl:variable>
    
    <xapl:variable name="pages">
      <TAB_INFO>
        <HELP>
          <xapl:variable name="Value">
            <xapl:choose>
              <xapl:when test="{$page = 'details'}">
                <web:get-page name="add_book_orgdetails_help"/>
              </xapl:when>
              <xapl:when test="{$page = 'tree_view'}">
                <web:get-page name="add_book_orgdetails_help"/>
              </xapl:when>
              <xapl:when test="{$page = 'customer'}">
                <web:get-page name="add_book_orgdetails_help"/>
              </xapl:when>
              <xapl:when test="{$page = 'terms'}">
                <web:get-page name="add_book_terms_help"/>
              </xapl:when>
              <xapl:when test="{$page = 'contacts'}">
                <web:get-page name="add_book_contacts_help"/>
              </xapl:when>
              <xapl:when test="{$page = 'nexus'}">
                <web:get-page name="add_book_nexus_help"/>
              </xapl:when>
              <xapl:when test="{$page = 'children'}">
                <web:get-page name="add_book_childorg_help"/>
              </xapl:when>
              <xapl:when test="{$page = 'seller'}">
                <web:get-page name="add_book_sellerentity_help"/>
              </xapl:when>
              <xapl:when test="{$page = 'buying_limits'}">
                <web:get-page name="add_book_buying_limits_help"/>
              </xapl:when>
              <xapl:otherwise>                
                <web:get-page name="add_book_details_help"/>
              </xapl:otherwise>
            </xapl:choose>
          </xapl:variable>
          <URL Value="{$Value}"/>
        </HELP>
        
        <xapl:choose>
          
          <xapl:when test="{(string-length($orgId) = 0) or ($orgId = 'null')}">
            <NAV_PAGE>
              <DISPLAY_TEXT Value="Details"/>
              <URL Value="javascript:void(0)"/>
              <SELECTED Value="true"/>
            </NAV_PAGE>
          </xapl:when>
          
          <xapl:otherwise>
            <xapl:variable name="organization">
              <xcore:execute-method name="//UserSecurity/getOrganization">
                <ID Value="{$orgId}"/>
              </xcore:execute-method>
            </xapl:variable>
						
						<xapl:print><xapl:value-of select="$organization"/></xapl:print>
            
            <NAV_PAGE>
              <DISPLAY_TEXT Value="Organization Details"/>
              <xapl:variable name="Value" />
              <xapl:set-variable name="Value">
                <web:get-page name="addrbook_view_org">
                     <ORG_ID Value="{$orgId}"/>
                  <CUSTOMER_ORG_ID Value="{$orgId}"/>
                </web:get-page>   
              </xapl:set-variable>
              <URL Value="{$Value}"/>
              <SELECTED Value="{$page = 'details'}"/>
            </NAV_PAGE>
            
            <NAV_PAGE>
              <DISPLAY_TEXT Value="Organization View"/>
              <xapl:variable name="Value">
                <web:get-page name="org_tree_view">
                  <ORG_ID Value="{$orgId}"/>
                  <CUSTOMER_ORG_ID Value="{$orgId}"/>
                </web:get-page>
              </xapl:variable>
              <URL Value="{$Value}"/>
              <SELECTED Value="{$page = 'tree_view'}"/>
            </NAV_PAGE>
            
            <xapl:if test="($organization/SELLER_STATUS/@Value != 'NONE') and ($organization/SELLER_STATUS/@Value != 'DORMANT') and ($organization/SELLER_STATUS/@Value != 'INACTIVE') ">
              <NAV_PAGE>
                <DISPLAY_TEXT Value="Terms"/>
                <xapl:variable name="Value">
                  <web:get-page name="org_terms">
                    <ORG_ID Value="{$orgId}"/>
                  </web:get-page>
                </xapl:variable>
                <URL Value="{$Value}"/>
                <SELECTED Value="{$page = 'terms'}"/>
              </NAV_PAGE>
            </xapl:if>
            
            <NAV_PAGE>
              <DISPLAY_TEXT Value="Contacts"/>
              <xapl:variable name="Value">
                <web:get-page name="org_contacts">
                  <ORG_ID Value="{$orgId}"/>
                </web:get-page>
              </xapl:variable>
              <URL Value="{$Value}"/>
              <SELECTED Value="{$page = 'contacts'}"/>
            </NAV_PAGE>
            
            <xapl:if test="(string-length($fein/TAX_ID/@Value) != 0) and ($fein/COUNTRY/@Value='USA') and ($organization/SELLER_STATUS/@Value != 'NONE') and ($organization/SELLER_STATUS/@Value != 'DORMANT') and ($organization/SELLER_STATUS/@Value != 'INACTIVE')">
              
              <NAV_PAGE>
                <DISPLAY_TEXT Value="Nexus"/>
                <xapl:variable name="Value">
                    <web:get-page name="org_nexus">
                    <ORG_ID Value="{$orgId}"/>
                  </web:get-page>
                </xapl:variable>
                <URL Value="{$Value}"/>
                <SELECTED Value="{$page = 'nexus'}"/>
              </NAV_PAGE>
            </xapl:if>
          </xapl:otherwise>
        </xapl:choose>
      </TAB_INFO>
    </xapl:variable>

    <xapl:return>
      <xapl:value-of select="{$pages}" />
    </xapl:return>
    
  </x2:command>
  
   <!--************************************************************************--> 
  
  <x2:command public="yes" description="_" name="getOrgSharing">
    
    <xapl:variable name="shared">
      <SHARED>
        <xcore:execute-method name="//UserSecurity/getOrgsInSharingMap">
          <SOURCE_ORG_ID Value="{ORG_ID/@Value}"/>
        </xcore:execute-method>
      </SHARED>
      </xapl:variable>
    
    <xapl:if test="{count( $shared/TARGET_ORG_ID ) &gt; 0}">
	  <xapl:variable name="orgs">
	    <xcore:execute-method name="//UserSecurity/getOrganizations">
	      <FILTER Name="ID">
		    <OR>
		      <xapl:for-each varName="target" select="{$shared/TARGET_ORG_ID}">
                <xcore:search-by property="ID" value="{$target/@Value}" matchby="EQUAL"/>
              </xapl:for-each>
			</OR>
	      </FILTER>
		</xcore:execute-method>
	  </xapl:variable>
      <xapl:variable name="sharedOrgs" enforceList="true">
	    <xapl:value-of select="{$orgs/*}"/>
      </xapl:variable>
      
    </xapl:if>
    
    <xapl:return>
      <SHARED>
        <ORG_ID Value="{ORG_ID/@Value}"/>

        <perm:is-allowed document="ORGANIZATION" action="edit_global">
        	<EDITABLE Value="true"/>
        </perm:is-allowed>
        
        <xapl:value-of select="{$sharedOrgs}"/>
        <xapl:if test="{(count($this/SEARCH_PARAM) != 0) and (SEARCH_PARAM/@Value != '')}">
		  <xapl:variable name="sorgs">
		    <xcore:execute-method name="//UserSecurity/getOrganizations">
			  <FILTER Name="FULL_NAME">
			    <xcore:search-by property="FULL_NAME" value="{SEARCH_PARAM/@Value}" matchby="EQUAL"/>
			  </FILTER>
			  <FILTER Name="ID">
			    <xcore:search-by property="ID" value="{ORG_ID/@Value}" matchby="NOT_EQUAL"/>
			  </FILTER>
			</xcore:execute-method>
		  </xapl:variable>
		  
          <SEARCH_RESULTS>
		    <xapl:value-of select="{$sorgs/*}"/>
          </SEARCH_RESULTS>
        </xapl:if>
      </SHARED>
    </xapl:return>
    
  </x2:command>

  <!--************************************************************************--> 
  
  <x2:command public="yes" description="_" name="cancelSharedOrg">
    
    <web:display-page>
      <web:get-page name="sharing_orgs">
        <ORG_ID Value="{$this/SOURCE_ORG_ID/@Value}"/>
      </web:get-page>
    </web:display-page>
    
  </x2:command>
  

  <!--************************************************************************--> 
  
  <x2:command public="yes" description="_" name="addSharedOrg">
    
	<xapl:variable name="targetOrgIds">
	  <xapl:for-each varName="tOrgId" select="{$this/ID}">
	    <TARGET_ORG_ID Value="{$tOrgId/@Value}"/>
	  </xapl:for-each>
	</xapl:variable>
    <xcore:execute-method name="//UserSecurity/addOrgsToSharingMap">
      <SOURCE_ORG_ID Value="{$this/SOURCE_ORG_ID/@Value}"/>
	  <xapl:value-of select="{$targetOrgIds}"/>
    </xcore:execute-method>
    <web:display-page>
      <web:get-page name="sharing_orgs">
        <ORG_ID Value="{$this/SOURCE_ORG_ID/@Value}"/>
      </web:get-page>
    </web:display-page>
    
  </x2:command>
  
  <!--************************************************************************--> 
  
  <x2:command public="yes" description="_" name="searchSharedOrg">
    
    <web:display-page>
      <web:get-page name="org_sharing_search">
	    <ORG_ID Value="{$this/SOURCE_ORG_ID/@Value}"/>
		<IS_SHARING_SEARCH Value ="TRUE"/>
      </web:get-page>
    </web:display-page>
    
  </x2:command>

  <!--************************************************************************--> 
  
  <x2:command public="yes" description="_" name="removeSharedOrg">
  
    <xcore:execute-method name="//UserSecurity/removeOrgsFromSharingMap">
      <xapl:value-of select="{$this/*}"/>
    </xcore:execute-method>
    <web:display-page>
      <web:get-page name="sharing_orgs">
        <ORG_ID Value="{$this/SOURCE_ORG_ID/@Value}"/>
      </web:get-page>
    </web:display-page>
    
  </x2:command>

  <!--************************************************************************--> 

  <x2:command public="yes" description="_" name="saveBuyingLimits">
    
    <xapl:variable name="sellingOrg">
      <x2:execute command="omx.add_book.org.model:getUserSellingOrg"/>
    </xapl:variable>

    <xapl:variable name="limits">
      <docutil:collate name="LIMITS">
        <xapl:value-of select="{$this/PM_PAYMENT_INST_TYPE}"/>
        <xapl:value-of select="{$this/PM_TRANSACTION_BUYING_LIMIT}"/>
        <xapl:value-of select="{$this/PM_TRANSACTION_BUYING_LIMIT_STATUS}"/>
        <xapl:value-of select="{$this/PM_PERIODIC_BUYING_LIMIT}"/>
        <xapl:value-of select="{$this/PM_PERIODIC_BUYING_LIMIT_STATUS}"/>
        <xapl:value-of select="{$this/PM_PERIODIC_BUYING_LIMIT_DURATION}"/>
        <xapl:value-of select="{$this/PM_PERIODIC_BUYING_LIMIT_START_DATE}"/>
      </docutil:collate>
    </xapl:variable>

    <!-- save the buying limits for the organization -->
    <xapl:variable name="response">
      <xcore:execute-method name="//UserSecurity/setOrgBuyingLimit" entireResponse="true">
        <CUSTOMER_ORG_ID Value="{$this/ORG_ID/@Value}"/>
        <SELLING_ORG_ID Value="{$sellingOrg}"/>
        <xapl:value-of select="{$this/TRANSACTION_BUYING_LIMIT}"/>
        <xapl:value-of select="{$this/TRANSACTION_BUYING_LIMIT_STATUS}"/>
        <xapl:value-of select="{$this/PERIODIC_BUYING_LIMIT}"/>
        <xapl:value-of select="{$this/PERIODIC_BUYING_LIMIT_STATUS}"/>
        <xapl:value-of select="{$this/PERIODIC_BUYING_LIMIT_DURATION}"/>
        <xapl:value-of select="{$this/PERIODIC_BUYING_LIMIT_START_DATE}"/>
      </xcore:execute-method>
    </xapl:variable>

    <xapl:if test="string-length($response/RESPONSE/_RESULT/_ERROR/@Value) != 0">
      <web:display-page>
        <web:get-page name="org_buying_limits">
          <ORG_ID Value="{$this/ORG_ID/@Value}"/>
          <ERROR_MESSAGE Value="{$response/RESPONSE/_RESULT/_ERROR/@Value}"/>
        </web:get-page>
      </web:display-page>
    </xapl:if>

    <!-- save the buying limits for the payment methods -->
    <xapl:for-each varName="limit" select="{$limits/LIMITS}">
      <!-- check to see if we need to do a add or modify -->
      <xapl:variable name="getResponse">
        <xcore:execute-method name="//UserSecurity/getPaymentMethodBuyingLimit" entireResponse="true">
          <CUSTOMER_ORG_ID Value="{$this/ORG_ID/@Value}"/>
          <SELLING_ORG_ID Value="{$sellingOrg}"/>
          <PAYMENT_INST_TYPE Value="{$limit/PM_PAYMENT_INST_TYPE/@Value}"/>
        </xcore:execute-method>
      </xapl:variable>

      <xapl:set-variable name="response">
        <xapl:choose>
          <xapl:when test="$getResponse/RESPONSE/@Status != 'Success'">
            <!-- add -->
            <xcore:execute-method name="//UserSecurity/addPaymentMethodBuyingLimit" entireResponse="true">
              <CUSTOMER_ORG_ID Value="{$this/ORG_ID/@Value}"/>
              <SELLING_ORG_ID Value="{$sellingOrg}"/>
              <PAYMENT_INST_TYPE Value="{$limit/PM_PAYMENT_INST_TYPE/@Value}"/>
              <TRANSACTION_BUYING_LIMIT Value="{$limit/PM_TRANSACTION_BUYING_LIMIT/@Value}"/>
              <TRANSACTION_BUYING_LIMIT_STATUS Value="{$limit/PM_TRANSACTION_BUYING_LIMIT_STATUS/@Value}"/>
              <PERIODIC_BUYING_LIMIT Value="{$limit/PM_PERIODIC_BUYING_LIMIT/@Value}"/>
              <PERIODIC_BUYING_LIMIT_STATUS Value="{$limit/PM_PERIODIC_BUYING_LIMIT_STATUS/@Value}"/>
              <PERIODIC_BUYING_LIMIT_DURATION Value="{$limit/PM_PERIODIC_BUYING_LIMIT_DURATION/@Value}"/>
              <PERIODIC_BUYING_LIMIT_START_DATE Value="{$limit/PM_PERIODIC_BUYING_LIMIT_START_DATE/@Value}"/>
            </xcore:execute-method>
          </xapl:when>
          <xapl:otherwise>
            <!-- modify -->
            <xcore:execute-method name="//UserSecurity/modifyPaymentMethodBuyingLimit" entireResponse="true">
              <CUSTOMER_ORG_ID Value="{$this/ORG_ID/@Value}"/>
              <SELLING_ORG_ID Value="{$sellingOrg}"/>
              <PAYMENT_INST_TYPE Value="{$limit/PM_PAYMENT_INST_TYPE/@Value}"/>
              <TRANSACTION_BUYING_LIMIT Value="{$limit/PM_TRANSACTION_BUYING_LIMIT/@Value}"/>
              <TRANSACTION_BUYING_LIMIT_STATUS Value="{$limit/PM_TRANSACTION_BUYING_LIMIT_STATUS/@Value}"/>
              <PERIODIC_BUYING_LIMIT Value="{$limit/PM_PERIODIC_BUYING_LIMIT/@Value}"/>
              <PERIODIC_BUYING_LIMIT_STATUS Value="{$limit/PM_PERIODIC_BUYING_LIMIT_STATUS/@Value}"/>
              <PERIODIC_BUYING_LIMIT_DURATION Value="{$limit/PM_PERIODIC_BUYING_LIMIT_DURATION/@Value}"/>
              <PERIODIC_BUYING_LIMIT_START_DATE Value="{$limit/PM_PERIODIC_BUYING_LIMIT_START_DATE/@Value}"/>
            </xcore:execute-method>
          </xapl:otherwise>
        </xapl:choose>
      </xapl:set-variable>

      <xapl:if test="string-length($response/RESPONSE/_RESULT/_ERROR/@Value) != 0">
        <web:display-page>
          <web:get-page name="org_buying_limits">
            <ORG_ID Value="{$this/ORG_ID/@Value}"/>
            <ERROR_MESSAGE Value="{$response/RESPONSE/_RESULT/_ERROR/@Value}"/>
          </web:get-page>
        </web:display-page>
      </xapl:if>
    </xapl:for-each>

    <web:display-page>
      <web:get-page name="org_buying_limits">
        <ORG_ID Value="{$this/ORG_ID/@Value}"/>
        <SUCCESS_MESSAGE Value="Update Successful."/>
      </web:get-page>
    </web:display-page>
    
  </x2:command>

  <!--************************************************************************--> 

</x2:commands>
