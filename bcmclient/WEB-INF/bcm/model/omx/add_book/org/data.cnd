<?xml version="1.0" encoding="UTF-8"?>
<x2:commands description="_" 
             xmlns:FUNCTION="http://www.i2.com/FUNCTION" 
             xmlns:REMOVE="http://www.i2.com/REMOVE" 
             xmlns:cfg="http://www.i2.com/configurability" 
             xmlns:core="http://www.i2.com/core" 
             xmlns:omx="http://www.i2.com/omx" 
             xmlns:perm="http://www.i2.com/permissibility" 
             xmlns:util="http://www.i2.com/util" 
             xmlns:web="http://www.i2.com/web" 
             xmlns:x2="http://www.i2.com/x2" 
             xmlns:xapl="http://www.i2.com/xapl" 
             xmlns:xcore="http://www.i2.com/xcore" 
             xmlns:xcore-db="http://www.i2.com/xcore-db" 
             xmlns:docutil="http://www.i2.com/docutil" 
             xmlns:xudl="http://www.i2.com/xudl"
             xmlns:identity="http://www.i2.com/identity">
						   
  
  <!--************************************************************************-->   
  
  <x2:command public="yes" description="_" name="createOrganization">
    
    <xapl:variable name="orgId">
      <FUNCTION:create-unique-id name="custorg"/>
    </xapl:variable>
    <xcore:execute-method name="//UserSecurity/addCustomerOrg">
      <xapl:value-of select="{$this/ORG_NAME}"/>
      <ORG_ID Value="{$orgId}"/>
    </xcore:execute-method>
    <omx:touch userId="{$identity/USER_ID/@Value}">
      <CUSTOMER_ORGANIZATION id="{$orgId}"/>
    </omx:touch>
    <web:display-page>
      <web:get-page name="addrbook_home"/>
    </web:display-page>
    
  </x2:command>
  
  <!--************************************************************************--> 
  
  <x2:command public="yes" description="_" name="getOrganizations">
    <x2:param name="pOrgSearchCriteria"/>
    <x2:param name="pCustOrgId"/>
    
    <xapl:variable name="orgs">
      <xapl:choose>
        <xapl:when test="{(string-length($pCustOrgId) = 0) and (string-length($pOrgSearchCriteria) = 0)}">
          <xapl:variable name="recentOrgs">
            <omx:get-recent userId="{identity-user-id()}" max="7">
              <CUSTOMER_ORGANIZATION/>
            </omx:get-recent>
          </xapl:variable>
          <xapl:choose>
            <xapl:when test="{count($recentOrgs) != 0}">
  		    <xcore:execute-method name="//UserSecurity/getOrganizations">
  			  <FILTER Name="ID">
  			    <OR>
  				  <xapl:for-each varName="orgId" select="$recentOrgs/ID/@Value">
                      <xcore:search-by property="ID" value="{$orgId}"/>
                    </xapl:for-each>
  				</OR>
  			  </FILTER>
  			</xcore:execute-method>
            </xapl:when>
            <xapl:otherwise>
              <ORGANIZATIONS/>
            </xapl:otherwise>
          </xapl:choose>
        </xapl:when>
        <xapl:otherwise>
          <xcore:execute-method name="//UserSecurity/getOrganizations">
            <xapl:if test="{string-length($pOrgSearchCriteria) != 0}">
              <FILTER Name="FULL_NAME">
                <xcore:search-by property="FULL_NAME" value="{$pOrgSearchCriteria}"/>
              </FILTER>
            </xapl:if>
            <xapl:if test="{string-length($pCustOrgId) != 0}">
              <FILTER Name="ID">
                <ID Value="{$pCustOrgId}"/>
              </FILTER>
            </xapl:if>
          </xcore:execute-method>
          <!--xapl:value-of select="{$orgns/RESPONSE/ORGANIZATIONS/*}"/-->
        </xapl:otherwise>
      </xapl:choose>
    </xapl:variable>
    
    <perm:is-allowed document="ORGANIZATION" action="add">      
      <docutil:add select="{$orgs}">
        <EDITABLE Value="true"/>
      </docutil:add>
    </perm:is-allowed>
    
    <xapl:return>
      <xapl:value-of select="{$orgs}"/>
    </xapl:return>
    
  </x2:command>

  <!--************************************************************************--> 
  
  <x2:command public="yes" description="_" name="getChildOrgs">
    
	<xapl:variable name="orgs">
	  <xcore:execute-method name="//UserSecurity/getOrganizations">
	    <FILTER Name="PARENT_ORG_ID">
		  <xcore:search-by property="PARENT_ORG_ID" value="{$this/ORG_ID/@Value}" matchby="EQUAL"/>
		</FILTER>
	  </xcore:execute-method>
	</xapl:variable>
    <xapl:return>
      <CHILD_ORGS>
			
        <perm:is-allowed document="ORGANIZATION" action="add">
        	<EDITABLE Value="true"/>
        </perm:is-allowed>
        
        <ORG_ID Value="{$this/ORG_ID/@Value}"/>
		<xapl:value-of select="{$orgs/*}"/>
      </CHILD_ORGS>
    </xapl:return>
    
  </x2:command>

  <!--************************************************************************--> 
  
  <x2:command public="yes" description="_" name="removeCustomer">
    
    <xcore:execute-method name="//UserSecurity/setOrganizationStatus">
      <ID Value="{$this/ORG_ID/@Value}"/>
      <CUSTOMER_STATUS Value="DORMANT"/>
    </xcore:execute-method>
    
    <web:display-page>
      <web:get-page name="addrbook_view_org">
        <xapl:value-of select="{$this/ORG_ID}"/>
        <xapl:value-of select="{$this/PARENT_ORG_ID}"/>
      </web:get-page>
    </web:display-page>
    
  </x2:command>

  <!--************************************************************************--> 
  
  <x2:command public="yes" description="_" name="activateCustomer">
    
    <xapl:print>This in actiCUST<xapl:value-of select="$this"/></xapl:print>
    
    <xcore:execute-method name="//UserSecurity/setOrganizationStatus">
      <ID Value="{$this/ORG_ID/@Value}"/>
      <CUSTOMER_STATUS Value="ACTIVE"/>
    </xcore:execute-method>
    <web:display-page>
      <web:get-page name="addrbook_view_org">
        <xapl:value-of select="{$this/ORG_ID}"/>
        <xapl:value-of select="{$this/PARENT_ORG_ID}"/>
      </web:get-page>
    </web:display-page>

  </x2:command>

  <!--************************************************************************--> 
  
  <x2:command public="yes" description="_" name="removeSeller">
    
    <xcore:execute-method name="//UserSecurity/setOrganizationStatus">
      <ID Value="{$this/ORG_ID/@Value}"/>
      <SELLER_STATUS Value="DORMANT"/>
    </xcore:execute-method>
    <web:display-page>
      <web:get-page name="addrbook_view_org">
        <xapl:value-of select="{$this/ORG_ID}"/>
        <xapl:value-of select="{$this/PARENT_ORG_ID}"/>
      </web:get-page>
    </web:display-page>
    
  </x2:command>

  <!--************************************************************************--> 
  
  <x2:command public="yes" description="_" name="activateSeller">
    
    <xcore:execute-method name="//UserSecurity/setOrganizationStatus">
      <ID Value="{$this/ORG_ID/@Value}"/>
      <SELLER_STATUS Value="ACTIVE"/>
    </xcore:execute-method>
    <web:display-page>
      <web:get-page name="addrbook_view_org">
        <xapl:value-of select="{$this/ORG_ID}"/>
        <xapl:value-of select="{$this/PARENT_ORG_ID}"/>
      </web:get-page>
    </web:display-page>
    
  </x2:command>
  
  <!--************************************************************************--> 
  
  <x2:command public="yes" description="_" name="removeLocalCustomer">
    
	<xapl:variable name="sellingOrg">
      <x2:execute command="omx.add_book.org.model:getUserSellingOrg"/>
    </xapl:variable>
	
    <xcore:execute-method name="//UserSecurity/setEnabledOrganizationStatus">
      <ID Value="{$this/ID/@Value}"/>
      <CUSTOMER_ORG_ID Value="{$this/CUSTOMER_ORG_ID/@Value}"/>
      <SELLING_ORG_ID Value="{$sellingOrg}"/>
      <STATUS Value="DORMANT"/>
    </xcore:execute-method>
    <web:display-page>
      <web:get-page name="addrbook_view_org">
        <ORG_ID Value="{$this/CUSTOMER_ORG_ID/@Value}"/>
        <CUSTOMER_ORG_ID Value="{$this/CUSTOMER_ORG_ID/@Value}"/>
      </web:get-page>
    </web:display-page>
    
  </x2:command>

  <!--************************************************************************--> 
  <!-- JDJ -->
  
  <x2:command public="yes" description="_" name="removeLocalSeller">
    
    <xapl:variable name="custOrg">
      <x2:execute command="omx.add_book.org.model:getUserCustomerOrg"/>
    </xapl:variable>

    <xcore:execute-method name="//UserSecurity/setEnabledSellingOrganizationStatus">
      <CUSTOMER_ORG_ID Value="{$custOrg}"/>
      <SELLING_ORG_ID Value="{$this/SELLER_ORG_ID/@Value}"/>
      <STATUS Value="DORMANT"/>
    </xcore:execute-method>

    <xapl:print>
      SELLER_ORG_ID = 
      <xapl:value-of select="$this/SELLER_ORG_ID/@Value"/>
    </xapl:print>

    <web:display-page>
      <web:get-page name="addrbook_view_org">
        <ORG_ID Value="{$this/SELLER_ORG_ID/@Value}"/>
        <CUSTOMER_ORG_ID Value="{$this/SELLER_ORG_ID/@Value}"/>
      </web:get-page>
    </web:display-page>
    
  </x2:command>
  
  <!--************************************************************************--> 
  
