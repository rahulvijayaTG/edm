<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
    <xapl:variable name="entity">
      <x2:execute command="omx.add_book.org.model:getOrganization">
        <x2:with-param name="orgId" select="{$this/ORG_ID/@Value}"/>
      </x2:execute>
    </xapl:variable>
    <xapl:print select="$entity"/>
    <xapl:variable name="segmentEntity">
      <x2:execute command="omx.add_book.org.edit.account_code.model:getSegmentTableWithValuesUrl">
        <x2:with-param name="orgId" select="$this/ORG_ID/@Value"/>
      </x2:execute>
    </xapl:variable>
    <xapl:print select="$segmentEntity"/>
    <xapl:return>
      <!-- Header -->
      <x2:execute command="omx.add_book.org.edit.account_code.segment.view:getHeader"/>
      <!-- Tabs Container -->
      <x2:execute command="omx.add_book.org.edit.account_code.segment.view:getContainer">
        <x2:with-param name="pPage" select="'org_account_code_segment'"/>
        <x2:with-param name="pEntity" select="{$entity}"/>
        <x2:with-param name="pSegmentEntity" select="{$segmentEntity}"/>
      </x2:execute>
      <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
      <!--  The Page Data...                                           -->
      <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
      <PAGE>
        <ORG_ID Value="{$this/ORG_ID/@Value}"/>
        <PRIMARY_DOMAIN Value="{$s_inPrimaryDomain}"/>
        <xapl:value-of select="$segmentEntity"/>
      </PAGE>
      <!-- Status/Error Messages -->
      <x2:execute command="omx.alert:getAlerts">
        <x2:with-param name="pRefresh">
          <xapl:value-of select="$this/REFRESH/@Value"/>
        </x2:with-param>
        <x2:with-param name="pERROR">
          <xapl:value-of select="$this/ERROR/@Value"/>
        </x2:with-param>
        <x2:with-param name="pStatusMsg">
          <xapl:value-of select="$this/SUCCESS_MESSAGE/@Value"/>
        </x2:with-param>
      </x2:execute>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    <xapl:variable name="orgHeader" enforceList="true">
      <x2:execute command="omx.add_book.org.view:getHeader">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
    </xapl:variable>
    <xapl:variable name="orgPage">
      <web:get-page name="org_overview">
        <ORG_ID Value="{$addBookCurrOrgId/@Value}"/>
        <CUSTOMER_ORG_ID Value="{$addBookCurrOrgId/@Value}"/>
        <IN_PRIMARY_DOMAIN Value="{$s_inPrimaryDomain}"/>
      </web:get-page>
    </xapl:variable>
    <xapl:return>
      <HEADER>
        <HEADING3 Value="Account Code"/>
        <HEADING2_LINK Value="{$orgPage}"/>
        <xapl:value-of select="$orgHeader/*"/>
      </HEADER>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <x2:param name="pPage"/>
    <x2:param name="pEntity"/>
    <x2:param name="pSegmentEntity"/>
    <xapl:return>
      <CONTAINER>
        <HELP Url="../../../../help/account_codes_edit.html"/>
        <STEP DisplayText="Account Codes" OnClick="{$pages:org_account_code_segment}" Selected="{$pPage = 'org_account_code_segment'}">
          <BUTTONS>
            <xapl:if test="$s_inPrimaryDomain='true'">
              <xapl:if test="count($pSegmentEntity/SEGMENT) > 0">
                <BUTTON Name="update" DisplayText="Update" OnClick="javascript:onUpdate()" Emphasized="no"/>
              </xapl:if>
              <BUTTON Name="add" DisplayText="Add" OnClick="javascript:saveAsNew()" Emphasized="no"/>
            </xapl:if>
          </BUTTONS>
        </STEP>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
</x2:commands>
