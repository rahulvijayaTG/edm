<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
    
	<xapl:variable name="entity">
	  <x2:execute command="omx.add_book.org.model:getOrganization">
        <x2:with-param name="pRefresh" select="$this/REFRESH/@Value"/>               
        <x2:with-param name="orgId" select="{$this/ORG_ID/@Value}"/>
      </x2:execute>
	</xapl:variable>
    
	<xapl:variable name="sellingOrg">
      <x2:execute command="omx.add_book.org.model:getUserSellingOrg"/>
    </xapl:variable>
	
	<xapl:variable name="paymentMethods">
      <ROOT>
        <xcore:execute-method name="//UserSecurity/getPaymentMethods"/>
      </ROOT>
    </xapl:variable>
    
	<xapl:variable name="data">
      <!-- get the currency code for the order point -->
      <CURRENCY_CODE Value="{$entity/CURRENCY_CODE/@Value}"/>
	  
      <!-- get the list of periods -->
      <PERIODS>
        <xcore:execute-method name="//UserSecurity/getBuyingLimitDurations"/>
      </PERIODS>
	  
      <!-- get the buying limits for the organization -->
      <xcore:execute-method name="//UserSecurity/getOrgBuyingLimit">
        <CUSTOMER_ORG_ID Value="{$this/ORG_ID/@Value}"/>
        <SELLING_ORG_ID Value="{$sellingOrg}"/>
      </xcore:execute-method>
	  
	  <!-- get the buying limits for the payment methods -->
      <PAYMENT_METHODS>
        <xapl:for-each varName="pm" select="{$paymentMethods/CODE_MASTER_VALUE}">
          <PAYMENT_METHOD>
            <PAYMENT_INST_TYPE Value="{$pm/VALUE_ID/@Value}"/>
            <PAYMENT_INST_DESCRIPTION Value="{$pm/DESCRIPTION/@Value}"/>
            <xcore:execute-method name="//UserSecurity/getPaymentMethodBuyingLimit">
              <CUSTOMER_ORG_ID Value="{$this/ORG_ID/@Value}"/>
              <SELLING_ORG_ID Value="{$sellingOrg}"/>
              <PAYMENT_INST_TYPE Value="{$pm/VALUE_ID/@Value}"/>
            </xcore:execute-method>
          </PAYMENT_METHOD>
        </xapl:for-each>
      </PAYMENT_METHODS>
      <xapl:value-of select="{$this/SUCCESS_MESSAGE}"/>
      <xapl:value-of select="{$this/ERROR_MESSAGE}"/>
    </xapl:variable>
	
    <xapl:print select="$entity"/>
	
    <xapl:return>
      <!-- Header -->
      <x2:execute command="omx.add_book.org.view:getHeader">
	    <x2:with-param name="this" select="$this"/>
	  </x2:execute>
      
      <!-- Container -->
      <x2:execute command="omx.add_book.org.edit.view:getContainer">
        <x2:with-param name="pPage" select="'org_buying_limits'"/>
        <x2:with-param name="pHide" select="$this/TABS_HIDE/@Value"/>
        <x2:with-param name="pReturnLink" select="$this/RET_PAGE/@Value"/>
		<x2:with-param name="pEntity" select="{$entity}"/>
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
      
      <xapl:value-of select="$data"/>
	  
	  <xapl:value-of select="{$this/ORG_ID}"/>
      
	  <!-- Status/Error Messages -->
      <x2:execute command="omx.alert:getAlerts">
        <x2:with-param name="pRefresh"><xapl:value-of select="$this/REFRESH/@Value"/></x2:with-param>
        <x2:with-param name="pERROR"><xapl:value-of select="$this/ERROR/@Value"/></x2:with-param>
        <x2:with-param name="pStatusMsg"><xapl:value-of select="$this/SUCCESS_MESSAGE/@Value"/></x2:with-param>
      </x2:execute>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
</x2:commands>
