<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="save">
    <xapl:variable name="sellingOrg">
      <x2:execute command="omx.add_book.org.model:getUserSellingOrg"/>
    </xapl:variable>
    <xapl:variable name="limits">
      <docutil:collate name="LIMITS">
        <xapl:value-of select="{$this/PM_PAYMENT_INST_TYPE}"/>
        <xapl:value-of select="{$this/PM_TRANSACTION_BUYING_LIMIT}"/>
        <xapl:value-of select="{$this/PM_TRANSACTION_BUYING_LIMIT_STATUS}"/>
        <xapl:value-of select="{$this/PM_PERIODIC_BUYING_LIMIT}"/>
        <xapl:value-of select="{$this/PM_PERIODIC_BUYING_LIMIT_STATUS}"/>
        <xapl:value-of select="{$this/PM_PERIODIC_BUYING_LIMIT_DURATION}"/>
        <xapl:value-of select="{$this/PM_PERIODIC_BUYING_LIMIT_START_DATE}"/>
      </docutil:collate>
    </xapl:variable>
    <!-- save the buying limits for the organization -->
    <xapl:variable name="response">
      <xcore:execute-method name="//UserSecurity/setOrgBuyingLimit" entireResponse="true">
        <CUSTOMER_ORG_ID Value="{$this/ORG_ID/@Value}"/>
        <SELLING_ORG_ID Value="{$sellingOrg}"/>
        <xapl:value-of select="{$this/TRANSACTION_BUYING_LIMIT}"/>
        <xapl:value-of select="{$this/TRANSACTION_BUYING_LIMIT_STATUS}"/>
        <xapl:value-of select="{$this/PERIODIC_BUYING_LIMIT}"/>
        <xapl:value-of select="{$this/PERIODIC_BUYING_LIMIT_STATUS}"/>
        <xapl:value-of select="{$this/PERIODIC_BUYING_LIMIT_DURATION}"/>
        <xapl:value-of select="{$this/PERIODIC_BUYING_LIMIT_START_DATE}"/>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:if test="string-length($response/RESPONSE/_RESULT/_ERROR/@Value) != 0">
      <web:display-page>
        <web:get-page name="org_buying_limits">
          <ORG_ID Value="{$this/ORG_ID/@Value}"/>
          <ERROR_MESSAGE Value="{$response/RESPONSE/_RESULT/_ERROR/@Value}"/>
        </web:get-page>
      </web:display-page>
    </xapl:if>
    <!-- save the buying limits for the payment methods -->
    <xapl:for-each varName="limit" select="{$limits/LIMITS}">
      <!-- check to see if we need to do a add or modify -->
      <xapl:variable name="getResponse">
        <xcore:execute-method name="//UserSecurity/getPaymentMethodBuyingLimit" entireResponse="true">
          <CUSTOMER_ORG_ID Value="{$this/ORG_ID/@Value}"/>
          <SELLING_ORG_ID Value="{$sellingOrg}"/>
          <PAYMENT_INST_TYPE Value="{$limit/PM_PAYMENT_INST_TYPE/@Value}"/>
        </xcore:execute-method>
      </xapl:variable>
      <xapl:set-variable name="response">
        <xapl:choose>
          <xapl:when test="$getResponse/RESPONSE/@Status != 'Success'">
            <!-- add -->
            <xcore:execute-method name="//UserSecurity/addPaymentMethodBuyingLimit" entireResponse="true">
              <CUSTOMER_ORG_ID Value="{$this/ORG_ID/@Value}"/>
              <SELLING_ORG_ID Value="{$sellingOrg}"/>
              <PAYMENT_INST_TYPE Value="{$limit/PM_PAYMENT_INST_TYPE/@Value}"/>
              <TRANSACTION_BUYING_LIMIT Value="{$limit/PM_TRANSACTION_BUYING_LIMIT/@Value}"/>
              <TRANSACTION_BUYING_LIMIT_STATUS Value="{$limit/PM_TRANSACTION_BUYING_LIMIT_STATUS/@Value}"/>
              <PERIODIC_BUYING_LIMIT Value="{$limit/PM_PERIODIC_BUYING_LIMIT/@Value}"/>
              <PERIODIC_BUYING_LIMIT_STATUS Value="{$limit/PM_PERIODIC_BUYING_LIMIT_STATUS/@Value}"/>
              <PERIODIC_BUYING_LIMIT_DURATION Value="{$limit/PM_PERIODIC_BUYING_LIMIT_DURATION/@Value}"/>
              <PERIODIC_BUYING_LIMIT_START_DATE Value="{$limit/PM_PERIODIC_BUYING_LIMIT_START_DATE/@Value}"/>
            </xcore:execute-method>
          </xapl:when>
          <xapl:otherwise>
            <!-- modify -->
            <xcore:execute-method name="//UserSecurity/modifyPaymentMethodBuyingLimit" entireResponse="true">
              <CUSTOMER_ORG_ID Value="{$this/ORG_ID/@Value}"/>
              <SELLING_ORG_ID Value="{$sellingOrg}"/>
              <PAYMENT_INST_TYPE Value="{$limit/PM_PAYMENT_INST_TYPE/@Value}"/>
              <TRANSACTION_BUYING_LIMIT Value="{$limit/PM_TRANSACTION_BUYING_LIMIT/@Value}"/>
              <TRANSACTION_BUYING_LIMIT_STATUS Value="{$limit/PM_TRANSACTION_BUYING_LIMIT_STATUS/@Value}"/>
              <PERIODIC_BUYING_LIMIT Value="{$limit/PM_PERIODIC_BUYING_LIMIT/@Value}"/>
              <PERIODIC_BUYING_LIMIT_STATUS Value="{$limit/PM_PERIODIC_BUYING_LIMIT_STATUS/@Value}"/>
              <PERIODIC_BUYING_LIMIT_DURATION Value="{$limit/PM_PERIODIC_BUYING_LIMIT_DURATION/@Value}"/>
              <PERIODIC_BUYING_LIMIT_START_DATE Value="{$limit/PM_PERIODIC_BUYING_LIMIT_START_DATE/@Value}"/>
            </xcore:execute-method>
          </xapl:otherwise>
        </xapl:choose>
      </xapl:set-variable>
      <xapl:if test="string-length($response/RESPONSE/_RESULT/_ERROR/@Value) != 0">
        <web:display-page>
          <web:get-page name="org_buying_limits">
            <ORG_ID Value="{$this/ORG_ID/@Value}"/>
            <ERROR_MESSAGE Value="{$response/RESPONSE/_RESULT/_ERROR/@Value}"/>
          </web:get-page>
        </web:display-page>
      </xapl:if>
    </xapl:for-each>
    <web:display-page>
      <web:get-page name="org_buying_limits">
        <ORG_ID Value="{$this/ORG_ID/@Value}"/>
        <SUCCESS_MESSAGE Value="Save Successful."/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
</x2:commands>
