<?xml version="1.0" encoding="UTF-8"?>
<x2:commands description="_" 
             xmlns:omx="http://www.i2.com/omx" 
             xmlns:perm="http://www.i2.com/permissibility" 
             xmlns:web="http://www.i2.com/web" 
             xmlns:x2="http://www.i2.com/x2" 
             xmlns:xapl="http://www.i2.com/xapl" 
             xmlns:xcore="http://www.i2.com/xcore" 
             xmlns:xcore-db="http://www.i2.com/xcore-db" 
             xmlns:docutil="http://www.i2.com/docutil" 
             xmlns:i18n="http://www.i2.com/i18n" 
             xmlns:identity="http://www.i2.com/identity">

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getSegmentTable" >
    <x2:param name="orgId" />

    <xapl:return>

      <SEGMENT_TABLE>
        <xapl:variable name="parentSegs">
          <SEGMENTS>
            <xcore:execute-method name="//UserSecurity/getRootAccountCodeTypesByOrganization" >
              <ORG_ID Value="{$orgId}"/>
            </xcore:execute-method>
          </SEGMENTS>
        </xapl:variable>
        <xapl:if test=" count($parentSegs/CODE_MASTER_TYPE) > 0 ">
          <xapl:for-each select="$parentSegs/CODE_MASTER_TYPE" varName="seg">
            <SEGMENT>
              <xapl:value-of select="$seg/*"/>
              <SEQUENCE Value="1"/>
            </SEGMENT>
            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
            <!-- Get the children segments of this segment                    -->
            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
            <x2:execute command="omx.add_book.org.edit.account_code.model:getChildrenSegs">
              <x2:with-param name="parentId">
                <xapl:value-of select="$seg/TYPE_ID/@Value"/>
              </x2:with-param>
              <x2:with-param name="level" select="'1'"/>
            </x2:execute>
          </xapl:for-each>
        </xapl:if>
      </SEGMENT_TABLE>
	  
    </xapl:return>

  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getChildrenSegs" >
    <x2:param name="parentId" />
    <x2:param name="level"    />

    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <!--  get the children                                  -->
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <xapl:variable name="result">
      <xcore:execute-method name="//UserSecurity/getChildrenAccountCodeTypes">
        <TYPE_ID Value="{$parentId}"/>
      </xcore:execute-method>
    </xapl:variable>

    <xapl:choose>
      <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
      <!-- return nothing, as no children are present -->
      <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
      <xapl:when test="$result/_ERROR/@Value = 'NO_CHILDREN' ">
      </xapl:when>
      <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
      <!-- return available children                  -->
      <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
      <xapl:otherwise>
        <xapl:return>
          <SEGMENT>
            <xapl:value-of select="$result[1]/*"/>
            <SEQUENCE Value="{$level + 1}"/>
          </SEGMENT>
          <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
          <!-- Recursively call to get the children segments of this segment   -->
          <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
          <x2:execute command="omx.add_book.org.edit.account_code.model:getChildrenSegs">
            <x2:with-param name="parentId">
              <xapl:value-of select="$result[1]/TYPE_ID/@Value"/>
            </x2:with-param>
            <x2:with-param name="level" select="{$level + 1}"/>
          </x2:execute>
        </xapl:return>
      </xapl:otherwise>
    </xapl:choose>

  </x2:command>
  
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getSegmentTableWithValuesUrl" >
    <x2:param name="orgId" />

    <xapl:variable name="segmentTable">
      <x2:execute command="omx.add_book.org.edit.account_code.model:getSegmentTable">
        <x2:with-param name="orgId" select="$orgId"/>
      </x2:execute>
    </xapl:variable>

    <xapl:for-each select="$segmentTable/SEGMENT" varName="seg">
      <xapl:variable name="url">
        <web:get-page name="org_account_code_value">
          <ORG_ID        Value="{$orgId}"/>
          <SEGMENT_ID    Value="{$seg/TYPE_ID/@Value}"/>
        </web:get-page>
      </xapl:variable>

      <docutil:add select="$seg">
        <VALUES_URL Value="{$url}"/>
      </docutil:add>

    </xapl:for-each>


    <xapl:return>
      <xapl:value-of select="$segmentTable"/>
    </xapl:return>

  </x2:command>
  
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getValuesTable" >
    <x2:param name="segId" />
    
    <xapl:return>
      <VALUES_TABLE>
        <xcore:get-document name="//UserSecurity/CODE_MASTER_VALUE" >
          <TYPE_ID Value="{$segId}"/>
        </xcore:get-document>
      </VALUES_TABLE>
    </xapl:return>

  </x2:command>
  
  <!-- **********************************************************************
  *********************************************************************** -->

</x2:commands>
