<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">	
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="addEdit">
	
	<xapl:variable name="response" />
	 
    <xapl:print select="$this"/>
    
    <xapl:set-variable name="tempForm">
      <TEMP_FORM>
        <xapl:value-of select="$this/*"/>
      </TEMP_FORM>
    </xapl:set-variable>
        
     <xapl:set-variable name="response">
       <xapl:choose>
	     <xapl:when test="$this/IS_NEW/@Value = 'true'">
		   <docutil:remove select="{$this/ID}"/>
           <xcore:execute-method name="//UserSecurity/addPaymentTerm" entireResponse="true">
             <xapl:value-of select="$this/*"/>
           </xcore:execute-method>
         </xapl:when>
         <xapl:otherwise>
           <xcore:execute-method name="//UserSecurity/modifyPaymentTerm" entireResponse="true">
             <xapl:value-of select="$this/*"/>
           </xcore:execute-method>
         </xapl:otherwise>
       </xapl:choose>
     </xapl:set-variable>
	
	 <xapl:if test="string-length($response/RESPONSE/_RESULT/_ERROR/@Value) != 0">      
       <web:display-page>
         <web:get-page name="org_payment_term">
           <REFRESH Value="true"/>
           <!--<SELLING_ORG_ID Value="{$this/SELLING_ORG_ID/@Value}"/>-->
		   <xapl:value-of select="{$this/*}"/>
          <ERROR Value="{$response/RESPONSE/_RESULT/_ERROR/@Value}"/>
        </web:get-page>
      </web:display-page> 
    </xapl:if>
    
    <xapl:print>RESPONSE!!!<xapl:value-of select="$response"/></xapl:print>
    
    <xapl:variable name="result">
      <ROOT>
        <xapl:choose>
          <xapl:when test="{$this/IS_NEW/@Value = 'true'}">
            <ID Value="{$response/RESPONSE/ID/@Value}"/>
			<SELLING_ORG_ID Value="{$this/SELLING_ORG_ID/@Value}"/>
            <STATUS_MSG Value="Save Successful."/>
          </xapl:when>
          <xapl:otherwise>
            <ID Value="{$this/ID/@Value}"/>
			<SELLING_ORG_ID Value="{$this/SELLING_ORG_ID/@Value}"/>
            <STATUS_MSG Value="Updated Successful."/>
          </xapl:otherwise>
        </xapl:choose>
     </ROOT>
    </xapl:variable>
    
    <web:display-page>
      <web:get-page name="org_payment_term">
        <xapl:value-of select="$result/*"/>   
      </web:get-page>
    </web:display-page>
	
  </x2:command>
    
  <!-- **********************************************************************
  *********************************************************************** -->
</x2:commands>
