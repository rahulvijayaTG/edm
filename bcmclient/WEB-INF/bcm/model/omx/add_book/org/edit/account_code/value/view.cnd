<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
    <xapl:variable name="segmentEntity">
      <x2:execute command="omx.add_book.org.edit.account_code.model:getSegmentTable">
        <x2:with-param name="orgId" select="{$this/ORG_ID/@Value}"/>
      </x2:execute>
    </xapl:variable>
    <xapl:variable name="segmentId">
      <xapl:choose>
        <xapl:when test=" string-length($this/SEGMENT_ID/@Value) != 0 ">
          <xapl:value-of select="$this/SEGMENT_ID/@Value"/>
        </xapl:when>
        <xapl:otherwise>
          <xapl:value-of select="$segmentEntity/SEGMENT[1]/TYPE_ID/@Value"/>
        </xapl:otherwise>
      </xapl:choose>
    </xapl:variable>
    <xapl:print select="$segmentEntity"/>
    <xapl:variable name="valueEntity">
      <x2:execute command="omx.add_book.org.edit.account_code.model:getValuesTable">
        <x2:with-param name="segId" select="{$segmentId}"/>
        <x2:with-param name="opId" select="{$this/ORG_ID/@Value}"/>
      </x2:execute>
    </xapl:variable>
    <xapl:print select="$valueEntity"/>
    <xapl:return>
      <!-- Header -->
      <x2:execute command="omx.add_book.org.edit.account_code.value.view:getHeader"/>
      <!-- Tabs Container -->
      <x2:execute command="omx.add_book.org.edit.account_code.value.view:getContainer">
        <x2:with-param name="pPage" select="'org_account_code_value'"/>
        <x2:with-param name="pValueEntity" select="{$valueEntity}"/>
        <x2:with-param name="pSegmentEntity" select="{$segmentEntity}"/>
      </x2:execute>
      <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
      <!--  The Page Data...                                           -->
      <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
      <VALUES_PAGE>
        <ORG_ID Value="{$this/ORG_ID/@Value}"/>
        <PRIMARY_DOMAIN Value="{$s_inPrimaryDomain}"/>
        <SEGMENT_ID Value="{$segmentId}"/>
        <xapl:value-of select="$segmentEntity"/>
        <xapl:value-of select="$valueEntity"/>
      </VALUES_PAGE>
      <xapl:print select="'~~~~~~~~~~~~ this ~~~~~~~~~~'"/>
      <xapl:print select="$this"/>
      <!-- Status/Error Messages -->
      <x2:execute command="omx.alert:getAlerts">
        <x2:with-param name="pRefresh">
          <xapl:value-of select="$this/REFRESH/@Value"/>
        </x2:with-param>
        <x2:with-param name="pERROR">
          <xapl:value-of select="$this/ERROR/@Value"/>
        </x2:with-param>
        <x2:with-param name="pStatusMsg">
          <xapl:value-of select="$this/SUCCESS_MESSAGE/@Value"/>
        </x2:with-param>
      </x2:execute>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    <xapl:variable name="orgHeader" enforceList="true">
      <x2:execute command="omx.add_book.org.view:getHeader">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
    </xapl:variable>
    <xapl:variable name="acctCodePage">
      <web:get-page name="org_account_code_segment">
        <ORG_ID Value="{$addBookCurrOrgId/@Value}"/>
        <CUSTOMER_ORG_ID Value="{$addBookCurrOrgId/@Value}"/>
        <IN_PRIMARY_DOMAIN Value="{$s_inPrimaryDomain}"/>
      </web:get-page>
    </xapl:variable>
    <xapl:variable name="orgPage">
      <web:get-page name="org_overview">
        <ORG_ID Value="{$addBookCurrOrgId/@Value}"/>
        <CUSTOMER_ORG_ID Value="{$addBookCurrOrgId/@Value}"/>
        <IN_PRIMARY_DOMAIN Value="{$s_inPrimaryDomain}"/>
      </web:get-page>
    </xapl:variable>
    <xapl:return>
      <HEADER>
        <HEADING4 Value="Account Code Values"/>
        <HEADING3 Value="Account Code"/>
        <HEADING3_LINK Value="{$acctCodePage}"/>
        <HEADING2_LINK Value="{$orgPage}"/>
        <xapl:value-of select="$orgHeader/*"/>
      </HEADER>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <x2:param name="pPage"/>
    <x2:param name="pSegmentEntity"/>
    <x2:param name="pValueEntity"/>
    <xapl:return>
      <CONTAINER>
        <HELP Url="../../../../help/account_codes_value.html"/>
        <STEP DisplayText="Account Code Values" OnClick="{$pages:org_account_code_value}" Selected="{$pPage = 'org_account_code_value'}">
          <BUTTONS>
            <xapl:if test="$s_inPrimaryDomain='true'">
              <xapl:if test="count($pValueEntity/CODE_MASTER_VALUE) > 0">
                <BUTTON Name="delete" DisplayText="Delete" OnClick="javascript:onDelete()" Emphasized="no"/>
                <BUTTON Name="update" DisplayText="Update" OnClick="javascript:onUpdate()" Emphasized="no"/>
              </xapl:if>
              <BUTTON Name="add" DisplayText="Add" OnClick="javascript:onSave()" Emphasized="no"/>
            </xapl:if>
          </BUTTONS>
        </STEP>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
</x2:commands>
