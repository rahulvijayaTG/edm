<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">    
    
	<xapl:variable name="entity">
	  <x2:execute command="omx.add_book.org.edit.payment_term.view:getPaymentTerm">
        <x2:with-param name="pRefresh" select="$this/REFRESH/@Value"/>  
		<x2:with-param name="pId" select="{$this/ID/@Value}"/>             
        <x2:with-param name="pOrgId" select="{$this/SELLING_ORG_ID/@Value}"/>
      </x2:execute>
	</xapl:variable>
	
	<xapl:print select="$entity"/>
	
	<xapl:return>  
	
	  <!-- Header -->
      <x2:execute command="omx.add_book.org.edit.payment_term.view:getHeader">
	    <x2:with-param name="this" select="$this"/>
	  </x2:execute>
      
      <!-- Container -->
      <x2:execute command="omx.add_book.org.edit.payment_term.view:getContainer">
        <x2:with-param name="pPage" select="'org_payment_term'"/>
        <x2:with-param name="pHide" select="$this/HIDE_TABS/@Value"/>
        <x2:with-param name="pReturnLink" select="$this/RET_PAGE/@Value"/>
		<x2:with-param name="pEntity" select="{$entity}"/>
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
      
      <xapl:value-of select="{$entity}"/>
	  
	  <!-- Status/Error Messages -->
      <x2:execute command="omx.alert:getAlerts">
        <x2:with-param name="pRefresh"><xapl:value-of select="$this/REFRESH/@Value"/></x2:with-param>
        <x2:with-param name="pERROR"><xapl:value-of select="$this/ERROR/@Value"/></x2:with-param>
        <x2:with-param name="pStatusMsg"><xapl:value-of select="$this/STATUS_MSG/@Value"/></x2:with-param>
      </x2:execute>
	        
    </xapl:return>
  </x2:command> 
  
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    
	<xapl:variable name="orgHeader" enforceList="true">
      <x2:execute command="omx.add_book.org.view:getHeader">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
    </xapl:variable>

    <xapl:variable name="orgPage">
      <web:get-page name="org_overview">
	    <ORG_ID Value="{$addBookCurrOrgId/@Value}"/>
		<CUSTOMER_ORG_ID Value="{$addBookCurrOrgId/@Value}"/>
		<IN_PRIMARY_DOMAIN Value="{$s_inPrimaryDomain}"/>
      </web:get-page>
    </xapl:variable>

    <xapl:return>
      <HEADER>
      <HEADING3 Value="Term Details"/>
      <HEADING2_LINK Value="{$orgPage}"/>
      <xapl:value-of select="$orgHeader/*"/>
      </HEADER>
    </xapl:return>

  </x2:command>	
  
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <x2:param name="pPage"/>
	<x2:param name="pEntity"/>
    
    <xapl:return>
      <xapl:variable name="quote">'</xapl:variable>
      <CONTAINER>
        
		<xapl:variable name="url">
		  <web:get-page name="add_terms_help"/>
        </xapl:variable>
    
        <HELP Url="{$url}"/>
        
        <STEP
		  DisplayText="Term Details" 
		  OnClick="{$pages:org_payment_term}" 
		  Selected="{$pPage = 'org_payment_term'}">
		  
		  <xapl:variable name="clicker">
		    <xapl:value-of select="concat('javascript:onReset(', $quote, $pEntity/ID/@Value , $quote, ',' , $quote, $pEntity/SELLING_ORG_ID/@Value, $quote, ');')"/>
		  </xapl:variable>
		  <BUTTONS>
		    <xapl:if test="$pEntity/IS_NEW or $pEntity/EDITABLE/@Value='true'">
			  <BUTTON 
			    Name="Reset" 
				DisplayText="Reset" 
				OnClick="{$clicker}" 
				Disabled="report"/>
			</xapl:if>
			<xapl:if test="$pEntity/IS_NEW">
			  <BUTTON 
			    Name="Save" 
				DisplayText="Save" 
				Emphasized="yes"
				OnClick="javascript:onSave();" 
				Disabled="report"/>
			</xapl:if>
			<xapl:if test="string-length($pEntity/ID/@Value) != 0 and $pEntity/EDITABLE/@Value='true'">
			  <BUTTON 
			    Name="SaveAsNew" 
				DisplayText="Save As New" 
				OnClick="javascript:onSave();" 
				Disabled="report"/>
				
			  <BUTTON 
			    Name="Update" 
				DisplayText="Update"
				Emphasized="yes" 
				OnClick="javascript:onUpdate();" 
				Disabled="report"/>
			</xapl:if>
		  </BUTTONS> 
			 
        </STEP>
	  </CONTAINER>
      
    </xapl:return>
    
  </x2:command>
    
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getPaymentTerm">
    <x2:param name="pRefresh"/>
    <x2:param name="pId"/>
    <x2:param name="pOrgId"/>

    <xapl:variable name="tempTermsInfo"/>
    
    <xapl:print>
      *************************** getTerms
      ID <xapl:value-of select="$pId" />
    </xapl:print>
    
    <xapl:if test="$pRefresh = 'true'">
      <xapl:set-variable name="tempTermsInfo">
        <PAYMENT_TERMS>
          <xapl:value-of select="$tempForm/*"/>
        </PAYMENT_TERMS>
      </xapl:set-variable>
    </xapl:if>
		
    <xapl:variable name="pUserOrgId">
	  <identity:get-org/>
	</xapl:variable>
	<xapl:variable name="sellOrgId">
	  <xapl:choose>
	    <xapl:when test="string-length($pOrgId)=0">
	      <xapl:value-of select="$addBookCurrOrgId/@Value"/>
		</xapl:when>
		<xapl:otherwise>
		  <xapl:value-of select="$pOrgId"/>
		</xapl:otherwise>
	  </xapl:choose>
	</xapl:variable>
    <xapl:return>
      <xapl:choose>
        <xapl:when test="string-length($pId) != 0">
		  <xapl:variable name="data">
		    <xcore:execute-method name="//UserSecurity/getPaymentTerms">
		      <FILTER Name="ID">
                <xcore:search-by property="ID" value="{$pId}"/>
              </FILTER>
		    </xcore:execute-method>
		  </xapl:variable>
		  <perm:is-allowed document="PAYMENT_TERM" action="edit">   
		    <xapl:print select="$pOrgId"/>
			<xapl:print select="$pUserOrgId"/>
		    <!--<xapl:if test="$pOrgId = $pUserOrgId">   -->
			  <docutil:add select="{$data/PAYMENT_TERMS}">
                <EDITABLE Value="true"/>
			  </docutil:add>
		    <!--</xapl:if>-->
  	      </perm:is-allowed>
		  <xapl:print select="$data/PAYMENT_TERMS"/>
		  <xapl:value-of select="{$data/PAYMENT_TERMS}"/>
          <xapl:if test="{count($this/ERROR) != 0}">
            <xapl:value-of select="{ERROR}"/>
          </xapl:if>
          <xapl:if test="{count($this/SUCCESS) != 0}">
            <xapl:value-of select="{SUCCESS}"/>
          </xapl:if>
        </xapl:when>
        <xapl:otherwise>
		  <xapl:choose>
		    <xapl:when test="$pRefresh = 'true'">
			  <xapl:print select="$tempTermsInfo"/>
              <xapl:value-of select="$tempTermsInfo"/>
		    </xapl:when>
		    <xapl:otherwise>
		      <PAYMENT_TERMS>
		        <IS_NEW Value="true"/>
			    <SELLING_ORG_ID Value="{$sellOrgId}"/>
		      </PAYMENT_TERMS>
		    </xapl:otherwise>
		  </xapl:choose>
        </xapl:otherwise>
      </xapl:choose>
    </xapl:return>

  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
</x2:commands>
