<?xml version="1.0" encoding="UTF-8"?>
<x2:commands description="_" 
             xmlns:FUNCTION="http://www.i2.com/FUNCTION" 
             xmlns:REMOVE="http://www.i2.com/REMOVE" 
             xmlns:cfg="http://www.i2.com/configurability" 
             xmlns:core="http://www.i2.com/core" 
             xmlns:omx="http://www.i2.com/omx" 
             xmlns:perm="http://www.i2.com/permissibility" 
             xmlns:util="http://www.i2.com/util" 
             xmlns:web="http://www.i2.com/web" 
             xmlns:x2="http://www.i2.com/x2" 
             xmlns:xapl="http://www.i2.com/xapl" 
             xmlns:xcore="http://www.i2.com/xcore" 
             xmlns:xcore-db="http://www.i2.com/xcore-db" 
             xmlns:docutil="http://www.i2.com/docutil" 
             xmlns:xudl="http://www.i2.com/xudl"
             xmlns:identity="http://www.i2.com/identity">
  
  <!--************************************************************************-->    
  <x2:command public="yes" description="_" name="getPageData">
    <xapl:return>
      <x2:execute command="omx.add_book.org.pages:getTabs">
	    <x2:with-param name="page">sharing_orgs</x2:with-param>
		<x2:with-param name="orgId"><xapl:value-of select="{$this/ORG_ID/@Value}" /></x2:with-param>
        <x2:with-param name="searchMode" select="'false'"/>
	  </x2:execute>
	  
      <x2:execute command="omx.add_book.org.orgSharing:getSharing">
	    <x2:with-param name="pOrgId" select="{$this/ORG_ID/@Value}"/>
	  </x2:execute>
    </xapl:return>
  </x2:command>
  
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="getSharing">
    <x2:param name="pOrgId"/>
	
	<xapl:variable name="sharedOrgIds">
	  <SHARED_ORGS>
	    <xcore:execute-method name="//UserSecurity/getOrgsInSharingMap">
	      <SOURCE_ORG_ID Value="{$pOrgId}"/>
	    </xcore:execute-method>
	  </SHARED_ORGS>
	</xapl:variable>
	
	<xapl:variable name="sharedOrgs">
	  <xcore:execute-method name="//UserSecurity/getOrganizations">
	    <FILTER Name="ID">
		  <OR>
		    <xapl:for-each select="$sharedOrgIds/TARGET_ORG_ID" varName="torg">
			  <xcore:search-by property="ID" value="{$torg/@Value}" matchby="EQUAL"/>
			</xapl:for-each>
		  </OR>
		</FILTER>
	  </xcore:execute-method>
	</xapl:variable>
	
    <xapl:return>
	  <SHARED>
	    <EDITABLE Value="'true'"/>
		<ORG_ID Value="{$pOrgId}"/>
	    <xapl:value-of select="{$sharedOrgs/*}"/>
	  </SHARED>
	</xapl:return>
  </x2:command>
  
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="getSearchFormConfig">
    <xapl:return> 
      <!-- Search Fields -->
      <FORM  MethodName="//UserSecurity/getEnabledOrganizations"  Name="search_form" Action="search.jsp" Method="GET" Target="appFrame">        

        <INSTRUCTION DisplayText = "Select Target Organizations"/>

        <FIELD 
          Type="Text" 
          DisplayText="Name" 
		  Name="FULL_NAME" 
		  Value="{$this/FULL_NAME/@Value}" 
		  Visibility="Simple"/>
		  
		<FIELD 
		  Type="Hidden" 
		  Name="IS_SHARING_SEARCH" 
		  Value="{$this/IS_SHARING_SEARCH/@Value}" 
		  Visibility="Simple"/>
		  
		<FIELD 
		  Type="Hidden" 
		  Name="SOURCE_ORG_ID" 
		  Value="{$this/ORG_ID/@Value}" 
		  Visibility="Simple"/>
		  
		<FIELD 
		  Type="Hidden" 
		  Name="ORG_ID" 
		  Value="{$this/ORG_ID/@Value}" 
		  Visibility="Simple"/>
            
        <!-- Always Put hidden at the end -->
        <x2:execute command="omx.search.search:getHiddenFields">
          <x2:with-param name="this" select="$this"/>
        </x2:execute>  
          
        <!-- Form Buttons -->
        <BUTTONS>
          <BUTTON 
		    Name="search" 
			DisplayText="Search" 
			OnClick="javascript:onSearch()" 
			Emphasized="no"/>				
        </BUTTONS>
      </FORM>       
    </xapl:return>    
  </x2:command>
  
  <!-- *******************************************************************-->
  <x2:command public="yes" description="_" name="getSearchReportConfig">
    <xapl:variable name="helpUrl">
	  <web:get-page name="add_book_details_help"/>
	</xapl:variable>
			
    <xapl:return>
      <REPORT Selectable="All" Id="ORG_ID" Scrollable="yes"  >
        <HELP Url="{$helpUrl}"/>
        <FIELDS>
	      <FIELD 
		    Name="NAME"  
			DisplayText="Name"
			Sortable="yes"
			Url="../add_book/org/pages/redirectToCustomerOrgDetails.cmd"
			UrlParam="All"/>
          <FIELD 
		    Name="ADDRESS1"          
			DisplayText="Address"  
			Sortable="no"/>
		  <FIELD 
		    Type="Hidden"
		    Name="CUSTOMER_ORG_ID"          
			DisplayText="Customer Org Id"  
			Sortable="no"/>
			
		  <FIELD 
		    Type="Hidden" 
		    Name="SOURCE_ORG_ID" 
		    Value="{$this/ORG_ID/@Value}" 
		    Sortable="no"/>
		  
		  <FIELD 
		    Type="Hidden" 
		    Name="ORG_ID" 
		    Value="{$this/ORG_ID/@Value}" 
		    Sortable="no"/>
                        
          <!-- Hidden Fields -->
          <x2:execute command="omx.report.report:getHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute> 
        </FIELDS>   
      </REPORT>
    </xapl:return>
  </x2:command>
    
  <!-- ******************************************************************* -->
  <x2:command public="yes" description="_" name="getReportData">
    <x2:param name="pForm"/>
    <x2:param name="pIds"/>
    <x2:param name="pAddRecordCount" select="'true'"/>
    
    <!-- Give Defaults - Start:-->    
    <xapl:variable name="addRecordCount" select="$pAddRecordCount"/>
    <xapl:variable name="statusFilter"><ROOT/></xapl:variable>
    <xapl:variable name="userId"><identity:get-user-id/></xapl:variable>
    
      
    <xapl:variable name="data">
      <xapl:choose>
        <!-- pDoSearch and user has entered any Search Field on the form-->
        <xapl:when test="{($pForm/FIELD[@Name = 'DO_SEARCH']/@Value = 'Yes' ) and count($pForm/FIELD[@Type !='Hidden' and (string-length(@Value) > 0  or string-length(@Value1) >0 or string-length(@Value2) > 0)]) > 0}">
          <!-- Get Data -->
          <xcore:execute-method name="{$pForm/@MethodName}" StartAtRow="{$pForm/FIELD[@Name = 'START_COUNT']/@Value}" MaxRows="{$pForm/FIELD[@Name = 'MAX_ROWS']/@Value}" ReturnRowCount="{$this/RETURN_ROW_COUNT/@Value}">
            <!-- TODO :Genarate the FILTERS Automatically --> 
			<FILTER Name="ADDRESS">
            </FILTER>
            
			<FILTER Name="FULL_NAME">
              <xcore:search-by property="FULL_NAME" value="{$pForm/FIELD[@Name = 'FULL_NAME']/@Value}"/>
            </FILTER>
			
			<FILTER Name="CUSTOMER_ORG_ID">
              <xcore:search-by property="CUSTOMER_ORG_ID" value="{$pForm/FIELD[@Name = 'SOURCE_ORG_ID']/@Value}" matchby="NOT_EQUAL"/>
            </FILTER>
														
            <xapl:if test="string-length($pForm/FIELD[@Name = 'SORT_BY']/@Value) > 0 and string-length($pForm/FIELD[@Name = 'SORT_ORDER']/@Value) > 0">
  			  <ORDER_BY>
	  		    <docutil:element name="{$pForm/FIELD[@Name = 'SORT_BY']/@Value}" Sort="{$pForm/FIELD[@Name = 'SORT_ORDER']/@Value}"/>
		  	  </ORDER_BY>
            </xapl:if>   
          </xcore:execute-method>
        </xapl:when>
        <!-- pIds or pGetRecent -->        
        <xapl:otherwise>
          <xapl:if test="{($pForm/FIELD[@Name = 'DO_SEARCH']/@Value != 'Yes' ) or count($pIds/ID) > 0}">
            <!-- Get Ids -->
            <xapl:variable name="ids" >
              <IDS>
                <xapl:choose>
                  <!-- If ids are passed -->
                  <xapl:when test="count($pIds/ID) > 0">
                    <xapl:value-of select="$pIds/ID"/>
                  </xapl:when>
                  <!-- Other wise get recent ids-->
                  <xapl:otherwise>
                      <omx:get-recent max="10" userId="{$userId}">
                        <!-- TODO: get DOC_GROUP -->
                        <TRANSACTION>
                          <docutil:element name="{$pForm/FIELD[@Name = 'OBJECT_TYPE']/@Value}"/>
                        </TRANSACTION>
                      </omx:get-recent>
                  </xapl:otherwise>    
                </xapl:choose>  
              </IDS>                          
           </xapl:variable>

           <!-- Get data -->
           <xapl:if test="{count($ids/*) > 0}">
             <xapl:set-variable name="addRecordCount" select="'false'"/>
             <xcore:execute-method name="{$pForm/@MethodName}" ReturnRowCount="{$this/RETURN_ROW_COUNT/@Value}">
               <FILTER Name="ID">
                 <OR>
                 <xapl:value-of select="{$ids/ID}"/>
                 </OR>
               </FILTER>
				
               <xapl:if test="string-length($pForm/FIELD[@Name = 'SORT_BY']/@Value) > 0 and string-length($pForm/FIELD[@Name = 'SORT_ORDER']/@Value) > 0">
                 <ORDER_BY>
                   <docutil:element name="{$pForm/FIELD[@Name = 'SORT_BY']/@Value}" Sort="{$pForm/FIELD[@Name = 'SORT_ORDER']/@Value}"/>
                 </ORDER_BY>
               </xapl:if>
             </xcore:execute-method>
           </xapl:if>  <!-- If ids -->
         </xapl:if><!-- DO_SEARCH != yes or pIds -->
       </xapl:otherwise><!-- DO_SEARCH !=yes and user entered nothing -->
     </xapl:choose>	
   </xapl:variable>

    <!-- Add the total record count  -->
    <!-- Add the total record count  -->
    <docutil:add select="$data">
      <TOTAL_RECORD_COUNT Value="{$data/@TotalRowCount}"/>
      <START_AT_ROW Value ="{$this/START_COUNT/@Value}"/>
    </docutil:add>
    <!-- Add the total record count  -->
	<xapl:print select="$data"/>
		
    <xapl:return>
      <xapl:value-of select="{$data}"/>
    </xapl:return>
    
  </x2:command>

</x2:commands>