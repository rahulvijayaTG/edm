<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2"
              xmlns:core="http://www.i2.com/core"
              xmlns:xcore="http://www.i2.com/xcore"
              xmlns:xcore-db="http://www.i2.com/xcore-db"
              xmlns:xapl="http://www.i2.com/xapl"
              xmlns:web="http://www.i2.com/web"
              xmlns:docutil="http://www.i2.com/docutil"
              xmlns:util="http://www.i2.com/util"
              xmlns:xudl="http://www.i2.com/xudl"
              xmlns:cfg="http://www.i2.com/configurability"
              xmlns:perm="http://www.i2.com/permissibility"
              xmlns:omx="http://www.i2.com/omx"
              xmlns:i18n="http://www.i2.com/i18n"
              xmlns:identity="http://www.i2.com/identity"
              description="_">

  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="init">
    <xapl:variable name="addBookCurrOrgId" resolver="session" global="true"/>
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="addEditOrg">
    <x2:param name="this"/>
     
    <xapl:variable name="response" />
	 
    <xapl:print select="$this"/>
    
    <xapl:set-variable name="tempForm">
      <TEMP_FORM>
        <xapl:value-of select="$this/*"/>
      </TEMP_FORM>
    </xapl:set-variable>
    
    <xapl:if test="string-length($this/PARENT_ORG_ID/@Value) = 0">
      <docutil:remove select="{$this/PARENT_ORG_ID}"/>
    </xapl:if>
    
    <xapl:if test="string-length($this/IS_SINGLE_CORPORATE/@Value) = 0">
      <docutil:add select="$this">
        <IS_SINGLE_CORPORATE Value="false"/>
      </docutil:add>
    </xapl:if>
    
     <xapl:set-variable name="response">
        <xapl:variable name="status"><STATUS/></xapl:variable>
          <docutil:add select="$status">
            <xapl:choose>
              <xapl:when test="$this/CUSTOMER_STATUS/@Value = 'ACTIVE'">
                <IS_CUSTOMER Value="true"/>
              </xapl:when>
              <xapl:otherwise>
                <IS_CUSTOMER Value="false"/>
              </xapl:otherwise>
            </xapl:choose>
            <xapl:choose>
              <xapl:when test="$this/SELLER_STATUS/@Value = 'ACTIVE'">
                <IS_SELLER Value="true"/>
              </xapl:when>
              <xapl:otherwise>
                <IS_SELLER Value="false"/>
              </xapl:otherwise>
            </xapl:choose>
          </docutil:add>
        <xapl:choose>
          <xapl:when test="$this/IS_NEW/@Value = 'true'">
            <xcore:execute-method name="//UserSecurity/addOrg" entireResponse="true">
              <xapl:value-of select="$this/FULL_NAME"/>
              <xapl:value-of select="$this/NAME"/>            
              <xapl:value-of select="$this/ADDRESS1"/>
              <xapl:value-of select="$this/ADDRESS2"/>
              <xapl:value-of select="$this/ADDRESS3"/>
              <xapl:value-of select="$this/ADDRESS4"/>
              <xapl:value-of select="$this/ADDRESS5"/>
              <xapl:value-of select="$this/POSTAL_CODE"/>
              <xapl:value-of select="$this/CITY"/>
              <xapl:value-of select="$this/STATE"/>
              <xapl:value-of select="$this/COUNTRY"/>
			  <xapl:value-of select="$this/COUNTY"/>
			  <xapl:value-of select="$this/REGION"/>
              <xapl:value-of select="$this/URL"/>
              <xapl:value-of select="$this/PARENT_ORG_ID"/>
              <xapl:value-of select="$this/DEFAULT_FC_ID"/>
              <xapl:value-of select="$this/GENERATE_INVOICES"/>
              <xapl:value-of select="$this/ALLOWS_BACKORDERS"/>
              <xapl:value-of select="$this/IS_REPAIR_VENDOR"/>
              <xapl:value-of select="$this/IS_VRMA_REQUIRED"/>
              <xapl:value-of select="$this/TRANSFER_ORDERS_BILLABLE"/>
              <xapl:value-of select="$this/TAX_ID"/>
              <xapl:value-of select="$this/TAX_CODE"/>
              <xapl:value-of select="$this/CURRENCY_CODE"/>
              <xapl:value-of select="$this/IS_SINGLE_CORPORATE"/>
              <xapl:value-of select="$status/*"/>
            </xcore:execute-method>
          </xapl:when>
          <xapl:otherwise>
          <xcore:execute-method name="//UserSecurity/modifyOrganization" entireResponse="true">
             <xapl:value-of select="$this/ID"/>
             <xapl:value-of select="$this/ADDRESS_ID"/>
			 <xapl:value-of select="$this/CONTACT_ID"/>
             <xapl:value-of select="$this/FULL_NAME"/>
             <xapl:value-of select="$this/NAME"/>
             <xapl:value-of select="$this/ADDRESS1"/>
             <xapl:value-of select="$this/ADDRESS2"/>
             <xapl:value-of select="$this/ADDRESS3"/>
             <xapl:value-of select="$this/ADDRESS4"/>
             <xapl:value-of select="$this/ADDRESS5"/>
             <xapl:value-of select="$this/POSTAL_CODE"/>
             <xapl:value-of select="$this/CITY"/>
             <xapl:value-of select="$this/STATE"/>
             <xapl:value-of select="$this/COUNTRY"/>
			 <xapl:value-of select="$this/COUNTY"/>
			 <xapl:value-of select="$this/REGION"/>
             <xapl:value-of select="$this/URL"/>
             <xapl:value-of select="$this/PARENT_ORG_ID"/>
             <xapl:value-of select="$this/DEFAULT_FC_ID"/>
             <xapl:value-of select="$this/GENERATE_INVOICES"/>
             <xapl:value-of select="$this/ALLOWS_BACKORDERS"/>
             <xapl:value-of select="$this/IS_REPAIR_VENDOR"/>
             <xapl:value-of select="$this/IS_VRMA_REQUIRED"/>
             <xapl:value-of select="$this/TRANSFER_ORDERS_BILLABLE"/>
             <xapl:value-of select="$this/TAX_ID"/>
             <xapl:value-of select="$this/TAX_CODE"/>
             <xapl:value-of select="$this/CURRENCY_CODE"/>
             <xapl:value-of select="$this/IS_SINGLE_CORPORATE"/>
             <xapl:value-of select="$status/*"/>
          </xcore:execute-method>
          <xapl:if test="$this/CUSTOMER_STATUS/@Value = 'ACTIVE'">
            <xcore:execute-method name="//UserSecurity/setOrganizationStatus" entireResponse="true">
              <xapl:value-of select="$this/ID"/>
              <xapl:value-of select="$this/CUSTOMER_STATUS"/>
            </xcore:execute-method>
          </xapl:if>
          <xapl:if test="$this/SELLER_STATUS/@Value = 'ACTIVE'">
            <xcore:execute-method name="//UserSecurity/setOrganizationStatus" entireResponse="true">
              <xapl:value-of select="$this/ID"/>
              <xapl:value-of select="$this/SELLER_STATUS"/>
            </xcore:execute-method>
          </xapl:if>
        </xapl:otherwise>
      </xapl:choose>
    </xapl:set-variable>
	
	<xapl:return>
	  <xapl:value-of select="$response"/>
	</xapl:return>
	    
  </x2:command>
  
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="details">
  
	<web:display-page>
	  <web:get-page name="edit_org">
	    <ORG_ID Value="{$this/ID/@Value}"/>
		<CUSTOMER_ORG_ID Value="{$this/ID/@Value}"/>
	  </web:get-page>
	</web:display-page>
  
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="addEditLocalOrg">
    <x2:param name="this"/>
	
    <xapl:set-variable name="tempForm">
      <TEMP_FORM>
        <xapl:value-of select="{$this}"/>
      </TEMP_FORM>
    </xapl:set-variable>
    
    <xapl:variable name="sellingOrg">
      <x2:execute command="omx.add_book.org.model:getUserSellingOrg"/>
    </xapl:variable>

    <xapl:variable name="response">
      <xapl:choose>
        <xapl:when test="{$this/IS_LOCAL_NEW/@Value = 'true'}">
          <docutil:remove select="{$this/ID}"/>
          <xcore:execute-method name="//UserSecurity/addCustomerOrg" entireResponse="true">
            <SELLING_ORG_ID Value="{$sellingOrg}"/>
            <xapl:value-of select="{$this/*}"/>
          </xcore:execute-method>
        </xapl:when>
        <xapl:otherwise>
          <xcore:execute-method name="//UserSecurity/modifyCustomerOrg" entireResponse="true">
            <SELLING_ORG_ID Value="{$sellingOrg}"/>
            <xapl:value-of select="{$this/*}"/>
          </xcore:execute-method>
        </xapl:otherwise>
      </xapl:choose>
    </xapl:variable>
	
	<xapl:return>
	  <xapl:value-of select="$response"/>
	</xapl:return>
	
  </x2:command>
  
  <!--**********************************************************************
  ***********************************************************************-->
  <x2:command public="yes" description="_" name="changeLocalStatus">

    <xapl:variable name="sellingOrg">
      <x2:execute command="omx.add_book.org.model:getUserSellingOrg"/>
    </xapl:variable>
	
	 <!-- API -->    
    <xapl:variable name="changeStatusAPI" select="'//UserSecurity/setEnabledOrganizationStatus'"/>
    <!-- If status is passed -->       
    <xapl:if test="string-length($this/LOCAL_STATUS/@Value) > 0">
      <xcore:execute-method name="{$changeStatusAPI}">
        <CUSTOMER_ORG_ID Value="{$this/CUSTOMER_ORG_ID/@Value}"/>
      	<SELLING_ORG_ID Value="{$sellingOrg}"/>    
        <xapl:choose>
          <xapl:when test="{$this/LOCAL_STATUS/@Value = 'ACTIVE'}">
            <STATUS Value="DORMANT"/>
          </xapl:when>
          <xapl:when test="{$this/LOCAL_STATUS/@Value = 'DORMANT'}">
            <STATUS Value="ACTIVE"/>
          </xapl:when>
        </xapl:choose>
      </xcore:execute-method>
    </xapl:if>
	
	<xapl:variable name="statusMsg">
	  <xapl:choose>
	    <xapl:when test="{$this/LOCAL_STATUS/@Value = 'ACTIVE'}">
		  <STATUS_MSG Value="Deactivate Successful."/>
		  <LOCAL_EDITABLE Value="false"/>
        </xapl:when>
        <xapl:when test="{$this/LOCAL_STATUS/@Value = 'DORMANT'}">
		  <STATUS_MSG Value="Successfully Activated!"/>
		  <LOCAL_EDITABLE Value="true"/>
        </xapl:when>
      </xapl:choose>
	</xapl:variable>

    <web:display-page>
      <web:get-page name="edit_org">
        <ORG_ID Value="{$this/CUSTOMER_ORG_ID/@Value}"/>
        <xapl:value-of select="{$this/CUSTOMER_ORG_ID}"/>
		<xapl:value-of select="{$statusMsg}"/>
      </web:get-page>
    </web:display-page>

  </x2:command>
  
  <!--**********************************************************************
  ***********************************************************************-->
  <x2:command public="yes" description="_" name="addEditLocalSellerOrg">

    <xapl:variable name="custOrg">
      <x2:execute command="omx.add_book.org.model:getUserCustomerOrg"/>
    </xapl:variable>

    <xcore:execute-method name="//UserSecurity/enableSellerOrganization">
      <CUSTOMER_ORG_ID Value="{$custOrg}"/>
      <SELLING_ORG_ID   Value="{$this/SELLER_ORG_ID/@Value}"/>
    </xcore:execute-method>
	
	<xapl:if test="string-length($response/RESPONSE/_RESULT/_ERROR/@Value) != 0">      
      <web:display-page>
        <web:get-page name="edit_org">
          <REFRESH_LOCAL Value="true"/>
          <ORG_ID Value="{$this/SELLER_ORG_ID/@Value}"/>
          <ERROR Value="{$response/RESPONSE/_RESULT/_ERROR/@Value}"/>
        </web:get-page>
      </web:display-page>
    </xapl:if>
    
    <web:display-page>
      <web:get-page name="edit_org">
        <ORG_ID Value="{$this/SELLER_ORG_ID/@Value}"/>
		<STATUS_MSG Value="Save Successful."/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  
  <!--**********************************************************************
  ***********************************************************************-->
  <x2:command public="yes" description="_" name="changeLocalSellerStatus">

    <xapl:variable name="custOrg">
      <x2:execute command="omx.add_book.org.model:getUserCustomerOrg"/>
    </xapl:variable>
	
	 <!-- API -->    
    <xapl:variable name="changeStatusAPI" select="'//UserSecurity/setEnabledSellingOrganizationStatus'"/>
    <!-- If status is passed -->       
    <xapl:if test="string-length($this/LOCAL_SELLER_STATUS/@Value) > 0">
      <xcore:execute-method name="{$changeStatusAPI}">
        <CUSTOMER_ORG_ID Value="{$custOrg}"/>
      	<SELLING_ORG_ID Value="{$this/SELLER_ORG_ID/@Value}"/>    
        <xapl:choose>
          <xapl:when test="{$this/LOCAL_SELLER_STATUS/@Value = 'ACTIVE'}">
            <STATUS Value="DORMANT"/>
          </xapl:when>
          <xapl:when test="{$this/LOCAL_SELLER_STATUS/@Value = 'DORMANT'}">
            <STATUS Value="ACTIVE"/>
          </xapl:when>
        </xapl:choose>
      </xcore:execute-method>
    </xapl:if>
	
	<xapl:variable name="statusMsg">
	  <xapl:choose>
	    <xapl:when test="{$this/LOCAL_SELLER_STATUS/@Value = 'ACTIVE'}">
		  <STATUS_MSG Value="Deactivate Successful."/>
        </xapl:when>
        <xapl:when test="{$this/LOCAL_SELLER_STATUS/@Value = 'DORMANT'}">
		  <STATUS_MSG Value="Activate Successful."/>
        </xapl:when>
      </xapl:choose>
	</xapl:variable>

    <web:display-page>
      <web:get-page name="edit_org">
        <ORG_ID Value="{$this/SELLER_ORG_ID/@Value}"/>
        <CUSTOMER_ORG_ID Value="{$this/SELLER_ORG_ID/@Value}"/>
		<xapl:value-of select="{$statusMsg}"/>
      </web:get-page>
    </web:display-page>

  </x2:command>
  
  <!-- **********************************************************************
  *********************************************************************** -->

</x2:commands>
