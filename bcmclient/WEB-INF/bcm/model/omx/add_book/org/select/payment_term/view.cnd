<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
	<!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
	
    <!-- Search Param Overrides - Start:-->    
    <xapl:variable name="searchParams">
      <SEARCH_PARAM>
      </SEARCH_PARAM>
    </xapl:variable>  
    <!-- Search Param Overrides.  End-->    
    
    <xapl:return>

      <!-- Header -->
      <x2:execute command="omx.add_book.org.select.payment_term.view:getHeader"/>
      
      <!-- Tabs -->
      <x2:execute command="omx.add_book.org.select.payment_term.view:getContainer">
        <x2:with-param name="pPage" select="'select_payment_term'"/>
        <x2:with-param name="pHide" select="$this/TABS_HIDE/@Value"/>
        <x2:with-param name="pReturnLink" select="$this/RET_PAGE/@Value"/>
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
	  
      <!-- Search / Form and Report -->  
      <x2:execute command="core.search.search:getSearch">
        <x2:with-param name="this" select="{$this}"/>
        <x2:with-param name="pSearchParam" select="{$searchParam}"/>
        <x2:with-param name="pSearchFormConfigSource" select="'omx.add_book.org.select.payment_term.view:getFormConfig'"/>
        <x2:with-param name="pSearchReportConfigSource" select="'omx.add_book.org.select.payment_term.view:getReportConfig'"/>
        <x2:with-param name="pReportDataSource" select="'omx.add_book.org.select.payment_term.view:getReportData'"/>
      </x2:execute>
      
      <xapl:print> returning from load this <xapl:value-of select="{$this}"/> </xapl:print>
    </xapl:return>
    
  </x2:command>  
	
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    
	<xapl:variable name="orgHeader" enforceList="true">
      <x2:execute command="omx.add_book.org.view:getHeader">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
    </xapl:variable>

    <xapl:variable name="orgPage">
      <web:get-page name="org_overview">
	    <ORG_ID Value="{$addBookCurrOrgId/@Value}"/>
		<CUSTOMER_ORG_ID Value="{$addBookCurrOrgId/@Value}"/>
		<IN_PRIMARY_DOMAIN Value="{$s_inPrimaryDomain}"/>
      </web:get-page>
    </xapl:variable>

    <xapl:return>
      <HEADER>
      <HEADING3 Value="Search Terms"/>
      <HEADING2_LINK Value="{$orgPage}"/>
      <xapl:value-of select="$orgHeader/*"/>
      </HEADER>
    </xapl:return>

  </x2:command>	

  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <x2:param name="pPage"/>
    
    <xapl:return>
      
      <CONTAINER>
        
		<xapl:variable name="url">
		  <web:get-page name="select_term_help"/>
        </xapl:variable>
    
        <HELP Url="{$url}"/>
        
        <STEP
             DisplayText="Search Payment Terms" 
             OnClick="{$pages:select_payment_term}" 
             Selected="{$pPage = 'select_payment_term'}">
        </STEP>
	  </CONTAINER>
      
    </xapl:return>
    
  </x2:command>
  
    <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getFormConfig">
	
	<xapl:variable name="user">
	  <xcore:execute-method name="//UserSecurity/getUser">
	    <ID Value="{identity-user-id()}"/>
	  </xcore:execute-method>
	</xapl:variable>
	  
	<xapl:print select="$user"/>
	    
    <xapl:return>
      
      <!-- Search Fields -->
      <FORM  MethodName="//UserSecurity/getPaymentTerms" Name="search_form"  Target="appFrame">
        
        <FIELD
		  Type="Text" 
		  DisplayText="Name" 
		  Name="NAME" 
		  Value="{$this/NAME/@Value}" 
		  Visibility="Simple"/>
		  
		<FIELD
		    Type="Hidden"
			Name="SELLING_ORG_ID"
			Value="{$this/SELLING_ORG_ID/@Value}"/>
			
        <!-- Always Put hidden at the end -->
        <x2:execute command="omx.search.search:getHiddenFields">
          <x2:with-param name="this" select="$this"/>
        </x2:execute>  
        
        <!-- Form Buttons -->
        <BUTTONS>
          <BUTTON 
                  Name="search" 
                  DisplayText="Search" 
                  OnClick="javascript:onSearch()" 
                  Emphasized="no"/>				
        </BUTTONS>
        
      </FORM>       
    </xapl:return>
      
    </x2:command>
    
    
    <!-- ********************************************************************** 
    *********************************************************************** -->
    <x2:command public="yes" description="_" name="getReportConfig">
      
	  <xapl:variable name="helpUrl">
        <web:get-page name="select_help"/>
      </xapl:variable>
      <xapl:return>
        <REPORT Selectable="Single" Scrollable="yes">
          <HELP Url="{$helpUrl}"/>
          <FIELDS>
          
          <FIELD 
		    Name="NAME"  
			DisplayText="Name"
			Sortable="yes"
			Url="payment_term/controller/details.cmd"
			UrlParam="All"/>
         
          <FIELD 
		    Name="DESCRIPTION"          
			DisplayText="Description"  
			Sortable="no"/>	   
          
		  <FIELD
		    Type="Hidden"
			Name="SELLING_ORG_ID"
			Value="{$this/SELLING_ORG_ID/@Value}"/>
          <!-- Hidden Fields -->
          <x2:execute command="omx.report.report:getHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute> 
		  
        </FIELDS>
		<BUTTONS>
		  <perm:is-allowed document="ORGANIZATION" action="terms">
        <BUTTON 
			  Name="DeleteTerm" 
			  DisplayText="Remove" 
			  OnClick="javascript:remove();" 
        Disabled="report"/>
        <DIVIDER/>
		    <BUTTON 
			  Name="AddNewTerm" 
			  DisplayText="Add New" 
			  OnClick="javascript:addNew();" 
			  Disabled="no"/>
        <DIVIDER/>
		  </perm:is-allowed>
		  <BUTTON 
		    Name="ViewDetails" 
			DisplayText="View Details"
			Emphasized="yes" 
			OnClick="javascript:details();" 
			Disabled="report"/>
		</BUTTONS>
		<PAGINATION/>
      </REPORT>
    </xapl:return>

    </x2:command>
    
 
    <!-- ********************************************************************** 
    *********************************************************************** -->
    <x2:command public="yes" description="_" name="getReportData">
      <x2:param name="pForm"/>
      <x2:param name="this"/>
    
    <xapl:variable name="userId"><identity:get-user-id/></xapl:variable>
    
    <xapl:variable name="data">
	  <!-- pDoSearch and user has entered any Search Field on the form-->
	  <xapl:if test="{($pForm/FIELD[@Name = 'DO_SEARCH']/@Value = 'Yes' ) and count($pForm/FIELD[@Type !='Hidden' and (string-length(@Value) > 0  or string-length(@Value1) >0 or string-length(@Value2) > 0)]) > 0}">
        <xcore:execute-method name="{$pForm/@MethodName}" StartAtRow="{$pForm/FIELD[@Name = 'START_COUNT']/@Value}" MaxRows="{$pForm/FIELD[@Name = 'MAX_ROWS']/@Value}" ReturnRowCount="{$this/RETURN_ROW_COUNT/@Value}">
          <!-- TODO :Genarate the FILTERS Automatically -->
          <FILTER Name="SELLING_ORG_ID">
            <xcore:search-by property="SELLING_ORG_ID" value="{$pForm/FIELD[@Name = 'SELLING_ORG_ID']/@Value}"/>
          </FILTER>
          <FILTER Name="NAME">
            <xcore:search-by property="NAME" value="{$pForm/FIELD[@Name = 'NAME']/@Value}"/>
          </FILTER>            
		  
		  <xapl:if test="string-length($pForm/FIELD[@Name = 'SORT_BY']/@Value) > 0 and string-length($pForm/FIELD[@Name = 'SORT_ORDER']/@Value) > 0">
			<ORDER_BY>
			  <docutil:element name="{$pForm/FIELD[@Name = 'SORT_BY']/@Value}" Sort="{$pForm/FIELD[@Name = 'SORT_ORDER']/@Value}"/>
			</ORDER_BY>
          </xapl:if>            
        </xcore:execute-method>
	  </xapl:if>
    </xapl:variable>

    <docutil:add select="$data">
      <TOTAL_RECORD_COUNT Value="{$data/@TotalRowCount}"/>
      <START_AT_ROW Value ="{$this/START_COUNT/@Value}"/>
    </docutil:add>
	    
	<xapl:print> Total record Count 
	  <xapl:value-of select="{$data}"/>
	</xapl:print>
	
    <xapl:return>
      <xapl:value-of select="{$data}"/>
    </xapl:return>
    
  </x2:command>
  
  <!-- **********************************************************************
  *********************************************************************** -->
</x2:commands>
