<?xml version="1.0" encoding="UTF-8"?>

<x2:commands description="_" 
             xmlns:FUNCTION="http://www.i2.com/FUNCTION" 
             xmlns:REMOVE="http://www.i2.com/REMOVE" 
             xmlns:cfg="http://www.i2.com/configurability" 
             xmlns:core="http://www.i2.com/core" 
             xmlns:omx="http://www.i2.com/omx" 
             xmlns:perm="http://www.i2.com/permissibility" 
             xmlns:util="http://www.i2.com/util" 
             xmlns:web="http://www.i2.com/web" 
             xmlns:x2="http://www.i2.com/x2" 
             xmlns:xapl="http://www.i2.com/xapl" 
             xmlns:xcore="http://www.i2.com/xcore" 
             xmlns:xcore-db="http://www.i2.com/xcore-db" 
             xmlns:docutil="http://www.i2.com/docutil" 
             xmlns:xudl="http://www.i2.com/xudl"
             xmlns:identity="http://www.i2.com/identity">  
  
  
  <!--************************************************************************-->
  
  <x2:command public="yes" description="_" name="getPageData">
    <xapl:return>
      
      <x2:execute command="omx.add_book.org.pages:getTabs">
	    <x2:with-param name="page">nexus</x2:with-param>
        <x2:with-param name="orgId"><xapl:value-of select="{$this/ORG_ID/@Value}" /></x2:with-param>
	  </x2:execute>
      
      <x2:execute command="omx.add_book.org.orgNexus:getNexusStates">
        <x2:with-param name="this" select="$this"/>
  	  </x2:execute>
	  
	  <xapl:choose>
	    <xapl:when test="isAllowed('ORG_NEXUS','edit')">
	      <EDITABLE Value="true"/>
		</xapl:when>
        <xapl:otherwise>
		  <EDITABLE Value="false"/>
		</xapl:otherwise>
	  </xapl:choose>
    </xapl:return>
  </x2:command>
  
  <!--************************************************************************-->
  
  <x2:command public="yes" description="_" name="getNexusStates">
    
    <xapl:variable name="getStatesResult">
      <x2:execute command="omx.cm:getStates"/>
    </xapl:variable>
    
    <xapl:variable name="fein">
	  <xcore:execute-method name="//UserSecurity/getOrganization">
	    <ID Value="{$this/ORG_ID/@Value}"/>
	  </xcore:execute-method>
    </xapl:variable>
    
    <xapl:variable name="getNexusStatesResult">
      <ROOT>
        <xcore:execute-method name="//UserSecurity/getNexusStates">
          <FEIN Value="{$fein/TAX_ID/@Value}"/>
        </xcore:execute-method>
      </ROOT>
    </xapl:variable>
    
    <xapl:for-each varName="temp" select="{$getNexusStatesResult/STATES/STATE/@Value}">
      <docutil:set select="{$getStatesResult/CODE_MASTER_VALUE[$temp = VALUE_ID/@Value]}">
        <CHECKED Value="true"/>
      </docutil:set>
    </xapl:for-each>
    
    <xapl:return>
      <xapl:value-of select="{$getStatesResult}"/>
      <FEIN Value="{$fein/TAX_ID/@Value}"/>
      <ORG_ID Value="{$this/ORG_ID/@Value}"/>
    </xapl:return>
    
  </x2:command>

  <!--************************************************************************-->
  
  <x2:command public="yes" description="_" name="updateNexus">
    
    <xapl:variable name="updateVar">
      <xapl:value-of select="{$this/FEIN}"/>
      <STATES>
        <xapl:value-of select="{$this/STATE}"/>
      </STATES>
    </xapl:variable>
    
    <xcore:execute-method name="//UserSecurity/setNexusStates">
      <xapl:value-of select="{$updateVar}"/>
    </xcore:execute-method>
    
    <web:display-page>
      <web:get-page name="org_nexus">
        <ORG_ID Value="{$this/ORG_ID/@Value}"/>
        <FEIN Value="{$this/FEIN/@Value}"/>
      </web:get-page>
    </web:display-page>
    
  </x2:command>

  <!--************************************************************************-->
  
  <x2:command public="yes" description="_" name="getNexusFCStates">
    
    <xapl:variable name="getStatesResult">
      <x2:execute command="omx.cm:getStates"/>
    </xapl:variable>

    <xapl:variable name="fein">
      <x2:execute command="omx.add_book.location.model:getFulfillmentCenter">
        <x2:with-param name="pId" select="{$this/FULFILLMENT_CENTER_ID/@Value}"/>
      </x2:execute> 
    </xapl:variable>
  
    <xapl:variable name="getNexusStatesResult">
      <ROOT>
        <xcore:execute-method name="//UserSecurity/getNexusStates">
          <FEIN Value="{$fein/TAX_ID/@Value}"/>
        </xcore:execute-method>
      </ROOT>
    </xapl:variable>
    
    <xapl:for-each varName="temp" select="{$getNexusStatesResult/STATES/STATE/@Value}">
      <docutil:set select="{$getStatesResult/CODE_MASTER_VALUE[$temp = VALUE_ID/@Value]}">
        <CHECKED Value="true"/>
      </docutil:set>
    </xapl:for-each>
    
    <xapl:return>
      <xapl:value-of select="{$getStatesResult}"/>
      <FEIN Value="{$fein/TAX_ID/@Value}"/>
      <FULFILLMENT_CENTER_ID Value="{$this/FULFILLMENT_CENTER_ID/@Value}"/>
    </xapl:return>
    
  </x2:command>
  
  <!--************************************************************************-->
  
  <x2:command public="yes" description="_" name="updateFCNexus">
    
    <xapl:variable name="updateVar">
      <xapl:value-of select="{$this/FEIN}"/>
      <STATES>
        <xapl:value-of select="{$this/STATE}"/>
      </STATES>
    </xapl:variable>
    <xcore:execute-method name="//UserSecurity/setNexusStates">
      <xapl:value-of select="{$updateVar}"/>
    </xcore:execute-method>
    <web:display-page>
      <web:get-page name="FC_nexus">
        <FULFILLMENT_CENTER_ID Value="{$this/FULFILLMENT_CENTER_ID/@Value}"/>
      </web:get-page>
    </web:display-page>
    
  </x2:command>
  
  <!--************************************************************************-->
  
</x2:commands>




