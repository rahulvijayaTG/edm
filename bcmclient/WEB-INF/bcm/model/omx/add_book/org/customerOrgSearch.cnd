<?xml version="1.0" encoding="utf-8"?>
<x2:commands description="_" xmlns:cfg="http://www.i2.com/configurability" xmlns:core="http://www.i2.com/core" xmlns:omx="http://www.i2.com/omx" xmlns:perm="http://www.i2.com/permissibility" xmlns:util="http://www.i2.com/util" xmlns:web="http://www.i2.com/web" xmlns:x2="http://www.i2.com/x2" xmlns:xapl="http://www.i2.com/xapl" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:docutil="http://www.i2.com/docutil" xmlns:xudl="http://www.i2.com/xudl" xmlns:identity="http://www.i2.com/identity" xmlns:i18n="http://www.i2.com/i18n">
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getSearchFormConfig">
    <xapl:return>
      <!-- Search Fields -->
      <FORM MethodName="//UserSecurity/getEnabledOrganizations" Name="search_form" Action="search.jsp" Method="GET" Target="appFrame">
        <FIELD Type="Text" DisplayText="Name" Name="FULL_NAME" Value="{$this/FULL_NAME/@Value}" Visibility="Simple"/>
        <FIELD Type="Hidden" Name="SELLING_ORG_ID" Value="{$this/SELLING_ORG_ID/@Value}" Visibility="Simple"/>
        <FIELD Type="Hidden" Name="ORG_ID" Value="{$this/ORG_ID/@Value}" Visibility="Simple"/>
        <FIELD Type="Text" DisplayText="Org. ID" Name="ID" Value="{$this/ID/@Value}" Visibility="Advanced"/>
        <FIELD Type="Text" DisplayText="Parent Org. ID" Name="PARENT_ORG_ID" Value="{$this/PARENT_ORG_ID/@Value}" Visibility="Advanced"/>
        <!-- Always Put hidden at the end -->
        <x2:execute command="omx.search.search:getHiddenFields">
          <x2:with-param name="this" select="$this"/>
        </x2:execute>
        <!-- Form Buttons -->
        <BUTTONS>
          <BUTTON Name="search" DisplayText="Search" OnClick="javascript:onSearch()" Emphasized="no"/>
        </BUTTONS>
      </FORM>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getSearchReportConfig">
    <xapl:variable name="helpUrl">
      <web:get-page name="add_book_report_help"/>
    </xapl:variable>
    <xapl:return>
      <REPORT Selectable="Single" Scrollable="yes" Id="CUSTOMER_ORG_ID">
        <HELP Url="{$helpUrl}"/>
        <FIELDS>
          <FIELD Name="NAME" DisplayText="Name" Sortable="yes" Url="../add_book/org/pages/redirectToCustomerOrgDetails.cmd" UrlParam="All"/>
          <FIELD Name="ADDRESS1" DisplayText="Address" Sortable="no"/>
          <FIELD Type="Hidden" Name="CUSTOMER_ORG_ID" DisplayText="Customer Org ID" Sortable="no"/>
          <!-- Hidden Fields -->
          <x2:execute command="omx.report.report:getHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
        </FIELDS>
      </REPORT>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportData">
    <x2:param name="pForm"/>
    <x2:param name="pIds"/>
    <x2:param name="pAddRecordCount" select="'true'"/>
    <!-- Give Defaults - Start:-->
    <xapl:variable name="addRecordCount" select="$pAddRecordCount"/>
    <xapl:variable name="statusFilter">
      <ROOT/>
    </xapl:variable>
    <xapl:variable name="userId">
      <identity:get-user-id/>
    </xapl:variable>
    <!-- <xapl:if test=" ($pForm/FIELD[@Name = 'SORT_BY']/@Value = 'NAME') ">
      <docutil:set select="$pForm/FIELD[@Name = 'SORT_BY']/@Value">FULL_NAME</docutil:set>
    </xapl:if> -->
    <xapl:variable name="data">
      <xapl:choose>
        <!-- pDoSearch and user has entered any Search Field on the form-->
        <xapl:when test="{($pForm/FIELD[@Name = 'DO_SEARCH']/@Value = 'Yes' ) and count($pForm/FIELD[@Type !='Hidden' and (string-length(@Value) > 0  or string-length(@Value1) >0 or string-length(@Value2) > 0)]) > 0}">
          <!-- Get Data -->
          <xcore:execute-method name="{$pForm/@MethodName}" StartAtRow="{$pForm/FIELD[@Name = 'START_COUNT']/@Value}" MaxRows="{$pForm/FIELD[@Name = 'MAX_ROWS']/@Value}" ReturnRowCount="{$this/RETURN_ROW_COUNT/@Value}">
            <!-- TODO :Genarate the FILTERS Automatically -->
            <FILTER Name="ADDRESS"/>
            <FILTER Name="ID">
              <xcore:search-by property="CUSTOMER_ORG_ID" value="{$pForm/FIELD[@Name = 'ID']/@Value}"/>
            </FILTER>
            <FILTER Name="SELLING_ORG_ID">
              <xcore:search-by property="SELLING_ORG_ID" value="{$pForm/FIELD[@Name = 'SELLING_ORG_ID']/@Value}"/>
            </FILTER>
            <FILTER Name="FULL_NAME">
              <xcore:search-by property="FULL_NAME" value="{$pForm/FIELD[@Name = 'FULL_NAME']/@Value}"/>
            </FILTER>
            <xapl:value-of select="$statusFilter"/>
            <FILTER Name="PARENT_ORG_ID">
              <xcore:search-by property="PARENT_ORG_ID" value="{$pForm/FIELD[@Name = 'PARENT_ORG_ID']/@Value}"/>
            </FILTER>
            <xapl:if test="string-length($pForm/FIELD[@Name = 'SORT_BY']/@Value) > 0 and string-length($pForm/FIELD[@Name = 'SORT_ORDER']/@Value) > 0">
              <ORDER_BY>
                <docutil:element name="{$pForm/FIELD[@Name = 'SORT_BY']/@Value}" Sort="{$pForm/FIELD[@Name = 'SORT_ORDER']/@Value}"/>
              </ORDER_BY>
            </xapl:if>
          </xcore:execute-method>
        </xapl:when>
        <!-- pIds or pGetRecent -->
        <xapl:otherwise>
          <xapl:if test="{($pForm/FIELD[@Name = 'DO_SEARCH']/@Value != 'Yes' ) or count($pIds/ID) > 0}">
            <!-- Get Ids -->
            <xapl:variable name="ids">
              <IDS>
                <xapl:choose>
                  <!-- If ids are passed -->
                  <xapl:when test="count($pIds/ID) > 0">
                    <xapl:value-of select="$pIds/ID"/>
                  </xapl:when>
                  <!-- Other wise get recent ids-->
                  <xapl:otherwise>
                    <omx:get-recent max="10" userId="{$userId}">
                      <!-- TODO: get DOC_GROUP -->
                      <TRANSACTION>
                        <docutil:element name="{$pForm/FIELD[@Name = 'OBJECT_TYPE']/@Value}"/>
                      </TRANSACTION>
                    </omx:get-recent>
                  </xapl:otherwise>
                </xapl:choose>
              </IDS>
            </xapl:variable>
            <!-- Get data -->
            <xapl:if test="{count($ids/*) > 0}">
              <xapl:set-variable name="addRecordCount" select="'false'"/>
              <xcore:execute-method name="{$pForm/@MethodName}" ReturnRowCount="{$this/RETURN_ROW_COUNT/@Value}">
                <FILTER Name="ID">
                  <OR>
                    <xapl:value-of select="{$ids/ID}"/>
                  </OR>
                </FILTER>
                <xapl:if test="string-length($pForm/FIELD[@Name = 'SORT_BY']/@Value) > 0 and string-length($pForm/FIELD[@Name = 'SORT_ORDER']/@Value) > 0">
                  <ORDER_BY>
                    <docutil:element name="{$pForm/FIELD[@Name = 'SORT_BY']/@Value}" Sort="{$pForm/FIELD[@Name = 'SORT_ORDER']/@Value}"/>
                  </ORDER_BY>
                </xapl:if>
              </xcore:execute-method>
            </xapl:if>
            <!-- If ids -->
          </xapl:if>
          <!-- DO_SEARCH != yes or pIds -->
        </xapl:otherwise>
        <!-- DO_SEARCH !=yes and user entered nothing -->
      </xapl:choose>
    </xapl:variable>
    <!-- Add the total record count  -->
    <!-- Add the total record count  -->
    <docutil:add select="$data">
      <TOTAL_RECORD_COUNT Value="{$data/@TotalRowCount}"/>
      <START_AT_ROW Value="{$this/START_COUNT/@Value}"/>
    </docutil:add>
    <!-- Add the total record count  -->
    <xapl:print select="$data"/>
    <xapl:return>
      <xapl:value-of select="{$data}"/>
    </xapl:return>
  </x2:command>
</x2:commands>
