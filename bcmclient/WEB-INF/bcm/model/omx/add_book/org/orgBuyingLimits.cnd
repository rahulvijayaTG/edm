<?xml version="1.0" encoding="UTF-8"?>
<x2:commands description="_" 
             xmlns:FUNCTION="http://www.i2.com/FUNCTION" 
             xmlns:REMOVE="http://www.i2.com/REMOVE" 
             xmlns:cfg="http://www.i2.com/configurability" 
             xmlns:core="http://www.i2.com/core" 
             xmlns:omx="http://www.i2.com/omx" 
             xmlns:perm="http://www.i2.com/permissibility" 
             xmlns:util="http://www.i2.com/util" 
             xmlns:web="http://www.i2.com/web" 
             xmlns:x2="http://www.i2.com/x2" 
             xmlns:xapl="http://www.i2.com/xapl" 
             xmlns:xcore="http://www.i2.com/xcore" 
             xmlns:xcore-db="http://www.i2.com/xcore-db" 
             xmlns:docutil="http://www.i2.com/docutil" 
             xmlns:xudl="http://www.i2.com/xudl"
             xmlns:identity="http://www.i2.com/identity">  
  
  
  <!--************************************************************************-->   
  
  <x2:command public="yes" description="_" name="getPageData">

    <xapl:variable name="entity">
       <x2:execute command="omx.add_book.org.model:getOrganization">
          <x2:with-param name="orgId"><xapl:value-of select="$this/ORG_ID/@Value" /></x2:with-param>
       </x2:execute>
    </xapl:variable>

    <xapl:variable name="sellingOrg">
      <x2:execute command="omx.add_book.org.model:getUserSellingOrg"/>
    </xapl:variable>

    <xapl:variable name="paymentMethods">
      <ROOT>
        <xcore:execute-method name="//UserSecurity/getPaymentMethods"/>
      </ROOT>
    </xapl:variable>

    <xapl:variable name="data">
      <x2:execute command="omx.add_book.org.pages:getTabs">
        <x2:with-param name="page">buying_limits</x2:with-param>
        <x2:with-param name="orgId"><xapl:value-of select="{$this/ORG_ID/@Value}" /></x2:with-param>
      </x2:execute>

      <!-- get the currency code for the organization -->
      <CURRENCY_CODE Value="{$entity/CURRENCY_CODE/@Value}"/>

      <!-- get the list of periods -->
      <PERIODS>
        <xcore:execute-method name="//UserSecurity/getBuyingLimitDurations">
        </xcore:execute-method>
      </PERIODS>

      <!-- get the buying limits for the organization -->
      <xcore:execute-method name="//UserSecurity/getOrgBuyingLimit">
        <CUSTOMER_ORG_ID Value="{$this/ORG_ID/@Value}"/>
        <SELLING_ORG_ID Value="{$sellingOrg}"/>
      </xcore:execute-method>

      <!-- get the buying limits for the payment methods -->
      <PAYMENT_METHODS>
        <xapl:for-each varName="pm" select="{$paymentMethods/CODE_MASTER_VALUE}">
          <PAYMENT_METHOD>
            <PAYMENT_INST_TYPE Value="{$pm/VALUE_ID/@Value}"/>
            <PAYMENT_INST_DESCRIPTION Value="{$pm/DESCRIPTION/@Value}"/>
            <xcore:execute-method name="//UserSecurity/getPaymentMethodBuyingLimit">
              <CUSTOMER_ORG_ID Value="{$this/ORG_ID/@Value}"/>
              <SELLING_ORG_ID Value="{$sellingOrg}"/>
              <PAYMENT_INST_TYPE Value="{$pm/VALUE_ID/@Value}"/>
            </xcore:execute-method>
          </PAYMENT_METHOD>
        </xapl:for-each>
      </PAYMENT_METHODS>

      <xapl:value-of select="{$this/SUCCESS_MESSAGE}"/>
      <xapl:value-of select="{$this/ERROR_MESSAGE}"/>
    </xapl:variable>
        
    <xapl:print>############################getPageData<xapl:value-of select="$data"/></xapl:print>
        
    <xapl:return>
      <xapl:value-of select="{$data}"/>
	  <xapl:value-of select="{$this/ORG_ID}"/>
    </xapl:return>
  </x2:command>
  
  <!--************************************************************************-->   

</x2:commands>
