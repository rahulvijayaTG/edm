<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">    
	
	<xapl:variable name="entity">
	  <x2:execute command="omx.add_book.org.model:getOrganization">
        <x2:with-param name="pRefresh" select="$this/REFRESH/@Value"/>               
        <x2:with-param name="orgId" select="{$this/ORG_ID/@Value}"/>
        <x2:with-param name="parentOrgId" select="{$this/PARENT_ORG_ID/@Value}" />
      </x2:execute>
	</xapl:variable>

	<xapl:print select="$entity"/>
	
	<xapl:return>  
	
	  <!-- Header -->
      <x2:execute command="omx.add_book.org.view:getHeader">
	    <x2:with-param name="this" select="$this"/>
	  </x2:execute>
      
      <!-- Container -->
      <x2:execute command="omx.add_book.org.add.view:getContainer">
        <x2:with-param name="pPage" select="'add_org'"/>
        <x2:with-param name="pHide" select="$this/HIDE_TABS/@Value"/>
        <x2:with-param name="pReturnLink" select="$this/RET_PAGE/@Value"/>
		<x2:with-param name="pEntity" select="{$entity}"/>
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
      
      <xapl:value-of select="{$entity}"/>
	  
	  <x2:execute command="omx.add_book.org.add.view:getData"> 
	    <x2:with-param name="this" select="{$this}"/>
		<x2:with-param name="pEntity" select="{$entity}"/>
	  </x2:execute>
        
    </xapl:return>
    
  </x2:command> 

  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <x2:param name="pPage"/>
	<x2:param name="pEntity"/>

    <xapl:variable name="conTitle">
      <xapl:choose>
       <xapl:when test="{string-length($addBookCurrOrgId/@Value) > 0}">
         <xapl:value-of select="'Add Child Organization'" />
       </xapl:when>
       <xapl:otherwise>
         <xapl:value-of select="'Add Organization'" />
       </xapl:otherwise>
      </xapl:choose>
    </xapl:variable>

    <xapl:return>
      
      <CONTAINER>
        <xapl:variable name="url">
          <web:get-page name="add_org_help"/>
        </xapl:variable>
    
        <HELP Url="{$url}"/>
        
        <STEP
             DisplayText="{$conTitle}" 
             OnClick="{$pages:add_org}" 
             Selected="{$pPage = 'add_org'}">
          
          <BUTTONS>
            	
			<BUTTON 
                    Name="Reset" 
                    DisplayText="Reset" 
                    OnClick="javascript:reset();" 
                    Disabled="report"/>

            <xapl:choose>
			  <xapl:when test="$pEntity/CUSTOMER_STATUS/@Value='ACTIVE' or $pEntity/SELLER_STATUS/@Value='ACTIVE'">					
			    <BUTTON 
				  Name="Save" 
				  DisplayText="Save" 
				  Emphasized="yes"
				  OnClick="javascript:save();" 
				  Disabled="no"/>
			  </xapl:when>
			  <xapl:otherwise>
			    <BUTTON 
				  Name="Save" 
				  DisplayText="Save" 
				  Emphasized="yes"
				  OnClick="javascript:save();" 
				  Disabled="yes"/>
			  </xapl:otherwise>
			</xapl:choose>
            
          </BUTTONS>
          
        </STEP>
        
      </CONTAINER>
      
    </xapl:return>
    
  </x2:command>
  
   <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getData">
    <x2:param name="pEntity"/>
    <x2:param name="this"/>
  
    <xapl:variable name="data">
  	  <x2:execute command="omx.add_book.messaging:getMessagingOptions">
        <x2:with-param name="entityType">Org</x2:with-param>
        <x2:with-param name="pOrgId" select="{$this/ORG_ID/@Value}"/>
        <x2:with-param name="pRefresh" select="$this/REFRESH/@Value"/>
      </x2:execute>
      
      <x2:execute command="omx.add_book.org.model:getLocalCustomer">
        <x2:with-param name="orgId" select="{$this/ORG_ID/@Value}"/>
		<x2:with-param name="pEditable" select="{$this/LOCAL_EDITABLE/@Value}"/>
      </x2:execute>
	  
	  <x2:execute command="omx.add_book.org.model:getLocalSeller">
        <x2:with-param name="orgId" select="$this/ORG_ID/@Value"/>
        <x2:with-param name="pRefresh" select="$this/REFRESH/@Value"/>
      </x2:execute>
      
      <x2:execute command="omx.add_book.location.model:getFulfillmentCenters">
        <x2:with-param name="org_id" select="$this/ORG_ID/@Value"/>
      </x2:execute>
      
	  <x2:execute command="omx.cm:getStatesForCountry">
         <x2:with-param name="pCountry" select="$pEntity/COUNTRY/@Value"/>
      </x2:execute>
	  
      <x2:execute command="omx.cm:getCountries">
        <x2:with-param name="pDefaultCountry" select="$pEntity/COUNTRY/@Value"/>
      </x2:execute>
      
      <x2:execute command="omx.cm:getCustomerTypes"/>
      <x2:execute command="omx.cm:getConversionMethods"/>
      <x2:execute command="omx.cm:getCurrencyCodes"/>
      <x2:execute command="omx.cm:getTaxCodes"/>
      <x2:execute command="omx.cm:getPricingTemplates"/>  
      
      <x2:execute command="omx.alert:getAlerts">
        <x2:with-param name="pRefresh"><xapl:value-of select="$this/REFRESH/@Value"/></x2:with-param>
        <x2:with-param name="pERROR"><xapl:value-of select="$this/ERROR/@Value"/></x2:with-param>
        <x2:with-param name="pStatusMsg"><xapl:value-of select="$this/STATUS_MSG/@Value"/></x2:with-param>
      </x2:execute>
	</xapl:variable>
	
	<xapl:return>
	  <xapl:value-of select="$data"/>
	</xapl:return> 
	 
  </x2:command>
    
  <!-- **********************************************************************
  *********************************************************************** -->
  
</x2:commands>
