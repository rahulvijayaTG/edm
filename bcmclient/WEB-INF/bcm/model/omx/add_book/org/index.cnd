<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:tree="http://www.i2.com/tree" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" description="_">

  <x2:command public="yes" description="_" name="getPageData">

    <xapl:print>GETORGS data....<xapl:value-of select="$this/*"/></xapl:print>
    <xapl:return>
      <x2:execute command="omx.add_book.org.model:getOrganizations">
        <x2:with-param name="pOrgSearchCriteria" select="$this/ORG_SEARCH_CRITERIA/@Value"/>
        <x2:with-param name="pCustOrgId" select="$this/CUSTOMER_ORG_ID/@Value"/>
      </x2:execute>
    </xapl:return>

  </x2:command>

  <!-- *************************************************************** -->
  <x2:command public="yes" description="_" name="loadHeader">

    <xapl:return>
    <x2:execute command="omx.index:getHeader">
      <x2:with-param name="pHeading" select="'AddressBook - Organization'"/>
      <x2:with-param name="pToggle" select="'../../'"/>
    </x2:execute>
    </xapl:return>

  </x2:command>



</x2:commands>