            <VALUE_ID Value="ACTIVITY_ORDER"/>
            <DESCRIPTION Value="Activity Orders"/>
          </DOC_TYPE>
        </perm:is-allowed>
        <perm:is-allowed document="SEARCH" action="shipments">
          <DOC_TYPE>
            <VALUE_ID Value="SHIPMENT"/>
            <DESCRIPTION Value="Shipments"/>
          </DOC_TYPE>
        </perm:is-allowed>
        <perm:is-allowed document="SEARCH" action="invoices">
          <DOC_TYPE>
