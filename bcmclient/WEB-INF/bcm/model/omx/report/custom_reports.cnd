<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:oa="http://www.i2.com/oa" xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getSearchFormConfig">
    <xapl:return>
      <!-- Search Fields -->
      <FORM DataSourceName="UserSecurity//SAVED_SEARCH" DataSourceType="Document" Name="search_form" Action="search.jsp" Method="GET" Target="appFrame">
        <FIELD Type="Text" DisplayText="Name" Name="SAVED_SEARCH_NAME" Value="{$this/SAVED_SEARCH_NAME/@Value}" Visibility="Simple"/>
        <FIELD Type="Select" DisplayText="Doc Type" Name="SAVED_DOC_TYPE" Value="{$this/SAVED_DOC_TYPE/@Value}" Visibility="Simple" DataSourceType="Command" DataSourceName="omx.report.custom_reports:getDocTypes"/>
        <!-- Always Put hidden at the end -->
        <x2:execute command="omx.search.search:getHiddenFields">
          <x2:with-param name="this" select="$this"/>
        </x2:execute>
        <!-- Form Buttons -->
        <BUTTONS>
          <BUTTON Name="search" DisplayText="Search" OnClick="javascript:onSearch()" Emphasized="yes"/>
        </BUTTONS>
      </FORM>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getSearchReportConfig">
    <xapl:return>
      <REPORT Selectable="All" Id="NAME">
        <HELP Url="../help/search_res.htm"/>
        <FIELDS>
          <FIELD Name="NAME" DisplayText="Name" Sortable="yes" Url="../report/custom_reports/view.cmd" UrlParam="All"/>
          <FIELD Name="DOC_TYPE" Sortable="yes" DisplayText="Doc Type"/>
          <!-- Hidden Fields -->
          <FIELD Name="NAME" Type="Hidden" DisplayType="Hidden"/>
          <FIELD Name="DOC_TYPE" Type="Hidden" DisplayType="Hidden"/>
          <x2:execute command="omx.report.report:getHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
        </FIELDS>
      </REPORT>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportData">
    <x2:param name="pForm"/>
    <xapl:variable name="userId">
      <identity:get-user-id/>
    </xapl:variable>
    <xapl:variable name="data">
      <SAVED_SEARCHES>
        <xapl:choose>
          <xapl:when test="{($pForm/FIELD[@Name = 'DO_SEARCH']/@Value = 'Yes' ) and count($pForm/FIELD[@Type !='Hidden' and (string-length(@Value) > 0  or string-length(@Value1) >0 or string-length(@Value2) > 0)]) > 0}">
            <xcore:get-document name="//UserSecurity/SAVED_SEARCH" StartAtRow="{$pForm/FIELD[@Name = 'START_COUNT']/@Value}" MaxRows="{$pForm/FIELD[@Name = 'MAX_ROWS']/@Value}">
              <USER_ID Value="{$userId}"/>
              <xcore:search-by property="NAME" value="{$pForm/FIELD[@Name = 'SAVED_SEARCH_NAME']/@Value}"/>
              <xcore:search-by property="DOC_TYPE" value="{$pForm/FIELD[@Name = 'SAVED_DOC_TYPE']/@Value}"/>
            </xcore:get-document>
          </xapl:when>
          <!-- Get Recent -->
          <xapl:otherwise>
            <xapl:if test="{($pForm/FIELD[@Name = 'DO_SEARCH']/@Value != 'Yes' )}">
              <!-- Get Recent Ids -->
              <xapl:variable name="recentIds">
                <ROOT>
                  <omx:get-recent max="10" userId="{$userId}">
                    <xapl:value-of select="{$pForm/FIELD[@Name = 'OBJECT_TYPE']/@Value}"/>
                  </omx:get-recent>
                </ROOT>
              </xapl:variable>
              <!-- Get data-->
              <xcore:get-document name="//UserSecurity/SAVED_SEARCH" StartAtRow="{$pForm/FIELD[@Name = 'START_COUNT']/@Value}" MaxRows="{$pForm/FIELD[@Name = 'MAX_ROWS']/@Value}">
                <USER_ID Value="{$userId}"/>
                <xapl:if test="{count($recentIds) != 0}">
                  <FILTER Name="ID">
                    <OR>
                      <xapl:value-of select="{$recentIds/ID}"/>
                    </OR>
                  </FILTER>
                </xapl:if>
                <ORDER_BY>
                  <docutil:element name="{$pForm/FIELD[@Name = 'SORT_BY']/@Value}" Sort="{$pForm/FIELD[@Name = 'SORT_ORDER']/@Value}"/>
                </ORDER_BY>
              </xcore:get-document>
            </xapl:if>
          </xapl:otherwise>
        </xapl:choose>
      </SAVED_SEARCHES>
    </xapl:variable>
    <!-- Add the total record count  -->
    <xapl:variable name="recordCount">
      <x2:execute command="omx.report.custom_reports:getRecordCount">
        <x2:with-param name="pForm" select="$pForm"/>
      </x2:execute>
    </xapl:variable>
    <docutil:add select="$data">
      <TOTAL_RECORD_COUNT Value="{$recordCount}"/>
      <START_AT_ROW Value="{$pForm/FIELD[@Name = 'START_COUNT']/@Value}"/>
    </docutil:add>
    <!-- Add the total record count  -->
    <xapl:return>
      <xapl:value-of select="{$data}"/>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getRecordCount">
    <x2:param name="pForm"/>
    <xapl:variable name="userId">
      <identity:get-user-id/>
    </xapl:variable>
    <xapl:variable name="data">
      <SAVED_SEARCHES>
        <xcore:get-document name="//UserSecurity/SAVED_SEARCH">
          <USER_ID Value="{$userId}"/>
          <xcore:search-by property="NAME" value="{$pForm/FIELD[@Name = 'SAVED_SEARCH_NAME']/@Value}"/>
          <xcore:search-by property="DOC_TYPE" value="{$pForm/FIELD[@Name = 'SAVED_DOC_TYPE']/@Value}"/>
        </xcore:get-document>
      </SAVED_SEARCHES>
    </xapl:variable>
    <xapl:return>
      <xapl:value-of select="{count($data/*)}"/>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="view">
    <xapl:variable name="userId">
      <identity:get-user-id/>
    </xapl:variable>
    <!-- First get the custom report -->
    <xapl:variable name="responses">
      <xcore:execute-method name="//UserSecurity/getSavedSearch" entireResponse="true">
        <ID Value="{$this/ID[position() = 1]/@Value}"/>
        <NAME Value="{$this/NAME[position() = 1]/@Value}"/>
        <DOC_TYPE Value="{$this/DOC_TYPE[position() = 1]/@Value}"/>
      </xcore:execute-method>
    </xapl:variable>
    <!-- If error give message -->
    <xapl:if test="{$responses/@Status = 'Error'}">
      <web:display-page>
        <web:get-page name="message_page">
          <MESSAGE Value="{$responses/RESPONSE/_RESULT/_ERROR/@Value}"/>
          <TITLE Value="Retrieving Saved Search Error"/>
          <RETURN Value="true"/>
          <CANCEL/>
        </web:get-page>
      </web:display-page>
    </xapl:if>
    <!-- Unwrap the result into page parameters -->
    <xapl:variable name="param">
      <PARAMETERS>
        <xapl:for-each varName="field" select="{$responses/RESPONSE/SAVED_SEARCH/SEARCH_PARAMETERS_LINK/SEARCH_PARAMETERS}">
          <docutil:element name="{$field/FIELD_NAME/@Value}" Value="{$field/FIELD_VALUE/@Value}"/>
        </xapl:for-each>
      </PARAMETERS>
    </xapl:variable>
    <!-- Display search page with the parameters -->
    <x2:execute command="omx.report.custom_reports:display">
      <x2:with-param name="pSearchParameters" select="{$param}"/>
      <x2:with-param name="pDocType" select="{$responses/RESPONSE/SAVED_SEARCH/DOC_TYPE/@Value}"/>
      <x2:with-param name="pCustomReportName" select="{$responses/RESPONSE/SAVED_SEARCH/NAME/@Value}"/>
      <x2:with-param name="pSavedSearchId" select="{$responses/RESPONSE/SAVED_SEARCH/ID/@Value}"/>
    </x2:execute>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="delete">
    <xapl:variable name="userId">
      <identity:get-user-id/>
    </xapl:variable>
    <!-- Name is passed as ID -->
    <xapl:for-each varName="name" select="{$this/ID}">
      <xcore:execute-method name="//UserSecurity/deleteSavedSearch">
        <NAME Value="{$name/@Value}"/>
      </xcore:execute-method>
    </xapl:for-each>
    <web:display-page>
      <web:get-page name="message_page">
        <MESSAGE Value="Your Custom Report has been deleted!"/>
        <TITLE Value="Delete Custom Report"/>
        <OK Value="true"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="update">
    <xapl:variable name="userId">
      <identity:get-user-id/>
    </xapl:variable>
    <!-- API CAll -->
    <xapl:variable name="responses">
      <xcore:execute-method name="//UserSecurity/setSavedSearch" entireResponse="true">
        <NAME Value="{$sSearchCriteria/SAVED_SEARCH_NAME/@Value}"/>
        <DOC_TYPE Value="{$sSearchCriteria/SAVED_DOC_TYPE/@Value}"/>
        <xapl:value-of select="{$sSearchCriteria/*}"/>
      </xcore:execute-method>
    </xapl:variable>
    <!-- Error Message -->
    <xapl:if test="{count($responses/RESPONSE/_RESULT/_ERROR) > 0}">
      <web:display-page>
        <web:get-page name="message_page">
          <MESSAGE Value="{$responses/RESPONSE/_RESULT/_ERROR/@Value}"/>
          <TITLE Value="Updating Search Error"/>
          <RETURN Value="true"/>
          <CANCEL Value="true"/>
        </web:get-page>
      </web:display-page>
    </xapl:if>
    <!-- Success Message -->
    <xapl:variable name="docType">
      <xapl:value-of select="{$sSearchCriteria/SAVED_DOC_TYPE}"/>
    </xapl:variable>
    <xapl:variable name="idLink">
      <xapl:value-of select="{concat('report/custom_reports/view.cmd?ID=',$sSearchCriteria/SAVED_SEARCH_ID/@Value,'&amp;NAME=',$sSearchCriteria/SAVED_SEARCH_NAME/@Value)}"/>
    </xapl:variable>
    <web:display-page>
      <web:get-page name="message_page">
        <MESSAGE Value="Your Search Criteria has been successfully updated!"/>
        <TITLE Value="Confimation"/>
        <OK Value="true"/>
        <ID Value="{$sSearchCriteria/SAVED_SEARCH_ID/@Value}"/>
        <ID_LINK Value="{$idLink}"/>
        <DOC_TYPE Value="Search"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="display">
    <x2:param name="pSearchParameters"/>
    <x2:param name="pCustomReportName"/>
    <x2:param name="pSavedSearchId"/>
    <x2:param name="pDocType" select="{$this/DOC_TYPE/@Value}"/>
<!--
<xapl:print>
in display
this <xapl:value-of select="{$this}"/>
pDocType <xapl:value-of select="{$pDocType}"/>
</xapl:print>
-->
    <!-- Get The Page Name -->
    <xapl:variable name="searchPage">
      <x2:execute command="omx.report.custom_reports:getSearchPageName">
        <x2:with-param name="pDocType" select="{$pDocType}"/>
      </x2:execute>
    </xapl:variable>
<!--
<xapl:print>
searchPage <xapl:value-of select="{$searchPage}"/>
</xapl:print>
-->
    <!-- Display Page -->
    <web:display-page>
      <web:get-page name="{$searchPage}">
        <xapl:value-of select="{$pSearchParameters/*}"/>
        <xapl:if test="{string-length($pCustomReportName) !=0}">
          <SAVED_SEARCH_NAME Value="{$pCustomReportName}"/>
        </xapl:if>
        <xapl:if test="{string-length($pSavedSearchId) !=0}">
          <SAVED_SEARCH_ID Value="{$pSavedSearchId}"/>
        </xapl:if>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getSearchPageName">
    <x2:param name="pDocType" select="{$this/DOC_TYPE/@Value}"/>
    <xapl:variable name="searchPage">
      <xapl:choose>
        <xapl:when test="{$pDocType = 'SUGGESTED_ORDER'}">suggested_order_search</xapl:when>
        <xapl:when test="{$pDocType = 'SO_LINE_ITEM'}">so_line_item_search</xapl:when>
        <xapl:when test="{$pDocType = 'PURCHASE_ORDER'}">purchase_order_search</xapl:when>
        <xapl:when test="{$pDocType = 'PO_LINE_ITEM'}">po_line_item_search</xapl:when>
        <xapl:when test="{$pDocType = 'TRANSFER_ORDER'}">transfer_order_search</xapl:when>
        <xapl:when test="{$pDocType = 'TO_LINE_ITEM'}">to_line_item_search</xapl:when>
        <xapl:when test="{$pDocType = 'BPO'}">bpo_search</xapl:when>
        <xapl:when test="{$pDocType = 'ORDER'}">saved_order</xapl:when>
        <xapl:when test="{$pDocType = 'QUOTE'}">saved_quote</xapl:when>
        <xapl:when test="{$pDocType = 'TEMPLATE'}">saved_template</xapl:when>
        <xapl:when test="{$pDocType = 'DRAFT'}">saved_draft</xapl:when>
        <xapl:when test="{$pDocType = 'ACTIVITY_ORDER'}">saved_activity_order</xapl:when>
        <xapl:when test="{$pDocType = 'SHIPMENT'}">saved_shipment</xapl:when>
        <xapl:when test="{$pDocType = 'INVOICE'}">saved_invoice</xapl:when>
        <xapl:when test="{$pDocType = 'ORDER_ERROR'}">saved_edi</xapl:when>
        <xapl:when test="{$pDocType = 'RETURN_REPAIR_ORDER'}">return_order_search_display</xapl:when>
        <xapl:when test="{$pDocType = 'SERVICE_PURCHASE_ORDER_TRACKING'}">service_po_tracking_search_display</xapl:when>
        <xapl:when test="{$pDocType = 'SERVICE_PURCHASE_ORDER_UPDATE'}">service_po_update_search_display</xapl:when>        
        <xapl:when test="{$pDocType = 'RMA'}">saved_rma</xapl:when>
      </xapl:choose>
    </xapl:variable>
    <xapl:return>
      <xapl:value-of select="{$searchPage}"/>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getDocTypes">
    <xapl:return>
      <DOC_TYPES>
        <perm:is-allowed document="SEARCH" action="suggested_orders">
          <DOC_TYPE>
            <VALUE_ID Value="SUGGESTED_ORDER"/>
            <DESCRIPTION Value="Suggested Orders"/>
          </DOC_TYPE>
        </perm:is-allowed>
        <perm:is-allowed document="SEARCH" action="suggested_orders">
          <DOC_TYPE>
            <VALUE_ID Value="SO_LINE_ITEM"/>
            <DESCRIPTION Value="SO Line Items"/>
          </DOC_TYPE>
        </perm:is-allowed>
        <perm:is-allowed document="SEARCH" action="purchase_orders">
          <DOC_TYPE>
            <VALUE_ID Value="PURCHASE_ORDER"/>
            <DESCRIPTION Value="Purchase Orders"/>
          </DOC_TYPE>
        </perm:is-allowed>
        <perm:is-allowed document="SEARCH" action="purchase_orders">
          <DOC_TYPE>
            <VALUE_ID Value="PO_LINE_ITEM"/>
            <DESCRIPTION Value="PO Line Items"/>
          </DOC_TYPE>
        </perm:is-allowed>
        <perm:is-allowed document="SEARCH" action="transfer_orders">
          <DOC_TYPE>
