    <i18n:text>Invoices</i18n:text>
    <i18n:text>Errors</i18n:text>
    <i18n:text>RMAs</i18n:text>
  </x2:command>
  <!-- ********************************************************************** 
 *********************************************************************** -->
</x2:commands>
