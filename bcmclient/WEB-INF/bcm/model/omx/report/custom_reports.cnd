  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="i18n">
    <i18n:text>Your Search Criteria has been successfully updated!</i18n:text>
    <i18n:text>Confimation</i18n:text>
    <i18n:text>Saving Search Error</i18n:text>
    <i18n:text>Delete Custom Report</i18n:text>
    <i18n:text>Your Custom Report has been deleted!</i18n:text>
