<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" description="_">
  
<!-- ********************************************************************** 
  *********************************************************************** -->    
  <x2:command name="init" public="yes" description="_">
    <x2:execute command="omx.report.pages:defineCore"/>
  </x2:command>

  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="defineCore">
    
    <web:define-page name="custom_report_help" url="/omx/help/cust_report.htm"/>
    <web:define-page name="standard_report" url="/omx/search/search.jsp?DOC_TYPE=STANDARD_REPORT&amp;DIRECTORY=omx.report&amp;FILE=standard_reportsJSCRIPT=omx/report/js/report.js"/>
    <web:define-page name="custom_report" url="/omx/search/search.jsp?DOC_TYPE=CUSTOM_REPORT&amp;DIRECTORY=omx.report&amp;FILE=custom_reports&amp;JSCRIPT=omx/report/js/report.js"/>

    <web:define-page name="cas_report_links"   url="/omx/report/reportlinks.jsp"/>
    <web:define-page name="cas_report_content" url="/omx/report/reportlinks_content.jsp"/>

    <web:define-page name="corporate_reports" 
                     url="/omx/report/view/getReportLinksPage.cmd?CALLBACK=bpiPortalInitDone&amp;TYPE=CORPORATE&amp;FILTER=Orders&amp;key=A"/>
    <web:define-page name="omx_personal_reports"  
                     url="/omx/report/view/getReportLinksPage.cmd?CALLBACK=bpiPortalInitDone&amp;TYPE=CORPORATE&amp;FILTER=Orders&amp;key=B"/>
	<web:define-page name="omx_buy_personal_reports"  
                     url="/omx/report/view/getReportLinksPage.cmd?CALLBACK=bpiPortalInitDone&amp;TYPE=CORPORATE&amp;FILTER=Buy Orders&amp;key=B"/>
    <web:define-page name="em_personal_reports"  
                     url="/omx/report/view/getReportLinksPage.cmd?CALLBACK=bpiPortalInitDone&amp;TYPE=CORPORATE&amp;FILTER=Enterprise&amp;key=C"/>
    <web:define-page name="im_personal_reports"  
                     url="/omx/report/view/getReportLinksPage.cmd?CALLBACK=bpiPortalInitDone&amp;TYPE=CORPORATE&amp;FILTER=Inventory&amp;key=D"/>
    <web:define-page name="create_reports"     
                     url="/omx/report/view/getReportLinksPage.cmd?CALLBACK=createDocument"/>

    <web:define-xsl name="reportlinks_xsl" url="/omx/report/xsl/reportlinks.xsl"/>
    


  </x2:command>
  
  <!-- ********************************************************************** 
  *********************************************************************** -->
  
  <x2:command public="yes" description="_" name="getHeader">
    
    <xapl:return>		
      <x2:execute command="omx.index:getHeader">
        <x2:with-param name="pHeading" select="'Reports'"/>
      </x2:execute>
    </xapl:return>
    
  </x2:command>
  
  
  
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getTabs">
    
    <xapl:return>
      
      <TABS>           
        <HELP Url ="{$pages:custom_report_help}"/>
        <TAB
             DisplayText ="Custom Reports"
             Url="{$pages:custom_report}"

             Selected="{$pPage = 'CUSTOM_REPORT'}">
             
            <BUTTONS>
              <BUTTON 
                      Name="Delete" 
                      DisplayText="Delete" 
                      OnClick="javascript:onDelete()" 
                      Disabled="report"/>
            </BUTTONS>
          
        </TAB>
        <PAGINATION/>
      </TABS>  
    </xapl:return>
    
  </x2:command>
  
  <!-- ********************************************************************** 
  *********************************************************************** -->
</x2:commands>
  
  
