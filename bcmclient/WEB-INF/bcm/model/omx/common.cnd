<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:identity="http://www.i2.com/identity" xmlns:cis="http://www.i2.com/cis" xmlns:i18n="http://www.i2.com/i18n" description="_">
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="init">
    <omx:init-recent-list max="15"/>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="validateIdentity">
    <xapl:variable name="identityId" select="identity-user-id()"/>
    <xapl:if test="string-length($identityId) = 0">
      <web:display-page>
        <web:get-page name="login"/>
      </web:display-page>
    </xapl:if>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="validateSsoIdentity">
    <xapl:variable name="identityId" select="identity-user-id()"/>
    <xapl:if test="string-length($identityId) = 0">
      <xapl:variable name="userName">
        <cis:get-user-name/>
      </xapl:variable>
      <xapl:if test="string-length($userName) = 0">
        <web:display-page>
          <web:get-page name="ssologin"/>
        </web:display-page>
      </xapl:if>
      <identity:create-identity userId="{$userName}"/>
    </xapl:if>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="touch">
    <x2:param name="pObjectType"/>
    <x2:param name="pId"/>
    <xapl:variable name="userId" select="identity-user-id()"/>
    <xapl:choose>
      <xapl:when test="{$pObjectType = 'QUOTE'}">
        <omx:touch userId="{$userId}">
          <TRANSACTION>
            <QUOTE id="{$pId}"/>
          </TRANSACTION>
        </omx:touch>
      </xapl:when>
      <xapl:when test="{$pObjectType = 'TEMPLATE'}">
        <omx:touch userId="{$userId}">
          <TRANSACTION>
            <TEMPLATE id="{$pId}"/>
          </TRANSACTION>
        </omx:touch>
      </xapl:when>
      <xapl:when test="{$pObjectType = 'DRAFT'}">
        <omx:touch userId="{$userId}">
          <TRANSACTION>
            <DRAFT id="{$pId}"/>
          </TRANSACTION>
        </omx:touch>
      </xapl:when>
      <xapl:when test="{$pObjectType = 'ACTIVITY_ORDER'}">
        <omx:touch userId="{$userId}">
          <TRANSACTION>
            <ACTIVITY_ORDER id="{$pId}"/>
          </TRANSACTION>
        </omx:touch>
      </xapl:when>
      <xapl:when test="{$pObjectType = 'INVOICE'}">
        <omx:touch userId="{$userId}">
          <TRANSACTION>
            <INVOICE id="{$pId}"/>
          </TRANSACTION>
        </omx:touch>
      </xapl:when>
      <xapl:when test="{$pObjectType = 'SHIPMENT'}">
        <omx:touch userId="{$userId}">
          <TRANSACTION>
            <SHIPMENT id="{$pId}"/>
          </TRANSACTION>
        </omx:touch>
      </xapl:when>
      <xapl:otherwise>
        <omx:touch userId="{$userId}">
          <TRANSACTION>
            <ORDER id="{$pId}"/>
          </TRANSACTION>
        </omx:touch>
      </xapl:otherwise>
    </xapl:choose>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getRequestParameters">
    <x2:param name="pId" select="$this/ID/@Value"/>
    <x2:param name="pDocType" select="$this/DOC_TYPE/@Value"/>
    <xapl:if test="string-length($pId) &gt; 0">
      <x2:execute command="omx.common:touch">
        <x2:with-param name="pObjectType" select="$pDocType"/>
        <x2:with-param name="pId" select="$pId"/>
      </x2:execute>
    </xapl:if>
    <xapl:return>
      <REQUEST_PARAMETERS>
        <xapl:value-of select="{$this/*}"/>
      </REQUEST_PARAMETERS>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getConfirmationParameters">
    <xapl:return>
      <REQUEST_PARAMETERS>
        <xapl:value-of select="$this/*"/>
      </REQUEST_PARAMETERS>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getCalendarInfo">
    <xapl:variable name="formattedDate">
      <i18n:date unformat="true" format="common">
        <xapl:value-of select="$this/unformattedDate/@Value"/>
      </i18n:date>
    </xapl:variable>
    <xapl:variable name="todaysDate">
      <xapl:choose>
        <xapl:when test="($formattedDate = 'INVALID DATE') or (string-length($formattedDate) = 0)">
            <xapl:value-of select="current-date()"/><!-- Current-Date always returns in common format -->
        </xapl:when>
        <xapl:otherwise>
          <xapl:value-of select="$formattedDate"/>
        </xapl:otherwise>
      </xapl:choose>
    </xapl:variable>
    <xapl:return>
      <xapl:choose>
        <xapl:when test="{count($this/mon) > 0 and count($this/day) > 0 and count($this/year) > 0}">
          <DAY Value="{$this/day/@Value}"/>
          <MON Value="{$this/mon/@Value}"/>
          <YEAR Value="{$this/year/@Value}"/>
          <FORMATTED_DATE Value="{concat($this/mon/@Value,'/',$this/day/@Value,'/',$this/year/@Value)}"/>
        </xapl:when>
        <xapl:otherwise>
          <MON Value="{substring-before($todaysDate,'/')}"/>
          <DAY Value="{substring-before(substring-after($todaysDate,'/'),'/')}"/>
          <YEAR Value="{substring-after(substring-after($todaysDate,'/'),'/')}"/>
          <FORMATTED_DATE Value="{$todaysDate}"/>
        </xapl:otherwise>
      </xapl:choose>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="logout">
    <web:invalidate-session/>
    <web:display-page>
      <web:get-page name="login">
        <FROM Value="logout"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="redirectToLogin">
    <xapl:print select="{$this}"/>
    <xapl:choose>
      <xapl:when test="$this/MY_PROFILE/@Value = 'yes' ">
        <web:display-page>
          <web:get-page name="loginSuccess">
            <ACTIVITY Value="bcmDataManagement"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      <xapl:otherwise>
        <web:invalidate-session/>
        <web:display-page>
          <web:get-page name="login"/>
        </web:display-page>
      </xapl:otherwise>
    </xapl:choose>
<!--
        Earlier code ...
        <web:invalidate-session/>
        <web:display-page>
          <web:get-page name="login"/>
        </web:display-page>
-->
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getDefaultDate">
    <x2:param name="pFieldName"/>
    <xapl:variable name="tmpDate">
      <xapl:choose>
        <xapl:when test="{$pFieldName = 'DELIVERY_DATE'}">
          <xapl:value-of select="{current-date(1)}"/>
        </xapl:when>
        <xapl:otherwise>
          <xapl:value-of select="{current-date(1)}"/>
        </xapl:otherwise>
      </xapl:choose>
    </xapl:variable>
    <xapl:return>
      <xapl:value-of select="{$tmpDate}"/>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <!-- Currenty Used to scheduled date > today -->
  <x2:command public="yes" description="_" name="validateDate">
    <x2:param name="pFieldValue"/>
    <x2:param name="pFieldType" select="'Date'"/>
    <x2:param name="pFieldName" select="'DELIVERY_DATE'"/>
    <x2:param name="pObjectName" select="'ORDER_SCHEDULE'"/>
    <!-- Date - Start-->
    <xapl:variable name="defaultDate">
      <x2:execute command="omx.common:getDefaultDate">
        <xapl:with-param name="pFieldName" select="$pFieldName"/>
      </x2:execute>
    </xapl:variable>
    <xapl:variable name="result">
      <xapl:choose>
        <xapl:when test="string-length($pFieldValue) = 0">
          <_ERRORS>
            <_ERROR Value="MISSING_DATE"/>
          </_ERRORS>
        </xapl:when>
        <xapl:when test="date-compare($pFieldValue,$defaultDate) &lt; 0">
          <_ERRORS>
            <_ERROR Value="INVALID_FUTURE_DATE"/>
          </_ERRORS>
        </xapl:when>
        <xapl:when test="$pFieldValue = 'INVALID DATE' or $pFieldValue = 'INVALID_DATE'">
          <_ERRORS>
            <_ERROR Value="INVALID_DATE"/>
          </_ERRORS>
        </xapl:when>
      </xapl:choose>
    </xapl:variable>
    <xapl:print> validate date result <xapl:value-of select="{$result}"/>
    </xapl:print>
    <xapl:return>
      <xapl:value-of select="{$result}"/>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getDefaultCountry">
    <x2:param name="pReset" select="$this/RESET/@Value"/>
    <xapl:variable name="userId">
      <identity:get-user-id/>
    </xapl:variable>
    <xapl:choose>
      <xapl:when test="(string-length($userId) != 0) and ($pReset = 'true')">
        <!-- TODO: use identity support -->
        <xapl:variable name="currentUser">
          <xcore:get-document name="//UserSecurity/USER_PROFILE">
            <ID Value="{$userId}"/>
            <FETCH_DOCUMENT_LINK Name="CONTACT_INFO_LINK">
              <FETCH_DOCUMENT_LINK Name="ADDRESS_LINK"/>
            </FETCH_DOCUMENT_LINK>
          </xcore:get-document>
        </xapl:variable>
        <xapl:set-variable name="currentCountry">
          <xapl:value-of select="$currentUser/CONTACT_INFO_LINK/CONTACT/ADDRESS_LINK/ADDRESS/COUNTRY/@Value"/>
        </xapl:set-variable>
      </xapl:when>
      <!-- If on reset -->
      <xapl:otherwise>
        <xapl:if test="{string-length($currentCountry) = 0}">
          <xapl:set-variable name="currentCountry">USA</xapl:set-variable>
        </xapl:if>
      </xapl:otherwise>
    </xapl:choose>
    <xapl:return>
      <xapl:value-of select="{$currentCountry}"/>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getMessageHeader">
    <xapl:return>
      <x2:execute command="omx.index:getHeader">
        <x2:with-param name="pHeading" select="'Confirmation'"/>
        <x2:with-param name="pToggle" select="'../'"/>
      </x2:execute>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <!-- TODO: Use WEB_PAGE instead of PAGE -->
  <x2:command public="yes" description="_" name="reload">
    <x2:param name="pPage" select="$this/PAGE/@Value"/>
    <web:display-page>
      <web:get-page name="{$pPage}">
        <REFRESH Value="true"/>
        <xapl:value-of select="$this/*"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="reset">
    <xapl:print select="{$this}"/>
    <x2:param name="pPage" select="$this/PAGE/@Value"/>
    <xapl:variable name="param">
      <ROOT/>
    </xapl:variable>
    <xapl:for-each select="$this/RE_CIR_PARAM_NAME" varName="id">
      <docutil:add select="$param">
        <docutil:element name="{$id/@Value}" Value="{$this/*[name()= $id/@Value]/@Value}"/>
      </docutil:add>
    </xapl:for-each>
    <web:display-page>
      <web:get-page name="{$pPage}">
        <xapl:value-of select="$param/*"/>
        <xapl:if test="string-length($this/WHERE/@Value) &gt; 0">
          <WHERE Value="{$this/WHERE/@Value}" />
        </xapl:if>
        <xapl:if test="string-length($this/fromPage/@Value) &gt; 0">
          <fromPage Value="{$this/fromPage/@Value}" />
        </xapl:if>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getOrderAdminErrorSummary">
    <x2:param name="pResponse"/>
    <xapl:variable name="error">
      <ERROR_SUMMARY/>
    </xapl:variable>
    <docutil:add select="$error">
      <xapl:value-of select="$pResponse//_ERRORS[count(./_ERROR) &gt; 0]/.."/>
    </docutil:add>
    <xapl:return>
      <xapl:value-of select="$error"/>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="changeCountry">
    <xapl:variable name="param">
      <ROOT/>
    </xapl:variable>
    <xapl:choose>
      <xapl:when test=" string($this/RE_CIR_PARAM_NAME/@Value) = 'this' ">
        <docutil:add select="$param">
          <xapl:value-of select="$this/*"/>
        </docutil:add>
      </xapl:when>
      <xapl:otherwise>
        <xapl:for-each select="$this/RE_CIR_PARAM_NAME" varName="id">
          <docutil:add select="$param">
            <docutil:element name="{$id/@Value}" Value="{$this/*[name()= $id/@Value]/@Value}"/>
          </docutil:add>
        </xapl:for-each>
      </xapl:otherwise>
    </xapl:choose>
    <xapl:set-variable name="tempForm">
      <TEMP_FORM>
        <xapl:value-of select="{$this/*}"/>
      </TEMP_FORM>
    </xapl:set-variable>
    <xapl:print> TEMP FOrm value is <xapl:value-of select="$tempForm"/>
    </xapl:print>
    <web:display-page>
      <web:get-page name="{$this/PAGE/@Value}">
        <REFRESH Value="true"/>
        <xapl:value-of select="$param/*"/>
        <DEFAULT_COUNTRY Value="{this/COUNTRY/@Value}"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="prepareButtonXml">
    <x2:param name="pPageButtons"/>
    <x2:param name="pFilePath"/>
    <x2:param name="pContextValue"/>
    <xapl:variable name="getActionDefinations" select="concat($pFilePath, '.pages', ':', 'defineActions')"/>
    <!-- <xapl:print select="$getActionDefinations"></xapl:print> -->
    <xapl:variable name="actionDefinations">
      <x2:execute command="{$getActionDefinations}"/>
    </xapl:variable>
    <xapl:variable name="response">
      <BUTTONS/>
    </xapl:variable>
    <xapl:for-each select="$pPageButtons/page-button" varName="button">
      <xapl:variable name="actionDefination" select="$actionDefinations/define-action[@name = $button/@name]"/>
      <xapl:choose>
        <xapl:when test=" $button/@name = 'divider' ">
          <docutil:add select="$response">
            <DIVIDER/>
          </docutil:add>
        </xapl:when>
        <xapl:when test=" string-length($actionDefination/@contextNode) = 0 ">
          <perm:is-allowed document="{$actionDefination/@permContext}" action="{$actionDefination/@permAction}">
            <docutil:add select="$response">
              <xapl:variable name="onclick" select="concat('javascript:',$button/@onclick)"/>
              <BUTTON Id="{$actionDefination/@id}" Name="{$actionDefination/@displayText}" DisplayText="{$actionDefination/@displayText}" OnClick="{$onclick}" TabIndex="" Emphasized="{$button/@emphasized}"/>
            </docutil:add>
          </perm:is-allowed>
        </xapl:when>
        <xapl:when test=" string-length($actionDefination/@contextNode) &gt; 0 ">
          <xapl:variable name="nodeName" select="$actionDefination/@contextNode"/>
          <!-- <xapl:print select="$nodeName"/> -->
          <xapl:variable name="nodeValue" select="$pContextValue//*[name() = $nodeName]/@Value"/>
          <!-- <xapl:print select="$nodeValue"/> -->
          <!-- <xapl:print select="$actionDefination/@nodeValue"/> -->
          <xapl:variable name="addFlag">
            <FLAG Value="false"/>
          </xapl:variable>
          <xapl:choose>
            <xapl:when test=" $actionDefination/@matchBy = 'NOT_EQUAL' ">
              <xapl:if test=" string($nodeValue) != string($actionDefination/@nodeValue) ">
                <docutil:set select="$addFlag/@Value">true</docutil:set>
              </xapl:if>
            </xapl:when>
            <xapl:when test=" $actionDefination/@matchBy = 'EQUAL' ">
              <xapl:if test=" string($nodeValue) = string($actionDefination/@nodeValue) ">
                <docutil:set select="$addFlag/@Value">true</docutil:set>
              </xapl:if>
            </xapl:when>
          </xapl:choose>
          <xapl:if test=" $addFlag/@Value = 'true' ">
            <perm:is-allowed document="{$actionDefination/@permContext}" action="{$actionDefination/@permAction}">
              <docutil:add select="$response">
                <xapl:variable name="onclick" select="concat('javascript:',$button/@onclick)"/>
                <BUTTON Id="{$actionDefination/@id}" Name="{$actionDefination/@displayText}" DisplayText="{$actionDefination/@displayText}" OnClick="{$onclick}" TabIndex="" Emphasized="{$button/@emphasized}" Disabled="{$button/@disabled}"/>
              </docutil:add>
            </perm:is-allowed>
          </xapl:if>
        </xapl:when>
      </xapl:choose>
    </xapl:for-each>
    <!-- <xapl:print select="$response/BUTTON[position() = last()]/@Emphasized"/> -->
    <xapl:if test=" count($response/BUTTON) = 1 ">
      <docutil:remove select="$response/*[ name() = 'DIVIDER']"/>
    </xapl:if>
    <xapl:if test=" string-length($response/BUTTON[position() = last()]/@Emphasized) = 0 ">
      <docutil:set select="$response/BUTTON[position() = last()]/@Emphasized">true</docutil:set>
    </xapl:if>
    <!--<xapl:print select="$response"></xapl:print>-->
    <xapl:return>
      <xapl:value-of select="$response"/>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getLinks">
    <x2:param name="pPage" select="$this/PAGE/@Value"/>
    <x2:param name="pReturnLink" select="$this/RET_PAGE/@Value"/>
    <x2:param name="this"/>
    <x2:param name="pGetCurrentLink" select="'true'"/>
    <xapl:return>
      <xapl:variable name="encoded"/>
      <xapl:variable name="encoded2"/>
      <xapl:variable name="encoded3"/>
      <!-- Return Link -->
      <xapl:variable name="returnLink">
        <xapl:choose>
          <xapl:when test="{string-length($pReturnLink) > 0}">
            <xapl:value-of select="{$pReturnLink}"/>
          </xapl:when>
        </xapl:choose>
      </xapl:variable>
      <xapl:set-variable name="encoded">
        <xapl:if test="string-length($returnLink) > 0">
          <web:url-encode select="{$returnLink}"/>
        </xapl:if>
      </xapl:set-variable>
      <xapl:if test="string-length($returnLink) > 0">
        <xapl:set-variable name="encoded2">
          <web:url-encode select="{$encoded}"/>
        </xapl:set-variable>
        <xapl:set-variable name="encoded3">
          <web:url-encode select="{$encoded2}"/>
        </xapl:set-variable>
      </xapl:if>
      <LINK Name="Return" Value="{$returnLink}" EncodedValue="{$encoded}" TwiceEncodedValue="{$encoded2}" ThriceEncodedValue="{$encoded3}"/>
      <xapl:if test="string-length($pPage) > 0">
        <xapl:if test="$pGetCurrentLink = 'true'">
          <!-- Current Url -->
          <xapl:variable name="currentUrl">
            <web:get-page name="{$pPage}">
              <xapl:value-of select="$this/*"/>
            </web:get-page>
          </xapl:variable>
          <xapl:set-variable name="encoded">
            <xapl:if test="string-length($currentUrl) > 0">
              <web:url-encode select="{$currentUrl}"/>
            </xapl:if>
          </xapl:set-variable>
          <xapl:if test="string-length($currentUrl) > 0">
            <xapl:set-variable name="encoded2">
              <web:url-encode select="{$encoded}"/>
            </xapl:set-variable>
            <xapl:set-variable name="encoded3">
              <web:url-encode select="{$encoded2}"/>
            </xapl:set-variable>
          </xapl:if>
          <LINK Name="Current" Value="{$currentUrl}" EncodedValue="{$encoded}" TwiceEncodedValue="{$encoded2}" ThriceEncodedValue="{$encoded3}"/>
        </xapl:if>
      </xapl:if>

      <xapl:variable name="dateFormat"><identity:get-date-format format="common"/></xapl:variable>
      <FORMAT  Date="{$dateFormat}"/>

      
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getCallbackCommand">
    <x2:param name="pPage" select="$this/PAGE/@Value"/>
    <x2:param name="funcArgument"/>
    <xapl:return>
      <web:get-page name="{$pPage}">
        <xapl:value-of select="$funcArgument/*"/>
      </web:get-page>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="urlEncode">
    <x2:param name="pUrl"/>
    <x2:param name="level" select="'1'"/>
    <xapl:if test="string-length($pUrl) = 0">
      <xapl:print> forgot to pass urlEncode.pUrl</xapl:print>
      <xapl:return/>
    </xapl:if>
    <xapl:variable name="encoded">
      <web:url-encode select="{$pUrl}"/>
    </xapl:variable>
    <xapl:if test="$level > 1">
      <xapl:set-variable name="encoded">
        <x2:execute command="omx.common:urlEncode">
          <x2:with-param name="pUrl" select="$encoded"/>
          <x2:with-param name="level" select="$level -1"/>
        </x2:execute>
      </xapl:set-variable>
    </xapl:if>
    <xapl:return>
      <xapl:value-of select="$encoded"/>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="setProperties">
    <x2:param name="pDocument"/>
    <x2:param name="pProperties"/>
    <xapl:for-each varName="element" select="$pProperties/*">
      <xapl:variable name="elementName">
        <xapl:value-of select="name($element)"/>
      </xapl:variable>
      <xapl:choose>
        <xapl:when test="{count($pDocument/*[name() = $elementName]) = 0}">
          <docutil:add select="{$pDocument}">
            <docutil:element name="{$elementName}" Value="{$element/@Value}"/>
          </docutil:add>
        </xapl:when>
        <xapl:when test="{string-length($pDocument/*[name() = $elementName]/@Value) = 0}">
          <docutil:set select="$pDocument/*[name() = $elementName]/@Value">
            <xapl:value-of select="$element/@Value"/>
          </docutil:set>
        </xapl:when>
      </xapl:choose>
    </xapl:for-each>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="setPaginationDefaults">
    <x2:param name="this"/>
    <!-- Give Defaults - Start:-->
    <xapl:choose>
      <xapl:when test="{count($this/START_COUNT) = 0}">
        <docutil:add select="{$this}">
          <START_COUNT Value="0"/>
        </docutil:add>
      </xapl:when>
      <xapl:when test="{string-length($this/START_COUNT/@Value) = 0}">
        <docutil:set select="{$this/START_COUNT}">0</docutil:set>
      </xapl:when>
    </xapl:choose>
    <xapl:choose>
      <xapl:when test="{count($this/MAX_ROWS) = 0}">
        <docutil:add select="{$this}">
          <MAX_ROWS Value="10"/>
        </docutil:add>
      </xapl:when>
      <xapl:when test="{string-length($this/MAX_ROWS/@Value) = 0}">
        <docutil:set select="{$this/MAX_ROWS}">10</docutil:set>
      </xapl:when>
    </xapl:choose>
    <xapl:choose>
      <xapl:when test="{count($this/RETURN_ROW_COUNT) = 0}">
        <docutil:add select="{$this}">
          <RETURN_ROW_COUNT Value="yes"/>
        </docutil:add>
      </xapl:when>
      <xapl:when test="{string-length($this/RETURN_ROW_COUNT/@Value) = 0}">
        <docutil:set select="{$this/RETURN_ROW_COUNT}">yes</docutil:set>
      </xapl:when>
    </xapl:choose>
    <!-- Give Defaults: End-->
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="downloadFile">
    <x2:param name="pFileContents"/>
    <x2:param name="pFileName"/>
    <x2:param name="pFileType"/>
    <xapl:set-variable name="VIEW_FILE_CONTENTS">
      <xapl:choose>
        <xapl:when test="$pFileType = 'text'">
          <xapl:value-of select="{$pFileContents}"/>
        </xapl:when>
        <xapl:otherwise>
          <docutil:xml-to-string>
            <xapl:value-of select="{$pFileContents}"/>
          </docutil:xml-to-string>
        </xapl:otherwise>
      </xapl:choose>
    </xapl:set-variable>
    <!-- Send the file to browser to force download -->
    <web:display-page>
      <web:get-page name="downloaded_file">
        <OUTPUT_FILE Value="{$pFileName}"/>
      </web:get-page>
    </web:display-page>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getMinDate">
    <x2:param name="pDates"/>
    <xapl:variable name="minDate" select="$pDates/*[position() = 1]/@Value"/>
    <xapl:for-each select="$pDates/*/@Value" varName="date">
      <xapl:if test="date-compare($date,$minDate) &lt; 0">
        <xapl:set-variable name="minDate" select="$date"/>
      </xapl:if>
    </xapl:for-each>
    <xapl:return>
      <xapl:value-of select="$minDate"/>
    </xapl:return>
  </x2:command>
</x2:commands>
