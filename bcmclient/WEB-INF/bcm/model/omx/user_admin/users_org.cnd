<?xml version="1.0" encoding="UTF-8"?>
<x2:commands 
             xmlns:x2="http://www.i2.com/x2" 
             xmlns:core="http://www.i2.com/core" 
             xmlns:xcore="http://www.i2.com/xcore" 
             xmlns:xcore-db="http://www.i2.com/xcore-db" 
             xmlns:xapl="http://www.i2.com/xapl" 
             xmlns:web="http://www.i2.com/web" 
             xmlns:docutil="http://www.i2.com/docutil" 
             xmlns:util="http://www.i2.com/util" 
             xmlns:FUNCTION="http://www.i2.com/FUNCTION" 
             xmlns:REMOVE="http://www.i2.com/REMOVE" 
             xmlns:xudl="http://www.i2.com/xudl" 
             xmlns:cfg="http://www.i2.com/configurability" 
             xmlns:perm="http://www.i2.com/permissibility" 
             xmlns:omx="http://www.i2.com/omx" 
             xmlns:identity="http://www.i2.com/identity" description="_">  
	


	<x2:command public="yes" description="_" name="init">
		<xapl:variable name="originalThis" resolver="session" global="true"/>
	</x2:command>


	<x2:command public="yes" description="_" name="selectOrganization">
        <xapl:variable name="orgId">
          <xapl:value-of select="$this/ID/@Value"/>
        </xapl:variable>

        <!-- restore the this -->
        <xapl:set-variable name="this">
	    <xapl:clone select="{$originalThis}"/>
	  </xapl:set-variable>

        <!-- set the new org id -->
        <docutil:set select="{$this}">
          <ORG_ID Value="{$orgId}"/>
        </docutil:set>

        <!-- reload the user's page -->
        <x2:execute command="omx.common:reload">
          <x2:with-param name="this" select="$this"/>
        </x2:execute>  

	</x2:command>

	<!-- ********************************************************************** 
    *********************************************************************** -->		 
	<x2:command public="yes" description="_" name="view">
        <!-- save the this for later -->
        <xapl:set-variable name="originalThis">
	    <xapl:clone select="{$this}"/>
	  </xapl:set-variable>

	  <xapl:set-variable name="addBookCurrOrgId">
	    <ORG_ID/>
	  </xapl:set-variable>
	  
	  <web:display-page>
	    <web:get-page name="user_org_search_view">
		</web:get-page>
	  </web:display-page>
	</x2:command>
    
	<!-- ********************************************************************** 
    *********************************************************************** -->
    <x2:command public="yes" description="_" name="getSearchFormConfig">
      
      <xapl:return>
        
        <!-- Search Fields -->
        <FORM  MethodName="//UserSecurity/getOrganizations"  Name="search_form" Action="search.jsp" Method="GET" Target="appFrame">

        
        <FIELD 
               Type="Text" 
               DisplayText="Name" 
               Name="FULL_NAME" 
               Value="{$this/FULL_NAME/@Value}" 
               Visibility="Simple"/>
        
                 
          <FIELD 
                 Type="CheckBox" 
                 DisplayText="Show Inactive" 
                 Name="INACTIVE_STATUS"
                 Value="{$this/INACTIVE_STATUS/@Value}" 
                 CheckedValue="true" 
                 Visibility="Simple"/>
          
          <FIELD 
                 Type="Select"
                 SelectAll="No" 
                 DisplayText="Org. Type"
                 Name="STATUS" 
                 Value="{$this/STATUS/@Value}" 
                 Visibility="Advanced"
                 DataSourceType="Command"
                 DataSourceName="omx.cm:getOrgTypes" />
          
          <FIELD 
                 Type="Text" 
                 DisplayText="Parent Org Name" 
                 Name="PARENT_ORG_NAME" 
                 Value="{$this/PARENT_ORG_NAME/@Value}" 
                 Visibility="Advanced"/>
				 
		  <FIELD 
               Type="Select"
			         SelectAll="No" 
               DisplayText="Country" 
               Name="COUNTRY" 
               Value="{$this/COUNTRY/@Value}" 
               Visibility="Advanced"
			         DataSourceType="Command"
			         DataSourceName="omx.cm:getCountries" />
          
          
          <!-- Always Put hidden at the end -->
          <x2:execute command="omx.search.search:getHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>  
          
          <!-- Form Buttons -->
          <BUTTONS>
            <BUTTON 
                    Name="search" 
                    DisplayText="Search" 
                    OnClick="javascript:onSearch()" 
                    Emphasized="no"/>				
          </BUTTONS>
        </FORM>       
      </xapl:return>
      
    </x2:command>
    
    
    <!-- ********************************************************************** 
    *********************************************************************** -->
    <x2:command public="yes" description="_" name="getSearchReportConfig">
			
			<xapl:variable name="helpUrl">
				<web:get-page name="select_help"/>
			</xapl:variable>
			
      <xapl:return>
        <REPORT Selectable="Single" Scrollable="yes"  >
          <HELP Url="{$helpUrl}"/>
          <FIELDS>
            
            <!-- <FIELD  
                   Name="ID"                
                   DisplayText ="Org. Id" 
                   Sortable="yes" 
                   Url="../add_book/org/pages/redirectToOrgDetails.cmd"/> -->
            <FIELD 
                   Name="FULL_NAME"  
                   DisplayText="Name"
									 Sortable="yes"/>
            <FIELD 
                   Name="CUSTOMER_STATUS"          
                   DisplayText="Customer Status"  
                   Sortable="no"/>
						<FIELD 
                   Name="SELLER_STATUS"          
                   DisplayText="Seller Status"  
                   Sortable="no"/>
                        
            <!-- Hidden Fields -->
            <x2:execute command="omx.report.report:getHiddenFields">
              <x2:with-param name="this" select="$this"/>
            </x2:execute> 
            
          </FIELDS>   
        </REPORT>
      </xapl:return>
    </x2:command>
    
      
    <!-- ********************************************************************** 
  *********************************************************************** -->
  
  <x2:command public="yes" description="_" name="getReportData">
    <x2:param name="pForm"/>
    <x2:param name="pIds"/>
    <x2:param name="pAddRecordCount" select="'true'"/>
    
    <!-- Give Defaults - Start:-->    
    <xapl:variable name="addRecordCount" select="$pAddRecordCount"/>
		
    <xapl:variable name="statusFilter"><ROOT/></xapl:variable>
    
    <xapl:variable name="userId"><identity:get-user-id/></xapl:variable>
    
      
      <!-- setting the org status-->
    <xapl:choose>
      
      <xapl:when test=" ($pForm/FIELD[@Name = 'STATUS']/@Value = 'SELLER') ">
        <xapl:set-variable name="statusFilter">
          <FILTER Name="STATUS"> 
            <xapl:choose>
              <xapl:when test=" ($pForm/FIELD[@Name = 'INACTIVE_STATUS']/@Value = 'true') ">
                <AND>
                  <xcore:search-by property="SELLER_STATUS"  value="INACTIVE" matchby="NOT_EQUAL"/>
                  <xcore:search-by property="SELLER_STATUS"  value="NONE" matchby="NOT_EQUAL"/>
                </AND>                 
              </xapl:when>
              <xapl:otherwise>
                <AND>
                  <xcore:search-by property="SELLER_STATUS" value="ACTIVE"/>
                  <xcore:search-by property="CUSTOMER_STATUS"  value="INACTIVE" matchby="NOT_EQUAL"/>
                </AND>        
              </xapl:otherwise>
            </xapl:choose>
          </FILTER>
        </xapl:set-variable>
      </xapl:when>
      
      <xapl:when test=" ($pForm/FIELD[@Name = 'STATUS']/@Value = 'CUSTOMER') ">
        <xapl:set-variable name="statusFilter">
          <FILTER Name="STATUS">
            <xapl:choose>
              <xapl:when test=" ($pForm/FIELD[@Name = 'INACTIVE_STATUS']/@Value = 'true') ">
               <AND>
                  <xcore:search-by property="CUSTOMER_STATUS"  value="INACTIVE" matchby="NOT_EQUAL"/>
                  <xcore:search-by property="CUSTOMER_STATUS"  value="NONE" matchby="NOT_EQUAL"/>
                </AND> 
              </xapl:when>
              <xapl:otherwise>
                <AND>
                  <xcore:search-by property="CUSTOMER_STATUS" value="ACTIVE"/>
                  <xcore:search-by property="SELLER_STATUS"  value="INACTIVE" matchby="NOT_EQUAL"/>
                </AND>            
              </xapl:otherwise>
            </xapl:choose>
          </FILTER>
        </xapl:set-variable>
      </xapl:when>
      
      <xapl:when test=" ($pForm/FIELD[@Name = 'STATUS']/@Value = 'BOTH') ">
        <xapl:set-variable name="statusFilter">
          <FILTER Name="STATUS">
            <xapl:choose>
              <xapl:when test=" ($pForm/FIELD[@Name = 'INACTIVE_STATUS']/@Value = 'true') ">
								<xcore:search-by property="CUSTOMER_STATUS"  value="NONE" matchby="NOT_EQUAL"/>
								<xcore:search-by property="SELLER_STATUS"  value="NONE" matchby="NOT_EQUAL"/>
                <!-- <OR>
                  <AND>
                    <xcore:search-by property="CUSTOMER_STATUS" value="ACTIVE"/>
                    <xcore:search-by property="SELLER_STATUS"  value="ACTIVE" />
                  </AND>
                  <AND>
                    <xcore:search-by property="CUSTOMER_STATUS" value="DORMANT"/>
                    <xcore:search-by property="SELLER_STATUS"  value="DORMANT" />
                  </AND>
                </OR> -->
              </xapl:when>
              <xapl:otherwise>
                <AND>
                  <xcore:search-by property="CUSTOMER_STATUS" value="ACTIVE"/>
                  <xcore:search-by property="SELLER_STATUS"  value="ACTIVE" />
                </AND>            
              </xapl:otherwise>
            </xapl:choose>
          </FILTER>
        </xapl:set-variable>
      </xapl:when>
      
      <xapl:otherwise>
        <xapl:set-variable name="statusFilter">
          <FILTER Name="STATUS">
            <xapl:choose>
              <xapl:when test=" ($pForm/FIELD[@Name = 'INACTIVE_STATUS']/@Value = 'true') ">
                <AND>
                  <xcore:search-by property="CUSTOMER_STATUS" value="INACTIVE" matchby="NOT_EQUAL"/>
                  <xcore:search-by property="SELLER_STATUS"  value="INACTIVE" matchby="NOT_EQUAL"/>
                </AND>
              </xapl:when>
              <xapl:otherwise>
                <OR>
                  <xcore:search-by property="CUSTOMER_STATUS" value="ACTIVE"/>
                  <xcore:search-by property="SELLER_STATUS"  value="ACTIVE"/>
                </OR>
              </xapl:otherwise>
            </xapl:choose>
            
          </FILTER>
        </xapl:set-variable>
      </xapl:otherwise>
      
    </xapl:choose>
      <!-- end of setting the org status-->
    
    <!-- <xapl:if test=" ($pForm/FIELD[@Name = 'SORT_BY']/@Value = 'NAME') ">
      <docutil:set select="$pForm/FIELD[@Name = 'SORT_BY']/@Value">FULL_NAME</docutil:set>
    </xapl:if> -->
    
      
    <xapl:variable name="data">
      <xapl:choose>
        <!-- pDoSearch and user has entered any Search Field on the form-->
        <xapl:when test="{($pForm/FIELD[@Name = 'DO_SEARCH']/@Value = 'Yes' ) and count($pForm/FIELD[@Type !='Hidden' and (string-length(@Value) > 0  or string-length(@Value1) >0 or string-length(@Value2) > 0)]) > 0}">
          <!-- Get Data -->
          <xcore:execute-method name="{$pForm/@MethodName}" StartAtRow="{$pForm/FIELD[@Name = 'START_COUNT']/@Value}" MaxRows="{$pForm/FIELD[@Name = 'MAX_ROWS']/@Value}" ReturnRowCount="{$this/RETURN_ROW_COUNT/@Value}">
            
            <xapl:variable name="identityId"><identity:get-user-id/></xapl:variable>
            <USER_ID Value="{$identityId}"/>
			<!-- Domain Info -->
			<WITH_PERMISSIONS/>
			
			<!-- Return only those in primary domain -->
			<IN_PRIMARY_DOMAIN/>
			
            <!-- TODO :Genarate the FILTERS Automatically -->
            <FILTER Name="ID">
              <xcore:search-by property="ID" value="{$pForm/FIELD[@Name = 'ID']/@Value}"/>
            </FILTER>
            
            <xapl:if test="isAllowed('USER_ADMIN', '*', 'add_user_for_customer_org') or isAllowed('USER_ADMIN', '*', 'add_user_for_seller_org')">
              <FILTER Name="PARENT_ORG_ID">
                <xcore:search-by property="PARENT_ORG_ID" value="{identity-user-org()}" matchby="EQUAL"/>
              </FILTER>
            </xapl:if>
            
            <FILTER Name="FULL_NAME">
              <xcore:search-by property="FULL_NAME" value="{$pForm/FIELD[@Name = 'FULL_NAME']/@Value}"/>
            </FILTER>
			
			      <FILTER Name="ADDRESS">
			        <xcore:search-by property="COUNTRY" value="{$pForm/FIELD[@Name = 'COUNTRY']/@Value}"/>
            </FILTER>

            <xapl:value-of select="$statusFilter"/>
            
      			<xapl:if test="{string-length($pForm/FIELD[@Name = 'PARENT_ORG_NAME']/@Value) > 0}">
      			  <FILTER Name="PARENT_ORG_FILTER">
      			    <xcore:search-by property="FULL_NAME" value="{$pForm/FIELD[@Name = 'PARENT_ORG_NAME']/@Value}"/>
      			  </FILTER>		
      			</xapl:if>
							
							<FILTER Name="TAX_ID">
								<xcore:search-by property="TAX_ID" value="{$pForm/FIELD[@Name = 'TAX_ID']/@Value}"/>
							</FILTER>
							
							<FILTER Name="DEFAULT_FC_ID">
								<xcore:search-by property="DEFAULT_FC_ID" value="{$pForm/FIELD[@Name = 'DEFAULT_FC_ID']/@Value}"/>							
							</FILTER>
							
							<FILTER Name="MERCHANT_ID">
								<xcore:search-by property="MERCHANT_ID" value="{$pForm/FIELD[@Name = 'MERCHANT_ID']/@Value}"/>							
							</FILTER>
							
              <xapl:if test="string-length($pForm/FIELD[@Name = 'SORT_BY']/@Value) > 0 and string-length($pForm/FIELD[@Name = 'SORT_ORDER']/@Value) > 0">
  							<ORDER_BY>
	  							<docutil:element name="{$pForm/FIELD[@Name = 'SORT_BY']/@Value}" Sort="{$pForm/FIELD[@Name = 'SORT_ORDER']/@Value}"/>
		  					</ORDER_BY>
              </xapl:if>  
            
          </xcore:execute-method>
        
      </xapl:when>
      <!-- pIds or pGetRecent -->        
      <xapl:otherwise>

        <xapl:if test="{($pForm/FIELD[@Name = 'DO_SEARCH']/@Value != 'Yes' ) or count($pIds/ID) > 0}">
        
            <!-- Get Ids -->
          <xapl:variable name="ids" >
              <IDS>
                <xapl:choose>
                  <!-- If ids are passed -->
                  <xapl:when test="count($pIds/ID) > 0">
                    <xapl:value-of select="$pIds/ID"/>
                  </xapl:when>
                  <!-- Other wise get recent ids-->
                  <xapl:otherwise>
                      <omx:get-recent max="10" userId="{$userId}">
                        <!-- TODO: get DOC_GROUP -->
                        <TRANSACTION>
                          <docutil:element name="{$pForm/FIELD[@Name = 'OBJECT_TYPE']/@Value}"/>
                        </TRANSACTION>
                      </omx:get-recent>
                  </xapl:otherwise>    
                </xapl:choose>  
              </IDS>                          
           </xapl:variable>

            <!-- Get data -->
            <xapl:if test="{count($ids/*) > 0}">

              <xapl:set-variable name="addRecordCount" select="'false'"/>

              <xcore:execute-method name="{$pForm/@MethodName}" ReturnRowCount="{$this/RETURN_ROW_COUNT/@Value}">
                <FILTER Name="ID">
                  <OR>
                     <xapl:value-of select="{$ids/ID}"/>
                  </OR>
                </FILTER>
                
                <xapl:if test="{string-length($pForm/FIELD[@Name = 'STATE_ID']/@Value) != 0}">
                  <FILTER Name="STATE_ID">
                    <xcore:search-by property="STATE_ID" value="{$pForm/FIELD[@Name = 'STATE_ID']/@Value}"/>
                  </FILTER>              
                </xapl:if>

                <xapl:if test="string-length($pForm/FIELD[@Name = 'SORT_BY']/@Value) > 0 and string-length($pForm/FIELD[@Name = 'SORT_ORDER']/@Value) > 0">
                  <ORDER_BY>
                    <docutil:element name="{$pForm/FIELD[@Name = 'SORT_BY']/@Value}" Sort="{$pForm/FIELD[@Name = 'SORT_ORDER']/@Value}"/>
                  </ORDER_BY>
                </xapl:if>
              </xcore:execute-method>
              
            </xapl:if>  <!-- If ids -->
            
          </xapl:if><!-- DO_SEARCH != yes or pIds -->
        </xapl:otherwise><!-- DO_SEARCH !=yes and user entered nothing -->
        
      </xapl:choose>	
    </xapl:variable>
	
    <docutil:add select="$data">
      <TOTAL_RECORD_COUNT Value="{$data/@TotalRowCount}"/>
      <START_AT_ROW Value ="{$this/START_COUNT/@Value}"/>
    </docutil:add>
        <!-- TODO Do this dynamically only if timingStats are on. -->
        <docutil:remove select="$data/TIMING_STATS"/>
        <docutil:remove select="$data/RESPONSE/TIMING_STATS"/>
    <xapl:return>
      <xapl:value-of select="{$data}"/>
    </xapl:return>
    
  </x2:command>

  
</x2:commands>

