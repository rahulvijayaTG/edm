<?xml version="1.0" encoding="UTF-8"?>

<x2:commands description="_" 
             xmlns:FUNCTION="http://www.i2.com/FUNCTION" 
             xmlns:REMOVE="http://www.i2.com/REMOVE" 
             xmlns:cfg="http://www.i2.com/configurability" 
             xmlns:core="http://www.i2.com/core" 
             xmlns:omx="http://www.i2.com/omx" 
             xmlns:perm="http://www.i2.com/permissibility" 
             xmlns:util="http://www.i2.com/util" 
             xmlns:web="http://www.i2.com/web" 
             xmlns:x2="http://www.i2.com/x2" 
             xmlns:xapl="http://www.i2.com/xapl" 
             xmlns:xcore="http://www.i2.com/xcore" 
             xmlns:xcore-db="http://www.i2.com/xcore-db" 
             xmlns:docutil="http://www.i2.com/docutil" 
             xmlns:xudl="http://www.i2.com/xudl">  
    
    <!--************************************************************************-->
    
  <x2:command public="yes" description="_" name="loadUserAdminDomains">
   <xapl:return>

    <x2:execute command="omx.user_admin.pages:getTabs">
      <x2:with-param name="pPage">user_admin_domains</x2:with-param>
      <x2:with-param name="pId" select="$this/USER_ID/@Value"/>
    </x2:execute>

    <x2:execute command="omx.user_admin.user_admin_domains:getUserAdminDomains">
      <x2:with-param name="pUserId"><xapl:value-of select="{$this/USER_ID/@Value}"/></x2:with-param>
       <x2:with-param name="pRoleId"><xapl:value-of select="{$this/ROLE_ID/@Value}"/></x2:with-param>
       <x2:with-param name="pEdit"><xapl:value-of select="{$this/EDIT/@Value}"/></x2:with-param>
       <x2:with-param name="pSearchParam"><xapl:value-of select="{$this/SEARCH_PARAM/@Value}"/></x2:with-param>
    </x2:execute>
    
    <x2:execute command="omx.common:getLinks">
      <x2:with-param name="pPage" select="'user_admin_domains'" />
      <x2:with-param name="pReturnLink"  select="$this/RET_PAGE[1]/@Value"/>
      <x2:with-param name="this" select="$this"/>
      <x2:with-param name="pGetCurrentLink" select="'true'"/>
    </x2:execute>

   </xapl:return> 
  </x2:command>
  
  <!--************************************************************************--> 
  
  <x2:command public="yes" description="_" name="goBackToUserDetails">

	  <web:display-page>
	    <web:get-page name="user_admin_users">
        <ID Value="{$this/USER_ID[1]/@Value}"/>
      </web:get-page>
	  </web:display-page>

	</x2:command> 

  <!--************************************************************************-->   
    
  <x2:command public="yes" description="_" name="getUserAdminDomains">
    <x2:param name="pUserId"/>
    <x2:param name="pRoleId"/>
    <x2:param name="pEdit"/>
    <x2:param name="pSearchParam"/>
    
      <xapl:variable name="user">
        <x2:execute command="omx.user_admin.user_admin_users:getUser">
          <x2:with-param name="pId" select="$pUserId"/>
        </x2:execute>
      </xapl:variable>
      
      <xapl:variable name="domainTypes">
       <DOMAIN_TYPES>
         <xapl:if test="{string-length($pRoleId) &gt; 0}">
           <xcore:execute-method name="//UserSecurity/getDomainTypesForRole">
             <ROLE_ID Value="{$pRoleId}"/>
           </xcore:execute-method>
         </xapl:if>
       </DOMAIN_TYPES>
      </xapl:variable>

      <xapl:variable name="domains">
        <DOMAINS>
          <USER_ID Value="{$pUserId}"/>
          <ROLE_ID Value="{$pRoleId}"/>
        </DOMAINS>
      </xapl:variable>
      
      <xapl:for-each varName="domainType" select="{$domainTypes/ROLE_DOMAIN_TYPE_MAP[ DOMAIN_SCOPE/@Value = 'List' ]}">
         
        <xapl:variable name="entIds">
        <ENTITY_IDS>
          <xcore:execute-method name="//UserSecurity/getDomainEntitiesForUser">
            <ROLE_ID Value="{$pRoleId}"/>
            <USER_ID Value="{$pUserId}"/>
            <DOMAIN_TYPE_ID Value="{$domainType/DOMAIN_TYPE_ID/@Value}"/>
          </xcore:execute-method>
         </ENTITY_IDS>
        </xapl:variable>
        
        <xapl:variable name="ids">
          <OR/>
        </xapl:variable>
        
        <xapl:for-each varName="entId" select="{$entIds/USER_ROLE_DOMAIN_MAP}">
          <docutil:add select="{$ids}">
            <ID Value="{$entId/ENTITY_ID/@Value}"/>
          </docutil:add>
        </xapl:for-each>
        
        <docutil:add select="{$domains}">
          <DOMAIN>
            <DOMAIN_TYPE_ID Value="{$domainType/DOMAIN_TYPE_ID/@Value}"/>
            <xapl:choose>
              <xapl:when test="{$domainType/DOMAIN_TYPE_ID/@Value = 'CUST'}">
                <NAME Value="Corporate Points"/>
              </xapl:when>
              <xapl:when test="{$domainType/DOMAIN_TYPE_ID/@Value = 'SELL'}">
                <NAME Value="Selling Points"/>
              </xapl:when>
              <xapl:when test="{$domainType/DOMAIN_TYPE_ID/@Value = 'FC'}">
                <NAME Value="ShipFroms"/>
              </xapl:when>
            </xapl:choose>
            <EDITABLE Value="true"/>
            <xapl:if test="{$pEdit = $domainType/DOMAIN_TYPE_ID/@Value}">
              <EDITING Value="true"/>
              <xapl:if test="{string-length($pSearchParam) &gt; 0}">
                <SEARCH_RESULTS>
                  <xapl:choose>
                    <xapl:when test="{$domainType/DOMAIN_TYPE_ID/@Value = 'FC'}">
                      <x2:execute command="omx.user_admin.user_admin_domains:domainGetFCs">
                        <x2:with-param name="criteria">
                          <CRITERIA>
                            <xcore:search-by property="FULL_NAME" value="{$pSearchParam}"/>
                            <ORG_ID Value="{$user/ORG_ID/@Value}"/>
                          </CRITERIA>
                        </x2:with-param>
                        <x2:with-param name="ids">
                          <xapl:value-of select="{$ids}"/>
                        </x2:with-param>
                        <x2:with-param name="mode">
                          <MODE Value="getAll"/>
                        </x2:with-param>
                      </x2:execute>
                    </xapl:when>
                    <xapl:when test="{$domainType/DOMAIN_TYPE_ID/@Value = 'CUST'}">
					  <xapl:print select="$user"/>
                      <x2:execute command="omx.user_admin.user_admin_domains:domainGetOrgs">
                        <x2:with-param name="criteria">
                          <CRITERIA>
                            <xcore:search-by property="FULL_NAME" value="{$pSearchParam}"/>
                            <CUSTOMER_STATUS Value="ACTIVE"/>
					        <ORG_ID Value="{$user/ORG_ID/@Value}"/>
                          </CRITERIA>
                        </x2:with-param>
                        <x2:with-param name="ids">
                          <xapl:value-of select="{$ids}"/>
                        </x2:with-param>
                        <x2:with-param name="mode">
                          <MODE Value="getAll"/>
                        </x2:with-param>
                      </x2:execute>
                    </xapl:when>
                    <xapl:when test="{$domainType/DOMAIN_TYPE_ID/@Value = 'SELL'}">
                      <x2:execute command="omx.user_admin.user_admin_domains:domainGetOrgs">
                        <x2:with-param name="criteria">
                          <CRITERIA>
                            <xcore:search-by property="FULL_NAME" value="{$pSearchParam}"/>
                            <SELLER_STATUS Value="ACTIVE"/>
					        <ORG_ID Value="{$user/ORG_ID/@Value}"/>
                          </CRITERIA>
                        </x2:with-param>
                        <x2:with-param name="ids">
                          <xapl:value-of select="{$ids}"/>
                        </x2:with-param>
                        <x2:with-param name="mode">
                          <MODE Value="getAll"/>
                        </x2:with-param>
                      </x2:execute>
                    </xapl:when>
                  </xapl:choose>
                </SEARCH_RESULTS>
              </xapl:if>
            </xapl:if>
            
           
            <xapl:choose>
              <xapl:when test="{count( $entIds/USER_ROLE_DOMAIN_MAP ) &gt; 0}">
                <xapl:choose>
                  <xapl:when test="{$domainType/DOMAIN_TYPE_ID/@Value = 'FC'}">
                    <x2:execute command="omx.user_admin.user_admin_domains:domainGetFCs">
                      <x2:with-param name="criteria">
                        <CRITERIA>
                          <xapl:value-of select="{$ids}"/>
                        </CRITERIA>
                      </x2:with-param>
                      <x2:with-param name="mode">
                        <MODE Value="getAssigned"/>
                      </x2:with-param>
                    </x2:execute>
                  </xapl:when>
				  <xapl:when test="{$domainType/DOMAIN_TYPE_ID/@Value = 'CUST'}">
                    <x2:execute command="omx.user_admin.user_admin_domains:domainGetOrgs">
                      <x2:with-param name="criteria">
                        <CRITERIA>
                          <xapl:value-of select="{$ids}"/>
                          <CUSTOMER_STATUS Value="ACTIVE"/>
					      <ORG_ID Value="{$user/ORG_ID/@Value}"/>
                        </CRITERIA>
                      </x2:with-param>
                      <x2:with-param name="mode">
                        <MODE Value="getAssigned"/>
                      </x2:with-param>
                    </x2:execute>
				  </xapl:when>
				  <xapl:when test="{$domainType/DOMAIN_TYPE_ID/@Value = 'SELL'}">
                    <x2:execute command="omx.user_admin.user_admin_domains:domainGetOrgs">
                      <x2:with-param name="criteria">
                        <CRITERIA>
                          <xapl:value-of select="{$ids}"/>
                          <SELLER_STATUS Value="ACTIVE"/>
					      <ORG_ID Value="{$user/ORG_ID/@Value}"/>
                        </CRITERIA>
                      </x2:with-param>
                      <x2:with-param name="mode">
                        <MODE Value="getAssigned"/>
                      </x2:with-param>
                    </x2:execute>
				  </xapl:when>
                </xapl:choose>
                
              </xapl:when>
              <xapl:otherwise>
                <ENTITIES/>
              </xapl:otherwise>
            </xapl:choose>
          </DOMAIN>
        </docutil:add>
      </xapl:for-each>    

      <xapl:return>
        <xapl:value-of select="{$domains}"/>
      </xapl:return>
      
    </x2:command>

    <!--************************************************************************-->  
    
    <x2:command public="yes" description="_" name="getAllDomainsForUser">
      
      <xapl:variable name="urm">
        <xcore:get-document name="//UserSecurity/USER_ROLE_MAP">
          <USER_ID Value="{USER_ID/@Value}"/>
        </xcore:get-document>
      </xapl:variable>
      <xapl:return>
        <x2:execute command="omx.user_admin.user_admin_domains:getUserAdminDomains">
          <USER_ID Value="{USER_ID/@Value}"/>
          <ROLE_ID Value="{$urm/ROLE_ID/@Value}"/>
        </x2:execute>
      </xapl:return>
      
    </x2:command>

    <!--************************************************************************-->  
  
    <x2:command public="yes" description="_" name="domainGetOrgs">
      <x2:param name="criteria"/>
      <x2:param name="ids"/>
      <x2:param name="mode"/>
      
      <docutil:remove select="{$orgs}"/>
      <xapl:variable name="orgs">
        <ORGS/>
	  </xapl:variable>
	  
	  <xapl:print select="$criteria"/>

	  <xapl:choose>
	    <xapl:when test="$criteria/CUSTOMER_STATUS/@Value = 'ACTIVE'">
	      <xapl:variable name="custOrgs">
	        <xcore:execute-method name="//UserSecurity/getEnabledOrganizations">
		      <FILTER Name="SELLING_ORG_ID">
                <xcore:search-by property="SELLING_ORG_ID" value="{$criteria/ORG_ID/@Value}" matchby="EQUAL"/>
              </FILTER>
		      <FILTER Name="NAME">
                <xcore:search-by property="NAME" value="{$criteria/FULL_NAME/@Value}" matchby="STARTS_WITH"/>
              </FILTER>
		    </xcore:execute-method>
		  </xapl:variable>
		  <xapl:print select="$custOrgs"/>
		  <xapl:for-each varName="custOrg" select="$custOrgs/ENABLED_CUSTOMER">
		    <docutil:add select="{$orgs}">
			  <ORGANIZATION>
			    <ID Value="{$custOrg/CUSTOMER_ORG_ID/@Value}"/>
			    <FULL_NAME Value="{$custOrg/NAME/@Value}"/>
			  </ORGANIZATION>
			</docutil:add>
		  </xapl:for-each>
		</xapl:when>
		<xapl:when test="$criteria/SELLER_STATUS/@Value = 'ACTIVE'">
	      <xapl:variable name="sellOrgs">
	        <xcore:execute-method name="//UserSecurity/getEnabledSellerOrganizations">
		      <FILTER Name="CUSTOMER_ORG_ID">
                <xcore:search-by property="CUSTOMER_ORG_ID" value="{$criteria/ORG_ID/@Value}" matchby="EQUAL"/>
              </FILTER>
		      <FILTER Name="NAME">
                <xcore:search-by property="NAME" value="{$criteria/FULL_NAME/@Value}" matchby="STARTS_WITH"/>
              </FILTER>
		    </xcore:execute-method>
		  </xapl:variable>
		  <xapl:print select="$sellOrgs"/>
		  <xapl:for-each varName="sellOrg" select="$sellOrgs/ENABLED_CUSTOMER">
		    <docutil:add select="{$orgs}">
			  <ORGANIZATION>
			    <ID Value="{$sellOrg/SELLING_ORG_ID/@Value}"/>
			    <FULL_NAME Value="{$sellOrg/NAME/@Value}"/>
			  </ORGANIZATION>
			</docutil:add>
		  </xapl:for-each>
		</xapl:when>
      </xapl:choose>

	  <xapl:print select="$orgs"/>
 
	  <docutil:remove select="{$results}"/>
      <xapl:variable name="results">
        <ENTITIES/>
      </xapl:variable>

      <xapl:choose>
        <xapl:when test="{$mode/@Value = 'getAssigned'}">
          <xapl:for-each varName="org" select="{$orgs/ORGANIZATION}">
            <docutil:add select="{$results}">
              <ENTITY>
                <ID Value="{$org/ID/@Value}"/>
                <NAME Value="{$org/FULL_NAME/@Value}"/>
              </ENTITY>
            </docutil:add>
          </xapl:for-each>
        </xapl:when>
        <xapl:when test="{$mode/@Value = 'getAll'}">
          <xapl:for-each varName="org" select="{$orgs/ORGANIZATION}">          
            <xapl:if test="{count( $ids/ID[@Value = $org/ID/@Value] ) = 0 }">
              <docutil:add select="{$results}">
                <ENTITY>
                  <ID Value="{$org/ID/@Value}"/>
                  <NAME Value="{$org/FULL_NAME/@Value}"/>
                </ENTITY>
              </docutil:add>
            </xapl:if>
          </xapl:for-each>
        </xapl:when>
        <xapl:otherwise>
        </xapl:otherwise>
      </xapl:choose>
      
      <xapl:return>
        <xapl:value-of select="{$results}"/>
      </xapl:return>
    
  </x2:command>

    <!--************************************************************************-->  
  
  <x2:command public="yes" description="_" name="domainGetFCs">
    <x2:param name="criteria"/>
    <x2:param name="ids"/>
    <x2:param name="mode"/>
    
    <xapl:variable name="filter">
      <FILTER>
        <xapl:value-of select="{$criteria/*}"/>
      </FILTER>
    </xapl:variable>
  
    <xapl:variable name="fcs">
      <x2:execute command="omx.add_book.location.model:getFulfillmentCenters">
        <x2:with-param name="pFilter" select="{$filter}"/>
      </x2:execute>
    </xapl:variable>

    <xapl:variable name="results">
      <ENTITIES/>
    </xapl:variable>

      <xapl:choose>
        <xapl:when test="{$mode/@Value = 'getAssigned'}">
          <xapl:for-each varName="fc" select="{$fcs/FULFILLMENT_CENTER}">
            <docutil:add select="{$results}">
              <ENTITY>
                <ID Value="{$fc/ID/@Value}"/>
                <NAME Value="{$fc/FULL_NAME/@Value}"/>
              </ENTITY>
            </docutil:add>
          </xapl:for-each>
        </xapl:when>
        <xapl:when test="{$mode/@Value = 'getAll'}">
          <xapl:for-each varName="fc" select="{$fcs/FULFILLMENT_CENTER}">
            <xapl:if test="{count( $ids/ID[@Value = $fc/ID/@Value] ) = 0 }">
              <docutil:add select="{$results}">
                <ENTITY>
                  <ID Value="{$fc/ID/@Value}"/>
                  <NAME Value="{$fc/FULL_NAME/@Value}"/>
                </ENTITY>
              </docutil:add>
            </xapl:if>
          </xapl:for-each>
        </xapl:when>
        <xapl:otherwise>
        </xapl:otherwise>
      </xapl:choose>
  
      <xapl:return>
        <xapl:value-of select="{$results}"/>
      </xapl:return>
    
  </x2:command>
  
    <!--************************************************************************-->  
  
  <x2:command public="yes" description="_" name="addEntitiesToDomain">
    
      <xcore:execute-method name="//UserSecurity/addEntitiesToDomain" entireResponse="true">
        <xapl:value-of select="{$this/*}"/>
      </xcore:execute-method>
      <web:display-page>
        <web:get-page name="user_admin_domains">
          <USER_ID Value="{$this/USER_ID/@Value}"/>
          <ROLE_ID Value="{$this/ROLE_ID/@Value}"/>
          <EDIT Value="{$this/DOMAIN_TYPE_ID/@Value}"/>
        </web:get-page>
      </web:display-page>
    
  </x2:command>
  
    <!--************************************************************************-->  

  <x2:command public="yes" description="_" name="removeEntitiesFromDomain">
  
    <xapl:print select="$this"/>
    
      <xcore:execute-method name="//UserSecurity/removeEntitiesFromDomain">
        <xapl:value-of select="{$this/*}"/>
      </xcore:execute-method>
      <web:display-page>
        <web:get-page name="user_admin_domains">
          <USER_ID Value="{$this/USER_ID/@Value}"/>
          <ROLE_ID Value="{$this/ROLE_ID/@Value}"/>
          <EDIT Value="{$this/DOMAIN_TYPE_ID/@Value}"/>
        </web:get-page>
      </web:display-page>

  </x2:command>

    <!--************************************************************************-->  

</x2:commands>


















