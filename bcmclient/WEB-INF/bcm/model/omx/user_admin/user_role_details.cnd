<?xml version="1.0" encoding="UTF-8"?>
<x2:commands
	xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core"
	xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db"
	xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web"
	xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util"
	xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability"
	xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx"
	xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">

 <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="init">
    <xapl:variable name="roleDetails" resolver="session" global="true"/>
  </x2:command>

<!--* **********************************************************************
  ***********************************************************************-->
  <x2:command public="yes" description="_" name="display">
    <xapl:print select="{$this}"/>

    <xapl:if test="$this/CREATE_NEW/@Value = 'Yes'">
    	<xapl:set-variable name="adminProcess">
    		<ROLE_PROCESS Value="CREATE_NEW_ROLE"/>
    	</xapl:set-variable>
    	<xapl:set-variable name="roleDetails">
    		<RoleDetails/>
    	</xapl:set-variable>
    </xapl:if>

    <web:display-page>
      <web:get-page name="user_role_details">
        <xapl:value-of select="$this/ERROR_MESSAGE"/>
        <xapl:if test="string-length($this/SUCCESS_MESSAGE/@Value) &gt; 0">
          <SUCCESS_MESSAGE Value="{$this/SUCCESS_MESSAGE/@Value}"/>
        </xapl:if>
        <FORM_NAME Value="{$this/FORM_NAME/@Value}"/>
        <SERVICE Value="{$this/SERVICE/@Value}"/>
        <MAX_ROWS Value="{$this/MAX_ROWS/@Value}"/>
        <RETURN_ROW_COUNT Value="{$this/RETURN_ROW_COUNT[1]/@Value}"/>
        <SEARCH_TYPE Value="{$this/SEARCH_TYPE/@Value}"/>
        <DO_SEARCH Value="{$this/DO_SEARCH[1]/@Value}"/>
        <KEEP_SESSION_INFO Value="yes"/>
         <CREATE_NEW Value="{$this/CREATE_NEW[1]/@Value}"/>
        <FROM_ACT Value="{$this/FROM_ACT[1]/@Value}"/>
        <SELECTED_TAB Value="{$this/SELECTED_TAB[1]/@Value}"/>
      </web:get-page>
    </web:display-page>
  </x2:command>

<!--  **********************************************************************
    ***********************************************************************-->
  <x2:command public="yes" description="_" name="getRoleDetails">
    <xapl:print select="{$this}"/>
    <docutil:remove select="$this/SORT_ORDER"/>
    <docutil:remove select="$this/SORT_BY"/>
    <docutil:remove select="$this/START_COUNT"/>

    <docutil:remove select="{$roleDetails/*}"/>
    <web:display-page>
      <web:get-page name="user_role_details">
        <xapl:value-of select="$this/*[string-length(@Value) &gt; 0]"/>
      </web:get-page>
    </web:display-page>
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
  	<xapl:print select="$this"/>
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
      <x2:with-param name="display" select="'Role Details'"/>
      <x2:with-param name="page" select="'user_role_details'"/>
      <x2:with-param name="this" select="{$this}"/>
    </x2:execute>

    <xapl:choose>
    	<xapl:when test=" string-length($this/USER_ROLE.ID/@Value) &gt; 0 "> <!--when viewing a role details from role-search screen -->
    		<docutil:set select="$this">
        		<USER_ROLE_ID Value="{$this/USER_ROLE.ID/@Value}"/>
        		<FROM_CREATE Value="No"/>
      		</docutil:set>
      		<xapl:if test="not($this/KEEP_SESSION_INFO)">
	    		<xapl:set-variable name="roleDetails">
    	    		<RoleDetails>
        				<ROLE_ID Value="{$this/USER_ROLE.ID/@Value}"/>
        				<ROLE_NAME Value="{$this/USER_ROLE.NAME/@Value}"/>
        				<Activities/>
    				</RoleDetails>
    			</xapl:set-variable>
    		</xapl:if>
    	</xapl:when>
    	<xapl:otherwise>
      		<xapl:if test="$this/CREATE_NEW and $this/CREATE_NEW/@Value = 'Yes' ">
      			<xapl:variable name="tempRoleID"/>
            <xapl:if test="string-length($roleDetails/ROLE_ID/@Value) = 0">
                  <xapl:set-variable name="tempRoleID">
                    <xcore:execute-method name="//UserSecurity/getUniqueId" entireResponse="true">
                          <DOCUMENT_NAME Value="USER_ROLE"/>
                        </xcore:execute-method>
                  </xapl:set-variable>
                  <docutil:set select="$roleDetails">
                    <ROLE_ID Value="{concat('ROLE_ID-',substring-after($tempRoleID/RESPONSE/UNIQUE_ID/@Value, '-'))}"/>
                  </docutil:set>
                </xapl:if>

      			<xapl:variable name="tempRoleName"/>
            <xapl:if test="string-length($roleDetails/ROLE_NAME/@Value) = 0">
                  <xapl:set-variable name="tempRoleName">
                    <xcore:execute-method name="//UserSecurity/getUniqueId" entireResponse="true">
                          <DOCUMENT_NAME Value="USER_ROLE"/>
                        </xcore:execute-method>
                  </xapl:set-variable>
                  <docutil:set select="$roleDetails">
                    <ROLE_NAME Value="{concat('ROLE_NAME-',substring-after($tempRoleID/RESPONSE/UNIQUE_ID/@Value, '-'))}"/>
                  </docutil:set>
                </xapl:if>

    		</xapl:if>
    	</xapl:otherwise>
    </xapl:choose>

    <docutil:set select="$this">
      	<DO_SEARCH Value="Yes"/>
      	<SERVICE Value="UserSecurity"/>
      	<FORM_NAME Value="USR_SEC_ROLE_DETAILS_FORM"/>
        <xapl:choose>
          <xapl:when test="not($this/SELECTED_TAB) or string-length($this/SELECTED_TAB/@Value) = 0 or $this/SELECTED_TAB/@Value = 'WORKFLOW' ">
            <SELECTED_TAB Value="WORKFLOW"/>
            <F_UserActivity.ACTIVITY_TYPE Value="MenuForm"/>
          </xapl:when>
          <xapl:otherwise>
            <SELECTED_TAB Value="TABLE_EDITOR"/>
            <F_UserActivity.ACTIVITY_TYPE Value="UIForm"/>
          </xapl:otherwise>
        </xapl:choose>
    </docutil:set>

    <xapl:if test="not($this/CREATE_NEW/@Value = 'Yes') and ($adminProcess/@Value = 'CREATE_NEW_ROLE') ">
	    <docutil:set select="$this">
    	  	<CREATE_NEW Value="Yes"/>
    	</docutil:set>
    </xapl:if>
    <xapl:if test="$this/FROM_CREATE">
      <docutil:set select="$roleDetails">
      <FROM_CREATE Value="{$this/FROM_CREATE/@Value}"/>
      </docutil:set>
    </xapl:if>

	<!-- show admin activities to admin role only, restrict it for being assigned to other non admin roles-->
	<xapl:if test="$this/SELECTED_TAB/@Value = 'WORKFLOW' and $roleDetails/ROLE_ID/@Value = 'SU'">
	<xapl:print>
	  GET THE ADMIN ROLES ALSO FOR SU:::
	   <xapl:value-of select="$roleDetails/ROLE_ID/@Value"/>
	</xapl:print>
	 <docutil:set select="$this">
	    <F_UserActivity.ACTIVITY_TYPE Value="MenuForm,Admin"/>
	 </docutil:set>
	</xapl:if>
    <xapl:variable name="roleDetailsForm">
    	<ROLE_DETAILS_FORM>
	        <x2:execute command="bcm.framework.queryform.Form:getFormContainer">
    	      <x2:with-param name="this" select="$this"/>
        	  <x2:with-param name="pSearchParam" select="$searchParam"/>
	          <x2:with-param name="pFormName" select="'USR_SEC_ROLE_DETAILS_FORM'"/>
    	      <x2:with-param name="pServiceName" select="'UserSecurity'"/>
        	  <x2:with-param name="pSearchReportConfigSource" select="'omx.user_admin.user_role_details:getReportConfig'"/>
	          <x2:with-param name="pReportDataSource" select="'omx.user_admin.user_role_details:getReportData'"/>
    	    </x2:execute>
        </ROLE_DETAILS_FORM>
    </xapl:variable>

	<xapl:variable name="roleExists">
		<xapl:if test=" string-length($roleDetails/ROLE_ID/@Value) &gt; 0">
      		<xcore:execute-method name="//UserSecurity/validateRole" entireResponse="true">
        		<ROLE_ID Value="{$roleDetails/ROLE_ID/@Value}"/>
      		</xcore:execute-method>
      	</xapl:if>
	</xapl:variable>

	<docutil:set select="$this">
		<ROLE_EXISTS Value="{$roleExists/RESPONSE/IS_VALID/@Value}"/>
	</docutil:set>
    <xapl:return>
      <!-- Page Header as breadcrumbs-->
	  <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
	  <!-- Container-->
      <x2:execute command="omx.user_admin.user_role_details:getContainer">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
      <xapl:value-of select="$roleDetailsForm"/>
      <xapl:value-of select="$roleDetails"/>
      <!-- return parameters-->
      <xapl:value-of select="$this/*[string-length(@Value) &gt; 0]"/>
      <xapl:value-of select="$context"/>
    </xapl:return>
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <x2:param name="this"/>

    <xapl:variable name="help_url" select="'../../bcm/help/role_details_help.htm'"/>
    <xapl:if test="$this/CREATE_NEW[1]/@Value = 'Yes'">
    	<xapl:set-variable name="help_url" select="'../../bcm/help/create_role_details_help.htm'"/>
    </xapl:if>
    <xapl:print select="{$help_url}"/>

	<xapl:variable name="roleExists">
		<xapl:if test=" string-length($roleDetails/ROLE_ID/@Value) &gt; 0">
      		<xcore:execute-method name="//UserSecurity/validateRole" entireResponse="true">
        		<ROLE_ID Value="{$roleDetails/ROLE_ID/@Value}"/>
      		</xcore:execute-method>
      	</xapl:if>
	</xapl:variable>

    <xapl:return>
      <CONTAINER Scrollable="no">
        <HELP Url="{$help_url}"/>
        <!--<STEP Name="ViewForm" DisplayText="Role Details" OnClick="{$pages:user_role_details}" Selected="true"/>-->
        <STEP  DisplayText="Workflow Role Details" OnClick="javascript:showTab('WORKFLOW')" Selected="{$this/SELECTED_TAB/@Value = 'WORKFLOW'}"/>
        <STEP OnClick="javascript:showTab('TABLE_EDITOR')" Selected="{$this/SELECTED_TAB/@Value = 'TABLE_EDITOR'}" DisplayText="Table Editor Role Details"/>
        <BUTTONS>
              <BUTTON Id="Cancel" Name="Cancel" DisplayText="Cancel" OnClick="javascript:onCancel()" DisableOnClick="true"/>
              <DIVIDER/>
              <BUTTON Id="Add" Name="Add" DisplayText="Add Activities" OnClick="javascript:onAdd()" DisableOnClick="true" />
              <DIVIDER/>
              <BUTTON Id="Remove" Name="Remove" DisplayText="Remove Activities" OnClick="javascript:onRemove()" DisableOnClick="true" Disabled="report"/>




              <xapl:choose>
                <xapl:when test="$adminProcess/@Value = 'CREATE_NEW_ROLE' and count($roleDetails/Activities/Activity) = 0">
                  <!--<BUTTON Id="Save" Name="Save" DisplayText="Save" OnClick="javascript:onSave()" DisableOnClick="true" Disabled="true"/>-->
        <!--					<BUTTON Id="SaveAndReturn" Name="SaveAndReturn" DisplayText="Save And Return" OnClick="javascript:onSaveAndReturn()" DisableOnClick="true" Disabled="true"/>-->
                </xapl:when>
                <xapl:otherwise>
                  <!--<BUTTON Id="Save" Name="Save" DisplayText="Save" OnClick="javascript:onSave()" DisableOnClick="true"/>-->
        <!--					<BUTTON Id="SaveAndReturn" Name="SaveAndReturn" DisplayText="Save And Return" OnClick="javascript:onSaveAndReturn()" DisableOnClick="true"/>-->
                </xapl:otherwise>
              </xapl:choose>

              <xapl:if test="$roleExists/RESPONSE/IS_VALID/@Value = 'true' ">
                <DIVIDER/>
                <BUTTON Id="SaveAsNew" Name="SaveAsNew" DisplayText="Save As New" OnClick="javascript:onSaveAsNew()" DisableOnClick="true"/>
              </xapl:if>
        </BUTTONS>
      </CONTAINER>
    </xapl:return>
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportConfig">
    <x2:param name="this" select="$this"/>
    <xapl:return>
      <REPORT Title="User Activities" Action="UserRoleDetails.jsp" PagingTitle="yes" Scrollable="yes" Selectable="All" ScrollableContainer="yes" Id="#" SelectedId="SELECTED_ACT_ID">
        <FIELDS>
          <FIELD Name="UPDATE_ALL" DisplayType="Hidden" Value="NO"/>
          <!--get form's report fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
<!--  Removed this check  to enable the  feature of giving permissions at Activity level -->
          <!-- xapl:if test="$this/SELECTED_TAB/@Value = 'TABLE_EDITOR' " -->
            <FIELD
              Sequence="3"
              Name="cb_view"
              Document="Doc1"
              Property="Prop1"
              DisplayText="View"
              Disabled="true"
              DisplayType="CheckBox2"
              />
            <FIELD
              Sequence="3"
              Name="cb_create"
              Document="Doc1"
              Property="Prop1"
              DisplayText="Create"
              Disabled="true"
              DisplayType="CheckBox2"
              />
            <FIELD
              Sequence="3"
              Name="cb_edit"
              Document="Doc1"
              Property="Prop1"
              DisplayText="Edit"
              Disabled="true"
              DisplayType="CheckBox2"
              />
            <FIELD
              Sequence="3"
              Name="cb_delete"
              Document="Doc1"
              Property="Prop1"
              DisplayText="Delete"
              Disabled="true"
              DisplayType="CheckBox2"
              />
          <!-- /xapl:if -->
          <!-- get Hidden Fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
          <FIELD Name="SELECTED_TAB" DisplayType="Hidden" Value="{$this/SELECTED_TAB/@Value}"/>
        </FIELDS>
<!--        <BUTTONS>
          <BUTTON Id="Remove" Name="Remove" DisplayText="Remove" OnClick="javascript:onRemove()" DisableOnClick="true"/>
        </BUTTONS>-->
        <PAGINATION/>
      </REPORT>
    </xapl:return>
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportData">
    <x2:param name="this"/>
    <x2:param name="pForm"/>

<!--	<xapl:variable name="data">
      <xapl:choose>
        <xapl:when test="{ (string-length($this/USER_ROLE_ID/@Value) != 0) and (count($roleDetails/Activities/Activity) = 0)}">
          <xcore:execute-method name="{concat('//' , $this/SERVICE/@Value, '/getFormData')}" StartAtRow="{$this/*[name() = 'START_COUNT']/@Value}" MaxRows="1000" ReturnRowCount="yes" entireResponse="true">
            <ID Value="{$currentForm/@Id}"/>
            <FILTER Name="ROLE_ID" Document="ROLE_TEMPLATE">
              <xcore:search-by property="ROLE_ID" value="{$this/USER_ROLE_ID/@Value}" matchby="EQUAL"/>
            </FILTER>
          </xcore:execute-method>
        </xapl:when>
        <xapl:otherwise>
          <RESPONSES>
            <RESPONSE/>
          </RESPONSES>
        </xapl:otherwise>
      </xapl:choose>
    </xapl:variable>

    <xapl:if test="count($data/RESPONSE/*) != 0">
      <docutil:add select="$roleDetails/Activities">
        <xapl:for-each varName="activityVar" select="$data/RESPONSE/JOIN_RESULT">
          <Activity Action="MODIFY">
            <xapl:value-of select="$activityVar/*"/>
            <ACTIVITY_ID Value="{$activityVar/ROLE_TEMPLATE.ACTIVITY_ID/@Value}"/>
          </Activity>
        </xapl:for-each>
      </docutil:add>
    </xapl:if>

    <xapl:print select="$roleDetails"/>

    <xapl:variable name="reportData">
      <RESPONSE>
        <xapl:if test="not(count($roleDetails/Activities/Activity[@Action != 'REMOVE']) = 0)">
          <TOTAL_RECORD_COUNT Value="{count($roleDetails/Activities/Activity[@Action != 'REMOVE'])}"/>
          <START_AT_ROW Value="{$this/START_COUNT/@Value}"/>
        </xapl:if>
        <xapl:value-of select="$roleDetails/Activities/Activity[@Action != 'REMOVE']"/>
      </RESPONSE>
    </xapl:variable>-->



      <docutil:set select="$this">
        <SORT_BY Value="UserActivity.NAME"/>
        <SORT_ORDER Value="Ascending"/>
        <F_ROLE_TEMPLATE.ROLE_ID Value="{$roleDetails/ROLE_ID/@Value}"/>
      </docutil:set>

     <xapl:variable name="data">
       <xapl:if test="((string-length($this/ERROR_MESSAGE/@Value) = 0) or ((string-length($this/ERROR_MESSAGE/@Value) > 0) and ($roleDetails/FROM_CREATE/@Value = 'No')))">
          <x2:execute command="bcm.framework.queryform.Form:getFormReportData">
            <x2:with-param name="this" select="$this"/>
            <x2:with-param name="fromProperty" select="'SEARCH_PROPERTY'"/>
            <x2:with-param name="delimeter" select="'.'"/>
          </x2:execute>
       </xapl:if>
     </xapl:variable>
<!--  Removed this check  to enable the  feature of giving permissions at Activity level -->
    <!-- xapl:if test="$this/SELECTED_TAB/@Value = 'TABLE_EDITOR'" -->
      <xapl:for-each varName="activityVar" select="$data/JOIN_RESULT">
        <!--<xapl:variable name="accessLevelDoc">
          <x2:execute command="bcm.framework.util:createXMLFromString">
            <x2:with-param name="string" select="{$activityVar/ACCESS_LEVEL/@Value}"/>
            <x2:with-param name="delimeter" select="'+'"/>
            <x2:with-param name="tagname" select="'ACCESS_LEVEL'"/>
          </x2:execute>
        </xapl:variable>-->
        <docutil:add select="$activityVar">
            <xapl:if test="contains($activityVar/ROLE_TEMPLATE.ACCESS_LEVEL/@Value , 'View')">
              <cb_view Value="checked"/>
            </xapl:if>
            <xapl:if test="contains($activityVar/ROLE_TEMPLATE.ACCESS_LEVEL/@Value , 'Add')">
              <cb_create Value="checked"/>
            </xapl:if>
            <xapl:if test="contains($activityVar/ROLE_TEMPLATE.ACCESS_LEVEL/@Value , 'Update')">
              <cb_edit Value="checked"/>
            </xapl:if>
            <xapl:if test="contains($activityVar/ROLE_TEMPLATE.ACCESS_LEVEL/@Value , 'Remove')">
              <cb_delete Value="checked"/>
            </xapl:if>
        </docutil:add>

      </xapl:for-each>
    <!-- /xapl:if -->


    <xapl:print>
      DATA:::<xapl:value-of select="$data"/>
    </xapl:print>

      <docutil:remove select="$roleDetails/Activities/*"/>

      <docutil:add select="$roleDetails/Activities">
        <xapl:for-each varName="activityVar" select="$data/JOIN_RESULT">
          <Activity Action="MODIFY">
            <xapl:value-of select="$activityVar/*"/>
            <ACTIVITY_ID Value="{$activityVar/ROLE_TEMPLATE.ACTIVITY_ID/@Value}"/>
          </Activity>
        </xapl:for-each>
      </docutil:add>

    <xapl:print select="$roleDetails"/>


    <xapl:return>
    	<xapl:value-of select="$data"/>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="removeActivities">
    <xapl:print select="{$this}"/>
    <docutil:set select="{$roleDetails/ROLE_NAME/@Value}">
    	<xapl:value-of select="$this/ROLE_NAME/@Value"/>
    </docutil:set>

    <xapl:for-each varName="selectedID" select="$this/SELECTED_ACT_ID">
    	<xapl:variable name="roleID"/>
    	<xapl:set-variable name="roleID">
    		<x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
  				<x2:with-param name="selectedId" select="{$selectedID/@Value}"/>
        		<x2:with-param name="key" select="'ROLE_TEMPLATE.ACTIVITY_ID'"/>
        	</x2:execute>
        </xapl:set-variable>
<!--        <xapl:choose>
        	<xapl:when test="count($roleDetails/Activities/Activity[@Action = 'ADD' and ROLE_TEMPLATE.ACTIVITY_ID/@Value = $roleID]) != 0">
        		<docutil:remove select="$roleDetails/Activities/Activity[@Action = 'ADD' and ROLE_TEMPLATE.ACTIVITY_ID/@Value = $roleID]"/>
        	</xapl:when>
        	<xapl:when test="count($roleDetails/Activities/Activity[@Action = 'ADD' and ROLE_TEMPLATE.ACTIVITY_ID/@Value = $roleID]) = 0">
		        <docutil:set select="{$roleDetails/Activities/Activity[ROLE_TEMPLATE.ACTIVITY_ID/@Value = $roleID]/@Action}">REMOVE</docutil:set>
        	</xapl:when>
        </xapl:choose>-->
		    <docutil:set select="{$roleDetails/Activities/Activity[ROLE_TEMPLATE.ACTIVITY_ID/@Value = $roleID]/@Action}">REMOVE</docutil:set>
    </xapl:for-each>

    <docutil:remove select="$roleDetails/Activities/Activity[@Action = 'MODIFY' ]"/>

    <xapl:print>
      :::REMOVE
      <xapl:value-of select="$roleDetails"/>
    </xapl:print>
    <xapl:variable name="response">
      <xcore:execute-method name="//UserSecurity/manageRoleDetails" entireResponse="true">
        <xapl:value-of select="{$roleDetails}"/>
      </xcore:execute-method>
    </xapl:variable>

    <xapl:print select="{$response}"/>

    <docutil:add select="$this">
      <x2:execute command="bcm.framework.util:getResponseStatus">
        <x2:with-param name="response" select="$response"/>
        <x2:with-param name="successMessage" select=" 'ROLE_DETAILS_DELETED_SUCCESSFULLY' "/>
      </x2:execute>
    </docutil:add>

	  <x2:execute command="omx.user_admin.user_role_details:display">
    	<x2:with-param name="this" select="$this"/>
    </x2:execute>

  </x2:command>

  <!--  **********************************************************************
   ***********************************************************************-->
  <x2:command public="yes" description="_" name="saveRoleDetails">
    <xapl:print select="{$this}"/>
    <xapl:print>
      ######### roleDetails:::: <xapl:value-of select="$roleDetails"/>
    </xapl:print>
    <xapl:if test="$this/ACTION/@Value = 'SAVE_AS_NEW'">
      <xapl:set-variable name="adminProcess">
         <ROLE_PROCESS Value="CREATE_NEW_ROLE"/>
      </xapl:set-variable>
    		<docutil:set select="$roleDetails">
    			<ACTION_TYPE Value="CREATE_NEW"/>
          <FROM_ROLE_ID Value="{$roleDetails/ROLE_ID/@Value}"/>
         <FROM_ROLE_NAME Value="{$roleDetails/ROLE_NAME/@Value}"/>
    		</docutil:set>
        <docutil:remove select="$roleDetails/Activities/*"/>
    </xapl:if>

    <xapl:print>
      ######### roleDetails 2:::: <xapl:value-of select="$roleDetails"/>
    </xapl:print>

	<docutil:set select="$roleDetails/ROLE_ID/@Value">
   		<xapl:value-of select="{$this/ROLE_ID/@Value}"/>
    </docutil:set>

	<docutil:set select="$roleDetails/ROLE_NAME/@Value">
   		<xapl:value-of select="{$this/ROLE_NAME/@Value}"/>
    </docutil:set>

    <xapl:print>
      ######### roleDetails 3:::: <xapl:value-of select="$roleDetails"/>
    </xapl:print>

    <xapl:variable name="response">
      <xcore:execute-method name="//UserSecurity/manageRoleDetails" entireResponse="true">
        <xapl:value-of select="{$roleDetails}"/>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:print select="{$response}"/>

    <docutil:add select="$this">
      <x2:execute command="bcm.framework.util:getResponseStatus">
        <x2:with-param name="response" select="$response"/>
        <x2:with-param name="successMessage" select=" 'ROLE_SAVED_SUCCESSFULLY' "/>
      </x2:execute>
    </docutil:add>
	<xapl:variable name="frmRoleID">
	 	<xapl:value-of select="{$roleDetails/FROM_ROLE_ID/@Value}"/>
	</xapl:variable>
	<xapl:variable name="frmRoleName">
		 <xapl:value-of select="{$roleDetails/FROM_ROLE_NAME/@Value}"/>
	</xapl:variable>
	<!--clean up once you get the response chandru-->
	<docutil:remove select="{$roleDetails/ACTION_TYPE}"/>
	<docutil:remove select="{$roleDetails/FROM_ROLE_ID}"/>
	<docutil:remove select="{$roleDetails/FROM_ROLE_NAME}"/>

    <xapl:choose>
      <!-- if ERROR_MESSAGE exists.-->
      <xapl:when test="not(string-length($this/ERROR_MESSAGE/@Value) = 0 )">
	<docutil:set select="$roleDetails">
		<ROLE_ID Value="{$frmRoleID}"/>
		<ROLE_NAME Value="{$frmRoleName}"/>
	</docutil:set>
	<xapl:print>
		TO DISPLAY OLD ROLE ID and NAME ON ERROR PAGE
		<xapl:value-of select="$roleDetails"/>
	</xapl:print>
	<x2:execute command="omx.user_admin.user_role_details:display">
		<x2:with-param name="this" select="$this"/>
	</x2:execute>
      </xapl:when>

      <!-- to RETURN to same details page -->
      <xapl:when test="($this/TO_RETURN/@Value = 'No') and (string-length($this/ERROR_MESSAGE/@Value) = 0 )">
      	<!-- Nullify the ongoing workflow such as CREATE_NEW_ROLE -->
      	<xapl:set-variable name="adminProcess"/>
      	<docutil:set select="$roleDetails/ROLE_NAME/@Value">
      		<xapl:value-of select="{$response/RESPONSE/ROLE_NAME/@Value}"/>
      	</docutil:set>
<!--        <docutil:set select="$roleDetails/Activities/Activity[@Action = 'ADD']/@Action">MODIFY</docutil:set>
        <docutil:remove select="$roleDetails/Activities/Activity[@Action = 'REMOVE']"/>-->
        <x2:execute command="omx.user_admin.user_role_details:display">
          <x2:with-param name="this" select="$this"/>
        </x2:execute>
      </xapl:when>

      <!-- to RETURN to home page -->
      <xapl:when test="($this/TO_RETURN/@Value = 'Yes') and (string-length($this/ERROR_MESSAGE/@Value) = 0)">
      	<!-- Nullify the ongoing workflow such as CREATE_NEW_ROLE -->
      	<xapl:set-variable name="adminProcess"/>
        <docutil:add select="$this">
          <ACTION Value="INIT"/>
        </docutil:add>
        <x2:execute command="omx.user_admin.user_role_details:displayRoleSearchPage">
          <x2:with-param name="this" select="$this"/>
        </x2:execute>
      </xapl:when>
    </xapl:choose>
  </x2:command>

  <!--**********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="displayRoleSearchPage">
  		<xapl:if test="(string-length($this/ACTION/@Value) != 0) and  ($this/ACTION/@Value = 'INIT')">
  	    	<xapl:set-variable name="roleDetails">
        		<RoleDetails/>
        	</xapl:set-variable>
        </xapl:if>
        <!-- Nullify the ongoing workflow such as CREATE_NEW_ROLE -->
      	<xapl:set-variable name="adminProcess"/>

		<web:display-page>
      		<web:get-page name="user_role_search">
      			<xapl:value-of select="$this/*[string-length(@Value) &gt; 0]"/>
      		</web:get-page>
		</web:display-page>
  </x2:command>

 <!--  **********************************************************************
   ***********************************************************************-->
</x2:commands>