<?xml version="1.0" encoding="UTF-8"?>
<x2:commands description="_"
            xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE"
            xmlns:cfg="http://www.i2.com/configurability" xmlns:core="http://www.i2.com/core"
            xmlns:omx="http://www.i2.com/omx" xmlns:perm="http://www.i2.com/permissibility"
            xmlns:util="http://www.i2.com/util" xmlns:web="http://www.i2.com/web"
            xmlns:x2="http://www.i2.com/x2" xmlns:xapl="http://www.i2.com/xapl"
            xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db"
            xmlns:docutil="http://www.i2.com/docutil" xmlns:xudl="http://www.i2.com/xudl"
            xmlns:identity="http://www.i2.com/identity">

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="init">
    <xapl:variable name="userGroupDomainData" resolver="session" global="true"/>
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
    <xapl:print select="$this"/>
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
      <x2:with-param name="display" select="'UserSecurity.User_Group_Domain'"/>
      <x2:with-param name="page" select="'user_group_domain'"/>
      <x2:with-param name="this" select="{$this}"/>
    </x2:execute>

    <xapl:if test="not($this/USER_GROUP_ID)">
        <docutil:set select="$this">
            <USER_GROUP_ID Value="{$userGroupProfileData/USER_GRP_PROFILE/ID/@Value}"/>
        </docutil:set>
    </xapl:if>

    <xapl:if test="$this/LOAD_FIRST/@Value = 'YES'">
        <xapl:set-variable name="userGroupDomainData">
            <DomainDetails>
                <INCLUDE/>
                <EXCLUDE/>
            </DomainDetails>
        </xapl:set-variable>
    </xapl:if>
    <docutil:remove select="$this/LOAD_FIRST"/>

    <xapl:variable name="domainDetailsForm">
        <DOMAIN_DETAILS_FORM>
            <x2:execute command="bcm.framework.queryform.Form:getFormContainer">
              <x2:with-param name="this" select="$this"/>
              <x2:with-param name="pSearchParam" select="$searchParam"/>
              <x2:with-param name="pFormName" select="'USER_AUTH_DOCS_FORM'"/>
              <x2:with-param name="pServiceName" select="'BCMMasterService'"/>
              <x2:with-param name="pSearchReportConfigSource" select="'omx.user_admin.user_group_domain:getReportConfig'"/>
              <x2:with-param name="pReportDataSource" select="'omx.user_admin.user_group_domain:getReportData'"/>
            </x2:execute>
        </DOMAIN_DETAILS_FORM>
    </xapl:variable>

    <xapl:return>
        <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
        <x2:execute command="omx.user_admin.user_group_domain:getTabs">
            <x2:with-param name="this" select="{$this}"/>
        </x2:execute>
        <xapl:value-of select="$domainDetailsForm"/>
        <xapl:value-of select="$userGroupProfileData/*"/>
        <xapl:value-of select="$this/*[string-length(@Value) &gt; 0]"/>
        <xapl:value-of select="$this/INCLUDE_NOT_ADDED"/>
        <xapl:value-of select="$this/EXCLUDE_NOT_ADDED"/>
    </xapl:return>

  </x2:command>

  <!-- **************************************************************************
    ************************************************************************** -->
  <x2:command public="yes" description="_" name="getTabs">
    <xapl:return>
      <CONTAINER Scrollable="no">
        <xapl:if test="$this/SELECTED_TAB/@Value = 'INCLUDE'">
          <HELP Url="../../bcm/help/assign_domain_include_node_help.htm"/>
        </xapl:if>
        <xapl:if test="$this/SELECTED_TAB/@Value = 'EXCLUDE'">
          <HELP Url="../../bcm/help/assign_domain_exclude_node_help.htm"/>
        </xapl:if>
        <STEP OnClick="javascript:showTab('INCLUDE')" Selected="{$this/SELECTED_TAB/@Value = 'INCLUDE'}" DisplayText="Included Nodes"/>
        <STEP OnClick="javascript:showTab('EXCLUDE')" Selected="{$this/SELECTED_TAB/@Value = 'EXCLUDE'}" DisplayText="Excluded Nodes"/>
        <BUTTONS>
            <BUTTON DisplayText="Cancel" OnClick="javascript:onCancel();"/>
            <DIVIDER/>
            <BUTTON DisplayText="Save" OnClick="javascript:onSave();"/>
            <BUTTON DisplayText="Save and Return" OnClick="javascript:onSaveAndReturn();"/>
        </BUTTONS>
      </CONTAINER>
    </xapl:return>
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportConfig">
    <x2:param name="this" select="$this"/>
    <xapl:variable name="reportTitle">
        <xapl:if test="$this/SELECTED_TAB/@Value = 'INCLUDE'">Included Nodes</xapl:if>
        <xapl:if test="$this/SELECTED_TAB/@Value = 'EXCLUDE'">Excluded Nodes</xapl:if>
    </xapl:variable>
    <xapl:return>
      <REPORT Title="{$reportTitle}" Action="{$pages:user_group_domain}" Scrollable="yes" Selectable="All" ScrollableContainer="no" Id="#" SelectedId="SELECTED_NODE_ID">
        <FIELDS>
          <!--EQ:550569 Overridden falg is added to remove the favorites and customization icons-->
          <OVERRIDDEN Value="yes"/>  
          <FIELD Name="UPDATE_ALL" DisplayType="Hidden" Value="NO"/>
          <FIELD Name="USER_GROUP_ID" DisplayType="Hidden" Value="{$this/USER_GROUP_ID/@Value}"/>
          <FIELD Name="SELECTED_TAB" DisplayType="Hidden" Value="{$this/SELECTED_TAB/@Value}"/>
          <FIELD Name="WHERE" DisplayType="Hidden" Value="{$this/WHERE/@Value}"/>
          <!--get form report fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
          <!-- get hidden Fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
        </FIELDS>
        <xapl:if test="$this/SELECTED_TAB/@Value = 'INCLUDE'">
          <BUTTONS>
            <BUTTON DisplayText="Add" OnClick="javascript:onAddNodes('INCLUDE');"/>
            <DIVIDER/>
            <BUTTON DisplayText="Remove" Disabled="report" OnClick="javascript:onRemoveNodes('INCLUDE');"/>
          </BUTTONS>
        </xapl:if>
        <xapl:if test="$this/SELECTED_TAB/@Value = 'EXCLUDE'">
          <BUTTONS>
            <BUTTON DisplayText="Add" OnClick="javascript:onAddNodes('EXCLUDE');"/>
            <DIVIDER/>
            <BUTTON DisplayText="Remove" Disabled="report" OnClick="javascript:onRemoveNodes('EXCLUDE');"/>
          </BUTTONS>
        </xapl:if>
      </REPORT>
    </xapl:return>
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportData">
    <x2:param name="this"/>
    <x2:param name="pForm"/>

    <xapl:variable name="data">
        <xapl:if test="count($userGroupDomainData/*[name() = $this/SELECTED_TAB/@Value]/Node) = 0 ">
            <xcore:execute-method name="{concat('//' , 'BCMMasterService', '/getAuthDocsFormData')}" entireResponse="true">
                <ID Value="{$currentForm/@Id}"/>
                <USER_GROUP_ID Value="{$this/USER_GROUP_ID/@Value}"/>
            </xcore:execute-method>
        </xapl:if>
        <xapl:otherwise>
          <RESPONSES>
            <RESPONSE>
                <INCLUDE/>
                <EXCLUDE/>
            </RESPONSE>
          </RESPONSES>
        </xapl:otherwise>
    </xapl:variable>

    <!-- update the userGroupDomain session data -->
    <xapl:if test="count($data/RESPONSE/*[name() = $this/SELECTED_TAB/@Value]/*) != 0">
        <xapl:if test="count($userGroupDomainData/*[name() = $this/SELECTED_TAB/@Value]/Node) = 0 ">
          <docutil:add select="$userGroupDomainData/*[name() = $this/SELECTED_TAB/@Value]">
            <xapl:for-each varName="nodeVar" select="$data/RESPONSE/*[name() = $this/SELECTED_TAB/@Value]/JOIN_RESULT">
              <Node Action="MODIFY">
                <xapl:value-of select="$nodeVar/*"/>
                <NodeId Value="{concat($nodeVar/Hierarchy.Id/@Value,':',$nodeVar/Level.Id/@Value,':',$nodeVar/Member.Id/@Value)}"/>
              </Node>
            </xapl:for-each>
          </docutil:add>
        </xapl:if>
    </xapl:if>
    <xapl:if test="count($data/RESPONSE/*[name() != $this/SELECTED_TAB/@Value]/*) != 0">
        <xapl:if test="count($userGroupDomainData/*[name() != $this/SELECTED_TAB/@Value]/Node) = 0 ">
          <docutil:add select="$userGroupDomainData/*[name() != $this/SELECTED_TAB/@Value]">
            <xapl:for-each varName="nodeVar" select="$data/RESPONSE/*[name() != $this/SELECTED_TAB/@Value]/JOIN_RESULT">
              <Node Action="MODIFY">
                <xapl:value-of select="$nodeVar/*"/>
                <NodeId Value="{concat($nodeVar/Hierarchy.Id/@Value,':',$nodeVar/Level.Id/@Value,':',$nodeVar/Member.Id/@Value)}"/>
              </Node>
            </xapl:for-each>
          </docutil:add>
        </xapl:if>
    </xapl:if>

    <xapl:print select="$userGroupDomainData"/>

    <xapl:variable name="reportData">
      <RESPONSE>
        <xapl:if test="count($userGroupDomainData/*[name() = $this/SELECTED_TAB/@Value]/Node[@Action != 'REMOVE']) != 0 ">
          <TOTAL_RECORD_COUNT Value="{count($userGroupDomainData/*[name() = $this/SELECTED_TAB/@Value]/Node[@Action != 'REMOVE'])}"/>
          <START_AT_ROW Value="{$this/START_COUNT/@Value}"/>
        </xapl:if>
        <xapl:value-of select="{$userGroupDomainData/*[name() = $this/SELECTED_TAB/@Value]/Node[@Action != 'REMOVE']}"/>
      </RESPONSE>
    </xapl:variable>

    <xapl:return>
        <xapl:value-of select="$reportData"/>
    </xapl:return>
  </x2:command>

  <!-- **********************************************************************
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="removeNodes">
    <xapl:print select="{$this}"/>
    <xapl:print>
    POONAM
    </xapl:print>

    <xapl:for-each varName="selectedID" select="$this/SELECTED_NODE_ID">
        <xapl:variable name="memID"/>
        <xapl:set-variable name="memID">
            <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
                <x2:with-param name="selectedId" select="{$selectedID/@Value}"/>
                <x2:with-param name="key" select="'Member.Id'"/>
            </x2:execute>
        </xapl:set-variable>
        <xapl:print select="$memID"/>
        <docutil:set select="{$userGroupDomainData/*[name() = $this/SELECTED_TAB/@Value]/Node[Member.Id/@Value = $memID]/@Action}">REMOVE</docutil:set>
    </xapl:for-each>

    <docutil:remove select="{$this/Hierarchy.Id}"/>
    <docutil:remove select="{$this/SELECTED_NODE_ID}"/>
    <docutil:remove select="{$this/Member.Id}"/>
    <docutil:remove select="{$this/Dimension.Id}"/>
    <docutil:remove select="{$this/Level.Id}"/>
    <web:display-page>
        <web:get-page name="user_group_domain">
              <xapl:value-of select="$this/*[string-length(@Value) &gt; 0]"/>
          </web:get-page>
    </web:display-page>
  </x2:command>

  <!--  **********************************************************************
   ***********************************************************************-->
  <x2:command public="yes" description="_" name="saveDomainDetails">
    <xapl:print select="{$this}"/>

    <xapl:variable name="serverArgs">
        <x2:execute command="omx.user_admin.user_group_domain:prepareDomainDetailsArgs">
          <x2:with-param name="this" select="$this"/>
        </x2:execute>
    </xapl:variable>

    <xapl:variable name="response">
      <xcore:execute-method name="//UserSecurity/manageUserGroupAuthorization" entireResponse="true">
        <xapl:value-of select="{$serverArgs/*}"/>
      </xcore:execute-method>
    </xapl:variable>

    <docutil:add select="$this">
      <x2:execute command="bcm.framework.util:getResponseStatus">
        <x2:with-param name="response" select="$response"/>
        <x2:with-param name="successMessage" select=" 'UserSecurity.Domain_Details_Saved_Successfully' "/>
      </x2:execute>
    </docutil:add>

    <xapl:choose>
      <!-- if ERROR_MESSAGE exists.-->
      <xapl:when test="not(string-length($this/ERROR_MESSAGE/@Value) = 0 )">
        <web:display-page>
            <web:get-page name="user_group_domain">
                  <xapl:value-of select="$this/*[string-length(@Value) &gt; 0]"/>
              </web:get-page>
        </web:display-page>
      </xapl:when>

      <!-- to return to same details page -->
      <xapl:when test="($this/TO_RETURN/@Value = 'NO') and (string-length($this/ERROR_MESSAGE/@Value) = 0 )">
        <docutil:set select="$domainDetails/*[name() = 'INCLUDE' or name() = 'EXCLUDE']/Node[@Action = 'ADD']/@Action">MODIFY</docutil:set>
        <docutil:remove select="$domainDetails/*[name() = 'INCLUDE' or name() = 'EXCLUDE']/Node[@Action = 'REMOVE']"/>
        <web:display-page>
            <web:get-page name="user_group_domain">
                  <xapl:value-of select="$this/*[string-length(@Value) &gt; 0]"/>
              </web:get-page>
        </web:display-page>
      </xapl:when>

      <!-- to return to user group details page -->
      <xapl:when test="($this/TO_RETURN/@Value = 'YES') and (string-length($this/ERROR_MESSAGE/@Value) = 0)">
        <docutil:set select="$this">
            <WHERE Value="USER_GROUP_MAIN"/>
        </docutil:set>
        <xapl:set-variable name="adminProcess"/>
        <xapl:set-variable name="userGroupDomainData"/>
        <x2:execute command="omx.user_admin.user_group_domain:goToPage">
            <x2:with-param name="this" select="$this"/>
        </x2:execute>
      </xapl:when>
    </xapl:choose>
  </x2:command>

  <!--  **********************************************************************
   ***********************************************************************-->
  <x2:command description="Used by this file only" name="prepareDomainDetailsArgs">
    <x2:param name="this"/>
    <xapl:variable name="domainDetails">
        <AUTHORIZATION/>
    </xapl:variable>
    <!-- nodes for the selected tab -->
    <xapl:for-each varName="nodeVar" select="$userGroupDomainData/*[name() = $this/SELECTED_TAB/@Value]/Node[@Action != 'REMOVE']">
        <xapl:if test="count($domainDetails/DIMENSION[@Id = $nodeVar/Dimension.Id/@Value]) = 0">
            <docutil:add select="$domainDetails">
                <DIMENSION Id="{$nodeVar/Dimension.Id/@Value}"/>
            </docutil:add>
        </xapl:if>
        <xapl:if test="count($domainDetails/DIMENSION[@Id = $nodeVar/Dimension.Id/@Value]/*[name() = $this/SELECTED_TAB/@Value]) = 0">
            <docutil:add select="$domainDetails/DIMENSION[@Id = $nodeVar/Dimension.Id/@Value]">
                <docutil:element name="{$this/SELECTED_TAB/@Value}"/>
            </docutil:add>
        </xapl:if>
        <docutil:add select="$domainDetails/DIMENSION[@Id = $nodeVar/Dimension.Id/@Value]/*[name() = $this/SELECTED_TAB/@Value]">
            <MEMBER NodeId="{$nodeVar/NodeId/@Value}"/>
        </docutil:add>
    </xapl:for-each>

    <!-- nodes for the un-selected tab -->
    <xapl:variable name="unselectedTab">
            <xapl:if test=" $this/SELECTED_TAB/@Value = 'INCLUDE' "><xapl:value-of select="'EXCLUDE'"/></xapl:if>
            <xapl:if test=" $this/SELECTED_TAB/@Value = 'EXCLUDE' "><xapl:value-of select="'INCLUDE'"/></xapl:if>
    </xapl:variable>
    <xapl:for-each varName="nodeVar" select="$userGroupDomainData/*[name() = $unselectedTab]/Node[@Action != 'REMOVE']">
        <xapl:if test="count($domainDetails/DIMENSION[@Id = $nodeVar/Dimension.Id/@Value]) = 0">
            <docutil:add select="$domainDetails">
                <DIMENSION Id="{$nodeVar/Dimension.Id/@Value}"/>
            </docutil:add>
        </xapl:if>
        <xapl:if test="count($domainDetails/DIMENSION[@Id = $nodeVar/Dimension.Id/@Value]/*[name() = $unselectedTab]) = 0">
            <docutil:add select="$domainDetails/DIMENSION[@Id = $nodeVar/Dimension.Id/@Value]">
                <docutil:element name="{$unselectedTab}"/>
            </docutil:add>
        </xapl:if>
        <docutil:add select="$domainDetails/DIMENSION[@Id = $nodeVar/Dimension.Id/@Value]/*[name() = $unselectedTab]">
            <MEMBER NodeId="{$nodeVar/NodeId/@Value}"/>
        </docutil:add>
    </xapl:for-each>

    <xapl:return>
        <DOMAIN_ARGS>
            <USER_GRP_ID Value="{$this/USER_GROUP_ID/@Value}"/>
            <xapl:value-of select="$domainDetails"/>
        </DOMAIN_ARGS>
    </xapl:return>
  </x2:command>

 <!--************************************************************************
    ************************************************************************-->
  <x2:command public="yes" description="_" name="goToPage">
    <xapl:print select="$this"/>
    <xapl:variable name="whereToGo" select="{$this/WHERE[1]/@Value}"/>

    <xapl:choose>
      <!-- when pressed 'Cancel' on domain details screen -->
      <xapl:when test=" 'ONCANCEL' = $whereToGo ">
        <xapl:set-variable name="adminProcess"/>
        <xapl:set-variable name="userGroupDomainData"/>
        <web:display-page>
          <web:get-page name="user_group_details">
            <USER_GROUP_ID Value="{$userGroupProfileData/USER_GRP_PROFILE/ID/@Value}"/>
            <ORG_ID Value="{$userGroupProfileData/USER_GRP_PROFILE/ORG_ID/@Value}"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>

      <xapl:when test=" 'USER_GROUP_MAIN' = $whereToGo ">
        <web:display-page>
          <web:get-page name="user_group_details">
            <USER_GROUP_ID Value="{$userGroupProfileData/USER_GRP_PROFILE/ID/@Value}"/>
            <ORG_ID Value="{$userGroupProfileData/USER_GRP_PROFILE/ORG_ID/@Value}"/>
            <SUCCESS_MESSAGE Value="{$this/SUCCESS_MESSAGE/@Value}"/>
            <ERROR_MESSAGE Value="{$this/ERROR_MESSAGE/@Value}"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>

      <xapl:when test=" 'DOMAIN_NODES_SEARCH' = $whereToGo ">
        <web:display-page>
          <web:get-page name="domain_nodes">
            <ACTION Value="{$this/ACTION/@Value}"/>
            <SELECTED_TAB Value="{$this/SELECTED_TAB/@Value}"/>
            <DO_SEARCH Value="{$this/DO_SEARCH/@Value}"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>

    </xapl:choose>
  </x2:command>

  <!--************************************************************************
    ************************************************************************-->
</x2:commands>