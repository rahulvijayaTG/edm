<?xml version="1.0" encoding="UTF-8"?>
<x2:commands 
	xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" 
	xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" 
	xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" 
	xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" 
	xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" 
	xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" 
	xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">

<!--* **********************************************************************
  ***********************************************************************-->
  <x2:command public="yes" description="_" name="getActivitySearchPage">
    <xapl:print select="{$this}"/>
     <xapl:variable name="status"/>

    <xapl:if test="$adminProcess/@Value = 'CREATE_NEW_ROLE'">

        <docutil:set select="$roleDetails">
    			<ACTION_TYPE Value="CREATE_NEW"/>
    		</docutil:set>

    	<xapl:if test="string-length($this/ROLE_ID/@Value) &gt; 0">
    		<docutil:set select="$roleDetails">
    			<ROLE_ID Value="{$this/ROLE_ID/@Value}"/>
    		</docutil:set>
    	</xapl:if>
    	<xapl:if test="string-length($this/ROLE_NAME/@Value) &gt; 0">
    		<docutil:set select="$roleDetails">
    			<ROLE_NAME Value="{$this/ROLE_NAME/@Value}"/>
    		</docutil:set>
    	</xapl:if>
    <xapl:print>
      :::ADD
      <xapl:value-of select="$roleDetails"/>
    </xapl:print>
    <xapl:variable name="response">
      <xcore:execute-method name="//UserSecurity/manageRoleDetails" entireResponse="true">
        <xapl:value-of select="{$roleDetails}"/>
      </xcore:execute-method>
    </xapl:variable>

    <xapl:print select="{$response}"/>

    <xapl:set-variable name="status">
      <x2:execute command="bcm.framework.util:getResponseStatus">
        <x2:with-param name="response" select="$response"/>
        <x2:with-param name="successMessage" select=" 'ROLE_SAVED_SUCCESSFULLY' "/>
      </x2:execute>
    </xapl:set-variable>

    <docutil:add select="$this">
      <xapl:value-of select="$status"/>
    </docutil:add>



    </xapl:if>


    <xapl:choose>
      <xapl:when test="$status = 'ERROR_MESSAGE'  ">
          <web:display-page>
            <web:get-page name="user_role_details">
              <xapl:value-of select="$this/ERROR_MESSAGE"/>
              <FORM_NAME Value="{$this/FORM_NAME/@Value}"/>
              <SERVICE Value="{$this/SERVICE/@Value}"/>
              <MAX_ROWS Value="{$this/MAX_ROWS/@Value}"/>
              <RETURN_ROW_COUNT Value="{$this/RETURN_ROW_COUNT[1]/@Value}"/>
              <SEARCH_TYPE Value="{$this/SEARCH_TYPE/@Value}"/>
              <DO_SEARCH Value="{$this/DO_SEARCH[1]/@Value}"/>
              <KEEP_SESSION_INFO Value="yes"/>
              <CREATE_NEW Value="Yes"/>
              <FROM_ACT Value="{$this/FROM_ACT[1]/@Value}"/>
              <SELECTED_TAB Value="{$this/SELECTED_TAB[1]/@Value}"/>
            </web:get-page>
          </web:display-page>
      </xapl:when>
        <xapl:otherwise>
            <docutil:remove select="$this/*[ (string-length(@Value) = 0)]"/>
            <docutil:remove select="$roleDetails/ACTION_TYPE"/>
            <web:display-page>
              <web:get-page name="user_activity_search">
                <xapl:value-of select="$this/ERROR_MESSAGE"/>
                <xapl:if test="string-length($this/SUCCESS_MESSAGE/@Value) &gt; 0">
                  <SUCCESS_MESSAGE Value="{$this/SUCCESS_MESSAGE/@Value}"/>
                </xapl:if>
                <FORM_NAME Value="{$this/FORM_NAME/@Value}"/>
                <SERVICE Value="{$this/SERVICE/@Value}"/>
                <MAX_ROWS Value="{$this/MAX_ROWS/@Value}"/>
                <RETURN_ROW_COUNT Value="{$this/RETURN_ROW_COUNT[1]/@Value}"/>
                <SEARCH_TYPE Value="{$this/SEARCH_TYPE/@Value}"/>
                <DO_SEARCH Value="{$this/DO_SEARCH[1]/@Value}"/>
                <KEEP_SESSION_INFO Value="yes"/>
                <CREATE_NEW Value="{$this/CREATE_NEW[1]/@Value}"/>
                <FROM_ACT Value="{$this/FROM_ACT[1]/@Value}"/>
                <SELECTED_TAB Value="{$this/SELECTED_TAB[1]/@Value}"/>
              </web:get-page>
            </web:display-page>
        </xapl:otherwise>
    </xapl:choose>

  </x2:command>  

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
  	<xapl:print select="$this"/>
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
      <x2:with-param name="display" select="'Activity Search'"/>
      <x2:with-param name="page" select="'user_activity_search'"/>
      <x2:with-param name="this" select="{$this}"/>
    </x2:execute>
    
    <docutil:set select="$this">
      <DO_SEARCH Value="yes"/>
      <FORM_NAME Value="USER_ACTIVITY_SEARCH_FORM"/>
      <SERVICE Value="UserSecurity"/>
      <xapl:choose>
        <xapl:when test="not($this/SELECTED_TAB) or string-length($this/SELECTED_TAB/@Value) = 0 or $this/SELECTED_TAB/@Value = 'WORKFLOW' ">
          <SELECTED_TAB Value="WORKFLOW"/>
          <F_UserActivity.ACTIVITY_TYPE Value="MenuForm"/>
        </xapl:when>
        <xapl:otherwise>
          <SELECTED_TAB Value="TABLE_EDITOR"/>
          <F_UserActivity.ACTIVITY_TYPE Value="UIForm"/>
        </xapl:otherwise>
      </xapl:choose>
    </docutil:set>
	<!-- show admin activities to admin role only, restrict it for being assigned to other non admin roles-->
	<xapl:if test="$this/SELECTED_TAB/@Value = 'WORKFLOW' and $roleDetails/ROLE_ID/@Value = 'SU'">
	<xapl:print>
	  GET THE ADMIN ROLES ALSO FOR SU:::
	   <xapl:value-of select="$roleDetails/ROLE_ID/@Value"/>
	</xapl:print>
	 <docutil:set select="$this">
	    <F_UserActivity.ACTIVITY_TYPE Value="MenuForm,Admin"/>
	 </docutil:set>
	</xapl:if>

    <xapl:variable name="activitySearchForm">
    	<ACTIVITY_SEARCH_FORM>
        <x2:execute command="bcm.framework.queryform.Form:getFormContainer">
          <x2:with-param name="this" select="$this"/>
          <x2:with-param name="pSearchParam" select="$searchParam"/>
          <x2:with-param name="pFormName" select="'USER_ACTIVITY_SEARCH_FORM'"/>
          <x2:with-param name="pServiceName" select="'UserSecurity'"/>
          <x2:with-param name="pSearchReportConfigSource" select="'omx.user_admin.user_activity_search:getReportConfig'"/>
          <x2:with-param name="pReportDataSource" select="'omx.user_admin.user_activity_search:getReportData'"/>
        </x2:execute>
        </ACTIVITY_SEARCH_FORM>
    </xapl:variable>
    
    <xapl:print select="$context"/>
    
    <xapl:return>
      <!-- Page Header as breadcrumbs-->
	  <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>      	  	
	  <!-- Container-->
      <x2:execute command="omx.user_admin.user_activity_search:getContainer">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
      <xapl:value-of select="$activitySearchForm"/>
      <!-- return parameters-->
      <xapl:value-of select="$this/*[string-length(@Value) &gt; 0]"/>
      <xapl:value-of select="$context"/>
    </xapl:return>
  </x2:command>

 <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <x2:param name="pPage"/>

    <xapl:return>
      <CONTAINER Scrollable="no">
       	<xapl:if test="$this/SELECTED_TAB/@Value = 'WORKFLOW'">
       	  <HELP Url="../../bcm/help/activity_search_help.htm"/>
       	</xapl:if>
       	<xapl:if test="$this/SELECTED_TAB/@Value = 'TABLE_EDITOR'">
       	  <HELP Url="../../bcm/help/activity_search_help.htm"/>
       	</xapl:if>
        <STEP  DisplayText="Workflow Activity Search" OnClick="javascript:showTab('WORKFLOW')" Selected="{$this/SELECTED_TAB/@Value = 'WORKFLOW'}"/>
        <STEP OnClick="javascript:showTab('TABLE_EDITOR')" Selected="{$this/SELECTED_TAB/@Value = 'TABLE_EDITOR'}" DisplayText="Table Editor Activity Search"/>
        <BUTTONS>
			<BUTTON Id="Cancel" Name="Cancel" DisplayText="Cancel" OnClick="javascript:onCancel()" DisableOnClick="true"/>
			<DIVIDER/>
      <BUTTON Id="Save" Name="Save" DisplayText="Save" OnClick="javascript:onSave()" DisableOnClick="true"/>
			<BUTTON Id="SaveAndReturn" Name="SaveAndReturn" DisplayText="Save and Return" OnClick="javascript:onSelect()" DisableOnClick="true"/>
			<DIVIDER/>
			<BUTTON Id="Search" Name="Search" DisplayText="Search" OnClick="javascript:dispatchSearch()" DisableOnClick="true"/>
        </BUTTONS>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  
 <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportConfig">
    <x2:param name="this" select="$this"/>
    <xapl:return>
      <REPORT Title="User Activities" Action="{$pages:user_activity_search}" Scrollable="no"  ShowFilter="yes" Selectable="All" ScrollableContainer="yes" Id="#" SelectedId="SELECTED_ACTIVITY_ID" PagingTitle="yes">
        <FIELDS>
          <!-- get form's report fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
<!--  Removed this check  to enable the  feature of giving permissions at Activity level -->          
          <!-- xapl:if test="$this/SELECTED_TAB/@Value = 'TABLE_EDITOR' " -->
            <!--FIELD
              Sequence="3"
              Editable="yes"
              Name="cb_view"
              Document="Doc1"
              Property="Prop1"
              DisplayText="View"
              DisplayType="CheckBox2"
              /-->
            <FIELD
              Sequence="3"
              Editable="yes"
              Name="cb_create"
              Document="Doc1"
              Property="Prop1"
              DisplayText="Create"
              DisplayType="CheckBox2"
              />
            <FIELD
              Sequence="3"
              Editable="yes"
              Name="cb_edit"
              Document="Doc1"
              Property="Prop1"
              DisplayText="Edit"
              DisplayType="CheckBox2"
              />
            <FIELD
              Sequence="3"
              Editable="yes"
              Name="cb_delete"
              Document="Doc1"
              Property="Prop1"
              DisplayText="Delete"
              DisplayType="CheckBox2"
              />
          <!-- /xapl:if-->
          <!-- get Hidden Fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
          <FIELD Name="SELECTED_TAB" DisplayType="Hidden" Value="{$this/SELECTED_TAB[1]/@Value}"/>
          <FIELD Name="RETURN" DisplayType="Hidden" Value="TRUE"/>
        </FIELDS>
        <PAGINATION/>
      </REPORT>
    </xapl:return>
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportData">
    <x2:param name="this"/>
    <x2:param name="pForm"/>
	
	<docutil:set select="$this">
      <SORT_BY Value="UserActivity.NAME"/>
      <SORT_ORDER Value="Ascending"/>
    </docutil:set>

     <xapl:variable name="data">
      <x2:execute command="bcm.framework.queryform.Form:getFormReportData">
        <x2:with-param name="this" select="$this"/>
        <x2:with-param name="fromProperty" select="'SEARCH_PROPERTY'"/>
        <x2:with-param name="delimeter" select="'.'"/>
      </x2:execute>
     </xapl:variable>


    <xapl:for-each varName="activityVar" select="$data/JOIN_RESULT">
     <docutil:add select="$activityVar">
        <cb_view Value="{$activityVar/UserActivity.ID/@Value}"/>
        <cb_create Value="{$activityVar/UserActivity.ID/@Value}"/>
        <cb_edit Value="{$activityVar/UserActivity.ID/@Value}"/>
        <cb_delete Value="{$activityVar/UserActivity.ID/@Value}"/>
     </docutil:add>
    </xapl:for-each>


    <xapl:print>
      MODIFIED DATA:::<xapl:value-of select="$data"/>
    </xapl:print>

    <xapl:return>
      <xapl:value-of select="$data"/>
    </xapl:return>    
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="addActivities">
  	<xapl:print select="$this"/>

    <docutil:remove select="$roleDetails/Activities/*"/>
    <!--anish added this to avoid duplication errors-->
    <xapl:set-variable name="adminProcess"/>
    <docutil:remove select="$roleDetails/ACTION_TYPE"/>

    <xapl:print select="{$roleDetails}"/>
    <xapl:variable name="duplicateActivities" select="'No'"/>
    
    <xapl:for-each varName="selectedID" select="$this/SELECTED_ACTIVITY_ID">
    	<xapl:variable name="activityID"/>
    	<xapl:set-variable name="activityID">
    		<x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
  				<x2:with-param name="selectedId" select="{$selectedID/@Value}"/>
        		<x2:with-param name="key" select="'UserActivity.ID'"/>
        	</x2:execute>
        </xapl:set-variable>        
        
      <xapl:variable name="activityName"/>
    	<xapl:set-variable name="activityName">
    		<x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
  				<x2:with-param name="selectedId" select="{$selectedID/@Value}"/>
        		<x2:with-param name="key" select="'UserActivity.NAME'"/>
        	</x2:execute>
        </xapl:set-variable>  
        
        <xapl:print select="{$roleDetails}"/>
        
        <xapl:choose>

			<xapl:when test="(count($roleDetails/Activities/Activity) = 0 ) or (count($roleDetails/Activities/Activity[ROLE_TEMPLATE.ACTIVITY_ID/@Value = $activityID]) = 0 )">
		    	<docutil:add select="$roleDetails/Activities">
		      		<Activity Action="ADD">
                  <ROLE_TEMPLATE.ROLE_ID Value="{$roleDetails/ROLE_ID/@Value}"/>
                  <ROLE_TEMPLATE.ACTIVITY_ID Value="{$activityID}"/>
                  <UserActivity.NAME Value="{$activityName}"/>
                  <ACTIVITY_ID Value="{$activityID}"/>
<!--  Removed this check  to enable the  feature of giving permissions at Activity level -->                            
                <!-- xapl:if test="$this/SELECTED_TAB[1]/@Value = 'TABLE_EDITOR'" -->

                  <xapl:variable name="accLevel" select="'View+'"/>

                    <xapl:for-each varName="cbs" select="$this/*[substring-before(name() ,  '_'  )  = 'cb'  and @Value = $activityID]">
                      <xapl:print>
                           CHECKBOXES::
                          <xapl:value-of select="$cbs"/>
                      </xapl:print>
                      <!-- By Default give the view access-->
                      <!--xapl:if test="contains(name($cbs) , 'view')">
                         <xapl:set-variable name="accLevel">
                             <xapl:value-of select="concat($accLevel , 'View+') "/>
                         </xapl:set-variable>
                      </xapl:if-->
                      <xapl:if test="contains(name($cbs) , 'edit')">
                         <xapl:set-variable name="accLevel">
                             <xapl:value-of select="concat($accLevel , 'Update+') "/>
                         </xapl:set-variable>
                      </xapl:if>
                      <xapl:if test="contains(name($cbs) , 'create')">
                         <xapl:set-variable name="accLevel">
                             <xapl:value-of select="concat($accLevel , 'Add+') "/>
                         </xapl:set-variable>
                      </xapl:if>
                      <xapl:if test="contains(name($cbs) , 'delete')">
                         <xapl:set-variable name="accLevel">
                             <xapl:value-of select="concat($accLevel , 'Remove+') "/>
                         </xapl:set-variable>
                      </xapl:if>
                    </xapl:for-each>
                      <xapl:print>
                           ACCESS_LEVEL::
                          <xapl:value-of select="$accLevel"/>
                      </xapl:print>

                     <ACCESS_LEVEL Value="{$accLevel}"/>
                  <!-- /xapl:if -->

		      		</Activity>
		    	</docutil:add>        	
			</xapl:when> 			
			<xapl:otherwise>
				<xapl:choose>
				  <xapl:when test="(count($roleDetails/Activities/Activity[(@Action = 'ADD' or @Action = 'MODIFY') and ROLE_TEMPLATE.ACTIVITY_ID/@Value = $activityID]) = 0 )">
				  	<docutil:set select="{$roleDetails/Activities/Activity[@Action = 'REMOVE' and ROLE_TEMPLATE.ACTIVITY_ID/@Value = $activityID]/@Action}">MODIFY</docutil:set>
				  </xapl:when>
				  <xapl:otherwise>
				    <xapl:set-variable name="duplicateActivities" select="'Yes'"/>
				  </xapl:otherwise>
				</xapl:choose>
			</xapl:otherwise>
    	</xapl:choose>   	
    </xapl:for-each>

    <xapl:print select="{$roleDetails}"/>

<!--    <xapl:if test="$duplicateActivities = 'Yes'">
      <docutil:add select="$this">
        <ERROR_MESSAGE Value="The duplicate activities were ignored."/>
      </docutil:add>
    </xapl:if>-->

    <xapl:print>
      :::ADD
      <xapl:value-of select="$roleDetails"/>
    </xapl:print>
    <xapl:variable name="response">
      <xcore:execute-method name="//UserSecurity/manageRoleDetails" entireResponse="true">
        <xapl:value-of select="{$roleDetails}"/>
      </xcore:execute-method>
    </xapl:variable>

    <xapl:print select="{$response}"/>

    <xapl:variable name="status">
      <x2:execute command="bcm.framework.util:getResponseStatus">
        <x2:with-param name="response" select="$response"/>
        <x2:with-param name="successMessage" select=" 'Role_Details_Saved_Successfully' "/>
      </x2:execute>
    </xapl:variable>

    <docutil:add select="$this">
      <xapl:value-of select="$status"/>
    </docutil:add>





    <xapl:choose>
      <xapl:when test="name($status) = 'ERROR_MESSAGE' or $this/RETURN/@Value='FALSE' ">
            <x2:execute command="omx.user_admin.user_activity_search:getActivitySearchPage">
                <x2:with-param name="this" select="$this"/>
            </x2:execute>
      </xapl:when>
        <xapl:otherwise>
            <x2:execute command="omx.user_admin.user_role_details:display">
                <x2:with-param name="this" select="$this"/>
            </x2:execute>
        </xapl:otherwise>
    </xapl:choose>


  </x2:command>
  
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="fieldAccessDetails">
  	<xapl:print select="$this"/>

     	<xapl:variable name="activityID"/>
    	<xapl:set-variable name="activityID">
    		<x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
  				<x2:with-param name="selectedId" select="{$this/SELECTED_AUTH_SCOPE/@Value}"/>
        		<x2:with-param name="key" select="'UserActivity.ID'"/>
        	</x2:execute>
        </xapl:set-variable>        

		<web:display-page >
		            <web:get-page name="omx.user_admin.role_field_access">
                  <ROLE_ID Value="{$roleDetails/ROLE_ID/@Value}"/>
                  <ROLE_NAME Value="{$roleDetails/ROLE_NAME/@Value}"/>
                  <DOCUMENT_NAME Value="{substring-after($activityID,':')}"/>
				  <SERVICE_NAME Value="{substring-before($activityID,':')}"/>
				  </web:get-page>
		</web:display-page>

  </x2:command>
  
 <!--  **********************************************************************
   ***********************************************************************-->     


</x2:commands>