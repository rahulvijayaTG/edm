<?xml version="1.0" encoding="UTF-8"?>
<x2:commands description="_" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:cfg="http://www.i2.com/configurability" xmlns:core="http://www.i2.com/core" xmlns:omx="http://www.i2.com/omx" xmlns:perm="http://www.i2.com/permissibility" xmlns:util="http://www.i2.com/util" xmlns:web="http://www.i2.com/web" xmlns:x2="http://www.i2.com/x2" xmlns:xapl="http://www.i2.com/xapl" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:docutil="http://www.i2.com/docutil" xmlns:xudl="http://www.i2.com/xudl" xmlns:identity="http://www.i2.com/identity">
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="init" public="yes" description="_">
    <x2:execute command="omx.user_admin.pages:defineCore"/>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command name="defineCore" public="yes" description="_">
    <web:define-page name="user_admin_system" url="/omx/user_admin/user_admin_system.jsp"/>
    <!-- Additions by ASHISH KAPOOR for EM UI changes related to User Defaults- START -->
    <web:define-page name="nav_user_pref" url="/bcm/framework/user_admin/user_admin_users_pref/view.cmd?VIEW_MODE=PREFERENCE"/>
    <web:define-page name="user_admin_users_pref" url="/bcm/framework/user_admin/user_admin_users_pref.jsp"/>
    <web:define-page name="user_admin_users_pref_content" url="/bcm/framework/user_admin/user_admin_users_pref_content.jsp"/>
    <web:define-xsl name="user_admin_users_general_pref" url="/bcm/framework/user_admin/xsl/user_admin_users_general_pref.xsl"/>
    <web:define-xsl name="user_admin_users_notification_pref" url="/bcm/framework/user_admin/xsl/user_admin_users_notification_pref.xsl"/>
    <!-- shriniwas-->
    <!-- user group users pages -->
    <web:define-page name="user_admin_users" url="/bcm/framework/user_admin/user_admin_users.jsp"/>
    <web:define-xsl name="user_admin_users" url="/bcm/framework/user_admin/xsl/user_admin_users.xsl"/>
    <!--  User Groups -->
    <web:define-page name="user_admin_groups" url="/bcm/framework/user_admin/user_admin_groups.jsp"/>
    <web:define-xsl name="user_admin_groups" url="/bcm/framework/user_admin/xsl/user_admin_groups.xsl"/>
    <web:define-page name="user_admin_groups_new" url="/bcm/framework/user_admin/user_admin_groups_new.jsp"/>
    <web:define-xsl name="user_admin_groups_new" url="/bcm/framework/user_admin/xsl/user_admin_groups_new.xsl"/>
    <web:define-page name="user_admin_groups_new_content" url="/bcm/framework/user_admin/user_admin_groups_content_new.jsp"/>
    <web:define-page name="user_group_profile_return" url="/bcm/framework/user_admin/user_admin_groups_new/returnToUserGroup.cmd"/>
    <web:define-page name="user_admin_group_admin_role_template" url="/bcm/framework/user_admin/user_admin_group_admin_role_template.jsp"/>
    <web:define-xsl name="user_admin_group_admin_role_template" url="/bcm/framework/user_admin/xsl/user_admin_group_admin_role_template.xsl"/>
    <web:define-page name="user_admin_group_admin_role_template_content" url="/bcm/framework/user_admin/user_admin_group_admin_role_template_content.jsp"/>
    <web:define-page name="user_admin_groups_role_domain" url="/bcm/framework/user_admin/user_admin_groups_role_domain.jsp"/>
    <web:define-page name="user_admin_groups_role_domain_content" url="/bcm/framework/user_admin/user_admin_groups_content_role_domain.jsp"/>
    <web:define-xsl name="user_admin_groups_role_domain" url="/bcm/framework/user_admin/xsl/user_admin_groups_role_domain.xsl"/>
    <!-- user group search -->
    <!--
    <web:define-page name="user_admin_group_search" url="/omx/search/search.jsp?PAGE=user_admin_group_search&amp;DO_SEARCH=Yes&amp;OBJECT_TYPE=USER_GROUP&amp;DIRECTORY=omx.user_admin&amp;FILE=user_group_search&amp;JSCRIPT=omx/user_admin/js/user_admin.js"/>
    -->
    <!-- organization search -->
    <web:define-page name="user_group_org_search" url="/bcm/framework/user_admin/user_group_org/view.cmd"/>
    <web:define-page name="user_group_org_search_view" url="/omx/search/search.jsp?PAGE=user_group_org_search&amp;OBJECT_TYPE=ORGANIZATION&amp;DIRECTORY=omx.user_admin&amp;FILE=user_group_org_search&amp;JSCRIPT=bcm/framework/user_admin/js/user_group_admin.js"/>
    <web:define-page name="user_grp_domain_add_search_view" url="/omx/search/search.jsp?PAGE=user_grp_domain_add_search_view&amp;OBJECT_TYPE=ORGANIZATION&amp;DIRECTORY=omx.user_admin&amp;FILE=user_grps_domain_add&amp;JSCRIPT=bcm/framework/user_admin/js/user_admin.js"/>
    <!-- user group user search -->
    <web:define-page name="user_group_user_search_view" url="/omx/search/search.jsp?PAGE=user_group_user_search_view&amp;OBJECT_TYPE=USER&amp;DIRECTORY=omx.user_admin&amp;FILE=users_search&amp;JSCRIPT=bcm/framework/user_admin/js/user_group_admin.js"/>
    <web:define-page name="user_group_user_search_assign" url="/omx/search/search.jsp?PAGE=user_group_user_search_assign&amp;OBJECT_TYPE=USER&amp;DIRECTORY=omx.user_admin&amp;FILE=users_search&amp;JSCRIPT=bcm/framework/user_admin/js/user_group_admin.js"/>
    <!-- shriniwas-->
    <!-- Additions by ASHISH KAPOOR for EM UI changes related to User Defaults - END -->
    <web:define-page name="user_admin_domains" url="/omx/user_admin/user_admin_domains.jsp"/>
    <web:define-page name="user_admin_upload" url="/omx/user_admin/user_admin_upload.jsp"/>
    <web:define-page name="user_admin_notes" url="/omx/user_admin/user_admin_notes.jsp"/>
    <web:define-page name="user_admin_notes_search" url="/omx/user_admin/user_admin_notes_search.jsp"/>
    <web:define-page name="user_admin_notes_view" url="/omx/user_admin/user_admin_notes_view.jsp"/>
    <web:define-page name="user_admin_terms" url="/omx/user_admin/user_admin_terms.jsp"/>
    <web:define-page name="user_admin_roles" url="/omx/user_admin/user_admin_roles.jsp"/>
    <!--    <web:define-page name="local_code_master" url="/omx/user_admin/code_master.jsp?IS_EDITABLE=true"/>-->
    <web:define-page name="local_code_master" url="/omx/user_admin/code_master/code_master.jsp?IS_EDITABLE=true"/>
    <web:define-page name="global_code_master" url="/omx/user_admin/code_master.jsp?IS_EDITABLE=false"/>
    <web:define-page name="code_master_edit" url="/omx/user_admin/code_master_edit.jsp"/>
    <web:define-page name="user_admin_users_search_help" url="/bcm/help/user_admin_users_search_help.htm"/>
    <web:define-page name="user_admin_groups_search_help" url="/bcm/help/user_admin_groups_search_help.htm"/>
    <web:define-page name="user_group_user_search_view_help" url="/bcm/help/user_group_user_search_view_help.htm"/>
    <web:define-page name="user_group_user_search_assign_help" url="/bcm/help/user_group_user_search_assign_help.htm"/>
    <web:define-page name="user_group_detail_help" url="/bcm/help/user_group_detail_help.htm"/>
    <web:define-page name="create_user_group_detail_help" url="/bcm/help/create_user_group_detail_help.htm"/>
    <web:define-page name="user_detail_help" url="/bcm/help/user_detail_help.htm"/>
    <web:define-page name="create_user_detail_help" url="/bcm/help/create_user_detail_help.htm"/>
    <web:define-page name="user_admin_help" url="/bcm/help/user_admin_help.htm"/>
    <web:define-page name="user_admin_search_help" url="/bcm/help/user_admin_search_help.htm"/>
    <web:define-page name="user_admin_search_res_help" url="/bcm/help/user_admin_search_res_help.htm"/>
    <web:define-page name="user_admin_notes_help" url="/omx/help/admn_nts.html"/>
    <web:define-page name="code_master_help" url="/bcm/help/code_master.html"/>
    <web:define-page name="close_and_refresh_systemnotes" url="/omx/close_and_refresh_systemnotes.html"/>
    <web:define-page name="close_and_refresh_systemnotes_item" url="/omx/close_and_refresh_systemnotes_item.jsp"/>
    <web:define-page name="close_schedulenotes" url="/omx/close_schedulenotes.jsp"/>
    <web:define-page name="code_master_noedit_help" url="/bcm/help/codenoedit.html"/>
    <web:define-page name="code_master_edit_help" url="/bcm/help/codeeditable.html"/>
    <web:define-page name="user_admin_view_users_help" url="/bcm/help/user_admin_view_users_help.htm"/>
    <web:define-page name="user_admin_assign_users_help" url="/bcm/help/user_admin_assign_users_help.htm"/>
    <!-- organization search -->
    <web:define-page name="user_org_search" url="/omx/user_admin/users_org/view.cmd"/>
    <web:define-page name="user_org_search_view" url="/omx/search/search.jsp?PAGE=org_search&amp;OBJECT_TYPE=ORGANIZATION&amp;DIRECTORY=omx.user_admin&amp;FILE=users_org&amp;JSCRIPT=omx/user_admin/js/org.js"/>
    <!-- domain search -->
    <web:define-page name="user_domain_search_view" url="/omx/search/search.jsp?OBJECT_TYPE=DOMAIN&amp;DIRECTORY=omx.user_admin&amp;FILE=users_domain&amp;JSCRIPT=omx/user_admin/js/user_admin.js"/>
    <!-- domain add search -->
    <web:define-page name="user_domain_add_search_view" url="/omx/search/search.jsp?OBJECT_TYPE=DOMAIN&amp;DIRECTORY=omx.user_admin&amp;FILE=users_domain_add&amp;JSCRIPT=omx/user_admin/js/user_admin.js"/>
    <!--************************************************************************-->
    
    <web:define-page name="user_admin_users_content" url="/bcm/framework/user_admin/user_admin_users_content.jsp"/>
    <!--************************************************************************-->
  </x2:command>
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="getTabs">
    <x2:param name="pPage" select="$this/PAGE/@Value"/>
    <x2:param name="pSubPage" select="$this/SUBPAGE/@Value"/>
    <x2:param name="pRetPage" select="$this/RET_PAGE[1]/@Value"/>
    <x2:param name="pId" select="$this/USER_ID/@Value"/>
    <x2:param name="pRoleId" select="$this/ROLE_ID/@Value"/>
    <x2:param name="pViewMode" select="$this/VIEW_MODE/@Value"/>
    <x2:param name="pFromPage" select="$this/fromPage/@Value"/>
    <x2:param name="pWhere" select="$this/WHERE/@Value"/>
    <!--
    Removing 'domain' related info for bcm
    <x2:param name="pDomains" select="$this/PAGE/@Value"/>
-->
    <x2:param name="pStatus"/>
    <x2:param name="pEditable"/>
    <xapl:print select="$pPage"/>
    <xapl:print select="$pWhere"/>
    <xapl:variable name="identityOrg">
      <identity:get-org/>
    </xapl:variable>
    <xapl:variable name="userDetailLink">
      <web:get-page name="user_admin_users">
        <ID Value="{$pId}"/>
      </web:get-page>
    </xapl:variable>
    <xapl:variable name="pages">
      <TABS>
        <xapl:variable name="helpUrl">
          <xapl:choose>
            <xapl:when test="{$pPage = 'user_admin_search'}">
              <web:get-page name="user_admin_users_search_help"/>
            </xapl:when>
            <xapl:when test="{$pPage = 'user_admin_group_search'}">
              <web:get-page name="user_admin_groups_search_help"/>
            </xapl:when>
            <xapl:when test="{$pPage = 'user_group_user_search_view'}">
              <web:get-page name="user_group_user_search_view_help"/>
            </xapl:when>
            <xapl:when test="{$pPage = 'user_group_user_search_assign'}">
              <web:get-page name="user_group_user_search_assign_help"/>
            </xapl:when>
            <!--
            <xapl:when test="{$pPage = 'user_admin_notes'}">
              <web:get-page name="user_admin_notes_help"/>
            </xapl:when>
-->
            <xapl:when test="{$pPage = 'user_admin_users'}">
              <xapl:choose>
                <xapl:when test="$pWhere = 'NEW_USERS'">
                  <xapl:print>
                Step 1
              </xapl:print>
                  <web:get-page name="create_user_detail_help"/>
                </xapl:when>
                <xapl:otherwise>
                  <xapl:print>
                Step 2
              </xapl:print>
                  <web:get-page name="user_detail_help"/>
                </xapl:otherwise>
              </xapl:choose>
            </xapl:when>
            <!--
            <xapl:when test="{$pPage = 'user_admin_domains'}">
              <web:get-page name="user_admin_help"/>
            </xapl:when>
-->
          </xapl:choose>
        </xapl:variable>
        <xapl:print>
        helpUrl = <xapl:value-of select="$helpUrl"/>
        </xapl:print>
        <HELP Url="{$helpUrl}"/>
        <xapl:choose>
          <xapl:when test=" $pPage = 'org_search' ">
            <TAB DisplayText="Search Organizations" Selected="{$pPage = 'org_search'}" OnClick="{$pages:org_search}">
              <BUTTONS>
                <BUTTON DisplayText="Select Organization" OnClick="javascript:selectOrganization();" Emphasized="true" Disabled="report"/>
              </BUTTONS>
            </TAB>
            <PAGINATION/>
          </xapl:when>
          <!-- <xapl:when test=" $pPage = 'user_grp_domain_add_search_view' ">
            <TAB/>
          </xapl:when> -->
          <xapl:when test=" $pPage = 'user_admin_search' ">
            <TAB DisplayText="Search Users" Selected="{$pPage = 'user_admin_search'}" OnClick="{$pages:user_admin_search}">
              <BUTTONS>
                <!--perm:is-allowed document="USER_ADMIN" action="add_user">
                  <BUTTON DisplayText="Add New User" OnClick="javascript:add();" Disabled="no"/>
                </perm:is-allowed-->
                <!--
                Shifting button 'User Details' from 'omx.user_admin.pages:gettabs' to 'omx.user_admin.search:getreportconfig'.
                <BUTTON DisplayText="User Details" OnClick="javascript:edit();" Emphasized="false" Disabled="report"/>
-->
              </BUTTONS>
            </TAB>
          </xapl:when>
          <xapl:when test=" $pPage = 'user_admin_group_search' ">
            <TAB DisplayText="Search User Groups" Selected="{$pPage = 'user_admin_group_search'}" OnClick="{$pages:user_admin_group_search}"/>
          </xapl:when>
          <xapl:when test=" $pPage = 'user_group_user_search_view' ">
            <TAB DisplayText="View User Group Users" Selected="{$pPage = 'user_group_user_search_view'}" OnClick="{$pages:user_group_user_search_view}"/>
          </xapl:when>
          <xapl:when test=" $pPage = 'user_group_user_search_assign' ">
            <TAB DisplayText="User Group Users Assignment" Selected="{$pPage = 'user_group_user_search_assign'}" OnClick="{$pages:user_group_user_search_assign}"/>
          </xapl:when>
          <xapl:when test=" $pPage = 'user_admin_notes'">
            <perm:is-allowed document="USER_ADMIN" action="system_notes">
              <TAB DisplayText="Notes" Selected="{$pPage = 'user_admin_notes'}" OnClick="{$pages:user_admin_notes}">
                <BUTTONS>
                  <perm:is-allowed document="USER_ADMIN" action="system_notes">
                    <xapl:choose>
                      <xapl:when test=" ($pPage = 'user_admin_notes') and ($pSubPage = 'notes')">
                        <xapl:choose>
                          <xapl:when test=" $pEditable = 'false' ">
                            <BUTTON DisplayText="Reset" OnClick="javascript:reset(notesForm);" Emphasized="false" Disabled="yes"/>
                          </xapl:when>
                          <xapl:otherwise>
                            <BUTTON DisplayText="Reset" OnClick="javascript:reset(notesForm);" Emphasized="false" Disabled="no"/>
                          </xapl:otherwise>
                        </xapl:choose>
                        <DIVIDER/>
                        <xapl:if test=" (string-length($pId) > 0) ">
                          <xapl:choose>
                            <xapl:when test=" $pEditable = 'true' ">
                              <BUTTON DisplayText="Update" OnClick="javascript:save();" Emphasized="true" Disabled="no"/>
                            </xapl:when>
                            <xapl:otherwise>
                              <BUTTON DisplayText="Update" OnClick="javascript:save();" Emphasized="true" Disabled="yes"/>
                            </xapl:otherwise>
                          </xapl:choose>
                        </xapl:if>
                        <xapl:if test=" (string-length($pId) = 0) ">
                          <BUTTON DisplayText="Save" OnClick="javascript:saveAs();" Emphasized="true" Disabled="no"/>
                        </xapl:if>
                      </xapl:when>
                      <xapl:when test="{$pPage = 'user_admin_notes' and $pSubPage = 'notes_search'}">
                        <BUTTON DisplayText="Delete" OnClick="javascript:deleteNote();" Emphasized="false" Disabled="no"/>
                        <DIVIDER/>
                        <BUTTON DisplayText="Add New Note" OnClick="javascript:clear();" Emphasized="true" Disabled="no"/>
                      </xapl:when>
                    </xapl:choose>
                  </perm:is-allowed>
                </BUTTONS>
              </TAB>
            </perm:is-allowed>
            <PAGINATION/>
          </xapl:when>
          <!-- TAB for viewing the domain -->
          <xapl:when test=" $pPage = 'user_admin_domains' ">
            <xapl:variable name="domainTypes">
              <DOMAIN_TYPES>
                <xapl:if test="{string-length($pRoleId) &gt; 0}">
                  <xcore:execute-method name="//UserSecurity/getDomainTypesForRole">
                    <ROLE_ID Value="{$pRoleId}"/>
                  </xcore:execute-method>
                </xapl:if>
              </DOMAIN_TYPES>
            </xapl:variable>
            <xapl:variable name="subPage">
              <xapl:value-of select="{$pSubPage}"/>
            </xapl:variable>
            <xapl:for-each varName="domainType" select="{$domainTypes/ROLE_DOMAIN_TYPE_MAP[ DOMAIN_SCOPE/@Value = 'List' ]}">
              <xapl:if test=" (string-length($subPage) = 0) ">
                <xapl:set-variable name="subPage">
                  <xapl:value-of select="{$domainType/DOMAIN_TYPE_ID/@Value}"/>
                </xapl:set-variable>
              </xapl:if>
              <xapl:variable name="tabName">
                <xapl:choose>
                  <xapl:when test="{$domainType/DOMAIN_TYPE_ID/@Value = 'CUST'}">
                    <xapl:value-of select="'Corporate Points'"/>
                  </xapl:when>
                  <xapl:when test="{$domainType/DOMAIN_TYPE_ID/@Value = 'SELL'}">
                    <xapl:value-of select="'Selling Points'"/>
                  </xapl:when>
                  <xapl:when test="{$domainType/DOMAIN_TYPE_ID/@Value = 'FC'}">
                    <xapl:value-of select="'Fulfillment Centers'"/>
                  </xapl:when>
                  <xapl:when test="{$domainType/DOMAIN_TYPE_ID/@Value = 'DC'}">
                    <xapl:value-of select="'Distribution Centers'"/>
                  </xapl:when>
                  <xapl:when test="{$domainType/DOMAIN_TYPE_ID/@Value = 'ST'}">
                    <xapl:value-of select="'Shipping Points'"/>
                  </xapl:when>
                  <xapl:when test="{$domainType/DOMAIN_TYPE_ID/@Value = 'LOC'}">
                    <xapl:value-of select="'Locations'"/>
                  </xapl:when>
                </xapl:choose>
              </xapl:variable>
              <xapl:variable name="url">
                <web:get-page name="user_domain_search_view">
                  <SUBPAGE Value="{$domainType/DOMAIN_TYPE_ID/@Value}"/>
                  <USER_ID Value="{$pId}"/>
                  <ROLE_ID Value="{$pRoleId}"/>
                  <RET_PAGE Value="{$pRetPage}"/>
                  <PAGE Value="user_admin_domains"/>
                </web:get-page>
              </xapl:variable>
              <TAB DisplayText="{$tabName}" Selected="{$pPage = 'user_admin_domains' and $subPage = $domainType/DOMAIN_TYPE_ID/@Value}" OnClick="{$url}">
                <BUTTONS>
                  <BUTTON DisplayText="Add" OnClick="javascript:addDomain();" Emphasized="false" Disabled="no"/>
                  <BUTTON DisplayText="Delete" OnClick="javascript:deleteDomain();" Emphasized="false" Disabled="report"/>
                  <BUTTON DisplayText="Back" OnClick="javascript:backToUserDetails();" Emphasized="false" Disabled="no"/>
                </BUTTONS>
              </TAB>
            </xapl:for-each>
            <PAGINATION/>
          </xapl:when>
          <!-- TAB for adding the domain -->
          <xapl:when test=" $pPage = 'user_admin_domains_add' ">
            <xapl:variable name="tabName">
              <xapl:choose>
                <xapl:when test="{$pSubPage = 'CUST'}">
                  <xapl:value-of select="'Add new Corporate Points'"/>
                </xapl:when>
                <xapl:when test="{$pSubPage = 'SELL'}">
                  <xapl:value-of select="'Add new Selling Points'"/>
                </xapl:when>
                <xapl:when test="{$pSubPage = 'FC'}">
                  <xapl:value-of select="'Add new Fulfillment Centers'"/>
                </xapl:when>
                <xapl:when test="{$pSubPage = 'ST'}">
                  <xapl:value-of select="'Add new Shipping Points'"/>
                </xapl:when>
                <xapl:when test="{$pSubPage = 'DC'}">
                  <xapl:value-of select="'Add new Distribution Centers'"/>
                </xapl:when>
                <xapl:when test="{$domainType/DOMAIN_TYPE_ID/@Value = 'LOC'}">
                  <xapl:value-of select="'Locations'"/>
                </xapl:when>
              </xapl:choose>
            </xapl:variable>
            <xapl:variable name="url">
              <web:get-page name="user_domain_add_search_view">
                <SUBPAGE Value="{$domainType/DOMAIN_TYPE_ID/@Value}"/>
                <USER_ID Value="{$pId}"/>
                <ROLE_ID Value="{$pRoleId}"/>
                <RET_PAGE Value="{$pRetPage}"/>
                <PAGE Value="user_admin_domains_add"/>
              </web:get-page>
            </xapl:variable>
            <TAB DisplayText="{$tabName}" Selected="{$pPage = 'user_admin_domains_add'}" OnClick="{$url}">
              <!--  <BUTTONS>

                <BUTTON
                        DisplayText="Select"
                        OnClick="javascript:selectDomain();"
                        Emphasized="false"
                        Disabled="report"/>

                <BUTTON
                        DisplayText="Back"
                        OnClick="javascript:goBack();"
                        Emphasized="false"
                        Disabled="no"/>
              </BUTTONS> -->
            </TAB>
            <!-- <PAGINATION/>-->
          </xapl:when>
          <xapl:when test=" $pPage = 'user_admin_users' ">
            <TAB DisplayText="User Details" Selected="{$pPage = 'user_admin_users'}" OnClick="{$pages:user_admin_users}">
              <BUTTONS>
                <xapl:choose>
                  <xapl:when test="$pFromPage = 'users_search' or 'user_admin_users_content'">
                    <BUTTON DisplayText="Cancel" OnClick="javascript:onCancel('users_search');" Disabled="no"/>
                  </xapl:when>
                  <xapl:when test="$pWhere = 'NEW_USERS' ">
                    <BUTTON DisplayText="Cancel" OnClick="javascript:onCancel('user_group_profile_new_users');" Disabled="no"/>
                  </xapl:when>
                  <xapl:when test="$pFromPage = 'user_group_profile' ">
                    <BUTTON DisplayText="Cancel" OnClick="javascript:onCancel('user_group_profile_view_users');" Disabled="no"/>
                  </xapl:when>
                  <xapl:when test="$pWhere = 'ASSIGN_USERS' ">
                    <BUTTON DisplayText="Cancel" OnClick="javascript:onCancel('user_group_profile_assign_users');" Disabled="no"/>
                  </xapl:when>
                </xapl:choose>
                <xapl:if test="$pViewMode = 'PREFERENCE' ">
                  <BUTTON DisplayText="Change Password" OnClick="javascript:changePassword(user_form);" Disabled="no"/>
                </xapl:if>
                <BUTTON DisplayText="Reset" OnClick="javascript:reset(user_form);" Disabled="no"/>
                <xapl:if test=" (string-length($pId) > 0) ">
                  <!--xapl:if test=" $pDomains  &gt; 0 ">
                      <DIVIDER/>
                      <BUTTON DisplayText="Edit Domain" OnClick="javascript:editDomain();" Emphasized="false" Disabled="no"/>
                    </xapl:if-->
                  <xapl:if test=" $pId != identity-user-id() ">
                    <DIVIDER/>
                    <xapl:choose>
                      <xapl:when test=" $pStatus = 'INACTIVE' ">
                        <BUTTON DisplayText="Activate" OnClick="javascript:activate();" Emphasized="false" Disabled="no"/>
                      </xapl:when>
                      <xapl:when test=" $pStatus = 'ACTIVE' ">
                        <BUTTON DisplayText="Deactivate" OnClick="javascript:deactivate();" Emphasized="false" Disabled="no"/>
                      </xapl:when>
                    </xapl:choose>
                  </xapl:if>
                  <xapl:if test=" ($pStatus = 'ACTIVE') and ( ($pViewMode != 'PREFERENCE') or (string-length($pViewMode) = 0) ) ">
                    <DIVIDER/>
                  </xapl:if>
                  <xapl:if test=" $pStatus = 'ACTIVE' ">
                    <BUTTON DisplayText="Update" OnClick="javascript:save();" Emphasized="true" Disabled="no"/>
                  </xapl:if>
                </xapl:if>
                <xapl:if test=" (string-length($pId) = 0) ">
                  <BUTTON DisplayText="Save" OnClick="javascript:saveAs();" Emphasized="true" Disabled="no"/>
                </xapl:if>
              </BUTTONS>
            </TAB>
          </xapl:when>
          <!-- Addition by ASHISH KAPOOR for EM UI change - START -->
          <!--xapl:when test=" $pPage = 'user_admin_users_pref' ">
            <TAB DisplayText="User Preferences" Selected="{$pPage = 'user_admin_users_pref'}" OnClick="{$pages:user_admin_users_pref}">
              <BUTTONS>
                <BUTTON DisplayText="Update" OnClick="javascript:updateGeneralPref(user_general_pref_form);" Emphasized="true" Disabled="no"/>
                <BUTTON DisplayText="Unsubscribe" OnClick="javascript:unsubscribeNotifications(user_notification_subscription_form);" Emphasized="false" Disabled="no"/>
                <DIVIDER/>
                <BUTTON DisplayText="Subscribe" OnClick="javascript:subscribeNotifications(user_notification_subscription_form);" Emphasized="true" Disabled="no"/>
              </BUTTONS>
            </TAB>
          </xapl:when-->
          <!-- Addition by ASHISH KAPOOR for EM UI change - END -->
        </xapl:choose>
      </TABS>
    </xapl:variable>
    <xapl:print>pages!!!!<xapl:value-of select="$pages"/>
    </xapl:print>
    <xapl:return>
      <RET_PAGE Value="{$userDetailLink}"/>
      <xapl:value-of select="{$pages}"/>
    </xapl:return>
  </x2:command>
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="getCodeMasterLinks">
    <x2:param name="pPage"/>
    <x2:param name="pIsEditable"/>
    <xapl:variable name="helpUrl">
      <xapl:choose>
        <xapl:when test="{($pPage = 'code_master') and ($pIsEditable = 'true')}">
          <web:get-page name="code_master_edit_help"/>
        </xapl:when>
        <xapl:otherwise>
          <web:get-page name="code_master_noedit_help"/>
        </xapl:otherwise>
      </xapl:choose>
    </xapl:variable>
    <xapl:variable name="pages">
      <HELP>
        <URL Value="{$helpUrl}"/>
      </HELP>
      <NAV_PAGE>
        <DISPLAY_TEXT Value="Editable Code Master"/>
        <URL Value="{$pages:local_code_master}"/>
        <SELECTED Value="{($pPage = 'code_master') and ($pIsEditable != 'false')}"/>
      </NAV_PAGE>
      <NAV_PAGE>
        <DISPLAY_TEXT Value="Non-editable Code Master"/>
        <URL Value="{$pages:global_code_master}"/>
        <SELECTED Value="{($pPage = 'code_master') and ($pIsEditable = 'false')}"/>
      </NAV_PAGE>
    </xapl:variable>
    <xapl:print>pages!!!<xapl:value-of select="$pages"/>
    </xapl:print>
    <xapl:return>
      <xapl:value-of select="$pages"/>
    </xapl:return>
  </x2:command>
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="getHeader">
    <x2:param name="this"/>
    <xapl:print>PRINTING THIS INSIDE OMX_USER_ADMIN_PAGES getHeader <xapl:value-of select="$this"/>
    </xapl:print>
    <xapl:return>
      <HEADER>
        <APP_NAME Value="MDM"/>
        <xapl:choose>
          <xapl:when test="$this/WHERE/@Value = 'VIEW_USERS' ">
            <TOGGLE_NAV Value="../../"/>
            <HEADING Value="User Groups"/>
            <HEADING_LINK Value="{$pages:user_admin_group_search}"/>
            <HEADING2 Value="User Group Profile"/>
            <HEADING2_LINK Value="{$pages:user_group_profile_return}"/>
            <HEADING3 Value="View User Group Users"/>
          </xapl:when>
          <xapl:when test="$this/WHERE/@Value = 'ASSIGN_USERS' ">
            <TOGGLE_NAV Value="../../"/>
            <HEADING Value="User Group"/>
            <HEADING_LINK Value="{$pages:user_admin_group_search}"/>
            <HEADING2 Value="User Group Profile"/>
            <HEADING2_LINK Value="{$pages:user_group_profile_return}"/>
            <HEADING3 Value="Assign User Group Users"/>
          </xapl:when>
          <xapl:when test="$this/WHERE/@Value = 'NEW_USERS' ">
            <TOGGLE_NAV Value="../../"/>
            <HEADING Value="User Group"/>
            <HEADING_LINK Value="{$pages:user_admin_group_search}"/>
            <HEADING2 Value="User Group Profile"/>
            <HEADING2_LINK Value="{$pages:user_group_profile_return}"/>
            <HEADING3 Value="Create New User"/>
          </xapl:when>
          <xapl:when test="$this/WHERE/@Value = 'USERS_SEARCH' ">
            <TOGGLE_NAV Value="../"/>
            <HEADING Value="Users"/>
          </xapl:when>
          <xapl:otherwise>
            <TOGGLE_NAV Value="../"/>
            <HEADING Value="User Group"/>
          </xapl:otherwise>
        </xapl:choose>
        <HOME Value="bcm/framework/home.jsp"/>
      </HEADER>
    </xapl:return>
  </x2:command>
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="getUserProfileHeader">
    <x2:param name="this"/>
    <xapl:print>PRINTING THIS INSIDE OMX_USER_ADMIN_PAGES getUserProfileHeader <xapl:value-of select="$this"/>
    </xapl:print>
    <xapl:return>
      <HEADER>
        <APP_NAME Value="MDM"/>
        <xapl:choose>
          <xapl:when test="$this/WHERE/@Value = 'NEW_USERS' ">
            <TOGGLE_NAV Value="../../"/>
            <HEADING Value="User Group"/>
            <HEADING_LINK Value="{$pages:user_admin_group_search}"/>
            <HEADING2 Value="User Group Profile"/>
            <HEADING2_LINK Value="{$pages:user_group_profile_return}"/>
            <HEADING3 Value="Create New User"/>
          </xapl:when>
          <xapl:otherwise>
            <TOGGLE_NAV Value="../../"/>
            <HEADING Value="User"/>
            <HEADING_LINK Value="{$pages:user_admin_search}"/>
            <HEADING2 Value="User Profile"/>
          </xapl:otherwise>
        </xapl:choose>
        <HOME Value="bcm/framework/home.jsp"/>
      </HEADER>
    </xapl:return>
  </x2:command>
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="getUserGroupProfileHeader">
    <xapl:print>PRINTING THIS INSIDE getUserGroupProfileHeader <xapl:value-of select="$this"/>
    </xapl:print>
    <xapl:variable name="title">
      <xapl:choose>
        <xapl:when test="$this/ORG_ID/@Value != '' ">Add New User Group</xapl:when>
        <xapl:otherwise>User Group Profile</xapl:otherwise>
      </xapl:choose>
    </xapl:variable>
    <!--
    <xapl:variable name="orgPage">
      <web:get-page name="org_overview">
        <ORG_ID Value="{$addBookCurrOrgId/@Value}"/>
        <CUSTOMER_ORG_ID Value="{$addBookCurrOrgId/@Value}"/>
        <IN_PRIMARY_DOMAIN Value="{$s_inPrimaryDomain}"/>
      </web:get-page>
    </xapl:variable>

    <xapl:variable name="orgHeader" enforceList="true">
      <x2:execute command="omx.add_book.org.view:getHeader">
        <x2:with-param name="this" select="$this"/>
      </x2:execute>
    </xapl:variable>
-->
    <xapl:return>
      <HEADER>
        <APP_NAME Value="MDM"/>
        <TOGGLE_NAV Value="../../"/>
        <HEADING Value="User Group"/>
        <HEADING_LINK Value="{$pages:user_admin_group_search}"/>
        <HEADING2 Value="{$title}"/>
        <HOME Value="bcm/framework/home.jsp"/>
      </HEADER>
      <!--
      <HEADER>
      <HEADING Value="User Group"/>
      <HEADING2_LINK Value="{$orgPage}"/>
      <xapl:value-of select="$orgHeader/*"/>
      </HEADER>
-->
    </xapl:return>
  </x2:command>
  <!--************************************************************************-->
  <x2:command public="yes" description="_" name="getUserAdminCodeMasterHeader">
    <xapl:return>
      <x2:execute command="bcm.framework.index:getHeader">
        <x2:with-param name="pHeading" select="'Code Master'"/>
      </x2:execute>
    </xapl:return>
  </x2:command>
  <!--************************************************************************-->
  <!-- Additions by ASHISH KAPOOR for EM UI changes - START -->
  <x2:command public="yes" description="_" name="getUserPreferencesHeader">
    <xapl:return>
      <x2:execute command="bcm.framework.index:getHeader">
        <x2:with-param name="pHeading" select="'User Preferences'"/>
      </x2:execute>
    </xapl:return>
  </x2:command>
  <!-- Additions by ASHISH KAPOOR for EM UI changes - END -->
</x2:commands>
