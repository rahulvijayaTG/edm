<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
	<!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
    
    <!-- Search Param Overrides - Start:-->    
    <xapl:variable name="searchParams">
      <SEARCH_PARAM>
      </SEARCH_PARAM>
    </xapl:variable>  
    <!-- Search Param Overrides.  End-->    
    
    <xapl:return>
		
	  <xapl:value-of select="$this/ERROR_MESSAGE"/>
	  <xapl:value-of select="$this/SUCCESS_MESSAGE"/>
						
      <!-- Header -->
      <x2:execute command="omx.user_admin.notes_library.select.view:getHeader"/>
      
      <!-- Tabs -->
      <x2:execute command="omx.user_admin.notes_library.select.view:getContainer">
        <x2:with-param name="pPage" select="'notes_library'"/>
        <x2:with-param name="pHide" select="$this/TABS_HIDE/@Value"/>
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>

      <!-- Search / Form and Report -->  
      <x2:execute command="core.search.search:getSearch">
        <x2:with-param name="this" select="{$this}"/>
        <x2:with-param name="pSearchParam" select="{$searchParam}"/>
        <x2:with-param name="pSearchFormConfigSource" select="'omx.user_admin.notes_library.select.view:getFormConfig'"/>
        <x2:with-param name="pSearchReportConfigSource" select="'omx.user_admin.notes_library.select.view:getReportConfig'"/>
        <x2:with-param name="pReportDataSource" select="'omx.user_admin.notes_library.select.view:getReportData'"/>
      </x2:execute>
	  

    </xapl:return>
    
  </x2:command>  
	
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getHeader">
    
      <xapl:return>
        <x2:execute command="omx.index:getHeader">
	  	  <x2:with-param name="pHeading" select="'Notes Library'"/>
        </x2:execute>
      </xapl:return> 

  </x2:command>

  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <x2:param name="pPage"/>
    
    <xapl:variable name="helpUrl">
      <web:get-page name="notes_search_help"/>
    </xapl:variable>
	
    <xapl:return>
      
      <!-- TODO: why not scrolling? -->
      <CONTAINER Id="container">
        <HELP Url="{$helpUrl}"/>
          <STEP
             DisplayText="Search Notes" 
             OnClick="{$pages:notes_library}" 
             Selected="{$pPage = 'notes_library'}"/>

      </CONTAINER>
      
    </xapl:return>
    
  </x2:command>

  
  <!-- ********************************************************************** 
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="getFormConfig">

    <xapl:return>
      <!-- Search Fields -->
      <FORM  MethodName="//UserSecurity/getNotes" Name="search_form" Target="appFrame" Validation="false">
        
        <FIELD 
               Type="Text"
               DisplayText="Name" 
               Name="NOTE_CODE" 
               Value="{$this/NOTE_CODE/@Value}" 
               Visibility="Simple"/>

        <FIELD 
               Type="Select"
               DisplayText="Type" 
               Name="NOTE_TYPE" 
               Value="{$this/NOTE_TYPE/@Value}" 
               Visibility="Simple"
               DataSourceType="Command"
               DataSourceName="omx.user_admin.notes_library.select.view:getNoteTypes" />

        <!-- Always Put hidden at the end -->
        <x2:execute command="omx.search.search:getHiddenFields">
          <x2:with-param name="this" select="$this"/>
        </x2:execute>  
        
        <!-- Form Buttons -->
        <BUTTONS>
          <BUTTON 
                  Name="search" 
                  DisplayText="Search" 
                  OnClick="javascript:onSearch()" 
                  Emphasized="no"/>				
        </BUTTONS>
        
      </FORM>       
    </xapl:return>
      
  </x2:command>
    
    
    <!-- ********************************************************************** 
    *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportConfig">
      
	  <xapl:variable name="helpUrl">
      <web:get-page name="select_help"/>
    </xapl:variable>

    <xapl:return>
      <REPORT Selectable="Single" Scrollable="no" SelectedId="ID">
        <HELP Url="{$helpUrl}"/>
        <FIELDS>
           <!-- TODO: Add url -->
            <FIELD 
              Type="Text"
              Name="NOTE_CODE"  
              DisplayText="Name"
			  Url="controller/viewNote.cmd"
			  UrlParam="All"/>
         
            <FIELD 
              Type="Text"
              Name="NOTE_TYPE"  
              DisplayText="Type"/>
         
            <FIELD 
              Type="Text"
              Name="IS_EDITABLE"  
              DisplayText="Change Allowed"/>

            <FIELD 
              Type="Text"
              Name="DESCRIPTION"  
              DisplayText="Description"/>

            <FIELD 
              Type="Hidden"
              Name="NOTE_CODE"
			  Value="{$this/NOTE_CODE/@Value}"/>

            <FIELD 
              Type="Hidden"
              Name="NOTE_TYPE"
			  Value="{$this/NOTE_TYPE/@Value}"/>

            <FIELD 
              Type="Hidden"
              Name="RET_PAGE"
			  Value="{$this/RET_PAGE/@Value}"/>

        <!-- Hidden Fields -->
        <x2:execute command="omx.report.report:getHiddenFields">
          <x2:with-param name="this" select="$this"/>
        </x2:execute> 
		  
        </FIELDS>

		<BUTTONS>

		  <BUTTON 
		            Name="Details" 
			          DisplayText="View Details"
			          OnClick="javascript:onView();" 
			          Disabled="report"/>
					  
		  <BUTTON 
		            Name="Delete" 
			          DisplayText="Delete"
			          OnClick="javascript:onDelete();" 
			          Disabled="report"/>

		  <DIVIDER/>
		  
		  <BUTTON 
		            Name="AddNew" 
			          DisplayText="Add Note"
			          OnClick="javascript:onAdd();" 
					  Emphasized="yes"
			          Disabled="no"/>

        </BUTTONS>   
		  
	    <PAGINATION/>

      </REPORT>
    </xapl:return>

  </x2:command>
    
 
    <!-- ********************************************************************** 
    *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportData">
    <x2:param name="pForm"/>
    <x2:param name="this"/>

    <xapl:variable name="data"/>
    <xapl:variable name="allRecords"/>
    <!-- pDoSearch and user has entered any Search Field on the form-->
	<xapl:if test="{($pForm/FIELD[@Name = 'DO_SEARCH']/@Value = 'Yes' ) and count($pForm/FIELD[@Type !='Hidden' and (string-length(@Value) > 0  or string-length(@Value1) >0 or string-length(@Value2) > 0)]) > 0}">

      <xapl:set-variable name="data">
		  <xcore:execute-method name="{$pForm/@MethodName}" StartAtRow="{$pForm/FIELD[@Name = 'START_COUNT']/@Value}" MaxRows="{$pForm/FIELD[@Name = 'MAX_ROWS']/@Value}" ReturnRowCount="{$this/RETURN_ROW_COUNT/@Value}">

		    <FILTER Name="NOTE_CODE">
              <xcore:search-by property="NOTE_CODE" value="{$pForm/FIELD[@Name = 'NOTE_CODE']/@Value}"/>
            </FILTER>
		    <FILTER Name="NOTE_TYPE">
              <xcore:search-by property="NOTE_TYPE" value="{$pForm/FIELD[@Name = 'NOTE_TYPE']/@Value}"/>
            </FILTER>

          </xcore:execute-method>
      </xapl:set-variable>
		  
	</xapl:if>
	
    <xapl:return>
      <xapl:value-of select="{$data}"/>
    </xapl:return>
    
 </x2:command>
 <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getNoteTypes">
    <x2:param name="pTypeID"/>

    <!-- Get the code master values for the type -->
	  <xapl:variable name="data">
	    <CODE_MASTER_VALUES>
        <xcore:get-document name="//UserSecurity/CODE_MASTER_VALUE">
          <TYPE_ID Value="NOTE_TYPE"/>
        </xcore:get-document>
	    </CODE_MASTER_VALUES>
	  </xapl:variable>

    <!-- Return the code master values -->
	  <xapl:return>
	    <xapl:value-of select="$data"/>
	  </xapl:return>
  </x2:command>


 <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="i18n">
  </x2:command>

</x2:commands>


