<?xml version="1.0" encoding="UTF-8"?>
<x2:commands description="_" 
             xmlns:FUNCTION="http://www.i2.com/FUNCTION" 
             xmlns:REMOVE="http://www.i2.com/REMOVE" 
             xmlns:cfg="http://www.i2.com/configurability" 
             xmlns:core="http://www.i2.com/core" 
             xmlns:omx="http://www.i2.com/omx" 
             xmlns:perm="http://www.i2.com/permissibility" 
             xmlns:util="http://www.i2.com/util" 
             xmlns:web="http://www.i2.com/web" 
             xmlns:x2="http://www.i2.com/x2" 
             xmlns:xapl="http://www.i2.com/xapl" 
             xmlns:xcore="http://www.i2.com/xcore" 
             xmlns:xcore-db="http://www.i2.com/xcore-db" 
             xmlns:docutil="http://www.i2.com/docutil" 
             xmlns:xudl="http://www.i2.com/xudl"
             xmlns:identity="http://www.i2.com/identity">
               
  <!--************************************************************************--> 
  
  <x2:command name="init" public="yes" description="_">
    <x2:execute command="omx.user_admin.notes_library.pages:defineCore"/>
  </x2:command>

  <!--************************************************************************--> 
  
  <x2:command name="defineCore" public="yes" description="_">

  <web:define-page name="notes_library" url="/omx/user_admin/notes_library/select/notes_library.jsp"/>
  <web:define-xsl name="notes_library" url="/omx/user_admin/notes_library/select/xsl/notes_library.xsl"/>

  <web:define-page name="notes_library_detail" url="/omx/user_admin/notes_library/edit/notes_library.jsp"/>
  <web:define-xsl name="notes_library_detail" url="/omx/user_admin/notes_library/edit/xsl/notes_library.xsl"/>

  <web:define-page name="notes_library_help" url="/omx/help/notes_library.html"/>
  <web:define-page name="notes_search_help" url="/omx/help/search.htm"/>
  
  </x2:command> 

</x2:commands>
