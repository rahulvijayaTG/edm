<?xml version="1.0" encoding="UTF-8"?>
<x2:commands description="_" 
             xmlns:FUNCTION="http://www.i2.com/FUNCTION" 
             xmlns:REMOVE="http://www.i2.com/REMOVE" 
             xmlns:cfg="http://www.i2.com/configurability" 
             xmlns:core="http://www.i2.com/core" 
             xmlns:omx="http://www.i2.com/omx" 
             xmlns:perm="http://www.i2.com/permissibility" 
             xmlns:util="http://www.i2.com/util" 
             xmlns:web="http://www.i2.com/web" 
             xmlns:x2="http://www.i2.com/x2" 
             xmlns:xapl="http://www.i2.com/xapl" 
             xmlns:xcore="http://www.i2.com/xcore" 
             xmlns:xcore-db="http://www.i2.com/xcore-db" 
             xmlns:docutil="http://www.i2.com/docutil" 
             xmlns:xudl="http://www.i2.com/xudl"
             xmlns:identity="http://www.i2.com/identity">
               
  <!--************************************************************************--> 
  
  <x2:command name="init" public="yes" description="_">
    <x2:execute command="omx.user_admin.code_master.pages:defineCore"/>
  </x2:command>

  <!--************************************************************************--> 
  
  <x2:command name="defineCore" public="yes" description="_">

  <web:define-page name="editable_code_master" url="/omx/user_admin/code_master/code_master.jsp?IS_EDITABLE=true"/>
  <web:define-page name="noneditable_code_master" url="/omx/user_admin/code_master/code_master.jsp?IS_EDITABLE=false"/>
  <web:define-xsl name="code_master" url="/omx/user_admin/code_master/xsl/code_master.xsl"/>

  <web:define-page name="code_master_help" url="/bcm/help/code_master.html"/>
<!--
  <web:define-page name="add_order_point" url="/omx/add_book/order_point/add.jsp"/>
  <web:define-xsl name="add_order_point" url="/omx/add_book/order_point/xsl/add.xsl"/>
 -->      
  </x2:command> 

</x2:commands>
