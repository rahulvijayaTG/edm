<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="codeMasterDetails">
	
	<!-- Set the session variable for order point id -->
	<xapl:set-variable name="codeID">
	  <xapl:value-of select="{$this/ID/@Value}"/>
	</xapl:set-variable>
	
	<web:display-page>
	  <web:get-page name="edit_code_master">
	    <xapl:value-of select="{$this/*}"/>
	  </web:get-page>
	</web:display-page>
	 
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="activateCodeMasterValue">
    
		<!-- Activate each code selected -->
    <xapl:for-each varName="code" select="$this/SELECTED_ID/@Value"> 
      <xcore:modify-document name="//UserSecurity/CODE_MASTER_VALUE">
        <DOCUMENT_CONTEXT>
          <ID Value="{$code}"/>
        </DOCUMENT_CONTEXT>
        <UPDATE_PROPERTIES>
          <STATUS Value="ACTIVE"/>
        </UPDATE_PROPERTIES>
      </xcore:modify-document>
    </xapl:for-each>
		
		<!-- Return to the Non-Editable Code page, and coduct the search -->
    <web:display-page>
      <web:get-page name="noneditable_code_master">
       	<xapl:value-of select="$this/TYPE_ID"/>
				<DO_SEARCH Value="Yes"/>
				<xapl:value-of select="$this/START_COUNT"/>
				<PARENT_ID Value="{$this/MAIN_PARENT_ID/@Value}"/>
			  <SUCCESS_MESSAGE Value="CODE_MASTER_ENTRY_ACTIVATED"/>
      </web:get-page>
    </web:display-page>
    
  </x2:command>  
  
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="deactivateCodeMasterValue">
    
		<!-- Deactivate each code selected -->
    <xapl:for-each varName="code" select="$this/SELECTED_ID/@Value"> 
      <xcore:modify-document name="//UserSecurity/CODE_MASTER_VALUE">
        <DOCUMENT_CONTEXT>
          <ID Value="{$code}"/>
        </DOCUMENT_CONTEXT>
        <UPDATE_PROPERTIES>
          <STATUS Value="INACTIVE"/>
        </UPDATE_PROPERTIES>
      </xcore:modify-document>
    </xapl:for-each>

		<!-- Return to the Non-Editable Code page, and coduct the search -->
    <web:display-page>
      <web:get-page name="noneditable_code_master">
        <xapl:value-of select="$this/TYPE_ID"/>
				<DO_SEARCH Value="Yes"/>
				<xapl:value-of select="$this/START_COUNT"/>
				<PARENT_ID Value="{$this/MAIN_PARENT_ID/@Value}"/>
			  <SUCCESS_MESSAGE Value="CODE_MASTER_ENTRY_DEACTIVATED"/>
      </web:get-page>
    </web:display-page>
    
  </x2:command>
  
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="addCodeMasterValue">
  
    <xapl:variable name="errorFlag">false</xapl:variable>
    <xapl:variable name="errorSummary"/>
		
    <!-- Add the new code master value -->
    <xapl:variable name="response">
      <xcore:execute-method name="//UserSecurity/addCodeMasterValue" entireResponse="true">
        <xapl:value-of select="$this/TYPE_ID"/>
        <xapl:value-of select="$this/VALUE_ID"/>
        <xapl:value-of select="$this/DESCRIPTION"/>
        <xapl:value-of select="$this/PARENT_ID"/>
      </xcore:execute-method>
    </xapl:variable>
    
		<!-- Check for errors -->
    <xapl:if test="count($response/RESPONSE/_RESULT/_ERROR) > 0 and string-length($response/RESPONSE/_RESULT/_ERROR/@Value) != 0">
      <xapl:set-variable name="errorFlag">true</xapl:set-variable>
      <xapl:set-variable name="errorSummary">
        <ERROR_SUMMARY>
			    <ERROR_MESSAGE Value="{$response/RESPONSE/_RESULT/_ERROR/@Value}"/>
          <ERROR_VALUE_ID Value="{$this/VALUE_ID/@Value}" Type="ADD"/>
          <ERROR_DESCRIPTION Value="{$this/DESCRIPTION/@Value}" Type="ADD"/>
				</ERROR_SUMMARY>
      </xapl:set-variable>
    </xapl:if>
    
		<!-- Return to the Editable Code Master page -->
    <web:display-page>
      <web:get-page name="editable_code_master">
			  <xapl:choose>
          <xapl:when test=" $errorFlag = 'true' ">
						<xapl:value-of select="$errorSummary/*"/>
				  </xapl:when>
				  <xapl:otherwise>
					  <SUCCESS_MESSAGE Value="CODE_MASTER_ENTRY_ADDED"/>
          </xapl:otherwise>
			  </xapl:choose>
        <xapl:value-of select="$this/TYPE_ID"/>	
				<DO_SEARCH Value="Yes"/>
				<xapl:value-of select="$this/START_COUNT"/>
				<xapl:value-of select="$this/PARENT_ID"/>

      </web:get-page>
    </web:display-page>
    
  </x2:command>
  
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="deleteCodeMasterValues">
    
    <!-- For each selected id, delete the code master value -->
    <xapl:for-each varName="code" select="$this/SELECTED_ID/@Value"> 
      <xcore:execute-method name="//UserSecurity/removeCodeMasterValue">
        <xapl:value-of select="$this/TYPE_ID"/>
        <ID Value="{$code}"/>
      </xcore:execute-method>
    </xapl:for-each>
    
		<!-- Return to the Editable Code Master page -->
    <web:display-page>
      <web:get-page name="editable_code_master">
        <xapl:value-of select="$this/TYPE_ID[1]"/>
				<SUCCESS_MESSAGE Value="CODE_MASTER_ENTRY_REMOVED"/>
				<DO_SEARCH Value="Yes"/>
				<xapl:value-of select="$this/START_COUNT[1]"/>
				<PARENT_ID Value="{$this/MAIN_PARENT_ID[1]/@Value}"/>
			  <SUCCESS_MESSAGE Value="CODE_MASTER_ENTRY_DELETED"/>

      </web:get-page>
    </web:display-page>
    
  </x2:command>
  
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="modifyCodeMasterValues">
    <xapl:print>
        <xapl:value-of select="$this"/>
    </xapl:print>
		<!-- TODO: why duplication values on multiple updates??? -->
		
    <!-- Coallate the ID, VALUE_ID, DESCRIPTION, and PARENT_ID passed in from the form -->
    <xapl:variable name="codes">
      <docutil:collate name="CODES">
        <xapl:value-of select="$this/ID"/>
        <xapl:value-of select="$this/VALUE_ID"/>
        <xapl:value-of select="$this/DESCRIPTION"/>
        <xapl:value-of select="$this/PARENT_ID"/>
      </docutil:collate>	
    </xapl:variable>
    
    <xapl:variable name="errorSummary"><ERROR_SUMMARY/></xapl:variable>
    <xapl:variable name="errorFlag">false</xapl:variable>
		  <xapl:print>******  codes  <xapl:value-of select="$codes"/></xapl:print>
    <!-- For each selected id, update the code master value -->
    <xapl:for-each varName="selectedID" select="$this/SELECTED_ID/@Value"> 
     <xapl:print>******  selectedIDs  <xapl:value-of select="$selectedID"/></xapl:print>
      <xapl:variable name="response">
       	<xcore:execute-method name="//UserSecurity/modifyCodeMasterValue" entireResponse="true">
         	<ID Value="{$selectedID}"/>
         	<xapl:value-of select="$codes/CODES/ID[@Value = $selectedID]/../VALUE_ID"/>
         	<xapl:value-of select="$codes/CODES/ID[@Value = $selectedID]/../DESCRIPTION"/>
         	<xapl:value-of select="$codes/CODES/ID[@Value = $selectedID]/../PARENT_ID"/>
        </xcore:execute-method>
      </xapl:variable>
      
      <!-- TODO: add error message display to page -->
			
			<!-- Check for errors -->
      <xapl:if test="count($response/RESPONSE/_RESULT/_ERROR) > 0 and string-length($response/RESPONSE/_RESULT/_ERROR/@Value) != 0">
        <xapl:set-variable name="errorFlag">true</xapl:set-variable>
        <docutil:add select="$errorSummary">
			    <ERROR_MESSAGE Value="{$response/RESPONSE/_RESULT/_ERROR/@Value}"/>
          <ERROR_MESSAGE_ID Value="{$selectedID}"/>
       	</docutil:add>
      </xapl:if>
			
    </xapl:for-each>
    
		<xapl:print select="$errorSummary"/>
		
		<!-- Return to the Editable Code Master page -->
    <web:display-page>
      <web:get-page name="editable_code_master">
			  <xapl:choose>
          <xapl:when test=" $errorFlag = 'true' ">
						<xapl:value-of select="$errorSummary/*"/>
				  </xapl:when>
				  <xapl:otherwise>
					  <SUCCESS_MESSAGE Value="CODE_MASTER_ENTRY_UPDATED"/>
          </xapl:otherwise>
			  </xapl:choose>
        <xapl:value-of select="$this/TYPE_ID[1]"/>
				<DO_SEARCH Value="Yes"/>
				<xapl:value-of select="$this/START_COUNT[1]"/>
				<PARENT_ID Value="{$this/MAIN_PARENT_ID[1]/@Value}"/>

      </web:get-page>
    </web:display-page>
    
  </x2:command>  
</x2:commands>

