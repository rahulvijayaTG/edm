<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:i18n="http://www.i2.com/i18n" xmlns:identity="http://www.i2.com/identity" description="_">
	<!-- **********************************************************************
  *********************************************************************** -->
   <x2:command public="yes" description="_" name="init">
     <xapl:variable name="codeMasterFirstData" resolver="session" global="true"/>
   </x2:command>
   
  <x2:command public="yes" description="_" name="load">

<xapl:print>
	**********  THIS ON LOAD::::   %%%%%%%%%%%%%%<xapl:value-of select="$this"/>
</xapl:print>
      
   <x2:execute command="bcm.context.controller:cleanContext"/>


    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
      <x2:with-param name="display" select="'Code Master'"/>
      <x2:with-param name="page" select="'editable_code_master'"/>
      <x2:with-param name="this" select="{$this}"/>
    </x2:execute>

    <xapl:variable name="searchOutput">
      <!-- Search / Form and Report -->
      <x2:execute command="bcm.framework.queryform.Form:getFormContainer">
        <x2:with-param name="this" select="{$this}"/>
        <x2:with-param name="pSearchParam" select="{$searchParam}"/>
        <x2:with-param name="pSearchFormConfigSource" select="'omx.user_admin.code_master.view:getFormConfig'"/>
        <x2:with-param name="pSearchReportConfigSource" select="'omx.user_admin.code_master.view:getReportConfig'"/>
        <x2:with-param name="pReportDataSource" select="'omx.user_admin.code_master.view:getReportData'"/>
      </x2:execute>
    </xapl:variable>

    <xapl:return>

		  <xapl:value-of select="$this/TYPE_ID[1]"/>
		  <xapl:value-of select="$this/ERROR_MESSAGE[1]"/>
		  <xapl:value-of select="$this/ERROR_VALUE_ID[1]"/>
		  <xapl:value-of select="$this/ERROR_DESCRIPTION[1]"/>
		  <xapl:value-of select="$this/SUCCESS_MESSAGE[1]"/>

      <!-- Header -->
      <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>

      <!-- Tabs -->
      <x2:execute command="omx.user_admin.code_master.view:getContainer">
        <x2:with-param name="pEditable" select="$this/IS_EDITABLE[1]/@Value"/>
        <x2:with-param name="pHide" select="$this/TABS_HIDE[1]/@Value"/>
        <x2:with-param name="pReturnLink" select="$this/RET_PAGE[1]/@Value"/>
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
     <!-- Search / Form and Report -->
	 <xapl:value-of select="$searchOutput"/>

    </xapl:return>

  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getContainer">
    <x2:param name="pEditable"/>

    <xapl:variable name="helpUrl">
	  <xapl:choose>
        <xapl:when test="{$pEditable = 'true'}">
          <web:get-page name="code_master_help"/>
        </xapl:when>
		<xapl:otherwise>
          <web:get-page name="code_master_noedit_help"/>
		</xapl:otherwise>
	  </xapl:choose>
    </xapl:variable>

    <xapl:return>

      <!-- TODO: why not scrolling? -->
      <CONTAINER Id="container">
        <HELP Url="{$helpUrl}"/>

          <STEP
             DisplayText="Editable Codes"
             OnClick="{$pages:editable_code_master}"
             Selected="{$pEditable = 'true'}"/>


      </CONTAINER>

    </xapl:return>

  </x2:command>


  <!-- **********************************************************************
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="getFormConfig">
<xapl:print>
	getFormConfig::::<xapl:value-of select="$this"/>
</xapl:print>
    <xapl:return>
      <!-- Search Fields -->
      <FORM  MethodName="//UserSecurity/CODE_MASTER_VALUE" Name="search_form" Action="code_master.jsp" method="GET" Target="appFrame">

        <FIELD
               Type="Select"
               SelectAll="No"
               DisplayText="Type"
               Name="TYPE_ID"
               Value="{$this/TYPE_ID[1]/@Value}"
               Visibility="Simple"
               DataSourceType="Command"
               DataSourceName="omx.user_admin.code_master.view:getCodeMasterTypes" />

        <x2:execute command="omx.user_admin.code_master.view:getParentField">
          <x2:with-param name="this" select="$this"/>
          <x2:with-param name="pTypeID" select="$this/TYPE_ID[1]/@Value"/>
          <x2:with-param name="pValue" select="{$this/PARENT_ID[1]/@Value}"/>
          <x2:with-param name="pEditable" select="true"/>
          <x2:with-param name="pSelectAll" select="Yes"/>
        </x2:execute>

        <FIELD
               Type="Text"
               DisplayText="Name"
               Name="F_VALUE_ID"
               Value="{$this/F_VALUE_ID[1]/@Value}"
               Visibility="Advanced"/>

	<FIELD
               Type="Text"
               DisplayText="Description"
               Name="F_DESCRIPTION"
               Value="{$this/F_DESCRIPTION[1]/@Value}"
               Visibility="Advanced"/>

        <FIELD
		       Type="Hidden"
		       Name="IS_EDITABLE"
		       Value="{$this/IS_EDITABLE[1]/@Value}" />

        <!-- Always Put hidden at the end -->
        <!-- Always Put hidden at the end -->
        <x2:execute command="bcm.framework.queryform.Form:getFormSearchHiddenFields">
          <x2:with-param name="this" select="$this"/>
        </x2:execute>


        <!-- Form Buttons -->
        <BUTTONS>
          <BUTTON
                  Name="search"
                  DisplayText="Search"
                  OnClick="javascript:onSearch()"
                  Emphasized="no"/>
        </BUTTONS>

      </FORM>
    </xapl:return>

  </x2:command>


    <!-- **********************************************************************
    *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportConfig">
<xapl:print>
	getReportConfig:::<xapl:value-of select="$this"/>
</xapl:print>
	  <xapl:variable name="helpUrl">
      <web:get-page name="select_help"/>
    </xapl:variable>

    <xapl:return>
      <REPORT Selectable="All" SelectedId="SELECTED_ID" Validation="yes" ScrollableContainer="no" Scrollable="yes" PagingTitle="yes">
        <!--HELP Url="{$helpUrl}"/-->
        <FIELDS>

				<!-- Hidden field w/ DisplayType="Hidden" will appear for each result -->
        <FIELD
          Type="None"
					DisplayType="Text"
                    Hidden="yes"
          Name="ID"/>

 
            <FIELD
              DisplayType="Text"
              Name="VALUE_ID"
              DisplayText="Name"
              Required="yes"
              UrlParam="All"
              Editable="yes"/>

            <FIELD
              DisplayType="Text"
              Name="DESCRIPTION"
              Required="no"
              DisplayText="Description"
              Editable="yes"/> 
              

        <FIELD
          DisplayType="Text"
          Hidden="yes"
          Name="TYPE_ID"
					Value="{$this/TYPE_ID[1]/@Value}" />

        <FIELD
          DisplayType="Text"
          Hidden="yes"
          Name="MAIN_PARENT_ID"
					Value="{$this/PARENT_ID[1]/@Value}" />



        <!-- Hidden Fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
          
        </FIELDS>

		    <BUTTONS>

			      <!-- if codes are editable, add buttons to update and delete -->

		          <BUTTON
		            Name="Update"
			          DisplayText="Update"
			          OnClick="javascript:modifyCodeMasterValues();"
			          Disabled="report"/>

		          <BUTTON
		            Name="Delete"
			          DisplayText="Delete"
			          OnClick="javascript:deleteCodeMasterValues();"
			          Disabled="report"/>

        </BUTTONS>

		    <PAGINATION/>

      </REPORT>
    </xapl:return>

  </x2:command>

    <!-- **********************************************************************
    *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportData">
    <x2:param name="pForm"/>
    <x2:param name="this"/>
<xapl:print>
	getReportData:::<xapl:value-of select="$this"/>
</xapl:print>


    <xapl:variable name="userId"><identity:get-user-id/></xapl:variable>
    <xapl:variable name="data"/>




    <!-- pDoSearch and user has entered any Search Field on the form-->
	  <xapl:if test="{($pForm/FIELD[@Name = 'DO_SEARCH']/@Value = 'Yes' ) or ($pForm/FIELD[@Name = 'DO_SEARCH']/@Value = 'yes' )}">

      <xapl:set-variable name="data">
        <xcore:get-document name="{$pForm/@MethodName}" entireResponse="true" StartAtRow="{$this/START_COUNT[1]/@Value}" MaxRows="{$this/MAX_ROWS[1]/@Value}" ReturnRowCount="yes">
		      
		      <xapl:value-of select="$this/TYPE_ID[1]"/>
		      
		      <xapl:if test="string-length($this/F_VALUE_ID[1]/@Value) > 0 ">
		      	<xcore:search-by property="VALUE_ID" value="{$this/F_VALUE_ID[1]/@Value}"/>
		      </xapl:if>
		      		
		      <xapl:if test="string-length($this/PARENT_ID[1]/@Value) > 0 ">
		      	<xapl:value-of select="$this/PARENT_ID[1]"/>
		      </xapl:if>			      	      
		      
          <ORDER_BY>
            <DESCRIPTION Sort="Ascending"/>
          </ORDER_BY>
        </xcore:get-document>
      </xapl:set-variable>


	  </xapl:if>
	<xapl:print>
        BEFORE DATA:::::
        <xapl:value-of select="$data"/>
	</xapl:print>
    <docutil:add select="$data/RESPONSE">
      <TOTAL_RECORD_COUNT Value="{$data/RESPONSE/@TotalRowCount}"/>
      <START_AT_ROW Value ="{$this/START_COUNT/@Value}"/>
    </docutil:add>
	<xapl:print>
        AFTER DATA:::::
        <xapl:value-of select="$data"/>
	</xapl:print>
    <xapl:return>
      <xapl:value-of select="{$data/RESPONSE}"/>
    </xapl:return>

 </x2:command>

 <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getCodeMasterTypes">
    <x2:param name="this"/>

	<!-- Get all of the code master types based on the IS_EDITABLE flag -->
	  <xapl:variable name="rawData">
	    <CODE_MASTER_TYPES>
        <xcore:get-document name="//UserSecurity/CODE_MASTER_TYPE">
          <IS_EDITABLE Value="{$this/IS_EDITABLE[1]/@Value}"/>
          <ORDER_BY>
            <TYPE_ID Sort="Ascending"/>
          </ORDER_BY>
        </xcore:get-document>
	    </CODE_MASTER_TYPES>
	  </xapl:variable>

	  <!-- Convert the raw data to a format usefull in the dropdown list -->
	  <xapl:variable name="data">
	    <CODE_MASTER_TYPES>
        <xapl:for-each varName="row" select="{$rawData/*}">
		      <CODE_MASTER_TYPE>
		      	<VALUE_ID Value="{$row/TYPE_ID/@Value}"/>
                <DESCRIPTION Value="{$row/DESCRIPTION/@Value}"/>
		      </CODE_MASTER_TYPE>
        </xapl:for-each>
	    </CODE_MASTER_TYPES>
	  </xapl:variable>
         <xapl:print>%%%%%%%%  IN GET CODE MASTER TYPES  ***********</xapl:print>
         <xapl:print select="$data"/>
        
         <xapl:set-variable name="codeMasterFirstData" select="$data/CODE_MASTER_TYPE[1]"/>
         <xapl:print>%%%%%%%%%%%%%%    DATA      %%%%%%%%%%%%%%%%%</xapl:print>
         <xapl:print select="$codeMasterFirstData"/>         
	 <xapl:variable name="cmFirstValue" select="{$codeMasterFirstData/VALUE_ID/@Value}"/>
	 <xapl:print>%%%%%%%%%%%%%%   THIS  ++++++++++++++++</xapl:print>
	 <xapl:print select="$this"/>         
	 <xapl:choose>
	   <xapl:when test="string-length($this/TYPE_ID/@Value) = 0">
	      <xapl:print>%%%%%%%%%%   TYPE ID TAG NULL   ***********</xapl:print>
	      <docutil:add select="$this">
	        <TYPE_ID Value="{$cmFirstValue}"/>
	      </docutil:add>
           </xapl:when>
           <xapl:otherwise>
             <xapl:print>+++++++++++++++   TYPE ID TAG NOT  NULL   !!!!!!!!!!!!!!!!!</xapl:print>
           </xapl:otherwise>
         </xapl:choose>
         
	  <xapl:return>
      <xapl:value-of select="$data"/>
	  </xapl:return>

  </x2:command>

 <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getParentField">
    <x2:param name="this"/>
    <x2:param name="pTypeID"/>
	  <x2:param name="pValue"/>
	  <x2:param name="pEditable"/>
	  <x2:param name="pSelectAll"/>

    <!-- Get the code master values for the type -->
	  <xapl:variable name="data">
      <x2:execute command="omx.user_admin.code_master.view:getCodeMasterValuesByType">
        <x2:with-param name="pTypeID" select="{$pTypeID}"/>
	    </x2:execute>
	  </xapl:variable>

    <!-- If the code master value contains a parent id -->
	  <xapl:if test="count($data/CODE_MASTER_VALUE/PARENT_ID) > 0">

		  <!-- If it does not exist, get the parent code master value's type -->
		  <xapl:if test="string-length($this/PARENT_TYPE/@Value) = 0">
		    <xapl:variable name="parentType">
	          <x2:execute command="omx.user_admin.code_master.view:getParentType">
	            <x2:with-param name="codeMasterValues" select="{$data}"/>
		      </x2:execute>
		    </xapl:variable>

	        <!-- Add the parent type to this, so it can be accessed in getParentList -->
		    <docutil:add select="$this">
	        <xapl:value-of select="{$parentType}"/>
	      </docutil:add>
		  </xapl:if>

	      <!-- If the type is STATE, change the DisplayText to Country -->
		  <xapl:variable name="displayText">
		    <xapl:choose>
			    <xapl:when test="$pTypeID = 'STATE'">Country</xapl:when>
			    <xapl:otherwise>Parent</xapl:otherwise>
			  </xapl:choose>
		  </xapl:variable>

      <!-- Return the field with the DataSource to retreive the list of parent codes -->
      <xapl:return>
	      <FIELD
			      Type="Select"
			      SelectAll="{pSelectAll}"
			      DisplayText="{$displayText}"
			      Editable="{$pEditable}"
			      Value="{$pValue}"
            Name="PARENT_ID"
            DataSourceType="Command"
            DataSourceName="omx.user_admin.code_master.view:getParentList"/>
	    </xapl:return>

    </xapl:if>

  </x2:command>

 <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getParentType">
    <x2:param name="codeMasterValues"/>

      <!-- Get the child's parent id -->
	  <xapl:variable name="firstChild">
      <xapl:get-index index="0" select="$codeMasterValues/CODE_MASTER_VALUE"/>
    </xapl:variable>

	  <!-- Get the parent code master value from the parent id -->
    <xapl:variable name="parent">
      <xcore:get-document name="//UserSecurity/CODE_MASTER_VALUE">
        <ID Value="{$firstChild/PARENT_ID/@Value}"/>
      </xcore:get-document>
    </xapl:variable>

	  <!-- Return the parent code master value's type -->
    <xapl:return>
      <PARENT_TYPE Value="{$parent/TYPE_ID/@Value}"/>
    </xapl:return>

  </x2:command>

 <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getParentList">
    <x2:param name="this"/>

	<!-- Get the code master values of the parent type -->
	  <xapl:variable name="rawData">
      <x2:execute command="omx.user_admin.code_master.view:getCodeMasterValuesByType">
        <x2:with-param name="pTypeID" select="{$this/PARENT_TYPE/@Value}"/>
	    </x2:execute>
	  </xapl:variable>

  	<!-- Convert the raw data to a format usefull in the dropdown list -->
	  <xapl:variable name="data">
	    <CODE_MASTER_VALUES>
        <xapl:for-each varName="row" select="{$rawData/*}">
		      <CODE_MASTER_VALUE>
		        <VALUE_ID Value="{$row/ID/@Value}"/>
            <DESCRIPTION Value="{$row/DESCRIPTION/@Value}"/>
		      </CODE_MASTER_VALUE>
        </xapl:for-each>
	    </CODE_MASTER_VALUES>
	  </xapl:variable>

	  <xapl:return>
	    <xapl:value-of select="$data"/>
	  </xapl:return>

  </x2:command>

 <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getCodeMasterValuesByType">
    <x2:param name="pTypeID"/>

    <!-- Get the code master values for the type -->
	  <xapl:variable name="data">
	    <CODE_MASTER_VALUES>
        <xcore:get-document name="//UserSecurity/CODE_MASTER_VALUE">
          <TYPE_ID Value="{$pTypeID}"/>
        </xcore:get-document>
	    </CODE_MASTER_VALUES>
	  </xapl:variable>

    <!-- Return the code master values -->
	  <xapl:return>
	    <xapl:value-of select="$data"/>
	  </xapl:return>
  </x2:command>

 <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="i18n">
	  <i18n:text>Type</i18n:text>
	  <i18n:text>Activate</i18n:text>
	  <i18n:text>Deactivate</i18n:text>
	  <i18n:text>Name</i18n:text>
	  <i18n:text>Display Text</i18n:text>
	  <i18n:text>Status</i18n:text>
	  <i18n:text>Parent Text</i18n:text>
	  <i18n:text>Country</i18n:text>
	  <i18n:text>Update</i18n:text>
	  <i18n:text>Delete</i18n:text>
	  <i18n:text>Add New</i18n:text>
  </x2:command>

</x2:commands>


