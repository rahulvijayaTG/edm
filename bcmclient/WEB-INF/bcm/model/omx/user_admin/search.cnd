<?xml version="1.0" encoding="UTF-8"?>
<x2:commands description="_" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:cfg="http://www.i2.com/configurability" xmlns:core="http://www.i2.com/core" xmlns:omx="http://www.i2.com/omx" xmlns:perm="http://www.i2.com/permissibility" xmlns:util="http://www.i2.com/util" xmlns:web="http://www.i2.com/web" xmlns:x2="http://www.i2.com/x2" xmlns:xapl="http://www.i2.com/xapl" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:docutil="http://www.i2.com/docutil" xmlns:xudl="http://www.i2.com/xudl" xmlns:identity="http://www.i2.com/identity">
  <!-- ********************************************************************** 
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="getUsers">
    <x2:param name="pFilter"/>
    <xapl:variable name="users">
      <xcore:execute-method name="//UserSecurity/getUsers">
        <xapl:value-of select="$pFilter"/>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:return>
      <xapl:value-of select="$users"/>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="getUserName">
    <x2:param name="pId"/>
    <xapl:variable name="user">
      <xcore:execute-method name="//UserSecurity/getUser">
        <xcore:search-by property="ID" value="{$pId}" matchby="EQUAL"/>
      </xcore:execute-method>
    </xapl:variable>
    <xapl:return>
      <xapl:value-of select="$user/LOGIN_NAME/@Value"/>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
     *********************************************************************** -->
  <x2:command public="yes" description="_" name="getUserDocument">
    <x2:param name="pId"/>
    <xapl:return>
      <xcore:get-document name="//UserSecurity/USER_PROFILE">
        <!-- /getUsers doesnt give password -->
        <ID Value="{$pId}"/>
      </xcore:get-document>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getSearchFormConfig">
    <xapl:print select="{$this}"/>
    <xapl:return>
      <!-- Search Fields -->
      <FORM MethodName="//UserSecurity/getUsers" Name="search_form" Action="search.jsp" Method="GET" Target="appFrame">
        <FIELD Type="Text" DisplayText="Login Name" Name="LOGIN_NAME" Value="{$this/LOGIN_NAME/@Value}" Visibility="Simple"/>
        <FIELD Type="CheckBox" DisplayText="Show Inactive" Name="INACTIVE_STATUS" Value="{$this/INACTIVE_STATUS/@Value}" CheckedValue="true" Visibility="Simple"/>
        <FIELD Type="Select" SelectAll="Yes" DisplayText="Role" Name="ROLE_ID" Value="{$this/ROLE_ID/@Value}" Visibility="Advanced" DataSourceType="Command" DataSourceName="omx.user_admin.user_admin_users:getAssignableRoles"/>
        <FIELD Type="Text" DisplayText="First Name" Name="FIRST_NAME" Value="{$this/FIRST_NAME/@Value}" Visibility="Advanced"/>
        <FIELD Type="Text" DisplayText="Last Name" Name="LAST_NAME" Value="{$this/LAST_NAME/@Value}" Visibility="Advanced"/>
        <FIELD Type="Hidden" Name="WHERE" DisplayType="Hidden" Value="{$this/WHERE/@Value}"/>
        <!-- Always Put hidden at the end -->
        <x2:execute command="omx.search.search:getHiddenFields">
          <x2:with-param name="this" select="$this"/>
        </x2:execute>
        <!-- Form Buttons -->
        <BUTTONS>
          <BUTTON Name="search" DisplayText="Search" OnClick="javascript:onSearch()" Emphasized="no"/>
        </BUTTONS>
      </FORM>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getSearchReportConfig">
    <xapl:variable name="helpUrl">
      <web:get-page name="user_admin_search_res_help"/>
    </xapl:variable>
    <xapl:return>
      <REPORT Selectable="Single" Scrollable="no" PagingTitle="yes">
<!--
	<HELP Url="{$helpUrl}"/>
-->
	<FIELDS>
          <FIELD Name="LOGIN_NAME" DisplayText="Login Name" Sortable="yes" Url="" UrlParam="All"/>
          <FIELD Name="FIRST_NAME" DisplayText="First Name" Sortable="yes"/>
          <FIELD Name="LAST_NAME" DisplayText="Last Name" Sortable="yes"/>
          <FIELD Name="EMAIL_ADDRESS" DisplayText="Email Address"/>
          <FIELD Name="ORG_NAME" DisplayText="Organization Name" Sortable="no"/>
          <FIELD Name="STATUS" DisplayText="Status" Sortable="yes"/>
          <FIELD Name="ROLE_NAME" DisplayText="Role" Sortable="no"/>
          <FIELD Type="Hidden" Name="fromPage" Value="users_search"/>
          <!-- Hidden Fields -->
          <x2:execute command="omx.report.report:getHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
        </FIELDS>
        <BUTTONS>
          <BUTTON DisplayText="Reset Password" OnClick="javascript:onResetPassword();" DisableOnClick="true" Disabled="report"/>
          <DIVIDER/>
          <BUTTON DisplayText="User Details" OnClick="javascript:edit();" DisableOnClick="true" Disabled="report"/>
        </BUTTONS>
        <PAGINATION/>
      </REPORT>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportData">
    <x2:param name="pForm"/>
    <x2:param name="pIds"/>
    <x2:param name="pAddRecordCount" select="'true'"/>
    <!-- Give Defaults - Start:-->
    <xapl:variable name="addRecordCount" select="$pAddRecordCount"/>
    <xapl:variable name="statusFilter">
      <ROOT/>
    </xapl:variable>
    <xapl:variable name="userId">
      <identity:get-user-id/>
    </xapl:variable>
    <!-- setting the org status-->
    <xapl:set-variable name="statusFilter">
      <FILTER Name="STATUS">
        <xapl:choose>
          <xapl:when test=" ($pForm/FIELD[@Name = 'INACTIVE_STATUS']/@Value = 'true') ">
            <OR>
              <xcore:search-by property="STATUS" value="INACTIVE" matchby="EQUAL"/>
              <xcore:search-by property="STATUS" value="ACTIVE" matchby="EQUAL"/>
            </OR>
          </xapl:when>
          <xapl:otherwise>
            <xcore:search-by property="STATUS" value="ACTIVE"/>
          </xapl:otherwise>
        </xapl:choose>
      </FILTER>
    </xapl:set-variable>
    <xapl:variable name="data">
      <xapl:choose>
        <!-- pDoSearch and user has entered any Search Field on the form-->
        <xapl:when test="{($pForm/FIELD[@Name = 'DO_SEARCH']/@Value = 'Yes' )}">
          <xapl:print>INSIDE DO_SEARCH = YES </xapl:print>
          <!-- Get Data -->
          <xcore:execute-method name="{$pForm/@MethodName}" StartAtRow="{$pForm/FIELD[@Name = 'START_COUNT']/@Value}" MaxRows="{$pForm/FIELD[@Name = 'MAX_ROWS']/@Value}" ReturnRowCount="{$this/RETURN_ROW_COUNT/@Value}">
            <!-- TODO :Genarate the FILTERS Automatically -->
            <USER_ID Value="{identity-user-id()}"/>
            <xapl:if test="{string-length($this/FIRST_NAME/@Value) &gt; 0}">
              <FILTER Name="FIRST_NAME">
                <xcore:search-by property="FIRST_NAME" value="{$this/FIRST_NAME/@Value}"/>
              </FILTER>
            </xapl:if>
            <xapl:if test="{string-length($this/LAST_NAME/@Value) &gt; 0}">
              <FILTER Name="LAST_NAME">
                <xcore:search-by property="LAST_NAME" value="{$this/LAST_NAME/@Value}"/>
              </FILTER>
            </xapl:if>
            <xapl:if test="{string-length($this/LOGIN_NAME/@Value) &gt; 0}">
              <FILTER Name="LOGIN_NAME">
                <xcore:search-by property="LOGIN_NAME" value="{$this/LOGIN_NAME/@Value}"/>
              </FILTER>
            </xapl:if>
            <xapl:value-of select="$statusFilter"/>
            <xapl:choose>
              <xapl:when test="{string-length($this/ROLE_ID/@Value) &gt; 0}">
                <FILTER Name="ROLE_ID">
                  <xcore:search-by property="ROLE_ID" value="{$this/ROLE_ID/@Value}"/>
                </FILTER>
              </xapl:when>
              <xapl:otherwise>
                <xapl:variable name="assignableRoles">
                  <x2:execute command="omx.user_admin.user_admin_users:getAssignableRoles"/>
                </xapl:variable>
                <FILTER Name="ROLE_ID">
                  <OR>
                    <xapl:for-each select="$assignableRoles/ASSIGNABLE_ROLE" varName="role">
                      <xcore:search-by property="ROLE_ID" value="{$role/VALUE_ID/@Value}"/>
                    </xapl:for-each>
                  </OR>
                </FILTER>
              </xapl:otherwise>
            </xapl:choose>
            <xapl:if test="string-length($pForm/FIELD[@Name = 'SORT_BY']/@Value) > 0 and string-length($pForm/FIELD[@Name = 'SORT_ORDER']/@Value) > 0">
              <ORDER_BY>
                <docutil:element name="{$pForm/FIELD[@Name = 'SORT_BY']/@Value}" Sort="{$pForm/FIELD[@Name = 'SORT_ORDER']/@Value}"/>
              </ORDER_BY>
            </xapl:if>
          </xcore:execute-method>
        </xapl:when>
        <!-- pIds or pGetRecent -->
        <xapl:otherwise>
          <xapl:if test="{($pForm/FIELD[@Name = 'DO_SEARCH']/@Value != 'Yes' ) or count($pIds/ID) > 0}">
            <xapl:print>INSIDE DO_SEARCH NOT EQUAL TO YES </xapl:print>
            <!-- Get Ids -->
            <xapl:variable name="ids">
              <IDS>
                <xapl:choose>
                  <!-- If ids are passed -->
                  <xapl:when test="count($pIds/ID) > 0">
                    <xapl:value-of select="$pIds/ID"/>
                  </xapl:when>
                  <!-- Other wise get recent ids-->
                  <xapl:otherwise>
<!--
                    <omx:get-recent max="10" userId="{$userId}">
                      <TRANSACTION>
                        <docutil:element name="{$pForm/FIELD[@Name = 'OBJECT_TYPE']/@Value}"/>
                      </TRANSACTION>
                    </omx:get-recent>
                    <xapl:print>INSIDE OTHERWISE AFTER GET_RECENT </xapl:print>
-->
                  </xapl:otherwise>
                </xapl:choose>
              </IDS>
            </xapl:variable>
            <!-- Get data -->
            <xapl:if test="{count($ids/*) > 0}">
              <xapl:set-variable name="addRecordCount" select="'false'"/>
              <xcore:execute-method name="{$pForm/@MethodName}" ReturnRowCount="{$this/RETURN_ROW_COUNT/@Value}">
                <FILTER Name="ID">
                  <OR>
                    <xapl:value-of select="{$ids/ID}"/>
                  </OR>
                </FILTER>
                <xapl:if test="{string-length($pForm/FIELD[@Name = 'STATE_ID']/@Value) != 0}">
                  <FILTER Name="STATE_ID">
                    <xcore:search-by property="STATE_ID" value="{$pForm/FIELD[@Name = 'STATE_ID']/@Value}"/>
                  </FILTER>
                </xapl:if>
                <xapl:if test="string-length($pForm/FIELD[@Name = 'SORT_BY']/@Value) > 0 and string-length($pForm/FIELD[@Name = 'SORT_ORDER']/@Value) > 0">
                  <ORDER_BY>
                    <docutil:element name="{$pForm/FIELD[@Name = 'SORT_BY']/@Value}" Sort="{$pForm/FIELD[@Name = 'SORT_ORDER']/@Value}"/>
                  </ORDER_BY>
                </xapl:if>
              </xcore:execute-method>
            </xapl:if>
            <!-- If ids -->
          </xapl:if>
          <!-- DO_SEARCH != yes or pIds -->
        </xapl:otherwise>
        <!-- DO_SEARCH !=yes and user entered nothing -->
      </xapl:choose>
    </xapl:variable>
    <xapl:variable name="identityUserId">
      <identity:get-user-id/>
    </xapl:variable>
    <docutil:remove select="$data/USER_PROFILE[ ID/@Value = $identityUserId ]"/>
    <!-- Add the total record count  -->
    <docutil:add select="$data">
      <TOTAL_RECORD_COUNT Value="{$data/@TotalRowCount - 1}"/>
      <START_AT_ROW Value="{$this/START_COUNT/@Value}"/>
    </docutil:add>

        <!-- TODO Do this dynamically only if timingStats are on. -->
        <docutil:remove select="$data/TIMING_STATS"/>
        <docutil:remove select="$data/RESPONSE/TIMING_STATS"/>

    <xapl:return>
      <xapl:value-of select="{$data}"/>
    </xapl:return>
  </x2:command>
  <!-- ********************************************************************** 
  *********************************************************************** -->
</x2:commands>
