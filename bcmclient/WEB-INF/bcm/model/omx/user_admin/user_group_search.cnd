<?xml version="1.0" encoding="UTF-8"?>
<x2:commands description="_" 
             xmlns:FUNCTION="http://www.i2.com/FUNCTION" 
             xmlns:REMOVE="http://www.i2.com/REMOVE" 
             xmlns:cfg="http://www.i2.com/configurability" 
             xmlns:core="http://www.i2.com/core" 
             xmlns:omx="http://www.i2.com/omx" 
             xmlns:perm="http://www.i2.com/permissibility" 
             xmlns:util="http://www.i2.com/util" 
             xmlns:web="http://www.i2.com/web" 
             xmlns:x2="http://www.i2.com/x2" 
             xmlns:xapl="http://www.i2.com/xapl" 
             xmlns:xcore="http://www.i2.com/xcore" 
             xmlns:xcore-db="http://www.i2.com/xcore-db" 
             xmlns:docutil="http://www.i2.com/docutil" 
             xmlns:xudl="http://www.i2.com/xudl"
             xmlns:identity="http://www.i2.com/identity">
  
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
    <xapl:print select="$this"/>
    <x2:param name="this" select="$this"/>
    <xapl:if test="$this/MODE/@Value = 'START'">        
      <docutil:remove select="$this/MODE"/>
      <x2:execute command="bcm.context.controller:cleanContext"/>
      <!-- Nullify the ongoing workflow such as CREATE_NEW_ROLE -->
      <xapl:set-variable name="adminProcess"/> 
    </xapl:if>
    
    <!-- BREADCRUMBS AT TOP OR AFTER CLEAN-CONTEXT-->
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
      <x2:with-param name="display" select="'User Groups'"/>
      <x2:with-param name="page" select="'user_admin_group_search'"/>
      <x2:with-param name="this" select="{$this}"/>
    </x2:execute>
    
    <docutil:set select="$this">
      <DO_SEARCH Value="Yes"/>
      <SERVICE Value="UserSecurity"/>
      <FORM_NAME Value="USR_GRP_SEARCH_FORM"/>
    </docutil:set>
    
    <!-- 'STATUS' field being checkbox, $this needs to be updated when the field not checked(made false) -->
    <xapl:if test="count($this/F_USER_GRP_PROFILE_STATUS) = 0">
      <docutil:add select="$this">
        <F_USER_GRP_PROFILE_STATUS Value="false"/>
      </docutil:add>
    </xapl:if>    
    
    <xapl:variable name="userGroupSearchForm">
        <x2:execute command="bcm.framework.queryform.Form:getFormContainer">
          <x2:with-param name="this" select="$this"/>
          <x2:with-param name="pSearchParam" select="$searchParam"/>
          <x2:with-param name="pFormName" select="'USR_GRP_SEARCH_FORM'"/>
          <x2:with-param name="pServiceName" select="'UserSecurity'"/>
          <x2:with-param name="pSearchFormConfigSource" select="'omx.user_admin.user_group_search:getFormConfig'"/>
          <x2:with-param name="pSearchReportConfigSource" select="'omx.user_admin.user_group_search:getReportConfig'"/>
          <x2:with-param name="pReportDataSource" select="'omx.user_admin.user_group_search:getReportData'"/>
        </x2:execute>
    </xapl:variable>    
    
    <xapl:return>
      <!-- Page Header as breadcrumbs-->
      <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
      <!-- Container-->
      <x2:execute command="omx.user_admin.user_group_search:getContainer">
        <x2:with-param name="this" select="{$this}"/>
      </x2:execute>
      <xapl:value-of select="$userGroupSearchForm"/>
      <!-- return parameters-->
      <xapl:value-of select="$this/*[string-length(@Value) &gt; 0]"/>
      <xapl:value-of select="$context"/>
    </xapl:return>
  </x2:command>

<!-- ********************************************************************** 
     *********************************************************************** -->  
  <x2:command public="yes" description="_" name="getUserGroups">
    <x2:param name="pFilter"/>
    
    <xapl:variable name="usersGroups">
      <xcore:execute-method name="//UserSecurity/getUserGroups">
        <xapl:value-of select="$pFilter"/>
      </xcore:execute-method>
    </xapl:variable>  

    <xapl:return>
      <xapl:value-of select="$usersGroups"/>
    </xapl:return>
  </x2:command>  
  
 <!-- ********************************************************************** 
    *********************************************************************** -->  
  <x2:command public="yes" description="_" name="getFormConfig">      
    <xapl:print select="$this" />       
    <xapl:variable name="request"/>
    <xapl:set-variable name="request" select="{concat('//', 'UserSecurity', '/getFormData')}"/>
    <xapl:return>
      <FORM Name="search_form" Action="UserGroupSearch.jsp" method="POST" Target="appFrame">
        <!--get all search form fields -->
        <x2:execute command="bcm.framework.queryform.Form:getFormSearchFields">
          <x2:with-param name="this" select="$this"/>
        </x2:execute>
        <!-- Hidden Fields : general fields-->
        <x2:execute command="bcm.framework.queryform.Form:getFormSearchHiddenFields">
          <x2:with-param name="this" select="$this"/>
        </x2:execute>
        <BUTTONS>
          <BUTTON Name="search" DisplayText="Search" OnClick="javascript:onSearch()" Emphasized="no"/>
        </BUTTONS>
      </FORM>
    </xapl:return>
  </x2:command>

   <!-- ********************************************************************** 
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getReportConfig">
    <x2:param name="this" select="$this"/>
    <xapl:return>
      <REPORT Action="UserGroupSearch.jsp" Scrollable="no" ScrollableContainer="no" ShowFilter="no" Id="#" SelectedId="SELECTED_UG_ID" PagingTitle="yes">
        <FIELDS>
          <FIELD Name="UPDATE_ALL" DisplayType="Hidden" Value="NO"/>
          <!--get form's report fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
          <!-- get Hidden Fields -->
          <x2:execute command="bcm.framework.queryform.Form:getFormReportHiddenFields">
            <x2:with-param name="this" select="$this"/>
          </x2:execute>
        </FIELDS>
        <BUTTONS>
          <BUTTON Name="addNewUserGroup" DisplayText="Add New User Group" OnClick="javascript:onAddNewUserGroup()" Emphasized="no"/>
        </BUTTONS>
        <PAGINATION/>
      </REPORT>
    </xapl:return>
  </x2:command>
  
 <!-- ********************************************************************** 
  *********************************************************************** -->  
  <x2:command public="yes" description="_" name="getReportData">
    <x2:param name="this"/>

    <xapl:variable name="xfilters"><ROOT/></xapl:variable>        
      
    <xapl:set-variable name="xfilters">
      <FILTER Name="STATUS" Document="USER_GRP_PROFILE"> 
        <xapl:choose>
          <xapl:when test=" ($this/F_USER_GRP_PROFILE_STATUS/@Value = 'true') ">
            <OR>
              <xcore:search-by property="STATUS" value="INACTIVE" matchby="EQUAL"/>
              <xcore:search-by property="STATUS" value="ACTIVE" matchby="EQUAL"/>
              <xcore:search-by property="STATUS" value="DORMANT" matchby="EQUAL"/>            
            </OR>
          </xapl:when>
          <xapl:otherwise>
            <xcore:search-by property="STATUS" value="ACTIVE"/>
          </xapl:otherwise>
        </xapl:choose>
      </FILTER>
      
      <FILTER Name="GRP_NAME" Document="USER_GRP_PROFILE">
      <xapl:choose>
          <xapl:when test="{string-length($this/F_USER_GRP_PROFILE_GRP_NAME/@Value) &gt; 0}">           
              <xcore:search-by property="GRP_NAME" value="{$this/F_USER_GRP_PROFILE_GRP_NAME/@Value}" matchby="STARTS_WITH"/>
          </xapl:when>
          <xapl:otherwise>
              <xcore:search-by property="GRP_NAME" value="*" matchby="STARTS_WITH"/>            
          </xapl:otherwise>
      </xapl:choose>
      </FILTER>      
    </xapl:set-variable>

    <xapl:variable name="request"/>
    <xapl:set-variable name="request" select="{concat('//' , $this/SERVICE[1]/@Value, '/', 'getFormData')}"/>
    <xapl:variable name="response">
      <xapl:choose>        
        <xapl:when test="$this/DO_SEARCH/@Value = 'Yes' ">              
          <xcore:execute-method name="{$request}" 
                        StartAtRow="{$this/START_COUNT/@Value}" 
                        MaxRows="{$this/MAX_ROWS/@Value}" 
                        ReturnRowCount="yes" entireResponse="true">            

            <ID Value="{$currentForm/@Id}"/>
            
            <xapl:value-of select="$xfilters"/>
            
            <xapl:if test="string-length($this/*[name() = 'SORT_BY']/@Value) > 0
                  and $currentForm/RESULT_PROPERTIES/RESULT_PROPERTY
                  [@Property = substring-after( ($this/*[name() = 'SORT_BY']/@Value) , '.' )]
                  and $currentForm/RESULT_PROPERTIES/RESULT_PROPERTY
                  [@Document = substring-before( ($this/*[name() = 'SORT_BY']/@Value) , '.' )]">                  
              <ORDER_BY>
                <docutil:element name="{$this/*[name() = 'SORT_BY']/@Value}" 
                    Document="{substring-before($this/*[name() = 'SORT_BY']/@Value, '.' )}" 
                    Sort="{$this/*[name() = 'SORT_ORDER']/@Value}"/>
              </ORDER_BY>
            </xapl:if>            
         </xcore:execute-method>
        </xapl:when>
        <xapl:otherwise/>
      </xapl:choose>    
    </xapl:variable>

    <docutil:add select="$response/RESPONSE">
          <TOTAL_RECORD_COUNT Value="{$response/RESPONSE/@TotalRowCount}"/>
          <START_AT_ROW Value ="{$this/START_COUNT[position() = 1 ] /@Value}"/>
    </docutil:add>

    <xapl:return>
          <xapl:value-of select="{$response/RESPONSE}"/>
    </xapl:return>
    
  </x2:command>

  <!-- ********************************************************************** 
  *********************************************************************** -->  
  <x2:command public="yes" description="_" name="getContainer">
    <x2:param name="pPage"/>
    <xapl:variable name="helpUrl">
      <web:get-page name="user_admin_groups_search_help"/>
    </xapl:variable>
    <xapl:return>
      <CONTAINER Scrollable="yes">
        <HELP Url="{$helpUrl}"/>                          
        <STEP Name="ViewForm" DisplayText="UserSecurity.User_Group_Search" OnClick="{$pages:user_admin_group_search}" Selected="true"/>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  <!-- **********************************************************************
  *********************************************************************** -->
  
</x2:commands>