<?xml version="1.0" encoding="UTF-8"?>
<x2:commands description="_" 
            xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" 
            xmlns:cfg="http://www.i2.com/configurability" xmlns:core="http://www.i2.com/core" 
            xmlns:omx="http://www.i2.com/omx" xmlns:perm="http://www.i2.com/permissibility" 
            xmlns:util="http://www.i2.com/util" xmlns:web="http://www.i2.com/web" 
            xmlns:x2="http://www.i2.com/x2" xmlns:xapl="http://www.i2.com/xapl" 
            xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" 
            xmlns:docutil="http://www.i2.com/docutil" xmlns:xudl="http://www.i2.com/xudl"
            xmlns:identity="http://www.i2.com/identity">

  <!--************************************************************************
    ************************************************************************-->
  <x2:command public="yes" description="_" name="init">
    <xapl:variable name="userGroupProfileData" resolver="session" global="true"/>
  </x2:command>  
  
  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="getUserGroupDetails">
    <xapl:print select="{$this}"/>
    <docutil:remove select="$this/SORT_ORDER"/>
    <docutil:remove select="$this/SORT_BY"/>
    <docutil:remove select="$this/START_COUNT"/>
       
    <xapl:if test="$this/CREATE_NEW/@Value = 'Yes'">
    		<xapl:set-variable name="adminProcess">
            <ADMIN_PROCESS Value="CREATE_NEW_USR_GRP"/>
        </xapl:set-variable>
        <xapl:set-variable name="userGroupProfileData">
            <ROOT/>
        </xapl:set-variable>
        <!-- multiple values of USER_GRP_PROFILE come from the search screen -->
        <docutil:remove select="$this/*[substring-before(name(), '.') = 'USER_GRP_PROFILE']"/>
    </xapl:if>
    
    <web:display-page>
      <web:get-page name="user_group_details">
        <xapl:value-of select="$this/*[string-length(@Value) &gt; 0]"/>
      </web:get-page>
    </web:display-page> 
  </x2:command>

  <!-- **********************************************************************
  *********************************************************************** -->
  <x2:command public="yes" description="_" name="load">
    <xapl:print select="$this"/>
    
    <x2:execute command="bcm.framework.breadcrumb.controller:addBreadCrumbs">
      <x2:with-param name="display" select="'User Group Details'"/>
      <x2:with-param name="page" select="'user_group_details'"/>
      <x2:with-param name="this" select="{$this}"/>
    </x2:execute>

    <xapl:if test="not($this/USER_GROUP_ID)">
        <docutil:set select="$this">    
            <!-- when coming from the 'user group search' page -->
            <xapl:if test="string-length($this/USER_GRP_PROFILE.ID/@Value) &gt; 0">
                <USER_GROUP_ID Value="{$this/USER_GRP_PROFILE.ID/@Value}"/>
            </xapl:if>
            <xapl:if test="string-length($this/USER_GRP_ID/@Value) &gt; 0">
                <USER_GROUP_ID Value="{$this/USER_GRP_ID/@Value}"/>
            </xapl:if>
        </docutil:set>          
    </xapl:if>
    <xapl:if test="not($this/ORG_ID)">
        <docutil:set select="$this">
            <ORG_ID Value="{$this/USER_GRP_PROFILE.ORG_ID/@Value}"/>
        </docutil:set>          
    </xapl:if>
    
    <xapl:variable name="breadcrumbs">
        <x2:execute command="bcm.framework.breadcrumb.controller:getBreadCrumbs"/>
    </xapl:variable>
    
    <xapl:variable name="errorCode">
      <ROOT>
        <xapl:choose>
          <xapl:when test="string-length($this/ERROR_MESSAGE/@Value) &gt; 0">
            <ERROR_MESSAGE Value="{$this/ERROR_MESSAGE/@Value}"/>
          </xapl:when>
          <xapl:when test="string-length($this/SUCCESS_MESSAGE/@Value) &gt; 0">
            <SUCCESS_MESSAGE Value="{$this/SUCCESS_MESSAGE/@Value}"/>
          </xapl:when>
        </xapl:choose>
      </ROOT>
    </xapl:variable>

    <!-- available roles -->
    <xapl:variable name="availableRoleTemplates">
      <ROOT>
        <x2:execute command="omx.user_admin.user_group_details:getAssignableRoles"/>
      </ROOT>
    </xapl:variable>

    <!-- user group profile     -->
    <xapl:variable name="userGroupProfile">
      <xapl:choose>
        <xapl:when test="string-length($this/USER_GROUP_ID/@Value) &gt; 0">
          <x2:execute command="omx.user_admin.user_group_details:fetchUserGroupProfile">
            <x2:with-param name="userGroupID" select="{$this/USER_GROUP_ID/@Value}"/>
          </x2:execute>
        </xapl:when>
        <xapl:otherwise>
          <ROOT>
            <USER_GRP_PROFILE/>
          </ROOT>  
        </xapl:otherwise>   
      </xapl:choose>
    </xapl:variable>

    <xapl:print select="$userGroupProfile"/>
    <xapl:print>Organization ID *********<xapl:value-of select="$this/ORG_ID/@Value"/>
    </xapl:print>
    <!-- organization info -->
    <xapl:variable name="organizationInfo">
      <ROOT>
          <x2:execute command="omx.user_admin.user_group_details:getOrganization"/>
      </ROOT>
    </xapl:variable>
    <!--xapl:variable name="organizationInfo">
		      <ROOT>
		        <xapl:if test="string-length($this/ORG_ID/@Value) &gt; 0">
		          <x2:execute command="omx.user_admin.user_group_details:getOrganization">
		            <x2:with-param name="pId" select="{$this/ORG_ID/@Value}"/>
		          </x2:execute>
		        </xapl:if>
		      </ROOT>
    </xapl:variable-->
    <xapl:print select="$organizationInfo"/>
    <!-- user grp type STATIC INFO  -->
    <xapl:variable name="userGroupTypes">
      <ROOT>
        <x2:execute command="omx.user_admin.user_group_details:getUserGroupTypes"/>
      </ROOT>
    </xapl:variable>
    
    <xapl:variable name="viewMode" select="'READ'"/>
    <!-- READ/EDIT is not permission-driven in bcm; so set it to EDIT -->
    <xapl:set-variable name="viewMode" select="'EDIT'"/>

    <!-- page container -->
    <xapl:variable name="userGroupPageContainer">
      <ROOT>
        <x2:execute command="omx.user_admin.user_group_details:getUserGroupPageContainer">
          <x2:with-param name="userGroupProfileInfo" select="{$userGroupProfile}"/>
          <x2:with-param name="viewMode" select="{$viewMode}"/>
        </x2:execute>
      </ROOT>
    </xapl:variable>    
    
    <xapl:return>
    			<xapl:value-of select="{$breadcrumbs}"/>  
          <xapl:value-of select="$errorCode/*"/>
          <IN_PRIMARY_DOMAIN Value="{$s_inPrimaryDomain}"/>
          <xapl:value-of select="$userGroupPageContainer/*"/>
          <IDENTITY_ORG_ID Value="{identity-user-org()}"/>
          <VIEW_MODE Value="{$viewMode}"/>
          <xapl:value-of select="$userGroupProfile/*"/>
          <xapl:value-of select="$organizationInfo/*"/>
          <xapl:value-of select="$availableRoleTemplates/*"/>
          <xapl:value-of select="$userGroupTypes/*"/>       
    </xapl:return>
    
  </x2:command>

  <!--************************************************************************
        ************************************************************************-->
  <x2:command public="yes" description="_" name="getAssignableRoles">
    <x2:param name="pOrgId"/>
    <xapl:variable name="id">
      <xapl:choose>
        <xapl:when test=" string-length($pOrgId) &gt; 0 ">
          <xapl:value-of select="$pOrgId"/>
        </xapl:when>
        <xapl:otherwise>
          <xapl:value-of select="identity-user-org()"/>
        </xapl:otherwise>
      </xapl:choose>
    </xapl:variable>

    <xapl:variable name="identityOrg">
      <x2:execute command="omx.user_admin.user_group_details:getOrganization">
        <x2:with-param name="pId" select="$id"/>
      </x2:execute>
    </xapl:variable>

    <xapl:variable name="apiArgument">
      <ROOT>
        <USER_ID Value="{identity-user-id()}"/>
        <xapl:choose>
          <xapl:when test=" string-length($pOrgId) &gt; 0 ">
            <xapl:if test=" ($identityOrg/CUSTOMER_STATUS/@Value = 'ACTIVE') ">
              <ORG_TYPE Value="Customer"/>
            </xapl:if>
            <xapl:if test=" ($identityOrg/SELLER_STATUS/@Value = 'ACTIVE') ">
              <ORG_TYPE Value="Seller"/>
            </xapl:if>
            <xapl:if test=" ($pOrgId = '_SU_ORG_') or ($identityOrg/ID/@Value = '_SU_ORG_') ">
              <ORG_TYPE Value="System"/>
            </xapl:if>
          </xapl:when>
        </xapl:choose>
      </ROOT>
    </xapl:variable>

    <xapl:variable name="responses">
      <xcore:execute-method name="//UserSecurity/getAssignableRoles" entireResponse="true">
        <xapl:value-of select="$apiArgument/*"/>
      </xcore:execute-method>
    </xapl:variable>
 
    <xapl:return>
      <ASSIGNABLE_ROLES>
        <xapl:for-each select="$responses/RESPONSE/USER_GRP_ASSIGNEMENT_MAP" varName="roleEntry">
          <ASSIGNABLE_ROLE>
            <TYPE_ID Value="ASSIGNABLE_ROLE"/>
            <VALUE_ID Value="{$roleEntry/ASSIGNABLE_ROLE_ID/@Value}"/>
            <DESCRIPTION Value="{$roleEntry/ASSIGNABLE_ROLE_NAME/@Value}"/>
          </ASSIGNABLE_ROLE>
        </xapl:for-each>
      </ASSIGNABLE_ROLES>
    </xapl:return>
  </x2:command>
  
  <!--************************************************************************
    ************************************************************************-->
  <x2:command public="yes" description="_" name="getOrganization">
    <x2:param name="pId"/>
    <xapl:variable name="org">
      <xcore:execute-method name="//UserSecurity/getOrganizations">
        <ID Value="{$pId}"/>
      </xcore:execute-method>
    </xapl:variable>
	<xapl:print>User group fix check 1</xapl:print>
	<xapl:print>{$org}</xapl:print>
   
    <xapl:return>
      <xapl:value-of select="$org"/>
    </xapl:return>
  </x2:command>

  <!--************************************************************************
     ************************************************************************-->
  <x2:command public="yes" description="_" name="fetchUserGroupProfile">
    <x2:param name="userGroupID"/>    
    <xapl:variable name="userGroupProfile"/>
    <xapl:choose>
      <xapl:when test="string-length($userGroupID) &gt; 0">
        <xapl:variable name="responses">
          <xcore:execute-method name="//UserSecurity/getUserGroupDetails" entireResponse="true">
            <ID Value="{$userGroupID}"/>
          </xcore:execute-method>
        </xapl:variable>
        <xapl:set-variable name="userGroupProfile">
          <ROOT>
            <xapl:value-of select="$responses/RESPONSE/*"/>
          </ROOT>
        </xapl:set-variable>
      </xapl:when>
      <xapl:otherwise>
        <xapl:set-variable name="userGroupProfile">
          <ROOT>
            <USER_GRP_PROFILE/>
          </ROOT>
        </xapl:set-variable>
      </xapl:otherwise>
    </xapl:choose>
    <xapl:set-variable name="userGroupProfileData" select="$userGroupProfile"/>
    <xapl:return>
      <xapl:value-of select="$userGroupProfile"/>
    </xapl:return>
  </x2:command>
  
  <!-- **************************************************************************
    ************************************************************************** -->
  <x2:command public="yes" description="_" name="getUserGroupTypes">
    <xapl:return>
      <USER_GROUP_TYPES>
        <USER_GROUP_TYPE Value="ADMIN" Name="Administrator"/>
        <USER_GROUP_TYPE Value="ENTERPRISE" Name="Enterprise"/>
        <USER_GROUP_TYPE Value="PARTNER" Name="Partner"/>
        <!-- Added by Santosh -->
        <!-- <USER_GROUP_TYPE Value="CONSUMER" Name="Consumer"/> -->
      </USER_GROUP_TYPES>
    </xapl:return>
  </x2:command>

  <!-- **************************************************************************
    ************************************************************************** -->
  <x2:command public="yes" description="_" name="getUserGroupPageContainer">
    <xapl:param name="userGroupProfileInfo"/>
    <xapl:param name="viewMode"/>    
    
    <xapl:variable name="status" select="{$userGroupProfileInfo/USER_GRP_PROFILE/STATUS/@Value}"/>
    <xapl:variable name="id" select="{$userGroupProfileInfo/USER_GRP_PROFILE/ID/@Value}"/>
    <xapl:variable name="isSaveDisable" select="'yes'"/>
    <xapl:variable name="isUpdateDisable" select="'yes'"/>
    <xapl:variable name="isNewUserGroup" select="not( (string-length($id) &gt; 0) )"/>
    <xapl:variable name="isEditable" select=" 'false' "/>
    <xapl:choose>
      <xapl:when test=" string-length($viewMode) &gt; 0 and $viewMode = 'EDIT' ">
        <xapl:set-variable name="isEditable" select="'true'"/>
      </xapl:when>
    </xapl:choose>

    <xapl:choose>
      <xapl:when test=" $isEditable = 'true'">
        <xapl:if test="not($isNewUserGroup) ">
          <xapl:set-variable name="isSaveDisable" select="'yes'"/>
          <xapl:set-variable name="isUpdateDisable" select="'no'"/>
        </xapl:if>
        <xapl:if test="($isNewUserGroup)">
          <xapl:set-variable name="isSaveDisable" select="'no'"/>
          <xapl:set-variable name="isUpdateDisable" select="'yes'"/>
        </xapl:if>
      </xapl:when>
    </xapl:choose>

    <xapl:return>
      <CONTAINER Scrollable="no">
        <xapl:choose>
          <xapl:when test="$isNewUserGroup">
            <HELP Url="{$pages:create_user_group_detail_help}"/>
          </xapl:when>
          <xapl:otherwise>
            <HELP Url="{$pages:user_group_detail_help}"/>
          </xapl:otherwise>
        </xapl:choose>
        <!-- help page for User group is required  -->
        <STEP OnClick="{$pages:user_group_details}" Selected="true" DisplayText="User Group Details">
          <BUTTONS>
            <BUTTON DisplayText="Cancel" OnClick="javascript:onCancel();"/>
            <DIVIDER/>
            <xapl:choose>
              <xapl:when test=" string-length($status) &gt; 0 and $status = 'ACTIVE' ">
                <BUTTON DisplayText="Assign Domain" Disabled="{$isUpdateDisable}" OnClick="javascript:onAssignDomain();"/>
                <BUTTON DisplayText="Deactivate" Disabled="{$isUpdateDisable}" Emphasized="false" OnClick="javascript:submitFormToDeactivate();"/>
                <DIVIDER/>
              </xapl:when>
              <xapl:otherwise>
                <BUTTON DisplayText="Activate" Disabled="{$isUpdateDisable}" Emphasized="false" OnClick="javascript:submitFormToActivate();"/>
                <DIVIDER/>
              </xapl:otherwise>
            </xapl:choose>
            <BUTTON DisplayText="Update" Disabled="{$isUpdateDisable}" Emphasized="false" OnClick="javascript:submitFormToModifyUserGroup();"/>
            <BUTTON DisplayText="Save As New" Disabled="{$isUpdateDisable}" Emphasized="false" OnClick="javascript:submitFormToCreateNewUserGroup('SAVE_AS');"/>
            <DIVIDER/>
            <BUTTON DisplayText="Save" Disabled="{$isSaveDisable}" Emphasized="true" OnClick="javascript:submitFormToCreateNewUserGroup('SAVE');"/>
          </BUTTONS>
        </STEP>
      </CONTAINER>
    </xapl:return>
  </x2:command>
  
  <!--************************************************************************
    ************************************************************************-->
  <x2:command public="yes" description="_" name="createNewUserGroup">
    <xapl:print>createNewUserGroup</xapl:print>
    <xapl:print select="{$this}"/>
    <!-- prepare the api arguments -->
    <xapl:variable name="addUserGroupArguments">
        <ROOT>
          <GRP_NAME Value="{$this/GRP_NAME/@Value}"/>
          <ORG_ID Value="{$this/ORG_ID/@Value}"/>      
          <GRP_TYPE Value="{$this/USER_GROUP_TYPE/@Value}"/>
          <DESC Value="{$this/DESCRIPTION/@Value}"/>
        </ROOT>      
    </xapl:variable>
    
    <xapl:variable name="assignRoles">
      <x2:execute command="bcm.framework.util:createXMLFromString">
        <x2:with-param name="string" select="$this/ASSIGN_ROLES/@Value"/>
        <x2:with-param name="delimeter" select="'#'"/>
        <x2:with-param name="tagname" select="'ROLE_ID'"/>
      </x2:execute>
    </xapl:variable>
    
    <xapl:variable name="roleTemplates">        
        <ASSIGN_ROLE_TEMPLATES>
            <xapl:for-each select="{$assignRoles/ROLE_ID}" varName="roleVar">
                <ROLE_TEMPLATE Value="{$roleVar/@Value}"/>
            </xapl:for-each>
        </ASSIGN_ROLE_TEMPLATES>
    </xapl:variable>    
    
    
    <docutil:set select="$addUserGroupArguments">
        <xapl:value-of select="{$roleTemplates}"/>
    </docutil:set>
    
    <xapl:print select="{$addUserGroupArguments}"/>    
    
    <xapl:variable name="addUserGroupResult">
      <xcore:execute-method name="//UserSecurity/createUserGroup" entireResponse="true">
        <xapl:value-of select="{$addUserGroupArguments/*}"/>
      </xcore:execute-method>
    </xapl:variable>
    
    <docutil:add select="$this">
      <x2:execute command="bcm.framework.util:getResponseStatus">
        <x2:with-param name="response" select="$addUserGroupResult"/>
        <x2:with-param name="successMessage" select="'USER_GROUP_CREATED'"/>
      </x2:execute>
    </docutil:add>

    <xapl:print select="{$addUserGroupResult}"/>
    <xapl:print select="{$this}"/>

    <xapl:choose>
      <!-- check for error -->
      <xapl:when test="(string-length($responseStatus/ERROR_MESSAGE/Value) &gt; 0 )">
        <x2:execute command="omx.user_admin.user_group_details:getUserGroupDetails">      
            <x2:with-param name="this" select="$this"/>
        </x2:execute>       
      </xapl:when>

      <!-- on no errors -->
      <xapl:otherwise>
        <docutil:set select="$this">
            <USER_GROUP_ID Value="{$addUserGroupResult/RESPONSE/USER_GROUP_ID/@Value}"/>
        </docutil:set>
        <x2:execute command="omx.user_admin.user_group_details:getUserGroupDetails">      
            <x2:with-param name="this" select="$this"/>
            <xapl:set-variable name="adminProcess"/>
        </x2:execute>       
      </xapl:otherwise>
    </xapl:choose>
  </x2:command>
  
  <!--************************************************************************
    ************************************************************************-->
  <x2:command public="yes" description="_" name="activateUserGroup">
    <xapl:print select="{$this}"/>
    <xapl:variable name="activateUserGroupVar">
      <USER_GROUP_ID Value="{$userGroupProfileData/USER_GRP_PROFILE/ID/@Value}"/>
    </xapl:variable>
    <xapl:variable name="response">
      <xcore:execute-method name="//UserSecurity/activateUserGroup" entireResponse="true">
        <xapl:value-of select="{$activateUserGroupVar}"/>
      </xcore:execute-method>
    </xapl:variable>
    
    <docutil:add select="$this">
      <x2:execute command="bcm.framework.util:getResponseStatus">
        <x2:with-param name="response" select="$response"/>
        <x2:with-param name="successMessage" select="'USER_GROUP_ACTIVATED'"/>
      </x2:execute>
    </docutil:add>
    
    <x2:execute command="omx.user_admin.user_group_details:getUserGroupDetails">      
        <x2:with-param name="this" select="$this"/>
    </x2:execute>       
  </x2:command>

 <!--************************************************************************
    ************************************************************************-->
  <x2:command public="yes" description="_" name="inActivateUserGroup">
    <xapl:print select="{$this}"/>
    <xapl:variable name="inActivateUserGroupVar">
      <USER_GROUP_ID Value="{$userGroupProfileData/USER_GRP_PROFILE/ID/@Value}"/>
    </xapl:variable>
    <xapl:variable name="response">
      <xcore:execute-method name="//UserSecurity/inActivateUserGroup" entireResponse="true">
        <xapl:value-of select="{$inActivateUserGroupVar}"/>
      </xcore:execute-method>
    </xapl:variable>
    
    <docutil:add select="$this">
      <x2:execute command="bcm.framework.util:getResponseStatus">
        <x2:with-param name="response" select="$response"/>
        <x2:with-param name="successMessage" select="'USER_GROUP_DEACTIVATED'"/>
      </x2:execute>
    </docutil:add>

    <x2:execute command="omx.user_admin.user_group_details:getUserGroupDetails">      
        <x2:with-param name="this" select="$this"/>
    </x2:execute>       
  </x2:command>

 <!--************************************************************************
    ************************************************************************-->
  <x2:command public="yes" description="_" name="modifyUserGroupDetails">
    <xapl:print select="{$this}"/>
    
    <xapl:variable name="modifyUserGroupArguments">
      <ROOT>
          <ID Value="{$this/USER_GROUP_ID/@Value}"/>
          <GRP_NAME Value="{$this/GRP_NAME/@Value}"/>
          <ORG_ID Value="{$this/ORG_ID/@Value}"/>      
          <GRP_TYPE Value="{$this/USER_GROUP_TYPE/@Value}"/>
          <DESC Value="{$this/DESCRIPTION/@Value}"/>
      </ROOT>
    </xapl:variable>
    
    <xapl:variable name="addRoles"/>
    <xapl:variable name="addRolesXML"/>
    <xapl:variable name="removeRoles"/> 
    <xapl:variable name="removeRolesXML"/>

    <xapl:if test="string-length($this/ROLE_CHANGES/@Value) &gt; 0">            
        <xapl:set-variable name="addRoles">
            <xapl:value-of select="{substring-after(substring-before($this/ROLE_CHANGES/@Value, ':'), 'ADDROLES')}"/>
        </xapl:set-variable>
        <xapl:set-variable name="removeRoles">
            <xapl:value-of select="{substring-after(substring-after($this/ROLE_CHANGES/@Value, ':'), 'REMOVEROLES')}"/>
        </xapl:set-variable>
    </xapl:if>
    
    <xapl:if test="string-length($addRoles) &gt; 0">
      <xapl:set-variable name="addRolesXML">
          <x2:execute command="bcm.framework.util:createXMLFromString">
            <x2:with-param name="string" select="{$addRoles}"/>
            <x2:with-param name="delimeter" select="'#'"/>
            <x2:with-param name="tagname" select="'ROLE_ID'"/>
          </x2:execute> 
      </xapl:set-variable>
      
      <docutil:add select="{$modifyUserGroupArguments}">
        <ASSIGN_ROLES>
            <xapl:value-of select="{$addRolesXML/*}"/>
        </ASSIGN_ROLES>
      </docutil:add>
    </xapl:if>

    <xapl:if test="string-length($removeRoles) &gt; 0">
        <xapl:set-variable name="removeRolesXML">
            <x2:execute command="bcm.framework.util:createXMLFromString">
                <x2:with-param name="string" select="{$removeRoles}"/>
                <x2:with-param name="delimeter" select="'#'"/>
                <x2:with-param name="tagname" select="'ROLE_ID'"/>
            </x2:execute>               
        </xapl:set-variable>
        
      <docutil:add select="{$modifyUserGroupArguments}">
        <UNASSIGN_ROLES>
            <xapl:value-of select="{$removeRolesXML/*}"/>
        </UNASSIGN_ROLES>
      </docutil:add>        
    </xapl:if>              
            
    <xapl:print select="{$modifyUserGroupArguments}"/>
    
    <xapl:variable name="modifyUserGroupResult">
      <xcore:execute-method name="//UserSecurity/modifyUserGroup" entireResponse="true">
        <xapl:value-of select="{$modifyUserGroupArguments/*}"/>
      </xcore:execute-method>
    </xapl:variable>

    <docutil:add select="$this">
      <x2:execute command="bcm.framework.util:getResponseStatus">
        <x2:with-param name="response" select="$modifyUserGroupResult"/>
        <x2:with-param name="successMessage" select="'USER_GROUP_MODIFIED'"/>
      </x2:execute>
    </docutil:add>
    
    <x2:execute command="omx.user_admin.user_group_details:getUserGroupDetails">      
        <x2:with-param name="this" select="$this"/>
    </x2:execute>       
  </x2:command>

 <!--************************************************************************
    ************************************************************************-->
  <x2:command public="yes" description="_" name="addUsersToUserGroup">
    <xapl:print select="$this"/>
    
    <xapl:variable name="addUserToUserGroupArgument">
      <USER_GROUP_ID Value="{$userGroupProfileData/USER_GRP_PROFILE/ID/@Value}"/>
      <USERS>
        <xapl:for-each select="{$this/SELECTED_USER_ID}" varName="userVar">
            <xapl:variable name="userId">
               <x2:execute command="bcm.framework.queryform.Form:getValueFromSelectedId">
                  <x2:with-param name="selectedId" select="$userVar/@Value" />
                  <x2:with-param name="key" select="'USER_PROFILE.ID'" />
               </x2:execute>
            </xapl:variable>    
            <!-- Added the otherwise part for EQ:541582
            Not able to assign users to user groups -->
            <xapl:choose>
                <xapl:when test="string-length($userId)>0">
                    <USER Value="{$userId}"/>
                </xapl:when>
                <xapl:otherwise>
                    <USER Value="{$userVar/@Value}"/>
                </xapl:otherwise>
            </xapl:choose>
            
        </xapl:for-each>
      </USERS>
    </xapl:variable>

    <xapl:print>
        USER TO USER GRP ARG:::<xapl:value-of select="$addUserToUserGroupArgument"/>
    </xapl:print>

    <xapl:variable name="addToUserGroupResult">
        <xcore:execute-method name="//UserSecurity/addUserToUserGroup" entireResponse="true">
          <xapl:value-of select="{$addUserToUserGroupArgument}"/>
        </xcore:execute-method>
    </xapl:variable>
    
    <xapl:variable name="sendMessage">
        <xapl:if test="$addToUserGroupResult/RESPONSE/@Status = 'Success'">
            <SUCCESS_MESSAGE Value="Users added to the user group successfully"/>
            <xapl:set-variable name="adminProcess"/>
        </xapl:if>
        <xapl:if test="$addToUserGroupResult/RESPONSE/@Status = 'Error'">
            <ERROR_MESSAGE Value="{$addToUserGroupResult/RESPONSE/@Description}"/>
        </xapl:if>
    </xapl:variable>
    <xapl:print>
        SEND MSG:::<xapl:value-of select="$sendMessage"/>
    </xapl:print>
    <web:display-page>
      <web:get-page name="user_group_details">
        <USER_GROUP_ID Value="{$userGroupProfileData/USER_GRP_PROFILE/ID/@Value}"/>
        <xapl:value-of select="$sendMessage"/>
      </web:get-page>
    </web:display-page>
  </x2:command>

 <!--************************************************************************
    ************************************************************************-->
  <x2:command public="yes" description="_" name="goToPage">
    <xapl:print select="$this"/>
    <xapl:variable name="whereToGo" select="{$this/WHERE[1]/@Value}"/>
    <xapl:choose>
      
      <xapl:when test=" 'VIEW_USERS' = $whereToGo ">
        <xapl:set-variable name="adminProcess">
            <ADMIN_PROCESS Value="VIEW_USERS"/>
        </xapl:set-variable>
        <web:display-page>
          <!-- 'user_admin_search' is 'user_search_view' minus the params -->       
          <web:get-page name="user_admin_search">               
            <DO_SEARCH Value="Yes"/>
            <USER_GROUP_ID Value="{$this/USER_GROUP_ID/@Value}"/>
            <WHERE Value="{$this/WHERE/@Value}"/>
            <xapl:if test="string-length($this/fromPage/@Value) &gt; 0">
              <fromPage Value="{$this/fromPage/@Value}"/>
            </xapl:if>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      
      <xapl:when test=" 'ASSIGN_USERS' = $whereToGo ">
        <xapl:set-variable name="adminProcess">
            <ADMIN_PROCESS Value="ASSIGN_USERS"/>
        </xapl:set-variable>
        <web:display-page>
          <web:get-page name="user_admin_search">
            <DO_SEARCH Value="Yes"/>
            <USER_GROUP_ID Value="{$this/USER_GROUP_ID/@Value}"/>
            <WHERE Value="{$this/WHERE/@Value}"/>
            <xapl:if test="string-length($this/fromPage/@Value) &gt; 0">
              <fromPage Value="{$this/fromPage/@Value}"/>
            </xapl:if>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      
      <xapl:when test=" 'NEW_USERS' = $whereToGo ">
        <xapl:set-variable name="adminProcess">
            <ADMIN_PROCESS Value="NEW_USERS"/>
        </xapl:set-variable>
        <web:display-page>
          <web:get-page name="users_edit">
            <xapl:value-of select="$this/*[string-length(@Value) &gt; 0]"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      
      <xapl:when test=" 'USER_GROUP_CONTENTS' = $whereToGo ">
        <xapl:set-variable name="selectedDomainTypeName" select=""/>
        <web:display-page>
          <web:get-page name="user_admin_groups_new_content">
            <ID Value="{$userGroupProfileData/USER_GRP_PROFILE/ID/@Value}"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>
      
      <xapl:when test=" 'USER_GROUP_MAIN' = $whereToGo ">
        <xapl:set-variable name="adminProcess"/>
        <web:display-page>
          <web:get-page name="user_group_details">
            <USER_GROUP_ID Value="{$userGroupProfileData/USER_GRP_PROFILE/ID/@Value}"/>
          </web:get-page>
        </web:display-page>
      </xapl:when>

      <xapl:when test=" 'USER_DETAILS' = $whereToGo ">
         <xapl:set-variable name="adminProcess">
            <ADMIN_PROCESS Value="USER_DETAILS"/>
         </xapl:set-variable>       
         <web:display-page>
                <web:get-page name="users_edit">
                    <xapl:value-of select="$this/*"/>
                </web:get-page>
         </web:display-page>
      </xapl:when>
      
      <xapl:when test=" 'ASSIGN_DOMAIN' = $whereToGo ">
        <xapl:set-variable name="adminProcess">
            <ADMIN_PROCESS Value="ASSIGN_DOMAIN"/>
        </xapl:set-variable>       
        <web:display-page>
            <web:get-page name="user_group_domain">
                <xapl:value-of select="$this/*[string-length(@Value) &gt; 0]"/>
            </web:get-page>
        </web:display-page>
      </xapl:when>

      <xapl:when test=" 'ONCANCEL' = $whereToGo ">
        <!-- clear the session -->
        <xapl:set-variable name="adminProcess"/>
        <xapl:set-variable name="userGroupProfileData"/>            
        <!-- back will lead to 'user details' page or 'user group search' page -->
        <x2:execute command="bcm.framework.breadcrumb.controller:back"/>
      </xapl:when>

      <xapl:otherwise>
        <web:display-page>
          <web:get-page name="user_group_details">
            <xapl:value-of select="$this/*[string-length(@Value) &gt; 0]"/>
          </web:get-page>
        </web:display-page>
      </xapl:otherwise>
    </xapl:choose>
  </x2:command>
  
  <!--************************************************************************
    ************************************************************************-->  
</x2:commands>