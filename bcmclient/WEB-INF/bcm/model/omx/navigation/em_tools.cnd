<?xml version="1.0" encoding="UTF-8"?>
<x2:commands xmlns:x2="http://www.i2.com/x2" xmlns:core="http://www.i2.com/core" xmlns:xcore="http://www.i2.com/xcore" xmlns:xcore-db="http://www.i2.com/xcore-db" xmlns:xapl="http://www.i2.com/xapl" xmlns:web="http://www.i2.com/web" xmlns:docutil="http://www.i2.com/docutil" xmlns:util="http://www.i2.com/util" xmlns:FUNCTION="http://www.i2.com/FUNCTION" xmlns:REMOVE="http://www.i2.com/REMOVE" xmlns:xudl="http://www.i2.com/xudl" xmlns:cfg="http://www.i2.com/configurability" xmlns:perm="http://www.i2.com/permissibility" xmlns:omx="http://www.i2.com/omx" xmlns:identity="http://www.i2.com/identity" xmlns:i18n="http://www.i2.com/i18n" description="_">
<!-- **************************************************************** -->
   <x2:command public="yes" description="_" name="getLinks">
      <xapl:variable name="pad">
         <PAD Name="tools" DisplayText="Tools" Scrollable="yes">
<!-- Alerts -->
<!--
<perm:is-allowed document="TASKS" action="view_enterprise_alerts">
               <PAD_ITEM OnClick="{$pages:alerts_enterprise_management_display}" DisplayText="Alerts" />
            </perm:is-allowed>
-->

<!-- User Profile -->
            <PAD_ITEM OnClick="{$pages:nav_pref}" DisplayText="User Profile" />

<!-- Reports -->
<!--    
        Commented out until enterprise reports are defined. - WJD       
-->
            <perm:is-allowed document="TASKS" action="enterprise_reports">
               <PAD_ITEM DisplayText="Reports">
                  <PAD_ITEM OnClick="{$pages:em_corporate_reports}" DisplayText="Online Reports" />
      <!--PAD_ITEM OnClick="{$pages:em_scheduled_reports}" DisplayText="Scheduled Reports" />
      <PAD_ITEM OnClick="{$pages:em_personal_reports}" DisplayText="Personal Reports" /-->
      <PAD_ITEM OnClick="{$pages:create_reports}" DisplayText="Create Report" />

<!--
            <PAD_ITEM OnClick="{$pages:create_reports}"      DisplayText="Create"/>
            -->
               </PAD_ITEM>
            </perm:is-allowed>

<!-- for now use toplevel enterprise management activity -->
<!--
        <perm:is-allowed document="TOP_LEVEL_ACTIVITY" action="manage_enterprise">
                    <PAD_ITEM DisplayText="Reports">
            <PAD_ITEM OnClick="{$pages:em_personal_reports}" DisplayText="Standard Reports"/>
            <PAD_ITEM OnClick="{$pages:create_reports}"      DisplayText="Create"/>
          </PAD_ITEM>
        </perm:is-allowed>
-->
         </PAD>
      </xapl:variable>

      <xapl:return>
         <xapl:if test="count($pad/PAD_ITEM) &gt;0">
            <xapl:value-of select="$pad" />
         </xapl:if>
      </xapl:return>
   </x2:command>

   <x2:command public="yes" description="_" name="i18n">
      <i18n:text>Tools</i18n:text>

      <i18n:text>Alerts</i18n:text>

      <i18n:text>User Profile</i18n:text>

      <i18n:text>Reports</i18n:text>

      <i18n:text>Standard Reports</i18n:text>

      <i18n:text>Create</i18n:text>
   </x2:command>
</x2:commands>

