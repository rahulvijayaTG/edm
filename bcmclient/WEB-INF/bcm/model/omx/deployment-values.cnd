<?xml version="1.0" encoding="UTF-8"?>

<x2:commands xmlns:x2       = "http://www.i2.com/x2"
             xmlns:core     = "http://www.i2.com/core"
             xmlns:xcore    = "http://www.i2.com/xcore"
             xmlns:xapl     = "http://www.i2.com/xapl"
             xmlns:web      = "http://www.i2.com/web"
             xmlns:docutil  = "http://www.i2.com/docutil"
             xmlns:util     = "http://www.i2.com/util"
             xmlns:cfg      = "http://www.i2.com/configurability"
             xmlns:perm     = "http://www.i2.com/permissibility"
             xmlns:omx      = "http://www.i2.com/omx"
             xmlns:i18n     = "http://www.i2.com/i18n"
             xmlns:identity = "http://www.i2.com/identity"
             description    = "_">

<!-- ********************************************************************************
     * Use this file to specify values with a "get" accessor that are               *
     *   1) accessable from x2 code only                                            *
     *   2) system wide.                                                            *
     *   3)  configurable at deployment time (potentially by an installer)          *
     ******************************************************************************** -->

  <!-- CAS Service Integration Values -->
  <x2:command public="yes" description="_" name="getCasServiceName">
    <xapl:return><xapl:value-of select="'http://blrdev34:9001/cas'"/></xapl:return>
  </x2:command>
  <x2:command public="yes" description="_" name="getCasServiceLogin">
    <xapl:variable name="userName"><identity:get-user-name/></xapl:variable>
    <xapl:return><xapl:value-of select="$userName"/></xapl:return>
  </x2:command>
  <x2:command public="yes" description="_" name="getCasServicePassword">
    <xapl:return><xapl:value-of select="'pw'"/></xapl:return>
  </x2:command>


</x2:commands>
